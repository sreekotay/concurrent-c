diff --git a/cc_ast_record.h b/cc_ast_record.h
index 4426a146..aef61d9d 100644
--- a/cc_ast_record.h
+++ b/cc_ast_record.h
@@ -18,6 +18,22 @@
 #define CC_AST_WITH_NODE(code) \
     do { struct CCASTStubNode *node = cc_ast_current_node(); if (node) { code } } while(0)
 
+/* Byte offset of the current lex position within the top-level parse buffer.
+ * Exact only for in-memory string compiles (the CC pipeline's case: buffer
+ * holds the whole source).  -1 when inside a nested include stream (file->prev
+ * set) or a streaming fd window, where buf_ptr is not a global offset. */
+static inline long cc_ast_cur_off(void) {
+    if (!file || file->prev) return -1;
+    return (long)(file->buf_ptr - file->buffer);
+}
+
+/* Byte offset of column `col` (1-based) on the current line — token-precise
+ * refinement used at the same sites that stamp col_start/col_end. */
+static inline long cc_ast_col_off(int col) {
+    if (!file || file->prev || !file->cc_line_start || col <= 0) return -1;
+    return (long)(file->cc_line_start - file->buffer) + (col - 1);
+}
+
 static void cc_ast_ensure_tables(void) {
     if (!tcc_state) return;
     if (!tcc_state->cc_nodes) {
@@ -64,6 +80,8 @@ void cc_ast_record_start(int kind) {
     tcc_state->cc_nodes[idx].line_end = tcc_state->cc_nodes[idx].line_start;
     tcc_state->cc_nodes[idx].col_start = 0;
     tcc_state->cc_nodes[idx].col_end = 0;
+    tcc_state->cc_nodes[idx].off_start = (cc_tok_off >= 0) ? cc_tok_off : cc_ast_cur_off();
+    tcc_state->cc_nodes[idx].off_end = -1;
     tcc_state->cc_nodes[idx].aux1 = 0;
     tcc_state->cc_nodes[idx].aux2 = 0;
     tcc_state->cc_nodes[idx].aux_s1 = NULL;
@@ -76,6 +94,13 @@ void cc_ast_record_end(void) {
     int idx = tcc_state->cc_node_stack[tcc_state->cc_node_stack_top];
     if (file && (tcc_state->cc_nodes[idx].aux2 & CC_AST_FLAG_LINE_END_SET) == 0)
         tcc_state->cc_nodes[idx].line_end = file->line_num;
+    {
+        /* Exclusive end: prefer the start of the token AFTER the construct
+         * (tight bound); fall back to the raw lex position. */
+        long off = (cc_tok_off >= 0) ? cc_tok_off : cc_ast_cur_off();
+        if (off >= 0 && off >= tcc_state->cc_nodes[idx].off_start)
+            tcc_state->cc_nodes[idx].off_end = off;
+    }
     tcc_state->cc_node_stack_top--;
 }
 

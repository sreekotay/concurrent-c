/* Memory diagnostics (Mach footprint, arena slabs, live bytes).
 * Included into redis_idiomatic.ccs / redis_owner.ccs after RedisDb exists.
 * Log prefix stays `redis_idiomatic:` so bench_robust mem_gap parsers match. */
#ifndef REDIS_IDIOMATIC_MEM_CCH
#define REDIS_IDIOMATIC_MEM_CCH

static size_t redis_map_live_payload_bytes(RedisDbMap map) {
    return map ? map.live_bytes() : 0;
}

static size_t redis_db_map_live_bytes(const RedisDb* db) {
    size_t sum = 0;
    size_t i;
    if (!db || !db->shards) return 0;
    for (i = 0; i < db->shard_count; ++i) {
        RedisDbMap m = db->shards[i].entries;
        sum += redis_map_live_payload_bytes(m);
    }
    return sum;
}

static size_t redis_db_map_len(const RedisDb* db) {
    size_t sum = 0;
    size_t i;
    if (!db || !db->shards) return 0;
    for (i = 0; i < db->shard_count; ++i) {
        RedisDbMap m = db->shards[i].entries;
        if (m) sum += m.len();
    }
    return sum;
}

static size_t redis_db_map_buckets(const RedisDb* db) {
    size_t sum = 0;
    size_t i;
    if (!db || !db->shards) return 0;
    for (i = 0; i < db->shard_count; ++i) {
        RedisDbMap m = db->shards[i].entries;
        if (m) sum += m.cap();
    }
    return sum;
}

static void db_mem_stats_note_key_alloc(size_t bytes) {
    CC_ATOMIC_FETCH_ADD(&g_db_mem_stats.key_alloc_count, 1);
    CC_ATOMIC_FETCH_ADD(&g_db_mem_stats.key_alloc_bytes, bytes);
}

static void db_mem_stats_note_key_release(size_t bytes) {
    CC_ATOMIC_FETCH_ADD(&g_db_mem_stats.key_release_count, 1);
    CC_ATOMIC_FETCH_ADD(&g_db_mem_stats.key_release_bytes, bytes);
}

static void db_mem_stats_note_value_alloc(size_t bytes) {
    CC_ATOMIC_FETCH_ADD(&g_db_mem_stats.value_alloc_count, 1);
    CC_ATOMIC_FETCH_ADD(&g_db_mem_stats.value_alloc_bytes, bytes);
}

static void db_mem_stats_note_value_release(size_t bytes) {
    CC_ATOMIC_FETCH_ADD(&g_db_mem_stats.value_release_count, 1);
    CC_ATOMIC_FETCH_ADD(&g_db_mem_stats.value_release_bytes, bytes);
}

static size_t db_mem_stats_live(size_t alloc_bytes, size_t release_bytes) {
    return alloc_bytes >= release_bytes ? alloc_bytes - release_bytes : 0;
}

static void db_dump_mem_stats(RedisDb* db, const char* tag);

static size_t redis_mem_worker_hint(void) {
    const char* s = getenv("CC_WORKERS");
    size_t w;
    if (s && s[0]) {
        char* end = NULL;
        unsigned long n = strtoul(s, &end, 10);
        if (end != s && (!end || *end == 0) && n > 0 && n < 4096) return (size_t)n;
    }
    w = cc_sched_get_num_workers();
    if (w > 0) return w;
    {
        long n = sysconf(_SC_NPROCESSORS_ONLN);
        if (n > 0) return (size_t)n;
    }
    return 1;
}

/* Process footprint in bytes. Prefer Mach phys_footprint on Darwin; else
 * getrusage maxrss (Darwin: bytes; Linux: kilobytes). */
static int redis_mem_process_footprint_B(uint64_t* out_bytes, const char** out_source) {
    struct rusage ru;
    if (!out_bytes || !out_source) return 0;
    *out_bytes = 0;
    *out_source = "none";
#if defined(__APPLE__)
    {
        struct task_vm_info vm_info;
        mach_msg_type_number_t count = TASK_VM_INFO_COUNT;
        if (task_info(mach_task_self(), TASK_VM_INFO, (task_info_t)&vm_info, &count) ==
            KERN_SUCCESS) {
            *out_bytes = (uint64_t)vm_info.phys_footprint;
            *out_source = "mach_phys";
            return 1;
        }
    }
#endif
    memset(&ru, 0, sizeof(ru));
    if (getrusage(RUSAGE_SELF, &ru) != 0) return 0;
#if defined(__APPLE__)
    *out_bytes = (uint64_t)ru.ru_maxrss;
#else
    *out_bytes = (uint64_t)ru.ru_maxrss * 1024ull;
#endif
    *out_source = "maxrss";
    return 1;
}

static size_t redis_mem_key_arenas_gross_B(const RedisDb* db) {
    size_t sum = 0;
    size_t i;
    if (!db || !db->shards) return 0;
    for (i = 0; i < db->shard_count; ++i)
        sum += cc_arena_committed_gross_bytes(&db->shards[i].key_arena);
    return sum;
}

static size_t redis_mem_arenas_gross_B(const RedisDb* db) {
    if (!db) return 0;
    return cc_arena_committed_gross_bytes(&db->map_arena) +
           redis_mem_key_arenas_gross_B(db) +
           cc_arena_committed_gross_bytes(&db->value_arena);
}

/* One machine-parseable line: footprint − (map+key+value live). Always on.
 * Remainder is runtime/fibers/overflow/frag/untracked — not a leak by itself. */
static void redis_mem_emit_gap(const RedisDb* db, const char* phase) {
    uint64_t footprint = 0;
    const char* source = "none";
    size_t map_live = redis_db_map_live_bytes(db);
    size_t key_live = db_mem_stats_live(CC_ATOMIC_LOAD(&g_db_mem_stats.key_alloc_bytes),
                                        CC_ATOMIC_LOAD(&g_db_mem_stats.key_release_bytes));
    size_t value_live = db_mem_stats_live(CC_ATOMIC_LOAD(&g_db_mem_stats.value_alloc_bytes),
                                          CC_ATOMIC_LOAD(&g_db_mem_stats.value_release_bytes));
    size_t logical = map_live + key_live + value_live;
    size_t arenas_gross = redis_mem_arenas_gross_B(db);
    size_t workers = redis_mem_worker_hint();
    uint64_t fiber_hint = (uint64_t)workers * (2ull << 20);
    int64_t gap = 0;
    if (!redis_mem_process_footprint_B(&footprint, &source)) return;
    gap = (int64_t)footprint - (int64_t)logical;
    fprintf(stderr,
            "redis_idiomatic: mem_gap phase=%s footprint_B=%llu source=%s logical_B=%zu "
            "gap_B=%lld map_B=%zu key_B=%zu value_B=%zu arenas_gross_B=%zu workers=%zu "
            "fiber_reserve_hint_B=%llu note=runtime+fibers+overflow+frag+untracked\n",
            phase ? phase : "?",
            (unsigned long long)footprint,
            source,
            logical,
            (long long)gap,
            map_live,
            key_live,
            value_live,
            arenas_gross,
            workers,
            (unsigned long long)fiber_hint);
}

/* Mach / map summary to stderr (no getenv gate).  Always ends with mem_gap. */
static void redis_mem_report_impl(const RedisDb* db, const char* tag) {
    struct rusage ru;
    uint64_t mach_phys_footprint = 0;
    int have_mach_footprint = 0;
    memset(&ru, 0, sizeof(ru));
    if (getrusage(RUSAGE_SELF, &ru) == 0) {
        fprintf(stderr,
                "redis_idiomatic: mem[%s] getrusage maxrss=%ld (%s)\n",
                tag ? tag : "?",
                (long)ru.ru_maxrss,
#if defined(__APPLE__)
                "bytes on Darwin"
#else
                "kilobytes on Linux/most Unix"
#endif
                );
    }
#if defined(__APPLE__)
    {
        struct task_vm_info vm_info;
        mach_msg_type_number_t count = TASK_VM_INFO_COUNT;
        if (task_info(mach_task_self(), TASK_VM_INFO, (task_info_t)&vm_info, &count) ==
            KERN_SUCCESS) {
            mach_phys_footprint = (uint64_t)vm_info.phys_footprint;
            have_mach_footprint = 1;
            fprintf(stderr,
                    "redis_idiomatic: mem[%s] mach resident=%llu phys_footprint=%llu\n",
                    tag ? tag : "?",
                    (unsigned long long)vm_info.resident_size,
                    (unsigned long long)vm_info.phys_footprint);
        }
    }
#endif
    fprintf(stderr,
            "redis_idiomatic: mem[%s] worker_hint=%zu sched_workers=%zu (fiber stacks: VM reserve "
            "~2MiB each, commit on touch; see cc/runtime/fiber_sched.c MCO_USE_VMEM_ALLOCATOR)\n",
            tag ? tag : "?",
            redis_mem_worker_hint(),
            cc_sched_get_num_workers());
    if (db && db->shards) {
        size_t n = redis_db_map_len(db);
        size_t cap = redis_db_map_buckets(db);
        size_t map_alloc = redis_db_map_live_bytes(db);
        fprintf(stderr,
                "redis_idiomatic: mem[%s] map shards=%zu len=%zu buckets=%zu "
                "live_bytes=%zu (sharded array_map)\n",
                tag ? tag : "?",
                db->shard_count,
                n,
                cap,
                map_alloc);
        fprintf(stderr,
                "redis_idiomatic: mem[%s] model: map/value shared + per-shard key arenas; "
                "fixed root+overflow; keys/values releasable individually\n",
                tag ? tag : "?");
        if (have_mach_footprint) {
            size_t map_live = map_alloc;
            size_t key_live = db_mem_stats_live(CC_ATOMIC_LOAD(&g_db_mem_stats.key_alloc_bytes),
                                                CC_ATOMIC_LOAD(&g_db_mem_stats.key_release_bytes));
            size_t value_live =
                db_mem_stats_live(CC_ATOMIC_LOAD(&g_db_mem_stats.value_alloc_bytes),
                                  CC_ATOMIC_LOAD(&g_db_mem_stats.value_release_bytes));
            size_t logical_live = key_live + value_live + map_live;
            if (logical_live > 0) {
                double ratio = (double)mach_phys_footprint / (double)logical_live;
                int64_t gap = (int64_t)mach_phys_footprint - (int64_t)logical_live;
                fprintf(stderr,
                        "redis_idiomatic: mem[%s] accounting: mach_phys_footprint=%llu B "
                        "logical_db_live=%zu B (ratio %.1fx; gap=%lld B ≈ runtime+fibers+libc; "
                        "map_live_bytes=%zu B)\n",
                        tag ? tag : "?",
                        (unsigned long long)mach_phys_footprint,
                        logical_live,
                        ratio,
                        (long long)gap,
                        map_alloc);
            } else {
                fprintf(stderr,
                        "redis_idiomatic: mem[%s] accounting: mach_phys_footprint=%llu B "
                        "logical_db_live=0 (empty db; map_live_bytes=%zu B)\n",
                        tag ? tag : "?",
                        (unsigned long long)mach_phys_footprint,
                        map_alloc);
            }
        }
    }
    redis_mem_emit_gap(db, tag);
}

/* Set CC_REDIS_MEM_REPORT=1 for verbose Mach/arena dump at owner-ready.
 * Compact mem_gap always prints (via report_impl or standalone). */
static void redis_mem_report(const RedisDb* db, const char* tag) {
    const char* want = getenv("CC_REDIS_MEM_REPORT");
    if (want && want[0]) {
        redis_mem_report_impl(db, tag);
        if (db && db->shards) {
            db_dump_mem_stats((RedisDb*)(void*)db, tag);
        }
        return;
    }
    redis_mem_emit_gap(db, tag);
}

/* Print each bump slab's capacity for `a`, newest (current root) first, then each
 * older extent via ->prev.  Matches cc_arena_slab_chain_bytes (sum of these). */
static void redis_db_fprint_arena_slab_chain_detail(const char* tag, const char* pool, const CCArena* a) {
    const CCArena* cur = a;
    fprintf(stderr, "redis_idiomatic: mem[%s] arena_%s_slab_sizes_B (root_first", tag ? tag : "db", pool);
    while (cur && cur->base) {
        fprintf(stderr, " %zu", cur->capacity);
        cur = cur->prev;
    }
    fprintf(stderr, ") sum=%zu\n", cc_arena_slab_chain_bytes(a));
}

static void db_dump_mem_stats(RedisDb* db, const char* tag) {
    size_t map_live = redis_db_map_live_bytes(db);
    size_t key_live = db_mem_stats_live(CC_ATOMIC_LOAD(&g_db_mem_stats.key_alloc_bytes),
                                        CC_ATOMIC_LOAD(&g_db_mem_stats.key_release_bytes));
    size_t value_live = db_mem_stats_live(CC_ATOMIC_LOAD(&g_db_mem_stats.value_alloc_bytes),
                                          CC_ATOMIC_LOAD(&g_db_mem_stats.value_release_bytes));
    size_t map_count = redis_db_map_len(db);
    size_t map_buckets = redis_db_map_buckets(db);
    fprintf(stderr,
            "redis_idiomatic: mem[%s] entries=%zu buckets=%zu keys allocs=%zu bytes=%zu live=%zu | "
            "values allocs=%zu bytes=%zu live=%zu | map_live=%zu | total_live=%zu\n",
            tag ? tag : "db",
            map_count,
            map_buckets,
            (size_t)CC_ATOMIC_LOAD(&g_db_mem_stats.key_alloc_count),
            (size_t)CC_ATOMIC_LOAD(&g_db_mem_stats.key_alloc_bytes),
            key_live,
            (size_t)CC_ATOMIC_LOAD(&g_db_mem_stats.value_alloc_count),
            (size_t)CC_ATOMIC_LOAD(&g_db_mem_stats.value_alloc_bytes),
            value_live,
            map_live,
            key_live + value_live + map_live);
    if (db) {
        size_t si;
        size_t k_slab = 0, k_ovf = 0, k_ext = 0, k_gross = 0;
        /* Arena roots (B): must match db_init() map/key/value heap-overflow roots. */
        fprintf(stderr,
                "redis_idiomatic: mem[%s] arena_initial_root_B map=%u(heap_overflow) "
                "key=%u(heap_overflow×%zu shards) value=%u(heap_overflow)\n",
                tag ? tag : "db",
                1024u,
                1024u,
                db->shard_count,
                1024u);
        redis_db_fprint_arena_slab_chain_detail(tag, "map", &db->map_arena);
        for (si = 0; db->shards && si < db->shard_count; ++si) {
            char pool[32];
            snprintf(pool, sizeof(pool), "key%zu", si);
            redis_db_fprint_arena_slab_chain_detail(tag, pool, &db->shards[si].key_arena);
            k_slab += cc_arena_slab_chain_bytes(&db->shards[si].key_arena);
            k_ovf += cc_arena_overflow_raw_bytes(&db->shards[si].key_arena);
            k_ext += cc_arena_extent_struct_bytes(&db->shards[si].key_arena);
            k_gross += cc_arena_committed_gross_bytes(&db->shards[si].key_arena);
        }
        redis_db_fprint_arena_slab_chain_detail(tag, "value", &db->value_arena);
        size_t m_slab = cc_arena_slab_chain_bytes(&db->map_arena);
        size_t m_ovf = cc_arena_overflow_raw_bytes(&db->map_arena);
        size_t m_ext = cc_arena_extent_struct_bytes(&db->map_arena);
        size_t m_gross = cc_arena_committed_gross_bytes(&db->map_arena);
        size_t v_slab = cc_arena_slab_chain_bytes(&db->value_arena);
        size_t v_ovf = cc_arena_overflow_raw_bytes(&db->value_arena);
        size_t v_ext = cc_arena_extent_struct_bytes(&db->value_arena);
        size_t v_gross = cc_arena_committed_gross_bytes(&db->value_arena);
        fprintf(stderr,
                "redis_idiomatic: mem[%s] arena_committed_B "
                "map slabs=%zu ovf=%zu ext_meta=%zu gross=%zu | "
                "key(sum) slabs=%zu ovf=%zu ext_meta=%zu gross=%zu | "
                "value slabs=%zu ovf=%zu ext_meta=%zu gross=%zu | "
                "db_arenas_gross_sum=%zu\n",
                tag ? tag : "db",
                m_slab,
                m_ovf,
                m_ext,
                m_gross,
                k_slab,
                k_ovf,
                k_ext,
                k_gross,
                v_slab,
                v_ovf,
                v_ext,
                v_gross,
                m_gross + k_gross + v_gross);
    }
}

#endif /* REDIS_IDIOMATIC_MEM_CCH */

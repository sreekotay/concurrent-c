/*
 * Tiny Redis: PING ECHO GET SET DEL EXISTS INCR MGET DBSIZE FLUSHDB.
 *
 * Lifetimes:
 *   Cmd.args      → clone_into(cmd arena) for one execute (not BufReader views)
 *   shard arenas  → durable keys/values (put copies; delete releases packed entries)
 *   Conn.out      → encode coalesce (8K stack slab, growable spill); flush
 *                   after shard release (never socket I/O under hold).
 *                   Format lines with @string(..., @scratch) then write into out
 *                   — scratch is stack-local; one append into the coalesce buf.
 *   ConnEnc (= @typeview Encode) → execute/exec_* encode-only (no sock/flush);
 *                   handle_client keeps Conn* for flush (draft_facets.md)
 *   encode/flush / read  → bool !>(CCIoError): client-fatal I/O
 *   execute              → bool !>(CCError): command/db; becomes -ERR
 *   CCShardHold   → acquire + @defer hold.release(); then if (!held()) …
 *                   release is a defined no-op when n==0 (cc_exclusive /
 *                   CCShardHold); defer-before-held-check is intentional,
 *                   not a double-unlock on admission failure.
 *                   Soft-return: return exec_*(...) runs before block defer.
 *
 * Caveats (sketch-ok):
 *   Mid-MGET encode failure after array_len is buffered ships a truncated
 *   RESP array. Connection dies on Err, so the client sees malformed
 *   protocol rather than a clean close on heap exhaustion — not worth
 *   two-phase encode here; just know it.
 *
 * Full server (same I/O shape, full command surface): redis_idiomatic.ccs.
 *
 * Build: `make redis_async_sketch`
 * Run:   ./out/redis_async_sketch [addr]   # default 127.0.0.1:6381
 */

#include <ccc/std/prelude.cch>
#include <ccc/cc_instantiate.cch>
#include <ccc/std/net.cch>
#include <ccc/std/map.cch>
#include <ccc/std/hash.cch>
#include <ccc/std/string.cch>
#include <ccc/std/shard_map.cch>
#include <ccc/cc_exclusive.cch>
#include <ccc/script/stdio.cch>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <signal.h>

#define K_READ_BUF   (16 * 1024)
#define K_CMD_ARENA  (64 * 1024)
#define K_OUT_BUF    (8 * 1024)
#define K_PIPELINE   16
#define K_MAX_ARGS   16
#define K_MAX_SHARDS 64

static const char* k_listen = "127.0.0.1:6381";

typedef enum Hold {
    HOLD_NONE = 0,
    HOLD_KEY,
    HOLD_KEYS,
    HOLD_ALL,
} Hold;

typedef struct DB {
    CCShardMap maps;
} DB;

typedef struct Cmd {
    char[:] args[K_MAX_ARGS];
    size_t argc;
} Cmd;

typedef struct Conn {
    CCSocket* sock;
    CCArena* arena; /* stack root + GROWABLE spill; reset on flush */
    CCString out;   /* contiguous encode buffer in arena */
} Conn;

/* Encode phase: methods only (no sock/flush; fields stay behind Conn* bodies). */
typedef @typeview Encode on Conn {
    r: write, lit, simple, err, ok, pong, null, integer, bulk, array_*;
} *ConnEnc;

static bool !>(CCIoError) write_all(CCSocket* sock, char[:] data) {
    @errhandler(CCError e) cc_error_exit(e);
    size_t off = 0;
    while (off < data.len) {
        size_t n = sock->write(data.ptr + off, data.len - off) !>(e) {
            return cc_err(e);
        };
        if (n == 0)
            return cc_err(cc_io_error(CC_ERROR(CC_ERR_CLOSED, "short write")));
        off += n;
    }
    return cc_ok(true);
}

static bool !>(CCIoError) conn_flush(Conn* c) {
    @errhandler(CCError e) cc_error_exit(e);
    char[:] data;
    if (!c || !c->arena)
        return cc_err(cc_io_error(CC_ERROR(CC_ERR_INVALID_ARG, "conn flush: null")));
    data = c->out.as_slice();
    if (data.len == 0) return cc_ok(true);
    /* LIFO: release handle, then reclaim the encode arena. */
    @defer c->arena->reset();
    @defer c->out.release(c->arena);
    write_all(c->sock, data) !>(e) { return cc_err(e); };
    return cc_ok(true);
}

/* Encode-only: never flush/socket — safe under a shard hold.
 * Format on @scratch (stack), then one append into Conn.out. */
static bool !>(CCError) conn_write(Conn* c, char[:] data) {
    if (!c || !c->arena)
        return cc_err(CC_ERR_INVALID_ARG, "conn encode: null");
    if (data.len == 0) return cc_ok(true);
    if (!c->out.append(data, c->arena) || c->out.failed())
        return cc_err(CC_ERR_OUT_OF_MEMORY, "conn encode oom");
    return cc_ok(true);
}

/* Fixed wire bytes → lit(char[:]) (lits → CC_SLICE_LIT). Interpolated → @string. */
static bool !>(CCError) conn_lit(Conn* c, char[:] s) {
    return c->write(s);
}

static bool !>(CCError) conn_simple(Conn* c, const char* s) {
    CCString line = @string(`+${s}\r\n`, @scratch);
    return c->write(line.as_slice());
}

static bool !>(CCError) conn_err(Conn* c, const char* s) {
    CCString line = @string(`-ERR ${s}\r\n`, @scratch);
    return c->write(line.as_slice());
}

static bool !>(CCError) conn_ok(Conn* c) { return c->lit("+OK\r\n"); }
static bool !>(CCError) conn_pong(Conn* c) { return c->lit("+PONG\r\n"); }
static bool !>(CCError) conn_null(Conn* c) { return c->lit("$-1\r\n"); }

static bool !>(CCError) conn_integer(Conn* c, int64_t v) {
    CCString line = @string(`:${v}\r\n`, @scratch);
    return c->write(line.as_slice());
}

static bool !>(CCError) conn_bulk(Conn* c, char[:] b) {
    @errhandler(CCError e) { return cc_err(e); }
    CCString hdr = @string(`$${b.len}\r\n`, @scratch);
    c->write(hdr.as_slice()) !>;
    c->write(b) !>;
    return c->lit("\r\n");
}

static bool !>(CCError) conn_array_len(Conn* c, size_t nkeys) {
    CCString hdr = @string(`*${nkeys}\r\n`, @scratch);
    return c->write(hdr.as_slice());
}

static bool db_init(DB* db, CCExclusive excl, CCShardMask mask) {
    CCShardMap* maps;
    if (!db) return false;
    memset(db, 0, sizeof(*db));
    maps = &db->maps;
    return maps->init(excl, mask);
}

static void db_free(DB* db) {
    if (!db) return;
    cc_shard_map_destroy(&db->maps);
    memset(db, 0, sizeof(*db));
}

static size_t shard_of(DB* db, char[:] key) {
    CCShardMap* maps = &db->maps;
    return maps->index(cc_hash_slice(key));
}

static Hold hold_for(char[:] name) {
    switch (name) {
    case "GET":
    case "SET":
    case "INCR":
        return HOLD_KEY;
    case "DEL":
    case "EXISTS":
    case "MGET":
        return HOLD_KEYS;
    case "DBSIZE":
    case "FLUSHDB":
        return HOLD_ALL;
    default:
        return HOLD_NONE;
    }
}

static bool !>(CCError) exec_incr(CCShard* sh, char[:] key,
                                  ConnEnc conn) {
    @errhandler(CCError e) cc_error_exit(e);
    CCString* v = sh->get(key);
    int64_t n = 0;
    if (v) {
        char[:] s = v->as_slice();
        int64_t parsed = s.to_i64() !>(e) {
            (void)e;
            return conn->err("value is not an integer");
        };
        n = parsed;
    }
    n++;
    CCString num = @string(`${n}`, @scratch);
    if (!sh->put(key, num.as_slice())) return conn->err("oom");
    return conn->integer(n);
}

static bool !>(CCError) exec_key(DB* db, Cmd* c, size_t si,
                                 ConnEnc conn) {
    CCShardMap* maps = &db->maps;
    CCShard* sh = maps->shard(si);
    char[:] name = c->args[0];
    char[:] key = c->args[1];
    CCString* v;

    if (!sh) return conn->err("internal");
    switch (name) {
    case "GET":
        v = sh->get(key);
        if (!v) return conn->null();
        return conn->bulk(v->as_slice());
    case "SET":
        if (c->argc < 3) return conn->err("wrong number of arguments");
        if (!sh->put(key, c->args[2])) return conn->err("oom");
        return conn->ok();
    case "INCR":
        return exec_incr(sh, key, conn);
    default:
        return conn->err("internal");
    }
}

static bool !>(CCError) exec_keys(DB* db, Cmd* c,
                                  ConnEnc conn) {
    @errhandler(CCError e) { return cc_err(e); }
    CCShardMap* maps = &db->maps;
    char[:] name = c->args[0];
    size_t i, nkeys;
    int64_t n;
    CCShard* sh;
    CCString* v;

    switch (name) {
    case "DEL":
        n = 0;
        for (i = 1; i < c->argc; i++) {
            sh = maps->shard(shard_of(db, c->args[i]));
            if (sh && sh->delete(c->args[i])) n++;
        }
        return conn->integer(n);
    case "EXISTS":
        n = 0;
        for (i = 1; i < c->argc; i++) {
            sh = maps->shard(shard_of(db, c->args[i]));
            if (sh && sh->get(c->args[i])) n++;
        }
        return conn->integer(n);
    case "MGET":
        /* Header first: a later bulk Err leaves a truncated array on the
         * wire (conn closes). Acceptable for this sketch. */
        nkeys = c->argc - 1;
        conn->array_len(nkeys) !>;
        for (i = 1; i < c->argc; i++) {
            sh = maps->shard(shard_of(db, c->args[i]));
            v = sh ? sh->get(c->args[i]) : NULL;
            if (!v) conn->null() !>;
            else conn->bulk(v->as_slice()) !>;
        }
        return cc_ok(true);
    default:
        return conn->err("internal");
    }
}

static bool !>(CCError) exec_all(DB* db, Cmd* c,
                                 ConnEnc conn) {
    CCShardMap* maps = &db->maps;
    char[:] name = c->args[0];
    switch (name) {
    case "DBSIZE":
        return conn->integer((int64_t)maps->len());
    case "FLUSHDB":
        if (!maps->reset()) return conn->err("oom");
        return conn->ok();
    default:
        return conn->err("internal");
    }
}

static size_t unique_shards(DB* db, Cmd* c, uint64_t* names, size_t cap) {
    size_t n = 0, i, j;
    for (i = 1; i < c->argc; i++) {
        uint64_t si = (uint64_t)shard_of(db, c->args[i]);
        int seen = 0;
        for (j = 0; j < n; j++) {
            if (names[j] == si) {
                seen = 1;
                break;
            }
        }
        if (!seen && n < cap) names[n++] = si;
    }
    return n;
}

/* Encode phase only — ship (flush/sock) stays on Conn* in handle_client. */
static bool !>(CCError) execute(DB* db, Cmd* c,
                                ConnEnc conn) {
    Hold h = HOLD_NONE;
    char[:] name;
    size_t i;

    if (c->argc == 0) return conn->err("empty command");
    name = c->args[0];
    /* Fold for string-switch; names are tiny (GET/MGET/…). */
    for (i = 0; i < name.len; i++)
        if (name.ptr[i] >= 'a' && name.ptr[i] <= 'z') name.ptr[i] -= 32;
    switch (name) {
    case "PING":
        if (c->argc > 1) return conn->bulk(c->args[1]);
        return conn->pong();
    case "ECHO":
        if (c->argc < 2) return conn->err("wrong number of arguments");
        return conn->bulk(c->args[1]);
    default:
        break;
    }
    h = hold_for(name);
    if (h == HOLD_NONE) return conn->err("unknown command");

    CCShardMap* maps = &db->maps;
    if (h == HOLD_KEY) {
        size_t si;
        if (c->argc < 2) return conn->err("wrong number of arguments");
        si = shard_of(db, c->args[1]);
        CCShardHold hold = maps->hold_one((uint64_t)si);
        @defer hold.release();
        if (!hold.held()) return conn->err("shard admission failed");
        return exec_key(db, c, si, conn);
    }
    if (h == HOLD_KEYS) {
        uint64_t names[K_MAX_SHARDS];
        size_t nnames;
        if (c->argc < 2) return conn->err("wrong number of arguments");
        nnames = unique_shards(db, c, names, (size_t)K_MAX_SHARDS);
        CCShardHold hold = maps->hold_sorted(names, nnames);
        @defer hold.release();
        if (!hold.held()) return conn->err("shard admission failed");
        return exec_keys(db, c, conn);
    }
    {
        CCShardHold hold = maps->hold_all();
        @defer hold.release();
        if (!hold.held()) return conn->err("shard admission failed");
        return exec_all(db, c, conn);
    }
}

static bool !>(CCIoError) read_cmd(BufReader::[CCSocket]* br, CCArena* arena, Cmd* out) {
    @errhandler(CCError e) cc_error_exit(e);
    for (;;) {
        size_t i, start, end;
        memset(out, 0, sizeof(*out));

        char[:] line = br->read_line() !>(e) { return cc_err(e); };
        if (line.len == 0) {
            if (br->eof) return cc_ok(false);
            continue;
        }

        if (line.ptr[0] != '*') {
            start = 0;
            while (start < line.len && out->argc < (size_t)K_MAX_ARGS) {
                while (start < line.len && line.ptr[start] == ' ') start++;
                if (start >= line.len) break;
                end = start;
                while (end < line.len && line.ptr[end] != ' ') end++;
                char[:] part = line.sub(start, end);
                char[:] owned = part.clone_into(arena) !>(e) {
                    return cc_err(cc_io_error(e));
                };
                out->args[out->argc++] = owned;
                start = end;
            }
            if (out->argc == 0) continue;
            return cc_ok(true);
        }

        char[:] argc_s = line.sub(1, line.len);
        int64_t n = argc_s.to_i64() !>(e) {
            (void)e;
            return cc_err(cc_io_error(CC_ERROR(CC_ERR_INVALID_ARG, "bad argc")));
        };
        if (n < 0 || n > K_MAX_ARGS)
            return cc_err(cc_io_error(CC_ERROR(CC_ERR_INVALID_ARG, "bad argc")));
        if (n == 0) continue;
        for (i = 0; i < (size_t)n; i++) {
            char[:] hdr = br->read_line() !>(e) { return cc_err(e); };
            if (hdr.len == 0 || hdr.ptr[0] != '$')
                return cc_err(cc_io_error(CC_ERROR(CC_ERR_INVALID_ARG, "bad bulk")));
            char[:] blen_s = hdr.sub(1, hdr.len);
            int64_t blen = blen_s.to_i64() !>(e) {
                (void)e;
                return cc_err(cc_io_error(CC_ERROR(CC_ERR_INVALID_ARG, "bad bulk")));
            };
            if (blen < 0 || blen > (int64_t)K_CMD_ARENA)
                return cc_err(cc_io_error(CC_ERROR(CC_ERR_INVALID_ARG, "bad bulk")));

            char[:] payload = br->read_exact((size_t)blen + 2) !>(e) {
                return cc_err(e);
            };
            char[:] part = payload.sub(0, (size_t)blen);
            char[:] owned = part.clone_into(arena) !>(e) {
                return cc_err(cc_io_error(e));
            };
            out->args[out->argc++] = owned;
        }
        return cc_ok(true);
    }
}

static void handle_client(CCSocket client, DB* db) {
    @errhandler(CCError e) cc_error_exit(e);
    char read_buf[K_READ_BUF];
    char cmd_buf[K_CMD_ARENA];
    char out_slab[K_OUT_BUF];
    BufReader::[CCSocket] br;
    CCArena arena =
        cc_arena_create_buffer(out_slab, sizeof(out_slab), CC_ARENA_GROWABLE)
        @destroy;
    Conn conn = { .sock = &client, .arena = &arena, .out = cc_string_new() };
    @defer client.close();
    @defer conn.flush() !>(e) { (void)e; }; /* exit-only; errors swallowed */
    br.init(&client, read_buf, sizeof(read_buf));

    for (;;) {
        size_t i;
        for (i = 0; i < (size_t)K_PIPELINE; i++) {
            Cmd c;
            if (i > 0 && br.buffered() == 0) break;
            CCArena cmd_a = @create(cmd_buf, sizeof(cmd_buf)) @destroy;

            bool ok = read_cmd(&br, &cmd_a, &c) !>(e) {
                if (i == 0 && e.base.kind != CC_ERR_CLOSED)
                    conn.err(cc_io_error_str(e)) !>(e2) { (void)e2; };
                return;
            };
            if (!ok) return;
            execute(db, &c, &conn) !>(e) {
                (void)e;
                return;
            };
        }
        /* Steady-state: checked ship (defer alone would swallow write failure). */
        conn.flush() !>(e) {
            (void)e;
            return;
        };
    }
}

int main(int argc, char** argv) {
    @errhandler(CCError e) { cc_error_log(e); return 1; }

    const char* addr = argc > 1 ? argv[1] : k_listen;
    DB db = {0};
    CCShardMask mask = cc_shard_mask_auto((size_t)K_MAX_SHARDS);

    CCArena excl_arena = @create(kilobytes(64)) @destroy;
    CCExclusive excl = cc_exclusive_create(&excl_arena, mask.count * 2u) !> @destroy;

    if (!db_init(&db, excl, mask)) {
        eprintln("redis_async_sketch: db_init failed") !>;
        return 1;
    }
    @defer db_free(&db);

    CCListener ln = cc_tcp_listen(cc_slice_cstr(addr)) !>(e) {
        eprintln(@string(`listen: ${e}`, @scratch)) !>;
        return 1;
    };
    @defer ln.close();

    size_t nshards = db.maps.count();
    println(@string(`redis-async-sketch on ${addr} shards=${nshards}`,
                    @scratch)) !>;

    /* !> @destroy joins (wait-then-free); cancel unparks accept. */
    CCNursery server = cc_nursery_create() !> @destroy;
    server.cancel_on_signals(SIGINT, SIGTERM) !>;

    server.spawn(() => [@safe &db, @safe &ln, server] {
        ln.serve(server, (CCSocket* accepted) => [@safe &db, server] {
            CCSocket client = *accepted;
            (void)client.set_nodelay(1);
            server.spawn(() => [@safe &db, client] {
                handle_client(client, &db);
            });
        });
    });
    return 0;
}

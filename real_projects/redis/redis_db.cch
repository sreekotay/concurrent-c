/*
 * redis_db.cch — the Redis DB layer shared by redis_idiomatic.ccs and
 * redis_owner.ccs: storage structs/arenas, mem-stat accounting, key/value
 * ops (db_set/db_get/...), lazy expiry, preload, and teardown.
 *
 * Implementation-grade header: the compiler splices it into each including
 * TU before canonicalize (it carries @variant/@errhandler/!> bodies), so
 * every variant compiles its own static copy, C header-library style.
 *
 * Concurrency-agnostic: nothing in here synchronizes.  The including
 * variant owns serialization — redis_idiomatic.ccs by per-shard (or
 * all-shard) named exclusive locks; redis_owner.ccs by one owner fiber
 * (always init with shard_count=1).
 *
 * Include AFTER redis_cc/redis_cc.cch (types) and redis_reply.cch
 * (Resp write schemas + reply_* builders db_* speak).
 */
#ifndef REDIS_DB_CCH
#define REDIS_DB_CCH

/* Arenas: shared map/value (table blob + CCString backing); per-shard key
 * arenas so concurrent shard inserts never share an allocator.
 * Map/value use fixed-root + per-object malloc overflow (individual free).
 * Keys use growable slabs — redis-benchmark keys are ~16B (heap-form packed),
 * and one-malloc-per-key destroys probe locality at large N. DEL of a key
 * is logical until FLUSH/destroy (slab bump); FLUSH still tears the arena. */

/* Probe key: stack borrow of request bytes (not durable — do not insert). */
static inline CCSlicePacked db_key_packed_borrow(CCSlicePackedView* view, char[:] key) {
    return cc_slice_packed_borrow_slice(view, key);
}

/* .str = SET bytes; .num = INCR-family ints (no text round-trip).  Read
 * boundaries render .num to canonical decimal. */
@variant(packed) RedisValue {
    str: CCString;
    num: int64_t;
};

/* Value only in the main map.  Absolute expire deadlines live in `expires`
 * (Redis-style side table): keys without TTL pay no per-entry int64. */
typedef struct RedisEntry {
    RedisValue val;
} RedisEntry;

/* Keys are CCSlicePacked (8B): dense rows stay narrow; empty probe slots 4 B. */
typedef ArrayMap::[CCSlicePacked, RedisEntry] RedisDbMap;
/* key → absolute expire ms; absent / missing ⇒ no TTL. */
typedef ArrayMap::[CCSlicePacked, int64_t] RedisExpiresMap;

/* One hash shard: entries + expires + key bytes for that shard. */
typedef struct RedisDbShard {
    RedisDbMap entries;
    RedisExpiresMap expires;
    CCArena key_arena;
} RedisDbShard;

enum { REDIS_DB_MAX_SHARDS = 64 };

typedef struct RedisDb {
    CCArena map_arena;
    CCArena value_arena;
    size_t shard_count; /* power of two, 1..REDIS_DB_MAX_SHARDS */
    size_t shard_mask;  /* shard_count - 1 */
    RedisDbShard* shards;
} RedisDb;

/* Key → shard index (same hash as ArrayMap key routing). */
static size_t db_shard_index_for_hash(const RedisDb* db, size_t hash) {
    if (!db || db->shard_count == 0) return 0;
    return hash & db->shard_mask;
}

static size_t db_shard_index_for_key(const RedisDb* db, char[:] key) {
    CCSlicePackedView view;
    CCSlicePacked kh;
    if (!db || db->shard_count == 0) return 0;
    kh = db_key_packed_borrow(&view, key);
    return db_shard_index_for_hash(db, cc_map_hash_slice_packed(kh));
}

static size_t db_shard_index_for_packed(const RedisDb* db, CCSlicePacked kh) {
    if (!db || db->shard_count == 0) return 0;
    return db_shard_index_for_hash(db, cc_map_hash_slice_packed(kh));
}

static RedisDbShard* db_shard_at(RedisDb* db, size_t i) {
    if (!db || !db->shards || i >= db->shard_count) return NULL;
    return &db->shards[i];
}

static RedisDbShard* db_shard_for_key(RedisDb* db, char[:] key) {
    return db_shard_at(db, db_shard_index_for_key(db, key));
}

typedef struct RedisDbMemStats {
    /* Atomic: shards update concurrently under per-shard exclusive holds. */
    cc_atomic_size key_alloc_count;
    cc_atomic_size key_alloc_bytes;
    cc_atomic_size key_release_count;
    cc_atomic_size key_release_bytes;
    cc_atomic_size value_alloc_count;
    cc_atomic_size value_alloc_bytes;
    cc_atomic_size value_release_count;
    cc_atomic_size value_release_bytes;
} RedisDbMemStats;

static RedisDbMemStats g_db_mem_stats;

#include "redis_mem.cch"
#include "redis_glob.cch"

static size_t db_string_cap_8x(size_t len) {
    size_t need = len + 1; /* Keep room for the trailing NUL. */
    if (need < len) return 0;
    size_t rem = need & 7;
    if (rem == 0) return need;
    size_t rounded = need + (8 - rem);
    if (rounded < need) return 0;
    return rounded;
}

static CCString !>(CCError) db_clone_value_into_arena(CCArena* arena,
                                                      char[:] src,
                                                      const char* err_msg) {
    size_t cap = db_string_cap_8x(src.len);
    if (cap == 0) return cc_err(CC_ERROR(CC_ERR_OUT_OF_MEMORY, err_msg));
    CCString cloned = cc_string_new();
    if (!cloned.reserve(cap, arena)) {
        return cc_err(CC_ERROR(CC_ERR_OUT_OF_MEMORY, err_msg));
    }
    if (cloned.push_slice(src, arena) == NULL) {
        return cc_err(CC_ERROR(CC_ERR_OUT_OF_MEMORY, err_msg));
    }
    if (cloned.heap_data()) db_mem_stats_note_value_alloc(cloned.cap());
    return cc_ok(cloned);
}

static bool db_init_overflow_arena(CCArena* a, size_t root_bytes) {
    *a = cc_arena_malloc(root_bytes);
    return a->valid();
}

/* Growable slabs for durable packed keys (locality under find_dense_h). */
static bool db_init_key_arena(CCArena* a, size_t root_bytes) {
    *a = cc_arena_heap(root_bytes);
    return a->valid();
}

static void db_destroy_shard_key_arenas(RedisDb* db) {
    size_t i;
    if (!db || !db->shards) return;
    for (i = 0; i < db->shard_count; ++i) {
        db->shards[i].key_arena.destroy();
    }
}

static void db_free_arenas_only(RedisDb* db) {
    if (!db) return;
    db_destroy_shard_key_arenas(db);
    db->map_arena.destroy();
    db->value_arena.destroy();
}

/* `shard_count` must be a power of two in 1..REDIS_DB_MAX_SHARDS.
 * Per-shard bucket hint is bucket_count / shard_count (min 8). */
static bool db_init(RedisDb* db, size_t bucket_count, size_t shard_count) {
    size_t i;
    size_t per_shard;
    if (!db || bucket_count == 0) return false;
    if (shard_count == 0 || shard_count > (size_t)REDIS_DB_MAX_SHARDS) return false;
    if ((shard_count & (shard_count - 1u)) != 0) return false;
    const size_t map_value_heap_root = 1024;
    /* ~1MiB/shard root: ~50k×16B keys before a new slab; grows as needed. */
    const size_t key_arena_root = megabytes(1);
    memset(db, 0, sizeof(*db));
    db->shard_count = shard_count;
    db->shard_mask = shard_count - 1u;
    if (!db_init_overflow_arena(&db->map_arena, map_value_heap_root)) return false;
    if (!db_init_overflow_arena(&db->value_arena, map_value_heap_root)) {
        db_free_arenas_only(db);
        return false;
    }
    db->shards = (RedisDbShard*)cc_arena_alloc(&db->map_arena,
                                               shard_count * sizeof(RedisDbShard),
                                               _Alignof(RedisDbShard));
    if (!db->shards) {
        db_free_arenas_only(db);
        return false;
    }
    memset(db->shards, 0, shard_count * sizeof(RedisDbShard));
    per_shard = bucket_count / shard_count;
    if (per_shard < 8u) per_shard = 8u;
    for (i = 0; i < shard_count; ++i) {
        if (!db_init_key_arena(&db->shards[i].key_arena, key_arena_root))
            goto fail;
        db->shards[i].entries =
            array_map_new_count::[CCSlicePacked, RedisEntry](&db->map_arena, per_shard);
        if (!db->shards[i].entries) goto fail;
        /* Side expires dict starts small; grows only for keys that get a TTL. */
        db->shards[i].expires = array_map_new::[CCSlicePacked, int64_t](&db->map_arena);
        if (!db->shards[i].expires) goto fail;
    }
    return true;
fail:
    for (i = 0; i < shard_count; ++i) {
        RedisDbShard* sh = &db->shards[i];
        if (sh->expires) {
            sh->expires->destroy();
            sh->expires = NULL;
        }
        if (sh->entries) {
            sh->entries->destroy();
            sh->entries = NULL;
        }
    }
    db_destroy_shard_key_arenas(db);
    db->shards = NULL;
    db->map_arena.destroy();
    db->value_arena.destroy();
    return false;
}

static void db_release_value(RedisDb* db, CCString* value) {
    if (!db || !value) return;
    if (value->heap_data()) {
        CCStringHeapHeader* header = cc__string_heap_header(value);
        db_mem_stats_note_value_release(value->cap());
        /* Malloc-backed heap string (header->arena is dead). */
        if (header && !cc_arena_is_live(header->arena)) {
            free(header);
            *value = (CCString){0};
            return;
        }
    }
    value->release(&db->value_arena);
}

/* Replace path for an existing STR-arm payload.  In-place overwrite when
 * the new value fits the old capacity — the happy case for constant-width
 * SET benchmarks.  Growing values clone a replacement into db->value_arena
 * and release the superseded buffer. */
static void !>(CCError) db_value_replace(RedisDb* db, CCString* cell, char[:] value) {
    @errhandler(CCError e) { return cc_err(e); }
    if (!cell) return cc_err(CC_ERROR(CC_ERR_INVALID_ARG, "db replace without entry"));
    if (value.len + 1 <= cell->cap()) {
        if (!cell->clear()) {
            return cc_err(CC_ERROR(CC_ERR_OUT_OF_MEMORY, "entry value clear failed"));
        }
        if (!cell->push_slice(value, &db->value_arena)) {
            return cc_err(CC_ERROR(CC_ERR_OUT_OF_MEMORY, "entry value replace failed"));
        }
        return cc_ok();
    }
    CCString replacement =
        db_clone_value_into_arena(&db->value_arena, value, "entry value clone failed") !>;
    db_release_value(db, cell);
    *cell = replacement;
    return cc_ok();
}

/* Store `value` bytes as the entry's str arm.  A str cell keeps the
 * in-place-overwrite fast path (db_value_replace); a num cell owns no
 * buffer, so the bytes clone fresh and the one-line transition installs
 * the str arm (nothing to drop: int64 carries no destructor). */
static void !>(CCError) db_entry_store_str(RedisDb* db, RedisValue* val, char[:] value) {
    @errhandler(CCError e) { return cc_err(e); }
    if (val->kind == .str) {
        db_value_replace(db, &val->str, value) !>;
        return cc_ok();
    }
    CCString cloned =
        db_clone_value_into_arena(&db->value_arena, value, "entry value clone failed") !>;
    *val = { .str = cloned };
    return cc_ok();
}

static RedisEntry* db_find_entry(RedisDb* db, char[:] key) {
    CCSlicePackedView view;
    CCSlicePacked kh;
    size_t h;
    RedisDbShard* sh;
    if (!db || !db->shards) return NULL;
    kh = db_key_packed_borrow(&view, key);
    h = cc_map_hash_slice_packed(kh);
    sh = db_shard_at(db, db_shard_index_for_hash(db, h));
    if (!sh || !sh->entries) return NULL;
    return sh->entries->get_ptr_h(kh, h);
}

/* ---- lazy expiration ----
 * One wall-clock sample per command: the command boundary owns a DbCmdClock
 * (`DbCmdClock clock = {0}`) and every expiry-aware helper reads through
 * `clock->now()` (UFCS → db_cmd_clock_now), so a command sees a single
 * consistent "now" (and the no-TTL hot path never touches the clock).
 * Deadlines are absolute wall milliseconds; 0 = none. */
typedef struct DbCmdClock {
    int64_t now_ms;
    bool sampled;
} DbCmdClock;

static int64_t redis_now_ms(void) {
    struct timespec ts;
    clock_gettime(CLOCK_REALTIME, &ts);
    return (int64_t)ts.tv_sec * 1000 + (int64_t)(ts.tv_nsec / 1000000);
}

/* UFCS: clock->now() */
static int64_t db_cmd_clock_now(DbCmdClock* clock) {
    if (!clock->sampled) {
        clock->now_ms = redis_now_ms();
        clock->sampled = true;
    }
    return clock->now_ms;
}

static CCSlicePacked !>(CCError) db_clone_key_packed(RedisDb* db, char[:] key) {
    @errhandler(CCError e) { return cc_err(e); }
    RedisDbShard* sh;
    if (!db) return cc_err(CC_ERROR(CC_ERR_INVALID_ARG, "db key clone without db"));
    sh = db_shard_for_key(db, key);
    if (!sh) return cc_err(CC_ERROR(CC_ERR_INVALID_ARG, "db key clone without shard"));
    CCSlicePacked !>(CCError) rr = key.to_packed(&sh->key_arena);
    if (rr.is_err()) return cc_err(rr.error());
    return cc_ok(rr.value());
}

/* Heap-form keys return via the owning shard's key arena; inline/empty no-op. */
static void db_release_key_packed(RedisDb* db, CCSlicePacked* k) {
    RedisDbShard* sh;
    if (!db || !k) return;
    if (cc_slice_packed_is_empty(k) || cc_slice_packed_is_inline(k) ||
        cc_slice_packed_is_view(k)) {
        /* Clear via release helper (packed `.w` store is restricted). */
        cc_slice_packed_release(NULL, k);
        return;
    }
    sh = db_shard_at(db, db_shard_index_for_packed(db, *k));
    if (!sh) return;
    cc_slice_packed_release(&sh->key_arena, k);
}

static int64_t db_expires_get(RedisDb* db, CCSlicePacked kh) {
    int64_t* p;
    size_t h;
    RedisDbShard* sh;
    /* No-TTL workloads: skip the side-map probe when the table is empty. */
    if (!db || !db->shards) return 0;
    h = cc_map_hash_slice_packed(kh);
    sh = db_shard_at(db, db_shard_index_for_hash(db, h));
    if (!sh || !sh->expires || sh->expires->len() == 0) return 0;
    p = sh->expires->get_ptr_h(kh, h);
    return p ? *p : 0;
}

static int64_t db_expires_get_key(RedisDb* db, char[:] key) {
    CCSlicePackedView view;
    return db_expires_get(db, db_key_packed_borrow(&view, key));
}

static bool db_key_expired(RedisDb* db, char[:] key, DbCmdClock* clock) {
    int64_t exp = db_expires_get_key(db, key);
    if (exp == 0) return false;
    return clock->now() >= exp;
}

/* Set absolute deadline; when==0 clears TTL.  New TTL keys clone into key_arena
 * when the side table does not already share the entries key word (side-table
 * key bytes are not double-counted in key_alloc mem stats). */
static void !>(CCError) db_expires_set(RedisDb* db, char[:] key, int64_t when) {
    @errhandler(CCError e) { return cc_err(e); }
    CCSlicePackedView view;
    CCSlicePacked kh = db_key_packed_borrow(&view, key);
    size_t h = cc_map_hash_slice_packed(kh);
    RedisDbShard* sh = db_shard_at(db, db_shard_index_for_hash(db, h));
    if (!db || !sh || !sh->expires) {
        return cc_err(CC_ERROR(CC_ERR_INVALID_ARG, "db expires without map"));
    }
    if (when == 0) {
        /* Plain SET / overwrite with no TTL: if this shard never stored a
         * deadline, skip the expires probe (redis-benchmark SET path). */
        size_t xb = 0;
        size_t xdi;
        if (sh->expires->len() == 0) return cc_ok();
        xdi = sh->expires->find_dense_h(kh, h, &xb);
        if (xdi != SIZE_MAX) {
            CCSlicePacked exp_owned = *sh->expires->key_ptr(xdi);
            uintptr_t entry_w = 0;
            if (sh->entries) {
                CCSlicePacked* ek = sh->entries->find_key_ptr_h(kh, h);
                if (ek) entry_w = ek->w;
            }
            (void)sh->expires->del_at(xdi, xb);
            /* Shared insert path reused the entries word — do not double-free. */
            if (exp_owned.w && exp_owned.w != entry_w)
                db_release_key_packed(db, &exp_owned);
        }
        return cc_ok();
    }
    {
        int64_t* p = sh->expires->get_ptr_h(kh, h);
        if (p) {
            *p = when;
            return cc_ok();
        }
    }
    CCSlicePacked owned = db_clone_key_packed(db, key) !>;
    if (sh->expires->insert(owned, when) != 0) {
        db_release_key_packed(db, &owned);
        return cc_err(CC_ERROR(CC_ERR_OUT_OF_MEMORY, "db expires insert failed"));
    }
    return cc_ok();
}

/* Remove one entry: value released, key accounted, and heap key bytes returned
 * to the key arena (overflow malloc).  Expires may share the entries key word
 * or own a separate clone — free the clone only when distinct. */
static void db_remove_entry(RedisDb* db, char[:] key, RedisEntry* cell) {
    RedisValue* val = &cell->val;
    CCString doomed = val->str ?> cc_string_new();  /* num arms own no bytes */
    CCSlicePackedView view;
    CCSlicePacked kh = db_key_packed_borrow(&view, key);
    size_t h = cc_map_hash_slice_packed(kh);
    RedisDbShard* sh = db_shard_at(db, db_shard_index_for_hash(db, h));
    CCSlicePacked entry_key = cc_slice_packed_empty();
    CCSlicePacked exp_key = cc_slice_packed_empty();
    size_t eb = 0;
    size_t edi;
    uintptr_t entry_w;
    if (!sh || !sh->entries) return;
    edi = sh->entries->find_dense_h(kh, h, &eb);
    if (edi == SIZE_MAX) return;
    entry_key = *sh->entries->key_ptr(edi);
    if (sh->expires && sh->expires->len() > 0) {
        size_t xb = 0;
        size_t xdi = sh->expires->find_dense_h(kh, h, &xb);
        if (xdi != SIZE_MAX) {
            exp_key = *sh->expires->key_ptr(xdi);
            (void)sh->expires->del_at(xdi, xb);
        }
    }
    if (!sh->entries->del_at(edi, eb)) return;
    entry_w = entry_key.w;
    db_mem_stats_note_key_release(key.len);
    db_release_key_packed(db, &entry_key);
    if (exp_key.w && exp_key.w != entry_w)
        db_release_key_packed(db, &exp_key);
    db_release_value(db, &doomed);
}

/* THE read path: every command that touches a key goes through here so
 * expired entries die on first contact (lazy expiration, no active cycle).
 * One hash serves entries + expires; empty expires skips the side probe. */
static RedisEntry* db_lookup_live(RedisDb* db, char[:] key, DbCmdClock* clock) {
    CCSlicePackedView view;
    CCSlicePacked kh;
    size_t h;
    RedisDbShard* sh;
    RedisEntry* cell;
    if (!db || !db->shards) return NULL;
    kh = db_key_packed_borrow(&view, key);
    h = cc_map_hash_slice_packed(kh);
    sh = db_shard_at(db, db_shard_index_for_hash(db, h));
    if (!sh || !sh->entries) return NULL;
    cell = sh->entries->get_ptr_h(kh, h);
    if (!cell) return NULL;
    if (sh->expires && sh->expires->len() > 0) {
        int64_t* ep = sh->expires->get_ptr_h(kh, h);
        if (ep && *ep != 0 && clock->now() >= *ep) {
            db_remove_entry(db, key, cell);
            return NULL;
        }
    }
    return cell;
}

static void !>(CCError) db_insert_value(RedisDb* db, CCSlicePacked owned_key, RedisEntry entry) {
    RedisDbShard* sh;
    size_t before;
    if (!db || !db->shards) {
        return cc_err(CC_ERROR(CC_ERR_INVALID_ARG, "db insert without entry"));
    }
    sh = db_shard_at(db, db_shard_index_for_packed(db, owned_key));
    if (!sh || !sh->entries) {
        return cc_err(CC_ERROR(CC_ERR_INVALID_ARG, "db insert without entry"));
    }
    before = sh->entries->len();
    if (sh->entries->insert(owned_key, entry) != 0) {
        return cc_err(CC_ERROR(CC_ERR_OUT_OF_MEMORY, "db insert failed"));
    }
    if (sh->entries->len() > before) {
        db_mem_stats_note_key_alloc((size_t)cc_slice_packed_len(&owned_key));
    } else {
        /* Replace path: map kept the prior key word; free the unused clone. */
        db_release_key_packed(db, &owned_key);
    }
    return cc_ok();
}

/* Create path shared by db_set and db_incrby's fresh-key arm: clone the
 * key, insert the entry, account the key bytes.  On insert failure a
 * str-arm payload is released; num arms own nothing. */
static void !>(CCError) db_insert_new_entry(RedisDb* db, char[:] key,
                                            RedisValue val, int64_t expires_at_ms) {
    @errhandler(CCError e) { return cc_err(e); }
    CCSlicePacked owned_key = db_clone_key_packed(db, key) !>;
    RedisEntry entry;
    entry.val = val;
    db_insert_value(db, owned_key, entry) !>(e) {
        RedisValue* pv = &entry.val;
        CCString doomed = pv->str ?> cc_string_new();
        db_release_value(db, &doomed);
        db_release_key_packed(db, &owned_key);
        return cc_err(e);
    };
    if (expires_at_ms != 0) {
        /* Reuse the same durable key word in the side table (no second clone). */
        RedisDbShard* sh = db_shard_at(db, db_shard_index_for_packed(db, owned_key));
        if (!sh || !sh->expires || sh->expires->insert(owned_key, expires_at_ms) != 0) {
            return cc_err(CC_ERROR(CC_ERR_OUT_OF_MEMORY, "db expires insert failed"));
        }
    }
    return cc_ok();
}

/* Write path shared by SET/SETEX/PSETEX/MSET (and the create arms of
 * SETNX/APPEND/INCR).  `expires_at_ms` is the entry's NEW absolute deadline
 * (0 = none): a plain SET overwriting a key with a TTL clears that TTL,
 * per redis semantics.  An expired-but-unreaped cell is safe to overwrite
 * in place — that IS its reap. */
/* Ok = stored; caller encodes +OK / integer as appropriate. */
static void !>(CCError) db_set(RedisDb* db, char[:] key, char[:] value,
                               int64_t expires_at_ms) {
    @errhandler(CCError e) { return cc_err(e); }
    if (!db || !db->shards) return cc_err(CC_ERROR(CC_ERR_OUT_OF_MEMORY, "db lookup failed"));

    RedisEntry* cell = db_find_entry(db, key);
    if (cell) {
        db_entry_store_str(db, &cell->val, value) !>;
        /* Clearing TTL is a no-op when the shard has no expire rows and the
         * caller asked for none — avoid a second hash probe on every SET. */
        if (expires_at_ms != 0) {
            db_expires_set(db, key, expires_at_ms) !>;
        } else {
            RedisDbShard* sh = db_shard_for_key(db, key);
            if (sh && sh->expires && sh->expires->len() > 0)
                db_expires_set(db, key, 0) !>;
        }
        return cc_ok();
    }

    CCString owned_str =
        db_clone_value_into_arena(&db->value_arena, value, "entry value clone failed") !>;
    db_insert_new_entry(db, key, (RedisValue){ .str = owned_str }, expires_at_ms) !>;
    return cc_ok();
}

/* GET: num cells render at the boundary (arena-less @string → reply_arena). */
static RedisReply !>(CCError) db_get(RedisDb* db, char[:] key,
                                     CCArena* reply_arena, DbCmdClock* clock) {
    @errhandler(CCError e) { return cc_err(e); }
    RedisEntry* cell = db_lookup_live(db, key, clock);
    if (!cell) return cc_ok(reply_null());
    RedisValue* val = &cell->val;
    switch (val) {
        case .str: return cc_ok(reply_bulk(val->str.as_slice()));
        case .num: {
            int64_t n = val->num;
            char[:] text = @string(`${n}`);
            char[:] bytes = reply_arena_alloc_slice(reply_arena, text.len) !>;
            memcpy((char*)bytes.ptr, text.ptr, text.len);
            return cc_ok(reply_bulk(bytes));
        }
    }
    return cc_err(CC_ERROR(CC_ERR_INVALID_ARG, "corrupt value cell"));
}

/* DEL/EXISTS share the variadic count shape: lazy expiry means a key that
 * timed out counts as absent for both (lookup_live reaps it first). */
static RedisReply db_del(RedisDb* db, char[:]* keys, size_t nkeys,
                         DbCmdClock* clock) {
    int64_t removed = 0;
    if (!db || !db->shards) return reply_integer(0);
    for (size_t i = 0; i < nkeys; ++i) {
        RedisEntry* cell = db_lookup_live(db, keys[i], clock);
        if (!cell) continue;
        db_remove_entry(db, keys[i], cell);
        removed++;
    }
    return reply_integer(removed);
}

static RedisReply db_exists(RedisDb* db, char[:]* keys, size_t nkeys,
                            DbCmdClock* clock) {
    int64_t found = 0;
    for (size_t i = 0; i < nkeys; ++i) {
        if (db_lookup_live(db, keys[i], clock)) found++;
    }
    return reply_integer(found);
}

static RedisReply db_type(RedisDb* db, char[:] key, DbCmdClock* clock) {
    /* Only string values exist in this server. */
    return reply_simple(db_lookup_live(db, key, clock) ? "string" : "none");
}

static RedisReply db_strlen(RedisDb* db, char[:] key, DbCmdClock* clock) {
    RedisEntry* cell = db_lookup_live(db, key, clock);
    if (!cell) return reply_integer(0);
    RedisValue* val = &cell->val;
    switch (val) {
        case .str: return reply_integer((int64_t)val->str.len());
        case .num: {
            /* length of the canonical decimal render, no storage touched */
            int64_t n = val->num;
            char[:] text = @string(`${n}`);
            return reply_integer((int64_t)text.len);
        }
    }
    return reply_integer(0);
}

static RedisReply !>(CCError) db_setnx(RedisDb* db, char[:] key, char[:] value, DbCmdClock* clock) {
    @errhandler(CCError e) { return cc_err(e); }
    if (db_lookup_live(db, key, clock)) return cc_ok(reply_integer(0));
    db_set(db, key, value, 0) !>;
    return cc_ok(reply_integer(1));
}

/* APPEND keeps the entry's TTL (redis semantics).  Combined bytes are staged
 * in caller-provided scratch (redis_owner: request arena; redis_idiomatic:
 * per-window reply arena). */
static RedisReply !>(CCError) db_append(RedisDb* db,
                                        char[:] key,
                                        char[:] suffix,
                                        CCArena* scratch,
                                        DbCmdClock* clock) {
    @errhandler(CCError e) { return cc_err(e); }
    RedisEntry* cell = db_lookup_live(db, key, clock);
    if (!cell) {
        db_set(db, key, suffix, 0) !>;
        return cc_ok(reply_integer((int64_t)suffix.len));
    }
    RedisValue* val = &cell->val;
    char[:] old = cc_slice_empty();
    switch (val) {
        case .str: old = val->str.as_slice(); break;
        case .num: {
            /* Render the int cell into request scratch: the arena-less
             * @string buffer is block-scoped and must not escape this case. */
            int64_t n = val->num;
            char[:] text = @string(`${n}`);
            char[:] copy = cc_arena_alloc_slice_bytes(scratch, text.len);
            if (!copy.ptr) {
                return cc_err(CC_ERROR(CC_ERR_OUT_OF_MEMORY, "append staging OOM"));
            }
            memcpy((char*)copy.ptr, text.ptr, text.len);
            old = copy;
            break;
        }
    }
    size_t new_len = old.len + suffix.len;
    char[:] combined = cc_arena_alloc_slice_bytes(scratch, new_len);
    if (new_len > 0 && !combined.ptr) {
        return cc_err(CC_ERROR(CC_ERR_OUT_OF_MEMORY, "append staging OOM"));
    }
    if (old.len > 0) memcpy((char*)combined.ptr, old.ptr, old.len);
    if (suffix.len > 0) memcpy((char*)combined.ptr + old.len, suffix.ptr, suffix.len);
    db_entry_store_str(db, val, combined) !>;
    return cc_ok(reply_integer((int64_t)new_len));
}

/* INCR/DECR/INCRBY/DECRBY.  Existing entries keep their TTL (value edit);
 * a fresh entry starts at `delta` with no TTL.  The hot path (existing num
 * cell) is projection + checked add + num->num transition: no text parse,
 * no re-encode.  A str cell parses once in the `?>` fallback, then the
 * one-line transition installs the num arm — its CCString is released
 * first with the same value-arena accounting as before (int64 carries no
 * destructor, so the manual release IS the drop).  Error paths leave the
 * cell untouched. */
static RedisReply !>(CCError) db_incrby(RedisDb* db, char[:] key, int64_t delta, DbCmdClock* clock) {
    @errhandler(CCError e) { return cc_err(e); }
    if (!db || !db->shards) return cc_err(CC_ERROR(CC_ERR_OUT_OF_MEMORY, "db lookup failed"));

    RedisEntry* cell = db_lookup_live(db, key, clock);

    int64_t value = delta;
    if (cell) {
        RedisValue* val = &cell->val;
        int64_t base = val->num ?> ({          /* fallback: parse the str arm */
            char[:] cur = val->str.as_slice();
            int64_t parsed = cur.to_i64() !> {
                return cc_err(CC_ERROR(CC_ERR_INVALID_ARG,
                                       "ERR value is not an integer or out of range"));
            };
            parsed;
        });
        value = cc_add_i64_checked(base, delta) !> {
            return cc_err(CC_ERROR(CC_ERR_INVALID_ARG, "ERR increment or decrement would overflow"));
        };
        if (val->kind == .str) {
            CCString doomed = val->str;
            db_release_value(db, &doomed);
        }
        *val = { .num = value };
    } else {
        db_insert_new_entry(db, key, (RedisValue){ .num = value }, 0) !>;
    }

    return cc_ok(reply_integer(value));
}

/* EXPIRE/PEXPIRE, already scaled to relative ms.  Non-positive TTL deletes
 * the key immediately and still answers 1 (redis semantics).  A deadline
 * past INT64_MAX clamps to "effectively never". */
static RedisReply !>(CCError) db_expire_rel_ms(RedisDb* db, char[:] key, int64_t rel_ms,
                                               DbCmdClock* clock) {
    @errhandler(CCError e) { return cc_err(e); }
    RedisEntry* cell = db_lookup_live(db, key, clock);
    if (!cell) return cc_ok(reply_integer(0));
    if (rel_ms <= 0) {
        db_remove_entry(db, key, cell);
        return cc_ok(reply_integer(1));
    }
    int64_t now = clock->now();
    int64_t when = (rel_ms > INT64_MAX - now) ? INT64_MAX : now + rel_ms;
    db_expires_set(db, key, when) !>;
    return cc_ok(reply_integer(1));
}

/* TTL/PTTL: -2 missing key, -1 no expiry, else remaining time (TTL rounds
 * the millisecond remainder UP, matching redis's second-granularity view). */
static RedisReply db_ttl(RedisDb* db, char[:] key, bool in_ms, DbCmdClock* clock) {
    RedisEntry* cell = db_lookup_live(db, key, clock);
    if (!cell) return reply_integer(-2);
    {
        int64_t exp = db_expires_get_key(db, key);
        if (exp == 0) return reply_integer(-1);
        int64_t rem = exp - clock->now();
        if (rem < 0) rem = 0;
        if (in_ms) return reply_integer(rem);
        /* Ceiling to seconds.  Clamped INT64_MAX deadlines (set_with_ttl /
         * expire_rel_ms) make bare `rem + 999` overflow to a negative TTL. */
        CCResult_int64_t_CCError adj = cc_add_i64_checked(rem, 999);
        if (adj.is_err()) return reply_integer(INT64_MAX / 1000);
        return reply_integer(adj.value() / 1000);
    }
}

static RedisReply !>(CCError) db_persist(RedisDb* db, char[:] key, DbCmdClock* clock) {
    @errhandler(CCError e) { return cc_err(e); }
    RedisEntry* cell = db_lookup_live(db, key, clock);
    if (!cell) return cc_ok(reply_integer(0));
    if (db_expires_get_key(db, key) == 0) return cc_ok(reply_integer(0));
    db_expires_set(db, key, 0) !>;
    return cc_ok(reply_integer(1));
}

/* MGET → WIRE array in reply_arena.  Pass 1 reaps; pass 2 re-reads with
 * a stable clock; encode size from cc_measure (one alloc). */
static RedisReply !>(CCError) db_mget(RedisDb* db,
                                      char[:]* keys,
                                      size_t nkeys,
                                      CCArena* reply_arena,
                                      DbCmdClock* clock) {
    @errhandler(CCError e) { return cc_err(e); }
    for (size_t i = 0; i < nkeys; ++i) {
        (void)db_lookup_live(db, keys[i], clock);
    }

    char[:] vals[REDIS_ARGV_MAX] = {0};
    bool found[REDIS_ARGV_MAX] = {0};
    for (size_t i = 0; i < nkeys; ++i) {
        RedisEntry* cell = db_lookup_live(db, keys[i], clock);
        found[i] = cell != NULL;
        if (cell) {
            RedisValue* val = &cell->val;
            switch (val) {
                case .str:
                    vals[i] = val->str.as_slice();
                    break;
                case .num: {
                    /* Render into reply_arena so the measured write keeps
                     * stable bytes for the encode below. */
                    int64_t n = val->num;
                    char[:] text = @string(`${n}`);
                    char[:] bytes = reply_arena_alloc_slice(reply_arena, text.len) !>;
                    memcpy((char*)bytes.ptr, text.ptr, text.len);
                    vals[i] = bytes;
                    break;
                }
            }
        }
    }

    RespGBulk elems[REDIS_ARGV_MAX];
    for (size_t i = 0; i < nkeys; ++i)
        elems[i] = wire_bulk_or_nil(vals[i], found[i]);

    RespGBulkArray arr;
    memset(&arr, 0, sizeof arr);
    arr.n = (long long)nkeys;
    arr.elems = elems;
    arr.elems_n = nkeys;
    size_t need = cc_measure(RespGBulkArray, &arr);
    if (need == 0 || need > (size_t)k_reply_encode_cap_max) {
        return cc_err(CC_ERROR(CC_ERR_OUT_OF_MEMORY, "mget reply encode overflow"));
    }
    char[:] out = reply_arena_alloc_slice(reply_arena, need) !>;
    size_t w = cc_write(RespGBulkArray, &arr, (char*)out.ptr, out.len);
    if (w != need) {
        return cc_err(CC_ERROR(CC_ERR_INTERNAL, "mget encode: write size != measure"));
    }
    out.truncate(w) !>;
    return cc_ok(reply_wire(out));
}

static void !>(CCError) db_mset(RedisDb* db, char[:]* args, size_t argc) {
    @errhandler(CCError e) { return cc_err(e); }
    for (size_t i = 0; i + 1 < argc; i += 2) {
        db_set(db, args[i], args[i + 1], 0) !>;
    }
    return cc_ok();
}

/* DBSIZE counts only live entries: expired-but-unreaped cells are skipped
 * (not deleted — no map mutation during iteration). */
static RedisReply db_dbsize(RedisDb* db, DbCmdClock* clock) {
    int64_t n = 0;
    size_t si;
    CCSlicePacked k;
    RedisEntry v;
    if (!db || !db->shards) return reply_integer(0);
    for (si = 0; si < db->shard_count; ++si) {
        RedisDbShard* sh = &db->shards[si];
        if (!sh->entries) continue;
        CC_ARRAY_MAP_FOREACH(sh->entries, k, v) {
            int64_t exp = db_expires_get(db, k);
            if (exp != 0 && clock->now() >= exp) continue;
            (void)v;
            n++;
        }
    }
    return reply_integer(n);
}

/* FLUSHDB/FLUSHALL (one logical DB, so they are the same operation): a
 * mass-DEL.  Values and heap keys are released with the usual accounting,
 * then maps are cleared.  Dense at_ptr/key_ptr so release hits the live cell
 * (same discipline as get_ptr — not a by-value FOREACH alias). */
static RedisReply db_flush(RedisDb* db) {
    size_t si;
    if (!db || !db->shards) return reply_simple("OK");
    for (si = 0; si < db->shard_count; ++si) {
        RedisDbShard* sh = &db->shards[si];
        size_t n;
        size_t i;
        if (!sh->entries) continue;
        n = sh->entries->len();
        for (i = 0; i < n; ++i) {
            CCSlicePacked* k = sh->entries->key_ptr(i);
            RedisEntry* cell = sh->entries->at_ptr(i);
            CCSlicePacked entry_key;
            CCSlicePacked exp_key = cc_slice_packed_empty();
            uintptr_t entry_w;
            if (!k || !cell) continue;
            entry_key = *k;
            entry_w = entry_key.w;
            if (sh->expires) {
                CCSlicePacked* xk = sh->expires->find_key_ptr(entry_key);
                if (xk) exp_key = *xk;
            }
            db_mem_stats_note_key_release(k->len());
            RedisValue* val = &cell->val;
            CCString doomed = val->str ?> cc_string_new();  /* num arms own no bytes */
            db_release_value(db, &doomed);
            db_release_key_packed(db, &entry_key);
            if (exp_key.w && exp_key.w != entry_w)
                db_release_key_packed(db, &exp_key);
        }
        sh->entries->clear();
        if (sh->expires) sh->expires->clear();
    }
    return reply_simple("OK");
}

/* KEYS → WIRE array in reply_arena.  Measure pass (exact size), then encode;
 * write each bulk immediately so inline CCSlicePacked key bytes are copied
 * before the next dense-row step (staging RespGReply items for a later
 * batched write mis-encodes under --release). */
static RedisReply !>(CCError) db_keys(RedisDb* db,
                                      char[:] pattern,
                                      CCArena* reply_arena,
                                      DbCmdClock* clock) {
    @errhandler(CCError e) { return cc_err(e); }
    /* Depth cap for glob_match's recursion (fiber stacks are ~2MiB). */
    enum { k_keys_pattern_max = 512 };
    if (pattern.len > (size_t)k_keys_pattern_max) {
        return cc_err(CC_ERROR(CC_ERR_INVALID_ARG, "ERR KEYS pattern too long"));
    }
    const char* pat = (const char*)pattern.ptr;

    size_t matched = 0;
    size_t body = 0;
    size_t si;
    if (!db || !db->shards) {
        /* empty DB — still a valid empty array reply */
    } else {
        for (si = 0; si < db->shard_count; ++si) {
            RedisDbShard* sh = &db->shards[si];
            size_t n = sh->entries ? sh->entries->len() : 0;
            size_t i;
            for (i = 0; i < n; ++i) {
                CCSlicePacked* kp = sh->entries->key_ptr(i);
                if (!kp) continue;
                int64_t exp = db_expires_get(db, *kp);
                if (exp != 0 && clock->now() >= exp) continue;
                char[:] ks = kp->as_slice();
                if (!glob_match(pat, pattern.len, (const char*)ks.ptr, ks.len)) continue;
                matched++;
                RespGReply elem = wire_bulk(ks);
                size_t m = cc_measure(RespGReply, &elem);
                if (m == 0) {
                    return cc_err(CC_ERROR(CC_ERR_OUT_OF_MEMORY, "keys reply encode overflow"));
                }
                body += m;
            }
        }
    }

    RespGArrayHdr hdr = { .n = (long long)matched };
    size_t hdr_sz = cc_measure(RespGArrayHdr, &hdr);
    if (hdr_sz == 0) {
        return cc_err(CC_ERROR(CC_ERR_OUT_OF_MEMORY, "keys reply encode overflow"));
    }
    size_t need = hdr_sz + body;
    if (need > (size_t)k_reply_encode_cap_max) {
        return cc_err(CC_ERROR(CC_ERR_OUT_OF_MEMORY, "keys reply encode overflow"));
    }

    char[:] out = reply_arena_alloc_slice(reply_arena, need) !>;
    char* dst = (char*)out.ptr;
    size_t off = cc_write(RespGArrayHdr, &hdr, dst, out.len);
    if (off != hdr_sz) {
        return cc_err(CC_ERROR(CC_ERR_INTERNAL, "keys encode: hdr write != measure"));
    }
    if (db && db->shards) {
        for (si = 0; si < db->shard_count; ++si) {
            RedisDbShard* sh = &db->shards[si];
            size_t n = sh->entries ? sh->entries->len() : 0;
            size_t i;
            for (i = 0; i < n; ++i) {
                CCSlicePacked* kp = sh->entries->key_ptr(i);
                if (!kp) continue;
                int64_t exp = db_expires_get(db, *kp);
                if (exp != 0 && clock->now() >= exp) continue;
                char[:] ks = kp->as_slice();
                if (!glob_match(pat, pattern.len, (const char*)ks.ptr, ks.len)) continue;
                RespGReply elem = wire_bulk(ks);
                size_t w = cc_write(RespGReply, &elem, dst + off, out.len - off);
                if (w == 0) {
                    return cc_err(CC_ERROR(CC_ERR_INTERNAL, "keys encode: bulk write failed"));
                }
                off += w;
            }
        }
    }
    if (off != need) {
        return cc_err(CC_ERROR(CC_ERR_INTERNAL, "keys encode: write size != measure"));
    }
    out.truncate(off) !>;
    return cc_ok(reply_wire(out));
}

/* Seconds → relative ms for EXPIRE/SETEX, clamped instead of overflowing. */
static int64_t expire_seconds_to_rel_ms(int64_t seconds) {
    if (seconds > INT64_MAX / 1000) return INT64_MAX;
    if (seconds < INT64_MIN / 1000) return INT64_MIN;
    return seconds * 1000;
}

/* SETEX/PSETEX: TTL must be strictly positive (redis errors on <= 0). */
static void !>(CCError) db_set_with_ttl(RedisDb* db,
                                        char[:] key,
                                        char[:] value,
                                        int64_t rel_ms,
                                        DbCmdClock* clock) {
    @errhandler(CCError e) { return cc_err(e); }
    if (rel_ms <= 0) {
        return cc_err(CC_ERROR(CC_ERR_INVALID_ARG, "ERR invalid expire time"));
    }
    int64_t now = clock->now();
    int64_t deadline = (rel_ms > INT64_MAX - now) ? INT64_MAX : now + rel_ms;
    db_set(db, key, value, deadline) !>;
    return cc_ok();
}

static int db_preload_key_count(void) {
    const char* s = getenv("CC_REDIS_PRELOAD_KEYS");
    if (!s || !s[0]) return 0;
    char* end = NULL;
    long n = strtol(s, &end, 10);
    if (end == s || (end && *end != 0) || n <= 0) return 0;
    return (int)n;
}

static bool !>(CCError) db_preload_keys(RedisDb* db, int count) {
    @errhandler(CCError e) { return cc_err(e); }
    if (!db || count <= 0) return cc_ok(true);
    static const char preload_value[] = "0";
    for (int i = 0; i < count; ++i) {
        char key_buf[32];
        int n = snprintf(key_buf, sizeof(key_buf), "key:%d", i);
        if (n <= 0 || (size_t)n >= sizeof(key_buf)) {
            return cc_err(CC_ERROR(CC_ERR_INVALID_ARG, "preload key encode failed"));
        }
        db_set(db,
               cc_slice_from_buffer(key_buf, (size_t)n),
               cc_slice_from_buffer((void*)preload_value, sizeof(preload_value) - 1),
               0) !>(e) { return cc_err(e); };
    }
    return cc_ok(true);
}

static bool db_preload_keys_ok(RedisDb* db, int count) {
    return cc_is_ok(db_preload_keys(db, count));
}

static void db_free_all(RedisDb* db) {
    size_t i;
    if (!db) return;
    if (db->shards) {
        for (i = 0; i < db->shard_count; ++i) {
            RedisDbShard* sh = &db->shards[i];
            if (sh->expires) {
                sh->expires->destroy();
                sh->expires = NULL;
            }
            if (sh->entries) {
                sh->entries->destroy();
                sh->entries = NULL;
            }
        }
        /* Key arenas destroyed in db_free_arenas_only while shards[] is live. */
        db_free_arenas_only(db);
        db->shards = NULL;
        return;
    }
    db_free_arenas_only(db);
}

#endif /* REDIS_DB_CCH */

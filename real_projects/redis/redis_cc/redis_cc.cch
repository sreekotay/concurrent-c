/*
 * Shared Redis project types.
 *
 * These types exist to keep tutorial, idiomatic, and production versions on
 * the same conceptual model from the start.
 */
#ifndef REDIS_CC_SHARED_H
#define REDIS_CC_SHARED_H

#include <ccc/std/prelude.cch>
#include <stdint.h>

/* Inline byte budget for argv clones on a freshly-allocated RedisRequest.
 * Overflow (oversized SET values etc.) spills onto heap blocks owned by
 * req->arena. */
#ifndef REDIS_REQUEST_ARGV_BUF_CAP
#define REDIS_REQUEST_ARGV_BUF_CAP 368
#endif

typedef struct RedisReplyOutbox RedisReplyOutbox;
typedef struct RedisConn RedisConn;

@variant RedisCommand {
    ping: void;
    config_get: void;
    echo: void;
    get: void;
    set: void;
    setnx: void;
    setex: void;
    psetex: void;
    append: void;
    strlen: void;
    type: void;
    del: void;
    exists: void;
    incr: void;
    decr: void;
    incrby: void;
    decrby: void;
    mget: void;
    mset: void;
    expire: void;
    pexpire: void;
    ttl: void;
    pttl: void;
    persist: void;
    dbsize: void;
    flushdb: void;
    flushall: void;
    keys: void;
    /* Concurrent-C: dump arena / mem stats to stderr; reply +OK. */
    cc_memlog: void;
};

/* Channel element form:
 *   structured — SIMPLE/BULK/INTEGER/NULL_BULK/ERROR (domain shape)
 *   WIRE       — opaque RESP bytes already in the reply arena (array+nil
 *                shapes that do not round-trip through structured arms)
 * Ownership (arena-safe for send_into) is a separate seam from form. */
@variant RedisReply {
    simple: char[:];
    bulk: char[:];
    integer: int64_t;
    null_bulk: void;
    error: char[:];
    wire: char[:];
};

/* Owner-fiber argv AFTER the command word (redis_owner). Idiomatic has
 * no argc cap: schema `items` without `cap N` + a parse arena. Owner
 * still static-asserts REDIS_ARGV_MAX + 1 == RespGCmd_args_cap.
 * 31 payload slots (32 wire argv) covers smoke MGET + 20 keys. */
#ifndef REDIS_ARGV_MAX
#define REDIS_ARGV_MAX 31
#endif

typedef struct RedisRequest {
    uint64_t conn_id;
    uint64_t request_id;
    uint32_t shard_id;
    RedisConn* conn;
    RedisCommand kind;
    size_t argc;
    char[:] argv[REDIS_ARGV_MAX];
    /* argv-clone scratch: req->arena wraps argv_buf and heap-spills
     * on overflow.  Pairing kept at the tail so sizeof(RedisRequest)
     * is the exact pool-slot size. */
    CCArena arena;
    char argv_buf[REDIS_REQUEST_ARGV_BUF_CAP];
} RedisRequest;


static inline const char* redis_command_name(RedisCommand kind) {
    @switch (kind) {
        case .ping: return "PING";
        case .config_get: return "CONFIG_GET";
        case .echo: return "ECHO";
        case .get: return "GET";
        case .set: return "SET";
        case .setnx: return "SETNX";
        case .setex: return "SETEX";
        case .psetex: return "PSETEX";
        case .append: return "APPEND";
        case .strlen: return "STRLEN";
        case .type: return "TYPE";
        case .del: return "DEL";
        case .exists: return "EXISTS";
        case .incr: return "INCR";
        case .decr: return "DECR";
        case .incrby: return "INCRBY";
        case .decrby: return "DECRBY";
        case .mget: return "MGET";
        case .mset: return "MSET";
        case .expire: return "EXPIRE";
        case .pexpire: return "PEXPIRE";
        case .ttl: return "TTL";
        case .pttl: return "PTTL";
        case .persist: return "PERSIST";
        case .dbsize: return "DBSIZE";
        case .flushdb: return "FLUSHDB";
        case .flushall: return "FLUSHALL";
        case .keys: return "KEYS";
        case .cc_memlog: return "CC_MEMLOG";
    }
    return "UNKNOWN";
}

static inline const char* redis_reply_name(const RedisReply* r) {
    @switch (*r) {
        case .simple: return "simple-string";
        case .bulk: return "bulk-string";
        case .integer: return "integer";
        case .null_bulk: return "null-bulk";
        case .error: return "error";
        case .wire: return "wire";
    }
    return "unknown";
}

#endif

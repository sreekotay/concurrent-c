/*
 * redis_idiomatic.ccs
 *
 * One-writer concurrency via an N:1 request channel.  Only the owner
 * fiber touches RedisDb; client fibers pipeline requests and drain the
 * matching replies on a per-connection 1:1 reply channel.  Serialization
 * is by channel topology, not worker pinning, so the scheduler is free
 * to use any number of OS threads.  Pipeline depth is bounded by
 * `k_pipeline_reply_cap` (reply-channel capacity / client submit window).
 *
 * Owner replies use reserve-then-write (`try_send_into`): admit a slot,
 * build into it, then `ensure_owned` (materialize payload into reply_arena;
 * kind unchanged).  Structured vs WIRE is a form choice at the builder;
 * socket write is where structured replies become RESP.  RespGReply /
 * cc_write are encode tools, not channel types.
 *
 * Conn lifetime without refcounts — see the RedisConn block below.
 *
 * Command surface: PING/ECHO, GET/SET/SETNX/SETEX/PSETEX/APPEND/STRLEN,
 * TYPE, DEL/EXISTS (variadic), INCR/DECR/INCRBY/DECRBY, MGET/MSET,
 * EXPIRE/PEXPIRE/TTL/PTTL/PERSIST (lazy expiration: absolute deadline
 * checked on access, no active cycle), DBSIZE, FLUSHDB/FLUSHALL, KEYS
 * (glob), CONFIG GET, CC.MEMLOG.  Functional smoke: `python3 redis_smoke.py`.
 *
 * Build: `make redis_idiomatic`.  Bench: `./bench_robust.sh`.
 * Memory: CC_REDIS_MEM_REPORT=1 logs Mach footprint, logical_db_live vs
 * mach_phys_footprint, db_dump_mem_stats (per-arena map, key, value slabs).
 * CC.MEMLOG command prints arena + accounting without restart; see bench_then_memlog.sh.
 * mem_account.sh runs vmmap summary idle vs load vs upstream.
 */

#include <ccc/std/prelude.cch>
#include <ccc/std/net.cch>
#include <ccc/std/map.cch>
#include <ccc/std/static_map.cch>
#include <ccc/std/string.cch>
#include <stdio.h>
#include <stdlib.h>
#include <stdatomic.h>
#include <string.h>
#include <signal.h>
#include <time.h>
#include <unistd.h>
#include <errno.h>
#include <sys/socket.h>
#include <netinet/in.h>   /* IPPROTO_TCP (not transitive from tcp.h on glibc) */
#include <netinet/tcp.h>
#include <sys/resource.h>
#if defined(__APPLE__)
#include <mach/mach.h>
#include <mach/task_info.h>
#endif
#include "redis_cc/redis_cc.cch"
#include <ccc/std/task.cch>
#include <ccc/cc_sched.cch>
#include <ccc/cc_closure.cch>
#include <ccc/cc_type.cch>

/* Three DB arenas: map (table blob), key (cloned key bytes), value (CCString
 * backing).  Map/value: fixed root + heap overflow; key: growable slabs. */

static inline CCSliceHdr db_key_hdr_view(char[:] key) {
    CCSliceHdr h = {0};
    h.ptr = key.ptr;
    h.len = key.len;
    return h;
}

static inline size_t db_map_hash_key(CCSliceHdr key) {
    size_t h = 2166136261U;
    const unsigned char *p = (const unsigned char *)key.ptr;
    for (size_t i = 0; i < key.len; ++i)
        h ^= p[i], h *= 16777619;
    return h;
}

static inline int db_map_eq_key(CCSliceHdr a, CCSliceHdr b) {
    return a.len == b.len && (a.ptr == b.ptr || (a.ptr && b.ptr && memcmp(a.ptr, b.ptr, a.len) == 0));
}

/* .str = SET bytes; .num = INCR-family ints (no text round-trip).  Read
 * boundaries render .num to canonical decimal. */
@variant(packed) RedisValue {
    str: CCString;
    num: int64_t;
};

/* expires_at_ms == 0 → no expiry.  Lazy: checked on access (db_lookup_live). */
typedef struct RedisEntry {
    RedisValue val;
    int64_t expires_at_ms;
} RedisEntry;

/* Wide RedisEntry values: array_map keeps empty probe slots to 4 B. */
CC_ARRAY_MAP_DECL(CCSliceHdr, RedisEntry, RedisDbMap, db_map_hash_key, db_map_eq_key);

typedef struct RedisDb {
    CCArena map_arena;
    CCArena key_arena;
    CCArena value_arena;
    RedisDbMap* entries;
} RedisDb;

typedef struct RedisDbMemStats {
    size_t key_alloc_count;
    size_t key_alloc_bytes;
    size_t key_release_count;
    size_t key_release_bytes;
    size_t value_alloc_count;
    size_t value_alloc_bytes;
    size_t value_release_count;
    size_t value_release_bytes;
} RedisDbMemStats;

static RedisDbMemStats g_db_mem_stats = {0};

#include "redis_mem.cch"
#include "redis_glob.cch"

/* Compile-time channel geometry: embedded in CC endpoint types and must match
 * handle_client's per-round submit cap (same value as reply channel depth). */
enum {
    k_request_chan_cap = 256,
    k_pipeline_reply_cap = 16,
    redis_conn_out_buf_bytes = 1024,
};

typedef struct RedisPipelineWindow {
    size_t cap;
    size_t submitted;
    size_t replies_pending;
} RedisPipelineWindow;

typedef enum RedisPipelineStatus {
    REDIS_PIPELINE_OK = 0,
    REDIS_PIPELINE_OWNER_UNAVAILABLE,
    REDIS_PIPELINE_REPLY_CLOSED,
    REDIS_PIPELINE_WRITE_FAILED,
} RedisPipelineStatus;

static inline RedisPipelineWindow redis_pipeline_window_start(void) {
    return (RedisPipelineWindow){
        .cap = (size_t)k_pipeline_reply_cap,
        .submitted = 0,
        .replies_pending = 0,
    };
}

static inline bool redis_pipeline_window_has_room(const RedisPipelineWindow* window) {
    return window && window->submitted < window->cap;
}

static inline bool redis_pipeline_window_is_full(const RedisPipelineWindow* window) {
    return window && window->submitted == window->cap;
}

static inline void redis_pipeline_window_accept(RedisPipelineWindow* window) {
    window->submitted++;
    window->replies_pending++;
}

/* Replies must match submission order (RESP).  `ordered` = per-sender FIFO;
 * single owner sender ⇒ total order. */
typedef RedisReply[~k_pipeline_reply_cap 1:1 >] ReplyTx;
typedef RedisReply[~k_pipeline_reply_cap 1:1 ordered <] ReplyRx;

/* Conn lifetime (no refcounts):
 *   1. Client submits a request (inflight++); req->conn borrows this conn.
 *   2. Owner builds the reply inside try_send_into (builder may still borrow
 *      req / DB), then releases the request pool slot.
 *   3. Client drains reply_rx (inflight--).  Drain-to-zero — or reply-channel
 *      close after owner exit — is the teardown join; then @destroy may free.
 * Payload ownership across step 2 is redis_reply_ensure_owned. */
typedef struct RedisConn {
    uint64_t conn_id;
    uint64_t next_request_id;
    size_t inflight;           /* client: submit++ / drain--; teardown join */
    CCArenaPool req_pool;      /* per-conn RedisRequest slots */
    CCArena reply_arena;       /* reply payload bytes; reset per pipeline window */
    ReplyTx reply_tx;
    ReplyRx reply_rx;
    CCSocket* sock;            /* handle_client stack; outlives conn */
    size_t out_len;
    char out_buf[redis_conn_out_buf_bytes];
} RedisConn;

/* Shared N:1 request channel; Rx is ordered so each conn's requests run
 * in submission order. */
typedef RedisRequest*[~k_request_chan_cap N:1 >] ReqTx;
typedef RedisRequest*[~k_request_chan_cap N:1 ordered <] ReqRx;

static RedisConn* redis_conn_create(uint64_t conn_id);
static void redis_conn_destroy(RedisConn* conn);
static void redis_conn_release_slot(RedisConn* conn, RedisRequest* req);
/* Defined with the reply path below; the owner's array-reply builders
 * (MGET/KEYS) allocate through it into conn->reply_arena. */
static CCSlice !>(CCError) reply_arena_alloc_slice(CCArena* reply_arena, size_t n);

/* After drain-to-zero (see RedisConn lifetime), free the conn. */
@comptime {
    (void)cc_type_register("RedisConn*", (CCTypeHooks){
        .destroy = cc_type_destroy_call("redis_conn_destroy"),
    });
}

static CCIoError net_to_io_error(CCNetError err) {
    switch (err) {
        case CC_NET_CONNECTION_CLOSED:
        case CC_NET_CONNECTION_RESET:
            return cc_io_error(CC_IO_CONNECTION_CLOSED);
        case CC_NET_TIMED_OUT:
            return cc_io_error(CC_IO_BUSY);
        default:
            return cc_io_error(CC_IO_OTHER);
    }
}

static void redis_diag_fprintln(CCString* line, CCArena* scratch) {
    const char* p = cc_string_cstr(line, scratch);
    if (p) fprintf(stderr, "%s\n", p);
}

static bool slice_eq_ignore_case(char[:] s, const char* cstr) {
    size_t len = strlen(cstr);
    if (s.len != len) return false;
    for (size_t i = 0; i < len; ++i) {
        char a = ((const char*)s.ptr)[i];
        char b = cstr[i];
        if (a >= 'a' && a <= 'z') a = (char)(a - 'a' + 'A');
        if (b >= 'a' && b <= 'z') b = (char)(b - 'a' + 'A');
        if (a != b) return false;
    }
    return true;
}

/* Args: char[:].to_i64().  Num cells render at read boundaries via @string. */

#include "redis_resp.cch"

/* RESP reader (parity oracle: tests/redis_resp_gen_parity_smoke.ccs).
 * Parse borrows the read buffer; argv is cloned into req->arena after a
 * complete frame.  cap 8 = REDIS_ARGV_MAX+1 wire tokens. */
@grammar(schema) RespGArg {~~~~
    rules [
        digit:  charset [#'0' - #'9']
        number: keep [opt #'-' some digit]
    ]
    #'$' len: int number "\r\n"
    data: bytes len
    "\r\n"
~~~~}

@grammar(schema) RespGCmd {~~~~
    rules [
        digit:  charset [#'0' - #'9']
        number: keep [opt #'-' some digit]
        lchar:  complement charset [#'\r' #'\n']
        line:   keep [any lchar]
    ]
    one of [
        framed [ #'*' argc: int number "\r\n" args: items RespGArg argc cap 8 ]
        plain  [ text: line "\r\n" ]
    ]
~~~~}

/* RESP writer (same shape as the reader).  cc_write allocates nothing;
 * hot replies go to out_buf; arrays encode into reply_arena.
 * Nil is not a RespGReply arm ('$' collides with bulk) — use RespGBulkHdr
 * with len = -1. */
@grammar(schema) RespGReply {~~~~
    rules [
        digit:  charset [#'0' - #'9']
        number: keep [opt #'-' some digit]
        lchar:  complement charset [#'\r' #'\n']
        line:   keep [any lchar]
    ]
    one of [
        simple  [ #'+' s: line "\r\n" ]
        error   [ #'-' msg: line "\r\n" ]
        integer [ #':' v: int number "\r\n" ]
        bulk    [ #'$' len: int number "\r\n" data: bytes len "\r\n" ]
        array   [ #'*' n: int number "\r\n" items: items RespGReply n ]
    ]
~~~~}

/* Bulk header alone: "$<len>\r\n".  Two boundary jobs the union cannot do:
 * nil (len = -1, see above) and streaming a bulk payload larger than
 * conn->out_buf (schema-written header, then the payload slice). */
@grammar(schema) RespGBulkHdr {~~~~
    rules [
        digit:  charset [#'0' - #'9']
        number: keep [opt #'-' some digit]
    ]
    #'$' len: int number "\r\n"
~~~~}

/* Multi-bulk header alone: "*<n>\r\n".  MGET interleaves bulk and nil
 * elements, and nil can't be a RespGReply array item — so its array is
 * written element-by-element under this schema-written header. */
@grammar(schema) RespGArrayHdr {~~~~
    rules [
        digit:  charset [#'0' - #'9']
        number: keep [opt #'-' some digit]
    ]
    #'*' n: int number "\r\n"
~~~~}

static RespParseStatus gen_try_read_args_buffered(RespReader* r,
                                                  CCSlice* args,
                                                  size_t cap,
                                                  size_t* out_argc,
                                                  CCError* err) {
    size_t pos = 0;
    RespGCmd c;
    bool !>(CCError) tr = RespGCmd_try_read((const char*)(r->data + r->start),
                                            r->end - r->start, &pos, NULL, &c);
    if (tr.is_err()) {
        if (tr.error().kind == CC_ERR_WOULD_BLOCK) return RESP_PARSE_INCOMPLETE;
        *err = tr.error();
        return RESP_PARSE_ERROR;
    }
    if (!tr.value()) return RESP_PARSE_INCOMPLETE;
    if (c.kind == RespGCmd_plain) {
        /* whitespace tokenization stays with the hand helper: it is server
         * policy (arg splitting), not wire framing */
        size_t !>(CCError) pargs = parse_inline_args(c.u.plain.text, args, cap);
        if (pargs.is_err()) { *err = pargs.error(); return RESP_PARSE_ERROR; }
        *out_argc = pargs.value();
        r->start += pos;
        return RESP_PARSE_OK;
    }
    if (c.u.framed.args_n < 1 || c.u.framed.args_n > cap) {
        *err = CC_ERROR(CC_ERR_PARSE, "unsupported argument count");
        return RESP_PARSE_ERROR;
    }
    for (size_t i = 0; i < c.u.framed.args_n; i++) args[i] = c.u.framed.args[i].data;
    *out_argc = c.u.framed.args_n;
    r->start += pos;
    return RESP_PARSE_OK;
}

typedef struct RedisCommandSpec {
    RedisCommandKind kind;
    int min_args;
    int max_args;      /* -1 means unbounded */
    int args_multiple; /* 0 means no divisibility constraint */
} RedisCommandSpec;

@comptime {
    CCStaticMapEntry commands[] = {
        { "PING",      "(RedisCommandSpec){ REDIS_CMD_PING, 0, 1, 0 }" },
        { "ECHO",      "(RedisCommandSpec){ REDIS_CMD_ECHO, 1, 1, 0 }" },
        { "GET",       "(RedisCommandSpec){ REDIS_CMD_GET, 1, 1, 0 }" },
        { "SET",       "(RedisCommandSpec){ REDIS_CMD_SET, 2, 2, 0 }" },
        { "SETNX",     "(RedisCommandSpec){ REDIS_CMD_SETNX, 2, 2, 0 }" },
        { "SETEX",     "(RedisCommandSpec){ REDIS_CMD_SETEX, 3, 3, 0 }" },
        { "PSETEX",    "(RedisCommandSpec){ REDIS_CMD_PSETEX, 3, 3, 0 }" },
        { "APPEND",    "(RedisCommandSpec){ REDIS_CMD_APPEND, 2, 2, 0 }" },
        { "STRLEN",    "(RedisCommandSpec){ REDIS_CMD_STRLEN, 1, 1, 0 }" },
        { "TYPE",      "(RedisCommandSpec){ REDIS_CMD_TYPE, 1, 1, 0 }" },
        { "DEL",       "(RedisCommandSpec){ REDIS_CMD_DEL, 1, -1, 0 }" },
        { "EXISTS",    "(RedisCommandSpec){ REDIS_CMD_EXISTS, 1, -1, 0 }" },
        { "INCR",      "(RedisCommandSpec){ REDIS_CMD_INCR, 1, 1, 0 }" },
        { "DECR",      "(RedisCommandSpec){ REDIS_CMD_DECR, 1, 1, 0 }" },
        { "INCRBY",    "(RedisCommandSpec){ REDIS_CMD_INCRBY, 2, 2, 0 }" },
        { "DECRBY",    "(RedisCommandSpec){ REDIS_CMD_DECRBY, 2, 2, 0 }" },
        { "MGET",      "(RedisCommandSpec){ REDIS_CMD_MGET, 1, -1, 0 }" },
        { "MSET",      "(RedisCommandSpec){ REDIS_CMD_MSET, 2, -1, 2 }" },
        { "EXPIRE",    "(RedisCommandSpec){ REDIS_CMD_EXPIRE, 2, 2, 0 }" },
        { "PEXPIRE",   "(RedisCommandSpec){ REDIS_CMD_PEXPIRE, 2, 2, 0 }" },
        { "TTL",       "(RedisCommandSpec){ REDIS_CMD_TTL, 1, 1, 0 }" },
        { "PTTL",      "(RedisCommandSpec){ REDIS_CMD_PTTL, 1, 1, 0 }" },
        { "PERSIST",   "(RedisCommandSpec){ REDIS_CMD_PERSIST, 1, 1, 0 }" },
        { "DBSIZE",    "(RedisCommandSpec){ REDIS_CMD_DBSIZE, 0, 0, 0 }" },
        { "FLUSHDB",   "(RedisCommandSpec){ REDIS_CMD_FLUSHDB, 0, 1, 0 }" },
        { "FLUSHALL",  "(RedisCommandSpec){ REDIS_CMD_FLUSHALL, 0, 1, 0 }" },
        { "KEYS",      "(RedisCommandSpec){ REDIS_CMD_KEYS, 1, 1, 0 }" },
        { "CC.MEMLOG", "(RedisCommandSpec){ REDIS_CMD_CC_MEMLOG, 0, 0, 0 }" },
    };
    static_map("redis_commands", "RedisCommandSpec", commands,
               sizeof(commands) / sizeof(commands[0]),
               CC_STATIC_MAP_ASCII_CI);
}

/* `argc` counts arguments after the command word.  FLUSHDB/FLUSHALL accept an
 * optional ASYNC/SYNC token, though this single-owner server always flushes
 * synchronously.  Unknown names and invalid arity share one miss result. */
static RedisCommandKind cmd_kind(char[:] cmd, size_t argc) {
    const RedisCommandSpec* spec = redis_commands_get(cmd);
    if (!spec ||
        argc < (size_t)spec->min_args ||
        (spec->max_args >= 0 && argc > (size_t)spec->max_args) ||
        (spec->args_multiple > 0 && argc % (size_t)spec->args_multiple != 0)) {
        return (RedisCommandKind)-1;
    }
    return spec->kind;
}

/* Initialize only the fields read for each reply kind; avoid whole-struct
 * zeroing on the GET/SET/INCR hot path. */
static RedisReply reply_simple(const char* s) {
    RedisReply r;
    r.kind = REDIS_REPLY_SIMPLE_STRING;
    r.data = cc_slice_from_cstr(s);
    return r;
}

static RedisReply reply_error(const char* s) {
    RedisReply r;
    r.kind = REDIS_REPLY_ERROR;
    r.data = cc_slice_from_cstr(s);
    return r;
}

static RedisReply err_reply(CCError err) {
    return reply_error(err.message ? err.message : "ERR internal error");
}

static RedisReply io_err_reply(CCIoError err) {
    return reply_error(cc_io_error_str(err));
}

static RedisReply reply_bulk(CCSlice s) {
    RedisReply r;
    r.kind = REDIS_REPLY_BULK_STRING;
    r.data = s;
    return r;
}

static RedisReply reply_null(void) {
    RedisReply r;
    r.kind = REDIS_REPLY_NULL_BULK;
    r.data = cc_slice_empty();
    return r;
}

static RedisReply reply_integer(int64_t v) {
    RedisReply r;
    r.kind = REDIS_REPLY_INTEGER;
    r.int_value = v;
    r.data = cc_slice_empty();
    return r;
}

/* Opaque RESP already in reply_arena (arrays+nil; ensure_owned is a no-op). */
static RedisReply reply_wire(CCSlice s) {
    RedisReply r;
    r.kind = REDIS_REPLY_WIRE;
    r.data = s;
    return r;
}

/* RedisReply → socket bytes.  RespGReply is encode-only; NULL_BULK uses
 * RespGBulkHdr (nil is not a RespGReply arm). */
static inline RespGReply wire_bulk(CCSlice data) {
    RespGReply w;
    w.kind = RespGReply_bulk;
    w.u.bulk.len = (long long)data.len; /* derived on write; set for hygiene */
    w.u.bulk.data = data;
    return w;
}

/* Structured arms → RespGReply.  WIRE and NULL_BULK are not projected here. */
static bool redis_reply_to_wire(const RedisReply* reply, RespGReply* wire) {
    switch (reply->kind) {
        case REDIS_REPLY_SIMPLE_STRING:
            wire->kind = RespGReply_simple;
            wire->u.simple.s = reply->data;
            return true;
        case REDIS_REPLY_ERROR:
            wire->kind = RespGReply_error;
            wire->u.error.msg = reply->data;
            return true;
        case REDIS_REPLY_INTEGER:
            wire->kind = RespGReply_integer;
            wire->u.integer.v = reply->int_value;
            return true;
        case REDIS_REPLY_BULK_STRING:
            *wire = wire_bulk(reply->data);
            return true;
        default:
            return false;
    }
}

/* Serialize a channel RedisReply into dst.  WIRE copies; structured uses
 * RespGReply/cc_write; NULL_BULK uses RespGBulkHdr. */
static size_t RedisReply_write(const RedisReply* reply, char* dst, size_t cap) {
    if (!reply || !dst) return 0;
    if (reply->kind == REDIS_REPLY_WIRE) {
        if (reply->data.len > cap) return 0;
        if (reply->data.len > 0) memcpy(dst, reply->data.ptr, reply->data.len);
        return reply->data.len;
    }
    if (reply->kind == REDIS_REPLY_NULL_BULK) {
        RespGBulkHdr nil = { .len = -1 };
        return cc_write(RespGBulkHdr, &nil, dst, cap);
    }
    RespGReply wire;
    if (!redis_reply_to_wire(reply, &wire)) return 0;
    return cc_write(RespGReply, &wire, dst, cap);
}

/* Encode into reply_arena.  `cap_hint` is a guess; cc_write 0-on-miss +
 * checkpoint/restore + double until fit (or overflow). */
enum { k_reply_encode_cap_max = 1 << 30 };

static CCSlice !>(CCError) reply_wire_encode_into_arena(const RespGReply* wire,
                                                                 CCArena* reply_arena,
                                                                 size_t cap_hint) {
    @errhandler(CCError e) { return cc_err(e); }
    size_t cap = cap_hint < 16 ? 16 : cap_hint;
    for (;;) {
        CCArenaCheckpoint cp = cc_arena_checkpoint(reply_arena);
        CCSlice out = reply_arena_alloc_slice(reply_arena, cap) !>;
        size_t w = cc_write(RespGReply, wire, (char*)out.ptr, out.len);
        if (w != 0) {
            out.len = w;
            return cc_ok(out);
        }
        cc_arena_restore(cp);
        if (cap >= (size_t)k_reply_encode_cap_max) {
            return cc_err(CC_ERROR(CC_ERR_OUT_OF_MEMORY, "reply encode overflow"));
        }
        cap *= 2;
    }
}

/* CONFIG GET: two-element array via schema, encoded into reply_arena. */
static RedisReply !>(CCError) config_get_reply(char[:] key, CCArena* reply_arena) {
    @errhandler(CCError e) { return cc_err(e); }
    RespGReply items[2];
    size_t n = 0;
    if (slice_eq_ignore_case(key, "save")) {
        items[0] = wire_bulk(cc_slice_from_cstr("save"));
        items[1] = wire_bulk(cc_slice_from_cstr(""));
        n = 2;
    } else if (slice_eq_ignore_case(key, "appendonly")) {
        items[0] = wire_bulk(cc_slice_from_cstr("appendonly"));
        items[1] = wire_bulk(cc_slice_from_cstr("no"));
        n = 2;
    }
    RespGReply arr;
    arr.kind = RespGReply_array;
    arr.u.array.n = (long long)n; /* derived on write; set for hygiene */
    arr.u.array.items = items;
    arr.u.array.items_n = n;
    CCSlice out = reply_wire_encode_into_arena(&arr, reply_arena, 64) !>;
    return cc_ok(reply_wire(out));
}

static bool !>(CCError) decode_request_shape(CCSlice* args,
                                             size_t argc,
                                             RedisCommandKind* out_kind,
                                             size_t* out_arg_start,
                                             size_t* out_argc) {
    if (argc < 1) return cc_err(CC_ERROR(CC_ERR_PARSE, "empty command"));

    if (slice_eq_ignore_case(args[0], "CONFIG")) {
        if (argc != 3 || !slice_eq_ignore_case(args[1], "GET")) {
            return cc_err(CC_ERROR(CC_ERR_INVALID_ARG, "ERR unsupported command"));
        }
        *out_kind = REDIS_CMD_CONFIG_GET;
        *out_arg_start = 2;
        *out_argc = 1;
        return cc_ok(true);
    }

    RedisCommandKind kind = cmd_kind(args[0], argc - 1);
    if ((int)kind < 0) {
        return cc_err(CC_ERROR(CC_ERR_INVALID_ARG, "ERR unsupported command"));
    }

    *out_kind = kind;
    *out_arg_start = 1;
    *out_argc = argc - 1;
    return cc_ok(true);
}

/* Non-blocking iterator over pipelined requests in the buffered reader.
 *   ok(true), *out = req  → handed to owner (slot released after commit;
 *                           see RedisConn lifetime).
 *   ok(false)             → need rr_fill (mid-message).
 *   err(e)                → parse/alloc failure; slot already returned.
 * Borrows `reader` and `conn`. */
typedef struct ReqIter {
    RespReader* reader;
    RedisConn* conn;
} ReqIter;

typedef struct RedisRequestSlot {
    RedisConn* conn;
    RedisRequest* req;
} RedisRequestSlot;

/* Direct boundaries from handle_client: iterator setup is pure; refill uses
 * fiber-aware socket I/O and may park the fiber, never the OS worker. */
@noblock static ReqIter rr_req_iter(RespReader* reader, RedisConn* conn) {
    ReqIter it = { .reader = reader, .conn = conn };
    return it;
}

@noblock static bool !>(CCIoError) redis_rr_fill(RespReader* reader, CCSocket* sock) {
    return rr_fill(reader, sock);
}

static void redis_request_slot_release(RedisRequestSlot* slot) {
    if (!slot || !slot->req) return;
    redis_conn_release_slot(slot->conn, slot->req);
    slot->conn = NULL;
    slot->req = NULL;
}

static RedisRequest* redis_request_slot_commit(RedisRequestSlot* slot) {
    if (!slot || !slot->conn || !slot->req) return NULL;
    RedisRequest* req = slot->req;
    /* req borrows conn for the owner hop (RedisConn lifetime §1–2). */
    req->conn = slot->conn;
    slot->conn = NULL;
    slot->req = NULL;
    return req;
}

static RedisRequestSlot !>(CCError) redis_conn_request_slot(RedisConn* conn) {
    /* The pool slot IS a RedisRequest; req->arena wraps the trailing
     * req->argv_buf for argv clones (heap-spills on overflow). */
    RedisRequest* req = (RedisRequest*)cc_arena_pool_alloc(&conn->req_pool);
    if (!req) {
        return cc_err(CC_ERROR(CC_ERR_OUT_OF_MEMORY, "request slot pool exhausted"));
    }
    /* No full-struct memset: sizeof(RedisRequest) is ~450 B (dominated
     * by the 368-byte argv_buf scratch) and zeroing it per-request
     * showed up as a hot leaf in GET profiling.  All fields we read
     * downstream are written explicitly below; argv_buf is just the
     * arena's backing store so uninitialized bytes are fine. */
    req->arena = cc_arena_create_buffer(req->argv_buf,
                                        sizeof(req->argv_buf),
                                        CC_ARENA_GROWABLE);
    if (!cc_arena_valid(&req->arena)) {
        cc_arena_pool_free(&conn->req_pool, req);
        return cc_err(CC_ERROR(CC_ERR_OUT_OF_MEMORY, "request arena init failed"));
    }
    return cc_ok((RedisRequestSlot){ .conn = conn, .req = req });
}

static bool !>(CCError) rr_req_iter_next(ReqIter* it, RedisRequest** out) {
    RedisConn* conn = it->conn;
    @errhandler(CCError e) { return cc_err(e); }

    /* Parse BEFORE taking a pool slot: incomplete frames are the common
     * refill case and must not touch req_pool / argv_buf at all.  Args
     * borrow read_buf until we materialize into req->arena below. */
    CCSlice args[1 + REDIS_ARGV_MAX] = {0};
    size_t argc = 0;
    CCError perr = {0};
    RespParseStatus argc_status =
        gen_try_read_args_buffered(it->reader, args, 1 + REDIS_ARGV_MAX, &argc, &perr);
    if (argc_status == RESP_PARSE_INCOMPLETE) {
        return cc_ok(false);
    }
    if (argc_status == RESP_PARSE_ERROR) return cc_err(perr);

    RedisCommandKind kind = REDIS_CMD_PING;
    size_t arg_start = 0;
    size_t req_argc = 0;
    decode_request_shape(args, argc, &kind, &arg_start, &req_argc) !>(e) { return cc_err(e); };

    RedisRequestSlot slot = redis_conn_request_slot(conn) !>;
    @defer redis_request_slot_release(&slot);
    RedisRequest* req = slot.req;

    req->conn_id = conn->conn_id;
    req->request_id = conn->next_request_id;
    req->kind = kind;
    req->argc = req_argc;
    for (size_t i = 0; i < req_argc; ++i) {
        req->argv[i] = cc_slice_clone(&req->arena, args[arg_start + i]);
        if (args[arg_start + i].len > 0 && !req->argv[i].ptr) {
            return cc_err(CC_ERROR(CC_ERR_OUT_OF_MEMORY, "request argument clone failed"));
        }
    }

    *out = redis_request_slot_commit(&slot);
    return cc_ok(true);
}

static size_t db_string_cap_8x(size_t len) {
    size_t need = len + 1; /* Keep room for the trailing NUL. */
    if (need < len) return 0;
    size_t rem = need & 7;
    if (rem == 0) return need;
    size_t rounded = need + (8 - rem);
    if (rounded < need) return 0;
    return rounded;
}

static CCString !>(CCError) db_clone_value_into_arena(CCArena* arena,
                                                      char[:] src,
                                                      const char* err_msg) {
    size_t cap = db_string_cap_8x(src.len);
    if (cap == 0) return cc_err(CC_ERROR(CC_ERR_OUT_OF_MEMORY, err_msg));
    CCString cloned = cc_string_new();
    if (!cloned.reserve(cap, arena)) {
        return cc_err(CC_ERROR(CC_ERR_OUT_OF_MEMORY, err_msg));
    }
    if (cloned.push_slice(src, arena) == NULL) {
        return cc_err(CC_ERROR(CC_ERR_OUT_OF_MEMORY, err_msg));
    }
    if (cloned.heap_data()) db_mem_stats_note_value_alloc(cloned.cap());
    return cc_ok(cloned);
}

static bool db_init_overflow_arena(CCArena* a, size_t root_bytes) {
    *a = cc_arena_heap(root_bytes);
    if (!a->valid()) return false;
    a->block_max = 1;
    if (!cc_arena_set_heap_overflow(a, true)) {
        a->destroy();
        return false;
    }
    return true;
}

static void db_free_arenas_only(RedisDb* db) {
    if (!db) return;
    db->map_arena.destroy();
    db->key_arena.destroy();
    db->value_arena.destroy();
}

static bool db_init(RedisDb* db, size_t bucket_count) {
    if (!db || bucket_count == 0) return false;
    const size_t map_value_heap_root = 1024;
    const size_t key_arena_root = 4096;
    if (!db_init_overflow_arena(&db->map_arena, map_value_heap_root)) return false;
    db->key_arena = cc_arena_heap(key_arena_root);
    if (!db->key_arena.valid()) {
        db_free_arenas_only(db);
        return false;
    }
    if (!db_init_overflow_arena(&db->value_arena, map_value_heap_root)) {
        db_free_arenas_only(db);
        return false;
    }
    db->entries = RedisDbMap_init_count(&db->map_arena, bucket_count);
    if (!db->entries) {
        db_free_arenas_only(db);
        return false;
    }
    return true;
}

static void db_release_value(RedisDb* db, CCString* value) {
    if (!db || !value) return;
    if (value->heap_data()) {
        db_mem_stats_note_value_release(value->cap());
    }
    value->release(&db->value_arena);
}

/* Replace path for an existing STR-arm payload.  In-place overwrite when
 * the new value fits the old capacity — the happy case for constant-width
 * SET benchmarks.  Growing values clone a replacement into db->value_arena
 * and release the superseded buffer. */
static void !>(CCError) db_value_replace(RedisDb* db, CCString* cell, char[:] value) {
    @errhandler(CCError e) { return cc_err(e); }
    if (!cell) return cc_err(CC_ERROR(CC_ERR_INVALID_ARG, "db replace without entry"));
    if (value.len + 1 <= cell->cap()) {
        if (!cell->clear()) {
            return cc_err(CC_ERROR(CC_ERR_OUT_OF_MEMORY, "entry value clear failed"));
        }
        if (!cell->push_slice(value, &db->value_arena)) {
            return cc_err(CC_ERROR(CC_ERR_OUT_OF_MEMORY, "entry value replace failed"));
        }
        return cc_ok();
    }
    CCString replacement =
        db_clone_value_into_arena(&db->value_arena, value, "entry value clone failed") !>;
    db_release_value(db, cell);
    *cell = replacement;
    return cc_ok();
}

/* Store `value` bytes as the entry's str arm.  A str cell keeps the
 * in-place-overwrite fast path (db_value_replace); a num cell owns no
 * buffer, so the bytes clone fresh and the one-line transition installs
 * the str arm (nothing to drop: int64 carries no destructor). */
static void !>(CCError) db_entry_store_str(RedisDb* db, RedisValue* val, char[:] value) {
    @errhandler(CCError e) { return cc_err(e); }
    if (val->kind == .str) {
        db_value_replace(db, &val->str, value) !>;
        return cc_ok();
    }
    CCString cloned =
        db_clone_value_into_arena(&db->value_arena, value, "entry value clone failed") !>;
    *val = { .str = cloned };
    return cc_ok();
}

static RedisEntry* db_find_entry(RedisDb* db, char[:] key) {
    if (!db || !db->entries) return NULL;
    CCSliceHdr kh = db_key_hdr_view(key);
    return RedisDbMap_get_ptr(db->entries, kh);
}

/* ---- lazy expiration ----
 * One wall-clock sample per request: execute_request seeds now_cache = -1
 * and every expiry-aware helper reads through db_req_now, so a request sees
 * a single consistent "now" (and the no-TTL hot path never touches the
 * clock).  Deadlines are absolute wall milliseconds; 0 means no expiry. */
static int64_t redis_now_ms(void) {
    struct timespec ts;
    clock_gettime(CLOCK_REALTIME, &ts);
    return (int64_t)ts.tv_sec * 1000 + (int64_t)(ts.tv_nsec / 1000000);
}

static int64_t db_req_now(int64_t* now_cache) {
    if (*now_cache < 0) *now_cache = redis_now_ms();
    return *now_cache;
}

static bool db_entry_expired(const RedisEntry* cell, int64_t* now_cache) {
    if (cell->expires_at_ms == 0) return false;
    return db_req_now(now_cache) >= cell->expires_at_ms;
}

/* Remove one entry outright (value released, key accounted).  The key bytes
 * stay in the growable key arena until db teardown — same policy as DEL had
 * from the start (arena keys are not individually freeable). */
static void db_remove_entry(RedisDb* db, char[:] key, RedisEntry* cell) {
    RedisValue* val = &cell->val;
    CCString doomed = val->str ?> cc_string_new();  /* num arms own no bytes */
    CCSliceHdr kh = db_key_hdr_view(key);
    if (!RedisDbMap_del(db->entries, kh)) return;
    db_mem_stats_note_key_release(key.len);
    db_release_value(db, &doomed);
}

/* THE read path: every command that touches a key goes through here so
 * expired entries die on first contact (lazy expiration, no active cycle). */
static RedisEntry* db_lookup_live(RedisDb* db, char[:] key, int64_t* now_cache) {
    RedisEntry* cell = db_find_entry(db, key);
    if (!cell) return NULL;
    if (db_entry_expired(cell, now_cache)) {
        db_remove_entry(db, key, cell);
        return NULL;
    }
    return cell;
}

static CCSliceHdr !>(CCError) db_clone_key_hdr(RedisDb* db, char[:] key) {
    @errhandler(CCError e) { return cc_err(e); }
    if (!db) return cc_err(CC_ERROR(CC_ERR_INVALID_ARG, "db key clone without db"));
    CCSliceHdr view = db_key_hdr_view(key);
    CCSliceHdr stable = cc_slice_hdr_clone_into(&view, &db->key_arena) !>;
    return cc_ok(stable);
}

static void !>(CCError) db_insert_value(RedisDb* db, CCSliceHdr owned_key, RedisEntry entry) {
    if (!db || !db->entries) {
        return cc_err(CC_ERROR(CC_ERR_INVALID_ARG, "db insert without entry"));
    }
    if (RedisDbMap_insert(db->entries, owned_key, entry) != 0) {
        return cc_err(CC_ERROR(CC_ERR_OUT_OF_MEMORY, "db insert failed"));
    }
    return cc_ok();
}

/* Create path shared by db_set and db_incrby's fresh-key arm: clone the
 * key, insert the entry, account the key bytes.  On insert failure a
 * str-arm payload is released; num arms own nothing. */
static void !>(CCError) db_insert_new_entry(RedisDb* db, char[:] key,
                                            RedisValue val, int64_t expires_at_ms) {
    @errhandler(CCError e) { return cc_err(e); }
    CCSliceHdr owned_key = db_clone_key_hdr(db, key) !>;
    RedisEntry entry;
    entry.val = val;
    entry.expires_at_ms = expires_at_ms;
    db_insert_value(db, owned_key, entry) !>(e) {
        RedisValue* pv = &entry.val;
        CCString doomed = pv->str ?> cc_string_new();
        db_release_value(db, &doomed);
        return cc_err(e);
    };
    db_mem_stats_note_key_alloc(key.len);
    return cc_ok();
}

/* Write path shared by SET/SETEX/PSETEX/MSET (and the create arms of
 * SETNX/APPEND/INCR).  `expires_at_ms` is the entry's NEW absolute deadline
 * (0 = none): a plain SET overwriting a key with a TTL clears that TTL,
 * per redis semantics.  An expired-but-unreaped cell is safe to overwrite
 * in place — that IS its reap. */
static RedisReply !>(CCError) db_set(RedisDb* db, char[:] key, char[:] value, int64_t expires_at_ms) {
    @errhandler(CCError e) { return cc_err(e); }
    if (!db || !db->entries) return cc_err(CC_ERROR(CC_ERR_OUT_OF_MEMORY, "db lookup failed"));

    RedisEntry* cell = db_find_entry(db, key);
    if (cell) {
        db_entry_store_str(db, &cell->val, value) !>;
        cell->expires_at_ms = expires_at_ms;
        return cc_ok(reply_simple("OK"));
    }

    CCString owned_str =
        db_clone_value_into_arena(&db->value_arena, value, "entry value clone failed") !>;
    db_insert_new_entry(db, key, (RedisValue){ .str = owned_str }, expires_at_ms) !>;
    return cc_ok(reply_simple("OK"));
}

/* GET: num cells render at the boundary (arena-less @string → reply_arena). */
static RedisReply !>(CCError) db_get(RedisDb* db, char[:] key,
                                     CCArena* reply_arena, int64_t* now_cache) {
    @errhandler(CCError e) { return cc_err(e); }
    RedisEntry* cell = db_lookup_live(db, key, now_cache);
    if (!cell) return cc_ok(reply_null());
    RedisValue* val = &cell->val;
    switch (val) {
        case .str: return cc_ok(reply_bulk(val->str.as_slice()));
        case .num: {
            int64_t n = val->num;
            char[:] text = @string(`${n}`);
            CCSlice bytes = reply_arena_alloc_slice(reply_arena, text.len) !>;
            memcpy((char*)bytes.ptr, text.ptr, text.len);
            return cc_ok(reply_bulk(bytes));
        }
    }
    return cc_err(CC_ERROR(CC_ERR_INVALID_ARG, "corrupt value cell"));
}

/* DEL/EXISTS share the variadic count shape: lazy expiry means a key that
 * timed out counts as absent for both (lookup_live reaps it first). */
static RedisReply db_del(RedisDb* db, CCSlice* keys, size_t nkeys, int64_t* now_cache) {
    int64_t removed = 0;
    if (!db || !db->entries) return reply_integer(0);
    for (size_t i = 0; i < nkeys; ++i) {
        RedisEntry* cell = db_lookup_live(db, keys[i], now_cache);
        if (!cell) continue;
        db_remove_entry(db, keys[i], cell);
        removed++;
    }
    return reply_integer(removed);
}

static RedisReply db_exists(RedisDb* db, CCSlice* keys, size_t nkeys, int64_t* now_cache) {
    int64_t found = 0;
    for (size_t i = 0; i < nkeys; ++i) {
        if (db_lookup_live(db, keys[i], now_cache)) found++;
    }
    return reply_integer(found);
}

static RedisReply db_type(RedisDb* db, char[:] key, int64_t* now_cache) {
    /* Only string values exist in this server. */
    return reply_simple(db_lookup_live(db, key, now_cache) ? "string" : "none");
}

static RedisReply db_strlen(RedisDb* db, char[:] key, int64_t* now_cache) {
    RedisEntry* cell = db_lookup_live(db, key, now_cache);
    if (!cell) return reply_integer(0);
    RedisValue* val = &cell->val;
    switch (val) {
        case .str: return reply_integer((int64_t)val->str.len());
        case .num: {
            /* length of the canonical decimal render, no storage touched */
            int64_t n = val->num;
            char[:] text = @string(`${n}`);
            return reply_integer((int64_t)text.len);
        }
    }
    return reply_integer(0);
}

static RedisReply !>(CCError) db_setnx(RedisDb* db, char[:] key, char[:] value, int64_t* now_cache) {
    @errhandler(CCError e) { return cc_err(e); }
    if (db_lookup_live(db, key, now_cache)) return cc_ok(reply_integer(0));
    db_set(db, key, value, 0) !>;
    return cc_ok(reply_integer(1));
}

/* APPEND keeps the entry's TTL (redis semantics).  Combined bytes are staged
 * in req scratch; safe while the try_send_into builder still holds req. */
static RedisReply !>(CCError) db_append(RedisDb* db,
                                        char[:] key,
                                        char[:] suffix,
                                        CCArena* scratch,
                                        int64_t* now_cache) {
    @errhandler(CCError e) { return cc_err(e); }
    RedisEntry* cell = db_lookup_live(db, key, now_cache);
    if (!cell) {
        db_set(db, key, suffix, 0) !>;
        return cc_ok(reply_integer((int64_t)suffix.len));
    }
    RedisValue* val = &cell->val;
    CCSlice old = cc_slice_empty();
    switch (val) {
        case .str: old = val->str.as_slice(); break;
        case .num: {
            /* Render the int cell into request scratch: the arena-less
             * @string buffer is block-scoped and must not escape this case. */
            int64_t n = val->num;
            char[:] text = @string(`${n}`);
            CCSlice copy = cc_arena_alloc_slice_bytes(scratch, text.len);
            if (!copy.ptr) {
                return cc_err(CC_ERROR(CC_ERR_OUT_OF_MEMORY, "append staging OOM"));
            }
            memcpy((char*)copy.ptr, text.ptr, text.len);
            old = copy;
            break;
        }
    }
    size_t new_len = old.len + suffix.len;
    CCSlice combined = cc_arena_alloc_slice_bytes(scratch, new_len);
    if (new_len > 0 && !combined.ptr) {
        return cc_err(CC_ERROR(CC_ERR_OUT_OF_MEMORY, "append staging OOM"));
    }
    if (old.len > 0) memcpy((char*)combined.ptr, old.ptr, old.len);
    if (suffix.len > 0) memcpy((char*)combined.ptr + old.len, suffix.ptr, suffix.len);
    db_entry_store_str(db, val, combined) !>;
    return cc_ok(reply_integer((int64_t)new_len));
}

/* INCR/DECR/INCRBY/DECRBY.  Existing entries keep their TTL (value edit);
 * a fresh entry starts at `delta` with no TTL.  The hot path (existing num
 * cell) is projection + checked add + num->num transition: no text parse,
 * no re-encode.  A str cell parses once in the `?>` fallback, then the
 * one-line transition installs the num arm — its CCString is released
 * first with the same value-arena accounting as before (int64 carries no
 * destructor, so the manual release IS the drop).  Error paths leave the
 * cell untouched. */
static RedisReply !>(CCError) db_incrby(RedisDb* db, char[:] key, int64_t delta, int64_t* now_cache) {
    @errhandler(CCError e) { return cc_err(e); }
    if (!db || !db->entries) return cc_err(CC_ERROR(CC_ERR_OUT_OF_MEMORY, "db lookup failed"));

    RedisEntry* cell = db_lookup_live(db, key, now_cache);

    int64_t value = delta;
    if (cell) {
        RedisValue* val = &cell->val;
        int64_t base = val->num ?> ({          /* fallback: parse the str arm */
            char[:] cur = val->str.as_slice();
            int64_t parsed = cur.to_i64() !> {
                return cc_err(CC_ERROR(CC_ERR_INVALID_ARG,
                                       "ERR value is not an integer or out of range"));
            };
            parsed;
        });
        value = cc_add_i64_checked(base, delta) !> {
            return cc_err(CC_ERROR(CC_ERR_INVALID_ARG, "ERR increment or decrement would overflow"));
        };
        if (val->kind == .str) {
            CCString doomed = val->str;
            db_release_value(db, &doomed);
        }
        *val = { .num = value };
    } else {
        db_insert_new_entry(db, key, (RedisValue){ .num = value }, 0) !>;
    }

    return cc_ok(reply_integer(value));
}

/* EXPIRE/PEXPIRE, already scaled to relative ms.  Non-positive TTL deletes
 * the key immediately and still answers 1 (redis semantics).  A deadline
 * past INT64_MAX clamps to "effectively never". */
static RedisReply db_expire_rel_ms(RedisDb* db, char[:] key, int64_t rel_ms, int64_t* now_cache) {
    RedisEntry* cell = db_lookup_live(db, key, now_cache);
    if (!cell) return reply_integer(0);
    if (rel_ms <= 0) {
        db_remove_entry(db, key, cell);
        return reply_integer(1);
    }
    int64_t now = db_req_now(now_cache);
    cell->expires_at_ms = (rel_ms > INT64_MAX - now) ? INT64_MAX : now + rel_ms;
    return reply_integer(1);
}

/* TTL/PTTL: -2 missing key, -1 no expiry, else remaining time (TTL rounds
 * the millisecond remainder UP, matching redis's second-granularity view). */
static RedisReply db_ttl(RedisDb* db, char[:] key, bool in_ms, int64_t* now_cache) {
    RedisEntry* cell = db_lookup_live(db, key, now_cache);
    if (!cell) return reply_integer(-2);
    if (cell->expires_at_ms == 0) return reply_integer(-1);
    int64_t rem = cell->expires_at_ms - db_req_now(now_cache);
    if (rem < 0) rem = 0;
    return reply_integer(in_ms ? rem : (rem + 999) / 1000);
}

static RedisReply db_persist(RedisDb* db, char[:] key, int64_t* now_cache) {
    RedisEntry* cell = db_lookup_live(db, key, now_cache);
    if (!cell || cell->expires_at_ms == 0) return reply_integer(0);
    cell->expires_at_ms = 0;
    return reply_integer(1);
}

/* MGET → WIRE array in reply_arena.  Pass 1 reaps; pass 2 re-reads with
 * a stable now_cache. */
static RedisReply !>(CCError) db_mget(RedisDb* db,
                                      CCSlice* keys,
                                      size_t nkeys,
                                      CCArena* reply_arena,
                                      int64_t* now_cache) {
    @errhandler(CCError e) { return cc_err(e); }
    for (size_t i = 0; i < nkeys; ++i) {
        (void)db_lookup_live(db, keys[i], now_cache);
    }

    CCSlice vals[REDIS_ARGV_MAX];
    bool found[REDIS_ARGV_MAX];
    /* Capacity hint, not wire math: per-element schema overhead is well
     * under 24 bytes (nil is 5); cc_write's 0-on-didn't-fit catches any
     * shortfall below and the loop doubles. */
    size_t cap = 16;
    for (size_t i = 0; i < nkeys; ++i) {
        RedisEntry* cell = db_lookup_live(db, keys[i], now_cache);
        found[i] = cell != NULL;
        if (cell) {
            RedisValue* val = &cell->val;
            switch (val) {
                case .str:
                    vals[i] = val->str.as_slice();
                    break;
                case .num: {
                    /* boundary render into the reply arena: stays valid
                     * through the (possibly repeated) encode below */
                    int64_t n = val->num;
                    char[:] text = @string(`${n}`);
                    CCSlice bytes = reply_arena_alloc_slice(reply_arena, text.len) !>;
                    memcpy((char*)bytes.ptr, text.ptr, text.len);
                    vals[i] = bytes;
                    break;
                }
            }
            cap += vals[i].len + 24;
        } else {
            cap += 8;
        }
    }

    /* Nil elements keep MGET off the single-array cc_write path (nil has no
     * RespGReply variant — see the schema comment), so the array is written
     * element-by-element under a schema-written "*<n>\r\n" header. */
    for (;;) {
        CCArenaCheckpoint cp = cc_arena_checkpoint(reply_arena);
        CCSlice out = reply_arena_alloc_slice(reply_arena, cap) !>;
        char* dst = (char*)out.ptr;
        RespGArrayHdr hdr = { .n = (long long)nkeys };
        size_t off = cc_write(RespGArrayHdr, &hdr, dst, out.len);
        bool fit = off != 0;
        for (size_t i = 0; fit && i < nkeys; ++i) {
            size_t w;
            if (found[i]) {
                RespGReply elem = wire_bulk(vals[i]);
                w = cc_write(RespGReply, &elem, dst + off, out.len - off);
            } else {
                RespGBulkHdr nil = { .len = -1 };
                w = cc_write(RespGBulkHdr, &nil, dst + off, out.len - off);
            }
            fit = w != 0;
            off += w;
        }
        if (fit) {
            out.len = off;
            return cc_ok(reply_wire(out));
        }
        cc_arena_restore(cp);
        if (cap >= (size_t)k_reply_encode_cap_max) {
            return cc_err(CC_ERROR(CC_ERR_OUT_OF_MEMORY, "mget reply encode overflow"));
        }
        cap *= 2; /* re-encode is safe: no map mutation since pass 1 reaped */
    }
}

static RedisReply !>(CCError) db_mset(RedisDb* db, CCSlice* args, size_t argc) {
    @errhandler(CCError e) { return cc_err(e); }
    for (size_t i = 0; i + 1 < argc; i += 2) {
        db_set(db, args[i], args[i + 1], 0) !>;
    }
    return cc_ok(reply_simple("OK"));
}

/* DBSIZE counts only live entries: expired-but-unreaped cells are skipped
 * (not deleted — no map mutation during iteration). */
static RedisReply db_dbsize(RedisDb* db, int64_t* now_cache) {
    int64_t n = 0;
    CCSliceHdr k;
    RedisEntry v;
    if (!db || !db->entries) return reply_integer(0);
    CC_ARRAY_MAP_FOREACH(db->entries, k, v) {
        if (v.expires_at_ms != 0 && db_req_now(now_cache) >= v.expires_at_ms) continue;
        n++;
    }
    return reply_integer(n);
}

/* FLUSHDB/FLUSHALL (one logical DB, so they are the same operation): a
 * mass-DEL.  Values are released with the usual accounting, then the map is
 * cleared in one shot; key bytes follow the standing DEL policy (arena-held
 * until db teardown). */
static RedisReply db_flush(RedisDb* db) {
    CCSliceHdr k;
    RedisEntry v;
    if (!db || !db->entries) return reply_simple("OK");
    CC_ARRAY_MAP_FOREACH(db->entries, k, v) {
        db_mem_stats_note_key_release(k.len);
        RedisValue* val = &v.val;
        CCString doomed = val->str ?> cc_string_new();  /* num arms own no bytes */
        db_release_value(db, &doomed);
    }
    RedisDbMap_clear(db->entries);
    return reply_simple("OK");
}

/* KEYS → WIRE array in reply_arena (count, then encode; skip expired). */
static RedisReply !>(CCError) db_keys(RedisDb* db,
                                      char[:] pattern,
                                      CCArena* reply_arena,
                                      int64_t* now_cache) {
    @errhandler(CCError e) { return cc_err(e); }
    /* Depth cap for glob_match's recursion (fiber stacks are ~2MiB). */
    enum { k_keys_pattern_max = 512 };
    if (pattern.len > (size_t)k_keys_pattern_max) {
        return cc_err(CC_ERROR(CC_ERR_INVALID_ARG, "ERR KEYS pattern too long"));
    }
    const char* pat = (const char*)pattern.ptr;
    CCSliceHdr k;
    RedisEntry v;

    size_t matched = 0;
    size_t cap = 16;
    if (db && db->entries) {
        CC_ARRAY_MAP_FOREACH(db->entries, k, v) {
            if (v.expires_at_ms != 0 && db_req_now(now_cache) >= v.expires_at_ms) continue;
            if (!glob_match(pat, pattern.len, (const char*)k.ptr, k.len)) continue;
            matched++;
            cap += k.len + 24;
        }
    }

    for (;;) {
        CCArenaCheckpoint cp = cc_arena_checkpoint(reply_arena);
        CCSlice out = reply_arena_alloc_slice(reply_arena, cap) !>;
        char* dst = (char*)out.ptr;
        RespGArrayHdr hdr = { .n = (long long)matched };
        size_t off = cc_write(RespGArrayHdr, &hdr, dst, out.len);
        bool fit = off != 0;
        if (fit && db && db->entries) {
            CC_ARRAY_MAP_FOREACH(db->entries, k, v) {
                if (v.expires_at_ms != 0 && db_req_now(now_cache) >= v.expires_at_ms) continue;
                if (!glob_match(pat, pattern.len, (const char*)k.ptr, k.len)) continue;
                RespGReply elem = wire_bulk(cc_slice_from_buffer((void*)k.ptr, k.len));
                size_t w = cc_write(RespGReply, &elem, dst + off, out.len - off);
                if (w == 0) { fit = false; break; }
                off += w;
            }
        }
        if (fit) {
            out.len = off;
            return cc_ok(reply_wire(out));
        }
        cc_arena_restore(cp);
        if (cap >= (size_t)k_reply_encode_cap_max) {
            return cc_err(CC_ERROR(CC_ERR_OUT_OF_MEMORY, "keys reply encode overflow"));
        }
        cap *= 2;
    }
}

/* Seconds → relative ms for EXPIRE/SETEX, clamped instead of overflowing. */
static int64_t expire_seconds_to_rel_ms(int64_t seconds) {
    if (seconds > INT64_MAX / 1000) return INT64_MAX;
    if (seconds < INT64_MIN / 1000) return INT64_MIN;
    return seconds * 1000;
}

/* SETEX/PSETEX: TTL must be strictly positive (redis errors on <= 0). */
static RedisReply !>(CCError) db_set_with_ttl(RedisDb* db,
                                              char[:] key,
                                              char[:] value,
                                              int64_t rel_ms,
                                              int64_t* now_cache) {
    @errhandler(CCError e) { return cc_err(e); }
    if (rel_ms <= 0) {
        return cc_err(CC_ERROR(CC_ERR_INVALID_ARG, "ERR invalid expire time"));
    }
    int64_t now = db_req_now(now_cache);
    int64_t deadline = (rel_ms > INT64_MAX - now) ? INT64_MAX : now + rel_ms;
    return db_set(db, key, value, deadline);
}

static int db_preload_key_count(void) {
    const char* s = getenv("CC_REDIS_PRELOAD_KEYS");
    if (!s || !s[0]) return 0;
    char* end = NULL;
    long n = strtol(s, &end, 10);
    if (end == s || (end && *end != 0) || n <= 0) return 0;
    return (int)n;
}

static bool !>(CCError) db_preload_keys(RedisDb* db, int count) {
    @errhandler(CCError e) { return cc_err(e); }
    if (!db || count <= 0) return cc_ok(true);
    static const char preload_value[] = "0";
    for (int i = 0; i < count; ++i) {
        char key_buf[32];
        int n = snprintf(key_buf, sizeof(key_buf), "key:%d", i);
        if (n <= 0 || (size_t)n >= sizeof(key_buf)) {
            return cc_err(CC_ERROR(CC_ERR_INVALID_ARG, "preload key encode failed"));
        }
        db_set(db,
               cc_slice_from_buffer(key_buf, (size_t)n),
               cc_slice_from_buffer((void*)preload_value, sizeof(preload_value) - 1),
               0) !>(e) { return cc_err(e); };
    }
    return cc_ok(true);
}

static bool db_preload_keys_ok(RedisDb* db, int count) {
    return cc_is_ok(db_preload_keys(db, count));
}

/* Owner dispatch (@noblock).  Builders may borrow req/DB; ensure_owned runs
 * before the slot is released.  `now` sampled at most once (db_req_now). */
@noblock static RedisReply !>(CCError) execute_request_body(RedisDb* db,
                                                           RedisRequest* req,
                                                           CCArena* reply_arena) {
    @errhandler(CCError e) { return cc_err(e); }
    int64_t now = -1;
    switch (req->kind) {
        case REDIS_CMD_PING:
            if (req->argc == 1) return cc_ok(reply_bulk(req->argv[0]));
            return cc_ok(reply_simple("PONG"));
        case REDIS_CMD_ECHO:
            return cc_ok(reply_bulk(req->argv[0]));
        case REDIS_CMD_CONFIG_GET:
            return config_get_reply(req->argv[0], reply_arena);
        case REDIS_CMD_GET:
            return db_get(db, req->argv[0], reply_arena, &now);
        case REDIS_CMD_SET:
            return db_set(db, req->argv[0], req->argv[1], 0);
        case REDIS_CMD_SETNX:
            return db_setnx(db, req->argv[0], req->argv[1], &now);
        case REDIS_CMD_SETEX: {
            char[:] secs_arg = req->argv[1];
            int64_t seconds = secs_arg.to_i64() !>;
            return db_set_with_ttl(db, req->argv[0], req->argv[2],
                                   expire_seconds_to_rel_ms(seconds), &now);
        }
        case REDIS_CMD_PSETEX: {
            char[:] ms_arg = req->argv[1];
            int64_t ms = ms_arg.to_i64() !>;
            return db_set_with_ttl(db, req->argv[0], req->argv[2], ms, &now);
        }
        case REDIS_CMD_APPEND:
            return db_append(db, req->argv[0], req->argv[1], &req->arena, &now);
        case REDIS_CMD_STRLEN:
            return cc_ok(db_strlen(db, req->argv[0], &now));
        case REDIS_CMD_TYPE:
            return cc_ok(db_type(db, req->argv[0], &now));
        case REDIS_CMD_DEL:
            return cc_ok(db_del(db, req->argv, req->argc, &now));
        case REDIS_CMD_EXISTS:
            return cc_ok(db_exists(db, req->argv, req->argc, &now));
        case REDIS_CMD_INCR:
            return db_incrby(db, req->argv[0], 1, &now);
        case REDIS_CMD_DECR:
            return db_incrby(db, req->argv[0], -1, &now);
        case REDIS_CMD_INCRBY: {
            char[:] delta_arg = req->argv[1];
            int64_t delta = delta_arg.to_i64() !>;
            return db_incrby(db, req->argv[0], delta, &now);
        }
        case REDIS_CMD_DECRBY: {
            char[:] delta_arg = req->argv[1];
            int64_t delta = delta_arg.to_i64() !>;
            int64_t neg = cc_sub_i64_checked(0, delta) !> {
                return cc_err(CC_ERROR(CC_ERR_INVALID_ARG,
                                       "ERR decrement would overflow"));
            };
            return db_incrby(db, req->argv[0], neg, &now);
        }
        case REDIS_CMD_MGET:
            return db_mget(db, req->argv, req->argc, reply_arena, &now);
        case REDIS_CMD_MSET:
            return db_mset(db, req->argv, req->argc);
        case REDIS_CMD_EXPIRE: {
            char[:] secs_arg = req->argv[1];
            int64_t seconds = secs_arg.to_i64() !>;
            return cc_ok(db_expire_rel_ms(db, req->argv[0],
                                          expire_seconds_to_rel_ms(seconds), &now));
        }
        case REDIS_CMD_PEXPIRE: {
            char[:] ms_arg = req->argv[1];
            int64_t ms = ms_arg.to_i64() !>;
            return cc_ok(db_expire_rel_ms(db, req->argv[0], ms, &now));
        }
        case REDIS_CMD_TTL:
            return cc_ok(db_ttl(db, req->argv[0], false, &now));
        case REDIS_CMD_PTTL:
            return cc_ok(db_ttl(db, req->argv[0], true, &now));
        case REDIS_CMD_PERSIST:
            return cc_ok(db_persist(db, req->argv[0], &now));
        case REDIS_CMD_DBSIZE:
            return cc_ok(db_dbsize(db, &now));
        case REDIS_CMD_FLUSHDB:
        case REDIS_CMD_FLUSHALL:
            return cc_ok(db_flush(db));
        case REDIS_CMD_KEYS:
            return db_keys(db, req->argv[0], reply_arena, &now);
        case REDIS_CMD_CC_MEMLOG:
            /* Explicit debug-command exception: diagnostics may block stderr. */
            db_dump_mem_stats(db, "cc-memlog");
            redis_mem_report_impl(db, "cc-memlog");
            return cc_ok(reply_simple("OK"));
        default:
            return cc_err(CC_ERROR(CC_ERR_INVALID_ARG, "ERR unsupported command"));
    }
}

/* Payload ownership for the reply channel (RedisConn lifetime §2).
 * materialize_in only — kind unchanged.  Empty / canonical / already in
 * reply_arena are no-ops (PONG/OK stay static; GET-str copies DB bytes;
 * WIRE arrays built in-arena stay put).  Encode belongs at socket write. */
@noblock static inline bool !>(CCError) redis_reply_ensure_owned(RedisReply* reply,
                                                                      CCArena* reply_arena) {
    if (!reply || !reply_arena) {
        return cc_err(CC_ERROR(CC_ERR_INVALID_ARG, "reply ensure_owned null"));
    }
    return reply->data.materialize_in(reply_arena);
}

@noblock static RedisReply !>(CCError) execute_request(RedisDb* db,
                                                       RedisRequest* req,
                                                       CCArena* reply_arena) {
    @errhandler(CCError e) { return cc_err(e); }
    RedisReply reply = execute_request_body(db, req, reply_arena) !>;
    redis_reply_ensure_owned(&reply, reply_arena) !>;
    return cc_ok(reply);
}

static void db_free_all(RedisDb* db) {
    if (!db) return;
    if (db->entries) {
        RedisDbMap_destroy(db->entries);
        db->entries = NULL;
    }
    db_free_arenas_only(db);
}

static bool write_all(CCSocket* sock, CCSlice data) {
    CCNetError err = CC_NET_OK;
    size_t off = 0;
    const int write_deadline_ms = 1000;
    CCDeadline deadline = cc_deadline_after_ms(write_deadline_ms);
    while (off < data.len) {
        size_t n = cc_socket_write_deadline(sock,
                                            (const char*)data.ptr + off,
                                            data.len - off,
                                            &err,
                                            &deadline);
        if (err != CC_NET_OK || n == 0) return false;
        off += n;
    }
    return true;
}

static bool redis_conn_flush_out(RedisConn* conn) {
    if (!conn || conn->out_len == 0) return true;
    CCSlice data = {
        .ptr = conn->out_buf,
        .len = conn->out_len,
    };
    conn->out_len = 0;
    return write_all(conn->sock, data);
}

static bool redis_conn_write_bytes(RedisConn* conn, CCSlice data) {
    if (!conn || data.len == 0) return true;
    if (data.len > redis_conn_out_buf_bytes) {
        return conn->flush_out() && write_all(conn->sock, data);
    }
    if (conn->out_len + data.len > redis_conn_out_buf_bytes) {
        if (!conn->flush_out()) return false;
    }
    memcpy(conn->out_buf + conn->out_len, data.ptr, data.len);
    conn->out_len += data.len;
    return true;
}

/* One schema-written reply into conn->out_buf.  cc_write's 0-on-didn't-fit
 * drives the existing buffer discipline: try the remaining space, flush and
 * retry into the whole buffer, and only a reply bigger than the buffer
 * itself falls through to streaming (schema-written bulk header, then the
 * payload slice, then the closing CRLF pair). */
static bool redis_conn_write_wire_reply(RedisConn* conn, const RespGReply* wire) {
    size_t w = cc_write(RespGReply, wire, conn->out_buf + conn->out_len,
                        redis_conn_out_buf_bytes - conn->out_len);
    if (w == 0) {
        if (!conn->flush_out()) return false;
        w = cc_write(RespGReply, wire, conn->out_buf, redis_conn_out_buf_bytes);
    }
    if (w != 0) {
        conn->out_len += w;
        return true;
    }
    /* Bigger than the whole out_buf: only bulk payloads can get here
     * (simple/error carry short static messages; integers are <= 22 bytes).
     * Anything else oversized is a bug — fail the write loudly. */
    if (wire->kind != RespGReply_bulk) return false;
    RespGBulkHdr hdr = { .len = (long long)wire->u.bulk.data.len };
    size_t hw = cc_write(RespGBulkHdr, &hdr, conn->out_buf, redis_conn_out_buf_bytes);
    if (hw == 0) return false;
    conn->out_len = hw; /* buffer is empty after the flush above */
    return conn->write_bytes(wire->u.bulk.data) &&
           conn->write_bytes(cc_slice_from_cstr("\r\n"));
}

static bool redis_conn_write_reply(RedisConn* conn, const RedisReply* reply) {
    if (!conn || !reply) return false;
    size_t w = cc_write(RedisReply, reply,
                        conn->out_buf + conn->out_len,
                        redis_conn_out_buf_bytes - conn->out_len);
    if (w == 0) {
        if (!conn->flush_out()) return false;
        w = cc_write(RedisReply, reply, conn->out_buf, redis_conn_out_buf_bytes);
    }
    if (w != 0) {
        conn->out_len += w;
        return true;
    }
    if (reply->kind == REDIS_REPLY_WIRE) {
        return conn->write_bytes(reply->data);
    }
    if (reply->kind != REDIS_REPLY_BULK_STRING) return false;
    RespGReply wire;
    if (!redis_reply_to_wire(reply, &wire)) return false;
    return conn->write_wire_reply(&wire);
}

static CCSlice !>(CCError) reply_arena_alloc_slice(CCArena* reply_arena, size_t n) {
    CCSlice s = cc_arena_alloc_slice_bytes(reply_arena, n);
    if (n > 0 && !s.ptr) return cc_err(CC_ERROR(CC_ERR_OUT_OF_MEMORY, "reply encode OOM"));
    return cc_ok(s);
}

/* First reply_arena slab: enough for ~k_pipeline_reply_cap hot replies; larger
 * payloads spill to heap blocks. */
/* Connection setup allocates local runtime resources but performs no
 * externally-dependent wait. */
@noblock static RedisConn* redis_conn_create(uint64_t conn_id) {
    RedisConn* conn = calloc(1, sizeof(*conn));
    if (!conn) return NULL;

    ReplyTx reply_tx;
    ReplyRx reply_rx;
    CCChan* reply_ch = cc_channel_pair(&reply_tx, &reply_rx);
    if (!reply_ch) { free(conn); return NULL; }

    const size_t reply_arena_initial = 16 * 1024;
    conn->reply_arena = cc_arena_heap(reply_arena_initial);
    if (!conn->reply_arena.base) {
        cc_channel_free(reply_tx);
        free(conn);
        return NULL;
    }
    conn->reply_arena.block_max = 0;
    if (cc_arena_pool(&conn->req_pool, sizeof(RedisRequest)) != 0) {
        cc_arena_free(&conn->reply_arena);
        cc_channel_free(reply_tx);
        free(conn);
        return NULL;
    }
    conn->reply_tx = reply_tx;
    conn->reply_rx = reply_rx;
    conn->inflight = 0;
    conn->conn_id = conn_id;
    conn->next_request_id = 1;
    return conn;
}

static void redis_conn_destroy(RedisConn* conn) {
    /* Only after RedisConn lifetime §3 (drain-to-zero / channel close). */
    cc_arena_free(&conn->reply_arena);
    cc_arena_pool_destroy(&conn->req_pool);
    cc_channel_free(conn->reply_tx);
    free(conn);
}

/* One-shot error-reporting path: serialize directly into conn->out_buf
 * and flush immediately. */
static bool redis_conn_write_reply_now(RedisConn* conn, RedisReply reply) {
    return conn->write_reply(&reply) && conn->flush_out();
}

/* Free req arena spill and return the pool slot.  @noblock is load-bearing
 * on the owner hot path (blocking-pool dispatch was ~3x slower on SET). */
@noblock static void redis_conn_release_slot(RedisConn* conn, RedisRequest* req) {
    if (!req || !conn) return;
    cc_arena_free(&req->arena);
    cc_arena_pool_free(&conn->req_pool, req);
}

/* Teardown join (RedisConn lifetime §3): discard one reply per inflight. */
static void redis_conn_drain_inflight(RedisConn* conn) {
    RedisReply discard = {0};
    if (!conn) return;
    while (conn->inflight > 0 &&
           cc_io_avail(cc_channel_recv(conn->reply_rx, &discard))) {
        conn->inflight--;
    }
}

/* @defer backstop if the iteration exits before an explicit release. */
@noblock static void owner_release_pending(RedisConn* conn, RedisRequest** req) {
    if (req && *req) {
        redis_conn_release_slot(conn, *req);
        *req = NULL;
    }
}


static inline void reply_arena_reset(RedisConn* conn) {
    if (!conn) return;
    cc_arena_reset(&conn->reply_arena);
}

/* Owner loop: drain requests, execute, reply.  `db` is stack-local so
 * it can't outlive the owner and nobody else can take its address. */
@async int owner_loop(ReqRx req_rx) {
    RedisDb db = {0};
    bool db_ready = false;
    db_ready = db_init(&db, 1024);
    if (!db_ready) {
        char scratch_buf[256];
        @nonblocking {
            CCArena scratch = @create(scratch_buf, sizeof(scratch_buf)) @destroy;
            CCString line = @string("redis_idiomatic: db_init failed (out of memory?)", &scratch);
            redis_diag_fprintln(&line, &scratch);
        }
        return 1;
    }
    int preload_keys = db_preload_key_count();
    if (preload_keys > 0) {
        bool preload_ok = false;
        preload_ok = db_preload_keys_ok(&db, preload_keys);
        if (!preload_ok) {
            fprintf(stderr, "redis_idiomatic: preload failed\n");
            return 1;
        }
        size_t preload_key_count = (size_t)preload_keys;
        char preload_scratch_buf[128];
        {
            CCArena preload_scratch =
                @create(preload_scratch_buf, sizeof(preload_scratch_buf)) @destroy;
            CCString line =
                @string(`redis_idiomatic: preloaded ${preload_key_count} keys`, &preload_scratch);
            redis_diag_fprintln(&line, &preload_scratch);
        }
        db_dump_mem_stats(&db, "post-preload");
    }
    redis_mem_report(&db, "owner-ready");
    @defer db_free_all(&db);

    /* The request loop is the owner CPU/fiber hot path.  Its direct sync
     * boundary helpers carry @noblock; cold startup retains the default
     * blocking policy. */
    RedisRequest* req = NULL;
    while (cc_io_avail(req_rx.recv(&req))) {
        if (!req || !req->conn) continue;

        RedisConn* conn = req->conn;
        @defer owner_release_pending(conn, &req);
        @errhandler(CCError e) {
            if (req) { redis_conn_release_slot(conn, req); req = NULL; }
            cc_channel_close(conn->reply_tx, cc_io_error(e));
            return 0;
        }

        /* Reserve-then-write.  [dbp = &db]: value-capture pointer (not [&db]). */
        CCResult_bool_CCIoError queued =
            conn->reply_tx.try_send_into(
                (slot, arena) => [dbp = &db, req] {
                    CCResult_RedisReply_CCError built =
                        execute_request(dbp, req, arena);
                    if (built.is_err()) *slot = err_reply(built.error());
                    else *slot = built.value();
                    return NULL;
                },
                &conn->reply_arena);
        if (cc_is_err(queued)) {
            cc_channel_close(conn->reply_tx, queued.error());
            continue;
        }
        if (!cc_value(queued)) {
            cc_channel_close(conn->reply_tx, cc_io_error(CC_IO_CONNECTION_CLOSED));
            continue;
        }
        redis_conn_release_slot(conn, req);
        req = NULL;
    }
    return 0;
}

/* Direct boundaries from handle_client.  Channel/socket waits are fiber-aware:
 * these helpers may park the current fiber but do not block the OS worker. */
@noblock static RedisPipelineStatus !>(CCError) submit_pipeline_window(RedisConn* conn,
                                                            ReqTx req_tx,
                                                            ReqIter* req_iter,
                                                            RedisPipelineWindow* window) {
    @errhandler(CCError e) { return cc_err(e); }
    if (!window) return cc_err(CC_ERROR(CC_ERR_INVALID_ARG, "pipeline window null"));

    window->submitted = 0;
    window->replies_pending = 0;
    while (redis_pipeline_window_has_room(window)) {
        RedisRequest* req = NULL;
        bool has = rr_req_iter_next(req_iter, &req) !>;
        if (!has) break;
        conn->next_request_id++;
        CCResult_bool_CCIoError send_res = cc_channel_send(req_tx, req);
        if (cc_is_err(send_res) || !send_res.u.value) {
            redis_conn_release_slot(conn, req);
            return cc_ok(REDIS_PIPELINE_OWNER_UNAVAILABLE);
        }
        redis_pipeline_window_accept(window);
        conn->inflight++;
    }

    return cc_ok(REDIS_PIPELINE_OK);
}

@noblock static RedisPipelineStatus drain_pipeline_window(RedisConn* conn, RedisPipelineWindow* window) {
    if (!window) return REDIS_PIPELINE_REPLY_CLOSED;
    @defer reply_arena_reset(conn);
    while (window->replies_pending > 0) {
        RedisReply reply = {0};
        CCResult_bool_CCIoError recv_res = cc_channel_recv(conn->reply_rx, &reply);
        if (cc_is_err(recv_res) || !recv_res.u.value) return REDIS_PIPELINE_REPLY_CLOSED;
        window->replies_pending--;
        conn->inflight--;
        if (!conn->write_reply(&reply)) return REDIS_PIPELINE_WRITE_FAILED;
    }

    /* One socket write for the whole submitted pipeline window. */
    if (conn->out_len > 0 && !conn->flush_out()) return REDIS_PIPELINE_WRITE_FAILED;
    return REDIS_PIPELINE_OK;
}

/* Per-connection driver.  One outer iteration = one pipeline window:
 * submit / drain / flush / rr_fill (phases labeled inline). */
@async int handle_client(CCSocket client, ReqTx req_tx, uint64_t conn_id) {
    @defer cc_socket_close(&client);
    /* @destroy runs RedisConn lifetime §3, then redis_conn_destroy. */
    RedisConn* conn = redis_conn_create(conn_id) !> { return 1; }     @destroy {
        redis_conn_drain_inflight(conn);
    };
    conn->sock = &client;

    /* Large enough for pipelined redis-benchmark without constant compact moves. */
    char read_buf[64 * 1024];
    RespReader reader;
    @nonblocking { reader = rr_init(read_buf, sizeof(read_buf)); }
    ReqIter req_iter = rr_req_iter(&reader, conn);
    while (true) {
        /* Any CCError surfaced via !> in this window becomes one
         * err_reply and we tear down via the outer @defer. */
        @errhandler(CCError e) {
            (void)conn->write_reply_now(err_reply(e));
            return 0;
        }

        /* Submit: up to k_pipeline_reply_cap parsed requests to the owner.  Every
         * accepted request owes exactly one RedisReply back on reply_rx. */
        RedisPipelineWindow window = redis_pipeline_window_start();
        RedisPipelineStatus submit_status =
            submit_pipeline_window(conn, req_tx, &req_iter, &window) !>;
        if (submit_status == REDIS_PIPELINE_OWNER_UNAVAILABLE) {
            (void)conn->write_reply_now(reply_error("ERR owner channel unavailable"));
            return 0;
        }
        if (submit_status != REDIS_PIPELINE_OK) return 0;

        /* Drain/flush: exactly one RedisReply per submitted request. */
        RedisPipelineStatus drain_status = drain_pipeline_window(conn, &window);
        if (drain_status != REDIS_PIPELINE_OK) return 0;

        /* If the socket read already buffered more complete/partial commands
         * and this window stopped only because of k_pipeline_reply_cap, keep
         * parsing before parking on another read.  Otherwise -P larger than
         * the reply-channel depth can leave commands stranded in read_buf
         * while the fiber waits for new socket readiness that may never arrive. */
        if (redis_pipeline_window_is_full(&window) && reader.start < reader.end) continue;

        /* rr_fill: park until more bytes arrive or EOF. */
        bool more = redis_rr_fill(&reader, &client) !>(e) {
            conn->write_reply_now(io_err_reply(e));
            return 0;
        };
        if (!more) return 0;
    }
}

int main(int argc, char** argv) {
    @errhandler(CCError e) {
        char scratch_buf[256];
        CCArena scratch = @create(scratch_buf, sizeof(scratch_buf)) @destroy;
        const char* msg = e.message ? e.message : "unknown error";
        CCString line = @string(`fatal: ${msg}`, &scratch);
        redis_diag_fprintln(&line, &scratch);
        return 1;
    }

    int port = 6380;
    if (argc > 1) {
        char* end = NULL;
        long parsed = strtol(argv[1], &end, 10);
        if (end == argv[1] || (end && *end != 0) || parsed <= 0 || parsed > 65535) {
            char scratch_buf[256];
            CCArena scratch = @create(scratch_buf, sizeof(scratch_buf)) @destroy;
            CCString line = @string(`invalid port: ${argv[1]}`, &scratch);
            redis_diag_fprintln(&line, &scratch);
            return 1;
        }
        port = (int)parsed;
    }

    char addr[64];
    snprintf(addr, sizeof(addr), "127.0.0.1:%d", port);

    /* cc_tcp_listen uses an out-param, so guard explicitly instead
     * of !>; everything else in this function uses unwrap sugar. */
    CCNetError err = CC_NET_OK;
    CCListener ln = cc_tcp_listen(addr, strlen(addr), &err);
    if (err != CC_NET_OK) {
        char scratch_buf[256];
        CCArena scratch = @create(scratch_buf, sizeof(scratch_buf)) @destroy;
        CCString line = @string(`listen error: ${(int)err}`, &scratch);
        redis_diag_fprintln(&line, &scratch);
        return 1;
    }
    @defer cc_listener_close(&ln);

    ReqTx req_tx;
    ReqRx req_rx;
    CCChan* req_ch = cc_channel_pair(&req_tx, &req_rx) !> @destroy;

    CCListener* ln_ptr = &ln;

    printf("redis_idiomatic listening on %s\n", addr);
    fflush(stdout);

    {
        CCNursery* server = cc_nursery_create(NULL) !> @destroy;
        /* On cancel, close req_tx so owner_loop's recv returns
         * Ok(false) and the owner exits cleanly. */
        (void)server->close_on(req_tx);

        static const int shutdown_sigs[] = { SIGINT, SIGTERM };
        if (server->cancel_on_signals(shutdown_sigs,
                                         sizeof(shutdown_sigs) / sizeof(shutdown_sigs[0])) != 0) {
            char scratch_buf[256];
            CCArena scratch = @create(scratch_buf, sizeof(scratch_buf)) @destroy;
            CCString line =
                @string("redis_idiomatic: failed to install shutdown handler", &scratch);
            redis_diag_fprintln(&line, &scratch);
            return 1;
        }

        server->spawn(() => [ln_ptr, req_tx, req_ch, server] {
            uint64_t next_conn_id = 1;
            while (true) {
                CCNetError aerr = CC_NET_OK;
                CCSocket client = ln_ptr->accept(&aerr);
                if (aerr != CC_NET_OK) {
                    if (!server->is_cancelled()) {
                        char scratch_buf[256];
                        CCArena scratch = @create(scratch_buf, sizeof(scratch_buf)) @destroy;
                        CCString line =
                            @string(`redis_idiomatic accept error: ${(int)aerr}`, &scratch);
                        redis_diag_fprintln(&line, &scratch);
                    }
                    break;
                }

                /* TCP_NODELAY: redis-benchmark's pipelined pattern
                 * (write N, read N, repeat) interacts with Nagle +
                 * delayed-ACK to produce multi-second stalls. */
                int one = 1;
                (void)setsockopt(client.fd, IPPROTO_TCP, TCP_NODELAY, &one, sizeof(one));

                uint64_t id = next_conn_id++;
                (void)server->spawn_async(handle_client(client, req_tx, id));
            }
            cc_channel_close(req_ch);
        });

        (void)server->spawn_async(owner_loop(req_rx));
    }

    return 0;
}

/*
 * redis_idiomatic.ccs — default Concurrent-C Redis (complete).
 *
 * Same control flow as redis_async_sketch.ccs:
 *   parse → hold → execute(ConnEnc) encodes → release → flush
 * Full RedisDb / expiry / command surface underneath.
 *
 * Lifetimes:
 *   argv           → borrow read_buf for the pipeline window
 *   reply_arena    → DB scratch for num cells / MGET·KEYS wire blobs
 *   Conn.out       → encode coalesce (8K slab + growable); flush after
 *                    the window (never socket I/O under hold)
 *   RedisConnEnc   → @restricted Encode (no sock/flush)
 *   shard holds    → only in run_pipeline_window; cover mutate/snapshot
 *                    and Conn encode (bytes copied into out under hold)
 *
 * Build: `make redis_idiomatic`.  Tiny peer: `redis_async_sketch.ccs`.
 */

#include <ccc/std/prelude.cch>
#include <ccc/cc_instantiate.cch>
#include <ccc/std/net.cch>
#include <ccc/std/map.cch>
#include <ccc/std/static_map.cch>
#include <ccc/std/string.cch>
#include <ccc/script/stdio.cch>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <signal.h>
#include <unistd.h>
#include "redis_cc/redis_cc.cch"
#include <ccc/cc_exclusive.cch>

enum {
    k_pipeline_window_cap = 16,
    k_out_buf = 8192,
};

typedef struct RedisConn {
    CCArena reply_arena;
    CCSocket* sock;
    CCArena* arena;
    CCString out;
} RedisConn;

typedef @restricted Encode on RedisConn {
    r: reply_arena, write, lit, simple, err, ok, pong, null, integer, bulk,
       array_len, write_reply;
} *RedisConnEnc;

#include "redis_resp.cch"

@grammar(rules) Resp {~~~~
    include "redis_resp.rules"
~~~~}

/* Write schemas (db_mget / db_keys / CONFIG). Must live in the .ccs —
 * #'…' is not safe inside #included .cch (cpp). */
@grammar(schema) RespGReply {~~~~
    use Resp
    one of [
        simple  [ #'+' s: Resp.line "\r\n" ]
        error   [ #'-' msg: Resp.line "\r\n" ]
        integer [ #':' v: int Resp.number "\r\n" ]
        bulk    [ #'$' len: int Resp.number "\r\n" data: bytes len "\r\n" ]
        array   [ #'*' n: int Resp.number "\r\n" items: items RespGReply n ]
    ]
~~~~}

@grammar(schema) RespGBulk {~~~~
    use Resp
    #'$' len: int Resp.number
    one of [
        nil  [= -1] [ "\r\n" ]
        data [>= 0] [ "\r\n" payload: bytes len "\r\n" ]
    ] by len
~~~~}

@grammar(schema) RespGBulkArray {~~~~
    use Resp
    #'*' n: int Resp.number "\r\n"
    elems: items RespGBulk n
~~~~}

@grammar(schema) RespGBulkHdr {~~~~
    use Resp
    #'$' len: int Resp.number "\r\n"
~~~~}

@grammar(schema) RespGArrayHdr {~~~~
    use Resp
    #'*' n: int Resp.number "\r\n"
~~~~}

@grammar(schema) RespGArg {~~~~
    use Resp
    #'$' len: int Resp.number "\r\n"
    data: bytes len
    "\r\n"
~~~~}

@grammar(schema) RespGCmd {~~~~
    use Resp
    one of [
        framed [ #'*' argc: int Resp.number "\r\n" args: items RespGArg argc cap 8 ]
        plain  [ text: Resp.line "\r\n" ]
    ]
~~~~}

#include "redis_reply.cch"

static RespParseStatus gen_try_read_args_buffered(RespReader* r,
                                                  CCSlice* args,
                                                  size_t cap,
                                                  size_t* out_argc,
                                                  CCError* err) {
    while (1) {
        size_t pos = 0;
        RespGCmd c;
        bool !>(CCError) tr = RespGCmd_try_read((const char*)(r->data + r->start),
                                                r->end - r->start, &pos, NULL, &c);
        if (tr.is_err()) {
            if (tr.error().kind == CC_ERR_WOULD_BLOCK) return RESP_PARSE_INCOMPLETE;
            *err = tr.error();
            return RESP_PARSE_ERROR;
        }
        if (!tr.value()) return RESP_PARSE_INCOMPLETE;
        if (c.kind == RespGCmd_plain) {
            size_t !>(CCError) pargs = parse_inline_args(c.plain.text, args, cap);
            if (pargs.is_err()) { *err = pargs.error(); return RESP_PARSE_ERROR; }
            r->start += pos;
            if (pargs.value() == 0) continue;
            *out_argc = pargs.value();
            return RESP_PARSE_OK;
        }
        if (c.kind == RespGCmd_framed) {
            if (c.framed.args_n > cap) {
                *err = CC_ERROR(CC_ERR_PARSE, "unsupported argument count");
                return RESP_PARSE_ERROR;
            }
            r->start += pos;
            if (c.framed.args_n == 0) continue;
            for (size_t i = 0; i < c.framed.args_n; i++) args[i] = c.framed.args[i].data;
            *out_argc = c.framed.args_n;
            return RESP_PARSE_OK;
        }
        *err = CC_ERROR(CC_ERR_PARSE, "unsupported RESP command shape");
        return RESP_PARSE_ERROR;
    }
}

typedef enum RedisCmdHold {
    REDIS_HOLD_KEY = 0,
    REDIS_HOLD_NONE,
    REDIS_HOLD_INSTALL,
    REDIS_HOLD_KEYS,
    REDIS_HOLD_ALL,
} RedisCmdHold;

typedef struct RedisCommandSpec {
    RedisCommandKind kind;
    int min_args;
    int max_args;
    int args_multiple;
} RedisCommandSpec;

typedef struct RedisCommandEntry {
    const char* key;
    RedisCommandSpec value;
} RedisCommandEntry;

@comptime {
    RedisCommandEntry commands[] = {
        { "PING", { REDIS_CMD_PING, 0, 1, 0 } },
        { "ECHO", { REDIS_CMD_ECHO, 1, 1, 0 } },
        { "GET", { REDIS_CMD_GET, 1, 1, 0 } },
        { "SET", { REDIS_CMD_SET, 2, 2, 0 } },
        { "SETNX", { REDIS_CMD_SETNX, 2, 2, 0 } },
        { "SETEX", { REDIS_CMD_SETEX, 3, 3, 0 } },
        { "PSETEX", { REDIS_CMD_PSETEX, 3, 3, 0 } },
        { "APPEND", { REDIS_CMD_APPEND, 2, 2, 0 } },
        { "STRLEN", { REDIS_CMD_STRLEN, 1, 1, 0 } },
        { "TYPE", { REDIS_CMD_TYPE, 1, 1, 0 } },
        { "DEL", { REDIS_CMD_DEL, 1, -1, 0 } },
        { "EXISTS", { REDIS_CMD_EXISTS, 1, -1, 0 } },
        { "INCR", { REDIS_CMD_INCR, 1, 1, 0 } },
        { "DECR", { REDIS_CMD_DECR, 1, 1, 0 } },
        { "INCRBY", { REDIS_CMD_INCRBY, 2, 2, 0 } },
        { "DECRBY", { REDIS_CMD_DECRBY, 2, 2, 0 } },
        { "MGET", { REDIS_CMD_MGET, 1, -1, 0 } },
        { "MSET", { REDIS_CMD_MSET, 2, -1, 2 } },
        { "EXPIRE", { REDIS_CMD_EXPIRE, 2, 2, 0 } },
        { "PEXPIRE", { REDIS_CMD_PEXPIRE, 2, 2, 0 } },
        { "TTL", { REDIS_CMD_TTL, 1, 1, 0 } },
        { "PTTL", { REDIS_CMD_PTTL, 1, 1, 0 } },
        { "PERSIST", { REDIS_CMD_PERSIST, 1, 1, 0 } },
        { "DBSIZE", { REDIS_CMD_DBSIZE, 0, 0, 0 } },
        { "FLUSHDB", { REDIS_CMD_FLUSHDB, 0, 1, 0 } },
        { "FLUSHALL", { REDIS_CMD_FLUSHALL, 0, 1, 0 } },
        { "KEYS", { REDIS_CMD_KEYS, 1, 1, 0 } },
        { "CC.MEMLOG", { REDIS_CMD_CC_MEMLOG, 0, 1, 0 } },
    };
    static_map("redis_commands", commands, CC_STATIC_MAP_ASCII_CI);
}

static const RedisCommandSpec* cmd_spec(char[:] cmd, size_t argc) {
    const RedisCommandSpec* spec = redis_commands_get(cmd);
    if (!spec ||
        argc < (size_t)spec->min_args ||
        (spec->max_args >= 0 && argc > (size_t)spec->max_args) ||
        (spec->args_multiple > 0 && argc % (size_t)spec->args_multiple != 0)) {
        return NULL;
    }
    return spec;
}

enum { k_argv_cap = RespGCmd_args_cap };
_Static_assert(REDIS_ARGV_MAX + 1 == RespGCmd_args_cap,
               "REDIS_ARGV_MAX must equal RespGCmd_args_cap - 1");

typedef struct RedisCmd {
    RedisCommandKind kind;
    char[:] args[k_argv_cap];
    size_t arg_start;
    size_t argc;
} RedisCmd;

static bool slice_eq_ignore_case(char[:] s, const char* cstr) {
    size_t len = strlen(cstr);
    if (s.len != len) return 0;
    for (size_t i = 0; i < len; ++i) {
        char a = ((const char*)s.ptr)[i];
        char b = cstr[i];
        if (a >= 'a' && a <= 'z') a = (char)(a - 'a' + 'A');
        if (b >= 'a' && b <= 'z') b = (char)(b - 'a' + 'A');
        if (a != b) return 0;
    }
    return 1;
}

static bool !>(CCError) decode_request_shape(RedisCmd* out, size_t raw_argc) {
    if (raw_argc < 1) return cc_err(CC_ERROR(CC_ERR_PARSE, "empty command"));
    if (slice_eq_ignore_case(out->args[0], "CONFIG")) {
        if (raw_argc != 3 || !slice_eq_ignore_case(out->args[1], "GET")) {
            return cc_err(CC_ERROR(CC_ERR_INVALID_ARG, "ERR unsupported command"));
        }
        out->kind = REDIS_CMD_CONFIG_GET;
        out->arg_start = 2;
        out->argc = 1;
        return cc_ok(1);
    }
    const RedisCommandSpec* spec = cmd_spec(out->args[0], raw_argc - 1);
    if (!spec) {
        return cc_err(CC_ERROR(CC_ERR_INVALID_ARG, "ERR unsupported command"));
    }
    out->kind = spec->kind;
    out->arg_start = 1;
    out->argc = raw_argc - 1;
    return cc_ok(1);
}

typedef struct ReqIter {
    RespReader* reader;
} ReqIter;

@noblock static ReqIter rr_req_iter(RespReader* reader) {
    return (ReqIter){ .reader = reader };
}

@noblock static bool !>(CCIoError) redis_rr_fill(RespReader* reader, CCSocket* sock) {
    return rr_fill(reader, sock);
}

static bool !>(CCError) rr_cmd_next(ReqIter* it, RedisCmd* out) {
    size_t raw_argc = 0;
    CCError perr = {0};
    RespParseStatus st =
        gen_try_read_args_buffered(it->reader, out->args, k_argv_cap,
                                   &raw_argc, &perr);
    if (st == RESP_PARSE_INCOMPLETE) return cc_ok(0);
    if (st == RESP_PARSE_ERROR) return cc_err(perr);
    decode_request_shape(out, raw_argc) !>(e) { return cc_err(e); };
    return cc_ok(1);
}

#include "redis_db.cch"

static RedisCmdHold hold_for(RedisCommandKind kind) {
    switch (kind) {
        case REDIS_CMD_SET:
            return REDIS_HOLD_INSTALL;
        case REDIS_CMD_PING:
        case REDIS_CMD_ECHO:
        case REDIS_CMD_CONFIG_GET:
            return REDIS_HOLD_NONE;
        case REDIS_CMD_GET:
        case REDIS_CMD_SETNX:
        case REDIS_CMD_SETEX:
        case REDIS_CMD_PSETEX:
        case REDIS_CMD_APPEND:
        case REDIS_CMD_STRLEN:
        case REDIS_CMD_TYPE:
        case REDIS_CMD_INCR:
        case REDIS_CMD_DECR:
        case REDIS_CMD_INCRBY:
        case REDIS_CMD_DECRBY:
        case REDIS_CMD_EXPIRE:
        case REDIS_CMD_PEXPIRE:
        case REDIS_CMD_TTL:
        case REDIS_CMD_PTTL:
        case REDIS_CMD_PERSIST:
            return REDIS_HOLD_KEY;
        case REDIS_CMD_DEL:
        case REDIS_CMD_EXISTS:
        case REDIS_CMD_MGET:
        case REDIS_CMD_MSET:
            return REDIS_HOLD_KEYS;
        case REDIS_CMD_DBSIZE:
        case REDIS_CMD_FLUSHDB:
        case REDIS_CMD_FLUSHALL:
        case REDIS_CMD_KEYS:
        case REDIS_CMD_CC_MEMLOG:
            return REDIS_HOLD_ALL;
    }
    abort();
}

static size_t redis_shard_count(const char** src_out) {
    const char* s = getenv("CC_REDIS_SHARDS");
    unsigned long n;
    char* end = NULL;
    CCShardMask mask;
    if (!s || !s[0]) {
        if (src_out) *src_out = "auto from ncpu";
        mask = cc_shard_mask_auto((size_t)REDIS_DB_MAX_SHARDS);
        return mask.count ? mask.count : 1u;
    }
    n = strtoul(s, &end, 10);
    if (end == s || (end && *end != 0) || n == 0 ||
        n > (unsigned long)REDIS_DB_MAX_SHARDS) {
        if (src_out) *src_out = "auto from ncpu (bad CC_REDIS_SHARDS)";
        mask = cc_shard_mask_auto((size_t)REDIS_DB_MAX_SHARDS);
        return mask.count ? mask.count : 1u;
    }
    if (src_out) *src_out = "CC_REDIS_SHARDS override";
    mask = cc_shard_mask_clamp((size_t)n, (size_t)REDIS_DB_MAX_SHARDS);
    return mask.count ? mask.count : 1u;
}

static size_t shard_guards_acquire_key_set(CCExclusive* excl,
                                           RedisDb* db,
                                           char[:]* keys,
                                           size_t nkeys,
                                           size_t stride,
                                           CCExclusiveGuard* guards,
                                           size_t guards_cap) {
    uint64_t names[REDIS_DB_MAX_SHARDS];
    size_t nnames = 0;
    size_t i;
    if (stride == 0) stride = 1;
    for (i = 0; i < nkeys; i += stride) {
        size_t si = db_shard_index_for_key(db, keys[i]);
        size_t j;
        int seen = 0;
        for (j = 0; j < nnames; j++) {
            if (names[j] == (uint64_t)si) { seen = 1; break; }
        }
        if (!seen && nnames < (size_t)REDIS_DB_MAX_SHARDS) {
            names[nnames++] = (uint64_t)si;
        }
    }
    return excl->acquire_sorted(names, nnames, guards, guards_cap);
}

/* --- Conn encode (sketch) ------------------------------------------------ */

static bool !>(CCError) write_all(CCSocket* sock, char[:] data) {
    size_t off = 0;
    const int write_deadline_ms = 1000;
    CCDeadline deadline = cc_deadline_after_ms(write_deadline_ms);
    while (off < data.len) {
        size_t n = sock->write_deadline(data.ptr + off, data.len - off,
                                        &deadline) !>(e) {
            return cc_err(e);
        };
        if (n == 0) return cc_err(CC_ERR_CLOSED, "short write");
        off += n;
    }
    return cc_ok(true);
}

static bool !>(CCError) redis_conn_flush(RedisConn* c) {
    char[:] data;
    if (!c || !c->arena)
        return cc_err(CC_ERR_INVALID_ARG, "conn flush: null");
    data = c->out.as_slice();
    if (data.len == 0) return cc_ok(true);
    @defer c->arena->reset();
    @defer c->out.release(c->arena);
    write_all(c->sock, data) !>(e) { return cc_err(e); };
    return cc_ok(true);
}

static bool !>(CCError) redis_conn_write(RedisConn* c, char[:] data) {
    if (!c || !c->arena)
        return cc_err(CC_ERR_INVALID_ARG, "conn encode: null");
    if (data.len == 0) return cc_ok(true);
    if (!c->out.append(data, c->arena) || c->out.failed())
        return cc_err(CC_ERR_OUT_OF_MEMORY, "conn encode oom");
    return cc_ok(true);
}

static bool !>(CCError) redis_conn_lit(RedisConn* c, const char* s) {
    return c->write(cc_slice_cstr(s));
}

static bool !>(CCError) redis_conn_simple(RedisConn* c, const char* s) {
    CCString line = @string(`+${s}\r\n`, @scratch);
    return c->write(line.as_slice());
}

static bool !>(CCError) redis_conn_err(RedisConn* c, const char* s) {
    CCString line = @string(`-ERR ${s}\r\n`, @scratch);
    return c->write(line.as_slice());
}

static bool !>(CCError) redis_conn_ok(RedisConn* c) { return c->simple("OK"); }
static bool !>(CCError) redis_conn_pong(RedisConn* c) { return c->simple("PONG"); }
static bool !>(CCError) redis_conn_null(RedisConn* c) { return c->lit("$-1\r\n"); }

static bool !>(CCError) redis_conn_integer(RedisConn* c, int64_t v) {
    CCString line = @string(`:${v}\r\n`, @scratch);
    return c->write(line.as_slice());
}

static bool !>(CCError) redis_conn_bulk(RedisConn* c, char[:] b) {
    @errhandler(CCError e) { return cc_err(e); }
    CCString hdr = @string(`$${b.len}\r\n`, @scratch);
    c->write(hdr.as_slice()) !>;
    c->write(b) !>;
    return c->lit("\r\n");
}

static bool !>(CCError) redis_conn_array_len(RedisConn* c, size_t n) {
    CCString hdr = @string(`*${n}\r\n`, @scratch);
    return c->write(hdr.as_slice());
}

/* RedisReply from redis_db → Conn.out.  ERROR payloads already include
 * the conventional "ERR …" text after '-'. */
static bool !>(CCError) redis_conn_write_reply(RedisConn* c,
                                              const RedisReply* reply) {
    @errhandler(CCError e) { return cc_err(e); }
    if (!c || !reply)
        return cc_err(CC_ERR_INVALID_ARG, "conn write_reply: null");
    switch (reply->kind) {
    case REDIS_REPLY_SIMPLE_STRING:
        c->lit("+") !>;
        c->write(reply->data) !>;
        return c->lit("\r\n");
    case REDIS_REPLY_ERROR:
        c->lit("-") !>;
        c->write(reply->data) !>;
        return c->lit("\r\n");
    case REDIS_REPLY_INTEGER:
        return c->integer(reply->int_value);
    case REDIS_REPLY_NULL_BULK:
        return c->null();
    case REDIS_REPLY_BULK_STRING:
        return c->bulk(reply->data);
    case REDIS_REPLY_WIRE:
        return c->write(reply->data);
    default:
        return cc_err(CC_ERR_INTERNAL, "conn write_reply: unknown kind");
    }
}

static RedisReply reply_or_err(RedisReply !>(CCError) built) {
    return built.is_err() ? err_reply(built.error()) : built.value();
}

/* Encode a DB RedisReply into Conn (errors → -ERR wire). */
static bool !>(CCError) enc_db_reply(RedisConnEnc enc,
                                     RedisReply !>(CCError) built) {
    RedisReply r = reply_or_err(built);
    return enc->write_reply(&r);
}

/* Hold path: DB work + encode into Conn (sketch shape). SET is HOLD_INSTALL. */
@noblock static bool !>(CCError) execute(RedisDb* db, RedisCmd* cmd,
                                         RedisConnEnc enc) {
    @errhandler(CCError e) { return cc_err(e); }
    char[:]* argv = cmd->args + cmd->arg_start;
    size_t argc = cmd->argc;
    CCArena* reply_arena = &enc->reply_arena;
    DbCmdClock clock = {0};
    switch (cmd->kind) {
        case REDIS_CMD_PING:
            if (argc == 1) return enc->bulk(argv[0]);
            return enc->pong();
        case REDIS_CMD_ECHO:
            return enc->bulk(argv[0]);
        case REDIS_CMD_CONFIG_GET:
            return enc_db_reply(enc, config_get_reply(argv[0], reply_arena));
        case REDIS_CMD_GET:
            return enc_db_reply(enc, db_get(db, argv[0], reply_arena, &clock));
        case REDIS_CMD_SETNX:
            return enc_db_reply(enc, db_setnx(db, argv[0], argv[1], &clock));
        case REDIS_CMD_SETEX: {
            char[:] secs_arg = argv[1];
            int64_t seconds = secs_arg.to_i64() !>;
            return enc_db_reply(
                enc, db_set_with_ttl(db, argv[0], argv[2],
                                     expire_seconds_to_rel_ms(seconds),
                                     &clock));
        }
        case REDIS_CMD_PSETEX: {
            char[:] ms_arg = argv[1];
            int64_t ms = ms_arg.to_i64() !>;
            return enc_db_reply(
                enc, db_set_with_ttl(db, argv[0], argv[2], ms, &clock));
        }
        case REDIS_CMD_APPEND:
            return enc_db_reply(
                enc, db_append(db, argv[0], argv[1], reply_arena, &clock));
        case REDIS_CMD_STRLEN: {
            RedisReply r = db_strlen(db, argv[0], &clock);
            return enc->write_reply(&r);
        }
        case REDIS_CMD_TYPE: {
            RedisReply r = db_type(db, argv[0], &clock);
            return enc->write_reply(&r);
        }
        case REDIS_CMD_DEL: {
            RedisReply r = db_del(db, argv, argc, &clock);
            return enc->write_reply(&r);
        }
        case REDIS_CMD_EXISTS: {
            RedisReply r = db_exists(db, argv, argc, &clock);
            return enc->write_reply(&r);
        }
        case REDIS_CMD_INCR:
            return enc_db_reply(enc, db_incrby(db, argv[0], 1, &clock));
        case REDIS_CMD_DECR:
            return enc_db_reply(enc, db_incrby(db, argv[0], -1, &clock));
        case REDIS_CMD_INCRBY: {
            char[:] delta_arg = argv[1];
            int64_t delta = delta_arg.to_i64() !>;
            return enc_db_reply(enc, db_incrby(db, argv[0], delta, &clock));
        }
        case REDIS_CMD_DECRBY: {
            char[:] delta_arg = argv[1];
            int64_t delta = delta_arg.to_i64() !>;
            int64_t neg = cc_sub_i64_checked(0, delta) !> {
                return cc_err(CC_ERROR(CC_ERR_INVALID_ARG,
                                       "ERR decrement would overflow"));
            };
            return enc_db_reply(enc, db_incrby(db, argv[0], neg, &clock));
        }
        case REDIS_CMD_MGET:
            return enc_db_reply(enc, db_mget(db, argv, argc, reply_arena, &clock));
        case REDIS_CMD_MSET:
            return enc_db_reply(enc, db_mset(db, argv, argc));
        case REDIS_CMD_EXPIRE: {
            char[:] secs_arg = argv[1];
            int64_t seconds = secs_arg.to_i64() !>;
            return enc_db_reply(
                enc, db_expire_rel_ms(db, argv[0],
                                      expire_seconds_to_rel_ms(seconds),
                                      &clock));
        }
        case REDIS_CMD_PEXPIRE: {
            char[:] ms_arg = argv[1];
            int64_t ms = ms_arg.to_i64() !>;
            return enc_db_reply(enc, db_expire_rel_ms(db, argv[0], ms, &clock));
        }
        case REDIS_CMD_TTL: {
            RedisReply r = db_ttl(db, argv[0], 0, &clock);
            return enc->write_reply(&r);
        }
        case REDIS_CMD_PTTL: {
            RedisReply r = db_ttl(db, argv[0], 1, &clock);
            return enc->write_reply(&r);
        }
        case REDIS_CMD_PERSIST:
            return enc_db_reply(enc, db_persist(db, argv[0], &clock));
        case REDIS_CMD_DBSIZE: {
            RedisReply r = db_dbsize(db, &clock);
            return enc->write_reply(&r);
        }
        case REDIS_CMD_FLUSHDB:
        case REDIS_CMD_FLUSHALL: {
            RedisReply r = db_flush(db);
            return enc->write_reply(&r);
        }
        case REDIS_CMD_KEYS:
            return enc_db_reply(enc, db_keys(db, argv[0], reply_arena, &clock));
        case REDIS_CMD_CC_MEMLOG: {
            const char* phase = "cc-memlog";
            char phase_buf[64];
            if (argc >= 1 && argv[0].ptr && argv[0].len > 0) {
                size_t n = argv[0].len < sizeof(phase_buf) - 1 ? argv[0].len
                                                             : sizeof(phase_buf) - 1;
                memcpy(phase_buf, argv[0].ptr, n);
                phase_buf[n] = '\0';
                phase = phase_buf;
            }
            db_dump_mem_stats(db, phase);
            redis_mem_report_impl(db, phase);
            return enc->ok();
        }
        case REDIS_CMD_SET:
        default:
            return enc->err("unsupported command");
    }
}

static bool redis_conn_write_err_now(RedisConn* conn, CCError e) {
    RedisConnEnc enc = conn;
    const char* msg = e.message ? e.message : "internal error";
    /* Strip leading "ERR " if present — redis_conn_err adds -ERR. */
    if (msg[0] == 'E' && msg[1] == 'R' && msg[2] == 'R' && msg[3] == ' ')
        msg += 4;
    enc->err(msg) !>(e2) { (void)e2; return 0; };
    conn->flush() !>(e2) { (void)e2; return 0; };
    return 1;
}

static bool db_setup(RedisDb* db, size_t shard_count, const char* shard_src) {
    @errhandler(CCError e) { (void)e; return 0; }
    if (!db_init(db, 1024, shard_count)) {
        eprintln("redis_idiomatic: db_init failed (out of memory?)") !>;
        return 0;
    }
    const char* src = shard_src ? shard_src : "auto from ncpu";
    size_t nshards = db->shard_count;
    eprintln(@string(`redis_idiomatic: shards=${nshards} (${src})`, @scratch)) !>;
    int preload_keys = db_preload_key_count();
    if (preload_keys > 0) {
        if (!db_preload_keys_ok(db, preload_keys)) {
            eprintln("redis_idiomatic: preload failed") !>;
            return 0;
        }
        size_t preload_key_count = (size_t)preload_keys;
        eprintln(@string(`redis_idiomatic: preloaded ${preload_key_count} keys`,
                         @scratch)) !>;
        db_dump_mem_stats(db, "post-preload");
        redis_mem_emit_gap(db, "post-preload");
    }
    redis_mem_report(db, "owner-ready");
    return 1;
}

/* Single acquire site.  Hold covers DB work + Conn encode; flush after. */
@noblock static bool !>(CCError) run_pipeline_window(RedisConn* conn,
                                                     RedisDb* db,
                                                     CCExclusive* excl,
                                                     ReqIter* req_iter,
                                                     size_t* n_out) {
    @errhandler(CCError e) { return cc_err(e); }
    @defer conn->reply_arena.reset();

    size_t n = 0;
    *n_out = 0;
    while (n < (size_t)k_pipeline_window_cap) {
        RedisCmd cmd;
        bool has = rr_cmd_next(req_iter, &cmd) !>;
        if (!has) break;
        n++;
        *n_out = n;

        char[:]* argv = cmd.args + cmd.arg_start;
        size_t argc = (size_t)cmd.argc;
        CCExclusiveGuard guards[REDIS_DB_MAX_SHARDS];
        size_t n_guards = 0;
        RedisConnEnc enc = conn;

        switch (hold_for(cmd.kind)) {
            case REDIS_HOLD_NONE:
                execute(db, &cmd, enc) !>(e) {
                    (void)e;
                    return cc_ok(0);
                };
                break;

            case REDIS_HOLD_INSTALL: {
                CCString pre_val = db_prep_value(argv[1]) !>;
                guards[0] = excl->acquire(
                    (uint64_t)db_shard_index_for_key(db, argv[0]));
                n_guards = 1;
                @defer guards->release_n(n_guards);
                RedisReply r = reply_or_err(db_set_install(db, argv[0], pre_val, 0));
                enc->write_reply(&r) !>(e) {
                    (void)e;
                    return cc_ok(0);
                };
                break;
            }

            case REDIS_HOLD_KEY: {
                guards[0] = excl->acquire(
                    (uint64_t)db_shard_index_for_key(db, argv[0]));
                n_guards = 1;
                @defer guards->release_n(n_guards);
                execute(db, &cmd, enc) !>(e) {
                    (void)e;
                    return cc_ok(0);
                };
                break;
            }

            case REDIS_HOLD_KEYS: {
                size_t stride = (cmd.kind == REDIS_CMD_MSET) ? 2u : 1u;
                n_guards = shard_guards_acquire_key_set(
                    excl, db, argv, argc, stride, guards,
                    (size_t)REDIS_DB_MAX_SHARDS);
                @defer guards->release_n(n_guards);
                execute(db, &cmd, enc) !>(e) {
                    (void)e;
                    return cc_ok(0);
                };
                break;
            }

            case REDIS_HOLD_ALL: {
                n_guards = excl->acquire_range(
                    0, (uint64_t)db->shard_count, guards,
                    (size_t)REDIS_DB_MAX_SHARDS);
                @defer guards->release_n(n_guards);
                execute(db, &cmd, enc) !>(e) {
                    (void)e;
                    return cc_ok(0);
                };
                break;
            }
        }
    }

    conn->flush() !>(e) {
        (void)e;
        return cc_ok(0);
    };
    return cc_ok(1);
}

static void handle_client(CCSocket client, RedisDb* db, CCExclusive* excl) {
    char out_slab[k_out_buf];
    CCArena out_arena =
        cc_arena_create_buffer(out_slab, sizeof(out_slab), CC_ARENA_GROWABLE)
        @destroy;
    RedisConn conn = {
        .sock = &client,
        .arena = &out_arena,
        .out = cc_string_new(),
    };
    @defer client.close();
    @defer conn.flush() !>(e) { (void)e; };

    conn.reply_arena = cc_arena_heap(16 * 1024);
    if (!conn.reply_arena.base) return;
    conn.reply_arena.block_max = 0;
    @defer conn.reply_arena.destroy();

    char read_buf[64 * 1024];
    RespReader reader;
    @nonblocking { reader = rr_init(read_buf, sizeof(read_buf)); }
    ReqIter req_iter = rr_req_iter(&reader);

    while (1) {
        @errhandler(CCError e) {
            (void)redis_conn_write_err_now(&conn, e);
            client.close();
            return;
        }

        size_t n_cmds = 0;
        bool window_ok =
            run_pipeline_window(&conn, db, excl, &req_iter, &n_cmds) !>;
        if (!window_ok) return;

        if (n_cmds == (size_t)k_pipeline_window_cap && reader.start < reader.end)
            continue;

        bool more = redis_rr_fill(&reader, &client) !>(e) {
            (void)redis_conn_write_err_now(&conn, e.base);
            return;
        };
        if (!more) return;
    }
}

int main(int argc, char** argv) {
    @errhandler(CCError e) { cc_error_log(e); return 1; }

    int port = 6380;
    if (argc > 1) {
        char* end = NULL;
        long parsed = strtol(argv[1], &end, 10);
        if (end == argv[1] || (end && *end != 0) || parsed <= 0 || parsed > 65535) {
            eprintln(@string(`invalid port: ${argv[1]}`, @scratch)) !>;
            return 1;
        }
        port = (int)parsed;
    }

    char addr[64];
    snprintf(addr, sizeof(addr), "127.0.0.1:%d", port);

    CCListener ln = cc_tcp_listen(cc_slice_cstr(addr)) !>(e) {
        eprintln(@string(`listen error: ${e}`, @scratch)) !>;
        return 1;
    };
    @defer ln.close();

    RedisDb db = {0};
    const char* shard_src = NULL;
    size_t shard_count = redis_shard_count(&shard_src);
    if (!db_setup(&db, shard_count, shard_src)) return 1;
    @defer db_free_all(&db);

    CCArena excl_arena = cc_arena_heap(kilobytes(64));
    @defer excl_arena.destroy();
    CCExclusive* excl = cc_exclusive_create(&excl_arena, shard_count * 2u);
    if (!excl) {
        eprintln("redis_idiomatic: exclusive failed") !>;
        return 1;
    }
    @defer excl->destroy();

    size_t nshards = db.shard_count;
    println(@string(`redis_idiomatic listening on ${addr} shards=${nshards}`,
                    @scratch)) !>;

    CCNursery* server = cc_nursery_create(NULL) !> @destroy;
    server->cancel_on_signals(SIGINT, SIGTERM) !>;

    server->spawn(() => [@safe &db, @safe &ln, excl, server] {
        ln.serve(server, (CCSocket* accepted) => [@safe &db, excl, server] {
            CCSocket client = *accepted;
            (void)client.set_nodelay(1);
            server->spawn(() => [@safe &db, excl, client] {
                handle_client(client, &db, excl);
            });
        });
    });

    return 0;
}

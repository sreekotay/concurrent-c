/*
 * redis_idiomatic.ccs — default Concurrent-C Redis server.
 *
 * Shared DB behind one table-wide named exclusive section (CCExclusive).
 * Each connection fiber parses, then executes against RedisDb while
 * holding that mutex.  No owner fiber, no request/reply channels.
 *
 * Request path: argv slices borrow the connection read buffer (no clone,
 * no handoff).  Each command's relationship to the hold is a field in the
 * command table (RedisCmdHold), and run_pipeline_window is the only place
 * that acquires: hold covers DB mutate/snapshot, RESP encode and socket
 * writes run after release.  SET preps its value outside the hold; install
 * borrow-looks up and clones the key into key_arena only on miss.
 *
 * RedisConn (including out_buf) lives on the connection fiber stack; a
 * connection costs one heap allocation (its reply arena).
 *
 * Build: `make redis_idiomatic`.  Bench: `./bench_robust.sh`.
 * Channel/owner-fiber variant (historical): `redis_owner.ccs`.
 */

#include <ccc/std/prelude.cch>
#include <ccc/std/net.cch>
#include <ccc/std/map.cch>
#include <ccc/std/static_map.cch>
#include <ccc/std/string.cch>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <signal.h>
#include <time.h>
#include <unistd.h>
#include <sys/socket.h>
#include <netinet/in.h>
#include <netinet/tcp.h>
#include <sys/resource.h>
#if defined(__APPLE__)
#include <mach/mach.h>
#include <mach/task_info.h>
#endif
#include "redis_cc/redis_cc.cch"

/* The one concurrency primitive this variant uses: a named exclusive
 * section.  main creates a single CCExclusive and resolves one mutex;
 * connection fibers acquire it around DB mutate / snapshot only. */
#include <ccc/cc_exclusive.cch>

/* The whole table is one name — this variant never shards. */
enum { k_table_lock_name = 1 };

/* Window cap bounds how many pipelined commands run per parsed batch.
 * out_buf holds serialized replies between flushes: a window of small
 * replies fits, and anything larger flushes mid-window. */
enum {
    k_pipeline_window_cap = 16,
    redis_conn_out_buf_bytes = 1024,
};

/* Per-connection state, on the connection fiber's stack.  reply_arena
 * holds oversized replies (arrays, big bulks) for the current window and
 * is reset when the window ends; out_buf batches serialized replies
 * between flushes. */
typedef struct RedisConn {
    CCArena reply_arena;
    CCSocket* sock;
    size_t out_len;
    char out_buf[redis_conn_out_buf_bytes];
} RedisConn;

static CCSlice !>(CCError) reply_arena_alloc_slice(CCArena* reply_arena, size_t n);

static void redis_diag_fprintln(CCString* line, CCArena* scratch) {
    const char* p = cc_string_cstr(line, scratch);
    if (p) fprintf(stderr, "%s\n", p);
}

static bool slice_eq_ignore_case(char[:] s, const char* cstr) {
    size_t len = strlen(cstr);
    if (s.len != len) return 0;
    for (size_t i = 0; i < len; ++i) {
        char a = ((const char*)s.ptr)[i];
        char b = cstr[i];
        if (a >= 'a' && a <= 'z') a = (char)(a - 'a' + 'A');
        if (b >= 'a' && b <= 'z') b = (char)(b - 'a' + 'A');
        if (a != b) return 0;
    }
    return 1;
}

/* Args: char[:].to_i64().  Num cells render at read boundaries via @string. */

#include "redis_resp.cch"

/* RESP reader (parity oracle: tests/redis_resp_gen_parity_smoke.ccs).
 * Parse borrows the read buffer; argv slices stay borrowed for the whole
 * window (no refill happens while a window is executing).  cap 8 =
 * REDIS_ARGV_MAX+1 wire tokens. */
@grammar(schema) RespGArg {~~~~
    rules [
        digit:  charset [#'0' - #'9']
        number: keep [opt #'-' some digit]
    ]
    #'$' len: int number "\r\n"
    data: bytes len
    "\r\n"
~~~~}

@grammar(schema) RespGCmd {~~~~
    rules [
        digit:  charset [#'0' - #'9']
        number: keep [opt #'-' some digit]
        lchar:  complement charset [#'\r' #'\n']
        line:   keep [any lchar]
    ]
    one of [
        framed [ #'*' argc: int number "\r\n" args: items RespGArg argc cap 8 ]
        plain  [ text: line "\r\n" ]
    ]
~~~~}

/* RESP writer (same shape as the reader).  cc_write allocates nothing;
 * hot replies go to out_buf; arrays encode into reply_arena.
 * Nil is not a RespGReply arm ('$' collides with bulk) — use RespGBulkHdr
 * with len = -1. */
@grammar(schema) RespGReply {~~~~
    rules [
        digit:  charset [#'0' - #'9']
        number: keep [opt #'-' some digit]
        lchar:  complement charset [#'\r' #'\n']
        line:   keep [any lchar]
    ]
    one of [
        simple  [ #'+' s: line "\r\n" ]
        error   [ #'-' msg: line "\r\n" ]
        integer [ #':' v: int number "\r\n" ]
        bulk    [ #'$' len: int number "\r\n" data: bytes len "\r\n" ]
        array   [ #'*' n: int number "\r\n" items: items RespGReply n ]
    ]
~~~~}

/* Bulk header alone: "$<len>\r\n".  Two boundary jobs the union cannot do:
 * nil (len = -1, see above) and streaming a bulk payload larger than
 * conn->out_buf (schema-written header, then the payload slice). */
@grammar(schema) RespGBulkHdr {~~~~
    rules [
        digit:  charset [#'0' - #'9']
        number: keep [opt #'-' some digit]
    ]
    #'$' len: int number "\r\n"
~~~~}

/* Multi-bulk header alone: "*<n>\r\n".  MGET interleaves bulk and nil
 * elements, and nil can't be a RespGReply array item — so its array is
 * written element-by-element under this schema-written header. */
@grammar(schema) RespGArrayHdr {~~~~
    rules [
        digit:  charset [#'0' - #'9']
        number: keep [opt #'-' some digit]
    ]
    #'*' n: int number "\r\n"
~~~~}

static RespParseStatus gen_try_read_args_buffered(RespReader* r,
                                                  CCSlice* args,
                                                  size_t cap,
                                                  size_t* out_argc,
                                                  CCError* err) {
    size_t pos = 0;
    RespGCmd c;
    bool !>(CCError) tr = RespGCmd_try_read((const char*)(r->data + r->start),
                                            r->end - r->start, &pos, NULL, &c);
    if (tr.is_err()) {
        if (tr.error().kind == CC_ERR_WOULD_BLOCK) return RESP_PARSE_INCOMPLETE;
        *err = tr.error();
        return RESP_PARSE_ERROR;
    }
    if (!tr.value()) return RESP_PARSE_INCOMPLETE;
    if (c.kind == RespGCmd_plain) {
        /* whitespace tokenization stays with the hand helper: it is server
         * policy (arg splitting), not wire framing */
        size_t !>(CCError) pargs = parse_inline_args(c.u.plain.text, args, cap);
        if (pargs.is_err()) { *err = pargs.error(); return RESP_PARSE_ERROR; }
        *out_argc = pargs.value();
        r->start += pos;
        return RESP_PARSE_OK;
    }
    if (c.u.framed.args_n < 1 || c.u.framed.args_n > cap) {
        *err = CC_ERROR(CC_ERR_PARSE, "unsupported argument count");
        return RESP_PARSE_ERROR;
    }
    for (size_t i = 0; i < c.u.framed.args_n; i++) args[i] = c.u.framed.args[i].data;
    *out_argc = c.u.framed.args_n;
    r->start += pos;
    return RESP_PARSE_OK;
}

/* How a command relates to the table hold.  run_pipeline_window switches on
 * this and is the only acquire site, so locking policy lives in the command
 * table below rather than in the window loop. */
typedef enum RedisCmdHold {
    /* acquire -> execute -> own bulk -> release */
    REDIS_HOLD_TABLE = 0,
    /* no hold: mutates nothing, and a torn read of DB stats is acceptable */
    REDIS_HOLD_NONE,
    /* prep the value outside -> acquire -> install -> release */
    REDIS_HOLD_INSTALL,
} RedisCmdHold;

/* min/max_args count arguments after the command word; max_args < 0 is
 * variadic, and args_multiple > 0 additionally requires a whole number of
 * groups (MSET pairs).  Arity is checked once, here, so command handlers
 * may index argv up to min_args without rechecking. */
typedef struct RedisCommandSpec {
    RedisCommandKind kind;
    int min_args;
    int max_args;
    int args_multiple;
    RedisCmdHold hold;
} RedisCommandSpec;

@comptime {
    /* name -> { kind, min_args, max_args, args_multiple, hold } */
    CCStaticMapEntry commands[] = {
        { "PING", "(RedisCommandSpec){ REDIS_CMD_PING, 0, 1, 0, REDIS_HOLD_TABLE }" },
        { "ECHO", "(RedisCommandSpec){ REDIS_CMD_ECHO, 1, 1, 0, REDIS_HOLD_TABLE }" },
        { "GET", "(RedisCommandSpec){ REDIS_CMD_GET, 1, 1, 0, REDIS_HOLD_TABLE }" },
        { "SET", "(RedisCommandSpec){ REDIS_CMD_SET, 2, 2, 0, REDIS_HOLD_INSTALL }" },
        { "SETNX", "(RedisCommandSpec){ REDIS_CMD_SETNX, 2, 2, 0, REDIS_HOLD_TABLE }" },
        { "SETEX", "(RedisCommandSpec){ REDIS_CMD_SETEX, 3, 3, 0, REDIS_HOLD_TABLE }" },
        { "PSETEX", "(RedisCommandSpec){ REDIS_CMD_PSETEX, 3, 3, 0, REDIS_HOLD_TABLE }" },
        { "APPEND", "(RedisCommandSpec){ REDIS_CMD_APPEND, 2, 2, 0, REDIS_HOLD_TABLE }" },
        { "STRLEN", "(RedisCommandSpec){ REDIS_CMD_STRLEN, 1, 1, 0, REDIS_HOLD_TABLE }" },
        { "TYPE", "(RedisCommandSpec){ REDIS_CMD_TYPE, 1, 1, 0, REDIS_HOLD_TABLE }" },
        { "DEL", "(RedisCommandSpec){ REDIS_CMD_DEL, 1, -1, 0, REDIS_HOLD_TABLE }" },
        { "EXISTS", "(RedisCommandSpec){ REDIS_CMD_EXISTS, 1, -1, 0, REDIS_HOLD_TABLE }" },
        { "INCR", "(RedisCommandSpec){ REDIS_CMD_INCR, 1, 1, 0, REDIS_HOLD_TABLE }" },
        { "DECR", "(RedisCommandSpec){ REDIS_CMD_DECR, 1, 1, 0, REDIS_HOLD_TABLE }" },
        { "INCRBY", "(RedisCommandSpec){ REDIS_CMD_INCRBY, 2, 2, 0, REDIS_HOLD_TABLE }" },
        { "DECRBY", "(RedisCommandSpec){ REDIS_CMD_DECRBY, 2, 2, 0, REDIS_HOLD_TABLE }" },
        { "MGET", "(RedisCommandSpec){ REDIS_CMD_MGET, 1, -1, 0, REDIS_HOLD_TABLE }" },
        { "MSET", "(RedisCommandSpec){ REDIS_CMD_MSET, 2, -1, 2, REDIS_HOLD_TABLE }" },
        { "EXPIRE", "(RedisCommandSpec){ REDIS_CMD_EXPIRE, 2, 2, 0, REDIS_HOLD_TABLE }" },
        { "PEXPIRE", "(RedisCommandSpec){ REDIS_CMD_PEXPIRE, 2, 2, 0, REDIS_HOLD_TABLE }" },
        { "TTL", "(RedisCommandSpec){ REDIS_CMD_TTL, 1, 1, 0, REDIS_HOLD_TABLE }" },
        { "PTTL", "(RedisCommandSpec){ REDIS_CMD_PTTL, 1, 1, 0, REDIS_HOLD_TABLE }" },
        { "PERSIST", "(RedisCommandSpec){ REDIS_CMD_PERSIST, 1, 1, 0, REDIS_HOLD_TABLE }" },
        { "DBSIZE", "(RedisCommandSpec){ REDIS_CMD_DBSIZE, 0, 0, 0, REDIS_HOLD_TABLE }" },
        { "FLUSHDB", "(RedisCommandSpec){ REDIS_CMD_FLUSHDB, 0, 1, 0, REDIS_HOLD_TABLE }" },
        { "FLUSHALL", "(RedisCommandSpec){ REDIS_CMD_FLUSHALL, 0, 1, 0, REDIS_HOLD_TABLE }" },
        { "KEYS", "(RedisCommandSpec){ REDIS_CMD_KEYS, 1, 1, 0, REDIS_HOLD_TABLE }" },
        { "CC.MEMLOG", "(RedisCommandSpec){ REDIS_CMD_CC_MEMLOG, 0, 1, 0, REDIS_HOLD_NONE }" },
    };
    static_map("redis_commands", "RedisCommandSpec", commands,
               sizeof(commands) / sizeof(commands[0]),
               CC_STATIC_MAP_ASCII_CI);
}

/* `argc` counts arguments after the command word.  FLUSHDB/FLUSHALL accept an
 * optional ASYNC/SYNC token, though this server always flushes
 * synchronously.  Unknown names and invalid arity share one miss (NULL). */
static const RedisCommandSpec* cmd_spec(char[:] cmd, size_t argc) {
    const RedisCommandSpec* spec = redis_commands_get(cmd);
    if (!spec ||
        argc < (size_t)spec->min_args ||
        (spec->max_args >= 0 && argc > (size_t)spec->max_args) ||
        (spec->args_multiple > 0 && argc % (size_t)spec->args_multiple != 0)) {
        return NULL;
    }
    return spec;
}

/* Initialize only the fields read for each reply kind; avoid whole-struct
 * zeroing on the GET/SET/INCR hot path. */
static RedisReply reply_simple(const char* s) {
    RedisReply r;
    r.kind = REDIS_REPLY_SIMPLE_STRING;
    r.data = cc_slice_from_cstr(s);
    return r;
}

static RedisReply reply_error(const char* s) {
    RedisReply r;
    r.kind = REDIS_REPLY_ERROR;
    r.data = cc_slice_from_cstr(s);
    return r;
}

static RedisReply err_reply(CCError err) {
    return reply_error(err.message ? err.message : "ERR internal error");
}

static RedisReply io_err_reply(CCIoError err) {
    return reply_error(cc_io_error_str(err));
}

static RedisReply reply_bulk(CCSlice s) {
    RedisReply r;
    r.kind = REDIS_REPLY_BULK_STRING;
    r.data = s;
    return r;
}

static RedisReply reply_null(void) {
    RedisReply r;
    r.kind = REDIS_REPLY_NULL_BULK;
    r.data = cc_slice_empty();
    return r;
}

static RedisReply reply_integer(int64_t v) {
    RedisReply r;
    r.kind = REDIS_REPLY_INTEGER;
    r.int_value = v;
    r.data = cc_slice_empty();
    return r;
}

/* Opaque RESP already in reply_arena (arrays+nil; ensure_owned is a no-op). */
static RedisReply reply_wire(CCSlice s) {
    RedisReply r;
    r.kind = REDIS_REPLY_WIRE;
    r.data = s;
    return r;
}

/* RedisReply → socket bytes.  RespGReply is encode-only; NULL_BULK uses
 * RespGBulkHdr (nil is not a RespGReply arm). */
static inline RespGReply wire_bulk(CCSlice data) {
    RespGReply w;
    w.kind = RespGReply_bulk;
    w.u.bulk.len = (long long)data.len;
    w.u.bulk.data = data;
    return w;
}

/* Structured arms → RespGReply.  WIRE and NULL_BULK are not projected here. */
static bool redis_reply_to_wire(const RedisReply* reply, RespGReply* wire) {
    switch (reply->kind) {
        case REDIS_REPLY_SIMPLE_STRING:
            wire->kind = RespGReply_simple;
            wire->u.simple.s = reply->data;
            return 1;
        case REDIS_REPLY_ERROR:
            wire->kind = RespGReply_error;
            wire->u.error.msg = reply->data;
            return 1;
        case REDIS_REPLY_INTEGER:
            wire->kind = RespGReply_integer;
            wire->u.integer.v = reply->int_value;
            return 1;
        case REDIS_REPLY_BULK_STRING:
            *wire = wire_bulk(reply->data);
            return 1;
        default:
            return 0;
    }
}

/* Serialize a RedisReply into dst.  WIRE copies; structured uses
 * RespGReply/cc_write; NULL_BULK uses RespGBulkHdr. */
static size_t RedisReply_write(const RedisReply* reply, char* dst, size_t cap) {
    if (!reply || !dst) return 0;
    if (reply->kind == REDIS_REPLY_WIRE) {
        if (reply->data.len > cap) return 0;
        if (reply->data.len > 0) memcpy(dst, reply->data.ptr, reply->data.len);
        return reply->data.len;
    }
    if (reply->kind == REDIS_REPLY_NULL_BULK) {
        RespGBulkHdr nil = { .len = -1 };
        return RespGBulkHdr_write(&nil, dst, cap);
    }
    RespGReply wire;
    if (!redis_reply_to_wire(reply, &wire)) return 0;
    return RespGReply_write(&wire, dst, cap);
}

/* Encode into reply_arena.  `cap_hint` is a guess; cc_write 0-on-miss +
 * checkpoint/restore + double until fit (or overflow). */
enum { k_reply_encode_cap_max = 1 << 30 };

static CCSlice !>(CCError) reply_wire_encode_into_arena(const RespGReply* wire,
                                                        CCArena* reply_arena,
                                                        size_t cap_hint) {
    @errhandler(CCError e) { return cc_err(e); }
    size_t cap = cap_hint < 16 ? 16 : cap_hint;
    for (;;) {
        CCArenaCheckpoint cp = cc_arena_checkpoint(reply_arena);
        CCSlice out = reply_arena_alloc_slice(reply_arena, cap) !>;
        size_t w = RespGReply_write(wire, (char*)out.ptr, out.len);
        if (w != 0) {
            out.len = w;
            return cc_ok(out);
        }
        cc_arena_restore(cp);
        if (cap >= (size_t)k_reply_encode_cap_max) {
            return cc_err(CC_ERROR(CC_ERR_OUT_OF_MEMORY, "reply encode overflow"));
        }
        cap *= 2;
    }
}

/* CONFIG GET: two-element array via schema, encoded into reply_arena. */
static RedisReply !>(CCError) config_get_reply(char[:] key, CCArena* reply_arena) {
    @errhandler(CCError e) { return cc_err(e); }
    RespGReply items[2];
    size_t n = 0;
    if (slice_eq_ignore_case(key, "save")) {
        items[0] = wire_bulk(cc_slice_from_cstr("save"));
        items[1] = wire_bulk(cc_slice_from_cstr(""));
        n = 2;
    } else if (slice_eq_ignore_case(key, "appendonly")) {
        items[0] = wire_bulk(cc_slice_from_cstr("appendonly"));
        items[1] = wire_bulk(cc_slice_from_cstr("no"));
        n = 2;
    }
    RespGReply arr;
    arr.kind = RespGReply_array;
    arr.u.array.n = (long long)n;
    arr.u.array.items = items;
    arr.u.array.items_n = n;
    CCSlice out = reply_wire_encode_into_arena(&arr, reply_arena, 64) !>;
    return cc_ok(reply_wire(out));
}

/* argv slots per command: the command word plus REDIS_ARGV_MAX arguments.
 * Must match the `cap` on RespGCmd's args rule. */
enum { k_argv_cap = REDIS_ARGV_MAX + 1 };

/* A decoded command.  args are slices borrowing the connection read
 * buffer — valid until the next rr_fill, i.e. for the current window.
 * arg_start skips the command word (and any subcommand token), so
 * `args + arg_start` is the argv a handler sees and `argc` its length. */
typedef struct RedisCmd {
    RedisCommandKind kind;
    RedisCmdHold hold;
    CCSlice args[k_argv_cap];
    size_t arg_start;
    size_t argc;
} RedisCmd;

/* Fill kind / hold / arg_start / argc from the raw tokens already parsed
 * into out->args.  CONFIG GET is the one two-word command: its subcommand
 * token is consumed here so handlers only ever see a flat argv. */
static bool !>(CCError) decode_request_shape(RedisCmd* out, size_t raw_argc) {
    if (raw_argc < 1) return cc_err(CC_ERROR(CC_ERR_PARSE, "empty command"));

    if (slice_eq_ignore_case(out->args[0], "CONFIG")) {
        if (raw_argc != 3 || !slice_eq_ignore_case(out->args[1], "GET")) {
            return cc_err(CC_ERROR(CC_ERR_INVALID_ARG, "ERR unsupported command"));
        }
        out->kind = REDIS_CMD_CONFIG_GET;
        out->hold = REDIS_HOLD_NONE;   /* answers from static text only */
        out->arg_start = 2;
        out->argc = 1;
        return cc_ok(1);
    }

    const RedisCommandSpec* spec = cmd_spec(out->args[0], raw_argc - 1);
    if (!spec) {
        return cc_err(CC_ERROR(CC_ERR_INVALID_ARG, "ERR unsupported command"));
    }

    out->kind = spec->kind;
    out->hold = spec->hold;
    out->arg_start = 1;
    out->argc = raw_argc - 1;
    return cc_ok(1);
}

/* Non-blocking iterator over pipelined commands in the buffered reader.
 *   ok(true), *out = cmd  → complete command decoded.
 *   ok(false)             → need rr_fill (mid-message).
 *   err(e)                → parse failure.
 * Borrows `reader`. */
typedef struct ReqIter {
    RespReader* reader;
} ReqIter;

@noblock static ReqIter rr_req_iter(RespReader* reader) {
    ReqIter it = { .reader = reader };
    return it;
}

@noblock static bool !>(CCIoError) redis_rr_fill(RespReader* reader, CCSocket* sock) {
    return rr_fill(reader, sock);
}

static bool !>(CCError) rr_cmd_next(ReqIter* it, RedisCmd* out) {
    size_t raw_argc = 0;
    CCError perr = {0};
    RespParseStatus argc_status =
        gen_try_read_args_buffered(it->reader, out->args, k_argv_cap,
                                   &raw_argc, &perr);
    if (argc_status == RESP_PARSE_INCOMPLETE) {
        return cc_ok(0);
    }
    if (argc_status == RESP_PARSE_ERROR) return cc_err(perr);

    decode_request_shape(out, raw_argc) !>(e) { return cc_err(e); };
    return cc_ok(1);
}

#include "redis_db.cch"

/* One command against the DB, under whatever hold its RedisCmdHold policy
 * asked for — REDIS_HOLD_TABLE commands run with the table held, and the
 * returned reply may still borrow DB memory, so the caller materializes
 * bulk into reply_arena before releasing.  Arity was checked by cmd_spec,
 * so arms index argv up to their min_args freely. */
@noblock static RedisReply !>(CCError) execute_cmd(RedisDb* db,
                                                   const RedisCmd* cmd,
                                                   CCArena* reply_arena) {
    @errhandler(CCError e) { return cc_err(e); }
    const CCSlice* argv = cmd->args + cmd->arg_start;
    size_t argc = cmd->argc;
    int64_t now = -1;
    switch (cmd->kind) {
        case REDIS_CMD_PING:
            if (argc == 1) return cc_ok(reply_bulk(argv[0]));
            return cc_ok(reply_simple("PONG"));
        case REDIS_CMD_ECHO:
            return cc_ok(reply_bulk(argv[0]));
        case REDIS_CMD_CONFIG_GET:
            return config_get_reply(argv[0], reply_arena);
        case REDIS_CMD_GET:
            return db_get(db, argv[0], reply_arena, &now);
        case REDIS_CMD_SET:
            /* REDIS_HOLD_INSTALL routes SET to db_set_install instead. */
            return cc_err(CC_ERROR(CC_ERR_INVALID_ARG,
                                   "ERR SET is not an execute_cmd arm"));
        case REDIS_CMD_SETNX:
            return db_setnx(db, argv[0], argv[1], &now);
        case REDIS_CMD_SETEX: {
            char[:] secs_arg = argv[1];
            int64_t seconds = secs_arg.to_i64() !>;
            return db_set_with_ttl(db, argv[0], argv[2],
                                   expire_seconds_to_rel_ms(seconds), &now);
        }
        case REDIS_CMD_PSETEX: {
            char[:] ms_arg = argv[1];
            int64_t ms = ms_arg.to_i64() !>;
            return db_set_with_ttl(db, argv[0], argv[2], ms, &now);
        }
        case REDIS_CMD_APPEND:
            return db_append(db, argv[0], argv[1], reply_arena, &now);
        case REDIS_CMD_STRLEN:
            return cc_ok(db_strlen(db, argv[0], &now));
        case REDIS_CMD_TYPE:
            return cc_ok(db_type(db, argv[0], &now));
        case REDIS_CMD_DEL:
            return cc_ok(db_del(db, (CCSlice*)argv, argc, &now));
        case REDIS_CMD_EXISTS:
            return cc_ok(db_exists(db, (CCSlice*)argv, argc, &now));
        case REDIS_CMD_INCR:
            return db_incrby(db, argv[0], 1, &now);
        case REDIS_CMD_DECR:
            return db_incrby(db, argv[0], -1, &now);
        case REDIS_CMD_INCRBY: {
            char[:] delta_arg = argv[1];
            int64_t delta = delta_arg.to_i64() !>;
            return db_incrby(db, argv[0], delta, &now);
        }
        case REDIS_CMD_DECRBY: {
            char[:] delta_arg = argv[1];
            int64_t delta = delta_arg.to_i64() !>;
            int64_t neg = cc_sub_i64_checked(0, delta) !> {
                return cc_err(CC_ERROR(CC_ERR_INVALID_ARG, "ERR decrement would overflow"));
            };
            return db_incrby(db, argv[0], neg, &now);
        }
        case REDIS_CMD_MGET:
            return db_mget(db, (CCSlice*)argv, argc, reply_arena, &now);
        case REDIS_CMD_MSET:
            return db_mset(db, (CCSlice*)argv, argc);
        case REDIS_CMD_EXPIRE: {
            char[:] secs_arg = argv[1];
            int64_t seconds = secs_arg.to_i64() !>;
            return db_expire_rel_ms(db, argv[0],
                                   expire_seconds_to_rel_ms(seconds), &now);
        }
        case REDIS_CMD_PEXPIRE: {
            char[:] ms_arg = argv[1];
            int64_t ms = ms_arg.to_i64() !>;
            return db_expire_rel_ms(db, argv[0], ms, &now);
        }
        case REDIS_CMD_TTL:
            return cc_ok(db_ttl(db, argv[0], 0, &now));
        case REDIS_CMD_PTTL:
            return cc_ok(db_ttl(db, argv[0], 1, &now));
        case REDIS_CMD_PERSIST:
            return db_persist(db, argv[0], &now);
        case REDIS_CMD_DBSIZE:
            return cc_ok(db_dbsize(db, &now));
        case REDIS_CMD_FLUSHDB:
        case REDIS_CMD_FLUSHALL:
            return cc_ok(db_flush(db));
        case REDIS_CMD_KEYS:
            return db_keys(db, argv[0], reply_arena, &now);
        case REDIS_CMD_CC_MEMLOG: {
            /* Optional phase tag: CC.MEMLOG [phase].  REDIS_HOLD_NONE: these
             * are diagnostics that may block on stderr, and a concurrent
             * writer can only skew counters a report already treats as
             * approximate. */
            const char* phase = "cc-memlog";
            char phase_buf[64];
            if (argc >= 1 && argv[0].ptr && argv[0].len > 0) {
                size_t n = argv[0].len < sizeof(phase_buf) - 1 ? argv[0].len
                                                             : sizeof(phase_buf) - 1;
                memcpy(phase_buf, argv[0].ptr, n);
                phase_buf[n] = '\0';
                phase = phase_buf;
            }
            db_dump_mem_stats(db, phase);
            redis_mem_report_impl(db, phase);
            return cc_ok(reply_simple("OK"));
        }
        default:
            return cc_err(CC_ERROR(CC_ERR_INVALID_ARG, "ERR unsupported command"));
    }
}

/* Result → reply.  A failed command answers with a RESP error line, so the
 * window loop writes exactly one reply per command either way. */
static RedisReply reply_or_err(CCResult_RedisReply_CCError built) {
    return built.is_err() ? err_reply(built.error()) : built.value();
}

/* Materialize reply->data into reply_arena so encode/write can run after
 * the table release.  Used for GET bulks (and other BULK_STRING replies).
 * materialize_in only — kind unchanged; static text / already-owned slices
 * are no-ops. */
@noblock static inline bool !>(CCError) redis_reply_ensure_owned(RedisReply* reply,
                                                                      CCArena* reply_arena) {
    if (!reply || !reply_arena) {
        return cc_err(CC_ERROR(CC_ERR_INVALID_ARG, "reply ensure_owned null"));
    }
    return reply->data.materialize_in(reply_arena);
}

static bool write_all(CCSocket* sock, CCSlice data) {
    size_t off = 0;
    const int write_deadline_ms = 1000;
    CCDeadline deadline = cc_deadline_after_ms(write_deadline_ms);
    while (off < data.len) {
        size_t n = cc_socket_write_deadline(sock,
                                            (const char*)data.ptr + off,
                                            data.len - off,
                                            &deadline) !>(e) {
            (void)e;
            return 0;
        };
        if (n == 0) return 0;
        off += n;
    }
    return 1;
}

static bool redis_conn_flush_out(RedisConn* conn) {
    if (!conn || conn->out_len == 0) return 1;
    CCSlice data = {
        .ptr = conn->out_buf,
        .len = conn->out_len,
    };
    conn->out_len = 0;
    return write_all(conn->sock, data);
}

static bool redis_conn_write_bytes(RedisConn* conn, CCSlice data) {
    if (!conn || data.len == 0) return 1;
    if (data.len > redis_conn_out_buf_bytes) {
        return conn->flush_out() && write_all(conn->sock, data);
    }
    if (conn->out_len + data.len > redis_conn_out_buf_bytes) {
        if (!conn->flush_out()) return 0;
    }
    memcpy(conn->out_buf + conn->out_len, data.ptr, data.len);
    conn->out_len += data.len;
    return 1;
}

/* The one reply→wire path.  cc_write's 0-on-didn't-fit drives the buffer
 * discipline: try the space left in out_buf, then flush and retry into the
 * whole buffer.  Only a reply larger than out_buf itself falls through to
 * streaming — opaque wire bytes go straight out, and a bulk goes as
 * schema-written header, payload slice, closing CRLF. */
static bool redis_conn_write_reply(RedisConn* conn, const RedisReply* reply) {
    if (!conn || !reply) return 0;
    size_t w = RedisReply_write(reply, conn->out_buf + conn->out_len,
                                redis_conn_out_buf_bytes - conn->out_len);
    if (w == 0) {
        if (!conn->flush_out()) return 0;
        w = RedisReply_write(reply, conn->out_buf, redis_conn_out_buf_bytes);
    }
    if (w != 0) {
        conn->out_len += w;
        return 1;
    }

    /* Streaming path; the retry above flushed, so out_buf is empty. */
    if (reply->kind == REDIS_REPLY_WIRE) return conn->write_bytes(reply->data);
    if (reply->kind != REDIS_REPLY_BULK_STRING) return 0;
    RespGBulkHdr hdr = { .len = (long long)reply->data.len };
    size_t hw = RespGBulkHdr_write(&hdr, conn->out_buf, redis_conn_out_buf_bytes);
    if (hw == 0) return 0;
    conn->out_len = hw;
    return conn->write_bytes(reply->data) &&
           conn->write_bytes(cc_slice_from_cstr("\r\n"));
}

static CCSlice !>(CCError) reply_arena_alloc_slice(CCArena* reply_arena, size_t n) {
    CCSlice s = cc_arena_alloc_slice_bytes(reply_arena, n);
    if (n > 0 && !s.ptr) return cc_err(CC_ERROR(CC_ERR_OUT_OF_MEMORY, "reply encode OOM"));
    return cc_ok(s);
}

/* One-shot error-reporting path: serialize directly into conn->out_buf
 * and flush immediately. */
static bool redis_conn_write_reply_now(RedisConn* conn, RedisReply reply) {
    return conn->write_reply(&reply) && conn->flush_out();
}

/* Window teardown: every reply landed in out_buf or the socket, so the
 * arena contents are dead. */
static inline void reply_arena_reset(RedisConn* conn) {
    if (!conn) return;
    cc_arena_reset(&conn->reply_arena);
}

/* DB construction, preload, and memory reporting, at server scope (the
 * memlog label strings match historical redis_idiomatic parsers). */
static bool db_setup(RedisDb* db) {
    if (!db_init(db, 1024)) {
        char scratch_buf[256];
        CCArena scratch = @create(scratch_buf, sizeof(scratch_buf)) @destroy;
        CCString line = @string("redis_idiomatic: db_init failed (out of memory?)", &scratch);
        redis_diag_fprintln(&line, &scratch);
        return 0;
    }
    int preload_keys = db_preload_key_count();
    if (preload_keys > 0) {
        if (!db_preload_keys_ok(db, preload_keys)) {
            fprintf(stderr, "redis_idiomatic: preload failed\n");
            return 0;
        }
        size_t preload_key_count = (size_t)preload_keys;
        char preload_scratch_buf[128];
        {
            CCArena preload_scratch =
                @create(preload_scratch_buf, sizeof(preload_scratch_buf)) @destroy;
            CCString line =
                @string(`redis_idiomatic: preloaded ${preload_key_count} keys`, &preload_scratch);
            redis_diag_fprintln(&line, &preload_scratch);
        }
        db_dump_mem_stats(db, "post-preload");
        redis_mem_emit_gap(db, "post-preload");
    }

    /* Tag kept as owner-ready for bench_then_memlog / baseline greps. */
    redis_mem_report(db, "owner-ready");
    return 1;
}

/* Drain up to k_pipeline_window_cap already-buffered commands.  Every hold
 * in the server is taken here, from the command's RedisCmdHold policy:
 *
 *   REDIS_HOLD_NONE     execute, no hold
 *   REDIS_HOLD_INSTALL  prep value -> hold -> install -> release
 *   REDIS_HOLD_TABLE    hold -> execute -> own bulk -> release
 *
 * In every arm the hold covers DB mutate/snapshot only: the guard releases
 * at the end of its arm — including on an error return — so RESP encoding
 * and the socket write always happen unheld.  End of window flushes out_buf.
 *
 * Returns ok(false) when the connection is gone (client closed / write
 * failed), err(e) on parse errors the caller reports, ok(true) with
 * *n_out = commands run otherwise.  The reply arena resets on exit. */
@noblock static bool !>(CCError) run_pipeline_window(RedisConn* conn,
                                                     RedisDb* db,
                                                     CCExclusiveMutex* table,
                                                     ReqIter* req_iter,
                                                     size_t* n_out) {
    @errhandler(CCError e) { return cc_err(e); }
    @defer reply_arena_reset(conn);

    size_t n = 0;
    *n_out = 0;
    while (n < (size_t)k_pipeline_window_cap) {
        RedisCmd cmd;
        bool has = rr_cmd_next(req_iter, &cmd) !>;
        if (!has) break;
        n++;
        *n_out = n;

        RedisReply reply;
        switch (cmd.hold) {
            case REDIS_HOLD_NONE:
                reply = reply_or_err(execute_cmd(db, &cmd, &conn->reply_arena));
                break;

            case REDIS_HOLD_INSTALL: {
                /* Value goes durable outside the hold; inside, install
                 * borrow-looks up and swings, or clones the key into
                 * key_arena and inserts (no discarded key on overwrite). */
                const CCSlice* argv = cmd.args + cmd.arg_start;
                CCString pre_val = db_prep_value(argv[1]) !>;
                CCExclusiveGuard g = table->acquire();
                @defer g.release();
                reply = reply_or_err(db_set_install(db, argv[0], pre_val, 0));
                break;
            }

            case REDIS_HOLD_TABLE: {
                CCExclusiveGuard g = table->acquire();
                @defer g.release();
                reply = reply_or_err(execute_cmd(db, &cmd, &conn->reply_arena));
                /* Own bulk before release: encode must never read DB memory
                 * once another fiber can mutate it. */
                if (reply.kind == REDIS_REPLY_BULK_STRING) {
                    redis_reply_ensure_owned(&reply, &conn->reply_arena) !>;
                }
                break;
            }

            default:
                reply = reply_error("ERR unknown hold policy");
                break;
        }

        if (!conn->write_reply(&reply)) return cc_ok(0);
    }

    /* End of window: flush outside the hold. */
    if (conn->out_len > 0 && !conn->flush_out()) return cc_ok(0);
    return cc_ok(1);
}

/* Connection fiber: read, parse, and run windows until the client goes
 * away.  This fiber does the work itself; `table` is its only link to the
 * other connections. */
@async int handle_client(CCSocket client, RedisDb* db, CCExclusiveMutex table) {
    @defer cc_socket_close(&client);

    /* All connection state on the fiber stack; the reply arena is the
     * connection's only heap allocation. */
    RedisConn conn_state = {0};
    RedisConn* conn = &conn_state;
    conn->reply_arena = cc_arena_heap(16 * 1024);
    if (!conn->reply_arena.base) return 1;
    conn->reply_arena.block_max = 0;
    @defer cc_arena_free(&conn->reply_arena);
    conn->sock = &client;

    /* Large enough for pipelined redis-benchmark without constant compact moves. */
    char read_buf[64 * 1024];
    RespReader reader;
    @nonblocking { reader = rr_init(read_buf, sizeof(read_buf)); }
    ReqIter req_iter = rr_req_iter(&reader);
    while (1) {
        /* Parse errors turn into RESP errors on the wire, then close. */
        @errhandler(CCError e) {
            (void)conn->write_reply_now(err_reply(e));
            return 0;
        }

        size_t n_cmds = 0;
        bool window_ok =
            run_pipeline_window(conn, db, &table, &req_iter, &n_cmds) !>;
        if (!window_ok) return 0;

        /* A full window with bytes still buffered means more pipelined
         * commands are ready — run another window before refilling. */
        if (n_cmds == (size_t)k_pipeline_window_cap && reader.start < reader.end) continue;

        bool more = redis_rr_fill(&reader, &client) !>(e) {
            conn->write_reply_now(io_err_reply(e));
            return 0;
        };
        if (!more) return 0;
    }
}

int main(int argc, char** argv) {
    @errhandler(CCError e) {
        char scratch_buf[256];
        CCArena scratch = @create(scratch_buf, sizeof(scratch_buf)) @destroy;
        const char* msg = e.message ? e.message : "unknown error";
        CCString line = @string(`fatal: ${msg}`, &scratch);
        redis_diag_fprintln(&line, &scratch);
        return 1;
    }

    int port = 6380;
    if (argc > 1) {
        char* end = NULL;
        long parsed = strtol(argv[1], &end, 10);
        if (end == argv[1] || (end && *end != 0) || parsed <= 0 || parsed > 65535) {
            char scratch_buf[256];
            CCArena scratch = @create(scratch_buf, sizeof(scratch_buf)) @destroy;
            CCString line = @string(`invalid port: ${argv[1]}`, &scratch);
            redis_diag_fprintln(&line, &scratch);
            return 1;
        }
        port = (int)parsed;
    }

    char addr[64];
    snprintf(addr, sizeof(addr), "127.0.0.1:%d", port);

    CCListener ln = cc_tcp_listen(addr, strlen(addr)) !>(e) {
        char scratch_buf[256];
        CCArena scratch = @create(scratch_buf, sizeof(scratch_buf)) @destroy;
        CCString line = @string(`listen error: ${(int)e}`, &scratch);
        redis_diag_fprintln(&line, &scratch);
        return 1;
    };
    @defer cc_listener_close(&ln);

    /* The DB lives at server scope and is shared by every connection. */
    RedisDb db = {0};
    if (!db_setup(&db)) return 1;
    @defer db_free_all(&db);

    /* One exclusive section, one mutex name for the whole table. */
    CCArena excl_arena = @create(kilobytes(16)) @destroy;
    CCExclusive* excl = cc_exclusive_create(&excl_arena);
    if (!excl) {
        fprintf(stderr, "redis_idiomatic: cc_exclusive_create failed\n");
        return 1;
    }
    @defer cc_exclusive_destroy(excl);
    CCExclusiveMutex table = excl->mutex(k_table_lock_name);

    RedisDb* dbp = &db;
    CCListener* ln_ptr = &ln;

    printf("redis_idiomatic listening on %s\n", addr);
    fflush(stdout);

    {
        CCNursery* server = cc_nursery_create(NULL) !> @destroy;

        static const int shutdown_sigs[] = { SIGINT, SIGTERM };
        if (server->cancel_on_signals(shutdown_sigs,
                                      sizeof(shutdown_sigs) / sizeof(shutdown_sigs[0])) != 0) {
            char scratch_buf[256];
            CCArena scratch = @create(scratch_buf, sizeof(scratch_buf)) @destroy;
            CCString line =
                @string("redis_idiomatic: failed to install shutdown handler", &scratch);
            redis_diag_fprintln(&line, &scratch);
            return 1;
        }

        server->spawn(() => [ln_ptr, dbp, table, server] {
            while (1) {
                CCSocket client = ln_ptr->accept() !>(e) {
                    if (!server->is_cancelled()) {
                        fprintf(stderr, "redis_idiomatic accept error: %d\n", (int)e);
                    }
                    break;
                };

                /* TCP_NODELAY: redis-benchmark's pipelined pattern
                 * (write N, read N, repeat) interacts with Nagle +
                 * delayed-ACK to produce multi-second stalls. */
                int one = 1;
                (void)setsockopt(client.fd, IPPROTO_TCP, TCP_NODELAY, &one, sizeof(one));

                (void)server->spawn_async(handle_client(client, dbp, table));
            }
        });
    }

    return 0;
}

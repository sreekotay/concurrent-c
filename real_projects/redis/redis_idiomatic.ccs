/*
 * redis_idiomatic.ccs — default Concurrent-C Redis (complete).
 *
 * Same control flow as redis_async_sketch.ccs:
 *   parse → hold → execute(ConnEnc) encodes → release → flush
 * Full RedisDb / expiry / command surface underneath.
 *
 * Lifetimes:
 *   argv           → bulk bytes borrow the current read window; slot
 *                    vector on per-command cc_arena_stack (grows; no cap).
 *                    RedisCmd is that argv extent (`.len` / `for-in`).
 *                    Fill lives on RespReader after the window returns —
 *                    next never sees it.
 *   reply_arena    → DB scratch (APPEND, CONFIG, KEYS hit list)
 *   Conn.out       → encode coalesce (cc_arena_stack 8K L1, then overflow);
 *                    flush after the window (never socket I/O under hold)
 *   RedisConnEnc   → @typeview Encode (no sock/flush)
 *   CCShardHold    → acquire inside execute (same shape as redis.go /
 *                    redis_async_sketch); encode under hold; release before
 *                    the next command / flush
 *
 * Shape (go + sketch): parse → execute(hold → exec → encode) → flush.
 * One string-switch maps the folded name to RedisOp; hold groups then one
 * exec switch on that enum. Encode on Conn under hold (MGET/KEYS stream
 * array_len+bulks). CONFIG GET still stages WIRE in reply_arena.
 * I/O / decode drops the connection. Command errors are -ERR and the
 * client stays up. Unknown command is decode-adjacent: -ERR then close.
 *
 * Build: `make redis_idiomatic`.  Tiny peer: `redis_async_sketch.ccs`.
 */

#include <ccc/std/prelude.cch>
#include <ccc/cc_instantiate.cch>
#include <ccc/std/net.cch>
#include <ccc/std/map.cch>
#include <ccc/std/string.cch>
#include <ccc/stdio.cch>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <signal.h>
#include <unistd.h>
#include "redis_cc/redis_cc.cch"
#include <ccc/cc_exclusive.cch>

enum {
    k_pipeline_window_cap = 16,
    k_out_buf = 8192,
    k_cmd_arena = 4096,
};

typedef struct RedisConn {
    CCArena reply_arena;
    CCSocket* sock;
    CCArena arena;
    CCString out;
} RedisConn;

typedef @typeview Encode on RedisConn {
    r: reply_arena, write, lit, simple, err, ok, pong, null, integer, bulk,
       array_len, write_reply;
} *RedisConnEnc;

#include "redis_resp.cch"

@grammar(rules) Resp {~~~~
    include "redis_resp.rules"
~~~~}

/* Write schemas (CONFIG). Must live in the .ccs —
 * #'…' is not safe inside #included .cch (cpp). */
@grammar(schema) RespGReply {~~~~
    use Resp
    one of [
        simple  [ #'+' s: Resp.line "\r\n" ]
        error   [ #'-' msg: Resp.line "\r\n" ]
        integer [ #':' v: int Resp.number "\r\n" ]
        bulk    [ #'$' len: int Resp.number "\r\n" data: bytes len "\r\n" ]
        array   [ #'*' n: int Resp.number "\r\n" items: items RespGReply n ]
    ]
~~~~}

@grammar(schema) RespGBulk {~~~~
    use Resp
    #'$' len: int Resp.number
    one of [
        nil  [= -1] [ "\r\n" ]
        data [>= 0] [ "\r\n" payload: bytes len "\r\n" ]
    ] by len
~~~~}

@grammar(schema) RespGBulkArray {~~~~
    use Resp
    #'*' n: int Resp.number "\r\n"
    elems: items RespGBulk n
~~~~}

@grammar(schema) RespGBulkHdr {~~~~
    use Resp
    #'$' len: int Resp.number "\r\n"
~~~~}

@grammar(schema) RespGArrayHdr {~~~~
    use Resp
    #'*' n: int Resp.number "\r\n"
~~~~}

@grammar(schema) RespGArg {~~~~
    use Resp
    #'$' len: int Resp.number "\r\n"
    data: bytes len
    "\r\n"
~~~~}

@grammar(schema) RespGInline {~~~~
    use Resp
    text: Resp.line "\r\n"
~~~~}

#include "redis_reply.cch"

static RespParseStatus gen_try_read_args_buffered(RespReader* r,
                                                  CCArena arena,
                                                  char[:]** out_args,
                                                  size_t* out_argc,
                                                  CCError* err) {
    @errhandler(CCError e) {
        *err = e;
        return RESP_PARSE_ERROR;
    }
    while (1) {
        const char* src = (const char*)(r->data + r->start);
        size_t avail = r->end - r->start;
        size_t pos = 0;
        if (avail == 0) return RESP_PARSE_INCOMPLETE;
        if (src[0] == '*') {
            size_t n, i;
            char[:]* args = NULL;
            RespGArrayHdr hdr;
            bool !>(CCError) hr =
                RespGArrayHdr_try_read(src, avail, &pos, arena, &hdr);
            if (hr.is_err()) {
                if (hr.error().kind == CC_ERR_WOULD_BLOCK)
                    return RESP_PARSE_INCOMPLETE;
                *err = hr.error();
                return RESP_PARSE_ERROR;
            }
            if (!hr.value()) return RESP_PARSE_INCOMPLETE;
            if (hdr.n < 0) {
                *err = CC_ERROR(CC_ERR_PARSE, "bad argc");
                return RESP_PARSE_ERROR;
            }
            n = (size_t)hdr.n;
            if (n == 0) {
                r->start += pos;
                continue;
            }
            args = cc_arena_alloc_T_count(CCSlice, arena, n);
            if (!args) {
                *err = CC_ERROR(CC_ERR_OUT_OF_MEMORY, "argv");
                return RESP_PARSE_ERROR;
            }
            @for (i in 0..n) {
                RespGArg a;
                bool !>(CCError) ar =
                    RespGArg_try_read(src, avail, &pos, arena, &a);
                if (ar.is_err()) {
                    if (ar.error().kind == CC_ERR_WOULD_BLOCK)
                        return RESP_PARSE_INCOMPLETE;
                    *err = ar.error();
                    return RESP_PARSE_ERROR;
                }
                if (!ar.value()) return RESP_PARSE_INCOMPLETE;
                args[i] = a.data.as_slice();
            }
            r->start += pos;
            *out_args = args;
            *out_argc = n;
            return RESP_PARSE_OK;
        }
        {
            RespGInline line;
            bool !>(CCError) tr =
                RespGInline_try_read(src, avail, &pos, arena, &line);
            if (tr.is_err()) {
                if (tr.error().kind == CC_ERR_WOULD_BLOCK)
                    return RESP_PARSE_INCOMPLETE;
                *err = tr.error();
                return RESP_PARSE_ERROR;
            }
            if (!tr.value()) return RESP_PARSE_INCOMPLETE;
            {
                size_t !>(CCError) pargs =
                    parse_inline_args_arena(line.text, arena, out_args);
                if (pargs.is_err()) {
                    *err = pargs.error();
                    return RESP_PARSE_ERROR;
                }
                r->start += pos;
                if (pargs.value() == 0) continue;
                *out_argc = pargs.value();
                return RESP_PARSE_OK;
            }
        }
    }
}

/* Parsed once from the folded command name; int-switched thereafter. */
typedef enum RedisOp {
    REDIS_OP_NONE = 0,
    REDIS_OP_PING,
    REDIS_OP_ECHO,
    REDIS_OP_CONFIG,
    REDIS_OP_GET,
    REDIS_OP_SET,
    REDIS_OP_SETNX,
    REDIS_OP_SETEX,
    REDIS_OP_PSETEX,
    REDIS_OP_APPEND,
    REDIS_OP_STRLEN,
    REDIS_OP_TYPE,
    REDIS_OP_INCR,
    REDIS_OP_DECR,
    REDIS_OP_INCRBY,
    REDIS_OP_DECRBY,
    REDIS_OP_EXPIRE,
    REDIS_OP_PEXPIRE,
    REDIS_OP_TTL,
    REDIS_OP_PTTL,
    REDIS_OP_PERSIST,
    REDIS_OP_DEL,
    REDIS_OP_EXISTS,
    REDIS_OP_MGET,
    REDIS_OP_MSET,
    REDIS_OP_DBSIZE,
    REDIS_OP_FLUSHDB,
    REDIS_OP_FLUSHALL,
    REDIS_OP_KEYS,
    REDIS_OP_CC_MEMLOG,
} RedisOp;

/* args[0] = folded command name (name_fold); args[1..] borrow the
 * current read window. Slot vector on the per-command arena. */
typedef struct RedisCmd {
    char[:]* args;
    size_t argc;
    char name_fold[16];
} RedisCmd;

@typehooks on RedisCmd {
    .len = cc_type_len_field("argc"),
    .access = cc_type_access_load("args"),
};

@noblock static bool !>(CCIoError) redis_rr_fill(RespReader* reader, CCSocket* sock) {
    return rr_fill(reader, sock);
}

/* ASCII fold into caller storage — do not mutate the read buffer. */
static char[:] fold_name(char[:] src, char* buf, size_t cap) {
    if (src.len == 0 || src.len >= cap) {
        char[:] empty = {0};
        return empty;
    }
    @for (i, ch in src) {
        char f = ch;
        if (f >= 'a' && f <= 'z') f -= 32;
        buf[i] = f;
    }
    char[:] out = buf.to_slice_n(src.len);
    return out;
}

/* payload = argc - 1 (command name at args[0]). max < 0 → unbounded. */
static bool payload_ok(size_t argc, size_t min, int max, int multiple) {
    size_t n = argc > 0 ? argc - 1 : 0;
    if (n < min) return 0;
    if (max >= 0 && n > (size_t)max) return 0;
    if (multiple > 0 && n % (size_t)multiple != 0) return 0;
    return 1;
}

static bool !>(CCError) rr_cmd_next(RespReader* reader, RedisCmd* out,
                                   CCArena arena) {
    size_t raw_argc = 0;
    CCError perr = {0};
    RespParseStatus st =
        gen_try_read_args_buffered(reader, arena, &out->args,
                                   &raw_argc, &perr);
    if (st == RESP_PARSE_INCOMPLETE) return cc_ok(0);
    if (st == RESP_PARSE_ERROR) return cc_err(perr);
    if (raw_argc < 1)
        return cc_err(CC_ERROR(CC_ERR_PARSE, "empty command"));
    out->argc = raw_argc;
    {
        char[:] folded = fold_name(out->args[0], out->name_fold,
                                   sizeof(out->name_fold));
        /* Overlong / empty name stays the borrow — redis_op → NONE,
         * not a fake "empty command" parse error. */
        if (folded.len != 0)
            out->args[0] = folded;
    }
    return cc_ok(1);
}

#include "redis_db.cch"

static RedisOp redis_op(char[:] name) {
    @switch (name) {
    case "PING":
        return REDIS_OP_PING;
    case "ECHO":
        return REDIS_OP_ECHO;
    case "CONFIG":
        return REDIS_OP_CONFIG;
    case "GET":
        return REDIS_OP_GET;
    case "SET":
        return REDIS_OP_SET;
    case "SETNX":
        return REDIS_OP_SETNX;
    case "SETEX":
        return REDIS_OP_SETEX;
    case "PSETEX":
        return REDIS_OP_PSETEX;
    case "APPEND":
        return REDIS_OP_APPEND;
    case "STRLEN":
        return REDIS_OP_STRLEN;
    case "TYPE":
        return REDIS_OP_TYPE;
    case "INCR":
        return REDIS_OP_INCR;
    case "DECR":
        return REDIS_OP_DECR;
    case "INCRBY":
        return REDIS_OP_INCRBY;
    case "DECRBY":
        return REDIS_OP_DECRBY;
    case "EXPIRE":
        return REDIS_OP_EXPIRE;
    case "PEXPIRE":
        return REDIS_OP_PEXPIRE;
    case "TTL":
        return REDIS_OP_TTL;
    case "PTTL":
        return REDIS_OP_PTTL;
    case "PERSIST":
        return REDIS_OP_PERSIST;
    case "DEL":
        return REDIS_OP_DEL;
    case "EXISTS":
        return REDIS_OP_EXISTS;
    case "MGET":
        return REDIS_OP_MGET;
    case "MSET":
        return REDIS_OP_MSET;
    case "DBSIZE":
        return REDIS_OP_DBSIZE;
    case "FLUSHDB":
        return REDIS_OP_FLUSHDB;
    case "FLUSHALL":
        return REDIS_OP_FLUSHALL;
    case "KEYS":
        return REDIS_OP_KEYS;
    case "CC.MEMLOG":
        return REDIS_OP_CC_MEMLOG;
    default:
        return REDIS_OP_NONE;
    }
}

static CCShardMask redis_shard_mask(const char** src_out) {
    const char* s = getenv("CC_REDIS_SHARDS");
    unsigned long n;
    char* end = NULL;
    CCShardMask mask;
    if (!s || !s[0]) {
        if (src_out) *src_out = "auto from ncpu";
        mask = cc_shard_mask_auto((size_t)REDIS_DB_MAX_SHARDS);
        return mask.count ? mask : cc_shard_mask_make(1u);
    }
    n = strtoul(s, &end, 10);
    if (end == s || (end && *end != 0) || n == 0 ||
        n > (unsigned long)REDIS_DB_MAX_SHARDS) {
        if (src_out) *src_out = "auto from ncpu (bad CC_REDIS_SHARDS)";
        mask = cc_shard_mask_auto((size_t)REDIS_DB_MAX_SHARDS);
        return mask.count ? mask : cc_shard_mask_make(1u);
    }
    if (src_out) *src_out = "CC_REDIS_SHARDS override";
    mask = cc_shard_mask_clamp((size_t)n, (size_t)REDIS_DB_MAX_SHARDS);
    return mask.count ? mask : cc_shard_mask_make(1u);
}

/* Unique shard ids for a key list (MGET/DEL stride=1, MSET stride=2). */
static size_t unique_shards(RedisDb* db, char[:]* keys, size_t nkeys,
                            size_t stride, uint64_t* names, size_t cap) {
    size_t n = 0, i, j;
    if (stride == 0) stride = 1;
    for (i = 0; i < nkeys; i += stride) {
        uint64_t si = (uint64_t)db_shard_index_for_key(db, keys[i]);
        int seen = 0;
        for (j = 0; j < n; j++) {
            if (names[j] == si) { seen = 1; break; }
        }
        if (!seen && n < cap) names[n++] = si;
    }
    return n;
}

/* --- Conn encode (sketch) ------------------------------------------------ */
/* Fixed wire bytes → lit(char[:]) (string lits coerce to CC_SLICE_LIT).
 * Interpolated headers → @string into @scratch, then one write into out.
 *
 * Encode/flush Result E is CCIoError (client-fatal). Command/db failures stay
 * CCError and become -ERR via enc_fail — they must not share this channel. */

static bool !>(CCIoError) write_all(CCSocket* sock, char[:] data) {
    size_t off = 0;
    const int write_deadline_ms = 1000;
    CCDeadline deadline = cc_deadline_after_ms(write_deadline_ms);
    while (off < data.len) {
        size_t n = sock->write_deadline(data.ptr + off, data.len - off,
                                        &deadline) !>(e) {
            return cc_err(e);
        };
        if (n == 0)
            return cc_err(cc_io_error(CC_ERROR(CC_ERR_CLOSED, "short write")));
        off += n;
    }
    return cc_ok(true);
}

static bool !>(CCIoError) redis_conn_flush(RedisConn* c) {
    char[:] data = c->out.as_slice();
    if (data.len == 0) return cc_ok(true);
    @defer c->arena.reset();
    @defer c->out.release(c->arena);
    write_all(c->sock, data) !>(e) { return cc_err(e); };
    return cc_ok(true);
}

static bool !>(CCIoError) redis_conn_write(RedisConn* c, char[:] data) {
    if (data.len == 0) return cc_ok(true);
    if (!c->out.append(data, c->arena) || c->out.failed())
        return cc_err(cc_io_error(CC_ERROR(CC_ERR_OUT_OF_MEMORY, "conn encode oom")));
    return cc_ok(true);
}

static bool !>(CCIoError) redis_conn_lit(RedisConn* c, char[:] s) {
    return c->write(s);
}

static bool !>(CCIoError) redis_conn_simple(RedisConn* c, const char* s) {
    CCString line = @string(`+${s}\r\n`, @scratch);
    return c->write(line.as_slice());
}

static bool !>(CCIoError) redis_conn_err(RedisConn* c, const char* s) {
    CCString line = @string(`-ERR ${s}\r\n`, @scratch);
    return c->write(line.as_slice());
}

static bool !>(CCIoError) redis_conn_ok(RedisConn* c) { return c->lit("+OK\r\n"); }
static bool !>(CCIoError) redis_conn_pong(RedisConn* c) { return c->lit("+PONG\r\n"); }
static bool !>(CCIoError) redis_conn_null(RedisConn* c) { return c->lit("$-1\r\n"); }

static bool !>(CCIoError) redis_conn_integer(RedisConn* c, int64_t v) {
    CCString line = @string(`:${v}\r\n`, @scratch);
    return c->write(line.as_slice());
}

static bool !>(CCIoError) redis_conn_bulk(RedisConn* c, char[:] b) {
    @errhandler(CCIoError e) { return cc_err(e); }
    CCString hdr = @string(`$${b.len}\r\n`, @scratch);
    c->write(hdr.as_slice()) !>;
    c->write(b) !>;
    return c->lit("\r\n");
}

static bool !>(CCIoError) redis_conn_array_len(RedisConn* c, size_t n) {
    CCString hdr = @string(`*${n}\r\n`, @scratch);
    return c->write(hdr.as_slice());
}

/* RedisReply from redis_db → Conn.out.  ERROR payloads already include
 * the conventional "ERR …" text after '-'. */
static bool !>(CCIoError) redis_conn_write_reply(RedisConn* c,
                                                 const RedisReply* reply) {
    @errhandler(CCIoError e) { return cc_err(e); }
    if (!c || !reply)
        return cc_err(cc_io_error(CC_ERROR(CC_ERR_INVALID_ARG, "conn write_reply: null")));
    switch (reply->kind) {
    case REDIS_REPLY_SIMPLE_STRING:
        c->lit("+") !>;
        c->write(reply->data) !>;
        return c->lit("\r\n");
    case REDIS_REPLY_ERROR:
        c->lit("-") !>;
        c->write(reply->data) !>;
        return c->lit("\r\n");
    case REDIS_REPLY_INTEGER:
        return c->integer(reply->int_value);
    case REDIS_REPLY_NULL_BULK:
        return c->null();
    case REDIS_REPLY_BULK_STRING:
        return c->bulk(reply->data);
    case REDIS_REPLY_WIRE:
        return c->write(reply->data);
    default:
        return cc_err(cc_io_error(CC_ERROR(CC_ERR_INTERNAL, "conn write_reply: unknown kind")));
    }
}

/* DB/command Err → Redis -ERR on the wire (Ok); connection stays open.
 * Only encode/IO failure surfaces as CCIoError. */
static bool !>(CCIoError) enc_fail(RedisConnEnc enc, CCError e) {
    const char* msg = e.message ? e.message : "internal error";
    if (msg[0] == 'E' && msg[1] == 'R' && msg[2] == 'R' && msg[3] == ' ')
        msg += 4;
    return enc->err(msg);
}

static bool !>(CCIoError) enc_int_result(RedisConnEnc enc,
                                         RedisReply !>(CCError) built) {
    RedisReply r;
    if (built.is_err()) return enc_fail(enc, built.error());
    r = built.value();
    return enc->integer(r.int_value);
}

/* CONFIG: still staged as RedisReply WIRE in reply_arena. */
static bool !>(CCIoError) enc_wire_result(RedisConnEnc enc,
                                          RedisReply !>(CCError) built) {
    RedisReply r;
    if (built.is_err()) return enc_fail(enc, built.error());
    r = built.value();
    return enc->write_reply(&r);
}

/* --- exec under hold: leaf → Conn; arrays stay WIRE --------------------- */

@noblock static bool !>(CCIoError) exec(RedisDb* db, RedisCmd* cmd,
                                        RedisConnEnc enc, RedisOp op) {
    /* Command/db CCError → -ERR (Ok). Result Err is encode/IO only. */
    @errhandler(CCError e) { return enc_fail(enc, e); }
    char[:]* keys = cmd->args + 1;
    size_t nkeys = cmd->argc > 0 ? cmd->argc - 1 : 0;
    CCArena reply_arena = enc->reply_arena;
    DbCmdClock clock = {0};
    @switch (op) {
    case REDIS_OP_GET: {
        RedisEntry* cell;
        RedisValue* val;
        if (!payload_ok(cmd->argc, 1, 1, 0))
            return enc->err("wrong number of arguments");
        cell = db_lookup_live(db, keys[0], &clock);
        if (!cell) return enc->null();
        val = &cell->val;
        @switch (val) {
        case .str(s):
            return enc->bulk(s.as_slice());
        case .num(n): {
            char[:] text = @string(`${n}`);
            return enc->bulk(text);
        }
        }
        return enc->err("corrupt value cell");
    }
    case REDIS_OP_SET:
        /* Clone under hold (sketch/go). Prep/install races under load. */
        if (!payload_ok(cmd->argc, 2, 2, 0))
            return enc->err("wrong number of arguments");
        db_set(db, keys[0], keys[1], 0) !>;
        return enc->ok();
    case REDIS_OP_SETNX:
        if (!payload_ok(cmd->argc, 2, 2, 0))
            return enc->err("wrong number of arguments");
        return enc_int_result(enc, db_setnx(db, keys[0], keys[1], &clock));
    case REDIS_OP_SETEX: {
        char[:] secs_arg;
        int64_t seconds;
        if (!payload_ok(cmd->argc, 3, 3, 0))
            return enc->err("wrong number of arguments");
        secs_arg = keys[1];
        seconds = secs_arg.to_i64() !>;
        db_set_with_ttl(db, keys[0], keys[2],
                        expire_seconds_to_rel_ms(seconds), &clock) !>;
        return enc->ok();
    }
    case REDIS_OP_PSETEX: {
        char[:] ms_arg;
        int64_t ms;
        if (!payload_ok(cmd->argc, 3, 3, 0))
            return enc->err("wrong number of arguments");
        ms_arg = keys[1];
        ms = ms_arg.to_i64() !>;
        db_set_with_ttl(db, keys[0], keys[2], ms, &clock) !>;
        return enc->ok();
    }
    case REDIS_OP_APPEND:
        if (!payload_ok(cmd->argc, 2, 2, 0))
            return enc->err("wrong number of arguments");
        return enc_int_result(
            enc, db_append(db, keys[0], keys[1], reply_arena, &clock));
    case REDIS_OP_STRLEN: {
        RedisEntry* cell;
        RedisValue* val;
        if (!payload_ok(cmd->argc, 1, 1, 0))
            return enc->err("wrong number of arguments");
        cell = db_lookup_live(db, keys[0], &clock);
        if (!cell) return enc->integer(0);
        val = &cell->val;
        @switch (val) {
        case .str:
            return enc->integer((int64_t)val->str.len());
        case .num: {
            int64_t n = val->num;
            char[:] text = @string(`${n}`);
            return enc->integer((int64_t)text.len);
        }
        }
        return enc->integer(0);
    }
    case REDIS_OP_TYPE:
        if (!payload_ok(cmd->argc, 1, 1, 0))
            return enc->err("wrong number of arguments");
        return enc->simple(db_lookup_live(db, keys[0], &clock) ? "string"
                                                               : "none");
    case REDIS_OP_INCR:
        if (!payload_ok(cmd->argc, 1, 1, 0))
            return enc->err("wrong number of arguments");
        return enc_int_result(enc, db_incrby(db, keys[0], 1, &clock));
    case REDIS_OP_DECR:
        if (!payload_ok(cmd->argc, 1, 1, 0))
            return enc->err("wrong number of arguments");
        return enc_int_result(enc, db_incrby(db, keys[0], -1, &clock));
    case REDIS_OP_INCRBY: {
        char[:] delta_arg;
        int64_t delta;
        if (!payload_ok(cmd->argc, 2, 2, 0))
            return enc->err("wrong number of arguments");
        delta_arg = keys[1];
        delta = delta_arg.to_i64() !>;
        return enc_int_result(enc, db_incrby(db, keys[0], delta, &clock));
    }
    case REDIS_OP_DECRBY: {
        char[:] delta_arg;
        int64_t delta;
        int64_t neg;
        if (!payload_ok(cmd->argc, 2, 2, 0))
            return enc->err("wrong number of arguments");
        delta_arg = keys[1];
        delta = delta_arg.to_i64() !>;
        neg = cc_sub_i64_checked(0, delta) !> {
            return enc->err("decrement would overflow");
        };
        return enc_int_result(enc, db_incrby(db, keys[0], neg, &clock));
    }
    case REDIS_OP_EXPIRE: {
        char[:] secs_arg;
        int64_t seconds;
        if (!payload_ok(cmd->argc, 2, 2, 0))
            return enc->err("wrong number of arguments");
        secs_arg = keys[1];
        seconds = secs_arg.to_i64() !>;
        return enc_int_result(
            enc, db_expire_rel_ms(db, keys[0],
                                  expire_seconds_to_rel_ms(seconds), &clock));
    }
    case REDIS_OP_PEXPIRE: {
        char[:] ms_arg;
        int64_t ms;
        if (!payload_ok(cmd->argc, 2, 2, 0))
            return enc->err("wrong number of arguments");
        ms_arg = keys[1];
        ms = ms_arg.to_i64() !>;
        return enc_int_result(enc, db_expire_rel_ms(db, keys[0], ms, &clock));
    }
    case REDIS_OP_TTL:
        if (!payload_ok(cmd->argc, 1, 1, 0))
            return enc->err("wrong number of arguments");
        return enc->integer(db_ttl(db, keys[0], 0, &clock).int_value);
    case REDIS_OP_PTTL:
        if (!payload_ok(cmd->argc, 1, 1, 0))
            return enc->err("wrong number of arguments");
        return enc->integer(db_ttl(db, keys[0], 1, &clock).int_value);
    case REDIS_OP_PERSIST:
        if (!payload_ok(cmd->argc, 1, 1, 0))
            return enc->err("wrong number of arguments");
        return enc_int_result(enc, db_persist(db, keys[0], &clock));
    case REDIS_OP_DEL: {
        size_t i;
        int64_t removed = 0;
        if (!payload_ok(cmd->argc, 1, -1, 0))
            return enc->err("wrong number of arguments");
        @for (i in 0..nkeys) {
            RedisEntry* cell = db_lookup_live(db, keys[i], &clock);
            if (!cell) continue;
            db_remove_entry(db, keys[i], cell);
            removed++;
        }
        return enc->integer(removed);
    }
    case REDIS_OP_EXISTS: {
        size_t i;
        int64_t found = 0;
        if (!payload_ok(cmd->argc, 1, -1, 0))
            return enc->err("wrong number of arguments");
        @for (i in 0..nkeys) {
            if (db_lookup_live(db, keys[i], &clock)) found++;
        }
        return enc->integer(found);
    }
    case REDIS_OP_MGET: {
        size_t i;
        if (!payload_ok(cmd->argc, 1, -1, 0))
            return enc->err("wrong number of arguments");
        /* Sketch shape: header then bulks. Mid-encode Err truncates the
         * array on the wire (conn closes) — same caveat as the sketch. */
        enc->array_len(nkeys) !>;
        @for (i in 0..nkeys) {
            RedisEntry* cell = db_lookup_live(db, keys[i], &clock);
            RedisValue* val;
            if (!cell) {
                enc->null() !>;
                continue;
            }
            val = &cell->val;
            @switch (val) {
            case .str:
                enc->bulk(val->str.as_slice()) !>;
                break;
            case .num: {
                int64_t n = val->num;
                char[:] text = @string(`${n}`);
                enc->bulk(text) !>;
                break;
            }
            }
        }
        return cc_ok(true);
    }
    case REDIS_OP_MSET:
        if (!payload_ok(cmd->argc, 2, -1, 2))
            return enc->err("wrong number of arguments");
        db_mset(db, keys, nkeys) !>;
        return enc->ok();
    case REDIS_OP_DBSIZE:
        if (!payload_ok(cmd->argc, 0, 0, 0))
            return enc->err("wrong number of arguments");
        return enc->integer(db_dbsize(db, &clock).int_value);
    case REDIS_OP_FLUSHDB:
    case REDIS_OP_FLUSHALL:
        if (!payload_ok(cmd->argc, 0, 1, 0))
            return enc->err("wrong number of arguments");
        (void)db_flush(db);
        return enc->ok();
    case REDIS_OP_KEYS: {
        /* One walk under HOLD_ALL: collect borrows, then array_len + bulks.
         * Holds every writer, so the packed key slices stay valid. */
        enum { k_keys_pattern_max = 512 };
        char[:] pattern;
        const char* pat;
        char[:]* hits = NULL;
        size_t matched = 0, cap = 0;
        size_t si, i;
        if (!payload_ok(cmd->argc, 1, 1, 0))
            return enc->err("wrong number of arguments");
        pattern = keys[0];
        if (pattern.len > (size_t)k_keys_pattern_max)
            return enc->err("KEYS pattern too long");
        pat = (const char*)pattern.ptr;
        if (db && db->shards) {
            for (si = 0; si < db->shard_count; ++si) {
                RedisDbShard* sh = &db->shards[si];
                size_t n = sh->entries ? sh->entries->len() : 0;
                for (i = 0; i < n; ++i) {
                    CCSlicePacked* kp = sh->entries->key_ptr(i);
                    int64_t exp;
                    char[:] ks;
                    if (!kp) continue;
                    exp = db_expires_get(db, *kp);
                    if (exp != 0 && clock.now() >= exp) continue;
                    ks = kp->as_slice();
                    if (!glob_match(pat, pattern.len, (const char*)ks.ptr,
                                    ks.len))
                        continue;
                    if (matched == cap) {
                        size_t ncap = cap ? cap * 2 : 16;
                        char[:]* nh =
                            cc_arena_alloc_T_count(CCSlice, reply_arena, ncap);
                        if (!nh) return enc->err("oom");
                        if (hits)
                            memcpy(nh, hits, cap * sizeof(CCSlice));
                        hits = nh;
                        cap = ncap;
                    }
                    hits[matched++] = ks;
                }
            }
        }
        enc->array_len(matched) !>;
        @for (i in 0..matched)
            enc->bulk(hits[i]) !>;
        return cc_ok(true);
    }
    case REDIS_OP_CC_MEMLOG: {
        const char* phase = "cc-memlog";
        char phase_buf[64];
        if (!payload_ok(cmd->argc, 0, 1, 0))
            return enc->err("wrong number of arguments");
        if (cmd->argc >= 2 && keys[0].ptr && keys[0].len > 0) {
            size_t n = keys[0].len < sizeof(phase_buf) - 1 ? keys[0].len
                                                           : sizeof(phase_buf) - 1;
            memcpy(phase_buf, keys[0].ptr, n);
            phase_buf[n] = '\0';
            phase = phase_buf;
        }
        db_dump_mem_stats(db, phase);
        redis_mem_report_impl(db, phase);
        return enc->ok();
    }
    default:
        return enc->err("internal");
    }
}

/* Hold + work + encode (redis.go / sketch execute).
 * redis_op() is the only string-switch; case groups are the hold class.
 * Result E is CCIoError only (encode/socket). Command/db CCError is mapped
 * to -ERR inside exec via enc_fail.
 * Ok(true) = keep client; Ok(false) = reply already encoded, close after flush
 * (unknown command / decode-adjacent policy). */
@noblock static bool !>(CCIoError) execute(RedisDb* db, CCShardDomain* shards,
                                           RedisCmd* cmd, RedisConnEnc enc) {
    @errhandler(CCIoError e) { return cc_err(e); }
    RedisOp op;

    if (cmd->argc == 0) return enc->err("empty command");
    op = redis_op(cmd->args[0]);

    @switch (op) {
    case REDIS_OP_PING:
        if (!payload_ok(cmd->argc, 0, 1, 0))
            return enc->err("wrong number of arguments");
        if (cmd->argc == 2) return enc->bulk(cmd->args[1]);
        return enc->pong();
    case REDIS_OP_ECHO:
        if (!payload_ok(cmd->argc, 1, 1, 0))
            return enc->err("wrong number of arguments");
        return enc->bulk(cmd->args[1]);
    case REDIS_OP_CONFIG: {
        char sub[8];
        char[:] get;
        if (cmd->argc != 3) return enc->err("wrong number of arguments");
        get = fold_name(cmd->args[1], sub, sizeof(sub));
        @switch (get) {
        case "GET":
            break;
        default:
            return enc->err("unsupported command");
        }
        return enc_wire_result(
            enc, config_get_reply(cmd->args[2], enc->reply_arena));
    }

    case REDIS_OP_GET:
    case REDIS_OP_SET:
    case REDIS_OP_SETNX:
    case REDIS_OP_SETEX:
    case REDIS_OP_PSETEX:
    case REDIS_OP_APPEND:
    case REDIS_OP_STRLEN:
    case REDIS_OP_TYPE:
    case REDIS_OP_INCR:
    case REDIS_OP_DECR:
    case REDIS_OP_INCRBY:
    case REDIS_OP_DECRBY:
    case REDIS_OP_EXPIRE:
    case REDIS_OP_PEXPIRE:
    case REDIS_OP_TTL:
    case REDIS_OP_PTTL:
    case REDIS_OP_PERSIST: {
        CCShardHold hold;
        if (cmd->argc < 2) return enc->err("wrong number of arguments");
        hold = shards->hold_one(
            (uint64_t)db_shard_index_for_key(db, cmd->args[1]));
        @defer hold.release();
        if (!hold.held()) return enc->err("shard admission failed");
        return exec(db, cmd, enc, op);
    }

    case REDIS_OP_DEL:
    case REDIS_OP_EXISTS:
    case REDIS_OP_MGET:
    case REDIS_OP_MSET: {
        uint64_t names[REDIS_DB_MAX_SHARDS];
        size_t stride = (op == REDIS_OP_MSET) ? 2u : 1u;
        size_t nkeys;
        size_t nnames;
        CCShardHold hold;
        if (cmd->argc < 2) return enc->err("wrong number of arguments");
        nkeys = cmd->argc - 1;
        nnames = unique_shards(db, cmd->args + 1, nkeys, stride, names,
                               (size_t)REDIS_DB_MAX_SHARDS);
        hold = shards->hold_sorted(names, nnames);
        @defer hold.release();
        if (!hold.held()) return enc->err("shard admission failed");
        return exec(db, cmd, enc, op);
    }

    case REDIS_OP_DBSIZE:
    case REDIS_OP_FLUSHDB:
    case REDIS_OP_FLUSHALL:
    case REDIS_OP_KEYS:
    case REDIS_OP_CC_MEMLOG: {
        CCShardHold hold = shards->hold_all();
        @defer hold.release();
        if (!hold.held()) return enc->err("shard admission failed");
        return exec(db, cmd, enc, op);
    }

    case REDIS_OP_NONE:
    default:
        enc->err("unsupported command") !>;
        return cc_ok(false);
    }
}

/* !> binders on CCIoError results project the as: CCError face into `e`. */
static void redis_client_drop_log(const char* phase, CCError e) {
    eprintln(@string(`redis_idiomatic: client drop: ${phase}: ${cc_error_str(e)}`, @scratch)) !>;
}

static bool redis_conn_write_err_now(RedisConn* conn, CCError e) {
    @errhandler(CCError e) {
        redis_client_drop_log("write -ERR", e);
        return 0;
    }
    RedisConnEnc enc = conn;
    const char* msg = e.message ? e.message : "internal error";
    /* Strip leading "ERR " if present — redis_conn_err adds -ERR. */
    if (msg[0] == 'E' && msg[1] == 'R' && msg[2] == 'R' && msg[3] == ' ')
        msg += 4;
    enc->err(msg) !>(e2) {
        redis_client_drop_log("write -ERR", e2);
        return 0;
    };
    conn->flush() !>(e2) {
        redis_client_drop_log("flush -ERR", e2);
        return 0;
    };
    return 1;
}

static bool db_setup(RedisDb* db, size_t shard_count, const char* shard_src) {
    @errhandler(CCError e) {
        cc_error_log(e);
        return 0;
    }
    if (!db_init(db, 1024, shard_count)) {
        eprintln("redis_idiomatic: db_init failed (out of memory?)") !>;
        return 0;
    }
    const char* src = shard_src ? shard_src : "auto from ncpu";
    size_t nshards = db->shard_count;
    eprintln(@string(`redis_idiomatic: shards=${nshards} (${src})`, @scratch)) !>;
    int preload_keys = db_preload_key_count();
    if (preload_keys > 0) {
        if (!db_preload_keys_ok(db, preload_keys)) {
            eprintln("redis_idiomatic: preload failed") !>;
            return 0;
        }
        size_t preload_key_count = (size_t)preload_keys;
        eprintln(@string(`redis_idiomatic: preloaded ${preload_key_count} keys`,
                         @scratch)) !>;
        db_dump_mem_stats(db, "post-preload");
        redis_mem_emit_gap(db, "post-preload");
    }
    redis_mem_report(db, "owner-ready");
    return 1;
}

/* Pipeline window: parse → execute → flush (hold lives inside execute).
 * Ok(false) = stop client (IO already logged). Err(CCError) = parse/decode
 * failure for handle_client (-ERR then close). */
@noblock static bool !>(CCError) run_pipeline_window(RedisConn* conn,
                                                     RedisDb* db,
                                                     CCShardDomain* shards,
                                                     RespReader* reader,
                                                     size_t* n_out) {
    @errhandler(CCError e) { return cc_err(e); }
    @defer conn->reply_arena.reset();

    *n_out = 0;
    @for (n in 0..(size_t)k_pipeline_window_cap) {
        cc_arena_stack(cmd_a, k_cmd_arena);
        RedisCmd cmd = {0};
        bool has = rr_cmd_next(reader, &cmd, cmd_a) !>;
        if (!has) break;
        *n_out = n + 1;
        bool keep = execute(db, shards, &cmd, conn) !>(e) {
            redis_client_drop_log("execute", e.base);
            return cc_ok(0);
        };
        if (!keep) {
            /* Unknown command etc.: flush -ERR then stop client (not silent). */
            redis_client_drop_log(
                "execute", CC_ERROR(CC_ERR_INVALID_ARG, "unsupported command"));
            conn->flush() !>(e) {
                redis_client_drop_log("flush", e);
                return cc_ok(0);
            };
            return cc_ok(0);
        }
    }

    /* UFCS Io unwrap binders project as: CCError; free-fn binders keep CCIoError. */
    conn->flush() !>(e) {
        redis_client_drop_log("flush", e);
        return cc_ok(0);
    };
    return cc_ok(1);
}

static void handle_client(CCSocket client, RedisDb* db, CCShardDomain* shards) {
    cc_arena_stack(out_arena, k_out_buf);
    RedisConn conn = {
        .sock = &client,
        .arena = out_arena,
        .out = cc_string_new(),
    };
    @defer client.close();
    @defer conn.flush() !>(e) {
        redis_client_drop_log("flush on teardown", e);
    };

    conn.reply_arena = cc_arena_heap(16 * 1024);
    if (!cc_arena_is_live(conn.reply_arena)) return;
    conn.reply_arena.a->block_max = 0;
    @defer conn.reply_arena.destroy();

    char read_buf[64 * 1024];
    RespReader reader;
    @nonblocking { reader = rr_init(read_buf, sizeof(read_buf)); }

    while (1) {
        @errhandler(CCError e) {
            redis_client_drop_log("parse", e);
            (void)redis_conn_write_err_now(&conn, e);
            client.close();
            return;
        }

        size_t n_cmds = 0;
        bool window_ok =
            run_pipeline_window(&conn, db, shards, &reader, &n_cmds) !>;
        if (!window_ok) return;

        if (n_cmds == (size_t)k_pipeline_window_cap && reader.start < reader.end)
            continue;

        bool more = redis_rr_fill(&reader, &client) !>(e) {
            redis_client_drop_log("read", e.base);
            (void)redis_conn_write_err_now(&conn, e.base);
            return;
        };
        if (!more) return;
    }
}

int main(int argc, char** argv) {
    @errhandler(CCError e) { cc_error_log(e); return 1; }

    int port = 6380;
    if (argc > 1) {
        char* end = NULL;
        long parsed = strtol(argv[1], &end, 10);
        if (end == argv[1] || (end && *end != 0) || parsed <= 0 || parsed > 65535) {
            eprintln(@string(`invalid port: ${argv[1]}`, @scratch)) !>;
            return 1;
        }
        port = (int)parsed;
    }

    CCString addr = @string(`127.0.0.1:${port}`, @scratch);

    CCListener ln = cc_tcp_listen(addr.as_slice()) !>(e) {
        eprintln(@string(`listen error: ${e}`, @scratch)) !>;
        return 1;
    };
    @defer ln.close();

    RedisDb db = {0};
    const char* shard_src = NULL;
    CCShardMask mask = redis_shard_mask(&shard_src);
    if (!db_setup(&db, mask.count, shard_src)) return 1;
    @defer db_free_all(&db);

    CCArena excl_arena = cc_arena_heap(kilobytes(64));
    @defer excl_arena.destroy();
    CCExclusive excl = cc_exclusive_create(excl_arena, mask.count * 2u) !> @destroy;
    CCShardDomain shards = cc_shard_domain(excl, mask);

    size_t nshards = db.shard_count;
    /* stderr: startup banners must not sit in stdout block-buffering when
     * the process is redirected (smoke / sanitize / monitored runs). */
    eprintln(@string(`redis_idiomatic listening on ${addr} shards=${nshards}`,
                     @scratch)) !>;

    CCNursery server = cc_nursery_create() !> @destroy;
    server.cancel_on_signals(SIGINT, SIGTERM) !>;

    server.spawn(() => [@safe &db, @safe &ln, @safe &shards, server] {
        ln.serve(server, (CCSocket* accepted) => [@safe &db, @safe &shards, server] {
            CCSocket client = *accepted;
            (void)client.set_nodelay(1);
            server.spawn(() => [@safe &db, @safe &shards, client] {
                handle_client(client, &db, &shards);
            }) !>;
        });
    }) !>;

    return 0;
}

/*
 * redis_idiomatic.ccs
 *
 * One-writer concurrency via an N:1 request channel.  Only the owner
 * fiber touches RedisDb; client fibers submit batches and drain the
 * matching replies on a per-connection 1:1 reply channel.  Serialization
 * is by channel topology, not worker pinning, so the scheduler is free
 * to use any number of OS threads.  Pipeline depth is bounded by
 * `k_pipeline_reply_cap` (see enum near the reply channel typedef).
 *
 * Build: `make redis_idiomatic`.  Bench: `./bench_robust.sh`.
 * Memory: CC_REDIS_MEM_REPORT=1 logs Mach footprint, logical_db_live vs
 * mach_phys_footprint, db_dump_mem_stats (per-arena map, key, value slabs).
 * CC.MEMLOG command prints arena + accounting without restart; see bench_then_memlog.sh.
 * mem_account.sh runs vmmap summary idle vs load vs upstream.
 */

#include <ccc/std/prelude.cch>
#include <ccc/std/net.cch>
#include <ccc/std/map.cch>
#include <ccc/std/string.cch>
#include <stdio.h>
#include <stdlib.h>
#include <stdatomic.h>
#include <string.h>
#include <signal.h>
#include <unistd.h>
#include <errno.h>
#include <sys/socket.h>
#include <netinet/in.h>   /* IPPROTO_TCP (not transitive from tcp.h on glibc) */
#include <netinet/tcp.h>
#include <sys/resource.h>
#if defined(__APPLE__)
#include <mach/mach.h>
#include <mach/task_info.h>
#endif
#include "redis_cc/redis_cc.cch"
#include <ccc/std/task.cch>
#include <ccc/cc_sched.cch>
#include <ccc/cc_closure.cch>
#include <ccc/cc_type.cch>

/* DB arena layout:
 *   - Three arenas: map (RedisDbMap blob + handle), key (cloned key bytes),
 *     value (CCString backing for DB values).  Mem report prints
 *     cc_arena_committed_gross_bytes per pool (slab chain + overflow + extent
 *     wrapper structs); see cc_arena.cch.
 *   - Map/value arenas use small fixed roots + heap overflow.
 *   - Key arena remains growable because key bytes are many small persistent
 *     allocations, which fit the slab model better than per-key malloc. */

static inline CCSliceHdr db_key_hdr_view(char[:] key) {
    CCSliceHdr h = {0};
    h.ptr = key.ptr;
    h.len = key.len;
    return h;
}

static inline size_t db_map_hash_key(CCSliceHdr key) {
    size_t h = 2166136261U;
    const unsigned char *p = (const unsigned char *)key.ptr;
    for (size_t i = 0; i < key.len; ++i)
        h ^= p[i], h *= 16777619;
    return h;
}

static inline int db_map_eq_key(CCSliceHdr a, CCSliceHdr b) {
    return a.len == b.len && (a.ptr == b.ptr || (a.ptr && b.ptr && memcmp(a.ptr, b.ptr, a.len) == 0));
}

CC_MAP_DECL_ARENA(CCSliceHdr, CCString, RedisDbMap, db_map_hash_key, db_map_eq_key);
CC_MAP_DECL_UFCS(RedisDbMap);

static inline size_t RedisDbMap_live_bytes(const RedisDbMap *m) {
    size_t cap;
    if (!m) return 0;
    cap = RedisDbMap_cap(m);
    if (cap == 0) return sizeof(*m);
    return sizeof(*m) + cap * (sizeof(CCSliceHdr) + sizeof(CCString)) + sizeof(uint16_t) * (cap + 4u) + 128u;
}

typedef struct RedisDb {
    CCArena map_arena;
    CCArena key_arena;
    CCArena value_arena;
    RedisDbMap* entries;
} RedisDb;

typedef struct RedisDbMemStats {
    size_t key_alloc_count;
    size_t key_alloc_bytes;
    size_t key_release_count;
    size_t key_release_bytes;
    size_t value_alloc_count;
    size_t value_alloc_bytes;
    size_t value_release_count;
    size_t value_release_bytes;
} RedisDbMemStats;

static RedisDbMemStats g_db_mem_stats = {0};

/* Compile-time channel geometry: embedded in CC endpoint types and must match
 * handle_client's per-round submit cap (same value as reply channel depth). */
enum {
    k_request_chan_cap = 256,
    k_pipeline_reply_cap = 16,
    redis_conn_out_buf_bytes = 1024,
};

typedef struct RedisPipelineBatch {
    size_t cap;
    size_t submitted;
    size_t replies_pending;
} RedisPipelineBatch;

typedef enum RedisReplySendStatus {
    REDIS_REPLY_SEND_QUEUED = 0,
    REDIS_REPLY_SEND_CLOSED,
} RedisReplySendStatus;

typedef enum RedisPipelineStatus {
    REDIS_PIPELINE_OK = 0,
    REDIS_PIPELINE_OWNER_UNAVAILABLE,
    REDIS_PIPELINE_REPLY_CLOSED,
    REDIS_PIPELINE_WRITE_FAILED,
} RedisPipelineStatus;

static inline RedisPipelineBatch redis_pipeline_batch_start(void) {
    return (RedisPipelineBatch){
        .cap = (size_t)k_pipeline_reply_cap,
        .submitted = 0,
        .replies_pending = 0,
    };
}

static inline bool redis_pipeline_batch_has_room(const RedisPipelineBatch* batch) {
    return batch && batch->submitted < batch->cap;
}

static inline bool redis_pipeline_batch_is_full(const RedisPipelineBatch* batch) {
    return batch && batch->submitted == batch->cap;
}

static inline void redis_pipeline_batch_accept(RedisPipelineBatch* batch) {
    batch->submitted++;
    batch->replies_pending++;
}

typedef RedisReply[~k_pipeline_reply_cap 1:1 >] ReplyTx;
typedef RedisReply[~k_pipeline_reply_cap 1:1 <] ReplyRx;

typedef struct RedisConn {
    uint64_t conn_id;
    uint64_t next_request_id;
    /* Requests accepted by the owner but not yet drained from reply_rx.
     * Only the client fiber touches this (submit++ / drain--), and the
     * teardown drain-to-zero uses it as the join condition — see
     * handle_client's @destroy.  No refcounts: the owner returns each
     * request's pool slot BEFORE queueing its reply, so "all replies
     * drained" proves the owner holds nothing of this conn. */
    size_t inflight;
    /* Per-conn pool of RedisRequest slots.  Each slot is exactly one
     * RedisRequest, with req->arena wrapping the trailing argv_buf
     * (heap-spills on overflow). */
    CCArenaPool req_pool;
    /* Backing storage for reply bytes that cannot safely borrow request/DB
     * memory across the owner-to-client channel handoff. Reset after the
     * client drains one reply batch. */
    CCArena reply_arena;
    /* Owner → client reply stream (1:1, depth k_pipeline_reply_cap). */
    ReplyTx reply_tx;
    ReplyRx reply_rx;
    /* The session's socket, set once by handle_client right after create.
     * The socket is handle_client's stack frame and its @defer close runs
     * AFTER the conn's @destroy (reverse registration order), so it
     * strictly outlives the conn.  Owned here so the write family below
     * are RECEIVER-FIRST conn methods instead of (sock, conn, ...)
     * threading through every signature. */
    CCSocket* sock;
    size_t out_len;
    char out_buf[redis_conn_out_buf_bytes];
} RedisConn;

/* The shared request channel's two endpoints, named so function
 * signatures don't have to spell out the channel type.  Clients hand a
 * RedisRequest* across ReqTx; the owner drains from ReqRx and replies
 * on the request's originating conn->reply_rx. */
typedef RedisRequest*[~k_request_chan_cap N:1 >] ReqTx;
typedef RedisRequest*[~k_request_chan_cap N:1 <] ReqRx;

static RedisConn* redis_conn_create(uint64_t conn_id);
static void redis_conn_destroy(RedisConn* conn);
@noblock static void redis_conn_release_slot(RedisConn* conn, RedisRequest* req);

/* Register RedisConn*'s destroy hook.  Per-use @destroy bodies run
 * BEFORE the registered callee, letting handle_client drain in-flight
 * replies to zero ahead of the free — the drain IS the join (one reply
 * per accepted request, slot returned before each reply is queued). */
@comptime {
    (void)cc_type_register("RedisConn*", (CCTypeHooks){
        .destroy = cc_type_destroy_call("redis_conn_destroy"),
    });
}

static CCIoError net_to_io_error(CCNetError err) {
    switch (err) {
        case CC_NET_CONNECTION_CLOSED:
        case CC_NET_CONNECTION_RESET:
            return cc_io_error(CC_IO_CONNECTION_CLOSED);
        case CC_NET_TIMED_OUT:
            return cc_io_error(CC_IO_BUSY);
        default:
            return cc_io_error(CC_IO_OTHER);
    }
}

/* Line-oriented stderr via @string scratch arena (see string_template_smoke).
 * In @async bodies, wrap @create/@string in @nonblocking — default autoblock
 * would dispatch arena init/diag to the blocking pool (see
 * tests/async_create_string_nonblocking_smoke.ccs). */
static void redis_diag_fprintln(CCString* line, CCArena* scratch) {
    const char* p = cc_string_cstr(line, scratch);
    if (p) fprintf(stderr, "%s\n", p);
}

static bool slice_eq_ignore_case(char[:] s, const char* cstr) {
    size_t len = strlen(cstr);
    if (s.len != len) return false;
    for (size_t i = 0; i < len; ++i) {
        char a = ((const char*)s.ptr)[i];
        char b = cstr[i];
        if (a >= 'a' && a <= 'z') a = (char)(a - 'a' + 'A');
        if (b >= 'a' && b <= 'z') b = (char)(b - 'a' + 'A');
        if (a != b) return false;
    }
    return true;
}

static int64_t !>(CCError) parse_i64(char[:] s) {
    if (s.len == 0) return cc_err(CC_ERROR(CC_ERR_PARSE, "empty integer"));
    int sign = 1;
    size_t i = 0;
    if (((const char*)s.ptr)[0] == '-') {
        sign = -1;
        i = 1;
        if (s.len == 1) return cc_err(CC_ERROR(CC_ERR_PARSE, "bad integer"));
    }

    uint64_t value = 0;
    uint64_t limit = (uint64_t)INT64_MAX;
    if (sign < 0) limit += 1;
    for (; i < s.len; ++i) {
        char ch = ((const char*)s.ptr)[i];
        if (ch < '0' || ch > '9') {
            return cc_err(CC_ERROR(CC_ERR_PARSE, "bad integer"));
        }
        uint64_t digit = (uint64_t)(ch - '0');
        if (value > limit / 10 ||
            (value == limit / 10 && digit > (limit % 10))) {
            return cc_err(CC_ERROR(CC_ERR_INVALID_ARG, "ERR value is not an integer or out of range"));
        }
        value = value * 10 + digit;
    }
    if (sign < 0) {
        if (value == (uint64_t)INT64_MAX + 1) return cc_ok(INT64_MIN);
        return cc_ok(-(int64_t)value);
    }
    return cc_ok((int64_t)value);
}

static size_t u64_decimal_len(uint64_t value) {
    size_t len = 1;
    while (value >= 10) {
        value /= 10;
        len++;
    }
    return len;
}

static size_t resp_integer_encoded_len(int64_t value) {
    uint64_t mag = (value < 0) ? ((uint64_t)(-(value + 1)) + 1) : (uint64_t)value;
    return 1 + (value < 0 ? 1 : 0) + u64_decimal_len(mag) + 2;
}

static size_t resp_bulk_header_len(size_t value_len) {
    return 1 + u64_decimal_len((uint64_t)value_len) + 2;
}

static size_t i64_decimal_len(int64_t value) {
    uint64_t mag = (value < 0) ? ((uint64_t)(-(value + 1)) + 1) : (uint64_t)value;
    return (value < 0 ? 1 : 0) + u64_decimal_len(mag);
}

static void encode_i64_decimal_into(char* dst, int64_t value) {
    uint64_t mag = (value < 0) ? ((uint64_t)(-(value + 1)) + 1) : (uint64_t)value;
    size_t pos = i64_decimal_len(value);
    if (value < 0) dst[0] = '-';
    do {
        dst[--pos] = (char)('0' + (mag % 10));
        mag /= 10;
    } while (mag != 0);
}

static void resp_encode_integer_into(char* dst, int64_t value) {
    uint64_t mag = (value < 0) ? ((uint64_t)(-(value + 1)) + 1) : (uint64_t)value;
    size_t digit_len = u64_decimal_len(mag);
    size_t pos = 1 + (value < 0 ? 1 : 0) + digit_len;
    dst[0] = ':';
    if (value < 0) dst[1] = '-';
    dst[pos] = '\r';
    dst[pos + 1] = '\n';
    do {
        dst[--pos] = (char)('0' + (mag % 10));
        mag /= 10;
    } while (mag != 0);
}

static void resp_encode_bulk_header_into(char* dst, size_t value_len) {
    uint64_t mag = (uint64_t)value_len;
    size_t digit_len = u64_decimal_len(mag);
    size_t pos = 1 + digit_len;
    dst[0] = '$';
    dst[1 + digit_len] = '\r';
    dst[2 + digit_len] = '\n';
    do {
        dst[--pos] = (char)('0' + (mag % 10));
        mag /= 10;
    } while (mag != 0);
}

#include "redis_resp.cch"

/* ---- @grammar RESP reader (the ONLY reader: the hand-rolled one is
 * retired from the server and lives on solely as the parity oracle in
 * tests/redis_resp_gen_parity_smoke.ccs) ----
 * The schema IS the protocol description; parity with the hand reader is
 * pinned by tests/redis_resp_gen_parity_smoke.ccs. The command is a tagged
 * union: '*' dispatches the framed arm, anything else is the inline-command
 * DEFAULT arm. cap 4 = the server's own "unsupported argument count"
 * policy, as an inline array: the parse hot path allocates nothing (the
 * arena parameter of try_read is unused by a fully capped schema).
 *
 * Known divergence from the hand reader (documented, pathological input
 * only): an inline line with a lone CR or LF inside it ("AB\nCD\r\n") is a
 * parse error here but accepted by rr_try_read_line's \r\n pair scan. */
@grammar(schema) RespGArg {~~~~
    rules [
        digit:  charset [#'0' - #'9']
        number: keep [opt #'-' some digit]
    ]
    #'$' len: int number "\r\n"
    data: bytes len
    "\r\n"
~~~~}

@grammar(schema) RespGCmd {~~~~
    rules [
        digit:  charset [#'0' - #'9']
        number: keep [opt #'-' some digit]
        lchar:  complement charset [#'\r' #'\n']
        line:   keep [any lchar]
    ]
    one of [
        framed [ #'*' argc: int number "\r\n" args: items RespGArg argc cap 4 ]
        plain  [ text: line "\r\n" ]
    ]
~~~~}

static RespParseStatus gen_try_read_args_buffered(RespReader* r,
                                                  CCSlice* args,
                                                  size_t cap,
                                                  size_t* out_argc,
                                                  CCError* err) {
    size_t pos = 0;
    RespGCmd c;
    bool !>(CCError) tr = RespGCmd_try_read((const char*)(r->data + r->start),
                                            r->end - r->start, &pos, NULL, &c);
    if (tr.is_err()) {
        if (tr.error().kind == CC_ERR_WOULD_BLOCK) return RESP_PARSE_INCOMPLETE;
        *err = tr.error();
        return RESP_PARSE_ERROR;
    }
    if (!tr.value()) return RESP_PARSE_INCOMPLETE;
    if (c.kind == RespGCmd_plain) {
        /* whitespace tokenization stays with the hand helper: it is server
         * policy (arg splitting), not wire framing */
        size_t !>(CCError) pargs = parse_inline_args(c.u.plain.text, args, cap);
        if (pargs.is_err()) { *err = pargs.error(); return RESP_PARSE_ERROR; }
        *out_argc = pargs.value();
        r->start += pos;
        return RESP_PARSE_OK;
    }
    if (c.u.framed.args_n < 1 || c.u.framed.args_n > cap) {
        *err = CC_ERROR(CC_ERR_PARSE, "unsupported argument count");
        return RESP_PARSE_ERROR;
    }
    for (size_t i = 0; i < c.u.framed.args_n; i++) args[i] = c.u.framed.args[i].data;
    *out_argc = c.u.framed.args_n;
    r->start += pos;
    return RESP_PARSE_OK;
}

static RedisCommandKind cmd_kind(char[:] cmd, size_t argc) {
    if (slice_eq_ignore_case(cmd, "PING") && argc <= 1) return REDIS_CMD_PING;
    if (slice_eq_ignore_case(cmd, "GET") && argc == 1) return REDIS_CMD_GET;
    if (slice_eq_ignore_case(cmd, "SET") && argc == 2) return REDIS_CMD_SET;
    if (slice_eq_ignore_case(cmd, "DEL") && argc == 1) return REDIS_CMD_DEL;
    if (slice_eq_ignore_case(cmd, "INCR") && argc == 1) return REDIS_CMD_INCR;
    if (slice_eq_ignore_case(cmd, "CC.MEMLOG") && argc == 0) return REDIS_CMD_CC_MEMLOG;
    return (RedisCommandKind)-1;
}

/* Initialize only the fields read for each reply kind; avoid whole-struct
 * zeroing on the GET/SET/INCR hot path. */
static RedisReply reply_simple(const char* s) {
    RedisReply r;
    r.kind = REDIS_REPLY_SIMPLE_STRING;
    r.data = cc_slice_from_cstr(s);
    return r;
}

static RedisReply reply_error(const char* s) {
    RedisReply r;
    r.kind = REDIS_REPLY_ERROR;
    r.data = cc_slice_from_cstr(s);
    return r;
}

static RedisReply err_reply(CCError err) {
    return reply_error(err.message ? err.message : "ERR internal error");
}

static RedisReply io_err_reply(CCIoError err) {
    return reply_error(cc_io_error_str(err));
}

static RedisReply reply_bulk(CCSlice s) {
    RedisReply r;
    r.kind = REDIS_REPLY_BULK_STRING;
    r.data = s;
    return r;
}

static RedisReply reply_null(void) {
    RedisReply r;
    r.kind = REDIS_REPLY_NULL_BULK;
    r.data = cc_slice_empty();
    return r;
}

static RedisReply reply_integer(int64_t v) {
    RedisReply r;
    r.kind = REDIS_REPLY_INTEGER;
    r.int_value = v;
    r.data = cc_slice_empty();
    return r;
}

static RedisReply reply_raw(char[:0] s) {
    RedisReply r;
    r.kind = REDIS_REPLY_RAW;
    r.data = s;
    return r;
}

static char[:0] config_get_reply(char[:] key) {
    if (slice_eq_ignore_case(key, "save")) {
        return @slice("*2\r\n$4\r\nsave\r\n$0\r\n\r\n");
    }
    if (slice_eq_ignore_case(key, "appendonly")) {
        return @slice("*2\r\n$10\r\nappendonly\r\n$2\r\nno\r\n");
    }
    return @slice("*0\r\n");
}

static bool !>(CCError) decode_request_shape(CCSlice* args,
                                             size_t argc,
                                             RedisCommandKind* out_kind,
                                             size_t* out_arg_start,
                                             size_t* out_argc) {
    if (argc < 1) return cc_err(CC_ERROR(CC_ERR_PARSE, "empty command"));

    if (slice_eq_ignore_case(args[0], "CONFIG")) {
        if (argc != 3 || !slice_eq_ignore_case(args[1], "GET")) {
            return cc_err(CC_ERROR(CC_ERR_INVALID_ARG, "ERR unsupported command"));
        }
        *out_kind = REDIS_CMD_CONFIG_GET;
        *out_arg_start = 2;
        *out_argc = 1;
        return cc_ok(true);
    }

    RedisCommandKind kind = cmd_kind(args[0], argc - 1);
    if ((int)kind < 0) {
        return cc_err(CC_ERROR(CC_ERR_INVALID_ARG, "ERR unsupported command"));
    }

    *out_kind = kind;
    *out_arg_start = 1;
    *out_argc = argc - 1;
    return cc_ok(true);
}

/* Non-blocking iterator over pipelined requests in the buffered
 * reader.  rr_req_iter_next yields:
 *   ok(true), *out = req  → req is handed to the owner, which returns
 *                           the slot before queueing the reply.
 *   ok(false)             → buffered bytes exhausted mid-message;
 *                           caller must rr_fill and retry.
 *   err(e)                → parse or allocation error; pool slot
 *                           already returned.
 *
 * Borrows `reader` and `conn`; must nest inside their lifetimes. */
typedef struct ReqIter {
    RespReader* reader;
    RedisConn* conn;
} ReqIter;

typedef struct RedisRequestSlot {
    RedisConn* conn;
    RedisRequest* req;
} RedisRequestSlot;

@noblock static ReqIter rr_req_iter(RespReader* reader, RedisConn* conn) {
    ReqIter it = { .reader = reader, .conn = conn };
    return it;
}

static void redis_request_slot_release(RedisRequestSlot* slot) {
    if (!slot || !slot->req) return;
    redis_conn_release_slot(slot->conn, slot->req);
    slot->conn = NULL;
    slot->req = NULL;
}

static RedisRequest* redis_request_slot_commit(RedisRequestSlot* slot) {
    if (!slot || !slot->conn || !slot->req) return NULL;
    RedisRequest* req = slot->req;
    /* Commit: req BORROWS conn.  The borrow is sound structurally: the
     * owner returns the slot before queueing the reply, and the client
     * drains every accepted request's reply before destroying the conn
     * (handle_client @destroy), so conn strictly outlives the request. */
    req->conn = slot->conn;
    slot->conn = NULL;
    slot->req = NULL;
    return req;
}

static RedisRequestSlot !>(CCError) redis_conn_request_slot(RedisConn* conn) {
    /* The pool slot IS a RedisRequest; req->arena wraps the trailing
     * req->argv_buf for argv clones (heap-spills on overflow). */
    RedisRequest* req = (RedisRequest*)cc_arena_pool_alloc(&conn->req_pool);
    if (!req) {
        return cc_err(CC_ERROR(CC_ERR_OUT_OF_MEMORY, "request slot pool exhausted"));
    }
    /* No full-struct memset: sizeof(RedisRequest) is ~450 B (dominated
     * by the 368-byte argv_buf scratch) and zeroing it per-request
     * showed up as a hot leaf in GET profiling.  All fields we read
     * downstream are written explicitly below; argv_buf is just the
     * arena's backing store so uninitialized bytes are fine. */
    req->arena = cc_arena_create_buffer(req->argv_buf,
                                        sizeof(req->argv_buf),
                                        CC_ARENA_GROWABLE);
    if (!cc_arena_valid(&req->arena)) {
        cc_arena_pool_free(&conn->req_pool, req);
        return cc_err(CC_ERROR(CC_ERR_OUT_OF_MEMORY, "request arena init failed"));
    }
    return cc_ok((RedisRequestSlot){ .conn = conn, .req = req });
}

static bool !>(CCError) rr_req_iter_next(ReqIter* it, RedisRequest** out) {
    RedisConn* conn = it->conn;
    @errhandler(CCError e) { return cc_err(e); }
    RedisRequestSlot slot = redis_conn_request_slot(conn) !>;
    @defer redis_request_slot_release(&slot);
    RedisRequest* req = slot.req;

    CCSlice args[4] = {0};
    size_t argc = 0;
    CCError perr = {0};
    RespParseStatus argc_status = gen_try_read_args_buffered(it->reader, args, 4, &argc, &perr);
    if (argc_status == RESP_PARSE_INCOMPLETE) {
        return cc_ok(false);
    }
    if (argc_status == RESP_PARSE_ERROR) return cc_err(perr);

    RedisCommandKind kind = REDIS_CMD_PING;
    size_t arg_start = 0;
    size_t req_argc = 0;
    decode_request_shape(args, argc, &kind, &arg_start, &req_argc) !>(e) { return cc_err(e); };

    req->conn_id = conn->conn_id;
    req->request_id = conn->next_request_id;
    req->kind = kind;
    req->argc = req_argc;
    for (size_t i = 0; i < req_argc; ++i) {
        req->argv[i] = cc_slice_clone(&req->arena, args[arg_start + i]);
        if (args[arg_start + i].len > 0 && !req->argv[i].ptr) {
            return cc_err(CC_ERROR(CC_ERR_OUT_OF_MEMORY, "request argument clone failed"));
        }
    }

    *out = redis_request_slot_commit(&slot);
    return cc_ok(true);
}

static size_t db_string_cap_8x(size_t len) {
    size_t need = len + 1; /* Keep room for the trailing NUL. */
    if (need < len) return 0;
    size_t rem = need & 7;
    if (rem == 0) return need;
    size_t rounded = need + (8 - rem);
    if (rounded < need) return 0;
    return rounded;
}

static size_t redis_map_live_payload_bytes(const RedisDbMap* map) {
    return RedisDbMap_live_bytes(map);
}

static void db_mem_stats_note_key_alloc(size_t bytes) {
    g_db_mem_stats.key_alloc_count++;
    g_db_mem_stats.key_alloc_bytes += bytes;
}

static void db_mem_stats_note_key_release(size_t bytes) {
    g_db_mem_stats.key_release_count++;
    g_db_mem_stats.key_release_bytes += bytes;
}

static void db_mem_stats_note_value_alloc(size_t bytes) {
    g_db_mem_stats.value_alloc_count++;
    g_db_mem_stats.value_alloc_bytes += bytes;
}

static void db_mem_stats_note_value_release(size_t bytes) {
    g_db_mem_stats.value_release_count++;
    g_db_mem_stats.value_release_bytes += bytes;
}

static void db_dump_mem_stats(RedisDb* db, const char* tag);

static size_t redis_mem_worker_hint(void) {
    const char* s = getenv("CC_WORKERS");
    size_t w;
    if (s && s[0]) {
        char* end = NULL;
        unsigned long n = strtoul(s, &end, 10);
        if (end != s && (!end || *end == 0) && n > 0 && n < 4096) return (size_t)n;
    }
    w = cc_sched_get_num_workers();
    if (w > 0) return w;
    {
        long n = sysconf(_SC_NPROCESSORS_ONLN);
        if (n > 0) return (size_t)n;
    }
    return 1;
}

/* Mach / map summary to stderr (no getenv gate).  Caller may follow with db_dump_mem_stats for arena slab lines. */
static void redis_mem_report_impl(const RedisDb* db, const char* tag) {
    struct rusage ru;
    uint64_t mach_phys_footprint = 0;
    int have_mach_footprint = 0;
    memset(&ru, 0, sizeof(ru));
    if (getrusage(RUSAGE_SELF, &ru) == 0) {
        fprintf(stderr,
                "redis_idiomatic: mem[%s] getrusage maxrss=%ld (%s)\n",
                tag ? tag : "?",
                (long)ru.ru_maxrss,
#if defined(__APPLE__)
                "bytes on Darwin"
#else
                "kilobytes on Linux/most Unix"
#endif
                );
    }
#if defined(__APPLE__)
    {
        struct task_vm_info vm_info;
        mach_msg_type_number_t count = TASK_VM_INFO_COUNT;
        if (task_info(mach_task_self(), TASK_VM_INFO, (task_info_t)&vm_info, &count) ==
            KERN_SUCCESS) {
            mach_phys_footprint = (uint64_t)vm_info.phys_footprint;
            have_mach_footprint = 1;
            fprintf(stderr,
                    "redis_idiomatic: mem[%s] mach resident=%llu phys_footprint=%llu\n",
                    tag ? tag : "?",
                    (unsigned long long)vm_info.resident_size,
                    (unsigned long long)vm_info.phys_footprint);
        }
    }
#endif
    fprintf(stderr,
            "redis_idiomatic: mem[%s] worker_hint=%zu sched_workers=%zu (fiber stacks: VM reserve "
            "~2MiB each, commit on touch; see cc/runtime/fiber_sched.c MCO_USE_VMEM_ALLOCATOR)\n",
            tag ? tag : "?",
            redis_mem_worker_hint(),
            cc_sched_get_num_workers());
    if (db && db->entries) {
        size_t cap = db->entries->cap();
        size_t n = db->entries->len();
        size_t meta_off = 0;
        size_t map_alloc = 0;
        /* One contiguous Jackson map blob: header + (CCSliceHdr+CCString)/slot +
         * uint16_t metadata[cap+4].  Explains most MALLOC_LARGE under key load. */
        if (cap > 0) {
            ccj_map_allocation_details(cap,
                                       sizeof(CCSliceHdr),
                                       RedisDbMap__layout(),
                                       &meta_off,
                                       &map_alloc);
        }
        fprintf(stderr,
                "redis_idiomatic: mem[%s] map len=%zu cap=%zu ccj_map_allocation=%zu "
                "(~%.2fMiB primary table; doubles by cap until load)\n",
                tag ? tag : "?",
                n,
                cap,
                map_alloc,
                map_alloc / (1024.0 * 1024.0));
        fprintf(stderr,
                "redis_idiomatic: mem[%s] model: map/value arenas fixed root+overflow; "
                "key arena growable — large map/value allocs use heap-overflow malloc\n",
                tag ? tag : "?");
        /* Same logical_live as db_dump_mem_stats: keys + heap values + map model bytes. */
        {
            size_t map_live = redis_map_live_payload_bytes(db->entries);
            size_t key_live = g_db_mem_stats.key_alloc_bytes - g_db_mem_stats.key_release_bytes;
            size_t value_live = g_db_mem_stats.value_alloc_bytes - g_db_mem_stats.value_release_bytes;
            size_t logical_live = key_live + value_live + map_live;
            if (have_mach_footprint) {
                if (logical_live > 0) {
                    double ratio = (double)mach_phys_footprint / (double)logical_live;
                    int64_t gap = (int64_t)mach_phys_footprint - (int64_t)logical_live;
                    fprintf(stderr,
                            "redis_idiomatic: mem[%s] accounting: mach_phys_footprint=%llu B "
                            "logical_db_live=%zu B (ratio %.1fx; gap=%lld B ≈ runtime+fibers+libc; "
                            "current_map_blob=%zu B)\n",
                            tag ? tag : "?",
                            (unsigned long long)mach_phys_footprint,
                            logical_live,
                            ratio,
                            (long long)gap,
                            map_alloc);
                } else {
                    fprintf(stderr,
                            "redis_idiomatic: mem[%s] accounting: mach_phys_footprint=%llu B logical_db_live=0 "
                            "(empty db; ccj_map_blob=%zu B)\n",
                            tag ? tag : "?",
                            (unsigned long long)mach_phys_footprint,
                            map_alloc);
                }
            }
        }
    }
}

/* Set CC_REDIS_MEM_REPORT=1 to print Mach + map summary and db_dump_mem_stats at owner startup. */
static void redis_mem_report(const RedisDb* db, const char* tag) {
    const char* want = getenv("CC_REDIS_MEM_REPORT");
    if (!want || !want[0]) return;
    redis_mem_report_impl(db, tag);
    if (db && db->entries) {
        db_dump_mem_stats((RedisDb*)(void*)db, tag);
    }
}

/* Print each bump slab's capacity for `a`, newest (current root) first, then each
 * older extent via ->prev.  Matches cc_arena_slab_chain_bytes (sum of these). */
static void redis_db_fprint_arena_slab_chain_detail(const char* tag, const char* pool, const CCArena* a) {
    const CCArena* cur = a;
    fprintf(stderr, "redis_idiomatic: mem[%s] arena_%s_slab_sizes_B (root_first", tag ? tag : "db", pool);
    while (cur && cur->base) {
        fprintf(stderr, " %zu", cur->capacity);
        cur = cur->prev;
    }
    fprintf(stderr, ") sum=%zu\n", cc_arena_slab_chain_bytes(a));
}

static void db_dump_mem_stats(RedisDb* db, const char* tag) {
    size_t map_live = db ? redis_map_live_payload_bytes(db->entries) : 0;
    size_t key_live = g_db_mem_stats.key_alloc_bytes - g_db_mem_stats.key_release_bytes;
    size_t value_live = g_db_mem_stats.value_alloc_bytes - g_db_mem_stats.value_release_bytes;
    size_t map_count = (db && db->entries) ? db->entries->len() : 0;
    size_t map_buckets = (db && db->entries) ? db->entries->cap() : 0;
    fprintf(stderr,
            "redis_idiomatic: mem[%s] entries=%zu buckets=%zu keys allocs=%zu bytes=%zu live=%zu | "
            "values allocs=%zu bytes=%zu live=%zu | map_live=%zu | total_live=%zu\n",
            tag ? tag : "db",
            map_count,
            map_buckets,
            g_db_mem_stats.key_alloc_count,
            g_db_mem_stats.key_alloc_bytes,
            key_live,
            g_db_mem_stats.value_alloc_count,
            g_db_mem_stats.value_alloc_bytes,
            value_live,
            map_live,
            key_live + value_live + map_live);
    if (db) {
        /* Arena roots (B): must match db_init() map/value heap root and key root. */
        fprintf(stderr,
                "redis_idiomatic: mem[%s] arena_initial_root_B map=%u(heap_overflow) key=%u(growable) value=%u(heap_overflow)\n",
                tag ? tag : "db",
                1024u,
                4096u,
                1024u);
        redis_db_fprint_arena_slab_chain_detail(tag, "map", &db->map_arena);
        redis_db_fprint_arena_slab_chain_detail(tag, "key", &db->key_arena);
        redis_db_fprint_arena_slab_chain_detail(tag, "value", &db->value_arena);
        size_t m_slab = cc_arena_slab_chain_bytes(&db->map_arena);
        size_t m_ovf = cc_arena_overflow_raw_bytes(&db->map_arena);
        size_t m_ext = cc_arena_extent_struct_bytes(&db->map_arena);
        size_t m_gross = cc_arena_committed_gross_bytes(&db->map_arena);
        size_t k_slab = cc_arena_slab_chain_bytes(&db->key_arena);
        size_t k_ovf = cc_arena_overflow_raw_bytes(&db->key_arena);
        size_t k_ext = cc_arena_extent_struct_bytes(&db->key_arena);
        size_t k_gross = cc_arena_committed_gross_bytes(&db->key_arena);
        size_t v_slab = cc_arena_slab_chain_bytes(&db->value_arena);
        size_t v_ovf = cc_arena_overflow_raw_bytes(&db->value_arena);
        size_t v_ext = cc_arena_extent_struct_bytes(&db->value_arena);
        size_t v_gross = cc_arena_committed_gross_bytes(&db->value_arena);
        fprintf(stderr,
                "redis_idiomatic: mem[%s] arena_committed_B "
                "map slabs=%zu ovf=%zu ext_meta=%zu gross=%zu | "
                "key slabs=%zu ovf=%zu ext_meta=%zu gross=%zu | "
                "value slabs=%zu ovf=%zu ext_meta=%zu gross=%zu | "
                "db_arenas_gross_sum=%zu\n",
                tag ? tag : "db",
                m_slab,
                m_ovf,
                m_ext,
                m_gross,
                k_slab,
                k_ovf,
                k_ext,
                k_gross,
                v_slab,
                v_ovf,
                v_ext,
                v_gross,
                m_gross + k_gross + v_gross);
    }
}

static CCString !>(CCError) db_clone_value_into_arena(CCArena* arena,
                                                      char[:] src,
                                                      const char* err_msg) {
    size_t cap = db_string_cap_8x(src.len);
    if (cap == 0) return cc_err(CC_ERROR(CC_ERR_OUT_OF_MEMORY, err_msg));
    CCString cloned = cc_string_new();
    if (!cloned.reserve(cap, arena)) {
        return cc_err(CC_ERROR(CC_ERR_OUT_OF_MEMORY, err_msg));
    }
    if (cloned.push_slice(src, arena) == NULL) {
        return cc_err(CC_ERROR(CC_ERR_OUT_OF_MEMORY, err_msg));
    }
    if (cloned.heap_data()) db_mem_stats_note_value_alloc(cloned.cap());
    return cc_ok(cloned);
}

static bool db_init_overflow_arena(CCArena* a, size_t root_bytes) {
    *a = cc_arena_heap(root_bytes);
    if (!a->valid()) return false;
    a->block_max = 1;
    if (!cc_arena_set_heap_overflow(a, true)) {
        a->destroy();
        return false;
    }
    return true;
}

static void db_free_arenas_only(RedisDb* db) {
    if (!db) return;
    db->map_arena.destroy();
    db->key_arena.destroy();
    db->value_arena.destroy();
}

static bool db_init(RedisDb* db, size_t bucket_count) {
    if (!db || bucket_count == 0) return false;
    const size_t map_value_heap_root = 1024;
    const size_t key_arena_root = 4096;
    if (!db_init_overflow_arena(&db->map_arena, map_value_heap_root)) return false;
    db->key_arena = cc_arena_heap(key_arena_root);
    if (!db->key_arena.valid()) {
        db_free_arenas_only(db);
        return false;
    }
    if (!db_init_overflow_arena(&db->value_arena, map_value_heap_root)) {
        db_free_arenas_only(db);
        return false;
    }
    db->entries = RedisDbMap_init_count(&db->map_arena, bucket_count);
    if (!db->entries) {
        db_free_arenas_only(db);
        return false;
    }
    return true;
}

static void db_release_value(RedisDb* db, CCString* value) {
    if (!db || !value) return;
    if (value->heap_data()) {
        db_mem_stats_note_value_release(value->cap());
    }
    value->release(&db->value_arena);
}

/* Replace path.  In-place overwrite when the new value fits the old
 * capacity — the happy case for same-length INCR or constant-width
 * SET benchmarks.  Growing values clone a replacement into db->value_arena
 * and release the superseded buffer. */
static void !>(CCError) db_value_replace(RedisDb* db, CCString* cell, char[:] value) {
    @errhandler(CCError e) { return cc_err(e); }
    if (!cell) return cc_err(CC_ERROR(CC_ERR_INVALID_ARG, "db replace without entry"));
    if (value.len + 1 <= cell->cap()) {
        if (!cell->clear()) {
            return cc_err(CC_ERROR(CC_ERR_OUT_OF_MEMORY, "entry value clear failed"));
        }
        if (!cell->push_slice(value, &db->value_arena)) {
            return cc_err(CC_ERROR(CC_ERR_OUT_OF_MEMORY, "entry value replace failed"));
        }
        return cc_ok();
    }
    CCString replacement =
        db_clone_value_into_arena(&db->value_arena, value, "entry value clone failed") !>;
    db_release_value(db, cell);
    *cell = replacement;
    return cc_ok();
}

static CCString* db_find_value(RedisDb* db, char[:] key) {
    if (!db || !db->entries) return NULL;
    CCSliceHdr kh = db_key_hdr_view(key);
    return db->entries->get_ptr(kh);
}

static CCSliceHdr !>(CCError) db_clone_key_hdr(RedisDb* db, char[:] key) {
    @errhandler(CCError e) { return cc_err(e); }
    if (!db) return cc_err(CC_ERROR(CC_ERR_INVALID_ARG, "db key clone without db"));
    CCSliceHdr view = db_key_hdr_view(key);
    CCSliceHdr stable = cc_slice_hdr_clone_into(&view, &db->key_arena) !>;
    return cc_ok(stable);
}

static void !>(CCError) db_insert_value(RedisDb* db, CCSliceHdr owned_key, CCString value) {
    if (!db || !db->entries) {
        return cc_err(CC_ERROR(CC_ERR_INVALID_ARG, "db insert without entry"));
    }
    if (db->entries->insert(owned_key, value) != 0) {
        return cc_err(CC_ERROR(CC_ERR_OUT_OF_MEMORY, "db insert failed"));
    }
    return cc_ok();
}

static RedisReply !>(CCError) db_set(RedisDb* db, char[:] key, char[:] value) {
    @errhandler(CCError e) { return cc_err(e); }
    if (!db || !db->entries) return cc_err(CC_ERROR(CC_ERR_OUT_OF_MEMORY, "db lookup failed"));

    CCString* cell = db_find_value(db, key);
    if (cell) {
        db_value_replace(db, cell, value) !>;
        return cc_ok(reply_simple("OK"));
    }

    CCSliceHdr owned_key = db_clone_key_hdr(db, key) !>;
    CCString owned_value =
        db_clone_value_into_arena(&db->value_arena, value, "entry value clone failed") !>;

    db_insert_value(db, owned_key, owned_value) !>(e) {
        db_release_value(db, &owned_value);
        return cc_err(e);
    };
    db_mem_stats_note_key_alloc(key.len);
    return cc_ok(reply_simple("OK"));
}

static RedisReply db_get(RedisDb* db, char[:] key) {
    CCString* cell = db_find_value(db, key);
    if (!cell) return reply_null();
    return reply_bulk(cell->as_slice());
}

static RedisReply db_del(RedisDb* db, char[:] key) {
    if (!db || !db->entries) return reply_integer(0);

    CCString* cell = db_find_value(db, key);
    if (!cell) return reply_integer(0);
    CCString doomed = *cell;
    CCSliceHdr kh = db_key_hdr_view(key);
    if (!db->entries->del(kh)) return reply_integer(0);
    db_mem_stats_note_key_release(key.len);
    db_release_value(db, &doomed);
    return reply_integer(1);
}

static RedisReply !>(CCError) db_incr(RedisDb* db, char[:] key) {
    @errhandler(CCError e) { return cc_err(e); }
    if (!db || !db->entries) return cc_err(CC_ERROR(CC_ERR_OUT_OF_MEMORY, "db lookup failed"));

    CCString* cell = db_find_value(db, key);

    int64_t value = 1;
    if (cell) {
        int64_t parsed = parse_i64(cell->as_slice()) !> {
            return cc_err(CC_ERROR(CC_ERR_INVALID_ARG, "ERR value is not an integer or out of range"));
        };
        if (parsed == INT64_MAX) {
            return cc_err(CC_ERROR(CC_ERR_INVALID_ARG, "ERR value is not an integer or out of range"));
        }
        value = parsed + 1;
    }

    char buf[32];
    size_t encoded_len = i64_decimal_len(value);
    encode_i64_decimal_into(buf, value);
    char[:] encoded = cc_slice_from_buffer(buf, encoded_len);
    if (cell) {
        db_value_replace(db, cell, encoded) !>;
    } else {
        db_set(db, key, encoded) !>;
    }

    return cc_ok(reply_integer(value));
}

static int db_preload_key_count(void) {
    const char* s = getenv("CC_REDIS_PRELOAD_KEYS");
    if (!s || !s[0]) return 0;
    char* end = NULL;
    long n = strtol(s, &end, 10);
    if (end == s || (end && *end != 0) || n <= 0) return 0;
    return (int)n;
}

static bool !>(CCError) db_preload_keys(RedisDb* db, int count) {
    @errhandler(CCError e) { return cc_err(e); }
    if (!db || count <= 0) return cc_ok(true);
    static const char preload_value[] = "0";
    for (int i = 0; i < count; ++i) {
        char key_buf[32];
        int n = snprintf(key_buf, sizeof(key_buf), "key:%d", i);
        if (n <= 0 || (size_t)n >= sizeof(key_buf)) {
            return cc_err(CC_ERROR(CC_ERR_INVALID_ARG, "preload key encode failed"));
        }
        db_set(db,
               cc_slice_from_buffer(key_buf, (size_t)n),
               cc_slice_from_buffer((void*)preload_value, sizeof(preload_value) - 1)) !>(e) { return cc_err(e); };
    }
    return cc_ok(true);
}

/* Owner-private dispatch.  `@noblock`: owner runs on the scheduler poll
 * thread and must not dispatch DB work to the blocking pool. */
@noblock static RedisReply !>(CCError) execute_request(RedisDb* db, RedisRequest* req) {
    switch (req->kind) {
        case REDIS_CMD_PING:
            if (req->argc == 1) return cc_ok(reply_bulk(req->argv[0]));
            return cc_ok(reply_simple("PONG"));
        case REDIS_CMD_CONFIG_GET:
            return cc_ok(reply_raw(config_get_reply(req->argv[0])));
        case REDIS_CMD_GET:
            return cc_ok(db_get(db, req->argv[0]));
        case REDIS_CMD_SET:
            return db_set(db, req->argv[0], req->argv[1]);
        case REDIS_CMD_DEL:
            return cc_ok(db_del(db, req->argv[0]));
        case REDIS_CMD_INCR:
            return db_incr(db, req->argv[0]);
        case REDIS_CMD_CC_MEMLOG:
            /* After redis-benchmark: arena slab lines + Mach/logical accounting on stderr. */
            db_dump_mem_stats(db, "cc-memlog");
            redis_mem_report_impl(db, "cc-memlog");
            return cc_ok(reply_simple("OK"));
        default:
            return cc_err(CC_ERROR(CC_ERR_INVALID_ARG, "ERR unsupported command"));
    }
}

static void db_free_all(RedisDb* db) {
    if (!db) return;
    if (db->entries) {
        RedisDbMap_destroy(db->entries);
        db->entries = NULL;
    }
    db_free_arenas_only(db);
}

static bool write_all(CCSocket* sock, CCSlice data) {
    CCNetError err = CC_NET_OK;
    size_t off = 0;
    const int write_deadline_ms = 1000;
    CCDeadline deadline = cc_deadline_after_ms(write_deadline_ms);
    while (off < data.len) {
        size_t n = cc_socket_write_deadline(sock,
                                            (const char*)data.ptr + off,
                                            data.len - off,
                                            &err,
                                            &deadline);
        if (err != CC_NET_OK || n == 0) return false;
        off += n;
    }
    return true;
}

static bool redis_conn_flush_out(RedisConn* conn) {
    if (!conn || conn->out_len == 0) return true;
    CCSlice data = {
        .ptr = conn->out_buf,
        .len = conn->out_len,
    };
    conn->out_len = 0;
    return write_all(conn->sock, data);
}

static bool redis_conn_write_bytes(RedisConn* conn, CCSlice data) {
    if (!conn || data.len == 0) return true;
    if (data.len > redis_conn_out_buf_bytes) {
        return conn->flush_out() && write_all(conn->sock, data);
    }
    if (conn->out_len + data.len > redis_conn_out_buf_bytes) {
        if (!conn->flush_out()) return false;
    }
    memcpy(conn->out_buf + conn->out_len, data.ptr, data.len);
    conn->out_len += data.len;
    return true;
}

static char* redis_conn_reserve_out(RedisConn* conn, size_t n) {
    if (!conn || n == 0 || n > redis_conn_out_buf_bytes) return NULL;
    if (conn->out_len + n > redis_conn_out_buf_bytes) {
        if (!conn->flush_out()) return NULL;
    }
    char* dst = conn->out_buf + conn->out_len;
    conn->out_len += n;
    return dst;
}

static bool redis_conn_write_reply(RedisConn* conn, const RedisReply* reply) {
    if (!reply) return false;
    switch (reply->kind) {
        case REDIS_REPLY_RAW:
            return conn->write_bytes(reply->data);
        case REDIS_REPLY_SIMPLE_STRING:
        case REDIS_REPLY_ERROR: {
            size_t n = reply->data.len + 3;
            char* dst = conn->reserve_out(n);
            if (!dst) {
                char prefix = (reply->kind == REDIS_REPLY_SIMPLE_STRING) ? '+' : '-';
                CCSlice pfx = cc_slice_from_buffer(&prefix, 1);
                CCSlice crlf = cc_slice_from_cstr("\r\n");
                return conn->write_bytes(pfx) &&
                       conn->write_bytes(reply->data) &&
                       conn->write_bytes(crlf);
            }
            dst[0] = (reply->kind == REDIS_REPLY_SIMPLE_STRING) ? '+' : '-';
            if (reply->data.len > 0) memcpy(dst + 1, reply->data.ptr, reply->data.len);
            dst[n - 2] = '\r';
            dst[n - 1] = '\n';
            return true;
        }
        case REDIS_REPLY_BULK_STRING: {
            size_t hdr_len = resp_bulk_header_len(reply->data.len);
            size_t n = hdr_len + reply->data.len + 2;
            char* dst = conn->reserve_out(n);
            if (!dst) {
                char hdr[32];
                resp_encode_bulk_header_into(hdr, reply->data.len);
                CCSlice hdr_s = cc_slice_from_buffer(hdr, hdr_len);
                CCSlice crlf = cc_slice_from_cstr("\r\n");
                return conn->write_bytes(hdr_s) &&
                       conn->write_bytes(reply->data) &&
                       conn->write_bytes(crlf);
            }
            resp_encode_bulk_header_into(dst, reply->data.len);
            if (reply->data.len > 0) memcpy(dst + hdr_len, reply->data.ptr, reply->data.len);
            dst[n - 2] = '\r';
            dst[n - 1] = '\n';
            return true;
        }
        case REDIS_REPLY_INTEGER: {
            size_t n = resp_integer_encoded_len(reply->int_value);
            char* dst = conn->reserve_out(n);
            if (dst) {
                resp_encode_integer_into(dst, reply->int_value);
                return true;
            }
            char buf[32];
            resp_encode_integer_into(buf, reply->int_value);
            return conn->write_bytes(cc_slice_from_buffer(buf, n));
        }
        case REDIS_REPLY_NULL_BULK: {
            char* dst = conn->reserve_out(5);
            if (dst) {
                memcpy(dst, "$-1\r\n", 5);
                return true;
            }
            return conn->write_bytes(cc_slice_from_cstr("$-1\r\n"));
        }
        default:
            return false;
    }
}

/* Reply bytes allocated here live until the client drains or tears down the
 * current pipeline batch and resets conn->reply_arena. */
@noblock static CCSlice !>(CCError) reply_batch_alloc_slice(CCArena* reply_batch_arena, size_t n) {
    CCSlice s = cc_arena_alloc_slice_bytes(reply_batch_arena, n);
    if (n > 0 && !s.ptr) return cc_err(CC_ERROR(CC_ERR_OUT_OF_MEMORY, "reply encode OOM"));
    return cc_ok(s);
}

@noblock static bool !>(CCError) reply_encode_into_batch_arena(RedisReply* reply,
                                                               CCArena* reply_batch_arena) {
    if (!reply || !reply_batch_arena) {
        return cc_err(CC_ERROR(CC_ERR_INVALID_ARG, "reply encode batch null arg"));
    }
    @errhandler(CCError e) { return cc_err(e); }

    switch (reply->kind) {
        case REDIS_REPLY_RAW: {
            CCSlice stable = reply_batch_alloc_slice(reply_batch_arena, reply->data.len) !>;
            char* dst = (char*)stable.ptr;
            if (reply->data.len > 0) memcpy(dst, reply->data.ptr, reply->data.len);
            reply->data = stable;
            return cc_ok(true);
        }
        case REDIS_REPLY_SIMPLE_STRING:
        case REDIS_REPLY_ERROR: {
            size_t n = reply->data.len + 3;
            CCSlice stable = reply_batch_alloc_slice(reply_batch_arena, n) !>;
            char* dst = (char*)stable.ptr;
            dst[0] = (reply->kind == REDIS_REPLY_SIMPLE_STRING) ? '+' : '-';
            if (reply->data.len > 0) memcpy(dst + 1, reply->data.ptr, reply->data.len);
            dst[n - 2] = '\r';
            dst[n - 1] = '\n';
            reply->kind = REDIS_REPLY_RAW;
            reply->data = stable;
            return cc_ok(true);
        }
        case REDIS_REPLY_BULK_STRING: {
            size_t hdr = resp_bulk_header_len(reply->data.len);
            size_t n = hdr + reply->data.len + 2;
            CCSlice stable = reply_batch_alloc_slice(reply_batch_arena, n) !>;
            char* dst = (char*)stable.ptr;
            resp_encode_bulk_header_into(dst, reply->data.len);
            if (reply->data.len > 0) memcpy(dst + hdr, reply->data.ptr, reply->data.len);
            dst[n - 2] = '\r';
            dst[n - 1] = '\n';
            reply->kind = REDIS_REPLY_RAW;
            reply->data = stable;
            return cc_ok(true);
        }
        case REDIS_REPLY_INTEGER: {
            size_t n = resp_integer_encoded_len(reply->int_value);
            CCSlice stable = reply_batch_alloc_slice(reply_batch_arena, n) !>;
            char* dst = (char*)stable.ptr;
            resp_encode_integer_into(dst, reply->int_value);
            reply->kind = REDIS_REPLY_RAW;
            reply->data = stable;
            return cc_ok(true);
        }
        case REDIS_REPLY_NULL_BULK: {
            CCSlice src = cc_slice_from_cstr("$-1\r\n");
            CCSlice stable = reply_batch_alloc_slice(reply_batch_arena, src.len) !>;
            char* dst = (char*)stable.ptr;
            memcpy(dst, src.ptr, src.len);
            reply->kind = REDIS_REPLY_RAW;
            reply->data = stable;
            return cc_ok(true);
        }
        default:
            return cc_err(CC_ERROR(CC_ERR_INVALID_ARG, "unknown reply kind"));
    }
}

/* Copy only a bulk payload into batch-arena storage.  DB-backed GET can keep
 * the structured reply shape as long as its payload no longer borrows DB memory
 * across the owner-to-client channel handoff. */
@noblock static bool !>(CCError) reply_copy_bulk_payload_into_batch(RedisReply* reply,
                                                                   CCArena* reply_batch_arena) {
    if (!reply || !reply_batch_arena || reply->kind != REDIS_REPLY_BULK_STRING) {
        return cc_err(CC_ERROR(CC_ERR_INVALID_ARG, "reply copy bulk invalid arg"));
    }
    CCSlice stable = reply_batch_alloc_slice(reply_batch_arena, reply->data.len) !>;
    char* dst = (char*)stable.ptr;
    if (reply->data.len > 0) memcpy(dst, reply->data.ptr, reply->data.len);
    reply->data = stable;
    return cc_ok(true);
}

/* First reply_arena slab: enough for ~k_pipeline_reply_cap hot replies; larger
 * payloads spill to heap blocks. */
static RedisConn* redis_conn_create(uint64_t conn_id) {
    RedisConn* conn = calloc(1, sizeof(*conn));
    if (!conn) return NULL;

    ReplyTx reply_tx;
    ReplyRx reply_rx;
    CCChan* reply_ch = cc_channel_pair(&reply_tx, &reply_rx);
    if (!reply_ch) { free(conn); return NULL; }

    const size_t reply_arena_initial = 16 * 1024;
    conn->reply_arena = cc_arena_heap(reply_arena_initial);
    if (!conn->reply_arena.base) {
        cc_channel_free(reply_tx);
        free(conn);
        return NULL;
    }
    conn->reply_arena.block_max = 0;
    if (cc_arena_pool(&conn->req_pool, sizeof(RedisRequest)) != 0) {
        cc_arena_free(&conn->reply_arena);
        cc_channel_free(reply_tx);
        free(conn);
        return NULL;
    }
    conn->reply_tx = reply_tx;
    conn->reply_rx = reply_rx;
    conn->inflight = 0;
    conn->conn_id = conn_id;
    conn->next_request_id = 1;
    return conn;
}

static void redis_conn_destroy(RedisConn* conn) {
    /* Reached from handle_client's teardown AFTER the drain-to-zero in
     * its @destroy body: every accepted request's reply has been drained
     * (or the owner closed the reply channel and exited), and the owner
     * returns each slot BEFORE queueing its reply — so nothing anywhere
     * still points into this conn. */
    cc_arena_free(&conn->reply_arena);
    cc_arena_pool_destroy(&conn->req_pool);
    cc_channel_free(conn->reply_tx);
    free(conn);
}

/* One-shot error-reporting path: serialize directly into conn->out_buf
 * and flush immediately. */
static bool redis_conn_write_reply_now(RedisConn* conn, RedisReply reply) {
    return conn->write_reply(&reply) && conn->flush_out();
}

/* Return a pool slot before it's been committed to a RedisRequest
 * (i.e. before req->conn was retained).  Frees any heap spill the
 * arena grew and returns the slot to the pool; never touches
 * refcounts. */
/* @noblock: pure arena/pool bookkeeping, and it sits on the owner's
 * per-request hot path (release-before-send) — without the attribute,
 * autoblock dispatches each call to the blocking pool from the @async
 * owner loop (measured: SET throughput timer-locked at ~200k ops/s,
 * 3x down; @noblock restores parity). */
@noblock static void redis_conn_release_slot(RedisConn* conn, RedisRequest* req) {
    if (!req || !conn) return;
    cc_arena_free(&req->arena);
    cc_arena_pool_free(&conn->req_pool, req);
}

/* Teardown drain: one discarded reply per still-in-flight request (the
 * join that replaces refcounts).  Stops early only if the owner closed
 * the reply channel — it has exited and holds nothing of this conn. */
static void redis_conn_drain_inflight(RedisConn* conn) {
    RedisReply discard = {0};
    if (!conn) return;
    while (conn->inflight > 0 &&
           cc_io_avail(cc_channel_recv(conn->reply_rx, &discard))) {
        conn->inflight--;
    }
}

/* Owner-loop @defer body: return the slot only if the iteration didn't
 * already (release-before-send nulls `*req` on the success and error
 * paths; this is the backstop for early exits). */
@noblock static void owner_release_pending(RedisConn* conn, RedisRequest** req) {
    if (req && *req) {
        redis_conn_release_slot(conn, *req);
        *req = NULL;
    }
}


@noblock static inline bool redis_slice_is_stable_for_reply_batch(CCSlice data,
                                                                  CCArena* reply_batch_arena) {
    if (data.len == 0) return true;
    if (cc_slice_is_canonical(data)) return true;
    return cc_slice_is_from_arena_epoch(data, reply_batch_arena);
}

@noblock static inline bool !>(CCError) redis_reply_stabilize_for_channel(RedisReply* reply,
                                                                          CCArena* reply_batch_arena) {
    @errhandler(CCError e) { return cc_err(e); }
    if (!reply) return cc_err(CC_ERROR(CC_ERR_INVALID_ARG, "reply stabilize null"));
    /* Scalar/null replies never borrow external payload bytes. */
    if (reply->kind == REDIS_REPLY_INTEGER || reply->kind == REDIS_REPLY_NULL_BULK) {
        return cc_ok(true);
    }
    if (redis_slice_is_stable_for_reply_batch(reply->data, reply_batch_arena)) {
        return cc_ok(true);
    }
    if (reply->kind == REDIS_REPLY_BULK_STRING) {
        reply_copy_bulk_payload_into_batch(reply, reply_batch_arena) !>;
    } else {
        reply_encode_into_batch_arena(reply, reply_batch_arena) !>;
    }
    return cc_ok(true);
}

static void* redis_reply_copy_into_channel_slot(void* env, intptr_t slot, intptr_t arena) {
    (void)arena;
    RedisReply* src = (RedisReply*)env;
    RedisReply* dst = (RedisReply*)slot;
    if (src && dst) *dst = *src;
    return NULL;
}

/* Queue a finished reply into the connection's channel-owned value storage.
 * Payload bytes remain owned by conn->reply_arena, which the client resets
 * after it drains or tears down the in-flight batch. */
@noblock static inline RedisReplySendStatus redis_conn_queue_reply(RedisConn* conn, RedisReply* reply) {
    if (!conn || !reply) return REDIS_REPLY_SEND_CLOSED;
    CCClosure2 build_reply = cc_closure2_make(redis_reply_copy_into_channel_slot, reply, NULL);
    CCResult_bool_CCIoError send_res =
        cc_chan_result_with(conn->reply_tx.raw,
                            cc_channel_raw_try_send_into(conn->reply_tx.raw,
                                                         build_reply,
                                                         sizeof(RedisReply),
                                                         &conn->reply_arena),
                            false);
    if (send_res.ok && send_res.u.value) return REDIS_REPLY_SEND_QUEUED;

    if (!send_res.ok) {
        CCIoError e = send_res.u.error;
        cc_channel_close(conn->reply_tx, e);
        return REDIS_REPLY_SEND_CLOSED;
    }

    cc_channel_close(conn->reply_tx, cc_io_error(CC_IO_CONNECTION_CLOSED));
    return REDIS_REPLY_SEND_CLOSED;
}

@noblock static inline void reply_release_batch(RedisConn* conn) {
    if (!conn) return;
    /* @nonblocking: cc_arena_reset is synchronous arena bookkeeping. */
    @nonblocking { cc_arena_reset(&conn->reply_arena); }
}

/* Owner loop: drain requests, execute, reply.  `db` is stack-local so
 * it can't outlive the owner and nobody else can take its address. */
@async int owner_loop(ReqRx req_rx) {
    RedisDb db = {0};
    if (!db_init(&db, 1024)) {
        char scratch_buf[256];
        @nonblocking {
            CCArena scratch = @create(scratch_buf, sizeof(scratch_buf)) @destroy;
            CCString line = @string("redis_idiomatic: db_init failed (out of memory?)", &scratch);
            redis_diag_fprintln(&line, &scratch);
        }
        return 1;
    }
    int preload_keys = db_preload_key_count();
    if (preload_keys > 0) {
        db_preload_keys(&db, preload_keys) !> {
            /* !> handler: @create/@string breaks even inside @nonblocking. */
            fprintf(stderr, "redis_idiomatic: preload failed\n");
            return 1;
        };
        size_t preload_key_count = (size_t)preload_keys;
        {
            /* Interpolated @string in this @async body still breaks reparse;
             * literal @string under @nonblocking works (see db_init arm above). */
            char preload_msg[96];
            int preload_msg_len =
                snprintf(preload_msg, sizeof(preload_msg), "redis_idiomatic: preloaded %zu keys\n", preload_key_count);
            if (preload_msg_len > 0) {
                fwrite(preload_msg, 1, (size_t)preload_msg_len, stderr);
            }
        }
        db_dump_mem_stats(&db, "post-preload");
    }
    redis_mem_report(&db, "owner-ready");
    @defer db_free_all(&db);

    RedisRequest* req = NULL;
    while (cc_io_avail(req_rx.recv(&req))) {
        if (!req || !req->conn) continue;

        RedisConn* conn = req->conn;
        /* INVARIANT (what lets RedisConn live without refcounts): the reply
         * channel is the owner's LAST touch of a conn for each request.
         * Slot released BEFORE the reply is queued (and before any error
         * close), so once the client has drained its in-flight replies —
         * or seen the channel close — the owner provably holds nothing of
         * this conn and teardown can free it. */
        @defer owner_release_pending(conn, &req);
        @errhandler(CCError e) {
            if (req) { redis_conn_release_slot(conn, req); req = NULL; }
            cc_channel_close(conn->reply_tx, cc_io_error(e));
            return 0;
        }

        RedisReply reply = execute_request(&db, req) ?>(e) err_reply(e);
        /* Stabilize BEFORE the slot goes back: the reply may still borrow
         * req->arena bytes (e.g. PING's echo argument). */
        redis_reply_stabilize_for_channel(&reply, &conn->reply_arena) !>;
        redis_conn_release_slot(conn, req);
        req = NULL;
        RedisReplySendStatus reply_status = redis_conn_queue_reply(conn, &reply);
        if (reply_status != REDIS_REPLY_SEND_QUEUED) continue;
    }
    return 0;
}

static RedisPipelineStatus !>(CCError) submit_pipeline_batch(RedisConn* conn,
                                                            ReqTx req_tx,
                                                            ReqIter* req_iter,
                                                            RedisPipelineBatch* batch) {
    @errhandler(CCError e) { return cc_err(e); }
    if (!batch) return cc_err(CC_ERROR(CC_ERR_INVALID_ARG, "pipeline batch null"));

    batch->submitted = 0;
    batch->replies_pending = 0;
    while (redis_pipeline_batch_has_room(batch)) {
        RedisRequest* req = NULL;
        bool has = rr_req_iter_next(req_iter, &req) !>;
        if (!has) break;
        conn->next_request_id++;
        CCResult_bool_CCIoError send_res = cc_channel_send(req_tx, req);
        if (cc_is_err(send_res) || !send_res.u.value) {
            redis_conn_release_slot(conn, req);
            return cc_ok(REDIS_PIPELINE_OWNER_UNAVAILABLE);
        }
        redis_pipeline_batch_accept(batch);
        conn->inflight++;
    }

    return cc_ok(REDIS_PIPELINE_OK);
}

static RedisPipelineStatus drain_pipeline_batch(RedisConn* conn, RedisPipelineBatch* batch) {
    if (!batch) return REDIS_PIPELINE_REPLY_CLOSED;
    @defer reply_release_batch(conn);
    while (batch->replies_pending > 0) {
        RedisReply reply = {0};
        CCResult_bool_CCIoError recv_res = cc_channel_recv(conn->reply_rx, &reply);
        if (cc_is_err(recv_res) || !recv_res.u.value) return REDIS_PIPELINE_REPLY_CLOSED;
        batch->replies_pending--;
        conn->inflight--;
        if (!conn->write_reply(&reply)) return REDIS_PIPELINE_WRITE_FAILED;
    }

    /* One socket write for the whole submitted request batch. */
    if (conn->out_len > 0 && !conn->flush_out()) return REDIS_PIPELINE_WRITE_FAILED;
    return REDIS_PIPELINE_OK;
}

/* Per-connection driver.  One outer iteration = one
 * submit / drain / flush / rr_fill batch (phases labeled inline). */
@async int handle_client(CCSocket client, ReqTx req_tx, uint64_t conn_id) {
    @defer cc_socket_close(&client);
    /* Teardown: DRAIN-TO-ZERO is the join.  Every accepted request owes
     * exactly one reply, and the owner returns the request's pool slot
     * BEFORE queueing that reply — so once inflight replies are drained
     * (or the owner closed the channel and exited) the owner provably
     * never touches this conn again, and the registered destroy can free
     * it.  This replaces the old refcount scheme outright. */
    RedisConn* conn = redis_conn_create(conn_id) !> { return 1; }     @destroy {
        redis_conn_drain_inflight(conn);
    };
    conn->sock = &client;

    /* Large enough for pipelined redis-benchmark without constant compact moves. */
    char read_buf[64 * 1024];
    RespReader reader;
    /* @nonblocking: rr_init is pure struct init; default autoblock would
     * needlessly wrap it when called from this @async body. */
    @nonblocking { reader = rr_init(read_buf, sizeof(read_buf)); }
    ReqIter req_iter = rr_req_iter(&reader, conn);

    while (true) {
        /* Any CCError surfaced via !> in this batch becomes one
         * err_reply and we tear down via the outer @defer. */
        @errhandler(CCError e) {
            (void)conn->write_reply_now(err_reply(e));
            return 0;
        }

        /* Submit: up to k_pipeline_reply_cap parsed requests to the owner.  Every
         * accepted request owes exactly one RedisReply back on reply_rx. */
        RedisPipelineBatch batch = redis_pipeline_batch_start();
        RedisPipelineStatus submit_status =
            submit_pipeline_batch(conn, req_tx, &req_iter, &batch) !>;
        if (submit_status == REDIS_PIPELINE_OWNER_UNAVAILABLE) {
            (void)conn->write_reply_now(reply_error("ERR owner channel unavailable"));
            return 0;
        }
        if (submit_status != REDIS_PIPELINE_OK) return 0;

        /* Drain/flush: exactly one RedisReply per submitted request. */
        RedisPipelineStatus drain_status = drain_pipeline_batch(conn, &batch);
        if (drain_status != REDIS_PIPELINE_OK) return 0;

        /* If the socket read already buffered more complete/partial commands
         * and this batch stopped only because of k_pipeline_reply_cap, keep parsing
         * before parking on another read.  Otherwise -P larger than the server
         * batch cap can leave commands stranded in read_buf while the fiber
         * waits for new socket readiness that may never arrive. */
        if (redis_pipeline_batch_is_full(&batch) && reader.start < reader.end) continue;

        /* rr_fill: park until more bytes arrive or EOF. */
        bool more = rr_fill(&reader, &client) !>(e) { conn->write_reply_now(io_err_reply(e)); return 0; };
        if (!more) return 0;
    }
}

int main(int argc, char** argv) {
    @errhandler(CCError e) {
        char scratch_buf[256];
        CCArena scratch = @create(scratch_buf, sizeof(scratch_buf)) @destroy;
        const char* msg = e.message ? e.message : "unknown error";
        CCString line = @string(`fatal: ${msg}`, &scratch);
        redis_diag_fprintln(&line, &scratch);
        return 1;
    }

    int port = 6380;
    if (argc > 1) {
        char* end = NULL;
        long parsed = strtol(argv[1], &end, 10);
        if (end == argv[1] || (end && *end != 0) || parsed <= 0 || parsed > 65535) {
            char scratch_buf[256];
            CCArena scratch = @create(scratch_buf, sizeof(scratch_buf)) @destroy;
            CCString line = @string(`invalid port: ${argv[1]}`, &scratch);
            redis_diag_fprintln(&line, &scratch);
            return 1;
        }
        port = (int)parsed;
    }

    char addr[64];
    snprintf(addr, sizeof(addr), "127.0.0.1:%d", port);

    /* cc_tcp_listen uses an out-param, so guard explicitly instead
     * of !>; everything else in this function uses unwrap sugar. */
    CCNetError err = CC_NET_OK;
    CCListener ln = cc_tcp_listen(addr, strlen(addr), &err);
    if (err != CC_NET_OK) {
        char scratch_buf[256];
        CCArena scratch = @create(scratch_buf, sizeof(scratch_buf)) @destroy;
        CCString line = @string(`listen error: ${(int)err}`, &scratch);
        redis_diag_fprintln(&line, &scratch);
        return 1;
    }
    @defer cc_listener_close(&ln);

    /* cc_channel_pair's syntax pass matches the raw endpoint types
     * structurally (it doesn't resolve typedefs), so declare in raw
     * form here and rely on the ReqTx/ReqRx aliases everywhere else. */
    RedisRequest*[~k_request_chan_cap N:1 >] req_tx;
    RedisRequest*[~k_request_chan_cap N:1 <] req_rx;
    CCChan* req_ch = cc_channel_pair(&req_tx, &req_rx) !> @destroy;

    CCListener* ln_ptr = &ln;

    printf("redis_idiomatic listening on %s\n", addr);
    fflush(stdout);

    {
        CCNursery* server = cc_nursery_create(NULL) !> @destroy;
        /* On cancel, close req_tx so owner_loop's recv returns
         * Ok(false) and the owner exits cleanly. */
        (void)server->close_on(req_tx);

        static const int shutdown_sigs[] = { SIGINT, SIGTERM };
        if (server->cancel_on_signals(shutdown_sigs,
                                         sizeof(shutdown_sigs) / sizeof(shutdown_sigs[0])) != 0) {
            char scratch_buf[256];
            CCArena scratch = @create(scratch_buf, sizeof(scratch_buf)) @destroy;
            CCString line =
                @string("redis_idiomatic: failed to install shutdown handler", &scratch);
            redis_diag_fprintln(&line, &scratch);
            return 1;
        }

        server->spawn(() => [ln_ptr, req_tx, req_ch, server] {
            uint64_t next_conn_id = 1;
            while (true) {
                CCNetError aerr = CC_NET_OK;
                CCSocket client = ln_ptr->accept(&aerr);
                if (aerr != CC_NET_OK) {
                    if (!server->is_cancelled()) {
                        char scratch_buf[256];
                        CCArena scratch = @create(scratch_buf, sizeof(scratch_buf)) @destroy;
                        CCString line =
                            @string(`redis_idiomatic accept error: ${(int)aerr}`, &scratch);
                        redis_diag_fprintln(&line, &scratch);
                    }
                    break;
                }

                /* TCP_NODELAY: redis-benchmark's pipelined pattern
                 * (write N, read N, repeat) interacts with Nagle +
                 * delayed-ACK to produce multi-second stalls. */
                int one = 1;
                (void)setsockopt(client.fd, IPPROTO_TCP, TCP_NODELAY, &one, sizeof(one));

                uint64_t id = next_conn_id++;
                (void)server->spawn_async(handle_client(client, req_tx, id));
            }
            cc_channel_close(req_ch);
        });

        (void)server->spawn_async(owner_loop(req_rx));
    }

    return 0;
}

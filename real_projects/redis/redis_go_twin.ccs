/*
 * redis_go_twin.ccs — lightweight Concurrent-C Redis sketch.
 *
 * Same tiny command surface as redis.go (PING…FLUSHDB). Incomplete on
 * purpose: no expiry, no ASCII-CI, no @grammar. The point is CC shape —
 * not a line twin of the Go file.
 *
 * Lifetimes (three scopes — clarity over cleverness):
 *   shard arenas  →  durable keys/values
 *   batch_arena   →  one pipeline batch (argv copies + encode scratch)
 *   Conn.out      →  connection coalesce until flush
 *
 * Flow: parse → Reply{CCString} → as_slice at write → Conn.out → flush.
 *
 *   commands   →  string-literal switch (case "GET":)
 *   io         →  BufReader + Conn flush/write coalesce
 *   encode     →  Reply owns CCString; as_slice only at write
 *   parse      →  !> bang + slice.to_i64 (no is_err/value)
 *   db         →  CCShardMap (stdlib string→string shard cell)
 *   holds      →  excl->acquire_*_into(builder)
 *   lifecycle  →  @create/@destroy, @defer
 *   errors     →  T!>(E) + cc_err(@as) Io→CCError
 *   nursery    →  cancel_on_signals; accept task; @destroy joins
 *
 * Full server (sketch I/O grown up): redis_idiomatic.ccs.
 *
 * Build: `make redis_go_twin`
 * Run:   ./out/redis_go_twin [addr]   # default 127.0.0.1:6380
 */

#include <ccc/std/prelude.cch>
#include <ccc/cc_instantiate.cch>
#include <ccc/std/net.cch>
#include <ccc/std/map.cch>
#include <ccc/std/hash.cch>
#include <ccc/std/string.cch>
#include <ccc/cc_exclusive.cch>
#include <ccc/script/stdio.cch>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <signal.h>

#define K_READ_BUF   (16 * 1024)
#define K_OUT_BUF    (8 * 1024)
#define K_PIPELINE   16
#define K_MAX_ARGS   16
#define K_MAX_SHARDS 64

static const char* k_listen = "127.0.0.1:6380";

typedef enum Hold {
    HOLD_NONE = 0,
    HOLD_KEY,
    HOLD_KEYS,
    HOLD_ALL,
} Hold;

typedef struct DB {
    CCShardMap* shards;
    size_t shard_count;
    uint32_t mask;
    CCArena root;
} DB;

typedef struct Cmd {
    CCSlice args[K_MAX_ARGS];
    size_t argc;
} Cmd;

typedef struct Reply {
    /* Owns the encoded reply. SSO lives in this value; larger bodies may
     * use batch_arena. Borrow with as_slice() only at conn_write. */
    CCString wire;
} Reply;

/* --- encode: build a Reply owner; slice only at the write edge --- */

static Reply reply_string(CCString line) {
    Reply r = {0};
    r.wire = line;
    return r;
}

static Reply enc_simple(const char* s, CCArena* a) {
    return reply_string(@string(`+${s}\r\n`, a));
}
static Reply enc_err(const char* s, CCArena* a) {
    return reply_string(@string(`-ERR ${s}\r\n`, a));
}
static Reply enc_int(int64_t v, CCArena* a) {
    return reply_string(@string(`:${v}\r\n`, a));
}
static Reply enc_null(CCArena* a) {
    return reply_string(@string(`$-1\r\n`, a));
}
static Reply enc_bulk(CCSlice b, CCArena* a) {
    CCString out = cc_string_with_capacity(a, b.len + 32);
    out.append(@string(`$${b.len}\r\n`, a), a);
    out.append(b, a);
    out.append("\r\n", a);
    if (cc_string_failed(&out)) return enc_err("oom", a);
    return reply_string(out);
}
static Reply enc_ok(CCArena* a) { return enc_simple("OK", a); }

/* --- DB over CCShardMap cells --- */

/* `n` is already a power of two from cc_shard_mask_auto (1..K_MAX_SHARDS). */
static bool db_init(DB* db, size_t n) {
    size_t i, per;
    if (n == 0) n = 1;
    per = 1024 / n;
    if (per < 8) per = 8;
    memset(db, 0, sizeof(*db));
    db->root = cc_arena_heap(n * sizeof(CCShardMap) + 64);
    if (!db->root.valid()) return false;
    db->shards = cc_arena_alloc_T_count(CCShardMap, &db->root, n);
    if (!db->shards) {
        db->root.destroy();
        return false;
    }
    db->shard_count = n;
    db->mask = (uint32_t)(n - 1u);
    for (i = 0; i < n; i++) {
        if (!cc_shard_map_init(&db->shards[i], per)) {
            size_t j;
            for (j = 0; j < i; j++) cc_shard_map_destroy(&db->shards[j]);
            db->root.destroy();
            return false;
        }
    }
    return true;
}

static void db_free(DB* db) {
    size_t i;
    if (!db) return;
    for (i = 0; i < db->shard_count; i++) cc_shard_map_destroy(&db->shards[i]);
    db->root.destroy();
    memset(db, 0, sizeof(*db));
}

static size_t shard_of(DB* db, CCSlice key) {
    return (size_t)(cc_hash_slice(key) & db->mask);
}

/* --- hold + execute (string switch is the command table) --- */

static Hold hold_for(CCSlice name) {
    switch (name) {
    case "GET":
    case "SET":
    case "INCR":
        return HOLD_KEY;
    case "DEL":
    case "EXISTS":
    case "MGET":
        return HOLD_KEYS;
    case "DBSIZE":
    case "FLUSHDB":
        return HOLD_ALL;
    default:
        return HOLD_NONE;
    }
}

/* Kept out of the string-switch body: bang/to_i64 emit clashes with case arms. */
static Reply exec_incr(CCShardMap* sh, CCSlice key, CCArena* a) {
    CCString* v = sh->get(key);
    int64_t n = 0;
    if (v) {
        CCSlice s = cc_string_as_slice(v);
        int64_t parsed = s.to_i64() !>(e) {
            (void)e;
            return enc_err("value is not an integer", a);
        };
        n = parsed;
    }
    n++;
    {
        CCString num = @string(`${n}`, a);
        if (!sh->put(key, num.as_slice())) return enc_err("oom", a);
    }
    return enc_int(n, a);
}

static Reply exec_key(DB* db, Cmd* c, size_t si, CCArena* a) {
    CCShardMap* sh = &db->shards[si];
    CCSlice name = c->args[0];
    CCSlice key = c->args[1];

    switch (name) {
    case "GET": {
        CCString* v = sh->get(key);
        if (!v) return enc_null(a);
        return enc_bulk(v->as_slice(), a);
    }
    case "SET":
        if (c->argc < 3) return enc_err("wrong number of arguments", a);
        if (!sh->put(key, c->args[2])) return enc_err("oom", a);
        return enc_ok(a);
    case "INCR":
        return exec_incr(sh, key, a);
    default:
        return enc_err("internal", a);
    }
}

static Reply exec_keys(DB* db, Cmd* c, CCArena* a) {
    CCSlice name = c->args[0];
    size_t i;

    switch (name) {
    case "DEL": {
        int64_t n = 0;
        for (i = 1; i < c->argc; i++) {
            CCShardMap* sh = &db->shards[shard_of(db, c->args[i])];
            if (sh->delete(c->args[i])) n++;
        }
        return enc_int(n, a);
    }
    case "EXISTS": {
        int64_t n = 0;
        for (i = 1; i < c->argc; i++) {
            CCShardMap* sh = &db->shards[shard_of(db, c->args[i])];
            if (sh->get(c->args[i])) n++;
        }
        return enc_int(n, a);
    }
    case "MGET": {
        size_t nkeys = c->argc - 1;
        size_t cap = 64 + nkeys * 64;
        CCString out;
        for (i = 1; i < c->argc; i++) cap += c->args[i].len + 32;
        out = cc_string_with_capacity(a, cap);
        out.append(@string(`*${nkeys}\r\n`, a), a);
        for (i = 1; i < c->argc; i++) {
            CCShardMap* sh = &db->shards[shard_of(db, c->args[i])];
            CCString* v = sh->get(c->args[i]);
            if (!v) {
                out.append("$-1\r\n", a);
            } else {
                char[:] s = v->as_slice();
                out.append(@string(`$${s.len}\r\n`, a), a);
                out.append(s, a);
                out.append("\r\n", a);
            }
        }
        if (cc_string_failed(&out)) return enc_err("oom", a);
        return reply_string(out);
    }
    default:
        return enc_err("internal", a);
    }
}

static Reply exec_all(DB* db, Cmd* c, CCArena* a) {
    CCSlice name = c->args[0];
    size_t si;

    switch (name) {
    case "DBSIZE": {
        int64_t n = 0;
        for (si = 0; si < db->shard_count; si++)
            n += (int64_t)cc_shard_map_len(&db->shards[si]);
        return enc_int(n, a);
    }
    case "FLUSHDB":
        for (si = 0; si < db->shard_count; si++) {
            cc_shard_map_destroy(&db->shards[si]);
            if (!cc_shard_map_init(&db->shards[si], 8)) return enc_err("oom", a);
        }
        return enc_ok(a);
    default:
        return enc_err("internal", a);
    }
}

static size_t unique_shards(DB* db, Cmd* c, uint64_t* names, size_t cap) {
    size_t n = 0, i, j;
    for (i = 1; i < c->argc; i++) {
        uint64_t si = (uint64_t)shard_of(db, c->args[i]);
        int seen = 0;
        for (j = 0; j < n; j++) {
            if (names[j] == si) {
                seen = 1;
                break;
            }
        }
        if (!seen && n < cap) names[n++] = si;
    }
    return n;
}

static Reply execute(DB* db, CCExclusive* excl, Cmd* c, CCArena* a) {
    Reply out = {0};
    Hold h = HOLD_NONE;

    if (c->argc == 0) return enc_err("empty command", a);
    {
        CCSlice name = c->args[0];
        switch (name) {
        case "PING":
            if (c->argc > 1) return enc_bulk(c->args[1], a);
            return enc_simple("PONG", a);
        case "ECHO":
            if (c->argc < 2) return enc_err("wrong number of arguments", a);
            return enc_bulk(c->args[1], a);
        default:
            break;
        }
        h = hold_for(name);
    }
    if (h == HOLD_NONE) return enc_err("unknown command", a);

    if (h == HOLD_KEY) {
        size_t si;
        if (c->argc < 2) return enc_err("wrong number of arguments", a);
        si = shard_of(db, c->args[1]);
        CCExclusiveGuard g = excl->acquire((uint64_t)si);
        out = exec_key(db, c, si, a);
        g.release();
    } else if (h == HOLD_KEYS) {
        uint64_t names[K_MAX_SHARDS];
        CCExclusiveGuard gs[K_MAX_SHARDS];
        size_t nnames, n;
        if (c->argc < 2) return enc_err("wrong number of arguments", a);
        nnames = unique_shards(db, c, names, (size_t)K_MAX_SHARDS);
        n = excl->acquire_sorted(names, nnames, gs, (size_t)K_MAX_SHARDS);
        if (n == 0) return enc_err("shard admission failed", a);
        out = exec_keys(db, c, a);
        gs->release_n(n);
    } else {
        CCExclusiveGuard gs[K_MAX_SHARDS];
        size_t n = excl->acquire_range(0, (uint64_t)db->shard_count, gs,
                                       (size_t)K_MAX_SHARDS);
        if (n == 0) return enc_err("shard admission failed", a);
        out = exec_all(db, c, a);
        gs->release_n(n);
    }
    return out;
}

/* --- buffered RESP --- */

static bool !>(CCError) read_cmd(BufReader::[CCSocket]* br, Cmd* out, CCArena* a) {
    for (;;) {
        size_t i;
        memset(out, 0, sizeof(*out));

        CCSlice line = br->read_line() !>(e) { return cc_err(e); };
        if (line.len == 0) {
            if (br->eof) return cc_ok(false);
            continue;
        }

        if (line.ptr[0] != '*') {
            size_t start = 0;
            while (start < line.len && out->argc < (size_t)K_MAX_ARGS) {
                size_t end;
                CCSlice part;
                while (start < line.len && line.ptr[start] == ' ') start++;
                if (start >= line.len) break;
                end = start;
                while (end < line.len && line.ptr[end] != ' ') end++;
                part = line.sub(start, end);
                {
                    CCSlice owned = part.clone_into(a) !>(e) {
                        return cc_err(e);
                    };
                    out->args[out->argc++] = owned;
                }
                start = end;
            }
            if (out->argc == 0) continue;
            return cc_ok(true);
        }

        {
            CCSlice argc_s = line.sub(1, line.len);
            int64_t n = argc_s.to_i64() !>(e) {
                (void)e;
                return cc_err(CC_ERR_INVALID_ARG, "bad argc");
            };
            if (n < 0 || n > K_MAX_ARGS)
                return cc_err(CC_ERR_INVALID_ARG, "bad argc");
            if (n == 0) continue;
            for (i = 0; i < (size_t)n; i++) {
                CCSlice hdr = br->read_line() !>(e) { return cc_err(e); };
                if (hdr.len == 0 || hdr.ptr[0] != '$')
                    return cc_err(CC_ERR_INVALID_ARG, "bad bulk");
                {
                    CCSlice blen_s = hdr.sub(1, hdr.len);
                    int64_t blen = blen_s.to_i64() !>(e) {
                        (void)e;
                        return cc_err(CC_ERR_INVALID_ARG, "bad bulk");
                    };
                    if (blen < 0) return cc_err(CC_ERR_INVALID_ARG, "bad bulk");

                    CCSlice payload = br->read_exact((size_t)blen + 2) !>(e) {
                        return cc_err(e);
                    };
                    CCSlice part = payload.sub(0, (size_t)blen);
                    CCSlice owned = part.clone_into(a) !>(e) {
                        return cc_err(e);
                    };
                    out->args[out->argc++] = owned;
                }
            }
        }
        return cc_ok(true);
    }
}

/* --- connection: coalesce Reply bytes into out[]; flush to the socket --- */

typedef struct Conn {
    CCSocket* sock;
    char out[K_OUT_BUF]; /* connection-scoped; survives past batch_arena reset */
    size_t out_len;
} Conn;

static bool write_all(CCSocket* sock, CCSlice data) {
    size_t off = 0;
    while (off < data.len) {
        size_t n = sock->write(data.ptr + off, data.len - off) !>(e) {
            (void)e;
            return false;
        };
        if (n == 0) return false;
        off += n;
    }
    return true;
}

static bool conn_flush(Conn* c) {
    if (!c || c->out_len == 0) return true;
    CCSlice data = cc_slice_from_buffer(c->out, c->out_len);
    c->out_len = 0;
    return write_all(c->sock, data);
}

static bool conn_write(Conn* c, CCSlice data) {
    if (!c || data.len == 0) return true;
    if (data.len > sizeof(c->out))
        return conn_flush(c) && write_all(c->sock, data);
    if (c->out_len + data.len > sizeof(c->out) && !conn_flush(c))
        return false;
    memcpy(c->out + c->out_len, data.ptr, data.len);
    c->out_len += data.len;
    return true;
}

static void handle_client(CCSocket client, DB* db, CCExclusive* excl) {
    /* Scopes: shard arenas = store; batch_arena = this pipeline batch;
     * conn.out = coalesce until flush. */
    char read_buf[K_READ_BUF];
    BufReader::[CCSocket] br;
    Conn conn = { .sock = &client, .out_len = 0 };
    CCArena batch_arena = cc_arena_heap(16 * 1024) @destroy;
    @defer client.close();
    batch_arena.block_max = 0;
    br.init(&client, read_buf, sizeof(read_buf));

    for (;;) {
        size_t i;
        batch_arena.reset();
        for (i = 0; i < (size_t)K_PIPELINE; i++) {
            Cmd c;
            Reply r;
            if (i > 0 && br.buffered() == 0) break;

            bool ok = read_cmd(&br, &c, &batch_arena) !>(e) {
                (void)conn_flush(&conn);
                if (!(i > 0 || e.kind == CC_ERR_CLOSED)) {
                    Reply er = enc_err(cc_error_str(e), &batch_arena);
                    if (er.wire.len())
                        (void)write_all(&client, er.wire.as_slice());
                }
                return;
            };
            if (!ok) {
                (void)conn_flush(&conn);
                return;
            }

            r = execute(db, excl, &c, &batch_arena);
            if (!r.wire.len()) r = enc_err("internal", &batch_arena);
            if (!conn_write(&conn, r.wire.as_slice())) return;
        }
        if (!conn_flush(&conn)) return;
    }
}

/* --- main --- */

int main(int argc, char** argv) {
    @errhandler(CCError e) { cc_error_log(e); return 1; }

    const char* addr = k_listen;
    DB db = {0};
    CCExclusive* excl = NULL;
    CCShardMask shards = cc_shard_mask_auto((size_t)K_MAX_SHARDS);
    if (argc > 1) addr = argv[1];

    CCArena excl_arena = @create(kilobytes(64)) @destroy;
    if (!db_init(&db, shards.count ? shards.count : 1u)) {
        eprintln("redis_go_twin: db_init failed") !>;
        return 1;
    }
    @defer db_free(&db);

    excl = cc_exclusive_create(&excl_arena, db.shard_count * 2u);
    if (!excl) {
        eprintln("redis_go_twin: exclusive failed") !>;
        return 1;
    }
    @defer excl->destroy();

    CCListener ln = cc_tcp_listen(cc_slice_cstr(addr)) !>(e) {
        eprintln(@string(`listen: ${e}`, @scratch)) !>;
        return 1;
    };
    @defer ln.close();

    println(@string(`redis-go-twin on ${addr} shards=${db.shard_count}`, @scratch)) !>;

    {
        CCNursery* server = cc_nursery_create(NULL) !> @destroy;
        static const int sigs[] = { SIGINT, SIGTERM };
        if (server->cancel_on_signals(sigs, sizeof(sigs) / sizeof(sigs[0])) != 0) {
            eprintln("redis_go_twin: shutdown handler failed") !>;
            return 1;
        }

        server->spawn(() => [@safe &db, excl, @safe &ln, server] {
            while (!server->is_cancelled()) {
                CCSocket client = ln.accept() !>(e) {
                    (void)e;
                    break;
                };
                (void)client.set_nodelay(1);
                server->spawn(() => [@safe &db, excl, client] {
                    handle_client(client, &db, excl);
                });
            }
        });
    }
    return 0;
}

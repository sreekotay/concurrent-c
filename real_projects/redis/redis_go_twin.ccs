/*
 * redis_go_twin.ccs — Concurrent-C twin of redis.go.
 *
 * Same shape as redis.go: sharded exclusive names, one fiber per conn,
 * hold covers DB work, pipeline window, owned argv copies from parse.
 *
 * Concurrent-C forms (see pigz_idiomatic.ccs / examples/recipe_*):
 *   withShards(fn)  →  excl->acquire_*_into(builder)
 *   resources       →  @create / @destroy / @defer
 *   bytes           →  CCSlice UFCS (s.reply(a), clone_into); arena last
 *   errors          →  T!>(E) + !>(e) { … }; main @errhandler + !>;
 *   bufio           →  BufReader::[CCSocket] (Go bufio.Reader twin)
 *   commands        →  comptime static_map (ASCII-CI), like redis_idiomatic
 *
 * Not the bench/smoke server — that is redis_idiomatic.ccs.
 *
 * Build: `make redis_go_twin`
 * Run:   ./out/redis_go_twin [addr]   # default 127.0.0.1:6380
 */

#include <ccc/std/prelude.cch>
#include <ccc/cc_instantiate.cch>
#include <ccc/std/net.cch>
#include <ccc/std/map.cch>
#include <ccc/std/hash.cch>
#include <ccc/std/string.cch>
#include <ccc/std/static_map.cch>
#include <ccc/cc_exclusive.cch>
#include <ccc/script/stdio.cch>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>

enum {
    k_read_buf_cap = 64 * 1024,
    k_out_buf_cap = 8 * 1024,
    k_pipeline_window = 16,
    k_max_args = 16,
    k_max_shards = 64,
};

static const char* k_default_listen = "127.0.0.1:6380";

typedef enum HoldKind {
    HOLD_NONE = 0,
    HOLD_KEY,
    HOLD_KEYS,
    HOLD_ALL,
} HoldKind;

typedef enum CmdKind {
    CMD_PING = 0,
    CMD_ECHO,
    CMD_GET,
    CMD_SET,
    CMD_DEL,
    CMD_EXISTS,
    CMD_INCR,
    CMD_MGET,
    CMD_DBSIZE,
    CMD_FLUSHDB,
    CMD_UNKNOWN,
} CmdKind;

typedef struct Entry {
    CCString val;
    int64_t expires_at; /* unix ms; 0 = none */
} Entry;

typedef ArrayMap::[CCSlicePacked, Entry] ShardMap;

typedef struct Shard {
    ShardMap data;
    CCArena arena;
} Shard;

typedef struct DB {
    Shard* shards;
    size_t shard_count;
    uint32_t mask;
    CCArena root;
} DB;

typedef struct Cmd {
    CmdKind kind;
    CCSlice args[k_max_args];
    size_t argc;
} Cmd;

typedef struct Reply {
    CCSlice wire;
} Reply;

/* name -> { kind, min_args, max_args } after the command word; max_args < 0
 * is variadic. Hold policy stays in hold_for (same split as redis_idiomatic). */
typedef struct CmdSpec {
    CmdKind kind;
    int min_args;
    int max_args;
} CmdSpec;

typedef struct CmdEntry {
    const char* key;
    CmdSpec value;
} CmdEntry;

@comptime {
    CmdEntry commands[] = {
        { "PING", { CMD_PING, 0, 1 } },
        { "ECHO", { CMD_ECHO, 1, 1 } },
        { "GET", { CMD_GET, 1, 1 } },
        { "SET", { CMD_SET, 2, 2 } },
        { "DEL", { CMD_DEL, 1, -1 } },
        { "EXISTS", { CMD_EXISTS, 1, -1 } },
        { "INCR", { CMD_INCR, 1, 1 } },
        { "MGET", { CMD_MGET, 1, -1 } },
        { "DBSIZE", { CMD_DBSIZE, 0, 0 } },
        { "FLUSHDB", { CMD_FLUSHDB, 0, 0 } },
    };
    static_map("twin_commands", commands, CC_STATIC_MAP_ASCII_CI);
}

/* --- helpers --- */

static int64_t now_ms(void) {
    struct timespec ts;
    clock_gettime(CLOCK_REALTIME, &ts);
    return (int64_t)ts.tv_sec * 1000 + (int64_t)(ts.tv_nsec / 1000000);
}

static HoldKind hold_for(CmdKind k) {
    if (k == CMD_PING || k == CMD_ECHO) return HOLD_NONE;
    if (k == CMD_GET || k == CMD_SET || k == CMD_INCR) return HOLD_KEY;
    if (k == CMD_DEL || k == CMD_EXISTS || k == CMD_MGET) return HOLD_KEYS;
    if (k == CMD_DBSIZE || k == CMD_FLUSHDB) return HOLD_ALL;
    return HOLD_NONE;
}

static CmdKind parse_kind(CCSlice name) {
    const CmdSpec* spec = twin_commands_get(name);
    return spec ? spec->kind : CMD_UNKNOWN;
}

/* --- DB --- */

static bool shard_init(Shard* sh, size_t bucket_hint) {
    memset(sh, 0, sizeof(*sh));
    sh->arena = cc_arena_heap(1024);
    if (!sh->arena.valid()) return false;
    sh->arena.block_max = 1;
    if (!cc_arena_set_heap_overflow(&sh->arena, true)) {
        sh->arena.destroy();
        return false;
    }
    sh->data = array_map_new_count::[CCSlicePacked, Entry](&sh->arena, bucket_hint);
    return sh->data != NULL;
}

static void shard_free(Shard* sh) {
    if (!sh) return;
    if (sh->data) {
        sh->data->destroy();
        sh->data = NULL;
    }
    sh->arena.destroy();
}

static bool db_init(DB* db, size_t ncpu) {
    size_t n = 1;
    size_t i;
    size_t per;
    while (n < ncpu && n < (size_t)k_max_shards) n <<= 1;
    per = 1024 / n;
    if (per < 8) per = 8;
    memset(db, 0, sizeof(*db));
    db->root = cc_arena_heap(n * sizeof(Shard) + 64);
    if (!db->root.valid()) return false;
    db->shards = cc_arena_alloc_T_count(Shard, &db->root, n);
    if (!db->shards) {
        db->root.destroy();
        return false;
    }
    db->shard_count = n;
    db->mask = (uint32_t)(n - 1u);
    for (i = 0; i < n; i++) {
        if (!shard_init(&db->shards[i], per)) {
            size_t j;
            for (j = 0; j < i; j++) shard_free(&db->shards[j]);
            db->root.destroy();
            return false;
        }
    }
    return true;
}

static void db_free(DB* db) {
    size_t i;
    if (!db) return;
    for (i = 0; i < db->shard_count; i++) shard_free(&db->shards[i]);
    db->root.destroy();
    memset(db, 0, sizeof(*db));
}

static size_t db_shard_idx(DB* db, CCSlice key) {
    return (size_t)(cc_hash_slice(key) & db->mask);
}

static bool entry_live(Entry* e, int64_t now) {
    return e->expires_at == 0 || e->expires_at > now;
}

static CCSlicePacked probe_key(CCSlicePackedView* view, CCSlice key) {
    return cc_slice_packed_borrow_slice(view, key);
}

static void release_entry(Shard* sh, Entry* e) {
    if (!e) return;
    e->val.release(&sh->arena);
    *e = (Entry){0};
}

static void release_key(Shard* sh, CCSlicePacked* k) {
    if (!sh || !k) return;
    cc_slice_packed_release(&sh->arena, k);
}

static void shard_del_key(Shard* sh, CCSlicePacked pk) {
    Entry* e = sh->data->get_ptr(pk);
    CCSlicePacked* stored;
    if (!e) return;
    stored = sh->data->find_key_ptr(pk);
    release_entry(sh, e);
    if (stored) {
        CCSlicePacked doomed = *stored;
        sh->data->del(pk);
        release_key(sh, &doomed);
    } else {
        sh->data->del(pk);
    }
}

static bool clone_string(CCSlice src, Shard* sh, CCString* out) {
    CCString s = cc_string_new();
    if (src.len && s.push_slice(src, &sh->arena) == NULL) return false;
    *out = s;
    return true;
}

static bool clone_key(CCSlice src, Shard* sh, CCSlicePacked* out) {
    CCSlicePacked !>(CCError) pk = src.to_packed(&sh->arena);
    if (pk.is_err()) return false;
    *out = pk.value();
    return true;
}

/* --- RESP encode into window arena (receiver / value first, arena last) --- */

/* UFCS: `s.reply(a)` → cc_slice_reply(&s, a). */
static Reply cc_slice_reply(CCSlice* s, CCArena* a) {
    Reply r = {0};
    if (!a || !s || !s->ptr || s->len == 0) return r;
    CCSlice !>(CCError) wire = s->clone_into(a);
    if (wire.is_err()) return r;
    r.wire = wire.value();
    return r;
}

static Reply encode_simple(const char* s, CCArena* a) {
    CCString line = @string(`+${s}\r\n`, a);
    CCSlice view = line.as_slice();
    return view.reply(a);
}

static Reply encode_error(const char* s, CCArena* a) {
    CCString line = @string(`-ERR ${s}\r\n`, a);
    CCSlice view = line.as_slice();
    return view.reply(a);
}

static Reply encode_int(int64_t v, CCArena* a) {
    CCString line = @string(`:${v}\r\n`, a);
    CCSlice view = line.as_slice();
    return view.reply(a);
}

static Reply encode_null_bulk(CCArena* a) {
    CCSlice nil = char_to_slice("$-1\r\n");
    return nil.reply(a);
}

static Reply encode_bulk(CCSlice b, CCArena* a) {
    CCString hdr = @string(`$${b.len}\r\n`, a);
    CCSlice h = hdr.as_slice();
    size_t total = h.len + b.len + 2;
    char* buf = cc_arena_alloc_T_count(char, a, total);
    Reply r = {0};
    if (!buf) return encode_error("oom", a);
    memcpy(buf, h.ptr, h.len);
    if (b.len) memcpy(buf + h.len, b.ptr, b.len);
    buf[h.len + b.len] = '\r';
    buf[h.len + b.len + 1] = '\n';
    r.wire = a->slice(buf, total);
    return r;
}

static Reply encode_ok(CCArena* a) { return encode_simple("OK", a); }

/* --- execute under hold --- */

static Reply exec_key(DB* db, Cmd* c, size_t si, int64_t now, CCArena* a) {
    Shard* sh = &db->shards[si];
    CCSlicePackedView view;
    CCSlicePacked pk = probe_key(&view, c->args[1]);
    Entry* e;
    CCString val;
    CCSlicePacked durable;
    Entry ent;

    if (c->kind == CMD_GET) {
        e = sh->data->get_ptr(pk);
        if (!e || !entry_live(e, now)) {
            if (e) shard_del_key(sh, pk);
            return encode_null_bulk(a);
        }
        return encode_bulk(e->val.as_slice(), a);
    }

    if (c->kind == CMD_SET) {
        if (c->argc < 3) return encode_error("wrong number of arguments", a);
        e = sh->data->get_ptr(pk);
        if (e) {
            e->val.release(&sh->arena);
            if (!clone_string(c->args[2], sh, &val)) return encode_error("oom", a);
            e->val = val;
            e->expires_at = 0;
            return encode_ok(a);
        }
        if (!clone_key(c->args[1], sh, &durable)) return encode_error("oom", a);
        if (!clone_string(c->args[2], sh, &val)) {
            release_key(sh, &durable);
            return encode_error("oom", a);
        }
        ent.val = val;
        ent.expires_at = 0;
        if (sh->data->insert(durable, ent) != 0) {
            val.release(&sh->arena);
            release_key(sh, &durable);
            return encode_error("oom", a);
        }
        return encode_ok(a);
    }

    if (c->kind == CMD_INCR) {
        int64_t n = 0;
        int64_t exp = 0;
        e = sh->data->get_ptr(pk);
        if (e && entry_live(e, now)) {
            char* end = NULL;
            CCSlice s = e->val.as_slice();
            char tmp[32];
            size_t copy = s.len < sizeof(tmp) - 1 ? s.len : sizeof(tmp) - 1;
            memcpy(tmp, s.ptr, copy);
            tmp[copy] = 0;
            n = strtoll(tmp, &end, 10);
            if (end == tmp || (end && *end)) {
                return encode_error("value is not an integer", a);
            }
            exp = e->expires_at;
            e->val.release(&sh->arena);
        } else if (e) {
            shard_del_key(sh, pk);
            e = NULL;
        }
        n++;
        {
            CCString num = @string(`${n}`, a);
            if (!clone_string(num.as_slice(), sh, &val)) return encode_error("oom", a);
            if (e) {
                e->val = val;
                e->expires_at = exp;
            } else {
                if (!clone_key(c->args[1], sh, &durable)) {
                    val.release(&sh->arena);
                    return encode_error("oom", a);
                }
                ent.val = val;
                ent.expires_at = exp;
                if (sh->data->insert(durable, ent) != 0) {
                    val.release(&sh->arena);
                    release_key(sh, &durable);
                    return encode_error("oom", a);
                }
            }
            return encode_int(n, a);
        }
    }

    return encode_error("internal", a);
}

static Reply exec_keys(DB* db, Cmd* c, int64_t now, CCArena* a) {
    size_t i;

    if (c->kind == CMD_DEL) {
        int64_t n = 0;
        for (i = 1; i < c->argc; i++) {
            size_t si = db_shard_idx(db, c->args[i]);
            Shard* sh = &db->shards[si];
            CCSlicePackedView view;
            CCSlicePacked pk = probe_key(&view, c->args[i]);
            Entry* e = sh->data->get_ptr(pk);
            if (!e) continue;
            if (entry_live(e, now)) n++;
            shard_del_key(sh, pk);
        }
        return encode_int(n, a);
    }

    if (c->kind == CMD_EXISTS) {
        int64_t n = 0;
        for (i = 1; i < c->argc; i++) {
            size_t si = db_shard_idx(db, c->args[i]);
            Shard* sh = &db->shards[si];
            CCSlicePackedView view;
            CCSlicePacked pk = probe_key(&view, c->args[i]);
            Entry* e = sh->data->get_ptr(pk);
            if (!e) continue;
            if (entry_live(e, now)) n++;
            else shard_del_key(sh, pk);
        }
        return encode_int(n, a);
    }

    if (c->kind == CMD_MGET) {
        size_t nkeys = c->argc > 0 ? c->argc - 1 : 0;
        size_t cap = 64 + nkeys * 64;
        size_t len = 0;
        char* buf;
        Reply r = {0};
        for (i = 1; i < c->argc; i++) cap += c->args[i].len + 32;
        buf = cc_arena_alloc_T_count(char, a, cap);
        if (!buf) return encode_error("oom", a);
        {
            CCString hdr = @string(`*${nkeys}\r\n`, a);
            CCSlice h = hdr.as_slice();
            if (h.len > cap) return encode_error("encode", a);
            memcpy(buf, h.ptr, h.len);
            len = h.len;
        }
        for (i = 1; i < c->argc; i++) {
            size_t si = db_shard_idx(db, c->args[i]);
            Shard* sh = &db->shards[si];
            CCSlicePackedView view;
            CCSlicePacked pk = probe_key(&view, c->args[i]);
            Entry* e = sh->data->get_ptr(pk);
            if (!e || !entry_live(e, now)) {
                if (e) shard_del_key(sh, pk);
                if (len + 5 > cap) return encode_error("encode", a);
                memcpy(buf + len, "$-1\r\n", 5);
                len += 5;
                continue;
            }
            {
                CCSlice v = e->val.as_slice();
                CCString bh = @string(`$${v.len}\r\n`, a);
                CCSlice h = bh.as_slice();
                if (len + h.len + v.len + 2 > cap) return encode_error("encode", a);
                memcpy(buf + len, h.ptr, h.len);
                len += h.len;
                if (v.len) memcpy(buf + len, v.ptr, v.len);
                len += v.len;
                buf[len++] = '\r';
                buf[len++] = '\n';
            }
        }
        r.wire = a->slice(buf, len);
        return r;
    }

    return encode_error("internal", a);
}

static Reply exec_all(DB* db, Cmd* c, int64_t now, CCArena* a) {
    size_t si;

    if (c->kind == CMD_DBSIZE) {
        int64_t n = 0;
        for (si = 0; si < db->shard_count; si++) {
            Shard* sh = &db->shards[si];
            size_t di = 0;
            while (di < sh->data->len()) {
                Entry* e = sh->data->at_ptr(di);
                CCSlicePacked* k = sh->data->key_ptr(di);
                if (!e || !k) break;
                if (entry_live(e, now)) {
                    n++;
                    di++;
                } else {
                    shard_del_key(sh, *k);
                }
            }
        }
        return encode_int(n, a);
    }

    if (c->kind == CMD_FLUSHDB) {
        for (si = 0; si < db->shard_count; si++) {
            shard_free(&db->shards[si]);
            if (!shard_init(&db->shards[si], 8)) return encode_error("oom", a);
        }
        return encode_ok(a);
    }

    return encode_error("internal", a);
}

static size_t unique_shard_names(DB* db, Cmd* c, uint64_t* names, size_t cap) {
    size_t n = 0;
    size_t i, j;
    for (i = 1; i < c->argc; i++) {
        uint64_t si = (uint64_t)db_shard_idx(db, c->args[i]);
        int seen = 0;
        for (j = 0; j < n; j++) {
            if (names[j] == si) {
                seen = 1;
                break;
            }
        }
        if (!seen && n < cap) names[n++] = si;
    }
    return n;
}

/* Go withShards(idxs, fn) → acquire_*_into(builder). */
static Reply db_execute(DB* db, CCExclusive* excl, Cmd* c, int64_t now, CCArena* a) {
    Reply out = {0};
    HoldKind h = hold_for(c->kind);
    bool admitted = 1;

    if (c->kind == CMD_PING) {
        if (c->argc > 1) return encode_bulk(c->args[1], a);
        return encode_simple("PONG", a);
    }
    if (c->kind == CMD_ECHO) {
        if (c->argc < 2) return encode_error("wrong number of arguments", a);
        return encode_bulk(c->args[1], a);
    }
    if (c->kind == CMD_UNKNOWN) return encode_error("unknown command", a);

    if (h == HOLD_KEY) {
        size_t si;
        CCClosure2 builder;
        if (c->argc < 2) return encode_error("wrong number of arguments", a);
        si = db_shard_idx(db, c->args[1]);
        builder = (Reply* slot, CCArena* arena) => [db, c, now] {
            *slot = exec_key(db, c, db_shard_idx(db, c->args[1]), now, arena);
            return NULL;
        };
        admitted = excl->acquire_into((uint64_t)si, &out, a, builder);
    } else if (h == HOLD_KEYS) {
        uint64_t names[k_max_shards];
        size_t nnames;
        CCClosure2 builder;
        if (c->argc < 2) return encode_error("wrong number of arguments", a);
        nnames = unique_shard_names(db, c, names, (size_t)k_max_shards);
        builder = (Reply* slot, CCArena* arena) => [db, c, now] {
            *slot = exec_keys(db, c, now, arena);
            return NULL;
        };
        admitted = excl->acquire_sorted_into(names, nnames, &out, a, builder);
    } else if (h == HOLD_ALL) {
        CCClosure2 builder = (Reply* slot, CCArena* arena) => [db, c, now] {
            *slot = exec_all(db, c, now, arena);
            return NULL;
        };
        admitted = excl->acquire_range_into(0, (uint64_t)db->shard_count, &out, a, builder);
    }

    if (!admitted) return encode_error("shard admission failed", a);
    return out;
}

/* --- buffered RESP reader (stdlib BufReader::[CCSocket]) --- */

/* Ok(true)=cmd; Ok(false)=clean EOF; Err=incomplete/protocol/IO.
 * BufReader is CCIoError-keyed; clone_into errors project via cc_io_error. */
static bool !>(CCIoError) read_resp_command(BufReader::[CCSocket]* br, Cmd* out,
                                            CCArena* a) {
    size_t i;
    memset(out, 0, sizeof(*out));

    CCSlice !>(CCIoError) line_res = br->read_line();
    if (line_res.is_err()) return cc_err(line_res.error());
    CCSlice line = line_res.value();
    if (line.len == 0) return cc_ok(false);

    if (line.ptr[0] != '*') {
        size_t start = 0;
        while (start < line.len && out->argc < (size_t)k_max_args) {
            size_t end;
            CCSlice part;
            while (start < line.len && line.ptr[start] == ' ') start++;
            if (start >= line.len) break;
            end = start;
            while (end < line.len && line.ptr[end] != ' ') end++;
            part = line.sub(start, end);
            out->args[out->argc++] = part.clone_into(a) !>(e) {
                return cc_err(cc_io_error(e));
            };
            start = end;
        }
        if (out->argc == 0) return cc_err(cc_io_error(CC_IO_CONNECTION_CLOSED));
        out->kind = parse_kind(out->args[0]);
        return cc_ok(true);
    }

    {
        long n = 0;
        char* endp = NULL;
        char tmp[32];
        size_t copy = line.len > 1 ? line.len - 1 : 0;
        if (copy >= sizeof(tmp))
            return cc_err(cc_io_error(CC_ERROR(CC_ERR_INVALID_ARG, "bad argc")));
        if (copy) memcpy(tmp, line.ptr + 1, copy);
        tmp[copy] = 0;
        n = strtol(tmp, &endp, 10);
        if (endp == tmp || n < 0 || n > k_max_args)
            return cc_err(cc_io_error(CC_ERROR(CC_ERR_INVALID_ARG, "bad argc")));
        for (i = 0; i < (size_t)n; i++) {
            long blen;
            char* bend = NULL;
            char ht[32];
            size_t hcopy;
            CCSlice part;

            CCSlice !>(CCIoError) hdr_res = br->read_line();
            if (hdr_res.is_err()) return cc_err(hdr_res.error());
            CCSlice hdr = hdr_res.value();
            if (hdr.len == 0) return cc_err(cc_io_error(CC_IO_CONNECTION_CLOSED));
            if (hdr.ptr[0] != '$')
                return cc_err(cc_io_error(CC_ERROR(CC_ERR_INVALID_ARG, "bad bulk hdr")));
            hcopy = hdr.len > 1 ? hdr.len - 1 : 0;
            if (hcopy >= sizeof(ht))
                return cc_err(cc_io_error(CC_ERROR(CC_ERR_INVALID_ARG, "bad bulk len")));
            if (hcopy) memcpy(ht, hdr.ptr + 1, hcopy);
            ht[hcopy] = 0;
            blen = strtol(ht, &bend, 10);
            if (bend == ht || blen < 0)
                return cc_err(cc_io_error(CC_ERROR(CC_ERR_INVALID_ARG, "bad bulk len")));

            CCSlice !>(CCIoError) payload_res = br->read_exact((size_t)blen + 2);
            if (payload_res.is_err()) return cc_err(payload_res.error());
            part = payload_res.value().sub(0, (size_t)blen);
            out->args[out->argc++] = part.clone_into(a) !>(e) {
                return cc_err(cc_io_error(e));
            };
        }
    }
    if (out->argc == 0)
        return cc_err(cc_io_error(CC_ERROR(CC_ERR_INVALID_ARG, "empty command")));
    out->kind = parse_kind(out->args[0]);
    return cc_ok(true);
}

/* --- connection --- */

static bool cc_socket_write_all(CCSocket* sock, CCSlice data) {
    size_t off = 0;
    while (off < data.len) {
        CCSlice rest = data.sub(off, data.len);
        size_t n = sock->write(rest.ptr, rest.len) !>(e) {
            (void)e;
            return false;
        };
        if (n == 0) return false;
        off += n;
    }
    return true;
}

static void flush_out(CCSocket* sock, char* out, size_t* out_len) {
    if (!out_len || !*out_len) return;
    (void)sock->write_all(cc_slice_from_buffer(out, *out_len));
    *out_len = 0;
}

static void handle_client(CCSocket client, DB* db, CCExclusive* excl) {
    @defer client.close();

    char read_buf[k_read_buf_cap];
    BufReader::[CCSocket] br;
    char out[k_out_buf_cap];
    size_t out_len = 0;
    CCArena window = @create(16 * 1024) @destroy;
    if (!window.base) return;
    window.block_max = 0;

    br.init(&client, read_buf, sizeof(read_buf));

    for (;;) {
        size_t i;
        window.reset();
        for (i = 0; i < (size_t)k_pipeline_window; i++) {
            Cmd c;
            Reply r;
            if (i > 0 && br.buffered() == 0) break;

            /* Model B: Ok(false)=EOF; Err(CLOSED)=incomplete; else -ERR. */
            bool ok = read_resp_command(&br, &c, &window) !>(e) {
                flush_out(&client, out, &out_len);
                if (i > 0 || e.base.kind == CC_ERR_CLOSED) return;
                Reply er = encode_error(cc_io_error_str(e), &window);
                if (er.wire.len) (void)client.write_all(er.wire);
                return;
            };
            if (!ok) {
                flush_out(&client, out, &out_len);
                return;
            }

            r = db_execute(db, excl, &c, now_ms(), &window);
            if (r.wire.len == 0) r = encode_error("internal", &window);
            if (out_len + r.wire.len > sizeof(out)) {
                if (out_len && !client.write_all(cc_slice_from_buffer(out, out_len))) {
                    return;
                }
                out_len = 0;
            }
            if (r.wire.len > sizeof(out)) {
                if (!client.write_all(r.wire)) return;
            } else {
                memcpy(out + out_len, r.wire.ptr, r.wire.len);
                out_len += r.wire.len;
            }
        }
        if (out_len) {
            if (!client.write_all(cc_slice_from_buffer(out, out_len))) return;
            out_len = 0;
        }
    }
}

/* --- main --- */

int main(int argc, char** argv) {
    @errhandler(CCError e) { cc_error_log(e); return 1; }

    const char* addr = k_default_listen;
    DB db = {0};
    CCExclusive* excl = NULL;
    CCShardMask ncpu_mask = cc_shard_mask_auto((size_t)k_max_shards);
    size_t ncpu = ncpu_mask.count ? ncpu_mask.count : 1u;

    if (argc > 1) addr = argv[1];

    CCArena excl_arena = @create(kilobytes(64)) @destroy;
    if (!excl_arena.base) {
        eprintln("redis_go_twin: excl arena failed") !>;
        return 1;
    }

    if (!db_init(&db, ncpu)) {
        eprintln("redis_go_twin: db_init failed") !>;
        return 1;
    }
    @defer db_free(&db);

    excl = cc_exclusive_create_sized(&excl_arena, db.shard_count * 2u);
    if (!excl) {
        eprintln("redis_go_twin: cc_exclusive_create failed") !>;
        return 1;
    }
    @defer excl->destroy();

    CCListener ln = cc_tcp_listen(addr, strlen(addr)) !>(e) {
        eprintln(@string(`listen: ${e}`, @scratch)) !>;
        return 1;
    };
    @defer ln.close();

    println(@string(`redis-go-twin idiomatic on ${addr} shards=${db.shard_count}`,
                    @scratch)) !>;

    {
        DB* dbp = &db;
        CCExclusive* exclp = excl;
        CCNursery* server = cc_nursery_create(NULL) !> @destroy;

        for (;;) {
            CCSocket client = ln.accept() !>(e) {
                (void)e;
                break;
            };
            server->spawn(() => [client, dbp, exclp] {
                handle_client(client, dbp, exclp);
            });
        }
    }

    return 0;
}

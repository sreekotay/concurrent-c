/*
 * redis_sketch_kv.cch — tiny sharded string store for redis_* sketches.
 *
 * Same grain as redis_db: Table::[CCSlicePacked, CCString] per shard +
 * caller-owned CCShardDomain. No expiry / RedisValue / replies.
 *
 * Include after prelude / string / table / exclusive.
 */
#ifndef REDIS_SKETCH_KV_CCH
#define REDIS_SKETCH_KV_CCH

#ifndef REDIS_SKETCH_MAX_SHARDS
#define REDIS_SKETCH_MAX_SHARDS 64
#endif

#ifndef REDIS_SKETCH_ARENA_ROOT
#define REDIS_SKETCH_ARENA_ROOT (64 * 1024)
#endif

typedef Table::[CCSlicePacked, CCString] SketchKvMap;

typedef struct SketchShard {
    SketchKvMap map;
    CCArena arena;
} SketchShard;

typedef struct SketchDb {
    CCArena root;
    SketchShard* shards;
    size_t shard_count;
    size_t shard_mask;
} SketchDb;

typedef struct SketchKey {
    char[:] key;
    size_t h;
} SketchKey;

static SketchKey sketch_key(char[:] key) {
    CCSlicePackedView view;
    SketchKey sk;
    sk.key = key;
    sk.h = cc_map_hash_slice_packed(cc_slice_packed_borrow_slice(&view, key));
    return sk;
}

static size_t sketch_shard_index(const SketchDb* db, SketchKey sk) {
    if (!db || db->shard_count == 0) return 0;
    return sk.h & db->shard_mask;
}

static SketchShard* sketch_shard_at(SketchDb* db, size_t si) {
    if (!db || !db->shards || si >= db->shard_count) return NULL;
    return &db->shards[si];
}

static SketchShard* sketch_shard(SketchDb* db, SketchKey sk) {
    return sketch_shard_at(db, sketch_shard_index(db, sk));
}

static bool sketch_shard_init(SketchShard* sh) {
    if (!sh) return false;
    *sh = (SketchShard){0};
    sh->arena = cc_arena_malloc(REDIS_SKETCH_ARENA_ROOT);
    if (!sh->arena.valid()) return false;
    sh->map = table_new::[CCSlicePacked, CCString](sh->arena);
    return sh->map != NULL;
}

static void sketch_shard_destroy(SketchShard* sh) {
    if (!sh) return;
    if (sh->map) {
        sh->map->destroy();
        sh->map = NULL;
    }
    sh->arena.destroy();
}

static bool sketch_db_init(SketchDb* db, size_t shard_count) {
    size_t i;
    if (!db || shard_count == 0 ||
        shard_count > (size_t)REDIS_SKETCH_MAX_SHARDS)
        return false;
    if ((shard_count & (shard_count - 1u)) != 0) return false;
    memset(db, 0, sizeof(*db));
    db->shard_count = shard_count;
    db->shard_mask = shard_count - 1u;
    db->root = cc_arena_heap(shard_count * sizeof(SketchShard) + 64);
    if (!db->root.valid()) return false;
    db->shards =
        (SketchShard*)cc_arena_alloc(db->root, shard_count * sizeof(SketchShard),
                                     _Alignof(SketchShard));
    if (!db->shards) {
        db->root.destroy();
        *db = (SketchDb){0};
        return false;
    }
    memset(db->shards, 0, shard_count * sizeof(SketchShard));
    for (i = 0; i < shard_count; i++) {
        if (!sketch_shard_init(&db->shards[i])) {
            size_t j;
            for (j = 0; j < i; j++) sketch_shard_destroy(&db->shards[j]);
            db->root.destroy();
            *db = (SketchDb){0};
            return false;
        }
    }
    return true;
}

static void sketch_db_destroy(SketchDb* db) {
    size_t i;
    if (!db) return;
    if (db->shards) {
        for (i = 0; i < db->shard_count; i++)
            sketch_shard_destroy(&db->shards[i]);
        db->shards = NULL;
    }
    db->root.destroy();
    *db = (SketchDb){0};
}

/* FLUSHDB: rebuild every cell; keep shard count. */
static bool sketch_db_reset(SketchDb* db) {
    size_t i;
    if (!db || !db->shards) return false;
    for (i = 0; i < db->shard_count; i++) {
        sketch_shard_destroy(&db->shards[i]);
        if (!sketch_shard_init(&db->shards[i])) return false;
    }
    return true;
}

static size_t sketch_db_len(const SketchDb* db) {
    size_t i, total = 0;
    if (!db || !db->shards) return 0;
    for (i = 0; i < db->shard_count; i++) {
        SketchKvMap m = db->shards[i].map;
        if (m) total += m->len();
    }
    return total;
}

/* Interior pointer — only under an exclusive hold; do not stash past release. */
static CCString* sketch_get(SketchShard* sh, SketchKey sk) {
    CCSlicePackedView view;
    if (!sh || !sh->map) return NULL;
    return sh->map->get_ptr_h(cc_slice_packed_borrow_slice(&view, sk.key), sk.h);
}

static bool sketch_put(SketchShard* sh, SketchKey sk, char[:] val) {
    CCSlicePackedView view;
    CCSlicePacked pk;
    CCString* cur;
    CCString owned;
    CCSlicePacked !>(CCError) packed;
    CCSlicePacked durable;
    if (!sh || !sh->map) return false;
    pk = cc_slice_packed_borrow_slice(&view, sk.key);
    cur = sh->map->get_ptr_h(pk, sk.h);
    owned = cc_string_from_slice(sh->arena, val);
    if (owned.failed()) return false;

    if (cur) {
        cur->release(sh->arena);
        *cur = owned;
        return true;
    }

    packed = cc_slice_to_packed(&sk.key, sh->arena);
    if (!cc_is_ok(packed)) {
        owned.release(sh->arena);
        return false;
    }
    durable = packed.u.value;
    if (sh->map->insert(durable, owned) != 0) {
        owned.release(sh->arena);
        cc_slice_packed_release(sh->arena, &durable);
        return false;
    }
    return true;
}

static bool sketch_delete(SketchShard* sh, SketchKey sk) {
    CCSlicePackedView view;
    CCSlicePacked pk;
    size_t bucket = 0;
    size_t di;
    CCString* v;
    CCSlicePacked doomed;
    if (!sh || !sh->map) return false;
    pk = cc_slice_packed_borrow_slice(&view, sk.key);
    di = sh->map->find_dense_h(pk, sk.h, &bucket);
    if (di == SIZE_MAX) return false;
    v = sh->map->at_ptr(di);
    doomed = *sh->map->key_ptr(di);
    if (v) v->release(sh->arena);
    if (!sh->map->del_at(di, bucket)) return false;
    cc_slice_packed_release(sh->arena, &doomed);
    return true;
}

static size_t sketch_unique_shards(SketchDb* db, char[:]* keys, size_t nkeys,
                                   uint64_t* names, size_t cap) {
    size_t n = 0, i, j;
    if (!db || !keys || !names || cap == 0) return 0;
    for (i = 0; i < nkeys; i++) {
        SketchKey sk = sketch_key(keys[i]);
        uint64_t si = (uint64_t)sketch_shard_index(db, sk);
        int seen = 0;
        for (j = 0; j < n; j++) {
            if (names[j] == si) {
                seen = 1;
                break;
            }
        }
        if (!seen && n < cap) names[n++] = si;
    }
    return n;
}

#endif /* REDIS_SKETCH_KV_CCH */

/* Connection read buffer: one contiguous ring used for RESP framing.
 * Cap is the per-connection command-size ceiling — a single request
 * (array header + all bulk args) must fit; oversized frames fail the
 * fill with an I/O error and the connection closes.  Real Redis accepts
 * much larger values (hundreds of MB); this port documents the bound
 * instead of pretending unbounded.  Callers size `data`/`cap` (today:
 * 64 KiB on each connection fiber stack). */
typedef struct RespReader {
    char* data;
    size_t start;
    size_t end;
    size_t cap;
} RespReader;

typedef enum RespParseStatus {
    RESP_PARSE_ERROR = -1,
    RESP_PARSE_INCOMPLETE = 0,
    RESP_PARSE_OK = 1,
} RespParseStatus;

static RespReader rr_init(char* data, size_t cap) {
    RespReader r = {0};
    r.data = data;
    r.cap = cap;
    return r;
}

static size_t rr_write_capacity(RespReader* r) {
    if (!r || r->end >= r->cap) return 0;
    return r->cap - r->end;
}

static void rr_compact(RespReader* r) {
    if (r->start == 0) return;
    if (r->start == r->end) {
        r->start = 0;
        r->end = 0;
        return;
    }
    memmove(r->data, r->data + r->start, r->end - r->start);
    r->end -= r->start;
    r->start = 0;
}

static bool !>(CCIoError) rr_fill_common(RespReader* r, CCSocket* sock, bool nonblocking) {
    rr_compact(r);
    size_t avail = rr_write_capacity(r);
    if (avail == 0) {
        return cc_err(cc_io_error(CC_IO_INVALID_ARGUMENT));
    }

    /* One read: as many bytes as the reader still has room for. The
     * 64 KiB cap is the command-size ceiling; a 4K chunk here only
     * added syscalls on fat pipelines. */
    size_t n = 0;
    if (nonblocking) {
        /* Socket try is three-way: Ok(true)=data, Ok(false)=FIN, Err(BUSY)=EAGAIN.
         * At the fill layer, would-block means "no progress now" → Ok(false). */
        bool !>(CCIoError) res =
            sock->try_read_into(r->data + r->end, avail, &n);
        if (cc_is_err(res)) {
            CCIoError e = cc_error(res);
            if (e.base.kind == CC_IO_BUSY) return cc_ok(false);
            return cc_err(e);
        }
        if (!cc_value(res)) return cc_ok(false);  /* FIN */
    } else {
        /* No per-fill clock. EAGAIN parks until readable (client close /
         * dest cancel ends the wait). */
        bool more = sock->read_into(r->data + r->end, avail, &n) !>(e) {
            return cc_err(e);
        };
        if (!more) return cc_ok(false);  /* FIN */
    }
    r->end += n;
    return cc_ok(true);
}

static bool !>(CCIoError) rr_fill(RespReader* r, CCSocket* sock) {
    return rr_fill_common(r, sock, false);
}

static bool !>(CCIoError) rr_try_fill(RespReader* r, CCSocket* sock) {
    return rr_fill_common(r, sock, true);
}
static size_t !>(CCError) parse_inline_args(char[:] line, char[:]* args, size_t cap) {
    size_t argc = 0;
    size_t pos = 0;
    const char *data = line.ptr;
    while (pos < line.len && argc < cap) {
        while (pos < line.len && data[pos] == ' ') pos++;
        if (pos >= line.len) break;
        size_t start = pos;
        while (pos < line.len && data[pos] != ' ') pos++;
        args[argc++] = line.sub(start, pos);
    }
    /* Blank inline line (`\r\n` / whitespace-only): argc 0.  Callers skip
     * like Redis — do not turn it into a parse error. */
    return cc_ok(argc);
}

static size_t count_inline_tokens(char[:] line) {
    size_t n = 0, pos = 0;
    const char *data = line.ptr;
    while (pos < line.len) {
        while (pos < line.len && data[pos] == ' ') pos++;
        if (pos >= line.len) break;
        n++;
        while (pos < line.len && data[pos] != ' ') pos++;
    }
    return n;
}

/* Inline argv on `arena` — no compile-time slot cap. Bulk bytes stay a
 * borrow of `line` (the read buffer). */
static size_t !>(CCError) parse_inline_args_arena(char[:] line, CCArena arena,
                                                 char[:]** out_args) {
    size_t n = count_inline_tokens(line);
    char[:]* args;
    if (n == 0) {
        *out_args = NULL;
        return cc_ok(0);
    }
    args = cc_arena_alloc_T_count(CCSlice, arena, n);
    if (!args) return cc_err(CC_ERROR(CC_ERR_OUT_OF_MEMORY, "inline argv"));
    *out_args = args;
    return parse_inline_args(line, args, n);
}

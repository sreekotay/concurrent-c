typedef struct RespReader {
    char* data;
    size_t start;
    size_t end;
    size_t cap;
} RespReader;

typedef enum RespParseStatus {
    RESP_PARSE_ERROR = -1,
    RESP_PARSE_INCOMPLETE = 0,
    RESP_PARSE_OK = 1,
} RespParseStatus;

static RespReader rr_init(char* data, size_t cap) {
    RespReader r = {0};
    r.data = data;
    r.cap = cap;
    return r;
}

static size_t rr_write_capacity(RespReader* r) {
    if (!r || r->end >= r->cap) return 0;
    return r->cap - r->end;
}

static void rr_compact(RespReader* r) {
    if (r->start == 0) return;
    if (r->start == r->end) {
        r->start = 0;
        r->end = 0;
        return;
    }
    memmove(r->data, r->data + r->start, r->end - r->start);
    r->end -= r->start;
    r->start = 0;
}

static bool !>(CCIoError) rr_fill_common(RespReader* r, CCSocket* sock, bool nonblocking) {
    rr_compact(r);
    size_t avail = rr_write_capacity(r);
    if (avail == 0) {
        return cc_err(cc_io_error(CC_IO_INVALID_ARGUMENT));
    }

    /* One syscall's worth; capped by space left in the reader buffer. */
    const size_t max_read_chunk = 4096;
    size_t max_bytes = max_read_chunk;
    if (max_bytes > avail) max_bytes = avail;

    size_t n = 0;
    if (nonblocking) {
        /* Socket try is three-way: Ok(true)=data, Ok(false)=FIN, Err(BUSY)=EAGAIN.
         * At the fill layer, would-block means "no progress now" → Ok(false). */
        CCResult_bool_CCIoError res =
            cc_socket_try_read_into(sock, r->data + r->end, max_bytes, &n);
        if (cc_is_err(res)) {
            CCIoError e = cc_error(res);
            if (e.kind == CC_IO_BUSY) return cc_ok(false);
            return cc_err(e);
        }
        if (!cc_value(res)) return cc_ok(false);  /* FIN */
    } else {
        const int read_deadline_ms = 60000;
        CCDeadline deadline = cc_deadline_after_ms(read_deadline_ms);
        CCResult_bool_CCIoError res =
            cc_socket_read_into_deadline(sock, r->data + r->end, max_bytes, &n, &deadline);
        if (cc_is_err(res)) return cc_err(cc_error(res));
        if (!cc_value(res)) return cc_ok(false);  /* FIN */
    }
    r->end += n;
    return cc_ok(true);
}

static bool !>(CCIoError) rr_fill(RespReader* r, CCSocket* sock) {
    return rr_fill_common(r, sock, false);
}

static bool !>(CCIoError) rr_try_fill(RespReader* r, CCSocket* sock) {
    return rr_fill_common(r, sock, true);
}
static size_t !>(CCError) parse_inline_args(CCSlice line, CCSlice* args, size_t cap) {
    size_t argc = 0;
    size_t pos = 0;
    const char* data = (const char*)line.ptr;
    while (pos < line.len && argc < cap) {
        while (pos < line.len && data[pos] == ' ') pos++;
        if (pos >= line.len) break;
        size_t start = pos;
        while (pos < line.len && data[pos] != ' ') pos++;
        args[argc++] = CCSlice_sub(&line, start, pos);
    }
    if (argc == 0) return cc_err(CC_ERROR(CC_ERR_PARSE, "empty inline command"));
    return cc_ok(argc);
}

#!ccc ccs
/*
 * parallel_storm — walkable hello-storm leaf.
 *
 * One owned scene. Tiles are independent: disjoint framebuffer rows.
 * `hit` is a sequential fold over the sphere vec — not a fork.
 * Raylib is the window; this page never includes raylib.h.
 *
 *   click to capture mouse · esc releases · WASD move · shift sprint · q quit
 *
 *   STORM_MODE=for       default — @parallel for over scanlines
 *   STORM_MODE=unbound   quadtree, @parallel { } at every split
 *   STORM_MODE=quad      same tree, @parallel (d < STORM_CUT)
 *
 * ADT construct/flatten/drop is storm_tile.ccs — this file stays the
 * buffer renderer.
 */
#include <ccc/std/prelude.cch>
#include <ccc/stdio.cch>
#include <math.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include "storm_rl.h"
#include "storm_world.cch"

#define STORM_FRAME_CAP 64

static double g_ms_render[STORM_FRAME_CAP];

static void render_row(int y) {
    int x;
    @for (x in 0..g_w)
        put_rgb(x, y, pixel_at(x, y));
}

static void fill_tile(int x0, int y0, int size) {
    int x1 = x0 + size;
    int y1 = y0 + size;
    int x;
    int y;
    if (x0 < 0)
        x0 = 0;
    if (y0 < 0)
        y0 = 0;
    if (x1 > g_w)
        x1 = g_w;
    if (y1 > g_h)
        y1 = g_h;
    @for (y in y0..y1) {
        @for (x in x0..x1)
            put_rgb(x, y, pixel_at(x, y));
    }
}

static void render_for(int seq) {
    @errhandler(CCError e) cc_error_exit(e);
    if (seq) {
        int y;
        @for (y in 0..g_h)
            render_row(y);
        return;
    }
    @parallel for (y in 0..g_h) {
        render_row(y);
    } !>.wait()!>;
}

static int render_unbound(uint32_t d, int x0, int y0, int size) {
    @errhandler(CCError e) cc_error_exit(e);
    int half;
    int nw = 0;
    int ne = 0;
    int sw = 0;
    int se = 0;
    if (d >= g_qdepth || size <= 1) {
        fill_tile(x0, y0, size);
        return 0;
    }
    half = size / 2;
    if (half < 1) {
        fill_tile(x0, y0, size);
        return 0;
    }
    @parallel {
        nw = render_unbound(d + 1, x0, y0, half);
        ne = render_unbound(d + 1, x0 + half, y0, half);
        sw = render_unbound(d + 1, x0, y0 + half, half);
        se = render_unbound(d + 1, x0 + half, y0 + half, half);
    } !>.wait()!>;
    return nw + ne + sw + se;
}

static int render_quad(uint32_t d, int x0, int y0, int size) {
    @errhandler(CCError e) cc_error_exit(e);
    int half;
    int nw = 0;
    int ne = 0;
    int sw = 0;
    int se = 0;
    if (d >= g_qdepth || size <= 1) {
        fill_tile(x0, y0, size);
        return 0;
    }
    half = size / 2;
    if (half < 1) {
        fill_tile(x0, y0, size);
        return 0;
    }
    @parallel (d < g_cut) {
        nw = render_quad(d + 1, x0, y0, half);
        ne = render_quad(d + 1, x0 + half, y0, half);
        sw = render_quad(d + 1, x0, y0 + half, half);
        se = render_quad(d + 1, x0 + half, y0 + half, half);
    } !>.wait()!>;
    return nw + ne + sw + se;
}

#define MODE_FOR 0
#define MODE_UNBOUND 1
#define MODE_QUAD 2

static int parse_mode(void) {
    const char* s = getenv("STORM_MODE");
    if (!s || !s[0] || strcmp(s, "for") == 0)
        return MODE_FOR;
    if (strcmp(s, "unbound") == 0)
        return MODE_UNBOUND;
    if (strcmp(s, "quad") == 0 || strcmp(s, "cut") == 0)
        return MODE_QUAD;
    return -1;
}

static void render_frame(int mode, int seq) {
    if (seq || mode == MODE_FOR) {
        render_for(seq);
        return;
    }
    if (mode == MODE_UNBOUND)
        (void)render_unbound(0, 0, 0, cover_pow2(g_w, g_h));
    else
        (void)render_quad(0, 0, 0, cover_pow2(g_w, g_h));
}

int main(void) {
    @errhandler(CCError e) { cc_error_log(e); return 1; }

    int w = (int)env_u32("STORM_W", 1024);
    int h = (int)env_u32("STORM_H", 1024);
    int grid = (int)env_u32("STORM_GRID", 64);
    int seq = (int)env_u32("STORM_SEQ", 0);
    int win_w = (int)env_u32("STORM_WIN_W", 1024);
    int win_h = (int)env_u32("STORM_WIN_H", 1024);
    int mode = parse_mode();
    int nframes = (int)env_u32("STORM_FRAMES", 0);
    int headless = (int)env_u32("STORM_HEADLESS", 0);
    int cover;
    const char* title;
    const char* mode_name;
    size_t nbytes;
    Cam cam;
    Scene scene;
    int captured = 0;
    int fi = 0;
    int nkeep = 0;
    double last_ms = 0.0;

    CCArena store = cc_arena_heap(megabytes(8)) @destroy;
    if (!cc_arena_is_live(store)) {
        eprintln("storm: store arena alloc failed");
        return 1;
    }

    if (w < 64)
        w = 64;
    if (h < 36)
        h = 36;
    if (grid < 1)
        grid = 1;
    if (grid > 16)
        grid = 16;
    if (mode < 0) {
        eprintln("storm: STORM_MODE must be for, unbound, or quad");
        return 1;
    }

    g_cut = env_u32("STORM_CUT", 3);
    cover = cover_pow2(w, h);
    g_qdepth = cover_depth(cover);
    if (headless && nframes == 0)
        nframes = 8;
    if (nframes > STORM_FRAME_CAP)
        nframes = STORM_FRAME_CAP;

    nbytes = (size_t)w * (size_t)h * 4u;
    char[:] fb = store.alloc_slice_bytes(nbytes);
    if (fb.len != nbytes) {
        eprintln("storm: framebuffer alloc failed");
        return 1;
    }

    scene = (Scene){0};
    if (!build_scene(&scene, grid)) {
        eprintln("storm: scene init failed");
        return 1;
    }

    cam.pos = vec3(0.0, EYE, 6.0);
    cam.yaw = 0.0;
    cam.pitch = -0.12;

    g_scene = &scene;
    g_fb = (unsigned char*)fb.ptr;
    g_w = w;
    g_h = h;
    g_cam = cam;

    title = "parallel_storm for";
    mode_name = "for";
    if (mode == MODE_UNBOUND) {
        title = "parallel_storm unbound";
        mode_name = "unbound";
    } else if (mode == MODE_QUAD) {
        title = "parallel_storm quad";
        mode_name = "quad";
    }
    if (seq)
        mode_name = "seq";
    if (!headless)
        storm_rl_init(win_w, win_h, w, h, title);
    else
        fprintf(stderr, "storm %dx%d %s shade=%d gamma=%d cut=%u frames=%d\n",
                w, h, mode_name, shade_wanted(), fb_gamma(), g_cut, nframes);

    while (headless ? (nframes == 0 || fi < nframes)
                    : !storm_rl_should_close()) {
        float mdx = 0.0f;
        float mdy = 0.0f;
        double dt = headless ? 0.016 : (double)storm_rl_dt();
        Vec wish;
        double speed;
        Look look;
        CCString hud;
        const char* hud_c;
        double t0;
        double t1;
        int rms;

        if (!headless && nframes && fi >= nframes)
            break;

        if (dt <= 0.0 || dt > 0.08)
            dt = 0.016;

        if (!headless) {
            if (storm_rl_key_q())
                break;
            if (storm_rl_click())
                storm_rl_set_capture(1);
            if (storm_rl_key_esc_pressed())
                storm_rl_set_capture(0);
            captured = storm_rl_captured();

            storm_rl_mouse_delta(&mdx, &mdy);
            if (captured) {
                cam.yaw += (double)mdx * 0.0022;
                cam.pitch -= (double)mdy * 0.0022;
                if (cam.pitch < -1.4)
                    cam.pitch = -1.4;
                if (cam.pitch > 1.4)
                    cam.pitch = 1.4;
            }

            look = cam_look(cam, w, h);
            wish = vec3(0.0, 0.0, 0.0);
            if (storm_rl_key_w()) {
                Vec f = vec3(look.forward.x, 0.0, look.forward.z);
                wish = wish.add(f);
            }
            if (storm_rl_key_s()) {
                Vec f = vec3(look.forward.x, 0.0, look.forward.z);
                wish = wish.minus(f);
            }
            if (storm_rl_key_d()) {
                Vec r = vec3(look.right.x, 0.0, look.right.z);
                wish = wish.add(r);
            }
            if (storm_rl_key_a()) {
                Vec r = vec3(look.right.x, 0.0, look.right.z);
                wish = wish.minus(r);
            }
            if (wish.dot(wish) > 1.0e-8) {
                speed = storm_rl_key_shift() ? 10.0 : 5.0;
                wish = wish.norm();
                wish = wish.scale(speed * dt);
                cam.pos = cam.pos.add(wish);
            }
            collide(&cam, &scene);
        } else {
            look = cam_look(cam, w, h);
        }

        g_cam = cam;
        g_look = look;
        t0 = now_ms();
        render_frame(mode, seq);
        t1 = now_ms();
        last_ms = t1 - t0;
        if (fi > 0 && nkeep < STORM_FRAME_CAP) {
            g_ms_render[nkeep] = last_ms;
            nkeep++;
        }
        fi++;

        if (!headless) {
            rms = (int)(last_ms + 0.5);
            {
                cc_arena_stack(hud_a, 256);
                hud = @string(`${mode_name} · ${rms} ms · click look · wasd · q`, hud_a);
                hud_c = hud.cstr(hud_a);
                if (!hud_c)
                    hud_c = "";
                storm_rl_present(g_fb, hud_c);
            }
        }
    }

    if (!headless)
        storm_rl_shutdown();
    if (nkeep > 0) {
        double mr = storm_median(g_ms_render, nkeep);
        fprintf(stderr, "storm median n=%d  render=%.2f ms\n", nkeep, mr);
    }
    return 0;
}

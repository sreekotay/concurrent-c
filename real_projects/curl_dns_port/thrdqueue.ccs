#!ccc ccs
/*
 * Curl_thrdq — stock ABI. Not a dest. Not a channel.
 *
 * Pieces (this file is the composition):
 *   workers     nursery — late spawn, hybrid, wait vs leave
 *   jobs / done exclusive lists — retract / expire / drain
 *   inflight    idle ticket — items sent and not finished or retracted
 *   recv        — poll done (AGAIN if empty); host does not park
 *   live        — spawn_up_to / idle-exit (pool policy on the nursery)
 *
 * List shape (what a stdlib exclusive list would be):
 *   Vec::[Job] + one CCExclusive name; the vec is the extent
 *   end() arms the sentinel (closed); wait() is acquire_when(n>0 || closed)
 *   ended is closed && empty — take-side EMPTY, not fiber death
 *   a dest ticket could plant on wait() / wait_end(); leave still must not
 *
 * send / recv / clear / destroy are curl's names. getaddrinfo stays
 * blocking — dest-attach is a fiber, so the runner is n.spawnhybrid.
 * The worker is deadlock-suppressed: curl multi is the progress source,
 * not a sibling ticket. The list wait is the long park; done-push and
 * getaddrinfo sit on the same fiber.
 */
#include <ccc/cc_runtime.cch>
#include <ccc/cc_atomic.cch>
#include <ccc/cc_exclusive.cch>
#include <ccc/cc_exclusive_result.cch>
#include <ccc/std/vec.cch>

#include <stdlib.h>
#include <string.h>

#include "cc_thrdqueue.h"

__attribute__((used)) const char cc_curl_thrdq[] = "concurrent-c";

typedef struct {
    void *item;
    const char *description;
    CCDeadline expire;
} Job;

enum { LIST_JOBS = 0, LIST_DONE = 1, TICKET_IDLE = 2 };

/* Exclusive list: grower + one name. end() arms the sentinel (closed). */
typedef struct JobList {
    Vec::[Job] items;
    int closed;
    int ready;
    CCExclusive excl;
    uint64_t name;
} JobList;

/* Item-idle name. Distinct from list end: process() holds no list name. */
typedef struct {
    CCExclusive excl;
    uint64_t name;
    int left;
    int ready;
} IdleTicket;

typedef struct curl_thrdq CcThrdq;

struct curl_thrdq {
    JobList jobs;
    JobList done;
    IdleTicket inflight;
    CCArena lock_arena;
    CCArena bag_arena;
    CCExclusive locks;
    CCNursery workers;
    char *name;
    int aborted;
    Curl_thrdq_item_free_cb fn_free;
    Curl_thrdq_item_process_cb fn_process;
    Curl_thrdq_ev_cb fn_event;
    void *fn_user_data;
    uint32_t send_max_len;
    uint32_t min_threads;
    uint32_t max_threads;
    uint32_t idle_time_ms;
    cc_atomic_int live;
};

static void give_back(CcThrdq *q, void *item) {
    if (item)
        q->fn_free(item);
}

static int job_expired(const Job *j) {
    return j->expire.deadline.tv_sec != 0 && cc_deadline_expired(&j->expire);
}

/* --- exclusive list ----------------------------------------------------- */

static int JobList_ready_or_ended(void *env) {
    JobList *b = (JobList *)env;
    return b->items.len() > 0 || b->closed;
}

static void !>(CCError) JobList_init(JobList *b, CCExclusive excl, uint64_t name,
                                    CCArena arena) {
    memset(b, 0, sizeof(*b));
    if (!cc_exclusive_is_live(excl) || !cc_arena_is_live(arena))
        return cc_err(CC_ERROR(CC_ERR_INVALID_ARG, "JobList_init"));
    b->excl = excl;
    b->name = name;
    b->items = vec_new::[Job](arena);
    b->ready = 1;
    return cc_ok();
}

static void JobList_destroy(JobList *b) {
    if (!b->ready)
        return;
    b->items.destroy();
    b->excl.p = NULL;
    b->ready = 0;
}

static int JobList_live(JobList *b) {
    return b && b->ready && cc_exclusive_is_live(b->excl);
}

static CCExclusiveGuard JobList_hold(JobList *b) {
    return b->excl.acquire(b->name);
}

/* Park until a take is possible or end is armed. Dest ticket shape.
 * wait_end would be acquire_when(closed && empty) — curl waits fibers. */
static CCExclusiveGuard !>(CCError) JobList_wait(JobList *b) {
    return b->excl.acquire_when(b->name, JobList_ready_or_ended, b);
}

static void JobList_end(JobList *b) {
    CCExclusiveGuard g;
    if (!b->live())
        return;
    g = b->hold();
    @defer g.release();
    b->closed = 1;
    g.broadcast();
}

/* Caller holds this list. Empty is NOT_FOUND, not a silent 0. */
static Job !>(CCError) JobList_take0(JobList *b) {
    Job *p = b->items.get(0);
    Job keep;
    size_t w = 0;
    size_t i = 0;
    if (!p)
        return cc_err(CC_ERROR(CC_ERR_NOT_FOUND, "JobList_take0"));
    keep = *p;
    @for (j in b->items) {
        if (i++ == 0)
            continue;
        if (b->items.set(w, j) != 0)
            return cc_err(CC_ERROR(CC_ERR_INTERNAL, "JobList_take0"));
        w++;
    }
    b->items.truncate(w);
    return cc_ok(keep);
}

/* Caller holds this list. */
static void !>(CCError) JobList_append_held(JobList *b, Job job) {
    if (b->closed)
        return cc_err(CC_ERROR(CC_ERR_CLOSED, "JobList_append_held"));
    if (b->items.push(job) != 0)
        return cc_err(CC_ERROR(CC_ERR_OUT_OF_MEMORY, "JobList_append_held"));
    return cc_ok();
}

/* Caller holds this list. Returns how many items were retracted. */
static int JobList_remove_if_held(JobList *b, CcThrdq *q,
                                  Curl_thrdq_item_match_cb fn_match,
                                  void *match_data) {
    size_t w = 0;
    int dropped = 0;
    @for (j in b->items) {
        if (fn_match(j.item, match_data)) {
            dropped++;
            give_back(q, j.item);
        } else {
            b->items.set(w, j);
            w++;
        }
    }
    b->items.truncate(w);
    return dropped;
}

/* 0 ok, AGAIN if at max_len, SEND_ERROR if closed/refused, OOM if grow fails. */
static int JobList_push(JobList *b, Job job, uint32_t max_len, int refuse) {
    CCExclusiveGuard g;
    int rc = CC_CURLE_OK;
    if (!b->live())
        return CC_CURLE_SEND_ERROR;
    g = b->hold();
    @defer g.release();
    if (refuse || b->closed)
        rc = CC_CURLE_SEND_ERROR;
    else if (max_len && b->items.len() >= (size_t)max_len)
        rc = CC_CURLE_AGAIN;
    else {
        b->append_held(job) !>(e) {
            rc = (e.kind == CC_ERR_CLOSED) ? CC_CURLE_SEND_ERROR
                                           : CC_CURLE_OUT_OF_MEMORY;
        };
        if (rc == CC_CURLE_OK)
            g.signal();
    }
    return rc;
}

static int JobList_drain(JobList *b, CcThrdq *q) {
    CCExclusiveGuard g;
    int n;
    if (!b->live())
        return 0;
    g = b->hold();
    @defer g.release();
    n = (int)b->items.len();
    @for (j in b->items)
        give_back(q, j.item);
    b->items.clear();
    return n;
}

/* --- idle ticket (items, not fibers) ------------------------------------ */

static int IdleTicket_is_idle(void *env) {
    return ((IdleTicket *)env)->left == 0;
}

static void !>(CCError) IdleTicket_init(IdleTicket *t, CCExclusive excl,
                                       uint64_t name) {
    memset(t, 0, sizeof(*t));
    if (!cc_exclusive_is_live(excl))
        return cc_err(CC_ERROR(CC_ERR_INVALID_ARG, "IdleTicket_init"));
    t->excl = excl;
    t->name = name;
    t->ready = 1;
    return cc_ok();
}

static int IdleTicket_live(IdleTicket *t) {
    return t && t->ready && cc_exclusive_is_live(t->excl);
}

/* Do not call while holding LIST_JOBS / LIST_DONE. */
static void IdleTicket_note(IdleTicket *t, int delta) {
    CCExclusiveGuard g;
    if (!t->live() || !delta)
        return;
    g = t->excl.acquire(t->name);
    @defer g.release();
    t->left += delta;
    if (t->left == 0)
        g.broadcast();
}

static int IdleTicket_wait(IdleTicket *t, uint32_t timeout_ms) {
    CCExclusiveGuard g;
    CCDeadline *prev = NULL;
    CCDeadline idle;
    if (!t->live())
        return CC_CURLE_FAILED_INIT;
    if (timeout_ms) {
        idle = cc_deadline_after_ms(timeout_ms);
        prev = cc_deadline_push(&idle);
    }
    @defer {
        if (prev)
            cc_deadline_pop(prev);
    }
    g = t->excl.acquire_when(t->name, IdleTicket_is_idle, t) !>(e) {
        if (e.kind == CC_ERR_TIMEOUT)
            return CC_CURLE_OPERATION_TIMEDOUT;
        return CC_CURLE_FAILED_INIT;
    };
    @defer g.release();
    return CC_CURLE_OK;
}

static void note_items_done(CcThrdq *q, int n) {
    if (!n)
        return;
    q->inflight.note(-n);
    if (q->fn_event)
        q->fn_event(q, CURL_THRDQ_EV_ITEM_DONE, q->fn_user_data);
}

/* --- park (worker): wait the jobs list, expire under both holds --------- */

/* TIMEOUT idle wait. CLOSED when end is armed and the list is empty. */
static Job !>(CCError) take_job(CcThrdq *q, const CCDeadline *dl) {
    CCDeadline *prev = NULL;
    CCDeadline idle;
    if (!q->jobs.live() || !q->done.live())
        return cc_err(CC_ERROR(CC_ERR_CLOSED, "take_job"));
    if (dl && dl->deadline.tv_sec) {
        idle = *dl;
        prev = cc_deadline_push(&idle);
    }
    @defer {
        if (prev)
            cc_deadline_pop(prev);
    }
    for (;;) {
        CCExclusiveGuard g_jobs;
        CCExclusiveGuard g_done;
        Job *head;
        Job got;
        int skipped = 0;
        /* Host event loop is the progress source; this wait is outside
         * the runtime dependency graph. Suppress is this wait only. */
        {
            cc_deadlock_suppress_enter();
            @defer cc_deadlock_suppress_leave();
            g_jobs = q->jobs.wait() !>(e) {
                return cc_err(e);
            };
        }
        @defer g_jobs.release();
        g_done = q->done.hold();
        @defer g_done.release();
        while ((head = q->jobs.items.get(0)) && job_expired(head)) {
            Job exp = q->jobs.take0() !>(e) {
                return cc_err(e);
            };
            q->done.append_held(exp) !>(e) {
                (void)e;
                give_back(q, exp.item);
            };
            skipped++;
        }
        got = q->jobs.take0() !>(e) {
            note_items_done(q, skipped);
            if (e.kind == CC_ERR_NOT_FOUND && q->jobs.closed)
                return cc_err(CC_ERROR(CC_ERR_CLOSED, "take_job"));
            if (e.kind == CC_ERR_NOT_FOUND)
                continue;
            return cc_err(e);
        };
        note_items_done(q, skipped);
        return cc_ok(got);
    }
}

/* --- join vs leave ------------------------------------------------------ */

static void q_release_storage(CcThrdq *q) {
    if (!q)
        return;
    q->jobs.destroy();
    q->done.destroy();
    if (cc_exclusive_is_live(q->locks)) {
        q->locks.destroy();
        q->locks.p = NULL;
    }
    if (cc_arena_is_live(q->bag_arena))
        q->bag_arena.destroy();
    q->lock_arena.destroy();
    free(q->name);
    q->name = NULL;
    free(q);
}

static void mark_aborted(CcThrdq *q) {
    CCExclusiveGuard gs[2];
    if (!q)
        return;
    q->aborted = 1;
    if (!cc_exclusive_is_live(q->locks))
        return;
    if (q->locks.acquire_range(LIST_JOBS, LIST_DONE + 1, gs, 2) == 2)
        gs[0].release_n(2);
}

/* Drain + end jobs. Join still waits fibers; leave does not. */
static void abort_open_jobs(CcThrdq *q) {
    int dropped = q->jobs.drain(q);
    q->jobs.end();
    if (dropped)
        q->inflight.note(-dropped);
}

/* Give back queued jobs (do not run), end() (sentinel; wakes wait()),
 * wait in-flight process, give back leftover done, free q. */
static void CcThrdq_teardown(CcThrdq *q) {
    CCNursery w;
    if (!q)
        return;
    mark_aborted(q);
    abort_open_jobs(q);
    w = q->workers;
    if (cc_nursery_is_live(w))
        w.wait() !>;
    q->done.drain(q);
    if (cc_nursery_is_live(w)) {
        w.free();
        q->workers.p = NULL;
    }
    q_release_storage(q);
}

/* --- pool policy: late spawn / idle-exit -------------------------------- */

static void worker(CcThrdq *q) {
    /* Host multi drives send/clear/destroy. Parks here are not a cycle. */
    cc_deadlock_suppress_enter();
    @defer cc_deadlock_suppress_leave();

    for (;;) {
        int n = q->live.load();
        CCDeadline idle = (q->idle_time_ms && n > (int)q->min_threads)
            ? cc_deadline_after_ms(q->idle_time_ms)
            : cc_deadline_none();
        Job job = take_job(q, &idle) !>(e) {
            if (e.kind == CC_ERR_TIMEOUT) {
                n = q->live.load();
                if (n > (int)q->min_threads && q->live.cas(&n, n - 1))
                    return;
                continue;
            }
            return;
        };

        if (job.item)
            q->fn_process(job.item);
        if (q->done.push(job, 0, q->aborted) != CC_CURLE_OK)
            give_back(q, job.item);
        note_items_done(q, 1);
    }
}

/* LEFT leftover at EMPTY: workers are already dead. Do not wait/free the nursery. */
static void finish_q(void *arg) {
    CcThrdq *q = (CcThrdq *)arg;
    if (!q)
        return;
    q->done.drain(q);
    q->workers.p = NULL;
    q_release_storage(q);
}

/* Take a live slot below `cap` and spawn. 1 spawned, 0 already at cap, -1 failed.
 * cas writes the current live back into n on failure — the loop reloads. */
static int spawn_up_to(CcThrdq *q, int cap) {
    CCNursery w = q->workers;
    int n = q->live.load();
    while (n < cap) {
        if (!q->live.cas(&n, n + 1))
            continue;
        if (!cc_nursery_is_live(w)) {
            q->live.fetch_add(-1);
            return -1;
        }
        w.spawnhybrid(() => [q] { worker(q); }) !>(e) {
            (void)e;
            q->live.fetch_add(-1);
            return -1;
        };
        return 1;
    }
    return 0;
}

static void !>(CCError) q_boot(CcThrdq *q, const char *name) {
    q->name = strdup(name ? name : "");
    if (!q->name)
        return cc_err(CC_ERROR(CC_ERR_OUT_OF_MEMORY, "q_boot"));
    q->lock_arena = cc_arena_heap(kilobytes(16));
    if (!cc_arena_is_live(q->lock_arena))
        return cc_err(CC_ERROR(CC_ERR_OUT_OF_MEMORY, "q_boot"));
    q->locks = q->lock_arena.create_exclusive(4) !>;
    q->bag_arena = cc_arena_heap(kilobytes(64));
    if (!cc_arena_is_live(q->bag_arena))
        return cc_err(CC_ERROR(CC_ERR_OUT_OF_MEMORY, "q_boot"));
    q->jobs.init(q->locks, LIST_JOBS, q->bag_arena) !>;
    q->done.init(q->locks, LIST_DONE, q->bag_arena) !>;
    q->inflight.init(q->locks, TICKET_IDLE) !>;
    q->workers = cc_nursery_create() !>;
    if (!cc_nursery_is_live(q->workers))
        return cc_err(CC_ERROR(CC_ERR_INTERNAL, "q_boot"));
    return cc_ok();
}

/* --- Curl_thrdq ABI ----------------------------------------------------- */

int Curl_thrdq_set_props(struct curl_thrdq *q, uint32_t max_len,
                         uint32_t min_threads, uint32_t max_threads,
                         uint32_t idle_time_ms) {
    if (!q)
        return CC_CURLE_FAILED_INIT;
    if (!max_threads || min_threads > max_threads)
        return CC_CURLE_BAD_FUNCTION_ARGUMENT;

    q->send_max_len = max_len;
    q->min_threads = min_threads;
    q->max_threads = max_threads;
    q->idle_time_ms = idle_time_ms;

    while (q->live.load() < (int)min_threads) {
        if (spawn_up_to(q, (int)min_threads) < 0)
            return CC_CURLE_OUT_OF_MEMORY;
    }
    return CC_CURLE_OK;
}

int Curl_thrdq_create(struct curl_thrdq **ptqueue, const char *name,
                      uint32_t max_len, uint32_t min_threads,
                      uint32_t max_threads, uint32_t idle_time_ms,
                      Curl_thrdq_item_free_cb fn_free,
                      Curl_thrdq_item_process_cb fn_process,
                      Curl_thrdq_ev_cb fn_event, void *user_data) {
    CcThrdq *q;
    int rc;

    *ptqueue = NULL;
    if (!fn_free || !fn_process)
        return CC_CURLE_FAILED_INIT;
    if (!max_threads || min_threads > max_threads)
        return CC_CURLE_BAD_FUNCTION_ARGUMENT;

    q = (CcThrdq *)calloc(1, sizeof(*q));
    if (!q)
        return CC_CURLE_OUT_OF_MEMORY;
    q->fn_free = fn_free;
    q->fn_process = fn_process;
    q->fn_event = fn_event;
    q->fn_user_data = user_data;
    q_boot(q, name) !>(e) {
        (void)e;
        q->teardown();
        return CC_CURLE_OUT_OF_MEMORY;
    };

    rc = Curl_thrdq_set_props(q, max_len, min_threads, max_threads,
                              idle_time_ms);
    if (rc != CC_CURLE_OK) {
        q->teardown();
        return rc;
    }
    *ptqueue = q;
    return CC_CURLE_OK;
}

int Curl_thrdq_send(struct curl_thrdq *q, void *item, const char *description,
                    int64_t timeout_ms) {
    Job job = {0};
    int rc;

    (void)description;
    if (!q || !item)
        return CC_CURLE_SEND_ERROR;
    if (timeout_ms < 0)
        return CC_CURLE_OPERATION_TIMEDOUT;

    job.item = item;
    job.description = description;
    job.expire = timeout_ms > 0 ? cc_deadline_after_ms((uint32_t)timeout_ms)
                                : cc_deadline_none();

    rc = q->jobs.push(job, q->send_max_len, q->aborted);
    if (rc != CC_CURLE_OK)
        return rc;
    q->inflight.note(1);
    /* Item is already owned. Spawn failure is not reported (stock signals
     * the pool unlocked and ignores the error). */
    (void)spawn_up_to(q, (int)q->max_threads);
    return CC_CURLE_OK;
}

int Curl_thrdq_recv(struct curl_thrdq *q, void **pitem) {
    Job job;
    CCExclusiveGuard g;
    *pitem = NULL;
    if (!q)
        return CC_CURLE_FAILED_INIT;
    if (!q->done.live())
        return CC_CURLE_FAILED_INIT;
    g = q->done.hold();
    @defer g.release();
    if (q->aborted)
        return CC_CURLE_RECV_ERROR;
    job = q->done.take0() !>(e) {
        if (e.kind == CC_ERR_NOT_FOUND)
            return CC_CURLE_AGAIN;
        return CC_CURLE_RECV_ERROR;
    };
    *pitem = job.item;
    return CC_CURLE_OK;
}

int Curl_thrdq_await_done(struct curl_thrdq *q, uint32_t timeout_ms) {
    if (!q)
        return CC_CURLE_FAILED_INIT;
    return q->inflight.wait(timeout_ms);
}

void Curl_thrdq_clear(struct curl_thrdq *tqueue,
                      Curl_thrdq_item_match_cb fn_match, void *match_data) {
    CcThrdq *q = tqueue;
    CCExclusiveGuard gs[2];
    int dropped;
    if (!q || !fn_match)
        return;
    if (!cc_exclusive_is_live(q->locks) || !q->jobs.live() || !q->done.live())
        return;
    if (q->locks.acquire_range(LIST_JOBS, LIST_DONE + 1, gs, 2) != 2)
        abort();
    @defer gs[0].release_n(2);
    dropped = q->jobs.remove_if_held(q, fn_match, match_data);
    q->done.remove_if_held(q, fn_match, match_data);
    if (dropped)
        q->inflight.note(-dropped);
}

/* curl multi quick_exit: process is dying — do not block on getaddrinfo. */
static void detach_teardown(CcThrdq *q) {
    CCNursery w;
    if (!q)
        return;
    mark_aborted(q);
    abort_open_jobs(q);
    w = q->workers;
    if (!cc_nursery_is_live(w)) {
        finish_q(q);
        return;
    }
    q->fn_event = NULL;
    q->fn_user_data = NULL;
    w.leave(q, finish_q) !>;
}

void Curl_thrdq_destroy(struct curl_thrdq *tqueue, bool join) {
    CcThrdq *q = tqueue;
    if (!q)
        return;
    if (join)
        q->teardown();
    else
        detach_teardown(q);
}

void Curl_thrdq_trace(struct curl_thrdq *q, struct Curl_easy *data) {
    CCExclusiveGuard gs[2];
    (void)data;
    if (!q)
        return;
    /* This TU does not include curl_trc. Walk under the same hold as
     * clear so name / descriptions stay live and the ABI is not a no-op. */
    if (!cc_exclusive_is_live(q->locks) || !q->jobs.live() || !q->done.live())
        return;
    if (q->locks.acquire_range(LIST_JOBS, LIST_DONE + 1, gs, 2) != 2)
        return;
    @defer gs[0].release_n(2);
    (void)q->name;
    @for (j in q->jobs.items)
        (void)j.description;
    @for (j in q->done.items)
        (void)j.description;
}

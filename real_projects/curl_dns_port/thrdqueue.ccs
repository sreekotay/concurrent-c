#!ccc ccs
/*
 * Curl_thrdq — stock ABI, nursery-owned pool.
 *
 * Owned here: workers nursery, jobs/done bags, live (min always, max ever).
 * Not owned: the void* item. send carries it; recv or give_back (their
 * fn_free) returns it. No third state.
 *
 *   create   jobs/done bags + min workers
 *   send     push jobs; live < max ⇒ spawn a hybrid worker
 *   worker   take (expired-while-queued → done, no process) →
 *            fn_process → push done (or give_back)
 *            idle-exit only when live > min
 *   recv     try-pop done (AGAIN if empty)
 *   clear    retract both bags under one sorted hold (jobs then done)
 *   destroy  give_back queued jobs (do not run), close jobs,
 *            join: wait in-flight getaddrinfo, give_back leftover done, free q
 *            detach: revoke listener, then workers.leave(q, finish_q)
 *
 * getaddrinfo stays blocking. The bags are lists you can retract from.
 * Exclusive acquire_when is the bag wait and await_done (not a channel).
 * The nursery is the join.
 */
#include <ccc/cc_runtime.cch>
#include <ccc/cc_atomic.cch>
#include <ccc/cc_exclusive.cch>
#include <ccc/cc_exclusive_result.cch>

#include <errno.h>
#include <stdlib.h>
#include <string.h>

#include "cc_thrdqueue.h"

__attribute__((used)) const char cc_curl_thrdq[] = "concurrent-c";

typedef struct {
    void *item;
    const char *description;
    CCDeadline expire;
} Job;

typedef struct {
    Job *a;
    int n;
    int cap;
    int closed;
    int ready;
    CCExclusive excl;
    uint64_t name;
} JobBag;

typedef struct curl_thrdq CcThrdq;

enum { BAG_JOBS = 0, BAG_DONE = 1, BAG_AWAIT = 2 };

struct curl_thrdq {
    JobBag jobs;
    JobBag done;
    CCArena lock_arena;
    CCExclusive locks;
    CCNursery workers;
    char *name;
    int aborted;
    Curl_thrdq_item_free_cb fn_free;
    Curl_thrdq_item_process_cb fn_process;
    Curl_thrdq_ev_cb fn_event;
    void *fn_user_data;
    uint32_t send_max_len;
    uint32_t min_threads;
    uint32_t max_threads;
    uint32_t idle_time_ms;
    cc_atomic_int live;
    int await_left; /* BAG_AWAIT: sent and not yet finished or retracted */
};

static void give_back(CcThrdq *q, void *item) {
    if (item)
        q->fn_free(item);
}

static int bag_has_item(void *env) {
    JobBag *b = (JobBag *)env;
    return b->n > 0 || b->closed;
}

static int await_is_idle(void *env) {
    return ((CcThrdq *)env)->await_left == 0;
}

/* Hold BAG_AWAIT only. Do not call while holding BAG_JOBS / BAG_DONE. */
static void await_note(CcThrdq *q, int delta) {
    CCExclusive locks;
    CCExclusiveGuard g;
    if (!q || !delta)
        return;
    locks = q->locks;
    if (!cc_exclusive_is_live(locks))
        return;
    g = locks.acquire(BAG_AWAIT);
    q->await_left += delta;
    if (q->await_left == 0)
        g.broadcast();
    g.release();
}

static int JobBag_init(JobBag *b, CCExclusive excl, uint64_t name) {
    memset(b, 0, sizeof(*b));
    if (!cc_exclusive_is_live(excl))
        return -1;
    b->excl = excl;
    b->name = name;
    b->ready = 1;
    return 0;
}

static void JobBag_destroy(JobBag *b) {
    if (!b->ready)
        return;
    free(b->a);
    b->a = NULL;
    b->n = b->cap = 0;
    b->excl.p = NULL;
    b->ready = 0;
}

static int JobBag_grow(JobBag *b) {
    int cap = b->cap ? b->cap * 2 : 8;
    Job *a = (Job *)realloc(b->a, (size_t)cap * sizeof(Job));
    if (!a)
        return -1;
    b->a = a;
    b->cap = cap;
    return 0;
}

static void JobBag_take0(JobBag *b, Job *out) {
    *out = b->a[0];
    b->n--;
    if (b->n)
        memmove(b->a, b->a + 1, (size_t)b->n * sizeof(Job));
}

static int job_expired(const Job *j) {
    return j->expire.deadline.tv_sec != 0 && cc_deadline_expired(&j->expire);
}

/* Caller holds this bag. */
static int JobBag_append_held(JobBag *b, Job job) {
    if (b->closed)
        return -1;
    if (b->n == b->cap && JobBag_grow(b) != 0)
        return -1;
    b->a[b->n++] = job;
    return 0;
}

/* Caller holds this bag. Returns how many jobs-bag matches were retracted. */
static int JobBag_remove_if_held(JobBag *b, CcThrdq *q, int from_jobs,
                                 Curl_thrdq_item_match_cb fn_match,
                                 void *match_data) {
    int i, w, dropped;
    w = 0;
    dropped = 0;
    for (i = 0; i < b->n; i++) {
        if (fn_match(b->a[i].item, match_data)) {
            if (from_jobs)
                dropped++;
            give_back(q, b->a[i].item);
        } else {
            b->a[w++] = b->a[i];
        }
    }
    b->n = w;
    return dropped;
}

/* 0 ok, AGAIN if at max_len, SEND_ERROR if closed/aborted, OOM if grow fails. */
static int JobBag_push(JobBag *b, CcThrdq *q, Job job, uint32_t max_len) {
    CCExclusiveGuard g;
    int rc = CC_CURLE_OK;
    if (!cc_exclusive_is_live(b->excl))
        return CC_CURLE_SEND_ERROR;
    g = b->excl.acquire(b->name);
    if (q->aborted || b->closed)
        rc = CC_CURLE_SEND_ERROR;
    else if (max_len && b->n >= (int)max_len)
        rc = CC_CURLE_AGAIN;
    else if (b->n == b->cap && JobBag_grow(b) != 0)
        rc = CC_CURLE_OUT_OF_MEMORY;
    else {
        b->a[b->n++] = job;
        g.signal();
    }
    g.release();
    return rc;
}

/* 0 took a live job. ETIMEDOUT idle wait. EPIPE closed and empty.
 * Expired heads move to done under jobs+done (no process), then ITEM_DONE. */
static int take_job(CcThrdq *q, Job *out, const CCDeadline *dl) {
    JobBag *jobs = &q->jobs;
    JobBag *done = &q->done;
    CCDeadline *prev = NULL;
    CCDeadline idle;
    if (!cc_exclusive_is_live(jobs->excl) || !cc_exclusive_is_live(done->excl))
        return EPIPE;
    if (dl && dl->deadline.tv_sec) {
        idle = *dl;
        prev = cc_deadline_push(&idle);
    }
    for (;;) {
        CCExclusiveGuard !>(CCError) r;
        CCExclusiveGuard g_jobs;
        CCExclusiveGuard g_done;
        Job exp;
        int skipped = 0;
        int got = 0;
        int closed;
        /* An empty worker pool is intentionally parked until libcurl sends
         * more work or closes the bag; the host event loop is the progress
         * source, so this wait is outside the runtime dependency graph. */
        cc_deadlock_suppress_enter();
        r = jobs->excl.acquire_when(jobs->name, bag_has_item, jobs);
        cc_deadlock_suppress_leave();
        if (cc_is_err(r)) {
            if (prev)
                cc_deadline_pop(prev);
            if (r.u.error.kind == CC_ERR_TIMEOUT)
                return ETIMEDOUT;
            return EPIPE;
        }
        g_jobs = r.u.value;
        g_done = done->excl.acquire(done->name);
        while (jobs->n > 0 && job_expired(&jobs->a[0])) {
            JobBag_take0(jobs, &exp);
            if (JobBag_append_held(done, exp) != 0)
                give_back(q, exp.item);
            skipped++;
        }
        if (jobs->n > 0) {
            JobBag_take0(jobs, out);
            got = 1;
        }
        closed = jobs->closed;
        g_done.release();
        g_jobs.release();
        if (skipped) {
            await_note(q, -skipped);
            if (q->fn_event)
                q->fn_event(q, CURL_THRDQ_EV_ITEM_DONE, q->fn_user_data);
        }
        if (got) {
            if (prev)
                cc_deadline_pop(prev);
            return 0;
        }
        if (closed) {
            if (prev)
                cc_deadline_pop(prev);
            return EPIPE;
        }
    }
}

static void JobBag_close(JobBag *b) {
    CCExclusiveGuard g;
    if (!b->ready || !cc_exclusive_is_live(b->excl))
        return;
    g = b->excl.acquire(b->name);
    b->closed = 1;
    g.broadcast();
    g.release();
}

static int JobBag_drain(JobBag *b, CcThrdq *q) {
    CCExclusiveGuard g;
    int i, n;
    if (!b->ready || !cc_exclusive_is_live(b->excl))
        return 0;
    g = b->excl.acquire(b->name);
    n = b->n;
    for (i = 0; i < n; i++)
        give_back(q, b->a[i].item);
    b->n = 0;
    g.release();
    return n;
}

static void q_release_storage(CcThrdq *q) {
    JobBag *jobs;
    JobBag *done;
    if (!q)
        return;
    jobs = &q->jobs;
    done = &q->done;
    jobs->destroy();
    done->destroy();
    if (cc_exclusive_is_live(q->locks)) {
        q->locks.destroy();
        q->locks.p = NULL;
    }
    q->lock_arena.destroy();
    free(q->name);
    q->name = NULL;
    free(q);
}

static void mark_aborted(CcThrdq *q) {
    CCExclusive locks;
    CCExclusiveGuard gs[2];
    if (!q)
        return;
    locks = q->locks;
    if (!cc_exclusive_is_live(locks)) {
        q->aborted = 1;
        return;
    }
    if (locks.acquire_range(BAG_JOBS, BAG_DONE + 1, gs, 2) == 2) {
        q->aborted = 1;
        {
            CCExclusiveGuard *held = gs;
            held->release_n(2);
        }
    } else {
        q->aborted = 1;
    }
}

/* Give back queued jobs (do not run), close (wakes workers), wait
 * in-flight process, give back leftover done, free q. */
static void CcThrdq_teardown(CcThrdq *q) {
    CCNursery w;
    if (!q)
        return;
    mark_aborted(q);
    {
        JobBag *jobs = &q->jobs;
        int dropped = jobs->drain(q);
        jobs->close();
        if (dropped)
            await_note(q, -dropped);
    }
    w = q->workers;
    if (cc_nursery_is_live(w))
        w.wait() !>;
    {
        JobBag *done = &q->done;
        done->drain(q);
    }
    if (cc_nursery_is_live(w)) {
        w.free();
        q->workers.p = NULL;
    }
    q_release_storage(q);
}

static void worker(CcThrdq *q) {
    JobBag *done = &q->done;

    for (;;) {
        Job job = {0};
        int n = q->live.load();
        CCDeadline idle = (q->idle_time_ms && n > (int)q->min_threads)
            ? cc_deadline_after_ms(q->idle_time_ms)
            : cc_deadline_none();
        int rc = take_job(q, &job, &idle);
        if (rc == ETIMEDOUT) {
            n = q->live.load();
            if (n > (int)q->min_threads && q->live.cas(&n, n - 1))
                return;
            continue;
        }
        if (rc != 0)
            break;

        if (job.item)
            q->fn_process(job.item);
        if (done->push(q, job, 0) != CC_CURLE_OK)
            give_back(q, job.item);
        if (q->fn_event)
            q->fn_event(q, CURL_THRDQ_EV_ITEM_DONE, q->fn_user_data);
        await_note(q, -1);
    }
}

static int spawn_worker(CCNursery n, CcThrdq *q) {
    if (!cc_nursery_is_live(n))
        return -1;
    n.spawnhybrid(() => [q] { worker(q); }) !>(e) {
        (void)e;
        return -1;
    };
    return 0;
}

/* LEFT leftover at EMPTY: workers are already dead. Do not wait/free the nursery. */
static void finish_q(void *arg) {
    CcThrdq *q = (CcThrdq *)arg;
    JobBag *done;
    JobBag *jobs;
    if (!q)
        return;
    done = &q->done;
    jobs = &q->jobs;
    done->drain(q);
    q->workers.p = NULL;
    q_release_storage(q);
}

/* Take a live slot below `cap` and spawn. 1 spawned, 0 already at cap, -1 failed.
 * cas writes the current live back into n on failure — the loop reloads. */
static int spawn_up_to(CcThrdq *q, int cap) {
    CCNursery w = q->workers;
    int n = q->live.load();
    while (n < cap) {
        if (!q->live.cas(&n, n + 1))
            continue;
        if (spawn_worker(w, q) != 0) {
            q->live.fetch_add(-1);
            return -1;
        }
        return 1;
    }
    return 0;
}

int Curl_thrdq_set_props(struct curl_thrdq *q, uint32_t max_len,
                         uint32_t min_threads, uint32_t max_threads,
                         uint32_t idle_time_ms) {
    if (!q)
        return CC_CURLE_FAILED_INIT;
    if (!max_threads || min_threads > max_threads)
        return CC_CURLE_BAD_FUNCTION_ARGUMENT;

    q->send_max_len = max_len;
    q->min_threads = min_threads;
    q->max_threads = max_threads;
    q->idle_time_ms = idle_time_ms;

    while (q->live.load() < (int)min_threads) {
        if (spawn_up_to(q, (int)min_threads) < 0)
            return CC_CURLE_OUT_OF_MEMORY;
    }
    return CC_CURLE_OK;
}

int Curl_thrdq_create(struct curl_thrdq **ptqueue, const char *name,
                      uint32_t max_len, uint32_t min_threads,
                      uint32_t max_threads, uint32_t idle_time_ms,
                      Curl_thrdq_item_free_cb fn_free,
                      Curl_thrdq_item_process_cb fn_process,
                      Curl_thrdq_ev_cb fn_event, void *user_data) {
    CcThrdq *q;
    int rc;

    *ptqueue = NULL;
    if (!fn_free || !fn_process)
        return CC_CURLE_FAILED_INIT;
    if (!max_threads || min_threads > max_threads)
        return CC_CURLE_BAD_FUNCTION_ARGUMENT;

    q = (CcThrdq *)calloc(1, sizeof(*q));
    if (!q)
        return CC_CURLE_OUT_OF_MEMORY;
    q->fn_free = fn_free;
    q->fn_process = fn_process;
    q->fn_event = fn_event;
    q->fn_user_data = user_data;
    q->name = strdup(name ? name : "");
    if (!q->name) {
        q->teardown();
        return CC_CURLE_OUT_OF_MEMORY;
    }

    q->lock_arena = cc_arena_heap(kilobytes(16));
    if (!cc_arena_is_live(q->lock_arena)) {
        q->teardown();
        return CC_CURLE_OUT_OF_MEMORY;
    }
    q->locks = cc_exclusive_create(q->lock_arena, 4) !>(e) {
        (void)e;
        q->teardown();
        return CC_CURLE_OUT_OF_MEMORY;
    };
    {
        JobBag *jobs = &q->jobs;
        JobBag *done = &q->done;
        if (jobs->init(q->locks, BAG_JOBS) != 0 ||
            done->init(q->locks, BAG_DONE) != 0) {
            q->teardown();
            return CC_CURLE_OUT_OF_MEMORY;
        }
    }

    q->workers = cc_nursery_create() !>(e) {
        (void)e;
        q->teardown();
        return CC_CURLE_OUT_OF_MEMORY;
    };
    if (!cc_nursery_is_live(q->workers)) {
        q->teardown();
        return CC_CURLE_OUT_OF_MEMORY;
    }

    rc = Curl_thrdq_set_props(q, max_len, min_threads, max_threads,
                              idle_time_ms);
    if (rc != CC_CURLE_OK) {
        q->teardown();
        return rc;
    }
    *ptqueue = q;
    return CC_CURLE_OK;
}

int Curl_thrdq_send(struct curl_thrdq *q, void *item, const char *description,
                    int64_t timeout_ms) {
    Job job = {0};
    int rc;

    (void)description;
    if (!q || !item)
        return CC_CURLE_SEND_ERROR;
    if (timeout_ms < 0)
        return CC_CURLE_OPERATION_TIMEDOUT;

    job.item = item;
    job.description = description;
    job.expire = timeout_ms > 0 ? cc_deadline_after_ms((uint32_t)timeout_ms)
                                : cc_deadline_none();

    {
        JobBag *jobs = &q->jobs;
        rc = jobs->push(q, job, q->send_max_len);
    }
    if (rc != CC_CURLE_OK)
        return rc;
    await_note(q, 1);
    /* Item is already owned. Spawn failure is not reported (stock signals
     * the pool unlocked and ignores the error). */
    (void)spawn_up_to(q, (int)q->max_threads);
    return CC_CURLE_OK;
}

int Curl_thrdq_recv(struct curl_thrdq *q, void **pitem) {
    Job job = {0};
    JobBag *done;
    CCExclusiveGuard g;
    *pitem = NULL;
    if (!q)
        return CC_CURLE_FAILED_INIT;
    done = &q->done;
    if (!cc_exclusive_is_live(done->excl))
        return CC_CURLE_FAILED_INIT;
    g = done->excl.acquire(done->name);
    if (q->aborted) {
        g.release();
        return CC_CURLE_RECV_ERROR;
    }
    if (done->n > 0) {
        JobBag_take0(done, &job);
        g.release();
        *pitem = job.item;
        return CC_CURLE_OK;
    }
    g.release();
    return CC_CURLE_AGAIN;
}

int Curl_thrdq_await_done(struct curl_thrdq *q, uint32_t timeout_ms) {
    CCExclusive locks;
    CCExclusiveGuard !>(CCError) r;
    CCExclusiveGuard g;
    CCDeadline *prev = NULL;
    CCDeadline idle;
    if (!q)
        return CC_CURLE_FAILED_INIT;
    locks = q->locks;
    if (!cc_exclusive_is_live(locks))
        return CC_CURLE_FAILED_INIT;
    if (timeout_ms) {
        idle = cc_deadline_after_ms(timeout_ms);
        prev = cc_deadline_push(&idle);
    }
    r = locks.acquire_when(BAG_AWAIT, await_is_idle, q);
    if (prev)
        cc_deadline_pop(prev);
    if (cc_is_err(r)) {
        if (r.u.error.kind == CC_ERR_TIMEOUT)
            return CC_CURLE_OPERATION_TIMEDOUT;
        return CC_CURLE_FAILED_INIT;
    }
    g = r.u.value;
    g.release();
    return CC_CURLE_OK;
}

void Curl_thrdq_clear(struct curl_thrdq *tqueue,
                      Curl_thrdq_item_match_cb fn_match, void *match_data) {
    CcThrdq *q = tqueue;
    CCExclusive locks;
    CCExclusiveGuard gs[2];
    JobBag *jobs;
    JobBag *done;
    int dropped;
    if (!q || !fn_match)
        return;
    locks = q->locks;
    jobs = &q->jobs;
    done = &q->done;
    if (!cc_exclusive_is_live(locks) || !jobs->ready || !done->ready)
        return;
    if (locks.acquire_range(BAG_JOBS, BAG_DONE + 1, gs, 2) != 2)
        abort();
    dropped = jobs->remove_if_held(q, 1, fn_match, match_data);
    done->remove_if_held(q, 0, fn_match, match_data);
    {
        CCExclusiveGuard *held = gs;
        held->release_n(2);
    }
    if (dropped)
        await_note(q, -dropped);
}

/* curl multi quick_exit: process is dying — do not block on getaddrinfo. */
static void detach_teardown(CcThrdq *q) {
    JobBag *jobs;
    CCNursery w;
    if (!q)
        return;
    mark_aborted(q);
    jobs = &q->jobs;
    w = q->workers;
    {
        int dropped = jobs->drain(q);
        jobs->close();
        if (dropped)
            await_note(q, -dropped);
    }
    if (!cc_nursery_is_live(w)) {
        finish_q(q);
        return;
    }
    q->fn_event = NULL;
    q->fn_user_data = NULL;
    w.leave(q, finish_q) !>;
}

void Curl_thrdq_destroy(struct curl_thrdq *tqueue, bool join) {
    CcThrdq *q = tqueue;
    if (!q)
        return;
    if (join)
        q->teardown();
    else
        detach_teardown(q);
}

void Curl_thrdq_trace(struct curl_thrdq *q, struct Curl_easy *data) {
    CCExclusive locks;
    CCExclusiveGuard gs[2];
    JobBag *jobs;
    JobBag *done;
    int i;
    (void)data;
    if (!q)
        return;
    /* This TU does not include curl_trc. Walk under the same hold as
     * clear so name / descriptions stay live and the ABI is not a no-op. */
    locks = q->locks;
    jobs = &q->jobs;
    done = &q->done;
    if (!cc_exclusive_is_live(locks) || !jobs->ready || !done->ready)
        return;
    if (locks.acquire_range(BAG_JOBS, BAG_DONE + 1, gs, 2) != 2)
        return;
    (void)q->name;
    for (i = 0; i < jobs->n; i++)
        (void)jobs->a[i].description;
    for (i = 0; i < done->n; i++)
        (void)done->a[i].description;
    {
        CCExclusiveGuard *held = gs;
        held->release_n(2);
    }
}

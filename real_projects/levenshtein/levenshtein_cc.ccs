/* python-Levenshtein's core, as a CC extension module.
 *
 *     ccc build -O real_projects/levenshtein/levenshtein_cc.ccs
 *     PYTHONPATH=bin python3 -c "import cclev; print(cclev.distance('kitten','sitting'))"
 *
 * The specimen bar (real_projects/README.md): same answers as the real
 * package, judged by the real package — parity.py cross-checks every
 * function against a pip-installed Levenshtein on random inputs, ASCII
 * through astral-plane, and bench.py races it.  The friction the port
 * surfaced is logged in FRICTION.md, not smoothed over.
 *
 * Semantics matched to upstream 0.27 (rapidfuzz-backed):
 *   distance      unit-cost edit distance over CODEPOINTS, not bytes
 *   ratio         (lensum - indel_distance) / lensum; empty/empty = 1.0
 *   hamming       pad=1 by default; unequal lengths count overhang as mismatches
 *                 (pad=0 raises on length mismatch, matching upstream)
 *   jaro          both-empty = 1.0, one-empty = 0.0
 *   jaro_winkler  prefix bonus 0.1, capped at 4
 *
 * Module state is one lazily-created scratch arena, reset per call —
 * steady-state does zero allocation — and `destroy` tears it down as the
 * module's m_free. */
#include <ccc/script/py.cch>
#include <ccc/std/slice.cch>
#include <stdint.h>
#include <string.h>

typedef struct Lev {
    CCArena a;
} Lev;

/* Python str arrives as CCPyStr (call-scoped borrow); `s.codepoints(arena)`
 * fills UCS4 via the Stable ABI — no UTF-8 round-trip.  Equality is by
 * codepoint, so 'é' vs 'e' is one edit, not two. */
static int lev__ensure_arena(Lev *self) {
    if (!self->a.base) self->a = cc_arena_heap(kilobytes(256));
    if (!self->a.base) return -1;
    cc_arena_reset(&self->a);
    return 0;
}

static int lev__prep(Lev *self, CCPyStr s1, CCPyStr s2,
                     uint32_t **a, size_t *n, uint32_t **b, size_t *m) {
    CCResult_CCSlice_uint32_t_CCError ra, rb;
    CCSlice_uint32_t ca, cb;
    if (lev__ensure_arena(self) != 0) return -1;
    ra = s1.codepoints(&self->a);
    if (CCResult_CCSlice_uint32_t_CCError_is_err(ra)) return -1;
    rb = s2.codepoints(&self->a);
    if (CCResult_CCSlice_uint32_t_CCError_is_err(rb)) return -1;
    ca = CCResult_CCSlice_uint32_t_CCError_value(ra);
    cb = CCResult_CCSlice_uint32_t_CCError_value(rb);
    *a = (uint32_t *)ca.base.ptr;
    *n = ca.base.len;
    *b = (uint32_t *)cb.base.ptr;
    *m = cb.base.len;
    return 0;
}

/* Two-row DP; `sub` is the substitution cost — 1 is the classic distance,
 * 2 makes it the indel distance `ratio` normalizes.  This is the spec the
 * bit-parallel kernels below must agree with; it also carries the small
 * inputs, where its zero setup cost wins. */
static long long lev__dp(CCArena *a, const uint32_t *s, size_t n,
                         const uint32_t *t, size_t m, long long sub) {
    size_t *prev = cc_arena_alloc_T_count(size_t, a, m + 1);
    size_t *cur  = cc_arena_alloc_T_count(size_t, a, m + 1);
    if (!prev || !cur) return -1;
    for (size_t j = 0; j <= m; j++) prev[j] = j;
    for (size_t i = 1; i <= n; i++) {
        cur[0] = i;
        for (size_t j = 1; j <= m; j++) {
            size_t del = prev[j] + 1;
            size_t ins = cur[j - 1] + 1;
            size_t rep = prev[j - 1] + (s[i - 1] == t[j - 1] ? 0 : (size_t)sub);
            size_t best = del < ins ? del : ins;
            cur[j] = rep < best ? rep : best;
        }
        { size_t *tmp = prev; prev = cur; cur = tmp; }
    }
    return (long long)prev[m];
}

/* Codepoint -> match-mask rows for the bit kernels.  When every pattern
 * codepoint fits below 0x100 (ASCII and Latin-1 — most real text, and
 * every invalid byte, which decodes as itself), the table is
 * direct-indexed: 256 rows, one load per text char.  Otherwise a small
 * open-addressed hash (capacity a power of two >= 2x the pattern length,
 * so probes stay short).  Either way a miss hands back an all-zero row.
 * 0xFFFFFFFF cannot be a key: codepoints top out at 0x10FFFF. */
#define LEV__CP_NONE 0xFFFFFFFFu

typedef struct LevPeq {
    uint64_t *direct;    /* 256 * blocks, or NULL when hashing */
    unsigned char *dseen;/* which direct rows were zeroed and filled */
    uint32_t *keys;
    uint64_t **rows;
    uint64_t *zero;
    size_t cap;
    size_t blocks;
} LevPeq;

static int lev__peq_build(CCArena *ar, const uint32_t *pat, size_t m,
                          size_t blocks, LevPeq *p) {
    size_t cap = 8, i, b;
    uint32_t maxcp = 0;
    for (i = 0; i < m; i++) if (pat[i] > maxcp) maxcp = pat[i];
    p->blocks = blocks;
    p->zero = cc_arena_alloc_T_count(uint64_t, ar, blocks);
    if (!p->zero) return -1;
    for (b = 0; b < blocks; b++) p->zero[b] = 0;
    if (maxcp < 0x100) {
        /* Rows for absent chars are never read past a zero check, but they
         * ARE read: lookups index straight in.  Zero only the rows the
         * pattern touches (a 256-byte seen map) plus each miss row on
         * demand via p->zero — memsetting all 256*blocks words per call
         * costs more than the whole kernel on mid-size inputs. */
        unsigned char seen[256];
        p->direct = cc_arena_alloc_T_count(uint64_t, ar, 256 * blocks);
        if (!p->direct) return -1;
        memset(seen, 0, sizeof(seen));
        for (i = 0; i < m; i++) {
            size_t c = pat[i];
            if (!seen[c]) {
                seen[c] = 1;
                memset(p->direct + c * blocks, 0, blocks * sizeof(uint64_t));
            }
            p->direct[c * blocks + (i >> 6)] |= (uint64_t)1 << (i & 63);
        }
        p->keys = NULL;
        p->rows = NULL;
        p->cap = 0;
        p->dseen = cc_arena_alloc_T_count(unsigned char, ar, 256);
        if (!p->dseen) return -1;
        memcpy(p->dseen, seen, 256);
        return 0;
    }
    p->direct = NULL;
    while (cap < 2 * m) cap <<= 1;
    p->keys = cc_arena_alloc_T_count(uint32_t, ar, cap);
    p->rows = cc_arena_alloc_T_count(uint64_t *, ar, cap);
    if (!p->keys || !p->rows) return -1;
    p->cap = cap;
    for (i = 0; i < cap; i++) p->keys[i] = LEV__CP_NONE;
    for (i = 0; i < m; i++) {
        uint32_t cp = pat[i];
        size_t h = (size_t)(cp * 2654435761u) & (cap - 1);
        while (p->keys[h] != LEV__CP_NONE && p->keys[h] != cp)
            h = (h + 1) & (cap - 1);
        if (p->keys[h] == LEV__CP_NONE) {
            uint64_t *row = cc_arena_alloc_T_count(uint64_t, ar, blocks);
            if (!row) return -1;
            for (b = 0; b < blocks; b++) row[b] = 0;
            p->keys[h] = cp;
            p->rows[h] = row;
        }
        p->rows[h][i >> 6] |= (uint64_t)1 << (i & 63);
    }
    return 0;
}

static const uint64_t *lev__peq_row(const LevPeq *p, uint32_t cp) {
    size_t h;
    if (p->direct)
        return (cp < 0x100 && p->dseen[cp]) ? p->direct + (size_t)cp * p->blocks
                                            : p->zero;
    h = (size_t)(cp * 2654435761u) & (p->cap - 1);
    while (p->keys[h] != LEV__CP_NONE) {
        if (p->keys[h] == cp) return p->rows[h];
        h = (h + 1) & (p->cap - 1);
    }
    return p->zero;
}

/* Constant-time SWAR popcount: LCS state words run about half-set, where
 * the bit-clearing loop's cost peaks. */
static int lev__popcount64(uint64_t x) {
    x -= (x >> 1) & 0x5555555555555555ull;
    x = (x & 0x3333333333333333ull) + ((x >> 2) & 0x3333333333333333ull);
    x = (x + (x >> 4)) & 0x0F0F0F0F0F0F0F0Full;
    return (int)((x * 0x0101010101010101ull) >> 56);
}

/* rapidfuzz reaches its long-string numbers with C++ templates on the
 * block count, so every state word lives in a register.  Same move here
 * for both bit kernels: emit lev__dist_fx2..fx8 and lev__lcs_fx2..fx8,
 * each unrolled to a fixed block count.  The code splices where these
 * blocks sit — after LevPeq and the helpers they call — and is ordinary
 * C in the lowered output (`--emit-c-only`). */
@comptime {
    for (int nb = 2; nb <= 8; nb++) {
        @emit(CC_EMIT_AT_COMPTIME_SITE, `
            static long long lev__dist_fx${nb}(const LevPeq *peq, const uint32_t *t,
                                               size_t m, size_t n, uint64_t last_top) {
                size_t j;
                long long score = (long long)n;
            `);
        for (int k = 0; k < nb; k++)
            @emit(CC_EMIT_AT_COMPTIME_SITE, `
                uint64_t Pv${k} = ~(uint64_t)0, Mv${k} = 0;
                `);
        /* Block 0 always enters with hin = +1 (first-row boundary), so
         * Ph picks up the |1 shift-in and Eq is never forced.  Blocks
         * 1..N-2 score at bit 63; the last block scores at last_top. */
        @emit(CC_EMIT_AT_COMPTIME_SITE, `
            for (j = 0; j < m; j++) {
                const uint64_t *eq = lev__peq_row(peq, t[j]);
                uint64_t Eq, Xv, Xh, Ph, Mh;
                int hin, hout;
                Eq = eq[0]; Xv = Eq | Mv0;
                Xh = (((Eq & Pv0) + Pv0) ^ Pv0) | Eq;
                Ph = Mv0 | ~(Xh | Pv0);
                Mh = Pv0 & Xh;
                hout = ((Ph & ((uint64_t)1 << 63)) ? 1 : 0)
                     - ((Mh & ((uint64_t)1 << 63)) ? 1 : 0);
                Ph = (Ph << 1) | 1;
                Mh <<= 1;
                Pv0 = Mh | ~(Xv | Ph);
                Mv0 = Ph & Xv;
                hin = hout;
            `);
        for (int k = 1; k < nb; k++)
            @emit(CC_EMIT_AT_COMPTIME_SITE, `
                Eq = eq[${k}]; Xv = Eq | Mv${k};
                if (hin < 0) Eq |= 1;
                Xh = (((Eq & Pv${k}) + Pv${k}) ^ Pv${k}) | Eq;
                Ph = Mv${k} | ~(Xh | Pv${k});
                Mh = Pv${k} & Xh;
                hout = ((Ph & ${k == nb - 1 ? "last_top" : "((uint64_t)1 << 63)"}) ? 1 : 0)
                     - ((Mh & ${k == nb - 1 ? "last_top" : "((uint64_t)1 << 63)"}) ? 1 : 0);
                Ph <<= 1;
                Mh <<= 1;
                if (hin > 0) Ph |= 1;
                else if (hin < 0) Mh |= 1;
                Pv${k} = Mh | ~(Xv | Ph);
                Mv${k} = Ph & Xv;
                hin = hout;
                `);
        @emit(CC_EMIT_AT_COMPTIME_SITE, `
                score += hin;
            }
            return score;
            }
            `);
    }
    for (int nb = 2; nb <= 8; nb++) {
        @emit(CC_EMIT_AT_COMPTIME_SITE, `
            static long long lev__lcs_fx${nb}(const LevPeq *peq, const uint32_t *t,
                                              size_t m, size_t n, uint64_t valid) {
                size_t j;
            `);
        for (int k = 0; k < nb; k++)
            @emit(CC_EMIT_AT_COMPTIME_SITE, `
                uint64_t S${k} = ~(uint64_t)0;
                `);
        /* Block 0's carry-out is the simplified form (no incoming add
         * carry); blocks 1..N-1 thread the bignum carry through. */
        @emit(CC_EMIT_AT_COMPTIME_SITE, `
            for (j = 0; j < m; j++) {
                const uint64_t *eq = lev__peq_row(peq, t[j]);
                uint64_t M, U, x, x2, carry;
                M = eq[0]; U = S0 & M; x = S0 + U;
                carry = x < S0 ? (uint64_t)1 : 0; S0 = x | (S0 & ~M);
            `);
        for (int k = 1; k < nb; k++)
            @emit(CC_EMIT_AT_COMPTIME_SITE, `
                M = eq[${k}]; U = S${k} & M; x = S${k} + U; x2 = x + carry;
                carry = ((x < S${k}) | (x2 < x)) ? (uint64_t)1 : 0;
                S${k} = x2 | (S${k} & ~M);
                `);
        @emit(CC_EMIT_AT_COMPTIME_SITE, `
            }
            return (long long)n - (0
            `);
        for (int k = 0; k < nb; k++)
            @emit(CC_EMIT_AT_COMPTIME_SITE, `
                + lev__popcount64(S${k}${k == nb - 1 ? " & valid" : ""})
                `);
        @emit(CC_EMIT_AT_COMPTIME_SITE, `
            );
            }
            `);
    }
}

/* Myers/Hyyro bit-parallel unit-cost edit distance: the shorter string
 * rides the bits (one DP column per 64-bit word), the longer one drives
 * the loop, so the whole column updates in ~15 word ops instead of 64
 * cell visits.  Blocks chain through hin/hout, the +-1 horizontal delta
 * at each block boundary; hin = +1 into block 0 is the first-row
 * boundary (row 0 reads 0,1,2,...).  The last block's unused high bits
 * run garbage, which stays harmless because every operation here only
 * carries influence upward — the scored bit at `last_top` never hears
 * from them. */
static long long lev__dist_bits(CCArena *ar, const uint32_t *s, size_t n,
                                const uint32_t *t, size_t m) {
    LevPeq peq;
    uint64_t *Pv, *Mv, last_top;
    size_t blocks, rem, b, j;
    long long score;
    if (n > m) {
        const uint32_t *ts = s; size_t tn = n;
        s = t; n = m; t = ts; m = tn;
    }
    if (n == 0) return (long long)m;
    blocks = (n + 63) >> 6;
    rem = n - ((blocks - 1) << 6);
    last_top = (uint64_t)1 << (rem - 1);
    if (lev__peq_build(ar, s, n, blocks, &peq) != 0) return -1;
    if (blocks == 1) {
        /* Pattern fits one word: state lives in registers, no carries. */
        uint64_t Pv1 = ~(uint64_t)0, Mv1 = 0;
        score = (long long)n;
        for (j = 0; j < m; j++) {
            uint64_t Eq = lev__peq_row(&peq, t[j])[0];
            uint64_t Xv = Eq | Mv1;
            uint64_t Xh = (((Eq & Pv1) + Pv1) ^ Pv1) | Eq;
            uint64_t Ph = Mv1 | ~(Xh | Pv1);
            uint64_t Mh = Pv1 & Xh;
            if (Ph & last_top) score++;
            else if (Mh & last_top) score--;
            Ph = (Ph << 1) | 1;
            Mh <<= 1;
            Pv1 = Mh | ~(Xv | Ph);
            Mv1 = Ph & Xv;
        }
        return score;
    }
    /* Fixed-count instances up to 512 codepoints; the general loop
     * carries the tail beyond them. */
    switch (blocks) {
    case 2: return lev__dist_fx2(&peq, t, m, n, last_top);
    case 3: return lev__dist_fx3(&peq, t, m, n, last_top);
    case 4: return lev__dist_fx4(&peq, t, m, n, last_top);
    case 5: return lev__dist_fx5(&peq, t, m, n, last_top);
    case 6: return lev__dist_fx6(&peq, t, m, n, last_top);
    case 7: return lev__dist_fx7(&peq, t, m, n, last_top);
    case 8: return lev__dist_fx8(&peq, t, m, n, last_top);
    default: break;
    }
    Pv = cc_arena_alloc_T_count(uint64_t, ar, blocks);
    Mv = cc_arena_alloc_T_count(uint64_t, ar, blocks);
    if (!Pv || !Mv) return -1;
    for (b = 0; b < blocks; b++) { Pv[b] = ~(uint64_t)0; Mv[b] = 0; }
    score = (long long)n;
    for (j = 0; j < m; j++) {
        const uint64_t *eq = lev__peq_row(&peq, t[j]);
        int hin = 1;
        for (b = 0; b < blocks; b++) {
            uint64_t Eq = eq[b], Pvb = Pv[b], Mvb = Mv[b];
            uint64_t Xv = Eq | Mvb;
            uint64_t Xh, Ph, Mh, top;
            int hout;
            if (hin < 0) Eq |= 1;
            Xh = (((Eq & Pvb) + Pvb) ^ Pvb) | Eq;
            Ph = Mvb | ~(Xh | Pvb);
            Mh = Pvb & Xh;
            top = (b == blocks - 1) ? last_top : ((uint64_t)1 << 63);
            hout = ((Ph & top) ? 1 : 0) - ((Mh & top) ? 1 : 0);
            Ph <<= 1;
            Mh <<= 1;
            if (hin > 0) Ph |= 1;
            else if (hin < 0) Mh |= 1;
            Pv[b] = Mh | ~(Xv | Ph);
            Mv[b] = Ph & Xv;
            hin = hout;
        }
        score += hin;
    }
    return score;
}

/* Bit-parallel LCS length (Allison-Dix): S holds the complemented match
 * chain, matched bits absorb an addition carry that spreads increments
 * up the column; the inter-block carry is exactly a bignum addition
 * carry, detected by wraparound.  LCS = zero bits of S among the n
 * valid positions, and the indel distance `ratio` wants is
 * n + m - 2*LCS. */
static long long lev__lcs_bits(CCArena *ar, const uint32_t *s, size_t n,
                               const uint32_t *t, size_t m) {
    LevPeq peq;
    uint64_t *S;
    size_t blocks, rem, b, j;
    long long ones = 0;
    if (n > m) {
        const uint32_t *ts = s; size_t tn = n;
        s = t; n = m; t = ts; m = tn;
    }
    if (n == 0) return 0;
    blocks = (n + 63) >> 6;
    rem = n - ((blocks - 1) << 6);
    if (lev__peq_build(ar, s, n, blocks, &peq) != 0) return -1;
    if (blocks == 1) {
        uint64_t S1 = ~(uint64_t)0;
        uint64_t valid = rem == 64 ? ~(uint64_t)0 : (((uint64_t)1 << rem) - 1);
        for (j = 0; j < m; j++) {
            uint64_t M = lev__peq_row(&peq, t[j])[0];
            uint64_t U = S1 & M;
            S1 = (S1 + U) | (S1 & ~M);
        }
        return (long long)n - lev__popcount64(S1 & valid);
    }
    /* Fixed-count instances up to 512 codepoints; the general loop
     * carries the tail beyond them. */
    {
        uint64_t valid = rem == 64 ? ~(uint64_t)0 : (((uint64_t)1 << rem) - 1);
        switch (blocks) {
        case 2: return lev__lcs_fx2(&peq, t, m, n, valid);
        case 3: return lev__lcs_fx3(&peq, t, m, n, valid);
        case 4: return lev__lcs_fx4(&peq, t, m, n, valid);
        case 5: return lev__lcs_fx5(&peq, t, m, n, valid);
        case 6: return lev__lcs_fx6(&peq, t, m, n, valid);
        case 7: return lev__lcs_fx7(&peq, t, m, n, valid);
        case 8: return lev__lcs_fx8(&peq, t, m, n, valid);
        default: break;
        }
    }
    S = cc_arena_alloc_T_count(uint64_t, ar, blocks);
    if (!S) return -1;
    for (b = 0; b < blocks; b++) S[b] = ~(uint64_t)0;
    for (j = 0; j < m; j++) {
        const uint64_t *eq = lev__peq_row(&peq, t[j]);
        uint64_t carry = 0;
        for (b = 0; b < blocks; b++) {
            uint64_t M = eq[b], Sb = S[b];
            uint64_t U = Sb & M;
            uint64_t x = Sb + U;
            uint64_t c1 = (x < Sb) ? 1 : 0;
            uint64_t x2 = x + carry;
            uint64_t c2 = (x2 < x) ? 1 : 0;
            carry = c1 | c2;
            S[b] = x2 | (Sb & ~M);
        }
    }
    for (b = 0; b + 1 < blocks; b++) ones += lev__popcount64(S[b]);
    ones += lev__popcount64(S[blocks - 1] &
                            (rem == 64 ? ~(uint64_t)0
                                       : (((uint64_t)1 << rem) - 1)));
    return (long long)n - ones;
}

/* One distance door for the methods: the DP carries small inputs (the
 * bit kernels' hash setup costs more than the whole DP down there), the
 * kernels carry the rest.  Same answers by construction — parity.py
 * sweeps both sides of this threshold against upstream. */
#define LEV__BITS_MIN 8

static long long lev__dist(CCArena *ar, const uint32_t *s, size_t n,
                           const uint32_t *t, size_t m, long long sub) {
    long long l;
    if ((n < m ? n : m) <= LEV__BITS_MIN) return lev__dp(ar, s, n, t, m, sub);
    if (sub == 1) return lev__dist_bits(ar, s, n, t, m);
    l = lev__lcs_bits(ar, s, n, t, m);
    if (l < 0) return -1;
    return (long long)(n + m) - 2 * l;
}

static long long !>(CCError) Lev_distance(Lev *self, CCPyStr s1, CCPyStr s2) {
    uint32_t *a, *b; size_t n, m;
    if (lev__prep(self, s1, s2, &a, &n, &b, &m) != 0)
        return cc_err(CC_ERR_OUT_OF_MEMORY, "levenshtein: scratch arena exhausted");
    long long d = lev__dist(&self->a, a, n, b, m, 1);
    if (d < 0) return cc_err(CC_ERR_OUT_OF_MEMORY, "levenshtein: scratch arena exhausted");
    return cc_ok(d);
}

static double !>(CCError) Lev_ratio(Lev *self, CCPyStr s1, CCPyStr s2) {
    uint32_t *a, *b; size_t n, m;
    if (lev__prep(self, s1, s2, &a, &n, &b, &m) != 0)
        return cc_err(CC_ERR_OUT_OF_MEMORY, "levenshtein: scratch arena exhausted");
    if (n + m == 0) return cc_ok(1.0);
    long long d = lev__dist(&self->a, a, n, b, m, 2);
    if (d < 0) return cc_err(CC_ERR_OUT_OF_MEMORY, "levenshtein: scratch arena exhausted");
    return cc_ok((double)((long long)(n + m) - d) / (double)(n + m));
}

static long long !>(CCError) Lev_hamming(Lev *self, CCPyStr s1, CCPyStr s2,
                                         long long pad = 1) {
    uint32_t *a, *b; size_t n, m;
    if (lev__prep(self, s1, s2, &a, &n, &b, &m) != 0)
        return cc_err(CC_ERR_OUT_OF_MEMORY, "levenshtein: scratch arena exhausted");
    if (!pad && n != m)
        return cc_err(CC_ERR_INVALID_ARG, "hamming: length mismatch");
    {
        size_t lo = n < m ? n : m, hi = n < m ? m : n;
        long long d = (long long)(hi - lo);
        for (size_t i = 0; i < lo; i++) d += (a[i] != b[i]);
        return cc_ok(d);
    }
}

static double lev__jaro(const uint32_t *a, size_t n, const uint32_t *b, size_t m,
                        CCArena *ar) {
    if (n == 0 && m == 0) return 1.0;
    if (n == 0 || m == 0) return 0.0;
    {
        size_t win = (n > m ? n : m) / 2;
        unsigned char *bf = (unsigned char *)cc_arena_alloc(ar, m, 1);
        unsigned char *af = (unsigned char *)cc_arena_alloc(ar, n, 1);
        size_t match = 0, t = 0, k = 0;
        if (!bf || !af) return -1.0;
        win = win > 0 ? win - 1 : 0; /* window = max/2 - 1, floored at 0 */
        memset(bf, 0, m);
        memset(af, 0, n);
        for (size_t i = 0; i < n; i++) {
            size_t from = i > win ? i - win : 0;
            size_t to = i + win + 1 < m ? i + win + 1 : m;
            for (size_t j = from; j < to; j++) {
                if (!bf[j] && a[i] == b[j]) { bf[j] = 1; af[i] = 1; match++; break; }
            }
        }
        if (match == 0) return 0.0;
        for (size_t i = 0; i < n; i++) {
            if (!af[i]) continue;
            while (!bf[k]) k++;
            if (a[i] != b[k]) t++;
            k++;
        }
        /* t counts order mismatches between the matched sequences; a
         * transposition is half of one, and upstream halves with INTEGER
         * division — an odd mismatch count rounds down, not to .5. */
        return ((double)match / (double)n +
                (double)match / (double)m +
                (double)(match - t / 2) / (double)match) / 3.0;
    }
}

static double !>(CCError) Lev_jaro(Lev *self, CCPyStr s1, CCPyStr s2) {
    uint32_t *a, *b; size_t n, m;
    if (lev__prep(self, s1, s2, &a, &n, &b, &m) != 0)
        return cc_err(CC_ERR_OUT_OF_MEMORY, "levenshtein: scratch arena exhausted");
    double j = lev__jaro(a, n, b, m, &self->a);
    if (j < 0) return cc_err(CC_ERR_OUT_OF_MEMORY, "levenshtein: scratch arena exhausted");
    return cc_ok(j);
}

static double !>(CCError) Lev_jaro_winkler(Lev *self, CCPyStr s1, CCPyStr s2) {
    uint32_t *a, *b; size_t n, m;
    if (lev__prep(self, s1, s2, &a, &n, &b, &m) != 0)
        return cc_err(CC_ERR_OUT_OF_MEMORY, "levenshtein: scratch arena exhausted");
    {
        double j = lev__jaro(a, n, b, m, &self->a);
        size_t l = 0, lim = n < m ? n : m;
        if (j < 0) return cc_err(CC_ERR_OUT_OF_MEMORY, "levenshtein: scratch arena exhausted");
        /* Winkler's boost threshold: the prefix bonus only rewards pairs
         * already similar (jaro > 0.7); below it, jaro_winkler IS jaro. */
        if (j <= 0.7) return cc_ok(j);
        if (lim > 4) lim = 4;
        while (l < lim && a[l] == b[l]) l++;
        return cc_ok(j + (double)l * 0.1 * (1.0 - j));
    }
}

static void Lev_destroy(Lev *self) {
    if (self->a.base) cc_arena_destroy(&self->a);
}

@comptime cc_py_export("cclev", "Lev", NULL);

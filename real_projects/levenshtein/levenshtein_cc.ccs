/* python-Levenshtein's core, as a CC extension module.
 *
 *     ccc build real_projects/levenshtein/levenshtein_cc.ccs
 *     PYTHONPATH=bin python3 -c "import cclev; print(cclev.distance('kitten','sitting'))"
 *
 * The specimen bar (real_projects/README.md): same answers as the real
 * package, judged by the real package — parity.py cross-checks every
 * function against a pip-installed Levenshtein on random inputs, ASCII
 * through astral-plane, and bench.py races it.  The friction the port
 * surfaced is logged in FRICTION.md, not smoothed over.
 *
 * Semantics matched to upstream 0.27 (rapidfuzz-backed):
 *   distance      unit-cost edit distance over CODEPOINTS, not bytes
 *   ratio         (lensum - indel_distance) / lensum; empty/empty = 1.0
 *   hamming       padded: unequal lengths count the overhang as mismatches
 *   jaro          both-empty = 1.0, one-empty = 0.0
 *   jaro_winkler  prefix bonus 0.1, capped at 4
 *
 * Module state is one lazily-created scratch arena, reset per call —
 * steady-state does zero allocation — and `destroy` tears it down as the
 * module's m_free. */
#include <ccc/script/py.cch>
#include <stdint.h>
#include <string.h>

typedef struct Lev {
    CCArena a;
} Lev;

/* UTF-8 -> codepoints, arena-backed.  Upstream operates on Python str,
 * which reaches us as UTF-8 bytes; equality must mean "same character",
 * so 'é' vs 'e' is one edit, not two.  An invalid byte decodes as itself
 * (never seen from CPython, which hands over valid UTF-8). */
static size_t lev__decode(CCArena *a, CCSlice s, uint32_t **out) {
    const unsigned char *p = (const unsigned char *)s.ptr;
    size_t i = 0, n = 0;
    uint32_t *cp = cc_arena_alloc_T_count(uint32_t, a, s.len ? s.len : 1);
    if (!cp) { *out = NULL; return 0; }
    while (i < s.len) {
        unsigned char c = p[i];
        uint32_t v = c;
        size_t more = 0;
        if (c >= 0xF0)      { v = c & 0x07; more = 3; }
        else if (c >= 0xE0) { v = c & 0x0F; more = 2; }
        else if (c >= 0xC0) { v = c & 0x1F; more = 1; }
        if (i + more < s.len) {
            for (size_t k = 1; k <= more; k++) v = (v << 6) | (p[i + k] & 0x3F);
            i += more + 1;
        } else {
            v = c;
            i++;
        }
        cp[n++] = v;
    }
    *out = cp;
    return n;
}

static int lev__prep(Lev *self, CCSlice s1, CCSlice s2,
                     uint32_t **a, size_t *n, uint32_t **b, size_t *m) {
    if (!self->a.base) self->a = cc_arena_heap(kilobytes(256));
    if (!self->a.base) return -1;
    cc_arena_reset(&self->a);
    *n = lev__decode(&self->a, s1, a);
    *m = lev__decode(&self->a, s2, b);
    return (*a && *b) ? 0 : -1;
}

/* Two-row DP; `sub` is the substitution cost — 1 is the classic distance,
 * 2 makes it the indel distance `ratio` normalizes. */
static long long lev__dp(CCArena *a, const uint32_t *s, size_t n,
                         const uint32_t *t, size_t m, long long sub) {
    size_t *prev = cc_arena_alloc_T_count(size_t, a, m + 1);
    size_t *cur  = cc_arena_alloc_T_count(size_t, a, m + 1);
    if (!prev || !cur) return -1;
    for (size_t j = 0; j <= m; j++) prev[j] = j;
    for (size_t i = 1; i <= n; i++) {
        cur[0] = i;
        for (size_t j = 1; j <= m; j++) {
            size_t del = prev[j] + 1;
            size_t ins = cur[j - 1] + 1;
            size_t rep = prev[j - 1] + (s[i - 1] == t[j - 1] ? 0 : (size_t)sub);
            size_t best = del < ins ? del : ins;
            cur[j] = rep < best ? rep : best;
        }
        { size_t *tmp = prev; prev = cur; cur = tmp; }
    }
    return (long long)prev[m];
}

static long long !>(CCError) Lev_distance(Lev *self, CCSlice s1, CCSlice s2) {
    uint32_t *a, *b; size_t n, m;
    if (lev__prep(self, s1, s2, &a, &n, &b, &m) != 0)
        return cc_err(CC_ERR_OUT_OF_MEMORY, "levenshtein: scratch arena exhausted");
    long long d = lev__dp(&self->a, a, n, b, m, 1);
    if (d < 0) return cc_err(CC_ERR_OUT_OF_MEMORY, "levenshtein: scratch arena exhausted");
    return cc_ok(d);
}

static double !>(CCError) Lev_ratio(Lev *self, CCSlice s1, CCSlice s2) {
    uint32_t *a, *b; size_t n, m;
    if (lev__prep(self, s1, s2, &a, &n, &b, &m) != 0)
        return cc_err(CC_ERR_OUT_OF_MEMORY, "levenshtein: scratch arena exhausted");
    if (n + m == 0) return cc_ok(1.0);
    long long d = lev__dp(&self->a, a, n, b, m, 2);
    if (d < 0) return cc_err(CC_ERR_OUT_OF_MEMORY, "levenshtein: scratch arena exhausted");
    return cc_ok((double)((long long)(n + m) - d) / (double)(n + m));
}

static long long !>(CCError) Lev_hamming(Lev *self, CCSlice s1, CCSlice s2) {
    uint32_t *a, *b; size_t n, m;
    if (lev__prep(self, s1, s2, &a, &n, &b, &m) != 0)
        return cc_err(CC_ERR_OUT_OF_MEMORY, "levenshtein: scratch arena exhausted");
    {
        size_t lo = n < m ? n : m, hi = n < m ? m : n;
        long long d = (long long)(hi - lo);
        for (size_t i = 0; i < lo; i++) d += (a[i] != b[i]);
        return cc_ok(d);
    }
}

static double lev__jaro(const uint32_t *a, size_t n, const uint32_t *b, size_t m,
                        CCArena *ar) {
    if (n == 0 && m == 0) return 1.0;
    if (n == 0 || m == 0) return 0.0;
    {
        size_t win = (n > m ? n : m) / 2;
        unsigned char *bf = (unsigned char *)cc_arena_alloc(ar, m, 1);
        unsigned char *af = (unsigned char *)cc_arena_alloc(ar, n, 1);
        size_t match = 0, t = 0, k = 0;
        if (!bf || !af) return -1.0;
        win = win > 0 ? win - 1 : 0; /* window = max/2 - 1, floored at 0 */
        memset(bf, 0, m);
        memset(af, 0, n);
        for (size_t i = 0; i < n; i++) {
            size_t from = i > win ? i - win : 0;
            size_t to = i + win + 1 < m ? i + win + 1 : m;
            for (size_t j = from; j < to; j++) {
                if (!bf[j] && a[i] == b[j]) { bf[j] = 1; af[i] = 1; match++; break; }
            }
        }
        if (match == 0) return 0.0;
        for (size_t i = 0; i < n; i++) {
            if (!af[i]) continue;
            while (!bf[k]) k++;
            if (a[i] != b[k]) t++;
            k++;
        }
        /* t counts order mismatches between the matched sequences; a
         * transposition is half of one, and upstream halves with INTEGER
         * division — an odd mismatch count rounds down, not to .5. */
        return ((double)match / (double)n +
                (double)match / (double)m +
                (double)(match - t / 2) / (double)match) / 3.0;
    }
}

static double !>(CCError) Lev_jaro(Lev *self, CCSlice s1, CCSlice s2) {
    uint32_t *a, *b; size_t n, m;
    if (lev__prep(self, s1, s2, &a, &n, &b, &m) != 0)
        return cc_err(CC_ERR_OUT_OF_MEMORY, "levenshtein: scratch arena exhausted");
    double j = lev__jaro(a, n, b, m, &self->a);
    if (j < 0) return cc_err(CC_ERR_OUT_OF_MEMORY, "levenshtein: scratch arena exhausted");
    return cc_ok(j);
}

static double !>(CCError) Lev_jaro_winkler(Lev *self, CCSlice s1, CCSlice s2) {
    uint32_t *a, *b; size_t n, m;
    if (lev__prep(self, s1, s2, &a, &n, &b, &m) != 0)
        return cc_err(CC_ERR_OUT_OF_MEMORY, "levenshtein: scratch arena exhausted");
    {
        double j = lev__jaro(a, n, b, m, &self->a);
        size_t l = 0, lim = n < m ? n : m;
        if (j < 0) return cc_err(CC_ERR_OUT_OF_MEMORY, "levenshtein: scratch arena exhausted");
        /* Winkler's boost threshold: the prefix bonus only rewards pairs
         * already similar (jaro > 0.7); below it, jaro_winkler IS jaro. */
        if (j <= 0.7) return cc_ok(j);
        if (lim > 4) lim = 4;
        while (l < lim && a[l] == b[l]) l++;
        return cc_ok(j + (double)l * 0.1 * (1.0 - j));
    }
}

static void Lev_destroy(Lev *self) {
    if (self->a.base) cc_arena_destroy(&self->a);
}

void *PyInit_cclev(void) {
    return py_module::[Lev]("cclev", NULL);
}

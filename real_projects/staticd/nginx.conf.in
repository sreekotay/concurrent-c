# Stock nginx defaults (plus harness: daemon off, pid, listen, root).
# Invoke: nginx -c $PWD/nginx.conf -p $PWD/run/nginx
worker_processes 1;
error_log stderr notice;
pid nginx.pid;
daemon off;

events {
    worker_connections 512;
}

http {
    access_log off;
    sendfile off;
    tcp_nopush off;
    keepalive_timeout 75;
    types {
        text/html                             html htm;
        text/css                              css;
        application/javascript                js;
        application/octet-stream              bin;
        text/plain                            txt;
    }
    default_type application/octet-stream;

    server {
        listen 127.0.0.1:8081;
        server_name localhost;
        root FIXTURES_ROOT;
    }
}

# Minimal nginx static root for staticd benchmarks.
# Invoke: nginx -c $PWD/nginx.conf -p $PWD/run/nginx
worker_processes auto;
error_log stderr notice;
pid nginx.pid;
daemon off;
worker_rlimit_nofile 65535;

events {
    worker_connections 16384;
    multi_accept on;
}

http {
    access_log off;
    sendfile on;
    tcp_nopush on;
    keepalive_timeout 65;
    keepalive_requests 100000;
    types {
        text/html                             html htm;
        text/css                              css;
        application/javascript                js;
        application/octet-stream              bin;
        text/plain                            txt;
    }
    default_type application/octet-stream;

    server {
        listen 127.0.0.1:8081;
        server_name localhost;
        root FIXTURES_ROOT;
        # Traversal stays inside root; nginx rejects .. escapes by default.
    }
}

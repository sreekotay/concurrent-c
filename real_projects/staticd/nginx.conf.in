# Homebrew nginx.conf defaults, plus the recommended uncomment
# (`sendfile on`, `tcp_nopush on`) and the harness (daemon off, pid,
# listen, root, access_log off).
# Invoke: nginx -c $PWD/nginx.conf -p $PWD/run/nginx
worker_processes 1;
error_log stderr notice;
pid nginx.pid;
daemon off;

events {
    worker_connections 1024;
}

http {
    access_log off;
    sendfile on;
    tcp_nopush on;
    keepalive_timeout 65;
    types {
        text/html                             html htm;
        text/css                              css;
        application/javascript                js;
        application/octet-stream              bin;
        text/plain                            txt;
    }
    default_type application/octet-stream;

    server {
        listen 127.0.0.1:8081;
        server_name localhost;
        root FIXTURES_ROOT;
    }
}

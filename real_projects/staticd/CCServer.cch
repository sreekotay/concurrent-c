/*
 * Local dest face. Not std. No protocol, no app row, no app hook.
 *
 *   CCIoSess  — socket session (sock / optional TLS / window / dead)
 *   CCServer  — listen, tls mats, dest, stop, live / worker ratchet
 *   CCIoAct   — wait | wait_out | close (how a socket step finishes)
 *
 * `serve` lives in CCServer.ccs (this header's owner): workers / wait /
 * grow, borrow-invoke one closure with `CCIoSess*`. Tape interest is
 * CCServerPoll.cch / .ccs. Dest-per-conn is `ln.serve`.
 *
 * Page sees: init / close / listen / load_tls / serve / start_n /
 * workers_max / tls / tls_fails; on io: try_write / window /
 * consume / full / apply / dead / touch / set_deadline. `app` is a page
 * cookie; dest never derefs it.
 *
 * try_write: one non-blocking send. Ok(n) may be short. BUSY = wrote
 * nothing, wait_out later. App output is try_write + cursors only.
 *
 * TLS: bind starts the engine (`tls_hs`); handshake steps from waiter
 * readiness (WANT_READ / WANT_WRITE) before on_app sees the row.
 *
 * Deadlines: absolute `time_t` on the session (`deadline`); 0 = none.
 * Dest reaps expired rows on the 50ms wait wake.
 *
 * Caller includes <ccc/std/net.cch>, <ccc/std/tls.cch>, <ccc/std/signal.cch>,
 * <ccc/cc_atomic.cch>. Certs are process mats (`cc_tls_server_load`)
 * before dest wraps TLS.
 */
#ifndef CC_SERVER_CCH
#define CC_SERVER_CCH

#include <fcntl.h>
#include <unistd.h>
#include <stdint.h>
#include <time.h>
#include <errno.h>
#include <ccc/cc_closure.cch>

@variant CCIoAct {
    wait: void;
    wait_out: void;
    close: void;
};

/* Socket-level session. read_ptr views a dest-owned buffer. */
typedef struct CCIoSess {
    CCSocket sock;
    CCTlsConn tls;
    void* tls_iobuf;
    int tls_on;
    int tls_hs;       /* 1 = handshake in progress (poll-stepped) */
    char* read_ptr;
    size_t rlen;
    size_t rcap;
    int dead;
    int want_in;      /* POLLIN; TLS HS may clear */
    int want_out;     /* POLLOUT */
    time_t deadline;  /* 0 = none; absolute time() */
    int sec_after_hs; /* first HTTP byte budget after TLS (set at bind) */
    void* app;
} CCIoSess;

/* Dest bag. Owns the listen fd and (optional) TLS mats.
 * Shared worker-visible state is listen + atomics only — no worker-mutable
 * fds. EMFILE spare recovery lives on CCTape (per dest). */
typedef struct CCServer {
    CCListener ln;
    int tls;
    int tls_owned;
    int workers_max;
    int sec_tls_hs;       /* first-byte budget during TLS HS (default 10) */
    int sec_first_byte;   /* first HTTP byte after bind/HS (default 15) */
    cc_atomic_u64 accept_backoff_until_ms; /* listen interest off until mono ms */
    cc_atomic_int stop;
    cc_atomic_int live;
    cc_atomic_int nworkers; /* running workers */
    cc_atomic_int tls_fail;
    cc_atomic_int accept_soft; /* EMFILE/ENFILE soft-fail count */
    CCParallel app;
} CCServer;

int cc_fd_nonblock(int fd) {
    int fl = fcntl(fd, F_GETFL, 0);
    if (fl < 0) return -1;
    return fcntl(fd, F_SETFL, fl | O_NONBLOCK);
}

int cc_server_stopped(CCServer* srv);

/* Defined in CCServer.ccs — send() / cc_tls_try_write, never parks. */
size_t !>(CCIoError) io_sess_try_write(CCIoSess* io, char[:] data);

void io_sess_consume(CCIoSess* io, size_t n) {
    if (!io->read_ptr) return;
    if (n > io->rlen) n = io->rlen;
    if (n && n < io->rlen) {
        size_t keep = io->rlen - n;
        char[:] buf = cc_slice_from_buffer(io->read_ptr, io->rlen);
        char[:] dst = buf.sub(0, keep);
        dst.copy_overlap(buf.sub(n, io->rlen)) !>(e) { (void)e; return; };
    }
    io->rlen -= n;
}

char[:] io_sess_window(CCIoSess* io) {
    if (!io || !io->read_ptr) return cc_slice_empty();
    return cc_slice_from_buffer(io->read_ptr, io->rlen);
}

int io_sess_full(CCIoSess* io) {
    return io && io->rcap && io->rlen >= io->rcap;
}

void io_sess_touch(CCIoSess* io, time_t now, int secs) {
    if (!io) return;
    if (secs <= 0) {
        io->deadline = 0;
        return;
    }
    io->deadline = now + (time_t)secs;
}

void io_sess_apply(CCIoSess* io, CCIoAct a) {
    @switch (a) {
    case .close:
        io->dead = 1;
        io->want_out = 0;
        break;
    case .wait:
        io->want_out = 0;
        break;
    case .wait_out:
        io->want_out = 1;
        break;
    }
}

void cc_server_init(CCServer* srv, int workers_max) {
    *srv = (CCServer){
        .ln = { .fd = -1 },
        .workers_max = workers_max,
        .sec_tls_hs = 10,
        .sec_first_byte = 15,
    };
}

int cc_server_start_n(CCServer* srv) {
    int n = srv->workers_max;
    if (n < 1) return 1;
    return n < 2 ? n : 2;
}

void !>(CCError) cc_server_listen(CCServer* srv, CCSlice addr) {
    @errhandler(CCError e) { return cc_err(e); }
    srv->ln = cc_tcp_listen(addr) !>(e) {
        return cc_err(cc_net_to_io_error(e).base);
    };
    (void)cc_fd_nonblock(srv->ln.fd);
    return cc_ok();
}

int cc_server_load_tls(CCServer* srv, const char* cert, const char* key) {
    if (!srv || !cert || !key) return -1;
    if (cc_tls_server_load(cert, key) != 0) return -1;
    srv->tls = 1;
    srv->tls_owned = 1;
    return 0;
}

void cc_server_shutdown(CCServer* srv) {
    cc_atomic_store_release(&srv->stop, 1);
}

int cc_server_tls_fails(CCServer* srv) {
    return cc_atomic_load_acquire(&srv->tls_fail);
}

void cc_server_close(CCServer* srv) {
    if (!srv) return;
    cc_server_shutdown(srv);
    srv->ln.close();
    if (srv->tls_owned) {
        cc_tls_server_unload();
        srv->tls_owned = 0;
        srv->tls = 0;
    }
}

/* Borrow-invoke on_app(io) per ready window; drop once after join. */
void !>(CCError) cc_server_serve(CCServer* srv, CCSignal* stop,
                                 CCClosure1 on_app);

#endif /* CC_SERVER_CCH */

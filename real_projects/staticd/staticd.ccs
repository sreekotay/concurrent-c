/*
 * staticd — Concurrent-C static HTTP/1.1 + WebSocket (specimen).
 *
 * Sessions are rows. Dest is the worker (`CCServer`: poll → step →
 * accept → reap). A ready fd fills, then one HTTP request or WS frames
 * (no dest-per-conn). A file body is a cursor on the row; a step sends
 * one chunk. POLLOUT waits while left. Workers: start 2 (1 if the cap
 * is 1), grow with live conns (one accept per poll). Cap is ncpu/2
 * (`--workers 0`) or N. `--workers 1` stays one dest — the isolate
 * receipt. `Cfg` is policy (root/pages/index/list/extra).
 * `CCIoAct` is wait|wait_out|close; TLS wraps once at accept (`srv.tls_fail`
 * counts drops). Pages are an early arm (`pages_serve`; MISS → static).
 *
 *   CCServer.cch        — dest face (`CCServer` / `CCIoSess` / `CCIoAct`)
 *   CCServer.ccs        — owner: `srv.serve` (workers / poll / grow)
 *   this page           — HTTP/WS (`handle_http` / `session_app`) + `main`
 *   staticd_http.cch    — date / Range / header-CI mechanics
 *   staticd_block.cch   — block ring keyed by dev+ino (reuse; idle cull)
 *   staticd_fs.cch      — jail, 1s fd cache, FileHold, listing
 *   staticd_script.cch  — --pages QuickJS / CPython views (same ABI)
 *   staticd_ws.cch      — SHA-1 / base64 / frame tape
 *
 * Usage:  ./out/staticd [--listen ADDR] [--root DIR] [--pages DIR]
 *                       [--tls-cert PEM] [--tls-key PEM]
 *                       [--index NAME] [--list] [--header 'Name: value']
 *                       [--workers N]
 * v1: GET/HEAD/OPTIONS, keep-alive, Date/Last-Modified/IMS, one Range,
 *     send cursor (one 64KB chunk per step). `?query` ignored on files;
 *     passed to pages. `--list` off. `--index` default index.html.
 *     `--pages` off. Optional TLS (`--tls-cert` + `--tls-key`). WS echo
 *     on Upgrade.
 */

#include <ccc/std/prelude.cch>
#include <ccc/cc_atomic.cch>
#include <ccc/cc_instantiate.cch>
#include <ccc/std/net.cch>
#include <ccc/std/tls.cch>
@link("../../third_party/bearssl/build/libbearssl.a")
#include <ccc/std/signal.cch>
#include <ccc/std/cli.cch>
#include <ccc/std/static_map.cch>
#include <ccc/stdio.cch>
#include <ccc/script/quickjs.cch>
#include <ccc/script/py.cch>
#include "staticd_http.cch"
#include "staticd_block.cch"
#include "staticd_fs.cch"
#include "staticd_script.cch"
#include "staticd_ws.cch"
#include "CCServer.cch"
#include <time.h>
#include <fcntl.h>
#include <sys/stat.h>
#include <unistd.h>
#include <stdlib.h>

#define K_PATH_MAX   4096
#define K_LIST_ARENA (32 * 1024)
#define K_OUT_BUF    (8 * 1024)
#define WORKERS_MAX  32

/* Phase budgets (stress shortens via env; one production path). */
#ifndef STATICD_TLS_HS_SEC
#define STATICD_TLS_HS_SEC 10
#endif
#ifndef STATICD_HEADER_GAP_SEC
#define STATICD_HEADER_GAP_SEC 5
#endif
#ifndef STATICD_HEADER_TOTAL_SEC
#define STATICD_HEADER_TOTAL_SEC 15
#endif
#ifndef STATICD_KEEPALIVE_IDLE_SEC
#define STATICD_KEEPALIVE_IDLE_SEC 30
#endif
#ifndef STATICD_WRITE_STALL_SEC
#define STATICD_WRITE_STALL_SEC 30
#endif
#ifndef STATICD_WS_IDLE_SEC
#define STATICD_WS_IDLE_SEC 120
#endif

static int g_sec_tls_hs = STATICD_TLS_HS_SEC;
static int g_sec_header_gap = STATICD_HEADER_GAP_SEC;
static int g_sec_header_total = STATICD_HEADER_TOTAL_SEC;
static int g_sec_keepalive = STATICD_KEEPALIVE_IDLE_SEC;
static int g_sec_write_stall = STATICD_WRITE_STALL_SEC;
static int g_sec_ws_idle = STATICD_WS_IDLE_SEC;

static int env_sec(const char* name, int defv) {
    const char* v = getenv(name);
    long n;
    char* end = NULL;
    if (!v || !v[0]) return defv;
    n = strtol(v, &end, 10);
    if (!end || end == v || *end || n < 1 || n > 86400) return defv;
    return (int)n;
}

static void staticd_load_budgets(void) {
    /* Prefer short names the adversary sets; STATICD_* also accepted. */
    g_sec_tls_hs = env_sec("TLS_HS", env_sec("STATICD_TLS_HS_SEC", g_sec_tls_hs));
    g_sec_header_gap = env_sec("HEADER_GAP",
            env_sec("STATICD_HEADER_GAP_SEC", g_sec_header_gap));
    g_sec_header_total = env_sec("HEADER_TOTAL",
            env_sec("STATICD_HEADER_TOTAL_SEC", g_sec_header_total));
    g_sec_keepalive = env_sec("KEEPALIVE",
            env_sec("STATICD_KEEPALIVE_IDLE_SEC", g_sec_keepalive));
    g_sec_write_stall = env_sec("WRITE_STALL",
            env_sec("STATICD_WRITE_STALL_SEC", g_sec_write_stall));
    g_sec_ws_idle = env_sec("WS_IDLE",
            env_sec("STATICD_WS_IDLE_SEC", g_sec_ws_idle));
}

@variant Phase {
    http: void;
    ws: void;
};

@variant WsStep {
    more: void;
    again: void;
    fin: void;
};

typedef struct Cfg {
    int root_fd;
    int pages_fd;
    int list;
    const char* index;
    CCSlice extra;
} Cfg;

typedef struct Enc {
    CCArena arena;
    CCString out;
    CCSlice extra;
} Enc;

typedef struct Session {
    CCIoSess* io;
    FileHold send;
    char* mem;       /* pool slab body (pages / listing); NULL = file cursor */
    size_t mem_len;
    size_t send_off;
    size_t send_left;
    char* out_mem;   /* protocol bytes (HTTP headers / WS frames) */
    size_t out_off;
    size_t out_left;
    time_t header_hard_deadline; /* 0 = none; absolute */
    Phase phase;
    int send_close;
} Session;

typedef @typeview Encode on Enc {
    r: write, lit, status, hdr, end_headers, date_ka, extra;
} *EncView;

@grammar(cli) StaticdOpts {~~~~
    help: flag -h, --help desc "Show help"
    listen: opt string -l, --listen as ADDR default "127.0.0.1:8080" desc "Listen address host:port"
    root: opt string -r, --root as DIR default "fixtures" desc "Document root"
    list: flag --list desc "Directory listing when no index file"
    index: opt string --index as NAME default "index.html" desc "Directory index file"
    header: opt string --header as LINE desc "Extra response header Name: value (repeatable)"
    workers: opt i64 -w, --workers as N default 0 desc "Worker cap (0 = ncpu/2; start 2, grow with conns)"
    pages: opt string --pages as DIR default "" desc "Script pages jail (.js / .py views; off when empty)"
    tls_cert: opt string --tls-cert as PATH default "" desc "PEM certificate chain (requires --tls-key)"
    tls_key: opt string --tls-key as PATH default "" desc "PEM private key (requires --tls-cert)"
~~~~}

@grammar(schema) ReqLine {~~~~
    rules [
        mtok: keep [some charset [#'A' - #'Z']]
        pchar: complement charset [#' ' #'#' #'\r' #'\n']
        pth: keep [#'/' any pchar]
        vtok: keep ["HTTP/1.0" | "HTTP/1.1"]
    ]
    method: mtok #' ' path: pth #' ' version: vtok
~~~~}

@variant Method {
    get: void;
    head: void;
    options: void;
    other: void;
};

typedef enum MimeTag {
    MIME_OCTET = 0,
    MIME_HTML,
    MIME_CSS,
    MIME_JS,
    MIME_JSON,
    MIME_PNG,
    MIME_JPEG,
    MIME_GIF,
    MIME_SVG,
    MIME_TXT,
} MimeTag;

typedef struct MimeSpec {
    MimeTag kind;
} MimeSpec;

typedef struct MimeEntry {
    const char* key;
    MimeSpec value;
} MimeEntry;

@comptime {
    MimeEntry mime_entries[] = {
        { ".html", { MIME_HTML } },
        { ".htm",  { MIME_HTML } },
        { ".css",  { MIME_CSS } },
        { ".js",   { MIME_JS } },
        { ".json", { MIME_JSON } },
        { ".png",  { MIME_PNG } },
        { ".jpg",  { MIME_JPEG } },
        { ".jpeg", { MIME_JPEG } },
        { ".gif",  { MIME_GIF } },
        { ".svg",  { MIME_SVG } },
        { ".txt",  { MIME_TXT } },
        { ".bin",  { MIME_OCTET } },
    };
    static_map("mime_ext", mime_entries, CC_STATIC_MAP_ASCII_CI);
}

static const char* k_mime[] = {
    [MIME_OCTET] = "application/octet-stream",
    [MIME_HTML]  = "text/html; charset=utf-8",
    [MIME_CSS]   = "text/css; charset=utf-8",
    [MIME_JS]    = "application/javascript; charset=utf-8",
    [MIME_JSON]  = "application/json",
    [MIME_PNG]   = "image/png",
    [MIME_JPEG]  = "image/jpeg",
    [MIME_GIF]   = "image/gif",
    [MIME_SVG]   = "image/svg+xml",
    [MIME_TXT]   = "text/plain; charset=utf-8",
};

static void session_clear_out(Session* s) {
    if (s->out_mem) {
        if (g_blocks.pool) g_blocks.pool->free(s->out_mem);
        s->out_mem = NULL;
    }
    s->out_off = 0;
    s->out_left = 0;
}

static void session_clear_send(Session* s) {
    if (s->mem) {
        if (g_blocks.pool) g_blocks.pool->free(s->mem);
        s->mem = NULL;
        s->mem_len = 0;
    }
    s->send.drop();
    s->send_off = 0;
    s->send_left = 0;
}

/* Idle / write / WS: absolute deadline from now. */
static void session_touch(Session* s, time_t now, int sec) {
    if (!s || !s->io) return;
    s->io->touch(now, sec);
}

/* Partial headers: gap from last progress ∩ hard from first byte. */
static void session_touch_headers(Session* s, time_t now) {
    time_t gap, hard, dl;
    if (!s || !s->io) return;
    if (!s->header_hard_deadline)
        s->header_hard_deadline = now + (time_t)g_sec_header_total;
    gap = now + (time_t)g_sec_header_gap;
    hard = s->header_hard_deadline;
    dl = gap < hard ? gap : hard;
    s->io->deadline = dl;
}

static Session* session_of(CCIoSess* io, CCArenaPool* pool) {
    Session* s;
    if (!io || !pool) return NULL;
    s = (Session*)io->app;
    if (s) return s;
    s = (Session*)pool->alloc();
    if (!s) return NULL;
    s->io = io;
    s->send = (FileHold){ .slot = -1, .fd = -1 };
    s->mem = NULL;
    s->mem_len = 0;
    s->send_off = 0;
    s->send_left = 0;
    s->out_mem = NULL;
    s->out_off = 0;
    s->out_left = 0;
    s->header_hard_deadline = 0;
    s->send_close = 0;
    s->phase = (Phase){ .http = {} };
    io->app = s;
    return s;
}

static void session_release(CCIoSess* io, CCArenaPool* pool) {
    Session* s;
    if (!io) return;
    s = (Session*)io->app;
    if (!s) return;
    session_clear_send(s);
    session_clear_out(s);
    io->app = NULL;
    if (pool) pool->free(s);
}

static void session_queue_send(Session* s, FileHold* fh, size_t off, size_t nsend) {
    session_clear_send(s);
    s->send = *fh;
    *fh = (FileHold){ .slot = -1, .fd = -1 };
    s->send_off = off;
    s->send_left = nsend;
    session_touch(s, time(NULL), g_sec_write_stall);
}

/* Memory body on a send_pool slab — same cursor / send_close as files. */
static bool !>(CCError) session_queue_mem(Session* s, char[:] body) {
    char* buf;
    if (!body.len) {
        session_clear_send(s);
        return cc_ok(true);
    }
    if (!g_blocks.pool || body.len > (size_t)FILE_SEND_CHUNK)
        return cc_err(CC_ERROR(CC_ERR_IO, "body too big for cursor"));
    session_clear_send(s);
    buf = (char*)g_blocks.pool->alloc();
    if (!buf) return cc_err(CC_ERROR(CC_ERR_OUT_OF_MEMORY, "body pool"));
    memcpy(buf, body.ptr, body.len);
    s->mem = buf;
    s->mem_len = body.len;
    s->send_off = 0;
    s->send_left = body.len;
    session_touch(s, time(NULL), g_sec_write_stall);
    return cc_ok(true);
}

/* Queue protocol bytes onto out_* (send_pool slab). Never write_all. */
static bool !>(CCError) session_queue_out(Session* s, char[:] data) {
    if (!data.len) return cc_ok(true);
    if (!g_blocks.pool)
        return cc_err(CC_ERROR(CC_ERR_OUT_OF_MEMORY, "out pool"));
    if (s->out_left) {
        size_t used = s->out_off + s->out_left;
        if (used + data.len > (size_t)FILE_SEND_CHUNK)
            return cc_err(CC_ERROR(CC_ERR_IO, "out backlog"));
        memcpy(s->out_mem + used, data.ptr, data.len);
        s->out_left += data.len;
        session_touch(s, time(NULL), g_sec_write_stall);
        return cc_ok(true);
    }
    if (data.len > (size_t)FILE_SEND_CHUNK)
        return cc_err(CC_ERROR(CC_ERR_IO, "out too big"));
    {
        char* buf = (char*)g_blocks.pool->alloc();
        if (!buf) return cc_err(CC_ERROR(CC_ERR_OUT_OF_MEMORY, "out pool"));
        memcpy(buf, data.ptr, data.len);
        s->out_mem = buf;
        s->out_off = 0;
        s->out_left = data.len;
    }
    session_touch(s, time(NULL), g_sec_write_stall);
    return cc_ok(true);
}

static CCIoAct !>(CCError) session_send_one(Session* s) {
    @errhandler(CCError e) {
        session_clear_send(s);
        session_clear_out(s);
        return cc_err(e);
    }
    /* Protocol bytes first, then body. */
    if (s->out_left) {
        size_t want = s->out_left;
        size_t n = s->io->try_write(
            cc_slice_from_buffer(s->out_mem + s->out_off, want)) !>(e) {
            if (e.base.kind == CC_IO_BUSY)
                return cc_ok((CCIoAct){ .wait_out = {} });
            session_clear_out(s);
            session_clear_send(s);
            return cc_err(e);
        };
        if (n > 0) {
            s->out_off += n;
            s->out_left -= n;
            if (s->out_left || s->send_left)
                session_touch(s, time(NULL), g_sec_write_stall);
        }
        if (s->out_left)
            return cc_ok((CCIoAct){ .wait_out = {} });
        session_clear_out(s);
        if (s->send_left)
            return cc_ok((CCIoAct){ .wait_out = {} });
        if (s->send_close) return cc_ok((CCIoAct){ .close = {} });
        return cc_ok((CCIoAct){ .wait = {} });
    }
    if (!s->send_left) return cc_ok((CCIoAct){ .wait = {} });
    if (s->mem) {
        size_t want = s->send_left;
        size_t n = s->io->try_write(
            cc_slice_from_buffer(s->mem + s->send_off, want)) !>(e) {
            if (e.base.kind == CC_IO_BUSY)
                return cc_ok((CCIoAct){ .wait_out = {} });
            session_clear_send(s);
            return cc_err(e);
        };
        if (n > 0) {
            s->send_off += n;
            s->send_left -= n;
            if (s->send_left)
                session_touch(s, time(NULL), g_sec_write_stall);
        }
    } else {
        size_t want;
        BlockHold bh;
        want = s->send_left;
        if (want > (size_t)FILE_SEND_CHUNK) want = (size_t)FILE_SEND_CHUNK;
        {
            size_t mis = s->send_off % (size_t)FILE_SEND_CHUNK;
            if (mis) {
                size_t room = (size_t)FILE_SEND_CHUNK - mis;
                if (want > room) want = room;
            }
        }
        bh = checkout_block(s->send.fd, s->send.dev, s->send.ino, s->send.mtime,
                            s->send.mtime_nsec, s->send_off, want, NULL) !>;
        {
            size_t n = s->io->try_write(cc_slice_from_buffer(bh.ptr, want)) !>(e) {
                block_hold_drop(&bh);
                if (e.base.kind == CC_IO_BUSY)
                    return cc_ok((CCIoAct){ .wait_out = {} });
                session_clear_send(s);
                return cc_err(e);
            };
            block_hold_drop(&bh);
            if (n > 0) {
                s->send_off += n;
                s->send_left -= n;
                if (s->send_left)
                    session_touch(s, time(NULL), g_sec_write_stall);
            }
        }
    }
    if (!s->send_left) {
        session_clear_send(s);
        if (s->send_close) return cc_ok((CCIoAct){ .close = {} });
        return cc_ok((CCIoAct){ .wait = {} });
    }
    return cc_ok((CCIoAct){ .wait_out = {} });
}

static bool !>(CCError) flush_conn(Session* s, Enc* c) {
    @errhandler(CCError e) { return cc_err(e); }
    char[:] sl = c->out.as_slice();
    if (sl.len)
        session_queue_out(s, sl) !>;
    c->out.release(c->arena);
    c->out = cc_string_new();
    return cc_ok(true);
}

static bool !>(CCError) enc_write(Enc* c, char[:] data) {
    if (data.len == 0) return cc_ok(true);
    if (!c->out.append(data, c->arena) || c->out.failed())
        return cc_err(CC_ERR_OUT_OF_MEMORY, "conn encode oom");
    return cc_ok(true);
}

static bool !>(CCError) enc_lit(Enc* c, char[:] s) {
    return c->write(s);
}

static bool !>(CCError) enc_status(Enc* c, int code, const char* reason) {
    CCString line = @string(`HTTP/1.1 ${code} ${reason}\r\n`, @scratch);
    return c->write(line);
}

static bool !>(CCError) enc_hdr(Enc* c, const char* name, char[:] value) {
    CCString line = @string(`${name}: ${value}\r\n`, @scratch);
    return c->write(line);
}

static bool !>(CCError) enc_end_headers(Enc* c) {
    return c->lit("\r\n");
}

static int method_sends_body(Method m) {
    @switch (m) {
    case .head:
        return 0;
    case .get:
    case .options:
    case .other:
        return 1;
    }
    return 1;
}

static Method method_of(char[:] name) {
    @switch (name) {
    case "GET":
        return (Method){ .get = {} };
    case "HEAD":
        return (Method){ .head = {} };
    case "OPTIONS":
        return (Method){ .options = {} };
    default:
        return (Method){ .other = {} };
    }
}

static const MimeSpec mime_octet_spec = { MIME_OCTET };

static const char* content_type_for(char[:] path) {
    char[:] ext = path_ext(path);
    const MimeSpec* spec = mime_ext_get(ext) ?> &mime_octet_spec;
    return k_mime[spec->kind];
}

static bool !>(CCError) enc_date_ka(Enc* c, int ka) {
    cc_arena_stack(stamp_a, 64);
    char[:] date = http_date_now(stamp_a);
    c->hdr("Date", date) !>;
    c->hdr("Connection", ka ? cc_slice_cstr("keep-alive")
                            : cc_slice_cstr("close")) !>;
    if (c->extra.len) {
        CCString extra = @string(`${c->extra}\r\n`, @scratch);
        c->write(extra) !>;
    }
    return cc_ok(true);
}

static bool !>(CCError) send_error(EncView conn, int code, const char* reason,
                                   const char* body, int with_body, int ka) {
    @errhandler(CCError e) { return cc_err(e); }
    char[:] body_s = cc_slice_cstr(body);
    size_t blen = body_s.len;
    CCString cl = @string(`${blen}`, @scratch);
    conn->status(code, reason) !>;
    if (code == 405)
        conn->hdr("Allow", cc_slice_cstr("GET, HEAD, OPTIONS")) !>;
    conn->hdr("Content-Type", cc_slice_cstr("text/plain; charset=utf-8")) !>;
    conn->hdr("Content-Length", cl) !>;
    conn->date_ka(ka) !>;
    conn->end_headers() !>;
    if (!with_body) return cc_ok(true);
    return conn->write(body_s);
}

static bool !>(CCError) send_file_hdrs(EncView conn, int code, const char* reason,
                                       char[:] url_path, size_t body_len,
                                       time_t mtime, char[:] crange, int ka) {
    @errhandler(CCError e) { return cc_err(e); }
    cc_arena_stack(stamp_a, 256);
    char[:] date = http_date_now(stamp_a);
    char[:] lm = http_last_modified(mtime, stamp_a);
    const char* ct = content_type_for(url_path);
    const char* ka_s = ka ? "keep-alive" : "close";
    CCString block;
    if (crange.ptr && crange.len > 0)
        block = @string(`HTTP/1.1 ${code} ${reason}\r\nContent-Type: ${ct}\r\nContent-Length: ${body_len}\r\nLast-Modified: ${lm}\r\nAccept-Ranges: bytes\r\nContent-Range: ${crange}\r\nDate: ${date}\r\nConnection: ${ka_s}\r\n`, @scratch);
    else
        block = @string(`HTTP/1.1 ${code} ${reason}\r\nContent-Type: ${ct}\r\nContent-Length: ${body_len}\r\nLast-Modified: ${lm}\r\nAccept-Ranges: bytes\r\nDate: ${date}\r\nConnection: ${ka_s}\r\n`, @scratch);
    conn->write(block) !>;
    if (conn->extra.len) {
        CCString extra = @string(`${conn->extra}\r\n`, @scratch);
        conn->write(extra) !>;
    }
    return conn->end_headers();
}

static bool !>(CCError) send_options(EncView conn, int ka) {
    @errhandler(CCError e) { return cc_err(e); }
    conn->status(204, "No Content") !>;
    conn->hdr("Allow", cc_slice_cstr("GET, HEAD, OPTIONS")) !>;
    conn->hdr("Accept-Ranges", cc_slice_cstr("bytes")) !>;
    conn->date_ka(ka) !>;
    return conn->end_headers();
}

static bool !>(CCError) send_not_modified(EncView conn, time_t mtime, int ka) {
    @errhandler(CCError e) { return cc_err(e); }
    cc_arena_stack(stamp_a, 64);
    char[:] lm = http_last_modified(mtime, stamp_a);
    conn->status(304, "Not Modified") !>;
    conn->hdr("Last-Modified", lm) !>;
    conn->date_ka(ka) !>;
    return conn->end_headers();
}

static bool !>(CCError) send_416(EncView conn, size_t total, int ka) {
    @errhandler(CCError e) { return cc_err(e); }
    CCString cr = @string(`bytes */${total}`, @scratch);
    conn->status(416, "Range Not Satisfiable") !>;
    conn->hdr("Content-Range", cr) !>;
    conn->hdr("Content-Length", cc_slice_cstr("0")) !>;
    conn->date_ka(ka) !>;
    return conn->end_headers();
}

static int take_line(char[:]* rest, char[:]* line) {
    if (!rest || rest->len == 0) return 0;
    char[:] s = *rest;
    @for (i, ch in s) {
        if (ch != '\n') continue;
        size_t n = i;
        if (n && s.ptr[n - 1] == '\r') n--;
        *line = s.sub(0, n);
        *rest = s.sub(i + 1, s.len);
        return 1;
    }
    return 0;
}

static bool !>(CCError) write_ws(Session* s, int opcode, char[:] body) {
    @errhandler(CCError e) { return cc_err(e); }
    unsigned char h[10];
    size_t hn;
    if (body.len > (size_t)WS_MAX_PAYLOAD)
        return cc_err(CC_ERROR(CC_ERR_IO, "ws too big"));
    hn = ws_hdr_unmasked(opcode, body.len, h);
    session_queue_out(s, cc_slice_from_buffer((char*)h, hn)) !>;
    if (body.len)
        session_queue_out(s, body) !>;
    return cc_ok(true);
}

static CCIoAct !>(CCError) http_fail(Session* s, Enc* conn, int code,
                                     const char* reason, const char* body,
                                     int with_body, int ka) {
    @errhandler(CCError e) { return cc_err(e); }
    send_error(conn, code, reason, body, with_body, ka) !>;
    flush_conn(s, conn) !>;
    if (s->out_left) {
        if (!ka) s->send_close = 1;
        return cc_ok((CCIoAct){ .wait_out = {} });
    }
    if (!ka) return cc_ok((CCIoAct){ .close = {} });
    return cc_ok((CCIoAct){ .wait = {} });
}

static CCIoAct !>(CCError) http_commit(Session* s, Enc* conn, int ka) {
    @errhandler(CCError e) { return cc_err(e); }
    flush_conn(s, conn) !>;
    if (s->out_left) {
        if (!ka) s->send_close = 1;
        return cc_ok((CCIoAct){ .wait_out = {} });
    }
    if (!ka) return cc_ok((CCIoAct){ .close = {} });
    return cc_ok((CCIoAct){ .wait = {} });
}

static const char* pages_reason(int code) {
    if (code == 200) return "OK";
    if (code == 201) return "Created";
    if (code == 204) return "No Content";
    if (code == 400) return "Bad Request";
    if (code == 404) return "Not Found";
    if (code == 500) return "Internal Server Error";
    if (code == 501) return "Not Implemented";
    return "OK";
}

static char[:] path_query_of(char[:] raw) {
    @for (i, ch in raw) {
        if (ch == '?')
            return raw.sub(i + 1, raw.len);
    }
    return cc_slice_empty();
}

static CCIoAct !>(CCError) pages_send(Session* s, Enc* conn, ScriptReply* r,
                                      Method meth, int ka) {
    @errhandler(CCError e) { return cc_err(e); }
    CCString cl = @string(`${r->body.len}`, @scratch);
    const char* reason = pages_reason(r->status);
    char[:] ct = cc_slice_cstr(r->content_type);
    conn->status(r->status, reason) !>;
    conn->hdr("Content-Type", ct) !>;
    conn->hdr("Content-Length", cl) !>;
    conn->date_ka(ka) !>;
    @for (i in 0..r->nhdrs) {
        conn->hdr(r->hdrs[i].name, cc_slice_cstr(r->hdrs[i].value)) !>;
    }
    conn->end_headers() !>;
    flush_conn(s, conn) !>;
    @switch (meth) {
    case .get:
        if (r->body.len) {
            session_queue_mem(s, r->body) !>;
            s->send_close = !ka;
            return cc_ok((CCIoAct){ .wait_out = {} });
        }
        break;
    case .head:
    case .options:
    case .other:
        break;
    }
    if (s->out_left) {
        if (!ka) s->send_close = 1;
        return cc_ok((CCIoAct){ .wait_out = {} });
    }
    if (!ka) return cc_ok((CCIoAct){ .close = {} });
    return cc_ok((CCIoAct){ .wait = {} });
}

static size_t headers_end(Session* s) {
    char[:] w = s->io->window();
    @for (i, ch in w) {
        if (ch != '\r') continue;
        if (w.sub(i, w.len).starts_with("\r\n\r\n"))
            return i + 4;
    }
    return 0;
}

/* One request. Sets s->phase = .ws on upgrade.
 * Caller has a complete header block at the front of s->io->window(). */
static CCIoAct !>(CCError) handle_http(Session* s, Enc* conn, Cfg* cfg) {
    @errhandler(CCError e) { return cc_err(e); }
    size_t hend = headers_end(s);
    char[:] block;
    char[:] rest;
    int parsed = 0, ka = 1, want_close = 0;
    int want_upgrade = 0;
    int has_upgrade_hdr = 0;
    int has_ws_upgrade = 0;
    int ws_ver_ok = 0;
    int has_body = 0;
    char[:] url;
    char[:] empty = cc_slice_empty();
    char[:] ims = empty;
    char[:] range = empty;
    char[:] ifr = empty;
    char[:] ws_key = empty;
    char[:] first;
    Method meth = (Method){ .other = {} };
    time_t mtime = 0, ims_t;
    size_t off = 0, nsend;
    int rkind;
    FileHold fh = { .slot = -1, .fd = -1 };
    size_t file_len;
    int root_fd = cfg->root_fd;
    @defer fh.drop();

    if (!hend) return cc_err(CC_ERROR(CC_ERR_IO, "no headers"));
    s->header_hard_deadline = 0;
    {
        char[:] win = s->io->window();
        block = win.sub(0, hend);
    }
    rest = block;
    if (!take_line(&rest, &first))
        return cc_err(CC_ERROR(CC_ERR_IO, "bad request line"));

    ReqLine req;
    parsed = cc_parse(ReqLine, first.ptr, first.len, conn->arena, &req);
    CCString path_s = cc_string_new();
    char[:] query_s = empty;
    if (parsed) {
        meth = method_of(req.method);
        {
            char[:] raw = path_without_query(req.path);
            query_s = path_query_of(req.path);
            uri_path_decode(raw, &path_s, conn->arena) !>(e) {
                (void)e;
                s->io->consume(hend);
                return http_fail(s, conn, 400, "Bad Request", "bad uri\n", 1, 0);
            };
        }
        if (path_s.failed()) {
            s->io->consume(hend);
            return http_fail(s, conn, 500, "Internal Server Error", "oom\n", 1, 0);
        }
        ka = !req.version.eq_cstr("HTTP/1.0");
    }

    for (;;) {
        char[:] h;
        char[:] val;
        if (!take_line(&rest, &h)) break;
        if (h.len == 0) break;
        if (hdr_val(h, "connection", &val)) {
            int saw_close = 0, saw_ka = 0;
            connection_scan(val, &saw_close, &saw_ka);
            if (saw_close) want_close = 1;
            else if (saw_ka) ka = 1;
            if (connection_has(val, "upgrade")) has_upgrade_hdr = 1;
        } else if (hdr_val(h, "upgrade", &val)) {
            if (ci_eq(val, "websocket")) has_ws_upgrade = 1;
        } else if (hdr_val(h, "sec-websocket-key", &val)) {
            CCString ks = @string(`${val}`, conn->arena);
            if (!ks.failed()) ws_key = ks;
        } else if (hdr_val(h, "sec-websocket-version", &val)) {
            if (ci_eq(val, "13")) ws_ver_ok = 1;
        } else if (hdr_val(h, "if-modified-since", &val)) {
            CCString ks = @string(`${val}`, conn->arena);
            if (!ks.failed()) ims = ks;
        } else if (hdr_val(h, "range", &val)) {
            CCString ks = @string(`${val}`, conn->arena);
            if (!ks.failed()) range = ks;
        } else if (hdr_val(h, "if-range", &val)) {
            CCString ks = @string(`${val}`, conn->arena);
            if (!ks.failed()) ifr = ks;
        } else if (hdr_val(h, "content-length", &val)
                || hdr_val(h, "transfer-encoding", &val)) {
            has_body = 1;
        }
    }
    if (want_close || has_body) ka = 0;
    want_upgrade = has_upgrade_hdr && has_ws_upgrade && ws_ver_ok;
    s->io->consume(hend);
    if (!parsed) {
        int head400 = first.starts_with("HEAD ");
        return http_fail(s, conn, 400, "Bad Request", "bad request\n", !head400, ka);
    }
    @switch (meth) {
    case .get:
        if (want_upgrade && ws_key.len) {
            char acc[29];
            char[:] accept;
            if (!ws_accept_b64(ws_key, acc))
                return http_fail(s, conn, 400, "Bad Request",
                                 "bad websocket key\n", 1, 0);
            accept = cc_slice_cstr(acc);
            conn->status(101, "Switching Protocols") !>;
            conn->hdr("Upgrade", cc_slice_cstr("websocket")) !>;
            conn->hdr("Connection", cc_slice_cstr("Upgrade")) !>;
            conn->hdr("Sec-WebSocket-Accept", accept) !>;
            conn->end_headers() !>;
            flush_conn(s, conn) !>;
            s->phase = (Phase){ .ws = {} };
            return http_commit(s, conn, 1);
        }
        break;
    case .other:
        return http_fail(s, conn, 405, "Method Not Allowed",
                         "method not allowed\n", 1, 0);
    case .head:
    case .options:
        break;
    }

    url = path_s;
    if (!path_is_safe(url))
        return http_fail(s, conn, 403, "Forbidden", "forbidden\n",
                         method_sends_body(meth), ka);
    if (url.len > (size_t)K_PATH_MAX)
        return http_fail(s, conn, 414, "URI Too Long", "uri too long\n",
                         method_sends_body(meth), ka);

    @switch (meth) {
    case .options:
        send_options(conn, ka) !>;
        return http_commit(s, conn, ka);
    case .get:
    case .head:
    case .other:
        break;
    }

    const char* rel = "";
    {
        const char* p = path_s.cstr(conn->arena) !>(e) {
            (void)e;
            return http_fail(s, conn, 500, "Internal Server Error", "oom\n",
                             method_sends_body(meth), ka);
        };
        rel = (p[0] == '/') ? p + 1 : p;
    }

    /* Pages arm: MISS falls through to static. */
    if (cfg->pages_fd >= 0) {
        PagesKind kind = PAGES_MISS;
        ScriptReply reply = pages_serve(cfg->pages_fd, url, req.method, url,
                                        query_s, empty, conn->arena, &kind)
                !>(e) {
            int code = 500;
            const char* msg = "pages failed\n";
            if (kind == PAGES_NO_ENGINE) {
                code = 501;
                msg = "pages: engine not attached\n";
            } else if (kind == PAGES_BOTH) {
                msg = "pages: both .js and .py\n";
            } else if (e.message && e.message[0]) {
                msg = e.message;
            }
            return http_fail(s, conn, code,
                             code == 501 ? "Not Implemented"
                                         : "Internal Server Error",
                             msg, method_sends_body(meth), ka);
        };
        if (kind == PAGES_JS || kind == PAGES_PY)
            return pages_send(s, conn, &reply, meth, ka);
    }

    int got_file = try_file(root_fd, rel, &fh);
    if (!got_file) {
        int dfd = fs_dir_open(root_fd, rel);
        char idx[K_PATH_MAX];
        if (dfd < 0)
            return http_fail(s, conn, 404, "Not Found", "not found\n",
                             method_sends_body(meth), ka);
        if (!join_index(idx, sizeof(idx), rel, cfg->index)) {
            close(dfd);
            return http_fail(s, conn, 414, "URI Too Long", "uri too long\n",
                             method_sends_body(meth), ka);
        }
        if (try_file(root_fd, idx, &fh)) {
            CCString mu = @string(`/${idx}`, conn->arena);
            if (!mu.failed()) url = mu;
            close(dfd);
            got_file = 1;
        } else if (!cfg->list) {
            close(dfd);
            return http_fail(s, conn, 403, "Forbidden", "forbidden\n",
                             method_sends_body(meth), ka);
        } else {
            struct stat dst;
            time_t dmtime = 0;
            if (fstat(dfd, &dst) == 0) dmtime = dst.st_mtime;
            cc_arena_stack(list_a, K_LIST_ARENA);
            CCString html = dir_listing(dfd, url, list_a) !>(e) {
                (void)e;
                return http_fail(s, conn, 500, "Internal Server Error",
                                 "listing\n", method_sends_body(meth), ka);
            };
            if (ims.len && http_parse_date(ims, conn->arena, &ims_t)
                    && ims_t >= dmtime) {
                send_not_modified(conn, dmtime, ka) !>;
                return http_commit(s, conn, ka);
            }
            send_file_hdrs(conn, 200, "OK", cc_slice_cstr("/listing.html"),
                           (size_t)html.len, dmtime, empty, ka) !>;
            flush_conn(s, conn) !>;
            @switch (meth) {
            case .get:
                if (html.len > 0) {
                    session_queue_mem(s, html.as_slice()) !>;
                    s->send_close = !ka;
                    return cc_ok((CCIoAct){ .wait_out = {} });
                }
                break;
            case .head:
            case .options:
            case .other:
                break;
            }
            if (s->out_left) {
                if (!ka) s->send_close = 1;
                return cc_ok((CCIoAct){ .wait_out = {} });
            }
            if (!ka) return cc_ok((CCIoAct){ .close = {} });
            return cc_ok((CCIoAct){ .wait = {} });
        }
    }
    mtime = fh.mtime;
    file_len = fh.file_len;
    if (ims.len && http_parse_date(ims, conn->arena, &ims_t) && ims_t >= mtime) {
        send_not_modified(conn, mtime, ka) !>;
        return http_commit(s, conn, ka);
    }

    if (range.len && ifr.len) {
        time_t ifr_t;
        if (!(http_parse_date(ifr, conn->arena, &ifr_t) && ifr_t == mtime))
            range = empty;
    }

    nsend = file_len;
    rkind = range.len ? range_parse(range, file_len, conn->arena, &off, &nsend) : 0;
    if (rkind < 0) {
        send_416(conn, file_len, ka) !>;
        return http_commit(s, conn, ka);
    }
    if (rkind > 0) {
        size_t last = off + nsend - 1;
        CCString cr = @string(`bytes ${off}-${last}/${file_len}`, @scratch);
        if (cr.failed())
            return cc_err(CC_ERROR(CC_ERR_OUT_OF_MEMORY, "content-range"));
        send_file_hdrs(conn, 206, "Partial Content", url, nsend, mtime,
                       cr.as_slice(), ka) !>;
    } else {
        send_file_hdrs(conn, 200, "OK", url, nsend, mtime, empty, ka) !>;
    }
    flush_conn(s, conn) !>;
    {
        int send_body = 0;
        @switch (meth) {
        case .get:
            send_body = nsend > 0;
            break;
        case .head:
        case .options:
        case .other:
            break;
        }
        if (send_body) {
            session_queue_send(s, &fh, off, nsend);
            s->send_close = !ka;
            return cc_ok((CCIoAct){ .wait_out = {} });
        }
    }
    if (s->out_left) {
        if (!ka) s->send_close = 1;
        return cc_ok((CCIoAct){ .wait_out = {} });
    }
    if (!ka) return cc_ok((CCIoAct){ .close = {} });
    return cc_ok((CCIoAct){ .wait = {} });
}

static WsStep !>(CCError) ws_one_frame(Session* s) {
    @errhandler(CCError e) { return cc_err(e); }
    unsigned char b0, b1, maskk[4];
    int opcode, masked;
    size_t n = 0, need = 2, hdr = 2;
    char* payload;
    char[:] w = s->io->window();
    if (w.len < 2) return cc_ok((WsStep){ .more = {} });
    b0 = (unsigned char)w.ptr[0];
    b1 = (unsigned char)w.ptr[1];
    if ((b0 & 0x80) == 0) return cc_ok((WsStep){ .fin = {} });
    opcode = (int)(b0 & 0x0f);
    masked = (b1 & 0x80) != 0;
    n = (size_t)(b1 & 0x7f);
    if (n == 126) {
        if (w.len < 4) return cc_ok((WsStep){ .more = {} });
        n = ((size_t)(unsigned char)w.ptr[2] << 8)
          | (size_t)(unsigned char)w.ptr[3];
        hdr = 4;
    } else if (n == 127) {
        if (w.len < 10) return cc_ok((WsStep){ .more = {} });
        @for (ch in w.sub(2, 8)) {
            if (ch) return cc_ok((WsStep){ .fin = {} });
        }
        n = ((size_t)(unsigned char)w.ptr[8] << 8)
          | (size_t)(unsigned char)w.ptr[9];
        hdr = 10;
    }
    if (!masked || n > (size_t)WS_MAX_PAYLOAD)
        return cc_ok((WsStep){ .fin = {} });
    need = hdr + 4 + n;
    if (need > s->io->rcap)
        return cc_ok((WsStep){ .fin = {} });
    if (w.len < need) return cc_ok((WsStep){ .more = {} });
    {
        char[:] mk = cc_slice_from_buffer((char*)maskk, 4);
        mk.copy(w.sub(hdr, hdr + 4)) !>;
    }
    payload = w.ptr + hdr + 4;
    if (n) ws_unmask(payload, n, maskk);
    if (opcode == 8) {
        write_ws(s, 8, cc_slice_from_buffer(payload, n)) !>;
        s->io->consume(need);
        s->send_close = 1;
        return cc_ok((WsStep){ .again = {} });
    }
    if (opcode == 9) {
        write_ws(s, 10, cc_slice_from_buffer(payload, n)) !>;
        s->io->consume(need);
        return cc_ok((WsStep){ .again = {} });
    }
    if (opcode == 10) {
        s->io->consume(need);
        return cc_ok((WsStep){ .again = {} });
    }
    if (opcode == 1 || opcode == 2) {
        write_ws(s, opcode, cc_slice_from_buffer(payload, n)) !>;
        s->io->consume(need);
        return cc_ok((WsStep){ .again = {} });
    }
    s->io->consume(need);
    return cc_ok((WsStep){ .fin = {} });
}

/* HTTP / WS until the row needs another wait. Transport already filled. */
static CCIoAct !>(CCError) session_app(Session* s, Enc* conn, Cfg* cfg) {
    @errhandler(CCError e) { return cc_err(e); }
    for (;;) {
        if (s->out_left || s->send_left) {
            CCIoAct a = session_send_one(s) !>;
            @switch (a) {
            case .close: return cc_ok(a);
            case .wait:
            case .wait_out:
                break;
            }
            if (s->out_left || s->send_left)
                return cc_ok((CCIoAct){ .wait_out = {} });
            if (s->send_close) return cc_ok((CCIoAct){ .close = {} });
            continue;
        }
        @switch (s->phase) {
        case .ws: {
            WsStep st = ws_one_frame(s) !>;
            CCIoAct fin = (CCIoAct){ .close = {} };
            CCIoAct more = (CCIoAct){ .wait = {} };
            CCIoAct out = (CCIoAct){ .wait_out = {} };
            @switch (st) {
            case .fin:
                return cc_ok(fin);
            case .more:
                /* Window full and still incomplete → frame cannot fit. */
                if (s->io->full()) return cc_ok(fin);
                session_touch(s, time(NULL), g_sec_ws_idle);
                return cc_ok(more);
            case .again:
                session_touch(s, time(NULL), g_sec_ws_idle);
                if (s->out_left)
                    return cc_ok(out);
                continue;
            }
            continue;
        }
        case .http:
            if (!headers_end(s)) {
                char[:] win = s->io->window();
                time_t now = time(NULL);
                if (s->io->full())
                    return http_fail(s, conn, 400, "Bad Request",
                                     "headers too big\n", 1, 0);
                if (win.len == 0) {
                    s->header_hard_deadline = 0;
                    session_touch(s, now, g_sec_keepalive);
                } else {
                    session_touch_headers(s, now);
                }
                return cc_ok((CCIoAct){ .wait = {} });
            }
            {
                CCIoAct a = handle_http(s, conn, cfg) !>;
                @switch (a) {
                case .close: return cc_ok(a);
                case .wait:
                case .wait_out:
                    break;
                }
            }
            @switch (s->phase) {
            case .http:
                conn->arena.reset();
                conn->out = cc_string_new();
                break;
            case .ws:
                session_touch(s, time(NULL), g_sec_ws_idle);
                break;
            }
            break;
        }
    }
}

static const char* extra_header_arg(const char* a, int i, int argc, char** argv) {
    char[:] s = cc_slice_cstr(a);
    if (s.eq_cstr("--header") && i + 1 < argc) return argv[i + 1];
    if (s.starts_with("--header=")) return a + 9;
    return NULL;
}

static int index_name_ok(char[:] idx) {
    if (!idx.len || idx.eq_cstr(".") || idx.eq_cstr("..")) return 0;
    @for (ch in idx) {
        if (ch == '/' || ch == '\\' || ch == '?') return 0;
    }
    return 1;
}

static int header_line_ok(char[:] v) {
    int colon = 0;
    if (!v.len) return 0;
    @for (ch in v) {
        if (ch == '\r' || ch == '\n') return 0;
        if (ch == ':') colon = 1;
    }
    return colon;
}

int main(int argc, char** argv) {
    cc_arena_pool_stack(send_pool, FILE_SEND_CHUNK, megabytes(1));
    cc_arena_pool_stack(sess_pool, sizeof(Session), kilobytes(64));

    @errhandler(CCError err) {
        cc_error_log(err);
        return 1;
    }

    staticd_load_budgets();

    cc_arena_stack(cli_a, kilobytes(4));
    staticd_sync_init(cli_a.create_exclusive(4) !>);
    block_cache_init(&g_blocks, &send_pool);
    StaticdOpts opts = {0};
    bool go = cc_prepare_args(StaticdOpts, argc, argv, cli_a, &opts, stderr) !>;
    if (!go) return 0;

    char[:0] listen = opts.listen;
    int nworkers = (int)opts.workers;
    if (nworkers <= 0) {
        long n = sysconf(_SC_NPROCESSORS_ONLN);
        nworkers = (n > 1) ? (int)(n / 2) : 1;
    }
    if (nworkers > WORKERS_MAX) nworkers = WORKERS_MAX;

    Cfg cfg = {
        .root_fd = -1,
        .pages_fd = -1,
        .list = 0,
        .index = "index.html",
        .extra = cc_slice_empty(),
    };

    CCServer srv;
    srv.init(nworkers);
    srv.sec_tls_hs = g_sec_tls_hs;
    srv.sec_first_byte = g_sec_header_total;
    @defer srv.close();

    char[:] root_view = opts.root;
    if (root_view.len == 0) {
        eprintln("staticd: empty docroot");
        return 1;
    }
    while (root_view.len > 1 && root_view.ptr[root_view.len - 1] == '/')
        root_view = root_view.sub(0, root_view.len - 1);
    CCString root_owned = @string(`${root_view}`, cli_a);
    if (root_owned.failed()) {
        eprintln("staticd: docroot oom");
        return 1;
    }
    const char* root_c = root_owned.cstr(cli_a) !> {
        eprintln("staticd: docroot nul");
        return 1;
    };
    cfg.root_fd = open(root_c, O_RDONLY | O_DIRECTORY | O_CLOEXEC);
    if (cfg.root_fd < 0) {
        eprintln(@string(`staticd: docroot open: ${root_c}`, @scratch));
        return 1;
    }
    @defer close(cfg.root_fd);

    {
        char[:] pages_view = opts.pages;
        if (pages_view.len > 0) {
            while (pages_view.len > 1
                    && pages_view.ptr[pages_view.len - 1] == '/')
                pages_view = pages_view.sub(0, pages_view.len - 1);
            CCString pages_owned = @string(`${pages_view}`, cli_a);
            if (pages_owned.failed()) {
                eprintln("staticd: pages oom");
                return 1;
            }
            const char* pages_c = pages_owned.cstr(cli_a) !> {
                eprintln("staticd: pages nul");
                return 1;
            };
            int pfd = open(pages_c, O_RDONLY | O_DIRECTORY | O_CLOEXEC);
            if (pfd < 0) {
                eprintln(@string(`staticd: pages open: ${pages_c}`, @scratch));
                return 1;
            }
            cfg.pages_fd = pfd;
            if (pages_engines_open() != 0) {
                eprintln("staticd: pages engines open failed");
                return 1;
            }
        }
    }
    @defer {
        pages_engines_close();
        if (cfg.pages_fd >= 0) close(cfg.pages_fd);
    };

    {
        char[:] cert_v = opts.tls_cert;
        char[:] key_v = opts.tls_key;
        int have_c = cert_v.len > 0;
        int have_k = key_v.len > 0;
        if (have_c != have_k) {
            eprintln("staticd: --tls-cert and --tls-key are required together");
            return 1;
        }
        if (have_c) {
            CCString cert_owned = @string(`${cert_v}`, cli_a);
            CCString key_owned = @string(`${key_v}`, cli_a);
            if (cert_owned.failed() || key_owned.failed()) {
                eprintln("staticd: tls path oom");
                return 1;
            }
            const char* cert_c = cert_owned.cstr(cli_a) !> {
                eprintln("staticd: tls cert nul");
                return 1;
            };
            const char* key_c = key_owned.cstr(cli_a) !> {
                eprintln("staticd: tls key nul");
                return 1;
            };
            if (srv.load_tls(cert_c, key_c) != 0) {
                eprintln("staticd: tls load failed (bad PEM cert/key?)");
                return 1;
            }
        }
    }

    cfg.list = opts.list ? 1 : 0;
    {
        char[:] idx = opts.index;
        if (idx.len == 0)
            cfg.index = "index.html";
        else if (!index_name_ok(idx)) {
            eprintln("staticd: bad --index");
            return 1;
        } else {
            CCString idx_owned = @string(`${idx}`, cli_a);
            if (idx_owned.failed()) {
                eprintln("staticd: index oom");
                return 1;
            }
            cfg.index = idx_owned.cstr(cli_a) !> {
                eprintln("staticd: index nul");
                return 1;
            };
        }
    }
    CCString extra = cc_string_new();
    {
        int n = 0;
        @for (i in 1..argc) {
            const char* v = extra_header_arg(argv[i], (int)i, argc, argv);
            if (!v) continue;
            if (!header_line_ok(cc_slice_cstr(v))) {
                eprintln("staticd: bad --header (want Name: value, no CR/LF)");
                return 1;
            }
            if (n) extra.append("\r\n", cli_a);
            extra.append(v, cli_a);
            n++;
        }
        if (extra.failed()) {
            eprintln("staticd: --header oom");
            return 1;
        }
        cfg.extra = extra.as_slice();
    }

    srv.listen(listen) !>(err) {
        const char* msg = cc_error_str(err);
        eprintln(@string(`listen: ${msg}`, @scratch));
        return 1;
    };
    {
        int start = srv.start_n();
        int cap = srv.workers_max;
        if (cfg.pages_fd >= 0 && srv.tls)
            println(@string(`staticd on ${listen} root=${root_c} pages=on tls=on workers=${start}..${cap}`, @scratch));
        else if (cfg.pages_fd >= 0)
            println(@string(`staticd on ${listen} root=${root_c} pages=on workers=${start}..${cap}`, @scratch));
        else if (srv.tls)
            println(@string(`staticd on ${listen} root=${root_c} tls=on workers=${start}..${cap}`, @scratch));
        else
            println(@string(`staticd on ${listen} root=${root_c} workers=${start}..${cap}`, @scratch));
    }
    CCSignal stop = cc_signal_watch2(SIGINT, SIGTERM) !> @destroy;
    Cfg* cfgp = &cfg;
    CCArenaPool* sessions = &sess_pool;
    srv.serve(&stop, (CCIoSess* io) => [cfgp, sessions] {
        @errhandler(CCError e) { (void)e; io->dead = 1; }
        Session* s;
        Enc enc;
        CCIoAct a;
        if (io->dead) {
            session_release(io, sessions);
            return;
        }
        s = session_of(io, sessions);
        if (!s) {
            io->dead = 1;
            return;
        }
        cc_arena_stack(enc_a, K_OUT_BUF);
        enc = (Enc){ .arena = enc_a, .out = cc_string_new(), .extra = cfgp->extra };
        a = session_app(s, &enc, cfgp) !>;
        io->apply(a);
        if (io->dead) session_release(io, sessions);
    }) !>;
    {
        int nfail = srv.tls_fails();
        if (srv.tls && nfail > 0)
            eprintln(@string(`staticd: tls handshake failures: ${nfail}`, @scratch));
    }
    return 0;
}

/*
 * staticd — Concurrent-C static HTTP/1.1 + WebSocket (specimen).
 *
 * Sessions are rows. Dest is the worker. The worker loop is the page:
 * poll → step rows → accept → reap. A ready fd fills, then one HTTP
 * request or WS frames (no dest-per-conn). A file body is a cursor on
 * the row; a step sends one chunk. POLLOUT waits while left.
 * Workers: start 2 (1 if the cap is 1), grow with live conns (one
 * accept per poll). Cap is ncpu/2 (`--workers 0`) or N. `--workers 1`
 * stays one dest — the page, and the isolate receipt.
 * `ServerCfg` holds policy (root/pages/tls/index/list/extra). Join/grow
 * atomics are process-wide. `serve(cfg)` owns the worker zip. Session
 * embeds `CCIoSess` (transport); `SessAct` is wait|close; TLS wraps once
 * at accept (`g_tls_fail` counts drops). Pages are an early arm
 * (`pages_serve`; MISS → static).
 *
 * Live table is Vec of Session* on a worker stack arena; slots are a
 * pool on that arena. Encode scratch is a second stack arena on the worker.
 *
 *   staticd_io.cch      — CCIoSess / SessAct / fill·write·tls·accept·reap
 *   staticd_http.cch    — date / Range / header-CI mechanics
 *   staticd_block.cch   — block ring keyed by dev+ino (reuse; idle cull)
 *   staticd_fs.cch      — jail, 1s fd cache, FileHold, listing
 *   staticd_script.cch  — --pages QuickJS / CPython views (same ABI)
 *   staticd_ws.cch      — SHA-1 / base64 / frame tape
 *
 * Usage:  ./out/staticd [--listen ADDR] [--root DIR] [--pages DIR]
 *                       [--tls-cert PEM] [--tls-key PEM]
 *                       [--index NAME] [--list] [--header 'Name: value']
 *                       [--workers N]
 * v1: GET/HEAD/OPTIONS, keep-alive, Date/Last-Modified/IMS, one Range,
 *     send cursor (one 64KB chunk per step). `?query` ignored on files;
 *     passed to pages. `--list` off. `--index` default index.html.
 *     `--pages` off. Optional TLS (`--tls-cert` + `--tls-key`). WS echo
 *     on Upgrade.
 */

#include <ccc/std/prelude.cch>
#include <ccc/cc_atomic.cch>
#include <ccc/cc_instantiate.cch>
#include <ccc/std/net.cch>
#include <ccc/std/tls.cch>
@link("../../third_party/bearssl/build/libbearssl.a")
#include <ccc/std/signal.cch>
#include <ccc/std/cli.cch>
#include <ccc/std/static_map.cch>
#include <ccc/stdio.cch>
#include <ccc/script/quickjs.cch>
#include <ccc/script/py.cch>
#include <stdlib.h>
#include "staticd_http.cch"
#include "staticd_block.cch"
#include "staticd_fs.cch"
#include "staticd_script.cch"
#include "staticd_ws.cch"
#include "staticd_io.cch"
#include <time.h>
#include <fcntl.h>
#include <sys/stat.h>
#include <sys/socket.h>
#include <unistd.h>
#include <errno.h>

#define K_READ_BUF   K_IO_READ_BUF
#define K_OUT_BUF    (8 * 1024)
#define K_PATH_MAX   4096
#define K_LIST_ARENA (32 * 1024)
#define WORKERS_MAX  32
#define POLL_MS      50
#define WORKER_GROW_EVERY 64

enum {
    SESS_HTTP = 0,
    SESS_WS = 1
};

/* Policy for one serve(); join/grow atomics stay process-wide. */
typedef struct ServerCfg {
    int root_fd;
    int pages_fd;
    int list;
    int tls;
    const char* index;
    CCSlice extra;
} ServerCfg;

typedef struct Conn {
    CCArena arena;
    CCString out;
    CCSlice extra; /* --header lines; view owned by ServerCfg */
} Conn;

/* App row: transport embed + send cursor + HTTP/WS phase. */
typedef struct Session {
    CCIoSess io;
    char read_buf[K_READ_BUF];
    FileHold send;
    size_t send_off;
    size_t send_left;
    int phase;
    int send_close;
} Session;

typedef Session* SessionP;

/* Session is CCIoSess for fill/write/wrap; Io allow-lists the face. */
@typeview on Session {
    as: io;
};

typedef @typeview Io on Session {
    r: fill, write_all, wrap_tls, consume, arm, drop;
} *SessIo;

typedef @typeview Encode on Conn {
    r: write, lit, status, hdr, end_headers, date_ka, extra;
} *ConnEnc;

/* Process-wide join/grow tape (not HTTP policy). */
static cc_atomic_int g_stop;
static cc_atomic_int g_live;
static cc_atomic_int g_nworkers;
static cc_atomic_int g_tls_fail; /* handshake / wrap drops (not EAGAIN) */
static int g_workers_max;
static CCListener* g_ln;
static ServerCfg* g_cfg;
static CCParallel g_app;

@grammar(cli) StaticdOpts {~~~~
    help: flag -h, --help desc "Show help"
    listen: opt string -l, --listen as ADDR default "127.0.0.1:8080" desc "Listen address host:port"
    root: opt string -r, --root as DIR default "fixtures" desc "Document root"
    list: flag --list desc "Directory listing when no index file"
    index: opt string --index as NAME default "index.html" desc "Directory index file"
    header: opt string --header as LINE desc "Extra response header Name: value (repeatable)"
    workers: opt i64 -w, --workers as N default 0 desc "Worker cap (0 = ncpu/2; start 2, grow with conns)"
    pages: opt string --pages as DIR default "" desc "Script pages jail (.js / .py views; off when empty)"
    tls_cert: opt string --tls-cert as PATH default "" desc "PEM certificate chain (requires --tls-key)"
    tls_key: opt string --tls-key as PATH default "" desc "PEM private key (requires --tls-cert)"
~~~~}

@grammar(schema) ReqLine {~~~~
    rules [
        mtok: keep [some charset [#'A' - #'Z']]
        pchar: complement charset [#' ' #'#' #'\r' #'\n']
        pth: keep [#'/' any pchar]
        vtok: keep ["HTTP/1.0" | "HTTP/1.1"]
    ]
    method: mtok #' ' path: pth #' ' version: vtok
~~~~}

@variant Method {
    get: void;
    head: void;
    options: void;
    other: void;
};

typedef enum MimeTag {
    MIME_OCTET = 0,
    MIME_HTML,
    MIME_CSS,
    MIME_JS,
    MIME_JSON,
    MIME_PNG,
    MIME_JPEG,
    MIME_GIF,
    MIME_SVG,
    MIME_TXT,
} MimeTag;

typedef struct MimeSpec {
    MimeTag kind;
} MimeSpec;

typedef struct MimeEntry {
    const char* key;
    MimeSpec value;
} MimeEntry;

@comptime {
    MimeEntry mime_entries[] = {
        { ".html", { MIME_HTML } },
        { ".htm",  { MIME_HTML } },
        { ".css",  { MIME_CSS } },
        { ".js",   { MIME_JS } },
        { ".json", { MIME_JSON } },
        { ".png",  { MIME_PNG } },
        { ".jpg",  { MIME_JPEG } },
        { ".jpeg", { MIME_JPEG } },
        { ".gif",  { MIME_GIF } },
        { ".svg",  { MIME_SVG } },
        { ".txt",  { MIME_TXT } },
        { ".bin",  { MIME_OCTET } },
    };
    static_map("mime_ext", mime_entries, CC_STATIC_MAP_ASCII_CI);
}

static const char* k_mime[] = {
    [MIME_OCTET] = "application/octet-stream",
    [MIME_HTML]  = "text/html; charset=utf-8",
    [MIME_CSS]   = "text/css; charset=utf-8",
    [MIME_JS]    = "application/javascript; charset=utf-8",
    [MIME_JSON]  = "application/json",
    [MIME_PNG]   = "image/png",
    [MIME_JPEG]  = "image/jpeg",
    [MIME_GIF]   = "image/gif",
    [MIME_SVG]   = "image/svg+xml",
    [MIME_TXT]   = "text/plain; charset=utf-8",
};

static bool !>(CCError) flush_conn(Session* s, Conn* c) {
    @errhandler(CCError e) { return cc_err(e); }
    char[:] sl = c->out.as_slice();
    if (sl.len)
        s->io.write_all(sl) !>;
    c->out.release(c->arena);
    c->out = cc_string_new();
    return cc_ok(true);
}

static void session_clear_send(Session* s) {
    s->send.drop();
    s->send_off = 0;
    s->send_left = 0;
}

#define STATICD_IO_ZIP
#include "staticd_io.cch"

static void session_queue_send(Session* s, FileHold* fh, size_t off, size_t nsend) {
    session_clear_send(s);
    s->send = *fh;
    *fh = (FileHold){ .slot = -1, .fd = -1 };
    s->send_off = off;
    s->send_left = nsend;
}

/* One FILE_SEND_CHUNK. Leaves send_left if more. */
static SessAct !>(CCError) session_send_one(Session* s) {
    @errhandler(CCError e) {
        session_clear_send(s);
        return cc_err(e);
    }
    size_t want;
    BlockHold bh;
    if (!s->send_left) return cc_ok((SessAct){ .wait = {} });
    want = s->send_left;
    if (want > (size_t)FILE_SEND_CHUNK) want = (size_t)FILE_SEND_CHUNK;
    bh = checkout_block(s->send.fd, s->send.dev, s->send.ino, s->send.mtime,
                        s->send_off, want) !>;
    s->io.write_all(cc_slice_from_buffer(bh.ptr, want)) !>(e) {
        block_hold_drop(&bh);
        session_clear_send(s);
        return cc_err(e);
    };
    block_hold_drop(&bh);
    s->send_off += want;
    s->send_left -= want;
    if (!s->send_left) {
        session_clear_send(s);
        if (s->send_close) return cc_ok((SessAct){ .close = {} });
    }
    return cc_ok((SessAct){ .wait = {} });
}

static bool !>(CCError) conn_write(Conn* c, char[:] data) {
    if (data.len == 0) return cc_ok(true);
    if (!c->out.append(data, c->arena) || c->out.failed())
        return cc_err(CC_ERR_OUT_OF_MEMORY, "conn encode oom");
    return cc_ok(true);
}

static bool !>(CCError) conn_lit(Conn* c, char[:] s) {
    return c->write(s);
}

static bool !>(CCError) conn_status(Conn* c, int code, const char* reason) {
    CCString line = @string(`HTTP/1.1 ${code} ${reason}\r\n`, @scratch);
    return c->write(line);
}

static bool !>(CCError) conn_hdr(Conn* c, const char* name, char[:] value) {
    CCString line = @string(`${name}: ${value}\r\n`, @scratch);
    return c->write(line);
}

static bool !>(CCError) conn_end_headers(Conn* c) {
    return c->lit("\r\n");
}

static Method method_of(char[:] name) {
    @switch (name) {
    case "GET":
        return (Method){ .get = {} };
    case "HEAD":
        return (Method){ .head = {} };
    case "OPTIONS":
        return (Method){ .options = {} };
    default:
        return (Method){ .other = {} };
    }
}

static const MimeSpec mime_octet_spec = { MIME_OCTET };

static const char* content_type_for(char[:] path) {
    char[:] ext = path_ext(path);
    const MimeSpec* spec = mime_ext_get(ext) ?> &mime_octet_spec;
    return k_mime[spec->kind];
}

static bool !>(CCError) conn_date_ka(Conn* c, int ka) {
    cc_arena_stack(stamp_a, 64);
    char[:] date = http_date_now(stamp_a);
    c->hdr("Date", date) !>;
    c->hdr("Connection", ka ? cc_slice_cstr("keep-alive")
                            : cc_slice_cstr("close")) !>;
    if (c->extra.len) {
        CCString extra = @string(`${c->extra}\r\n`, @scratch);
        c->write(extra) !>;
    }
    return cc_ok(true);
}

static bool !>(CCError) send_error(ConnEnc conn, int code, const char* reason,
                                   const char* body, int with_body, int ka) {
    @errhandler(CCError e) { return cc_err(e); }
    char[:] body_s = cc_slice_cstr(body);
    size_t blen = body_s.len;
    CCString cl = @string(`${blen}`, @scratch);
    conn->status(code, reason) !>;
    if (code == 405)
        conn->hdr("Allow", cc_slice_cstr("GET, HEAD, OPTIONS")) !>;
    conn->hdr("Content-Type", cc_slice_cstr("text/plain; charset=utf-8")) !>;
    conn->hdr("Content-Length", cl) !>;
    conn->date_ka(ka) !>;
    conn->end_headers() !>;
    if (!with_body) return cc_ok(true);
    return conn->write(body_s);
}

static bool !>(CCError) send_file_hdrs(ConnEnc conn, int code, const char* reason,
                                       char[:] url_path, size_t body_len,
                                       time_t mtime, char[:] crange, int ka) {
    @errhandler(CCError e) { return cc_err(e); }
    cc_arena_stack(stamp_a, 256);
    char[:] date = http_date_now(stamp_a);
    char[:] lm = http_last_modified(mtime, stamp_a);
    const char* ct = content_type_for(url_path);
    const char* ka_s = ka ? "keep-alive" : "close";
    CCString block;
    if (crange.ptr && crange.len > 0)
        block = @string(`HTTP/1.1 ${code} ${reason}\r\nContent-Type: ${ct}\r\nContent-Length: ${body_len}\r\nLast-Modified: ${lm}\r\nAccept-Ranges: bytes\r\nContent-Range: ${crange}\r\nDate: ${date}\r\nConnection: ${ka_s}\r\n`, @scratch);
    else
        block = @string(`HTTP/1.1 ${code} ${reason}\r\nContent-Type: ${ct}\r\nContent-Length: ${body_len}\r\nLast-Modified: ${lm}\r\nAccept-Ranges: bytes\r\nDate: ${date}\r\nConnection: ${ka_s}\r\n`, @scratch);
    conn->write(block) !>;
    if (conn->extra.len) {
        CCString extra = @string(`${conn->extra}\r\n`, @scratch);
        conn->write(extra) !>;
    }
    return conn->end_headers();
}

static bool !>(CCError) send_options(ConnEnc conn, int ka) {
    @errhandler(CCError e) { return cc_err(e); }
    conn->status(204, "No Content") !>;
    conn->hdr("Allow", cc_slice_cstr("GET, HEAD, OPTIONS")) !>;
    conn->hdr("Accept-Ranges", cc_slice_cstr("bytes")) !>;
    conn->date_ka(ka) !>;
    return conn->end_headers();
}

static bool !>(CCError) send_not_modified(ConnEnc conn, time_t mtime, int ka) {
    @errhandler(CCError e) { return cc_err(e); }
    cc_arena_stack(stamp_a, 64);
    char[:] lm = http_last_modified(mtime, stamp_a);
    conn->status(304, "Not Modified") !>;
    conn->hdr("Last-Modified", lm) !>;
    conn->date_ka(ka) !>;
    return conn->end_headers();
}

static bool !>(CCError) send_416(ConnEnc conn, size_t total, int ka) {
    @errhandler(CCError e) { return cc_err(e); }
    CCString cr = @string(`bytes */${total}`, @scratch);
    conn->status(416, "Range Not Satisfiable") !>;
    conn->hdr("Content-Range", cr) !>;
    conn->hdr("Content-Length", cc_slice_cstr("0")) !>;
    conn->date_ka(ka) !>;
    return conn->end_headers();
}

static int take_line(char[:]* rest, char[:]* line) {
    if (!rest || rest->len == 0) return 0;
    char[:] s = *rest;
    @for (i, ch in s) {
        if (ch != '\n') continue;
        size_t n = i;
        if (n && s.ptr[n - 1] == '\r') n--;
        *line = s.sub(0, n);
        *rest = s.sub(i + 1, s.len);
        return 1;
    }
    return 0;
}

static size_t headers_end(Session* s) {
    size_t i;
    if (s->io.rlen < 4) return 0;
    for (i = 0; i + 3 < s->io.rlen; i++) {
        if (s->io.read_ptr[i] == '\r' && s->io.read_ptr[i + 1] == '\n'
                && s->io.read_ptr[i + 2] == '\r' && s->io.read_ptr[i + 3] == '\n')
            return i + 4;
    }
    return 0;
}

static bool !>(CCError) write_ws(Session* s, int opcode, char[:] body) {
    @errhandler(CCError e) { return cc_err(e); }
    unsigned char h[10];
    size_t hn;
    if (body.len > (size_t)WS_MAX_PAYLOAD)
        return cc_err(CC_ERROR(CC_ERR_IO, "ws too big"));
    hn = ws_hdr_unmasked(opcode, body.len, h);
    s->io.write_all(cc_slice_from_buffer((char*)h, hn)) !>;
    if (body.len)
        s->io.write_all(body) !>;
    return cc_ok(true);
}

static SessAct !>(CCError) http_fail(Session* s, Conn* conn, int code,
                                     const char* reason, const char* body,
                                     int with_body, int ka) {
    @errhandler(CCError e) { return cc_err(e); }
    send_error(conn, code, reason, body, with_body, ka) !>;
    flush_conn(s, conn) !>;
    if (!ka) return cc_ok((SessAct){ .close = {} });
    return cc_ok((SessAct){ .wait = {} });
}

static SessAct !>(CCError) http_commit(Session* s, Conn* conn, int ka) {
    @errhandler(CCError e) { return cc_err(e); }
    flush_conn(s, conn) !>;
    if (!ka) return cc_ok((SessAct){ .close = {} });
    return cc_ok((SessAct){ .wait = {} });
}

static const char* pages_reason(int code) {
    if (code == 200) return "OK";
    if (code == 201) return "Created";
    if (code == 204) return "No Content";
    if (code == 400) return "Bad Request";
    if (code == 404) return "Not Found";
    if (code == 500) return "Internal Server Error";
    if (code == 501) return "Not Implemented";
    return "OK";
}

static char[:] path_query_of(char[:] raw) {
    @for (i, ch in raw) {
        if (ch == '?')
            return raw.sub(i + 1, raw.len);
    }
    return cc_slice_empty();
}

static SessAct !>(CCError) pages_send(Session* s, Conn* conn, ScriptReply* r,
                                      int with_body, int ka) {
    @errhandler(CCError e) { return cc_err(e); }
    CCString cl = @string(`${r->body.len}`, @scratch);
    const char* reason = pages_reason(r->status);
    char[:] ct = cc_slice_cstr(r->content_type);
    conn->status(r->status, reason) !>;
    conn->hdr("Content-Type", ct) !>;
    conn->hdr("Content-Length", cl) !>;
    conn->date_ka(ka) !>;
    {
        int i;
        for (i = 0; i < r->nhdrs; i++)
            conn->hdr(r->hdrs[i].name, cc_slice_cstr(r->hdrs[i].value)) !>;
    }
    conn->end_headers() !>;
    {
        SessAct a = http_commit(s, conn, ka) !>;
        @switch (a) {
        case .close:
            return cc_ok(a);
        case .wait:
            break;
        }
    }
    if (with_body && r->body.len)
        s->io.write_all(r->body) !>;
    return cc_ok((SessAct){ .wait = {} });
}

/* One request. Sets s->phase = SESS_WS on upgrade.
 * Caller has a complete header block at the front of s->io.read_ptr. */
static SessAct !>(CCError) handle_http(Session* s, Conn* conn, ServerCfg* cfg) {
    @errhandler(CCError e) { return cc_err(e); }
    size_t hend = headers_end(s);
    char[:] block;
    char[:] rest;
    int parsed = 0, ka = 1, want_close = 0, is_head = 0, is_get = 0, is_options = 0;
    int want_upgrade = 0;
    char[:] url;
    char[:] empty = cc_slice_empty();
    char[:] ims = empty;
    char[:] range = empty;
    char[:] ifr = empty;
    char[:] ws_key = empty;
    char[:] first;
    Method meth;
    time_t mtime = 0, ims_t;
    size_t off = 0, nsend;
    int rkind;
    FileHold fh = { .slot = -1, .fd = -1 };
    size_t file_len;
    int root_fd = cfg->root_fd;
    @defer fh.drop();

    if (!hend) return cc_err(CC_ERROR(CC_ERR_IO, "no headers"));
    block = cc_slice_from_buffer(s->io.read_ptr, hend);
    rest = block;
    if (!take_line(&rest, &first))
        return cc_err(CC_ERROR(CC_ERR_IO, "bad request line"));

    ReqLine req;
    parsed = cc_parse(ReqLine, first.ptr, first.len, conn->arena, &req);
    CCString path_s = cc_string_new();
    char[:] query_s = empty;
    if (parsed) {
        meth = method_of(req.method);
        {
            char[:] raw = path_without_query(req.path);
            path_s = @string(`${raw}`, conn->arena);
            query_s = path_query_of(req.path);
        }
        if (path_s.failed()) {
            s->io.consume(hend);
            return http_fail(s, conn, 500, "Internal Server Error", "oom\n", 1, 0);
        }
        ka = !req.version.eq_cstr("HTTP/1.0");
        @switch (meth) {
        case .get:     is_get = 1; break;
        case .head:    is_head = 1; break;
        case .options: is_options = 1; break;
        case .other:   break;
        }
    }

    for (;;) {
        char[:] h;
        char[:] val;
        if (!take_line(&rest, &h)) break;
        if (h.len == 0) break;
        if (hdr_val(h, "connection", &val)) {
            int saw_close = 0, saw_ka = 0;
            connection_scan(val, &saw_close, &saw_ka);
            if (saw_close) want_close = 1;
            else if (saw_ka) ka = 1;
            if (connection_has(val, "upgrade")) want_upgrade = 1;
        } else if (hdr_val(h, "upgrade", &val)) {
            if (ci_eq(val, "websocket")) want_upgrade = 1;
        } else if (hdr_val(h, "sec-websocket-key", &val)) {
            CCString ks = @string(`${val}`, conn->arena);
            if (!ks.failed()) ws_key = ks;
        } else if (hdr_val(h, "if-modified-since", &val)) {
            CCString ks = @string(`${val}`, conn->arena);
            if (!ks.failed()) ims = ks;
        } else if (hdr_val(h, "range", &val)) {
            CCString ks = @string(`${val}`, conn->arena);
            if (!ks.failed()) range = ks;
        } else if (hdr_val(h, "if-range", &val)) {
            CCString ks = @string(`${val}`, conn->arena);
            if (!ks.failed()) ifr = ks;
        }
    }
    if (want_close) ka = 0;
    s->io.consume(hend);
    if (!parsed) {
        int head400 = first.starts_with("HEAD ");
        return http_fail(s, conn, 400, "Bad Request", "bad request\n", !head400, ka);
    }
    if (is_get && want_upgrade && ws_key.len) {
        char acc[29];
        char[:] accept;
        if (!ws_accept_b64(ws_key, acc))
            return http_fail(s, conn, 400, "Bad Request", "bad websocket key\n", 1, 0);
        accept = cc_slice_cstr(acc);
        conn->status(101, "Switching Protocols") !>;
        conn->hdr("Upgrade", cc_slice_cstr("websocket")) !>;
        conn->hdr("Connection", cc_slice_cstr("Upgrade")) !>;
        conn->hdr("Sec-WebSocket-Accept", accept) !>;
        conn->end_headers() !>;
        flush_conn(s, conn) !>;
        s->phase = SESS_WS;
        return cc_ok((SessAct){ .wait = {} });
    }
    if (!is_get && !is_head && !is_options)
        return http_fail(s, conn, 405, "Method Not Allowed",
                         "method not allowed\n", 1, ka);

    url = path_s;
    if (!path_is_safe(url))
        return http_fail(s, conn, 403, "Forbidden", "forbidden\n", !is_head, ka);
    if (url.len > (size_t)K_PATH_MAX)
        return http_fail(s, conn, 414, "URI Too Long", "uri too long\n",
                         !is_head, ka);

    if (is_options) {
        send_options(conn, ka) !>;
        return http_commit(s, conn, ka);
    }

    const char* rel = "";
    {
        const char* p = path_s.cstr(conn->arena) !>(e) {
            (void)e;
            return http_fail(s, conn, 500, "Internal Server Error", "oom\n",
                             !is_head, ka);
        };
        rel = (p[0] == '/') ? p + 1 : p;
    }

    /* Pages arm: MISS falls through to static. */
    if (cfg->pages_fd >= 0) {
        PagesKind kind = PAGES_MISS;
        ScriptReply reply = pages_serve(cfg->pages_fd, url, req.method, url,
                                        query_s, empty, conn->arena, &kind)
                !>(e) {
            int code = 500;
            const char* msg = "pages failed\n";
            if (kind == PAGES_NO_ENGINE) {
                code = 501;
                msg = "pages: engine not attached\n";
            } else if (kind == PAGES_BOTH) {
                msg = "pages: both .js and .py\n";
            } else if (e.message && e.message[0]) {
                msg = e.message;
            }
            return http_fail(s, conn, code,
                             code == 501 ? "Not Implemented"
                                         : "Internal Server Error",
                             msg, !is_head, ka);
        };
        if (kind == PAGES_JS || kind == PAGES_PY)
            return pages_send(s, conn, &reply, is_get, ka);
    }

    int got_file = try_file(root_fd, rel, &fh);
    if (!got_file) {
        int dfd = fs_dir_open(root_fd, rel);
        char idx[K_PATH_MAX];
        if (dfd < 0)
            return http_fail(s, conn, 404, "Not Found", "not found\n",
                             !is_head, ka);
        if (!join_index(idx, sizeof(idx), rel, cfg->index)) {
            close(dfd);
            return http_fail(s, conn, 414, "URI Too Long", "uri too long\n",
                             !is_head, ka);
        }
        if (try_file(root_fd, idx, &fh)) {
            CCString mu = @string(`/${idx}`, conn->arena);
            if (!mu.failed()) url = mu;
            close(dfd);
            got_file = 1;
        } else if (!cfg->list) {
            close(dfd);
            return http_fail(s, conn, 403, "Forbidden", "forbidden\n",
                             !is_head, ka);
        } else {
            struct stat dst;
            time_t dmtime = 0;
            if (fstat(dfd, &dst) == 0) dmtime = dst.st_mtime;
            cc_arena_stack(list_a, K_LIST_ARENA);
            CCString html = dir_listing(dfd, url, list_a) !>(e) {
                (void)e;
                return http_fail(s, conn, 500, "Internal Server Error",
                                 "listing\n", !is_head, ka);
            };
            if (ims.len && http_parse_date(ims, conn->arena, &ims_t)
                    && ims_t >= dmtime) {
                send_not_modified(conn, dmtime, ka) !>;
                return http_commit(s, conn, ka);
            }
            send_file_hdrs(conn, 200, "OK", cc_slice_cstr("/listing.html"),
                           (size_t)html.len, dmtime, empty, ka) !>;
            {
                SessAct a = http_commit(s, conn, ka) !>;
                @switch (a) {
                case .close: return cc_ok(a);
                case .wait: break;
                }
            }
            if (is_get && html.len > 0)
                s->io.write_all(html.as_slice()) !>;
            return cc_ok((SessAct){ .wait = {} });
        }
    }
    mtime = fh.mtime;
    file_len = fh.file_len;
    if (ims.len && http_parse_date(ims, conn->arena, &ims_t) && ims_t >= mtime) {
        send_not_modified(conn, mtime, ka) !>;
        return http_commit(s, conn, ka);
    }

    if (range.len && ifr.len) {
        time_t ifr_t;
        if (!(http_parse_date(ifr, conn->arena, &ifr_t) && ifr_t == mtime))
            range = empty;
    }

    nsend = file_len;
    rkind = range.len ? range_parse(range, file_len, conn->arena, &off, &nsend) : 0;
    if (rkind < 0) {
        send_416(conn, file_len, ka) !>;
        return http_commit(s, conn, ka);
    }
    if (rkind > 0) {
        size_t last = off + nsend - 1;
        CCString cr = @string(`bytes ${off}-${last}/${file_len}`, @scratch);
        if (cr.failed())
            return cc_err(CC_ERROR(CC_ERR_OUT_OF_MEMORY, "content-range"));
        send_file_hdrs(conn, 206, "Partial Content", url, nsend, mtime,
                       cr.as_slice(), ka) !>;
    } else {
        send_file_hdrs(conn, 200, "OK", url, nsend, mtime, empty, ka) !>;
    }
    flush_conn(s, conn) !>;
    if (is_get && nsend > 0) {
        session_queue_send(s, &fh, off, nsend);
        if (!ka) s->send_close = 1;
        return cc_ok((SessAct){ .wait = {} });
    }
    if (!ka) return cc_ok((SessAct){ .close = {} });
    return cc_ok((SessAct){ .wait = {} });
}

/* 1 = consumed a frame, 0 = need more, -1 = close. */
static int ws_one_frame(Session* s) {
    unsigned char b0, b1, maskk[4];
    int opcode, masked;
    size_t n = 0, need = 2, hdr = 2;
    char* payload;
    if (s->io.rlen < 2) return 0;
    b0 = (unsigned char)s->io.read_ptr[0];
    b1 = (unsigned char)s->io.read_ptr[1];
    if ((b0 & 0x80) == 0) return -1;
    opcode = (int)(b0 & 0x0f);
    masked = (b1 & 0x80) != 0;
    n = (size_t)(b1 & 0x7f);
    if (n == 126) {
        if (s->io.rlen < 4) return 0;
        n = ((size_t)(unsigned char)s->io.read_ptr[2] << 8)
          | (size_t)(unsigned char)s->io.read_ptr[3];
        hdr = 4;
    } else if (n == 127) {
        int z;
        if (s->io.rlen < 10) return 0;
        for (z = 2; z < 8; z++)
            if (s->io.read_ptr[z]) return -1;
        n = ((size_t)(unsigned char)s->io.read_ptr[8] << 8)
          | (size_t)(unsigned char)s->io.read_ptr[9];
        hdr = 10;
    }
    if (!masked || n > (size_t)WS_MAX_PAYLOAD) return -1;
    need = hdr + 4 + n;
    if (s->io.rlen < need) return 0;
    {
        char[:] mk = cc_slice_from_buffer((char*)maskk, 4);
        mk.copy(cc_slice_from_buffer(s->io.read_ptr + hdr, 4)) !>(e) {
            (void)e;
            return -1;
        };
    }
    payload = s->io.read_ptr + hdr + 4;
    if (n) ws_unmask(payload, n, maskk);
    if (opcode == 8) {
        write_ws(s, 8, cc_slice_from_buffer(payload, n)) !>(e) { (void)e; };
        s->io.consume(need);
        return -1;
    }
    if (opcode == 9) {
        write_ws(s, 10, cc_slice_from_buffer(payload, n)) !>(e) { (void)e; };
        s->io.consume(need);
        return 1;
    }
    if (opcode == 10) {
        s->io.consume(need);
        return 1;
    }
    if (opcode == 1 || opcode == 2) {
        write_ws(s, opcode, cc_slice_from_buffer(payload, n)) !>(e) {
            (void)e;
            s->io.consume(need);
            return -1;
        };
        s->io.consume(need);
        return 1;
    }
    s->io.consume(need);
    return -1;
}

static void worker_run(ServerCfg* cfg, CCListener* ln);

/* One accept per poll, so live grows in the open. Spawn when
 * live >= (n+1) * WORKER_GROW_EVERY and n < cap. CAS owns the slot. */
static void maybe_grow(void) {
    int n = cc_atomic_load_acquire(&g_nworkers);
    int live = cc_atomic_load_acquire(&g_live);
    int next;
    if (n < 1 || n >= g_workers_max) return;
    if (live < (n + 1) * WORKER_GROW_EVERY) return;
    next = n + 1;
    if (!cc_atomic_cas(&g_nworkers, &n, next)) return;
    {
        CCListener* lnp = g_ln;
        ServerCfg* cfg = g_cfg;
        @parallel(g_app) {
            worker_run(cfg, lnp);
        }
    }
}

/* Fill, one send chunk, or HTTP/WS until the row needs another wait. */
static SessAct !>(CCError) session_step(Session* s, Conn* conn, ServerCfg* cfg,
                                        PollFd* p) {
    @errhandler(CCError e) { return cc_err(e); }
    short rv = p ? p->revents : 0;
    if (rv & (POLLERR | POLLHUP | POLLNVAL))
        return cc_ok((SessAct){ .close = {} });

    if (s->send_left) {
        if (rv & POLLIN) {
            int got = s->io.fill() !>;
            if (got < 0) return cc_ok((SessAct){ .close = {} });
        }
        if (rv & POLLOUT) {
            SessAct a = session_send_one(s) !>;
            @switch (a) {
            case .close: return cc_ok(a);
            case .wait: break;
            }
        }
        s->arm(p);
        if (s->send_left) return cc_ok((SessAct){ .wait = {} });
        if (s->send_close) return cc_ok((SessAct){ .close = {} });
    } else if (!(rv & POLLIN)) {
        return cc_ok((SessAct){ .wait = {} });
    } else {
        int got = s->io.fill() !>;
        if (got < 0) return cc_ok((SessAct){ .close = {} });
        if (got == 0) return cc_ok((SessAct){ .wait = {} });
    }

    for (;;) {
        if (s->phase == SESS_WS) {
            int r = ws_one_frame(s);
            if (r < 0) return cc_ok((SessAct){ .close = {} });
            if (r == 0) {
                s->arm(p);
                return cc_ok((SessAct){ .wait = {} });
            }
            continue;
        }
        if (!headers_end(s)) {
            if (s->io.rlen == s->io.rcap)
                return http_fail(s, conn, 400, "Bad Request",
                                 "headers too big\n", 1, 0);
            s->arm(p);
            return cc_ok((SessAct){ .wait = {} });
        }
        {
            SessAct a = handle_http(s, conn, cfg) !>;
            @switch (a) {
            case .close: return cc_ok(a);
            case .wait: break;
            }
        }
        if (s->phase == SESS_HTTP) {
            conn->arena.reset();
            conn->out = cc_string_new();
        }
        if (s->send_left) {
            SessAct a = session_send_one(s) !>;
            s->arm(p);
            @switch (a) {
            case .close: return cc_ok(a);
            case .wait: break;
            }
            if (s->send_left) return cc_ok((SessAct){ .wait = {} });
            if (s->send_close) return cc_ok((SessAct){ .close = {} });
        }
    }
}

static void step_row(Session* s, Conn* conn, ServerCfg* cfg, PollFd* p) {
    SessAct a = session_step(s, conn, cfg, p) !>(e) {
        (void)e;
        s->io.dead = 1;
        return;
    };
    session_apply(s, a);
}

/* Named steps: poll → step rows → accept → reap. */
static void worker_run(ServerCfg* cfg, CCListener* ln) {
    cc_arena_stack(wa, kilobytes(8));
    cc_arena_stack(enc, K_OUT_BUF);
    Conn conn = { .arena = enc, .out = cc_string_new(), .extra = cfg->extra };
    CCArenaPool* slots;
    if (!cc_arena_is_live(wa) || !cc_arena_is_live(enc)) return;
    slots = wa.create_pool(sizeof(Session)) !>(e) {
        (void)e;
        return;
    };
    Vec::[SessionP] live@(wa) @destroy;
    Vec::[PollFd] wait@(wa) @destroy;
    @defer {
        @for (s in live) {
            session_drop(s, slots);
            cc_atomic_fetch_sub(&g_live, 1);
        }
    };
    (void)io_fd_nonblock(ln->fd);
    {
        PollFd p = { .fd = ln->fd, .events = POLLIN, .revents = 0 };
        if (wait.push(p) != 0) return;
    }

    int listening = 1;
    while (!cc_atomic_load_acquire(&g_stop) || live.len() > 0) {
        PollFd* raw;
        size_t base;
        int pr, died;
        int stop = cc_atomic_load_acquire(&g_stop);
        if (stop && listening) {
            size_t n = wait.len();
            @for (i, src in wait) {
                if (i == 0) continue;
                if (wait.set(i - 1, src) != 0) return;
            }
            wait.truncate(n ? n - 1 : 0);
            listening = 0;
        }

        /* poll */
        raw = wait.data();
        if (wait.len() && !raw) return;
        pr = poll(raw, (nfds_t)wait.len(), listening ? POLL_MS : 0);
        if (pr < 0) {
            if (errno == EINTR) continue;
            return;
        }
        if (pr == 0) {
            cc_yield();
            continue;
        }

        /* step ready rows */
        base = listening ? 1 : 0;
        died = 0;
        @for (i, s in live) {
            PollFd* p = wait.get(base + i);
            if (!p) return;
            step_row(s, &conn, cfg, p);
            if (s->io.dead) died = 1;
        }

        /* accept */
        if (listening) {
            PollFd* lp = wait.get(0);
            if (lp && (lp->revents & POLLIN)) {
                int ar = try_accept(ln, cfg, &live, &wait, slots);
                if (ar < 0) return;
                if (ar > 0) maybe_grow();
            }
        }

        /* reap */
        if (!died) continue;
        session_reap(&live, &wait, base, slots);
    }
}

static const char* extra_header_arg(const char* a, int i, int argc, char** argv) {
    char[:] s = cc_slice_cstr(a);
    if (s.eq_cstr("--header") && i + 1 < argc) return argv[i + 1];
    if (s.starts_with("--header=")) return a + 9;
    return NULL;
}

static int index_name_ok(char[:] idx) {
    if (!idx.len || idx.eq_cstr(".") || idx.eq_cstr("..")) return 0;
    @for (ch in idx) {
        if (ch == '/' || ch == '\\' || ch == '?') return 0;
    }
    return 1;
}

static int header_line_ok(char[:] v) {
    int colon = 0;
    if (!v.len) return 0;
    @for (ch in v) {
        if (ch == '\r' || ch == '\n') return 0;
        if (ch == ':') colon = 1;
    }
    return colon;
}

/* Banner + workers + signal. Caller owns cfg / ln / open fds. */
static void !>(CCError) serve(ServerCfg* cfg, CCListener* ln,
                              char[:] listen, const char* root_c,
                              int nworkers) {
    @errhandler(CCError e) { return cc_err(e); }
    int start = nworkers < 2 ? nworkers : 2;
    if (cfg->pages_fd >= 0 && cfg->tls)
        println(@string(`staticd on ${listen} root=${root_c} pages=on tls=on workers=${start}..${nworkers}`, @scratch));
    else if (cfg->pages_fd >= 0)
        println(@string(`staticd on ${listen} root=${root_c} pages=on workers=${start}..${nworkers}`, @scratch));
    else if (cfg->tls)
        println(@string(`staticd on ${listen} root=${root_c} tls=on workers=${start}..${nworkers}`, @scratch));
    else
        println(@string(`staticd on ${listen} root=${root_c} workers=${start}..${nworkers}`, @scratch));

    CCSignal stop = cc_signal_watch2(SIGINT, SIGTERM) !> @destroy;
    CCListener* lnp = ln;
    ServerCfg* cfgp = cfg;
    CCSignal* stopp = &stop;
    g_ln = lnp;
    g_cfg = cfgp;
    g_workers_max = nworkers;
    cc_atomic_store_release(&g_nworkers, start);
    cc_atomic_store_release(&g_tls_fail, 0);

    g_app = @parallel spawn { @serial { (void)0; } } !>;
    @parallel(g_app) {
        int sig = 0;
        sig = stopp->wait() !>(e) { (void)e; };
        if (sig) cc_atomic_store_release(&g_stop, 1);
    }
    for (int w = 0; w < start; w++) {
        @parallel(g_app) {
            worker_run(cfgp, lnp);
        }
    }
    g_app.wait() !>;
    {
        int nfail = cc_atomic_load_acquire(&g_tls_fail);
        if (cfg->tls && nfail > 0)
            eprintln(@string(`staticd: tls handshake failures: ${nfail}`, @scratch));
    }
    return cc_ok();
}

int main(int argc, char** argv) {
    cc_arena_pool_stack(send_pool, FILE_SEND_CHUNK, megabytes(1));
    g_send_pool = &send_pool;

    @errhandler(CCError err) {
        cc_error_log(err);
        return 1;
    }

    cc_arena_stack(cli_a, kilobytes(4));
    staticd_sync_init(cli_a.create_exclusive(4) !>);
    StaticdOpts opts = {0};
    bool go = cc_prepare_args(StaticdOpts, argc, argv, cli_a, &opts, stderr) !>;
    if (!go) return 0;

    char[:0] listen = opts.listen;
    int nworkers = (int)opts.workers;
    if (nworkers <= 0) {
        long n = sysconf(_SC_NPROCESSORS_ONLN);
        nworkers = (n > 1) ? (int)(n / 2) : 1;
    }
    if (nworkers > WORKERS_MAX) nworkers = WORKERS_MAX;

    ServerCfg cfg = {
        .root_fd = -1,
        .pages_fd = -1,
        .list = 0,
        .tls = 0,
        .index = "index.html",
        .extra = cc_slice_empty(),
    };

    char[:] root_view = opts.root;
    if (root_view.len == 0) {
        eprintln("staticd: empty docroot");
        return 1;
    }
    while (root_view.len > 1 && root_view.ptr[root_view.len - 1] == '/')
        root_view = root_view.sub(0, root_view.len - 1);
    CCString root_owned = @string(`${root_view}`, cli_a);
    if (root_owned.failed()) {
        eprintln("staticd: docroot oom");
        return 1;
    }
    const char* root_c = root_owned.cstr(cli_a) !> {
        eprintln("staticd: docroot nul");
        return 1;
    };
    cfg.root_fd = open(root_c, O_RDONLY | O_DIRECTORY | O_CLOEXEC);
    if (cfg.root_fd < 0) {
        eprintln(@string(`staticd: docroot open: ${root_c}`, @scratch));
        return 1;
    }
    @defer close(cfg.root_fd);

    {
        char[:] pages_view = opts.pages;
        if (pages_view.len > 0) {
            while (pages_view.len > 1
                    && pages_view.ptr[pages_view.len - 1] == '/')
                pages_view = pages_view.sub(0, pages_view.len - 1);
            CCString pages_owned = @string(`${pages_view}`, cli_a);
            if (pages_owned.failed()) {
                eprintln("staticd: pages oom");
                return 1;
            }
            const char* pages_c = pages_owned.cstr(cli_a) !> {
                eprintln("staticd: pages nul");
                return 1;
            };
            int pfd = open(pages_c, O_RDONLY | O_DIRECTORY | O_CLOEXEC);
            if (pfd < 0) {
                eprintln(@string(`staticd: pages open: ${pages_c}`, @scratch));
                return 1;
            }
            cfg.pages_fd = pfd;
            if (pages_engines_open() != 0) {
                eprintln("staticd: pages engines open failed");
                return 1;
            }
        }
    }
    @defer {
        pages_engines_close();
        if (cfg.pages_fd >= 0) close(cfg.pages_fd);
        if (cfg.tls) cc_tls_server_unload();
    };

    {
        char[:] cert_v = opts.tls_cert;
        char[:] key_v = opts.tls_key;
        int have_c = cert_v.len > 0;
        int have_k = key_v.len > 0;
        if (have_c != have_k) {
            eprintln("staticd: --tls-cert and --tls-key are required together");
            return 1;
        }
        if (have_c) {
            CCString cert_owned = @string(`${cert_v}`, cli_a);
            CCString key_owned = @string(`${key_v}`, cli_a);
            if (cert_owned.failed() || key_owned.failed()) {
                eprintln("staticd: tls path oom");
                return 1;
            }
            const char* cert_c = cert_owned.cstr(cli_a) !> {
                eprintln("staticd: tls cert nul");
                return 1;
            };
            const char* key_c = key_owned.cstr(cli_a) !> {
                eprintln("staticd: tls key nul");
                return 1;
            };
            if (cc_tls_server_load(cert_c, key_c) != 0) {
                eprintln("staticd: tls load failed (bad PEM cert/key?)");
                return 1;
            }
            cfg.tls = 1;
        }
    }

    CCListener ln = cc_tcp_listen(listen) !>(err) {
        eprintln(@string(`listen: ${err}`, @scratch));
        return 1;
    };
    @defer ln.close();

    cfg.list = opts.list ? 1 : 0;
    {
        char[:] idx = opts.index;
        if (idx.len == 0)
            cfg.index = "index.html";
        else if (!index_name_ok(idx)) {
            eprintln("staticd: bad --index");
            return 1;
        } else
            cfg.index = (const char*)idx.ptr;
    }
    CCString extra = cc_string_new();
    {
        int n = 0;
        @for (i in 1..argc) {
            const char* v = extra_header_arg(argv[i], (int)i, argc, argv);
            if (!v) continue;
            if (!header_line_ok(cc_slice_cstr(v))) {
                eprintln("staticd: bad --header (want Name: value, no CR/LF)");
                return 1;
            }
            if (n) extra.append("\r\n", cli_a);
            extra.append(v, cli_a);
            n++;
        }
        if (extra.failed()) {
            eprintln("staticd: --header oom");
            return 1;
        }
        cfg.extra = extra.as_slice();
    }

    serve(&cfg, &ln, listen, root_c, nworkers) !>;
    return 0;
}

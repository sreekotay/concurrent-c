/*
 * staticd — Concurrent-C static HTTP/1.1 file server (specimen).
 *
 * Lifetimes:
 *   Conn.arena / Conn.out → response header coalesce (cc_arena_stack);
 *                           flush then reset between requests
 *   ConnEnc (= @typeview Encode) → encode-only (no sock/flush)
 *   File body               → 64KB named-block ring (dev+ino+block), reuse
 *                           in place; fstat ≤1s; idle cull. Else pool
 *                           pread. Accept dest-attaches onto g_clients.
 *                           Chunk writes dest-attach onto a send dest
 *                           the frame waits (the turnstile is stack).
 *   Request parse           → BufReader + @grammar(schema) ReqLine;
 *                           method/path copied onto Conn.arena before
 *                           header drain (fill() memmoves the read buf)
 *   root / listen           → char[:0] from @grammar(cli)
 *
 * Shape on the page:
 *   ReqLine — SERDES (recognize; no path rewrite)
 *   staticd_http.cch    — date / Range / header-CI mechanics
 *   staticd_block.cch   — block ring keyed by dev+ino (reuse; idle cull)
 *   staticd_fs.cch      — jail, 1s fd cache, FileHold, listing
 *   mime_ext static_map     — ext → MimeTag (POD) → k_mime[]
 *   @variant Method         — GET HEAD OPTIONS
 *   docroot fd              — openat + O_NOFOLLOW (no chroot, no sendfile)
 *
 * Usage:  ./out/staticd [--listen ADDR] [--root DIR] [--index NAME]
 *                       [--list] [--header 'Name: value']
 * v1: GET/HEAD/OPTIONS, keep-alive, Date/Last-Modified/IMS, one Range,
 *     pread + 64KB write; send dest + turnstile when n>1.
 *     `?query` ignored. `--list` off. `--index` default index.html.
 */

#include <ccc/std/prelude.cch>
#include <ccc/cc_instantiate.cch>
#include <ccc/std/net.cch>
#include <ccc/std/cli.cch>
#include <ccc/std/static_map.cch>
#include <ccc/stdio.cch>
#include "staticd_http.cch"
#include "staticd_block.cch"
#include "staticd_fs.cch"
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <signal.h>
#include <time.h>
#include <fcntl.h>
#include <sys/stat.h>
#include <unistd.h>
#include <errno.h>

#define K_READ_BUF   (16 * 1024)
#define K_OUT_BUF    (8 * 1024)
#define K_PATH_MAX   4096
#define K_LIST_ARENA (32 * 1024)

static int g_list;
static const char* g_index = "index.html";
static CCSlice g_extra;
static CCParallel g_clients;
#define SEND_PIPE_CAP 2

/* --- CLI ----------------------------------------------------------------- */
@grammar(cli) StaticdOpts {~~~~
    help: flag -h, --help desc "Show help"
    listen: opt string -l, --listen as ADDR default "127.0.0.1:8080" desc "Listen address host:port"
    root: opt string -r, --root as DIR default "fixtures" desc "Document root"
    list: flag --list desc "Directory listing when no index file"
    index: opt string --index as NAME default "index.html" desc "Directory index file"
    header: opt string --header as LINE desc "Extra response header Name: value (repeatable)"
~~~~}

/* --- Request line (SERDES) ----------------------------------------------- */
@grammar(schema) ReqLine {~~~~
    rules [
        mtok: keep [some charset [#'A' - #'Z']]
        pchar: complement charset [#' ' #'#' #'\r' #'\n']
        pth: keep [#'/' any pchar]
        vtok: keep ["HTTP/1.0" | "HTTP/1.1"]
    ]
    method: mtok #' ' path: pth #' ' version: vtok
~~~~}

/* --- Method / MIME as data ----------------------------------------------- */
@variant Method {
    get: void;
    head: void;
    options: void;
    other: void;
};

typedef enum MimeTag {
    MIME_OCTET = 0,
    MIME_HTML,
    MIME_CSS,
    MIME_JS,
    MIME_JSON,
    MIME_PNG,
    MIME_JPEG,
    MIME_GIF,
    MIME_SVG,
    MIME_TXT,
} MimeTag;

typedef struct MimeSpec {
    MimeTag kind;
} MimeSpec;

typedef struct MimeEntry {
    const char* key;
    MimeSpec value;
} MimeEntry;

@comptime {
    MimeEntry mime_entries[] = {
        { ".html", { MIME_HTML } },
        { ".htm",  { MIME_HTML } },
        { ".css",  { MIME_CSS } },
        { ".js",   { MIME_JS } },
        { ".json", { MIME_JSON } },
        { ".png",  { MIME_PNG } },
        { ".jpg",  { MIME_JPEG } },
        { ".jpeg", { MIME_JPEG } },
        { ".gif",  { MIME_GIF } },
        { ".svg",  { MIME_SVG } },
        { ".txt",  { MIME_TXT } },
        { ".bin",  { MIME_OCTET } },
    };
    static_map("mime_ext", mime_entries, CC_STATIC_MAP_ASCII_CI);
}

static const char* k_mime[] = {
    [MIME_OCTET] = "application/octet-stream",
    [MIME_HTML]  = "text/html; charset=utf-8",
    [MIME_CSS]   = "text/css; charset=utf-8",
    [MIME_JS]    = "application/javascript; charset=utf-8",
    [MIME_JSON]  = "application/json",
    [MIME_PNG]   = "image/png",
    [MIME_JPEG]  = "image/jpeg",
    [MIME_GIF]   = "image/gif",
    [MIME_SVG]   = "image/svg+xml",
    [MIME_TXT]   = "text/plain; charset=utf-8",
};

typedef struct Conn {
    CCSocket* sock;
    CCArena arena;
    CCString out;
} Conn;

typedef @typeview Encode on Conn {
    r: write, lit, status, hdr, end_headers, date_ka;
} *ConnEnc;

static bool !>(CCIoError) write_all(CCSocket* sock, char[:] data) {
    size_t off = 0;
    while (off < data.len) {
        size_t n = sock->write(data.ptr + off, data.len - off) !>(e) {
            return cc_err(e);
        };
        if (n == 0)
            return cc_err(cc_io_error(CC_ERROR(CC_ERR_CLOSED, "short write")));
        off += n;
        cc_yield();
    }
    return cc_ok(true);
}

static void !>(CCError) send_write_slice(CCSocket* sock, char[:] s) {
    write_all(sock, s) !>(e) {
        return cc_err(CC_ERROR(CC_ERR_IO, cc_io_error_str(e)));
    };
    return cc_ok();
}

/* leave before pass so the caller's wait(n) is the join. */
static void send_one_chunk(CCTurnstile* ts, CCSocket* sock, int fd,
                           uint64_t dev, uint64_t ino, time_t mtime,
                           size_t file_off, size_t want, int i) {
    @errhandler(CCError e) {
        (void)e;
        ts->leave() !>(e2) { (void)e2; };
        ts->fail(0, i) !>(e2) { (void)e2; };
        return;
    }
    BlockHold bh = checkout_block(fd, dev, ino, mtime, file_off, want) !>;
    @defer bh.drop();
    ts->wait(0, i) !>;
    send_write_slice(sock, cc_slice_from_buffer(bh.ptr, want)) !>;
    ts->leave() !>;
    ts->pass(0, i) !>(e) {
        (void)e;
        ts->fail(0, i) !>(e2) { (void)e2; };
        return;
    };
}

static void !>(CCError) send_file_chunks(CCSocket* sock, FileHold* fh,
                                        size_t off, size_t nsend) {
    @errhandler(CCError e) { return cc_err(e); }
    int n = (int)((nsend + (size_t)FILE_SEND_CHUNK - 1) / (size_t)FILE_SEND_CHUNK);
    cc_arena_stack(ts_a, kilobytes(64));
    CCTurnstile ts@(SEND_PIPE_CAP, 1, ts_a) !> @destroy;
    /* Frame dest: dest-attach onto g_clients would outlive ts_a. */
    CCParallel pipe = @parallel spawn { @serial { (void)0; } } !>;
    @defer pipe.wait() !>(e) { (void)e; };
    @defer(err) {
        int j;
        @for (j in 0..n) {
            ts.fail(0, j) !>(e2) { (void)e2; };
        }
    }
    int i;
    for (i = 0; i < n; i++) {
        size_t chunk_off = (size_t)i * (size_t)FILE_SEND_CHUNK;
        size_t want = nsend - chunk_off;
        if (want > (size_t)FILE_SEND_CHUNK) want = (size_t)FILE_SEND_CHUNK;
        int ticket = i;
        ts.enter(ticket) !>;
        @parallel(pipe) {
            send_one_chunk(&ts, sock, fh->fd, fh->dev, fh->ino, fh->mtime,
                           off + chunk_off, want, ticket);
        }
    }
    ts.wait(0, n) !>;
    return cc_ok();
}

static bool !>(CCIoError) send_file_body(CCSocket* sock, FileHold* fh,
                                        size_t off, size_t nsend) {
    BlockHold bh;
    if (nsend == 0) return cc_ok(true);
    if (fh->fd < 0 || off + nsend > fh->file_len)
        return cc_err(cc_io_from_errno(EIO));
    if (nsend <= (size_t)FILE_SEND_CHUNK) {
        bh = checkout_block(fh->fd, fh->dev, fh->ino, fh->mtime, off, nsend) !>(e) {
            return cc_err(cc_io_error(e));
        };
        @defer bh.drop();
        return write_all(sock, cc_slice_from_buffer(bh.ptr, nsend));
    }
    send_file_chunks(sock, fh, off, nsend) !>(e) {
        return cc_err(cc_io_error(e));
    };
    return cc_ok(true);
}

static bool !>(CCIoError) conn_flush(Conn* c) {
    char[:] data = c->out;
    if (data.len == 0) return cc_ok(true);
    @defer c->arena.reset();
    @defer c->out.release(c->arena);
    write_all(c->sock, data) !>(e) { return cc_err(e); };
    return cc_ok(true);
}

static bool !>(CCError) conn_write(Conn* c, char[:] data) {
    if (data.len == 0) return cc_ok(true);
    if (!c->out.append(data, c->arena) || c->out.failed())
        return cc_err(CC_ERR_OUT_OF_MEMORY, "conn encode oom");
    return cc_ok(true);
}

static bool !>(CCError) conn_lit(Conn* c, char[:] s) {
    return c->write(s);
}

static bool !>(CCError) conn_status(Conn* c, int code, const char* reason) {
    CCString line = @string(`HTTP/1.1 ${code} ${reason}\r\n`, @scratch);
    return c->write(line);
}

static bool !>(CCError) conn_hdr(Conn* c, const char* name, char[:] value) {
    CCString line = @string(`${name}: ${value}\r\n`, @scratch);
    return c->write(line);
}

static bool !>(CCError) conn_end_headers(Conn* c) {
    return c->lit("\r\n");
}

static Method method_of(char[:] name) {
    @switch (name) {
    case "GET":
        return (Method){ .get = {} };
    case "HEAD":
        return (Method){ .head = {} };
    case "OPTIONS":
        return (Method){ .options = {} };
    default:
        return (Method){ .other = {} };
    }
}

static const MimeSpec mime_octet_spec = { MIME_OCTET };

static const char* content_type_for(char[:] path) {
    char[:] ext = path_ext(path);
    const MimeSpec* spec = mime_ext_get(ext) ?> &mime_octet_spec;
    return k_mime[spec->kind];
}

static bool !>(CCError) conn_date_ka(Conn* c, int ka) {
    cc_arena_stack(stamp_a, 64);
    char[:] date = http_date_now(stamp_a);
    c->hdr("Date", date) !>;
    c->hdr("Connection", ka ? cc_slice_cstr("keep-alive")
                            : cc_slice_cstr("close")) !>;
    if (g_extra.len) {
        CCString extra = @string(`${g_extra}\r\n`, @scratch);
        c->write(extra) !>;
    }
    return cc_ok(true);
}

static bool !>(CCError) send_error(ConnEnc conn, int code, const char* reason,
                                   const char* body, int with_body, int ka) {
    @errhandler(CCError e) { return cc_err(e); }
    size_t blen = strlen(body);
    CCString cl = @string(`${blen}`, @scratch);
    conn->status(code, reason) !>;
    if (code == 405)
        conn->hdr("Allow", cc_slice_cstr("GET, HEAD, OPTIONS")) !>;
    conn->hdr("Content-Type", cc_slice_cstr("text/plain; charset=utf-8")) !>;
    conn->hdr("Content-Length", cl) !>;
    conn->date_ka(ka) !>;
    conn->end_headers() !>;
    if (!with_body) return cc_ok(true);
    return conn->write(body);
}

static bool !>(CCError) send_file_hdrs(ConnEnc conn, int code, const char* reason,
                                       char[:] url_path, size_t body_len,
                                       time_t mtime, char[:] crange, int ka) {
    @errhandler(CCError e) { return cc_err(e); }
    cc_arena_stack(stamp_a, 64);
    char[:] date = http_date_now(stamp_a);
    char[:] lm = http_last_modified(mtime, stamp_a);
    const char* ct = content_type_for(url_path);
    const char* ka_s = ka ? "keep-alive" : "close";
    CCString block;
    if (crange.ptr && crange.len > 0)
        block = @string(`HTTP/1.1 ${code} ${reason}\r\nContent-Type: ${ct}\r\nContent-Length: ${body_len}\r\nLast-Modified: ${lm}\r\nAccept-Ranges: bytes\r\nContent-Range: ${crange}\r\nDate: ${date}\r\nConnection: ${ka_s}\r\n`, @scratch);
    else
        block = @string(`HTTP/1.1 ${code} ${reason}\r\nContent-Type: ${ct}\r\nContent-Length: ${body_len}\r\nLast-Modified: ${lm}\r\nAccept-Ranges: bytes\r\nDate: ${date}\r\nConnection: ${ka_s}\r\n`, @scratch);
    conn->write(block) !>;
    if (g_extra.len) {
        CCString extra = @string(`${g_extra}\r\n`, @scratch);
        conn->write(extra) !>;
    }
    return conn->end_headers();
}

static bool !>(CCError) send_options(ConnEnc conn, int ka) {
    @errhandler(CCError e) { return cc_err(e); }
    conn->status(204, "No Content") !>;
    conn->hdr("Allow", cc_slice_cstr("GET, HEAD, OPTIONS")) !>;
    conn->hdr("Accept-Ranges", cc_slice_cstr("bytes")) !>;
    conn->date_ka(ka) !>;
    return conn->end_headers();
}

static bool !>(CCError) send_not_modified(ConnEnc conn, time_t mtime, int ka) {
    @errhandler(CCError e) { return cc_err(e); }
    cc_arena_stack(stamp_a, 64);
    char[:] lm = http_last_modified(mtime, stamp_a);
    conn->status(304, "Not Modified") !>;
    conn->hdr("Last-Modified", lm) !>;
    conn->date_ka(ka) !>;
    return conn->end_headers();
}

static bool !>(CCError) send_416(ConnEnc conn, size_t total, int ka) {
    @errhandler(CCError e) { return cc_err(e); }
    CCString cr = @string(`bytes */${total}`, @scratch);
    conn->status(416, "Range Not Satisfiable") !>;
    conn->hdr("Content-Range", cr) !>;
    conn->hdr("Content-Length", cc_slice_cstr("0")) !>;
    conn->date_ka(ka) !>;
    return conn->end_headers();
}

/* Returns 1 = keep-alive, 0 = close, -1 = hard error. */
static int handle_one(BufReader::[CCSocket]* br, Conn* conn, int root_fd) {
    @defer flush: conn_flush(conn) !> { };
    int parsed = 0, ka = 1, is_head = 0, is_get = 0, is_options = 0;
    char[:] url;
    char[:] empty = cc_slice_empty();
    char[:] ims = empty;
    char[:] range = empty;
    char[:] ifr = empty;
    Method meth;
    time_t mtime = 0, ims_t;
    size_t off = 0, nsend;
    int rkind;
    FileHold fh = { .slot = -1, .fd = -1 };
    size_t file_len;
    char cr_buf[64];
    char[:] crange = empty;
    @defer fh.drop();

    char[:] line = br->read_line() !>(e) {
        if (e.base.kind == CC_ERR_CLOSED) {
            @cancel_defer flush;
            return 0;
        }
        return -1;
    };
    if (line.len == 0) {
        @cancel_defer flush;
        return 0;
    }

    ReqLine req;
    parsed = cc_parse(ReqLine, line.ptr, line.len, conn->arena, &req);
    CCString path_s = cc_string_new();
    if (parsed) {
        /* method/version still borrow the read line; only path survives drain.
         * `?query` is recognized then dropped (darkhttpd). */
        meth = method_of(req.method);
        {
            char[:] raw = path_without_query(req.path);
            path_s = @string(`${raw}`, conn->arena);
        }
        if (path_s.failed()) {
            send_error(conn, 500, "Internal Server Error", "oom\n", 1, 0) !> {
                @cancel_defer flush;
                return -1;
            };
            return 0;
        }
        ka = !(req.version.len == 8 && memcmp(req.version.ptr, "HTTP/1.0", 8) == 0);
        @switch (meth) {
        case .get:     is_get = 1; break;
        case .head:    is_head = 1; break;
        case .options: is_options = 1; break;
        case .other:   break;
        }
    }

    for (;;) {
        char[:] h = br->read_line() !>(e) {
            if (e.base.kind == CC_ERR_CLOSED) {
                @cancel_defer flush;
                return 0;
            }
            return -1;
        };
        char[:] val;
        if (h.len == 0) break;
        if (hdr_val(h, "connection", &val)) {
            if (ci_eq(val, "close")) ka = 0;
            else if (ci_eq(val, "keep-alive")) ka = 1;
        } else if (hdr_val(h, "if-modified-since", &val)) {
            CCString s = @string(`${val}`, conn->arena);
            if (!s.failed()) ims = s;
        } else if (hdr_val(h, "range", &val)) {
            CCString s = @string(`${val}`, conn->arena);
            if (!s.failed()) range = s;
        } else if (hdr_val(h, "if-range", &val)) {
            CCString s = @string(`${val}`, conn->arena);
            if (!s.failed()) ifr = s;
        }
    }

    if (!parsed) {
        int head400 = line.len >= 5 && memcmp(line.ptr, "HEAD ", 5) == 0;
        send_error(conn, 400, "Bad Request", "bad request\n", !head400, ka) !> {
            @cancel_defer flush;
            return -1;
        };
        return ka;
    }
    if (!is_get && !is_head && !is_options) {
        send_error(conn, 405, "Method Not Allowed", "method not allowed\n", 1, ka) !> {
            @cancel_defer flush;
            return -1;
        };
        return ka;
    }

    url = path_s;
    if (!path_is_safe(url)) {
        send_error(conn, 403, "Forbidden", "forbidden\n", !is_head, ka) !> {
            @cancel_defer flush;
            return -1;
        };
        return ka;
    }
    if (url.len > (size_t)K_PATH_MAX) {
        send_error(conn, 414, "URI Too Long", "uri too long\n", !is_head, ka) !> {
            @cancel_defer flush;
            return -1;
        };
        return ka;
    }

    if (is_options) {
        send_options(conn, ka) !> {
            @cancel_defer flush;
            return -1;
        };
        return ka;
    }

    const char* rel = "";
    {
        const char* p = path_s.cstr(conn->arena) !> {
            send_error(conn, 500, "Internal Server Error", "oom\n", !is_head, ka) !> {
                @cancel_defer flush;
                return -1;
            };
            return ka;
        };
        rel = (p[0] == '/') ? p + 1 : p;
    }

    int got_file = try_file(root_fd, rel, &fh);
    if (!got_file) {
        int dfd = fs_dir_open(root_fd, rel);
        char idx[K_PATH_MAX];
        if (dfd < 0) {
            send_error(conn, 404, "Not Found", "not found\n", !is_head, ka) !> {
                @cancel_defer flush;
                return -1;
            };
            return ka;
        }
        if (!join_index(idx, sizeof(idx), rel, g_index)) {
            close(dfd);
            send_error(conn, 414, "URI Too Long", "uri too long\n", !is_head, ka) !> {
                @cancel_defer flush;
                return -1;
            };
            return ka;
        }
        if (try_file(root_fd, idx, &fh)) {
            CCString mu = @string(`/${idx}`, conn->arena);
            if (!mu.failed()) url = mu;
            close(dfd);
            got_file = 1;
        } else if (!g_list) {
            close(dfd);
            send_error(conn, 403, "Forbidden", "forbidden\n", !is_head, ka) !> {
                @cancel_defer flush;
                return -1;
            };
            return ka;
        } else {
            struct stat dst;
            time_t dmtime = 0;
            if (fstat(dfd, &dst) == 0) dmtime = dst.st_mtime;
            cc_arena_stack(list_a, K_LIST_ARENA);
            CCString html = dir_listing(dfd, url, list_a) !>(e) {
                (void)e;
                send_error(conn, 500, "Internal Server Error", "listing\n",
                           !is_head, ka) !> {
                    @cancel_defer flush;
                    return -1;
                };
                return ka;
            };
            if (ims.len && http_parse_date(ims, conn->arena, &ims_t)
                    && ims_t >= dmtime) {
                send_not_modified(conn, dmtime, ka) !> {
                    @cancel_defer flush;
                    return -1;
                };
                return ka;
            }
            send_file_hdrs(conn, 200, "OK", cc_slice_cstr("/listing.html"),
                           (size_t)html.len, dmtime, empty, ka) !> {
                @cancel_defer flush;
                return -1;
            };
            @cancel_defer flush;
            conn_flush(conn) !> { return -1; };
            if (is_get && html.len > 0)
                write_all(conn->sock, html.as_slice()) !> { return -1; };
            return ka;
        }
    }
    mtime = fh.mtime;
    file_len = fh.file_len;
    if (ims.len && http_parse_date(ims, conn->arena, &ims_t) && ims_t >= mtime) {
        send_not_modified(conn, mtime, ka) !> {
            @cancel_defer flush;
            return -1;
        };
        return ka;
    }

    /* If-Range: date must match Last-Modified; ETag / mismatch → ignore Range. */
    if (range.len && ifr.len) {
        time_t ifr_t;
        if (!(http_parse_date(ifr, conn->arena, &ifr_t) && ifr_t == mtime))
            range = empty;
    }

    nsend = file_len;
    rkind = range.len ? range_parse(range, file_len, conn->arena, &off, &nsend) : 0;
    if (rkind < 0) {
        send_416(conn, file_len, ka) !> {
            @cancel_defer flush;
            return -1;
        };
        return ka;
    }
    if (rkind > 0) {
        snprintf(cr_buf, sizeof(cr_buf), "bytes %zu-%zu/%zu",
                 off, off + nsend - 1, file_len);
        crange = cc_slice_cstr(cr_buf);
        send_file_hdrs(conn, 206, "Partial Content", url, nsend, mtime, crange, ka) !> {
            @cancel_defer flush;
            return -1;
        };
    } else {
        send_file_hdrs(conn, 200, "OK", url, nsend, mtime, empty, ka) !> {
            @cancel_defer flush;
            return -1;
        };
    }
    @cancel_defer flush;
    conn_flush(conn) !> { return -1; };
    if (is_get && nsend > 0)
        send_file_body(conn->sock, &fh, off, nsend) !> { return -1; };
    return ka;
}

static void handle_client(CCSocket client, int root_fd) {
    char read_buf[K_READ_BUF];
    BufReader::[CCSocket] br;
    cc_arena_stack(out_arena, K_OUT_BUF);
    Conn conn = {.sock = &client, .arena = out_arena, .out = cc_string_new()};
    @defer client.close();
    br.init(&client, read_buf, sizeof(read_buf));

    for (;;) {
        int rc = handle_one(&br, &conn, root_fd);
        if (rc <= 0) return;
    }
}

static void on_stop_signal(int sig) {
    (void)sig;
    /* TERM/INT from scripts. Do not ln.close() here: that destroys the
     * kqueue watcher under accept's wait (free + not async-signal-safe). */
    _exit(0);
}

int main(int argc, char** argv) {
    /* Process-lifetime 64KB send slabs — declare before @errhandler so
     * early returns do not jump over the VLA. Keep backing modest: an
     * 8MB main-stack VLA SIGSEGVs Darwin's default stack. */
    cc_arena_pool_stack(send_pool, FILE_SEND_CHUNK, megabytes(1));
    g_send_pool = &send_pool;

    @errhandler(CCError err) {
        cc_error_log(err);
        return 1;
    }

    cc_arena_stack(cli_a, kilobytes(4));
    staticd_sync_init(cli_a.create_exclusive(4) !>);
    StaticdOpts opts = {0};
    bool go = cc_prepare_args(StaticdOpts, argc, argv, cli_a, &opts, stderr) !>;
    if (!go) return 0;

    char[:0] listen = opts.listen;

    char[:] root_view = opts.root;
    if (root_view.len == 0) {
        eprintln("staticd: empty docroot");
        return 1;
    }
    while (root_view.len > 1 && root_view.ptr[root_view.len - 1] == '/')
        root_view = root_view.sub(0, root_view.len - 1);
    CCString root_owned = @string(`${root_view}`, cli_a);
    if (root_owned.failed()) {
        eprintln("staticd: docroot oom");
        return 1;
    }
    const char* root_c = root_owned.cstr(cli_a) !> {
        eprintln("staticd: docroot nul");
        return 1;
    };
    int root_fd = open(root_c, O_RDONLY | O_DIRECTORY | O_CLOEXEC);
    if (root_fd < 0) {
        eprintln(@string(`staticd: docroot open: ${root_c}`, @scratch));
        return 1;
    }
    @defer close(root_fd);

    CCListener ln = cc_tcp_listen(listen) !>(err) {
        eprintln(@string(`listen: ${err}`, @scratch));
        return 1;
    };
    @defer ln.close();

    g_list = opts.list ? 1 : 0;
    {
        char[:] idx = opts.index;
        const char* index_c = "index.html";
        if (idx.len)
            index_c = ((const char*)idx.ptr);
        if (!index_c[0] || strchr(index_c, '/') || strchr(index_c, '\\')
                || strchr(index_c, '?') || strcmp(index_c, ".") == 0
                || strcmp(index_c, "..") == 0) {
            eprintln("staticd: bad --index");
            return 1;
        }
        g_index = index_c;
    }
    CCString extra = cc_string_new();
    {
        int n = 0;
        @for (i in 1..argc) {
            const char* a = argv[i];
            const char* v = NULL;
            if (strcmp(a, "--header") == 0 && (int)i + 1 < argc)
                v = argv[i + 1];
            else if (strncmp(a, "--header=", 9) == 0)
                v = a + 9;
            if (!v) continue;
            if (!v[0] || !strchr(v, ':') || strchr(v, '\r') || strchr(v, '\n')) {
                eprintln("staticd: bad --header (want Name: value, no CR/LF)");
                return 1;
            }
            if (n) extra.append("\r\n", cli_a);
            extra.append(v, cli_a);
            n++;
        }
        if (extra.failed()) {
            eprintln("staticd: --header oom");
            return 1;
        }
        g_extra = extra.as_slice();
    }

    println(@string(`staticd on ${listen} root=${root_c}`, @scratch));

    signal(SIGINT, on_stop_signal);
    signal(SIGTERM, on_stop_signal);

    g_clients = @parallel {
        @serial {
            while (1) {
                CCSocket client = ln.accept() !>(e) { (void)e; return; };
                (void)client.set_nodelay(1);
                @parallel(g_clients) {
                    handle_client(client, root_fd);
                }
            }
        }
    } !>;
    g_clients.wait() !>;
    return 0;
}

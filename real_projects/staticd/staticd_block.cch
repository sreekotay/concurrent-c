/*
 * Named-block cache — mmap's hit without mapping the file.
 * Include before staticd_fs.cch (file_hold ticks and culls).
 *
 * Owned face: `BlockCache` (ring metadata + ring pool + miss pool + mutex).
 * Hot path is checkout of a ready slab. Cold path is `block_cache_fill` —
 * blocking `pread` on the caller today; that is the seam for a waitable
 * fill (return to poll, complete off-thread, then checkout). Unaligned
 * Range and ring pressure go through the miss pool.
 *
 * Async fill (not wired): pass non-NULL `async_fill` to checkout →
 * `WOULD_BLOCK` with a `BlockFillReq`. A blocking-pool worker must
 * `pread`, mark the slot ready, then **wake the owning dest**
 * (eventfd/pipe on the poll tape, or schedule onto that dest). The fill
 * job must own a generation token so a dropped session cannot UAF the
 * row. `.wait` alone is insufficient — without a wake the dest may
 * sleep until the next unrelated poll event. Call sites pass NULL today.
 *
 * Key is (dev, ino, block). FNV of that triple is the probe start only.
 * Never steal a live other key. Idle refs==0 past until is a hole
 * (cull ≤1s on file_hold).
 *
 * Ring bytes live on `ring_pool` (CCArenaPool, FILE_SEND_CHUNK elems).
 * Slabs grow on demand up to `ring_n` live entries (`--block-ring`,
 * default 256); cull/free returns them to the freelist.
 */
#pragma(@per_tu)
#ifndef STATICD_BLOCK_CCH
#define STATICD_BLOCK_CCH

#include <string.h>
#include <stdlib.h>
#include <time.h>
#include <unistd.h>
#include <errno.h>
#include <stdint.h>

#define FILE_SEND_CHUNK (64u * 1024u)
#ifndef BLOCK_RING_DEFAULT
#define BLOCK_RING_DEFAULT 256u
#endif
#ifndef BLOCK_RING_MAX
#define BLOCK_RING_MAX 4096u
#endif
#define BLOCK_IDLE_TTL  1

typedef struct BlockSlot {
    char* data; /* ring_pool slab; NULL when hole */
    uint64_t dev;
    uint64_t ino;
    time_t mtime;
    long mtime_nsec; /* rejects same-second in-place rewrite when platform has it */
    time_t until;
    uint32_t block;
    uint32_t refs;
    uint32_t ready; /* 1 after fill; miss must not see a half fill */
    size_t len;
} BlockSlot;

typedef struct BlockCache {
    BlockSlot* ring; /* heap; length ring_n */
    uint32_t ring_n;
    time_t now;
    CCArenaPool* pool;      /* miss / unaligned; process lifetime */
    CCArenaPool* ring_pool; /* named-block slabs; grow ≤ ring_n */
    CCExclusiveMutex mx;
} BlockCache;

typedef struct BlockHold {
    BlockCache* cache;
    char* ptr;
    int slot; /* >=0 ring; <0 pool slab */
} BlockHold;

/* One domain: name 0 = ring, name 1 = file cache (fs.cch), name 2 = pages
 * engines (script.cch). Same order as before when multiple are held. */
enum { SYNC_BLOCK = 0, SYNC_FC = 1, SYNC_PAGES = 2 };
static CCExclusive g_sync;
static CCExclusiveMutex g_block_mx;
static CCExclusiveMutex g_fc_mx;
static CCExclusiveMutex g_pages_mx;
static BlockCache g_blocks;

static void staticd_sync_init(CCExclusive e) {
    g_sync = e;
    g_block_mx = e.mutex(SYNC_BLOCK);
    g_fc_mx = e.mutex(SYNC_FC);
    g_pages_mx = e.mutex(SYNC_PAGES);
}

/* 0 = ok. `ring_n` clamped by caller to [1, BLOCK_RING_MAX]. */
static int block_cache_init(BlockCache* c, CCArenaPool* pool,
                            CCArenaPool* ring_pool, uint32_t ring_n) {
    BlockSlot* ring;
    if (!c || !ring_n) return 0;
    ring = (BlockSlot*)calloc((size_t)ring_n, sizeof(BlockSlot));
    if (!ring) return 0;
    memset(c, 0, sizeof(*c));
    c->ring = ring;
    c->ring_n = ring_n;
    c->pool = pool;
    c->ring_pool = ring_pool;
    c->mx = g_block_mx;
    return 1;
}

static uint64_t block_probe(uint64_t dev, uint64_t ino, uint32_t block) {
    uint64_t h = 14695981039346656037ull;
    h ^= dev;
    h *= 1099511628211ull;
    h ^= ino;
    h *= 1099511628211ull;
    h ^= (uint64_t)block;
    h *= 1099511628211ull;
    return h;
}

/* Drop a ring row's slab back to ring_pool; clear metadata. Caller holds mx. */
static void block_slot_clear(BlockCache* c, uint32_t k) {
    char* data;
    if (!c || !c->ring || k >= c->ring_n) return;
    data = c->ring[k].data;
    c->ring[k] = (BlockSlot){0};
    if (data && c->ring_pool) c->ring_pool->free(data);
}

/* At most one sweep per second — file_hold, not per chunk. */
static void block_cache_tick(BlockCache* c, time_t now) {
    uint32_t n;
    if (!c || !c->ring) return;
    n = c->ring_n;
    CCExclusiveGuard hold = c->mx.acquire() @destroy;
    if (now != c->now) {
        @for (i in 0..n) {
            if (c->ring[i].refs == 0 && c->ring[i].ino
                    && now > c->ring[i].until)
                block_slot_clear(c, (uint32_t)i);
        }
        c->now = now;
    }
}

static void block_cache_cull_id(BlockCache* c, uint64_t dev, uint64_t ino) {
    uint32_t n;
    if (!c || !c->ring || !ino) return;
    n = c->ring_n;
    CCExclusiveGuard hold = c->mx.acquire() @destroy;
    @for (i in 0..n) {
        if (c->ring[i].dev == dev && c->ring[i].ino == ino
                && c->ring[i].refs == 0)
            block_slot_clear(c, (uint32_t)i);
    }
}

/* Blocking cold read into the miss pool. Dest HOL until this returns. */
static char* !>(CCError) block_cache_pool_pread(BlockCache* c, int fd,
                                               size_t want, size_t file_off) {
    char* buf;
    ssize_t r;
    if (!c || !c->pool || want == 0 || want > (size_t)FILE_SEND_CHUNK)
        return cc_err(CC_ERROR(CC_ERR_IO, "bad pread"));
    buf = (char*)c->pool->alloc();
    if (!buf) return cc_err(CC_ERROR(CC_ERR_OUT_OF_MEMORY, "send pool"));
    r = pread(fd, buf, want, (off_t)file_off);
    if (r < 0) {
        int e = errno;
        c->pool->free(buf);
        return cc_err(CC_ERROR(CC_ERR_IO, cc_io_error_str(cc_io_from_errno(e))));
    }
    if ((size_t)r != want) {
        c->pool->free(buf);
        return cc_err(CC_ERROR(CC_ERR_CLOSED, "short file"));
    }
    return cc_ok(buf);
}

/*
 * Blocking fill of a reserved ring slot (refs==1, ready==0, data set).
 * Mutex must not be held. Safe to call from a blocking-pool thread.
 */
static int block_cache_fill_raw(BlockCache* c, uint32_t k, int fd,
                                size_t want, size_t file_off) {
    ssize_t r;
    char* data;
    if (!c || !c->ring || k >= c->ring_n) return -1;
    data = c->ring[k].data;
    if (!data) return -1;
    r = pread(fd, data, want, (off_t)file_off);
    if (r < 0 || (size_t)r != want) {
        CCExclusiveGuard hold = c->mx.acquire() @destroy;
        block_slot_clear(c, k);
        return -1;
    }
    {
        CCExclusiveGuard hold = c->mx.acquire() @destroy;
        c->ring[k].ready = 1;
        c->ring[k].until = c->now + BLOCK_IDLE_TTL;
    }
    return 0;
}

static int !>(CCError) block_cache_fill(BlockCache* c, uint32_t k, int fd,
                                       size_t want, size_t file_off) {
    if (block_cache_fill_raw(c, k, fd, want, file_off) != 0)
        return cc_err(CC_ERROR(CC_ERR_IO, "block fill"));
    return cc_ok(1);
}

typedef struct BlockFillReq {
    BlockCache* cache;
    uint32_t slot;
    int fd;
    size_t want;
    size_t file_off;
} BlockFillReq;

static void block_hold_drop(BlockHold* h) {
    BlockCache* c;
    if (!h || !h->ptr) return;
    c = h->cache;
    if (h->slot < 0) {
        if (c && c->pool) c->pool->free(h->ptr);
    } else if (c) {
        CCExclusiveGuard hold = c->mx.acquire() @destroy;
        if (c->ring[h->slot].refs > 0)
            c->ring[h->slot].refs--;
    }
    h->ptr = NULL;
    h->slot = -1;
    h->cache = NULL;
}

@typehooks on BlockHold {
    .destroy = cc_type_destroy_call("block_hold_drop"),
};

/* Under mx: ensure slot has a ring_pool slab. 0 = ok, -1 = OOM. */
static int block_slot_ensure_data(BlockCache* c, uint32_t k) {
    if (!c || !c->ring || k >= c->ring_n || !c->ring_pool) return -1;
    if (c->ring[k].data) return 0;
    c->ring[k].data = (char*)c->ring_pool->alloc();
    return c->ring[k].data ? 0 : -1;
}

static BlockHold !>(CCError) block_cache_checkout(BlockCache* c, int fd,
                                          uint64_t dev, uint64_t ino,
                                          time_t mtime, long mtime_nsec,
                                          size_t file_off, size_t want,
                                          BlockFillReq* async_fill) {
    @errhandler(CCError e) { return cc_err(e); }
    BlockHold h = { .cache = c, .slot = -1 };
    uint32_t block, i, k, n;
    if (!c || !c->ring || !c->ring_n)
        return cc_err(CC_ERROR(CC_ERR_IO, "no block cache"));
    if (want == 0 || want > (size_t)FILE_SEND_CHUNK)
        return cc_err(CC_ERROR(CC_ERR_IO, "bad block"));
    if (!ino || (file_off % (size_t)FILE_SEND_CHUNK) != 0) {
        h.ptr = block_cache_pool_pread(c, fd, want, file_off) !>;
        return cc_ok(h);
    }
    n = c->ring_n;
    block = (uint32_t)(file_off / (size_t)FILE_SEND_CHUNK);
    CCExclusiveGuard hold = c->mx.acquire() @destroy;
    i = (uint32_t)(block_probe(dev, ino, block) % (uint64_t)n);
    {
        uint32_t found = (uint32_t)-1;
        uint32_t hole = (uint32_t)-1;
        @for (probe in 0..n) {
            k = (i + (uint32_t)probe) % n;
            if (c->ring[k].dev == dev && c->ring[k].ino == ino
                    && c->ring[k].block == block) {
                found = k;
                break;
            }
            if (hole == (uint32_t)-1 && c->ring[k].refs == 0
                    && !c->ring[k].ready)
                hole = k;
        }
        if (found != (uint32_t)-1) {
            k = found;
            if (c->ring[k].ready && c->ring[k].mtime == mtime
                    && c->ring[k].mtime_nsec == mtime_nsec
                    && c->ring[k].len == want && c->ring[k].data) {
                c->ring[k].refs++;
                c->ring[k].until = c->now + BLOCK_IDLE_TTL;
                hold.release();
                h.ptr = c->ring[k].data;
                h.slot = (int)k;
                return cc_ok(h);
            }
            if (c->ring[k].refs != 0) {
                hold.release();
                h.ptr = block_cache_pool_pread(c, fd, want, file_off) !>;
                return cc_ok(h);
            }
        } else if (hole != (uint32_t)-1) {
            k = hole;
        } else {
            hold.release();
            h.ptr = block_cache_pool_pread(c, fd, want, file_off) !>;
            return cc_ok(h);
        }
    }
    c->ring[k].refs = 1;
    c->ring[k].ready = 0;
    c->ring[k].dev = dev;
    c->ring[k].ino = ino;
    c->ring[k].mtime = mtime;
    c->ring[k].mtime_nsec = mtime_nsec;
    c->ring[k].block = block;
    c->ring[k].len = want;
    if (block_slot_ensure_data(c, k) != 0) {
        block_slot_clear(c, k);
        hold.release();
        h.ptr = block_cache_pool_pread(c, fd, want, file_off) !>;
        return cc_ok(h);
    }
    hold.release();
    if (async_fill) {
        *async_fill = (BlockFillReq){
            .cache = c, .slot = k, .fd = fd,
            .want = want, .file_off = file_off,
        };
        return cc_err(CC_ERROR(CC_ERR_WOULD_BLOCK, "fill"));
    }
    block_cache_fill(c, k, fd, want, file_off) !>;
    h.ptr = c->ring[k].data;
    h.slot = (int)k;
    return cc_ok(h);
}

/* Process singleton — fs tick/cull and page send share one cache. */
static void block_tick(time_t now) { block_cache_tick(&g_blocks, now); }
static void block_cull_id(uint64_t dev, uint64_t ino) {
    block_cache_cull_id(&g_blocks, dev, ino);
}
static BlockHold !>(CCError) checkout_block(int fd, uint64_t dev, uint64_t ino,
                                            time_t mtime, long mtime_nsec,
                                            size_t file_off, size_t want,
                                            BlockFillReq* async_fill) {
    return block_cache_checkout(&g_blocks, fd, dev, ino, mtime, mtime_nsec,
                                file_off, want, async_fill);
}

#endif /* STATICD_BLOCK_CCH */

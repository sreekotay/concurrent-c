/*
 * Named-block ring — mmap's hit without mapping the file.
 * Include before staticd_fs.cch (file_hold ticks and culls).
 *
 * Key is (dev, ino, block). Hash of that triple is the probe start only.
 * A later GET reuses that slot (refill if mtime/len moved). Never steal
 * a live other key — pool pread if the probe chain has no hole. Idle
 * refs==0 past until is a hole (cull ≤1s on file_hold). Unaligned
 * Range → pool.
 *
 * 256 × 64KB = 16MB BSS until process exit. A send holds refs so a
 * sweep cannot drop a slab still on the wire.
 */
#ifndef STATICD_BLOCK_CCH
#define STATICD_BLOCK_CCH

#include <string.h>
#include <time.h>
#include <unistd.h>
#include <errno.h>
#include <stdint.h>

#define FILE_SEND_CHUNK (64u * 1024u)
#define BLOCK_RING_N    256
#define BLOCK_IDLE_TTL  1

typedef struct BlockSlot {
    uint64_t dev;
    uint64_t ino;
    time_t mtime;
    time_t until;
    uint32_t block;
    uint32_t refs;
    uint32_t ready; /* 1 after pread; miss must not see a half fill */
    size_t len;
} BlockSlot;

typedef struct BlockHold {
    char* ptr;
    int slot; /* >=0 ring; <0 pool slab */
} BlockHold;

static char g_block_bytes[BLOCK_RING_N][FILE_SEND_CHUNK];
static BlockSlot g_block_ring[BLOCK_RING_N];
static time_t g_block_now;
static CCArenaPool* g_send_pool; /* miss / unaligned; process lifetime */

/* One domain: name 0 = ring, name 1 = file cache (fs.cch). Same order
 * as before — file cache then ring — when both are held. */
enum { SYNC_BLOCK = 0, SYNC_FC = 1 };
static CCExclusive g_sync;
static CCExclusiveMutex g_block_mx;
static CCExclusiveMutex g_fc_mx;

static void staticd_sync_init(CCExclusive e) {
    g_sync = e;
    g_block_mx = e.mutex(SYNC_BLOCK);
    g_fc_mx = e.mutex(SYNC_FC);
}

static uint64_t block_probe(uint64_t dev, uint64_t ino, uint32_t block) {
    uint64_t h = 14695981039346656037ull;
    h ^= dev;
    h *= 1099511628211ull;
    h ^= ino;
    h *= 1099511628211ull;
    h ^= (uint64_t)block;
    h *= 1099511628211ull;
    return h;
}

/* At most one sweep per second — file_hold, not per chunk. */
static void block_tick(time_t now) {
    CCExclusiveGuard hold = g_block_mx.acquire() @destroy;
    if (now != g_block_now) {
        @for (i in 0..BLOCK_RING_N) {
            if (g_block_ring[i].refs == 0 && g_block_ring[i].ino
                    && now > g_block_ring[i].until)
                g_block_ring[i] = (BlockSlot){0};
        }
        g_block_now = now;
    }
}

static void block_cull_id(uint64_t dev, uint64_t ino) {
    if (!ino) return;
    CCExclusiveGuard hold = g_block_mx.acquire() @destroy;
    @for (i in 0..BLOCK_RING_N) {
        if (g_block_ring[i].dev == dev && g_block_ring[i].ino == ino
                && g_block_ring[i].refs == 0)
            g_block_ring[i] = (BlockSlot){0};
    }
}

static char* !>(CCError) pool_pread(int fd, size_t want, size_t file_off) {
    char* buf;
    ssize_t r;
    if (!g_send_pool || want == 0 || want > (size_t)FILE_SEND_CHUNK)
        return cc_err(CC_ERROR(CC_ERR_IO, "bad pread"));
    buf = (char*)g_send_pool->alloc();
    if (!buf) return cc_err(CC_ERROR(CC_ERR_OUT_OF_MEMORY, "send pool"));
    r = pread(fd, buf, want, (off_t)file_off);
    if (r < 0) {
        int e = errno;
        g_send_pool->free(buf);
        return cc_err(CC_ERROR(CC_ERR_IO, cc_io_error_str(cc_io_from_errno(e))));
    }
    if ((size_t)r != want) {
        g_send_pool->free(buf);
        return cc_err(CC_ERROR(CC_ERR_CLOSED, "short file"));
    }
    return cc_ok(buf);
}

static void block_hold_drop(BlockHold* h) {
    if (!h || !h->ptr) return;
    if (h->slot < 0) {
        if (g_send_pool) g_send_pool->free(h->ptr);
    } else {
        CCExclusiveGuard hold = g_block_mx.acquire() @destroy;
        if (g_block_ring[h->slot].refs > 0)
            g_block_ring[h->slot].refs--;
    }
    h->ptr = NULL;
    h->slot = -1;
}

static BlockHold !>(CCError) checkout_block(int fd, uint64_t dev, uint64_t ino,
                                           time_t mtime, size_t file_off,
                                           size_t want) {
    BlockHold h = { .slot = -1 };
    uint32_t block, i, k;
    ssize_t r;
    if (want == 0 || want > (size_t)FILE_SEND_CHUNK)
        return cc_err(CC_ERROR(CC_ERR_IO, "bad block"));
    if (!ino || (file_off % (size_t)FILE_SEND_CHUNK) != 0) {
        h.ptr = pool_pread(fd, want, file_off) !>;
        return cc_ok(h);
    }
    block = (uint32_t)(file_off / (size_t)FILE_SEND_CHUNK);
    CCExclusiveGuard hold = g_block_mx.acquire() @destroy;
    i = (uint32_t)(block_probe(dev, ino, block) % (uint64_t)BLOCK_RING_N);
    {
        uint32_t found = (uint32_t)-1;
        uint32_t hole = (uint32_t)-1;
        @for (probe in 0..BLOCK_RING_N) {
            k = (i + (uint32_t)probe) % (uint32_t)BLOCK_RING_N;
            if (g_block_ring[k].dev == dev && g_block_ring[k].ino == ino
                    && g_block_ring[k].block == block) {
                found = k;
                break;
            }
            if (hole == (uint32_t)-1 && g_block_ring[k].refs == 0
                    && !g_block_ring[k].ready)
                hole = k;
        }
        if (found != (uint32_t)-1) {
            k = found;
            if (g_block_ring[k].ready && g_block_ring[k].mtime == mtime
                    && g_block_ring[k].len == want) {
                g_block_ring[k].refs++;
                g_block_ring[k].until = g_block_now + BLOCK_IDLE_TTL;
                hold.release();
                h.ptr = g_block_bytes[k];
                h.slot = (int)k;
                return cc_ok(h);
            }
            if (g_block_ring[k].refs != 0) {
                hold.release();
                h.ptr = pool_pread(fd, want, file_off) !>;
                return cc_ok(h);
            }
        } else if (hole != (uint32_t)-1) {
            k = hole;
        } else {
            hold.release();
            h.ptr = pool_pread(fd, want, file_off) !>;
            return cc_ok(h);
        }
    }
    g_block_ring[k].refs = 1;
    g_block_ring[k].ready = 0;
    g_block_ring[k].dev = dev;
    g_block_ring[k].ino = ino;
    g_block_ring[k].mtime = mtime;
    g_block_ring[k].block = block;
    g_block_ring[k].len = want;
    hold.release();
    r = pread(fd, g_block_bytes[k], want, (off_t)file_off);
    if (r < 0 || (size_t)r != want) {
        hold = g_block_mx.acquire();
        g_block_ring[k] = (BlockSlot){0};
        hold.release();
        if (r < 0) {
            const char* em = cc_io_error_str(cc_io_from_errno(errno));
            return cc_err(CC_ERROR(CC_ERR_IO, em));
        }
        return cc_err(CC_ERROR(CC_ERR_CLOSED, "short file"));
    }
    hold = g_block_mx.acquire();
    g_block_ring[k].ready = 1;
    g_block_ring[k].until = g_block_now + BLOCK_IDLE_TTL;
    h.ptr = g_block_bytes[k];
    h.slot = (int)k;
    return cc_ok(h);
}

#endif /* STATICD_BLOCK_CCH */

/*
 * WebSocket tape: SHA-1 + base64 for the 101, unmasked server frames,
 * masked client frames. Policy (echo / close) stays in staticd.ccs.
 */
#ifndef STATICD_WS_CCH
#define STATICD_WS_CCH

#include <string.h>
#include <stdint.h>

#define WS_GUID "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"
#define WS_MAX_PAYLOAD FILE_SEND_CHUNK

static uint32_t ws_rol(uint32_t x, int n) {
    return (x << n) | (x >> (32 - n));
}

static void ws_sha1(const unsigned char* data, size_t len, unsigned char out[20]) {
    uint32_t h0 = 0x67452301u, h1 = 0xEFCDAB89u, h2 = 0x98BADCFEu;
    uint32_t h3 = 0x10325476u, h4 = 0xC3D2E1F0u;
    unsigned char blk[64];
    size_t off = 0;
    uint64_t bits = (uint64_t)len * 8ull;

    while (off + 64 <= len) {
        uint32_t w[80];
        uint32_t a, b, c, d, e;
        int i;
        for (i = 0; i < 16; i++) {
            w[i] = ((uint32_t)data[off + 4 * (size_t)i] << 24)
                 | ((uint32_t)data[off + 4 * (size_t)i + 1] << 16)
                 | ((uint32_t)data[off + 4 * (size_t)i + 2] << 8)
                 | ((uint32_t)data[off + 4 * (size_t)i + 3]);
        }
        for (i = 16; i < 80; i++)
            w[i] = ws_rol(w[i - 3] ^ w[i - 8] ^ w[i - 14] ^ w[i - 16], 1);
        a = h0; b = h1; c = h2; d = h3; e = h4;
        for (i = 0; i < 80; i++) {
            uint32_t f, k, t;
            if (i < 20) { f = (b & c) | ((~b) & d); k = 0x5A827999u; }
            else if (i < 40) { f = b ^ c ^ d; k = 0x6ED9EBA1u; }
            else if (i < 60) { f = (b & c) | (b & d) | (c & d); k = 0x8F1BBCDCu; }
            else { f = b ^ c ^ d; k = 0xCA62C1D6u; }
            t = ws_rol(a, 5) + f + e + k + w[i];
            e = d; d = c; c = ws_rol(b, 30); b = a; a = t;
        }
        h0 += a; h1 += b; h2 += c; h3 += d; h4 += e;
        off += 64;
    }

    {
        size_t rem = len - off;
        memset(blk, 0, 64);
        if (rem) memcpy(blk, data + off, rem);
        blk[rem] = 0x80;
        if (rem >= 56) {
            uint32_t w[80];
            uint32_t a, b, c, d, e;
            int j;
            for (j = 0; j < 16; j++) {
                w[j] = ((uint32_t)blk[4 * (size_t)j] << 24)
                     | ((uint32_t)blk[4 * (size_t)j + 1] << 16)
                     | ((uint32_t)blk[4 * (size_t)j + 2] << 8)
                     | ((uint32_t)blk[4 * (size_t)j + 3]);
            }
            for (j = 16; j < 80; j++)
                w[j] = ws_rol(w[j - 3] ^ w[j - 8] ^ w[j - 14] ^ w[j - 16], 1);
            a = h0; b = h1; c = h2; d = h3; e = h4;
            for (j = 0; j < 80; j++) {
                uint32_t f, k, t;
                if (j < 20) { f = (b & c) | ((~b) & d); k = 0x5A827999u; }
                else if (j < 40) { f = b ^ c ^ d; k = 0x6ED9EBA1u; }
                else if (j < 60) { f = (b & c) | (b & d) | (c & d); k = 0x8F1BBCDCu; }
                else { f = b ^ c ^ d; k = 0xCA62C1D6u; }
                t = ws_rol(a, 5) + f + e + k + w[j];
                e = d; d = c; c = ws_rol(b, 30); b = a; a = t;
            }
            h0 += a; h1 += b; h2 += c; h3 += d; h4 += e;
            memset(blk, 0, 64);
        }
        blk[56] = (unsigned char)(bits >> 56);
        blk[57] = (unsigned char)(bits >> 48);
        blk[58] = (unsigned char)(bits >> 40);
        blk[59] = (unsigned char)(bits >> 32);
        blk[60] = (unsigned char)(bits >> 24);
        blk[61] = (unsigned char)(bits >> 16);
        blk[62] = (unsigned char)(bits >> 8);
        blk[63] = (unsigned char)bits;
        {
            uint32_t w[80];
            uint32_t a, b, c, d, e;
            int j;
            for (j = 0; j < 16; j++) {
                w[j] = ((uint32_t)blk[4 * (size_t)j] << 24)
                     | ((uint32_t)blk[4 * (size_t)j + 1] << 16)
                     | ((uint32_t)blk[4 * (size_t)j + 2] << 8)
                     | ((uint32_t)blk[4 * (size_t)j + 3]);
            }
            for (j = 16; j < 80; j++)
                w[j] = ws_rol(w[j - 3] ^ w[j - 8] ^ w[j - 14] ^ w[j - 16], 1);
            a = h0; b = h1; c = h2; d = h3; e = h4;
            for (j = 0; j < 80; j++) {
                uint32_t f, k, t;
                if (j < 20) { f = (b & c) | ((~b) & d); k = 0x5A827999u; }
                else if (j < 40) { f = b ^ c ^ d; k = 0x6ED9EBA1u; }
                else if (j < 60) { f = (b & c) | (b & d) | (c & d); k = 0x8F1BBCDCu; }
                else { f = b ^ c ^ d; k = 0xCA62C1D6u; }
                t = ws_rol(a, 5) + f + e + k + w[j];
                e = d; d = c; c = ws_rol(b, 30); b = a; a = t;
            }
            h0 += a; h1 += b; h2 += c; h3 += d; h4 += e;
        }
    }
    out[0] = (unsigned char)(h0 >> 24); out[1] = (unsigned char)(h0 >> 16);
    out[2] = (unsigned char)(h0 >> 8);  out[3] = (unsigned char)h0;
    out[4] = (unsigned char)(h1 >> 24); out[5] = (unsigned char)(h1 >> 16);
    out[6] = (unsigned char)(h1 >> 8);  out[7] = (unsigned char)h1;
    out[8] = (unsigned char)(h2 >> 24); out[9] = (unsigned char)(h2 >> 16);
    out[10] = (unsigned char)(h2 >> 8); out[11] = (unsigned char)h2;
    out[12] = (unsigned char)(h3 >> 24); out[13] = (unsigned char)(h3 >> 16);
    out[14] = (unsigned char)(h3 >> 8); out[15] = (unsigned char)h3;
    out[16] = (unsigned char)(h4 >> 24); out[17] = (unsigned char)(h4 >> 16);
    out[18] = (unsigned char)(h4 >> 8); out[19] = (unsigned char)h4;
}

static void ws_b64_20(const unsigned char in[20], char out[29]) {
    static const char tab[] =
        "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
    int i, o = 0;
    for (i = 0; i + 3 <= 20; i += 3) {
        unsigned n = ((unsigned)in[i] << 16) | ((unsigned)in[i + 1] << 8)
                   | (unsigned)in[i + 2];
        out[o++] = tab[(n >> 18) & 63];
        out[o++] = tab[(n >> 12) & 63];
        out[o++] = tab[(n >> 6) & 63];
        out[o++] = tab[n & 63];
    }
    {
        unsigned n = ((unsigned)in[18] << 16) | ((unsigned)in[19] << 8);
        out[o++] = tab[(n >> 18) & 63];
        out[o++] = tab[(n >> 12) & 63];
        out[o++] = tab[(n >> 6) & 63];
        out[o++] = '=';
    }
    out[o] = 0;
}

/* out is 28 chars + NUL. key is the header value (no CR). */
static int ws_accept_b64(char[:] key, char out[29]) {
    unsigned char digest[20];
    char raw[128];
    size_t n = key.len;
    size_t glen = sizeof(WS_GUID) - 1;
    if (!n || n > 64 || n + glen > sizeof(raw)) return 0;
    memcpy(raw, key.ptr, n);
    memcpy(raw + n, WS_GUID, glen);
    ws_sha1((const unsigned char*)raw, n + glen, digest);
    ws_b64_20(digest, out);
    return 1;
}

/* Server → client: unmasked. Returns header length (2, 4, or 10). */
static size_t ws_hdr_unmasked(int opcode, size_t n, unsigned char h[10]) {
    h[0] = (unsigned char)(0x80u | (unsigned)(opcode & 0x0f));
    if (n < 126) {
        h[1] = (unsigned char)n;
        return 2;
    }
    if (n <= 0xffffu) {
        h[1] = 126;
        h[2] = (unsigned char)(n >> 8);
        h[3] = (unsigned char)n;
        return 4;
    }
    h[1] = 127;
    h[2] = 0; h[3] = 0; h[4] = 0; h[5] = 0;
    h[6] = (unsigned char)(n >> 24);
    h[7] = (unsigned char)(n >> 16);
    h[8] = (unsigned char)(n >> 8);
    h[9] = (unsigned char)n;
    return 10;
}

static void ws_unmask(char* p, size_t n, const unsigned char key[4]) {
    size_t i;
    for (i = 0; i < n; i++)
        p[i] = (char)((unsigned char)p[i] ^ key[i & 3]);
}

#endif /* STATICD_WS_CCH */

/*
 * pigz_pthread.ccs -- Parallel gzip using cc_thread_spawn (OS threads)
 *
 * Same compression and handoff semantics as pigz_channel.ccs: compress_block
 * returns a plain CompressedResult* (NULL on failure); the consumer treats NULL
 * as a pipeline error. The transport is a FIFO CCTask channel (OS-thread
 * workers) instead of send_task on fibers.
 *
 * Note: do NOT pack results in a local struct named __result_t / field
 * __result inside the thread entry — shadow_lower treats that like send_task
 * result sugar and can drop the explicit `return`, so joins see NULL.
 */

#include <ccc/std/prelude.cch>
#include <ccc/cc_atomic.cch>
#include <ccc/stdio.cch>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <zlib.h>

#define BLOCK_SIZE (128 * 1024)
#define BLOCK_ARENA_OVERHEAD 1024
#define CHAN_CAP 16

typedef struct {
    long seq;
    CCSlice data;
    bool is_last;
    CCArena arena;
} Block;

typedef struct {
    long seq;
    CCSlice data;
    unsigned long crc;
    size_t original_len;
    bool is_last;
    CCArena arena;
} CompressedResult;

cc_atomic_i64 g_bytes_in = 0;
cc_atomic_i64 g_bytes_out = 0;
cc_atomic_int g_blocks_done = 0;
cc_atomic_int g_pipeline_error = 0;
static int g_compress_level = 6;

/* Returns NULL on allocation or zlib failure. */
static CompressedResult* compress_block(Block* blk, int level) {
    size_t arena_size = blk->data.len + (blk->data.len >> 3) + 8192;

    CCArena res_arena = @create(arena_size) @destroy;
    if (!cc_arena_is_live(res_arena)) return NULL;
    CompressedResult* res = cc_arena_alloc_T(CompressedResult, res_arena);
    if (!res) return NULL;

    res->seq = blk->seq;
    res->is_last = blk->is_last;
    res->original_len = blk->data.len;
    res->crc = crc32(0UL, (const Bytef*)blk->data.ptr, (uInt)blk->data.len);

    size_t max_out = blk->data.len + (blk->data.len >> 3) + 256;
    unsigned char* out_buf = cc_arena_alloc_T_count(unsigned char, res_arena, max_out);
    if (!out_buf) return NULL;

    unsigned char header[10] = {0x1f, 0x8b, 0x08, 0x00, 0, 0, 0, 0, 0x00, 0x03};
    memcpy(out_buf, header, 10);
    size_t pos = 10;

    z_stream strm = {0};
    if (deflateInit2(&strm, level, Z_DEFLATED, -15, 8, Z_DEFAULT_STRATEGY) != Z_OK) {
        return NULL;
    }
    strm.next_in = (Bytef*)blk->data.ptr;
    strm.avail_in = (uInt)blk->data.len;
    strm.next_out = out_buf + pos;
    strm.avail_out = (uInt)(max_out - pos - 8);

    int ret = deflate(&strm, Z_FINISH);
    pos += strm.total_out;
    deflateEnd(&strm);

    if (ret != Z_STREAM_END) return NULL;

    unsigned long crc = res->crc;
    size_t in_len = blk->data.len;
    out_buf[pos++] = crc & 0xff;
    out_buf[pos++] = (crc >> 8) & 0xff;
    out_buf[pos++] = (crc >> 16) & 0xff;
    out_buf[pos++] = (crc >> 24) & 0xff;
    out_buf[pos++] = in_len & 0xff;
    out_buf[pos++] = (in_len >> 8) & 0xff;
    out_buf[pos++] = (in_len >> 16) & 0xff;
    out_buf[pos++] = (in_len >> 24) & 0xff;

    res->data = cc_slice_from_parts(out_buf, pos, CC_SLICE_ID_UNTRACKED);
    cc_atomic_fetch_add(&g_bytes_in, blk->data.len);
    cc_atomic_fetch_add(&g_bytes_out, pos);
    cc_atomic_fetch_add(&g_blocks_done, 1);

    res->arena = res_arena.detach() !>(e) { (void)e; return NULL; };
    return res;
}

/* Frees block arena after compression (thread entry uses this). */
static CompressedResult* compress_owned_block(Block* blk) {
    CompressedResult* out = compress_block(blk, g_compress_level);
    cc_arena_free(&blk->arena);
    return out;
}

static bool write_all_or_fail(CCFile* f, CCSlice data, const char* what) {
    CCResult_size_t_CCIoError wr = cc_file_write(f, data);
    if (cc_is_err(wr)) {
        CCIoError err = cc_unwrap_err_as(wr, CCIoError);
        eprintln(@string(`${what} failed kind=${err.base.kind} os=${err.os_code}`, @scratch)) !>;
        cc_atomic_store(&g_pipeline_error, 1);
        return false;
    }
    size_t n = cc_unwrap_as(wr, size_t);
    if (n != data.len) {
        eprintln(@string(`${what} short write ${n}/${data.len}`, @scratch)) !>;
        cc_atomic_store(&g_pipeline_error, 1);
        return false;
    }
    return true;
}

/* OS-thread entry: return the payload pointer directly (not a __result wrapper). */
void* compress_task_wrapper(void* arg) {
    Block* blk = (Block*)arg;
    return (void*)compress_owned_block(blk);
}

/* Join next CCTask from the FIFO channel; payload is the thread return value. */
static int pthread_task_recv(CCChanRx rx, CompressedResult** out) {
    CCTask task;
    int rc = cc_chan_recv(rx.raw, &task, sizeof(task));
    if (rc == EPIPE) return 0;
    if (rc != 0) return -1;
    if (task.kind != CC_TASK_KIND_SPAWN) {
        eprintln(@string(`pthread_task_recv: expected SPAWN task, kind=${(int)task.kind}`, @scratch)) !>;
        return -1;
    }
    *out = (CompressedResult*)cc_block_on_intptr(task);
    return 1;
}

int compress_file(const char* in_path, const char* out_path, int level) {
    g_compress_level = level;
    cc_atomic_store(&g_pipeline_error, 0);
    
    CCFile in_file = cc_file_open(cc_slice_cstr(in_path)) !>(e) {
        eprintln(@string(`Failed to open input: ${in_path}`, @scratch)) !>;
        return 1;
    } @destroy;

    CCFile out_file = CC_FILE_CLOSED @destroy;
    out_file.create(out_path) !>(e) {
        eprintln(@string(`Failed to open output: ${out_path}`, @scratch)) !>;
        return 1;
    };

    CCTask[~CHAN_CAP >] tasks_tx;
    CCTask[~CHAN_CAP <] tasks_rx;
    CCChan* ch = cc_channel_pair(&tasks_tx, &tasks_rx);
    @defer ch.free();

    CCFile* in_ptr = &in_file;
    CCFile* out_ptr = &out_file;

    @errhandler(CCError e) { return cc_err_log(e); }
    CCNursery consumer = @create() !> @destroy;
    consumer.spawn(() => [out_ptr, tasks_rx] {
        CompressedResult* r = NULL;
        long expect_seq = 0;
        int rc;
        while ((rc = pthread_task_recv(tasks_rx, &r)) == 1) {
            if (!r) {
                eprintln(@string(`compress task failed (OOM or zlib error)`, @scratch)) !>;
                cc_atomic_store(&g_pipeline_error, 1);
                tasks_rx.close_with(cc_io_error(CC_IO_OTHER));
                break;
            }
            if (r->seq != expect_seq) {
                eprintln(@string(`ORDER: expected=${expect_seq} got=${r->seq}`, @scratch)) !>;
                cc_atomic_store(&g_pipeline_error, 1);
            }
            expect_seq++;
            if (!write_all_or_fail(out_ptr, r->data, "compressed output")) {
                cc_arena_free(&r->arena);
                tasks_rx.close_with(cc_io_error(CC_IO_OTHER));
                break;
            }
            cc_arena_free(&r->arena);
        }
        if (rc < 0) {
            cc_atomic_store(&g_pipeline_error, 1);
            tasks_rx.close_with(cc_io_error(CC_IO_OTHER));
        }
    }) !>;

    CCNursery producer = @create(consumer) !> @destroy {
        chan_close(tasks_tx);
    };
    producer.spawn(() => [in_ptr, tasks_tx] {
        long seq = 0;
        while (true) {
            if (cc_atomic_load(&g_pipeline_error)) break;

            CCArena blk_arena = cc_arena_heap(BLOCK_SIZE + BLOCK_ARENA_OVERHEAD);
            CCSlice data;
            bool !>(CCIoError) read_res = in_ptr->read(blk_arena, BLOCK_SIZE, &data);
            
            if (cc_is_err(read_res) || !cc_io_avail(read_res)) {
                cc_arena_free(&blk_arena);
                break;
            }
            
            Block* blk = cc_arena_alloc_T(Block, blk_arena);
            if (!blk) {
                cc_arena_free(&blk_arena);
                break;
            }
            
            blk->seq = seq++;
            blk->data = data;
            blk->is_last = (data.len < BLOCK_SIZE);
            blk->arena = blk_arena;
            
            bool is_last = blk->is_last;
            
            CCTask task = cc_thread_spawn(compress_task_wrapper, blk);
            if (task.kind != CC_TASK_KIND_SPAWN) {
                eprintln(@string(`cc_thread_spawn failed seq=${blk->seq}`, @scratch)) !>;
                cc_arena_free(&blk->arena);
                cc_atomic_store(&g_pipeline_error, 1);
                break;
            }
            if (cc_chan_send(tasks_tx.raw, &task, sizeof(task)) != 0) {
                /* Channel closed by consumer on error — drop in-flight task. */
                (void)cc_block_on_intptr(task);
                break;
            }
            
            if (is_last) break;
        }
    }) !>;

    cc_file_sync(&out_file);
    return cc_atomic_load(&g_pipeline_error) ? 1 : 0;
}

int main(int argc, char *argv[]) {
    @errhandler(CCError e) { return cc_err_log(e); }

    if (argc < 2) {
        eprintln(@string(`Usage: ${argv[0]} <file>`, @scratch)) !>;
        return 1;
    }

    char[:0] in_path = cc_slice_cstr(argv[1]);
    CCString out_name = @string(`${in_path}.gz`, @scratch);
    if (out_name.failed())
        return cc_err_log(CC_ERROR(CC_ERR_OUT_OF_MEMORY, "output path"));

    int ret = compress_file((const char*)in_path.ptr, cc_string_cstr(&out_name, __cc_str_scratch), 6);

    if (ret == 0) {
        long long bin = (long long)cc_atomic_load(&g_bytes_in);
        long long bout = (long long)cc_atomic_load(&g_bytes_out);
        int blocks = cc_atomic_load(&g_blocks_done);
        println(@string(`Compressed ${in_path} -> ${out_name}`, @scratch)) !>;
        println(@string(`Stats: ${bin} bytes in, ${bout} bytes out, ${blocks} blocks`,
                        @scratch)) !>;
    }

    return ret;
}

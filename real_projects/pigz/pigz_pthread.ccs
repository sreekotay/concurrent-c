/*
 * pigz_pthread.ccs -- Parallel gzip using cc_thread_spawn (OS threads)
 *
 * Same compression and handoff semantics as pigz_idiomatic.ccs: compress_block
 * returns a plain CompressedResult* (NULL on failure); the consumer treats NULL
 * as a pipeline error. The transport is an ordered CCTask channel (OS-thread
 * workers) instead of send_task on fibers.
 */

#include <ccc/std/prelude.cch>
#include <ccc/cc_atomic.cch>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <zlib.h>

#define BLOCK_SIZE (128 * 1024)
#define BLOCK_ARENA_OVERHEAD 1024
#define CHAN_CAP 16

typedef struct {
    long seq;
    CCSlice data;
    bool is_last;
    CCArena arena;
} Block;

typedef struct {
    long seq;
    CCSlice data;
    unsigned long crc;
    size_t original_len;
    bool is_last;
    CCArena arena;
} CompressedResult;

cc_atomic_i64 g_bytes_in = 0;
cc_atomic_i64 g_bytes_out = 0;
cc_atomic_int g_blocks_done = 0;
cc_atomic_int g_pipeline_error = 0;
static int g_compress_level = 6;

/* Returns NULL on allocation or zlib failure. */
static CompressedResult* compress_block(Block* blk, int level) {
    size_t arena_size = blk->data.len + (blk->data.len >> 3) + 8192;

    CCArena res_arena_storage = @create(arena_size) @destroy;
    if (!res_arena_storage.base) return NULL;
    CCArena* res_arena = &res_arena_storage;
    CompressedResult* res = cc_arena_alloc_T(CompressedResult, res_arena);
    if (!res) return NULL;

    res->seq = blk->seq;
    res->is_last = blk->is_last;
    res->original_len = blk->data.len;
    res->crc = crc32(0UL, (const Bytef*)blk->data.ptr, (uInt)blk->data.len);

    size_t max_out = blk->data.len + (blk->data.len >> 3) + 256;
    unsigned char* out_buf = cc_arena_alloc_T_count(unsigned char, res_arena, max_out);
    if (!out_buf) return NULL;

    unsigned char header[10] = {0x1f, 0x8b, 0x08, 0x00, 0, 0, 0, 0, 0x00, 0x03};
    memcpy(out_buf, header, 10);
    size_t pos = 10;

    z_stream strm = {0};
    if (deflateInit2(&strm, level, Z_DEFLATED, -15, 8, Z_DEFAULT_STRATEGY) != Z_OK) {
        return NULL;
    }
    strm.next_in = (Bytef*)blk->data.ptr;
    strm.avail_in = (uInt)blk->data.len;
    strm.next_out = out_buf + pos;
    strm.avail_out = (uInt)(max_out - pos - 8);

    int ret = deflate(&strm, Z_FINISH);
    pos += strm.total_out;
    deflateEnd(&strm);

    if (ret != Z_STREAM_END) return NULL;

    unsigned long crc = res->crc;
    size_t in_len = blk->data.len;
    out_buf[pos++] = crc & 0xff;
    out_buf[pos++] = (crc >> 8) & 0xff;
    out_buf[pos++] = (crc >> 16) & 0xff;
    out_buf[pos++] = (crc >> 24) & 0xff;
    out_buf[pos++] = in_len & 0xff;
    out_buf[pos++] = (in_len >> 8) & 0xff;
    out_buf[pos++] = (in_len >> 16) & 0xff;
    out_buf[pos++] = (in_len >> 24) & 0xff;

    res->data = cc_slice_from_parts(out_buf, pos, CC_SLICE_ID_UNTRACKED, pos);
    cc_atomic_fetch_add(&g_bytes_in, blk->data.len);
    cc_atomic_fetch_add(&g_bytes_out, pos);
    cc_atomic_fetch_add(&g_blocks_done, 1);

    res->arena = cc_arena_detach(res_arena);
    return res;
}

/* Frees block arena after compression (thread entry uses this). */
static CompressedResult* compress_owned_block(Block* blk) {
    CompressedResult* out = compress_block(blk, g_compress_level);
    cc_arena_free(&blk->arena);
    return out;
}

static bool write_all_or_fail(CCFile* f, CCSlice data, const char* what) {
    CCResult_size_t_CCIoError wr = cc_file_write(f, data);
    if (cc_is_err(wr)) {
        CCIoError err = cc_unwrap_err_as(wr, CCIoError);
        fprintf(stderr, "%s failed kind=%d os=%d\n", what, err.base.kind, err.os_code);
        cc_atomic_store(&g_pipeline_error, 1);
        return false;
    }
    size_t n = cc_unwrap_as(wr, size_t);
    if (n != data.len) {
        fprintf(stderr, "%s short write %zu/%zu\n", what, n, data.len);
        cc_atomic_store(&g_pipeline_error, 1);
        return false;
    }
    return true;
}

void* compress_task_wrapper(void* arg) {
    Block* blk = (Block*)arg;
    CompressedResult* res = compress_owned_block(blk);

    typedef struct { CompressedResult* __result; } __result_t;
    __result_t* storage = (__result_t*)cc_task_result_ptr(sizeof(__result_t));
    if (!storage) {
        /* cc_thread_spawn doesn't have fiber-local storage;
           fall back to malloc for the tiny result wrapper */
        storage = (__result_t*)malloc(sizeof(__result_t));
        if (!storage) return NULL;
    }

    storage->__result = res;
    return storage;
}

int compress_file(const char* in_path, const char* out_path, int level) {
    g_compress_level = level;
    cc_atomic_store(&g_pipeline_error, 0);
    
    CCFile in_file;
    if (cc_file_open(&in_file, cc_slice_cstr(in_path), "rb") != 0) {
        fprintf(stderr, "Failed to open input: %s\n", in_path);
        return 1;
    }
    @defer cc_file_close(&in_file);

    CCFile out_file;
    if (cc_file_open(&out_file, cc_slice_cstr(out_path), "wb") != 0) {
        fprintf(stderr, "Failed to open output: %s\n", out_path);
        return 1;
    }
    @defer cc_file_close(&out_file);

    CCTask[~CHAN_CAP >] tasks_tx;
    CCTask[~CHAN_CAP <] tasks_rx;
    CCChan* ch = cc_channel_pair(&tasks_tx, &tasks_rx);
    @defer cc_channel_free(ch);

    CCFile* in_ptr = &in_file;
    CCFile* out_ptr = &out_file;

    CCNursery* consumer = @create(NULL, () => [out_ptr, tasks_rx] {
        void* result;
        long expect_seq = 0;
        while (ordered_recv(tasks_rx, &result) == 1) {
            CompressedResult* r = (CompressedResult*)result;
            if (!r) {
                fprintf(stderr, "compress task failed (OOM or zlib error)\n");
                cc_atomic_store(&g_pipeline_error, 1);
                break;
            }
            if (r->seq != expect_seq) {
                fprintf(stderr, "ORDER: expected=%ld got=%ld\n", expect_seq, r->seq);
                cc_atomic_store(&g_pipeline_error, 1);
            }
            expect_seq++;
            if (!write_all_or_fail(out_ptr, r->data, "compressed output")) {
                cc_arena_free(&r->arena);
                break;
            }
            cc_arena_free(&r->arena);
        }
    }) @destroy;
    if (!consumer) {
        fprintf(stderr, "Failed to create consumer nursery\n");
        return 1;
    }

    CCNursery* producer = @create(consumer, () => [in_ptr, tasks_tx] {
        long seq = 0;
        while (true) {
            if (cc_atomic_load(&g_pipeline_error)) break;

            CCArena blk_arena = cc_arena_heap(BLOCK_SIZE + BLOCK_ARENA_OVERHEAD);
            CCSlice data;
            bool !>(CCIoError) read_res = cc_file_read(in_ptr, &blk_arena, BLOCK_SIZE, &data);
            
            if (cc_is_err(read_res) || !cc_io_avail(read_res)) {
                cc_arena_free(&blk_arena);
                break;
            }
            
            Block* blk = cc_arena_alloc_T(Block, &blk_arena);
            if (!blk) {
                cc_arena_free(&blk_arena);
                break;
            }
            
            blk->seq = seq++;
            blk->data = data;
            blk->is_last = (data.len < BLOCK_SIZE);
            blk->arena = blk_arena;
            
            bool is_last = blk->is_last;
            
            // KEY DIFFERENCE: cc_thread_spawn instead of cc_fiber_spawn_task
            CCTask task = cc_thread_spawn(compress_task_wrapper, blk);
            cc_chan_send(tasks_tx.raw, &task, sizeof(task));
            
            if (is_last) break;
        }
    }) @destroy {
        chan_close(tasks_tx);
    };
    if (!producer) {
        chan_close(tasks_tx);
        fprintf(stderr, "Failed to create producer nursery\n");
        return 1;
    }

    cc_file_sync(&out_file);
    return cc_atomic_load(&g_pipeline_error) ? 1 : 0;
}

int main(int argc, char *argv[]) {
    if (argc < 2) {
        fprintf(stderr, "Usage: %s <file>\n", argv[0]);
        return 1;
    }
    
    char out_name[4096];
    snprintf(out_name, sizeof(out_name), "%s.gz", argv[1]);
    
    int ret = compress_file(argv[1], out_name, 6);
    
    if (ret == 0) {
        printf("Compressed %s -> %s\n", argv[1], out_name);
        printf("Stats: %lld bytes in, %lld bytes out, %d blocks\n",
               (long long)cc_atomic_load(&g_bytes_in),
               (long long)cc_atomic_load(&g_bytes_out),
               cc_atomic_load(&g_blocks_done));
    }
    
    return ret;
}

#!ccc ccs
/*
 * pigz_wait.ccs — pigz over `@parallel seq (use_par) wait (ts) for`.
 *
 * The construct owns enter / spawn / join / error capture. The body owns
 * stages and loop-carried state:
 *
 *   read  — (PIGZ_DICT=1) dictionary pointer into the previous block.
 *           Bytes are pread at i*BLOCK_SIZE. That input stays live until
 *           the next write ticket (pigz `dict = curr`).
 *   write — output position, and (PIGZ_DICT=1) the running CRC.
 *
 * PIGZ_SEQ=1 is the same body, sequential. PIGZ_DICT=1 is a flag on one
 * helper, not a second path. PIGZ_CAP=N (default 16).
 * PIGZ_SPAWN=1 replaces wait-for with enter + nur->spawn + leave.
 */

#include <ccc/std/prelude.cch>
#include <ccc/cc_atomic.cch>
#include <ccc/script/stdio.cch>
#include <limits.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <zlib.h>

#define BLOCK_SIZE (128 * 1024)
#define DICT_SIZE  32768
/* ~2x the scheduler workers: spare in-flight tickets absorb out-of-order
 * deflate completion so the ordered write stage never starves a runner
 * (pigz keeps the same lookahead in its job queue). */
#define DEFAULT_CAP 32
#define MAX_CAP     256
#define LEVEL       6

static const unsigned char GZIP_HDR[10] = {
    0x1f, 0x8b, 0x08, 0x00, 0, 0, 0, 0, 0x00, 0x03
};

/* Pooled: the element is this header followed by the output buffer
 * (deflate_cap(BLOCK_SIZE) bytes). Returned to out_pool after write. */
typedef struct {
    CCSlice data;
    unsigned long crc;
    size_t original_len;
} CompressedResult;

/* Reusable deflate state — pigz's deflateReset instead of Init/End per
 * block. In-flight tickets ≤ cap, so a cap-sized slot array always has
 * a free entry. */
typedef struct {
    z_stream strm;
    cc_atomic_int busy;
    int inited;
} ZSlot;

typedef struct {
    int in_fd;
    CCFile* out;
    CCTurnstileRW* ts;
    size_t file_len;
    int chain;
    const unsigned char* dict;
    size_t dict_len;
    unsigned char* held_in;  /* pooled input buffer kept alive as next dict */
    unsigned long crc;
    unsigned long crc_shift;
    ZSlot* zslots;
    int nzslots;
    CCArenaPool* in_pool;    /* BLOCK_SIZE input buffers, recycled */
    CCArenaPool* out_pool;   /* CompressedResult + output buffer, recycled */
} CompressJob;

cc_atomic_i64 g_bytes_in = 0;
cc_atomic_i64 g_bytes_out = 0;
cc_atomic_int g_blocks_done = 0;

static int stagger_cap(void) {
    const char* s = getenv("PIGZ_CAP");
    if (!s || !s[0])
        return DEFAULT_CAP;
    int v = atoi(s);
    if (v < 1)
        return DEFAULT_CAP;
    if (v > MAX_CAP)
        return MAX_CAP;
    return v;
}

static int env_is_one(const char* name) {
    const char* s = getenv(name);
    return s && s[0] == '1' && s[1] == '\0';
}

static void put_u32le(unsigned char* p, unsigned long v) {
    p[0] = (unsigned char)v;
    p[1] = (unsigned char)(v >> 8);
    p[2] = (unsigned char)(v >> 16);
    p[3] = (unsigned char)(v >> 24);
}

static void gzip_trailer(unsigned char t[8], unsigned long crc, unsigned long isize) {
    put_u32le(t, crc);
    put_u32le(t + 4, isize);
}

static CCSlice gzip_hdr_slice(void) {
    return cc_slice_from_buffer((void*)GZIP_HDR, sizeof(GZIP_HDR));
}

/* One bound: input + 12.5% + slack + gzip wrap (header+trailer). */
static size_t deflate_cap(size_t n) {
    return n + (n >> 3) + 1024 + 18;
}

static ZSlot* zslot_acquire(CompressJob* job) {
    for (;;) {
        int k;
        for (k = 0; k < job->nzslots; k++) {
            int expect = 0;
            if (cc_atomic_cas(&job->zslots[k].busy, &expect, 1))
                return &job->zslots[k];
        }
    }
}

static void zslot_release(ZSlot* zs) {
    cc_atomic_store(&zs->busy, 0);
}

/* !chain: header + Z_FINISH + crc/isize. chain: raw deflate, optional
 * dictionary, Z_SYNC_FLUSH (Z_FINISH on last). */
static CompressedResult* !>(CCError) compress_slice(CCSlice data,
        const unsigned char* dict, size_t dict_len, bool is_last, int chain,
        ZSlot* zs, CCArenaPool* out_pool) {
    size_t max_out = deflate_cap((size_t)BLOCK_SIZE);
    CompressedResult* res = (CompressedResult*)out_pool->alloc();
    @defer(err) out_pool->free(res);
    if (!res)
        return cc_err(CC_ERR_OUT_OF_MEMORY, "deflate buf");
    unsigned char* out_buf = (unsigned char*)(res + 1);

    res->original_len = data.len;
    res->crc = crc32(0UL, (const Bytef*)data.ptr, (uInt)data.len);

    size_t pos = 0;
    if (!chain) {
        memcpy(out_buf, GZIP_HDR, sizeof(GZIP_HDR));
        pos = sizeof(GZIP_HDR);
    }

    z_stream* strm = &zs->strm;
    if (zs->inited && deflateReset(strm) != Z_OK) {
        deflateEnd(strm);
        zs->inited = 0;
    }
    if (!zs->inited) {
        memset(strm, 0, sizeof(*strm));
        if (deflateInit2(strm, LEVEL, Z_DEFLATED, -15, 8,
                         Z_DEFAULT_STRATEGY) != Z_OK)
            return cc_err(CC_ERR_IO, "deflateInit2");
        zs->inited = 1;
    }
    if (chain && dict_len)
        deflateSetDictionary(strm, dict, (uInt)dict_len);

    strm->next_in = (Bytef*)data.ptr;
    strm->avail_in = (uInt)data.len;
    strm->next_out = out_buf + pos;
    strm->avail_out = (uInt)(max_out - pos - (chain ? 0 : 8));

    int flush = (!chain || is_last) ? Z_FINISH : Z_SYNC_FLUSH;
    int ret = deflate(strm, flush);
    uInt left = strm->avail_in;
    uInt space = strm->avail_out;
    pos += strm->total_out;
    if (flush == Z_FINISH ? (ret != Z_STREAM_END)
                          : (ret != Z_OK || left != 0 || space == 0))
        return cc_err(CC_ERR_IO, "deflate");

    if (!chain) {
        gzip_trailer(out_buf + pos, res->crc, (unsigned long)data.len);
        pos += 8;
    }

    res->data = cc_slice_from_parts(out_buf, pos, CC_SLICE_ID_UNTRACKED);
    g_bytes_in.fetch_add((int64_t)data.len);
    g_bytes_out.fetch_add((int64_t)pos);
    g_blocks_done.fetch_add(1);
    return cc_ok(res);
}

/* Read stage + deflate. @defer(err) passes the read ticket on any exit
 * before the handoff. Dict publish is the only wait. */
static CompressedResult* !>(CCError) deflate_ticket(CompressJob* job, int i,
                                                   unsigned char** prev_in) {
    @defer(err) job->ts->read.pass(i);

    size_t off = (size_t)i * (size_t)BLOCK_SIZE;
    if (off > job->file_len)
        return cc_err(CC_ERR_IO, "block past end");

    size_t remain = job->file_len - off;
    size_t want = remain < (size_t)BLOCK_SIZE ? remain : (size_t)BLOCK_SIZE;
    bool is_last = (off + want >= job->file_len);

    unsigned char* buf = NULL;
    @defer if (buf) job->in_pool->free(buf);

    CCSlice data = cc_slice_empty();
    if (want) {
        buf = (unsigned char*)job->in_pool->alloc();
        if (!buf)
            return cc_err(CC_ERR_OUT_OF_MEMORY, "block buf");
        ssize_t got = pread(job->in_fd, buf, want, (off_t)off);
        if (got < 0 || (size_t)got != want)
            return cc_err(CC_ERR_IO, "pread");
        data = cc_slice_from_parts(buf, (size_t)got, CC_SLICE_ID_UNTRACKED);
    }

    const unsigned char* dict = NULL;
    size_t dict_len = 0;
    if (job->chain) {
        job->ts->read.wait(i);
        dict = job->dict;
        dict_len = job->dict_len;
        *prev_in = job->held_in;
        size_t tail = data.len < (size_t)DICT_SIZE ? data.len : (size_t)DICT_SIZE;
        job->dict = tail ? (const unsigned char*)data.ptr + (data.len - tail) : NULL;
        job->dict_len = tail;
        /* Ownership moves to the chain: the successor frees it once its
         * deflate no longer needs it as a dictionary. Defer becomes no-op. */
        job->held_in = buf;
        buf = NULL;
    }

    job->ts->read.pass(i);
    /* `return compress_slice(...)` is a Result-fn tail return and skips
     * this function's @defer (input leak on the default path). cc_ok /
     * cc_err go through the epilogue. */
    ZSlot* zs = zslot_acquire(job);
    CompressedResult* !>(CCError) r = compress_slice(
        data, dict, dict_len, is_last, job->chain, zs, job->out_pool);
    zslot_release(zs);
    if (r.is_err())
        return cc_err(r.error());
    return cc_ok(r.value());
}

/* Write stage. Read has already been handed back. */
static void !>(CCError) compress_and_write_i(CompressJob* job, int i) {
    @errhandler(CCError e) { return cc_err(e); }

    unsigned char* prev_in = NULL;
    CompressedResult* !>(CCError) r = deflate_ticket(job, i, &prev_in);

    job->ts->write.wait(i);
    @defer job->ts->write.pass(i);
    if (prev_in)
        job->in_pool->free(prev_in);
    if (r.is_err())
        return cc_err(r.error());

    CompressedResult* item = r.value();
    @defer job->out_pool->free(item);
    if (job->chain) {
        size_t len = item->original_len;
        job->crc = (len == (size_t)BLOCK_SIZE)
            ? crc32_combine_op(job->crc, item->crc, job->crc_shift)
            : crc32_combine(job->crc, item->crc, (long)len);
    }
    size_t n = job->out->write(item->data) !>;
    if (n != item->data.len)
        return cc_err(CC_ERR_IO, "write");
    return cc_ok();
}

static void spawn_all(CompressJob* job, CCTurnstileRW* ts, int n) {
    @errhandler(CCError e) cc_error_exit(e);

    CCNursery* nur = cc_nursery_create(NULL) !> @destroy;
    int i;
    for (i = 0; i < n; i++) {
        ts->enter(i) !>;
        nur->spawn(() => [job, i, ts] {
            @errhandler(CCError e) cc_error_exit(e);
            compress_and_write_i(job, i) !>;
            ts->leave() !>;
        });
    }
}

void !>(CCError) compress_file(char[:] in_path, char[:] out_path) {
    @errhandler(CCError e) { return cc_err(e); }

    g_bytes_in.store(0);
    g_bytes_out.store(0);
    g_blocks_done.store(0);

    CCFile in_file;
    if (in_file.open(in_path, "rb") != 0)
        return cc_err(CC_ERR_IO, "Failed to open input");
    @defer in_file.close();

    size_t file_len = in_file.size() !>;

    CCFile out_file;
    if (out_file.open(out_path, "wb") != 0)
        return cc_err(CC_ERR_IO, "Failed to open output");
    @defer out_file.close();

    /* Empty file is one zero-length ticket, not a zero-byte .gz. */
    size_t n_sz = file_len ? (file_len + (size_t)BLOCK_SIZE - 1) / (size_t)BLOCK_SIZE : 1;
    if (n_sz > (size_t)INT_MAX)
        return cc_err(CC_ERR_INVALID_ARG, "too many blocks");
    int n = (int)n_sz;
    int cap = stagger_cap();
    int chain = env_is_one("PIGZ_DICT");

    if (chain)
        out_file.write(gzip_hdr_slice()) !>;

    CCArena ts_arena = cc_arena_heap(megabytes(2)) @destroy;
    CCTurnstileRW ts@(n, cap, &ts_arena) @destroy;
    if (!ts.core.excl)
        return cc_err(CC_ERR_OUT_OF_MEMORY, "cc_turnstile_create failed");

    CCArenaPool in_pool;
    if (cc_arena_pool(&in_pool, (size_t)BLOCK_SIZE) != 0)
        return cc_err(CC_ERR_OUT_OF_MEMORY, "input pool");
    @defer in_pool.destroy();

    CCArenaPool out_pool;
    if (cc_arena_pool(&out_pool,
            sizeof(CompressedResult) + deflate_cap((size_t)BLOCK_SIZE)) != 0)
        return cc_err(CC_ERR_OUT_OF_MEMORY, "output pool");
    @defer out_pool.destroy();

    ZSlot* zslots = cc_arena_alloc_T_count(ZSlot, &ts_arena, (size_t)cap);
    if (!zslots)
        return cc_err(CC_ERR_OUT_OF_MEMORY, "zslot pool");
    memset(zslots, 0, (size_t)cap * sizeof(ZSlot));
    @defer {
        int k;
        for (k = 0; k < cap; k++)
            if (zslots[k].inited)
                deflateEnd(&zslots[k].strm);
    }

    CompressJob store = {
        .in_fd = fileno(in_file.handle),
        .out = &out_file,
        .ts = &ts,
        .file_len = file_len,
        .chain = chain,
        .crc = crc32(0UL, NULL, 0),
        .crc_shift = chain ? crc32_combine_gen((z_off_t)BLOCK_SIZE) : 0,
        .zslots = zslots,
        .nzslots = cap,
        .in_pool = &in_pool,
        .out_pool = &out_pool,
    } @destroy {
        /* Last block's buffer: published as the next dict, no successor
         * ever takes it out of held_in. */
        if (store.held_in) store.in_pool->free(store.held_in);
    };

    int use_par = !env_is_one("PIGZ_SEQ");
    int use_spawn = env_is_one("PIGZ_SPAWN");
    int i;
    if (!use_par) {
        for (i = 0; i < n; i++)
            compress_and_write_i(&store, i) !>;
    } else if (use_spawn) {
        spawn_all(&store, &ts, n);
    } else {
        @parallel seq (use_par) wait (ts) for (i in 0..n) {
            compress_and_write_i(&store, i) !>;
        }
    }
    if (chain) {
        unsigned char t[8];
        gzip_trailer(t, store.crc, (unsigned long)(file_len & 0xffffffffUL));
        out_file.write(cc_slice_from_buffer(t, sizeof(t))) !>;
    }

    out_file.sync() !>;
    return cc_ok();
}

int main(int argc, char* argv[]) {
    @errhandler(CCError e) { return cc_err_log(e); }

    if (argc < 2) {
        @string(`Usage: ${argv[0]} <file>`, @scratch).eprintln() !>;
        return 1;
    }

    char[:0] in_path = cc_slice_cstr(argv[1]);
    CCString out_name = @string(`${in_path}.gz`, @scratch);
    if (out_name.failed())
        return cc_err_log(CC_ERROR(CC_ERR_OUT_OF_MEMORY, "output path"));

    compress_file(in_path, out_name.as_slice()) !>;

    long long bin = (long long)g_bytes_in.load();
    long long bout = (long long)g_bytes_out.load();
    int blocks = g_blocks_done.load();
    @string(`Compressed ${in_path} -> ${out_name}`, @scratch).println() !>;
    @string(`Stats: ${bin} bytes in, ${bout} bytes out, ${blocks} blocks`,
            @scratch).println() !>;
    return 0;
}

#!ccc ccs
/*
 * pigz_wait.ccs — pigz over `@parallel seq (use_par) wait (ts) for`.
 *
 * The loop body is one ordinary call; the construct owns enter / spawn /
 * join / error capture (no nursery plumbing, no shared failed flag). The
 * CCTurnstileRW stages order the two pieces of loop-carried state:
 *
 *   read stage  — (PIGZ_DICT=1) the chained dictionary pointer only.
 *                 Block bytes are pread at i*BLOCK_SIZE (no shared
 *                 cursor). The previous block's last 32 KiB stays live
 *                 until the next write ticket (pigz's `dict = curr`);
 *   write stage — output file position, and (PIGZ_DICT=1) the running CRC.
 *
 * Because the ticket order is the loop order, the parallel run writes
 * byte-for-byte what the sequential run writes. PIGZ_SEQ=1 denies
 * parallelism at runtime (`seq (use_par)`): same body, two schedules.
 * The helper returns `void !>(CCError)`; the wait-for line unwraps it.
 * The construct records the first error, cancels new entries, still
 * `leave()`s, and re-raises the lowest ticket. Stage passes always run
 * (read is handed back before deflate). PIGZ_DICT=1 is a flag on that
 * one helper — dict on the read stage, crc32_combine on the write,
 * raw deflate + Z_SYNC_FLUSH — not a second code path.
 *
 * PIGZ_CAP=N bounds in-flight blocks (default 16).
 */

#include <ccc/std/prelude.cch>
#include <ccc/cc_atomic.cch>
#include <ccc/script/stdio.cch>
#include <limits.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <zlib.h>

#define BLOCK_SIZE (128 * 1024)
#define DICT_SIZE  32768
#define DEFAULT_CAP 16
#define MAX_CAP     256

typedef struct {
    CCSlice data;         /* compressed bytes, owned by .arena */
    unsigned long crc;    /* crc32 of the uncompressed block */
    size_t original_len;
    CCArena arena;
} CompressedResult;

typedef struct {
    CCFile* in;
    int in_fd;            /* positional reads; FILE cursor is not shared */
    CCFile* out;
    CCTurnstileRW* ts;
    size_t file_len;
    int n;
    int level;
    int chain;            /* PIGZ_DICT=1: loop-carried dict + one member */
    /* Tail of the previous uncompressed block (into held_in). */
    const unsigned char* dict;
    size_t dict_len;
    CCArena held_in;      /* previous input; next write ticket frees it */
    /* Loop-carried, guarded by the write stage. */
    unsigned long crc;
    /* crc32_combine_gen(BLOCK_SIZE): pigz's g.shift = x2nmodp(block, 3).
     * Full-size blocks skip the per-combine modular exponentiation. */
    unsigned long crc_shift;
} CompressJob;

cc_atomic_i64 g_bytes_in = 0;
cc_atomic_i64 g_bytes_out = 0;
cc_atomic_int g_blocks_done = 0;

static int stagger_cap(void) {
    const char* s = getenv("PIGZ_CAP");
    if (!s || !s[0])
        return DEFAULT_CAP;
    int v = atoi(s);
    if (v < 1)
        return DEFAULT_CAP;
    if (v > MAX_CAP)
        return MAX_CAP;
    return v;
}

static int env_is_one(const char* name) {
    const char* s = getenv(name);
    return s && s[0] == '1' && s[1] == '\0';
}

/* !chain: one gzip member (header + Z_FINISH + crc/isize), like pigz_parallel.
 * chain: raw deflate, optional dictionary, Z_SYNC_FLUSH (Z_FINISH on last). */
static CompressedResult* !>(CCIoError) compress_slice(CCSlice data,
        const unsigned char* dict, size_t dict_len, bool is_last, int chain,
        int level) {
    size_t wrap = chain ? 0 : 18;
    size_t max_out = data.len + (data.len >> 3) + (chain ? 1024 : 256) + wrap;
    CCArena res_arena = cc_arena_heap(data.len + (data.len >> 3) + 8192);
    @defer(err) res_arena.free();
    if (!res_arena.base)
        return cc_err(cc_io_error(CC_IO_OUT_OF_MEMORY));

    CompressedResult* res = cc_arena_alloc_T(CompressedResult, &res_arena);
    unsigned char* out_buf =
        cc_arena_alloc_T_count(unsigned char, &res_arena, max_out);
    if (!res || !out_buf)
        return cc_err(cc_io_error(CC_IO_OUT_OF_MEMORY));

    res->original_len = data.len;
    res->crc = crc32(0UL, (const Bytef*)data.ptr, (uInt)data.len);

    size_t pos = 0;
    if (!chain) {
        unsigned char header[10] = {0x1f, 0x8b, 0x08, 0x00, 0, 0, 0, 0, 0x00, 0x03};
        memcpy(out_buf, header, 10);
        pos = 10;
    }

    z_stream strm = {0};
    if (deflateInit2(&strm, level, Z_DEFLATED, -15, 8, Z_DEFAULT_STRATEGY) != Z_OK)
        return cc_err(cc_io_error(CC_IO_OTHER));
    if (chain && dict_len)
        deflateSetDictionary(&strm, dict, (uInt)dict_len);

    strm.next_in = (Bytef*)data.ptr;
    strm.avail_in = (uInt)data.len;
    strm.next_out = out_buf + pos;
    strm.avail_out = (uInt)(max_out - pos - (chain ? 0 : 8));

    int flush = (!chain || is_last) ? Z_FINISH : Z_SYNC_FLUSH;
    int ret = deflate(&strm, flush);
    uInt left = strm.avail_in;
    uInt space = strm.avail_out;
    pos += strm.total_out;
    deflateEnd(&strm);
    /* Z_SYNC_FLUSH: avail_out == 0 can still mean pending sync bytes. */
    if (flush == Z_FINISH ? (ret != Z_STREAM_END)
                          : (ret != Z_OK || left != 0 || space == 0))
        return cc_err(cc_io_error(CC_IO_OTHER));

    if (!chain) {
        unsigned long crc = res->crc;
        size_t in_len = data.len;
        out_buf[pos++] = crc & 0xff;
        out_buf[pos++] = (crc >> 8) & 0xff;
        out_buf[pos++] = (crc >> 16) & 0xff;
        out_buf[pos++] = (crc >> 24) & 0xff;
        out_buf[pos++] = in_len & 0xff;
        out_buf[pos++] = (in_len >> 8) & 0xff;
        out_buf[pos++] = (in_len >> 16) & 0xff;
        out_buf[pos++] = (in_len >> 24) & 0xff;
    }

    res->data = res_arena.slice(out_buf, pos);
    g_bytes_in.fetch_add((int64_t)data.len);
    g_bytes_out.fetch_add((int64_t)pos);
    g_blocks_done.fetch_add(1);

    res->arena = res_arena.detach();
    return cc_ok(res);
}

/* One iteration. job->chain is the only switch: dict pointer on read,
 * combine on write. First local error is kept; stages still pass; the
 * wait-for line unwraps so the construct can cancel / re-raise. */
static void !>(CCError) compress_and_write_i(CompressJob* job, int i) {
    size_t off = (size_t)i * (size_t)BLOCK_SIZE;
    CompressedResult* item = NULL;
    int handed_read = 0;
    int published = 0;
    CCTurnstileRW* ts = job->ts;
    int chain = job->chain;
    CCErrorKind ek = CC_ERR_NONE;
    const char* em = NULL;
    const unsigned char* dict = NULL;
    size_t dict_len = 0;
    CCArena prev_in = {0};

    if (off >= job->file_len) {
        ek = CC_ERR_IO;
        em = "block past end";
    } else {
        size_t remain = job->file_len - off;
        size_t want = remain < (size_t)BLOCK_SIZE ? remain : (size_t)BLOCK_SIZE;
        bool is_last = (off + want >= job->file_len);

        CCArena blk_arena = cc_arena_heap(want + 64);
        @defer blk_arena.free();
        if (!blk_arena.base) {
            ek = CC_ERR_OUT_OF_MEMORY;
            em = "block arena";
        } else {
            unsigned char* buf =
                cc_arena_alloc_T_count(unsigned char, &blk_arena, want);
            CCSlice data = cc_slice_empty();
            if (!buf) {
                ek = CC_ERR_OUT_OF_MEMORY;
                em = "block buf";
            } else {
                ssize_t got = pread(job->in_fd, buf, want, (off_t)off);
                if (got < 0 || (size_t)got != want) {
                    ek = CC_ERR_IO;
                    em = "pread";
                } else {
                    data = cc_slice_from_parts(buf, (size_t)got,
                                               CC_SLICE_ID_UNTRACKED);
                    /* Dict pointer is the only loop-carried read state. */
                    if (chain)
                        ts->read.wait(i);
                    if (chain) {
                        dict = job->dict;
                        dict_len = job->dict_len;
                        prev_in = job->held_in;
                        memset(&job->held_in, 0, sizeof(job->held_in));
                        size_t tail = data.len < (size_t)DICT_SIZE
                            ? data.len : (size_t)DICT_SIZE;
                        job->dict = (const unsigned char*)data.ptr
                            + (data.len - tail);
                        job->dict_len = tail;
                        job->held_in = blk_arena.detach();
                        published = 1;
                    }
                    ts->read.pass(i);
                    handed_read = 1;
                    CompressedResult* !>(CCIoError) r = compress_slice(
                        data, dict, dict_len, is_last, chain, job->level);
                    if (r.is_err()) {
                        ek = CC_ERR_IO;
                        em = "deflate";
                    } else {
                        item = r.value();
                    }
                }
            }
            if (chain && !published) {
                job->dict = dict;
                job->dict_len = dict_len;
                job->held_in = prev_in;
                memset(&prev_in, 0, sizeof(prev_in));
            }
        }
    }

    if (!handed_read)
        ts->read.pass(i);

    ts->write.wait(i);
    @defer ts->write.pass(i);
    if (prev_in.base)
        prev_in.free();
    if (item && ek == CC_ERR_NONE) {
        if (chain) {
            size_t len2 = item->original_len;
            job->crc = (len2 == (size_t)BLOCK_SIZE)
                ? crc32_combine_op(job->crc, item->crc, job->crc_shift)
                : crc32_combine(job->crc, item->crc, (long)len2);
        }
        size_t !>(CCIoError) wr = job->out->write(item->data);
        if (wr.is_err() || wr.value() != item->data.len) {
            ek = CC_ERR_IO;
            em = "write";
        }
    }
    if (item)
        item->arena.free();

    if (ek != CC_ERR_NONE)
        return cc_err(ek, em);
    return cc_ok();
}

void !>(CCError) compress_file(char[:] in_path, char[:] out_path) {
    @errhandler(CCError e) { return cc_err(e); }

    g_bytes_in.store(0);
    g_bytes_out.store(0);
    g_blocks_done.store(0);

    CCFile in_file;
    if (in_file.open(in_path, "rb") != 0)
        return cc_err(CC_ERR_IO, "Failed to open input");
    @defer in_file.close();

    size_t file_len = in_file.size() !>;

    CCFile out_file;
    if (out_file.open(out_path, "wb") != 0)
        return cc_err(CC_ERR_IO, "Failed to open output");
    @defer out_file.close();

    /* gzip empty file is a valid member, not a zero-byte success. */
    if (file_len == 0) {
        CompressedResult* item =
            compress_slice(cc_slice_empty(), NULL, 0, true, 0, 6) !>;
        @defer item->arena.free();
        size_t n = out_file.write(item->data) !>;
        if (n != item->data.len)
            return cc_err(CC_ERR_IO, "write");
        out_file.sync() !>;
        return cc_ok();
    }

    size_t n_sz = (file_len + (size_t)BLOCK_SIZE - 1) / (size_t)BLOCK_SIZE;
    if (n_sz > (size_t)INT_MAX)
        return cc_err(CC_ERR_INVALID_ARG, "too many blocks");
    int n = (int)n_sz;
    int cap = stagger_cap();
    int chain = env_is_one("PIGZ_DICT");

    if (chain) {
        unsigned char header[10] = {0x1f, 0x8b, 0x08, 0x00, 0, 0, 0, 0, 0x00, 0x03};
        out_file.write(cc_slice_from_buffer(header, sizeof(header))) !>;
    }

    CCArena ts_arena = cc_arena_heap(megabytes(2)) @destroy;
    CCTurnstileRW ts@(n, cap, &ts_arena) @destroy;
    if (!ts.core.excl)
        return cc_err(CC_ERR_OUT_OF_MEMORY, "cc_turnstile_create failed");

    CompressJob job_store;
    memset(&job_store, 0, sizeof(job_store));
    job_store.in = &in_file;
    job_store.in_fd = fileno(in_file.handle);
    job_store.out = &out_file;
    job_store.ts = &ts;
    job_store.file_len = file_len;
    job_store.n = n;
    job_store.level = 6;
    job_store.chain = chain;
    job_store.crc = crc32(0UL, NULL, 0);
    if (chain)
        job_store.crc_shift = crc32_combine_gen((z_off_t)BLOCK_SIZE);
    CompressJob* job = &job_store;

    int use_par = !env_is_one("PIGZ_SEQ");

    int i;
    @parallel seq (use_par) wait (ts) for (i in 0..n) {
        compress_and_write_i(job, i) !>;
    }
    if (job->held_in.base)
        job->held_in.free();

    if (chain) {
        unsigned char trailer[8];
        unsigned long crc = job->crc;
        unsigned long isize = (unsigned long)(file_len & 0xffffffffUL);
        trailer[0] = crc & 0xff;
        trailer[1] = (crc >> 8) & 0xff;
        trailer[2] = (crc >> 16) & 0xff;
        trailer[3] = (crc >> 24) & 0xff;
        trailer[4] = isize & 0xff;
        trailer[5] = (isize >> 8) & 0xff;
        trailer[6] = (isize >> 16) & 0xff;
        trailer[7] = (isize >> 24) & 0xff;
        out_file.write(cc_slice_from_buffer(trailer, sizeof(trailer))) !>;
    }

    out_file.sync() !>;
    return cc_ok();
}

int main(int argc, char* argv[]) {
    @errhandler(CCError e) { return cc_err_log(e); }

    if (argc < 2) {
        @string(`Usage: ${argv[0]} <file>`, @scratch).eprintln() !>;
        return 1;
    }

    char[:0] in_path = cc_slice_cstr(argv[1]);
    CCString out_name = @string(`${in_path}.gz`, @scratch);
    if (out_name.failed())
        return cc_err_log(CC_ERROR(CC_ERR_OUT_OF_MEMORY, "output path"));

    compress_file(in_path, out_name.as_slice()) !>;

    long long bin = (long long)g_bytes_in.load();
    long long bout = (long long)g_bytes_out.load();
    int blocks = g_blocks_done.load();
    @string(`Compressed ${in_path} -> ${out_name}`, @scratch).println() !>;
    @string(`Stats: ${bin} bytes in, ${bout} bytes out, ${blocks} blocks`,
            @scratch).println() !>;
    return 0;
}

/*
 * pigz_cc.ccs -- Parallel gzip in Concurrent-C (pigz_idiomatic model).
 *
 * Feature parity with Mark Adler's pigz. Seekable compress is the
 * sequential block loop with @parallel wait / @stage / cache (zs).
 * Decompress stays a three-stage I/O pipeline (inflate is not
 * block-parallel).
 */

#include "pigz_cc.cch"
#include <ccc/std/cli.cch>
#include <ccc/stdio.cch>
#include <limits.h>

/* ============================================================================
 * Global State & Statistics
 * ============================================================================ */

cc_atomic_i64 g_bytes_in = 0;
cc_atomic_i64 g_bytes_out = 0;
cc_atomic_int g_blocks_done = 0;
cc_atomic_int g_pipeline_error = 0;

typedef struct {
    z_stream strm;
    int inited;
} ZState;

typedef struct {
    const char *zip_name;
    uint16_t zip_name_len;
    uint16_t zip_mtime;
    uint16_t zip_mdate;
} ZipWriteInfo;

/* Helpers for repeated fail-closed I/O and ownership patterns. */
static inline void report_io_error(const char* what, CCIoError err) {
    @errhandler(CCError e) { cc_error_log(e); return; }
    eprintln(@string(`Error: ${what} (kind=${err.base.kind} os=${err.os_code})`,
                     @scratch)) !>;
}

static inline void mark_pipeline_error(void) {
    g_pipeline_error.store(1);
}

static inline bool write_all_or_fail(CCFile* f, CCSlice data, const char* what) {
    @errhandler(CCError e) {
        cc_error_log(e);
        g_pipeline_error.store(1);
        return false;
    }
    size_t n = f->write(data) !>(e) {
        eprintln(@string(`${what} failed kind=${e.base.kind} os=${e.os_code}`,
                         @scratch)) !>;
        g_pipeline_error.store(1);
        return false;
    };
    if (n != data.len) {
        eprintln(@string(`${what} short write ${n}/${data.len}`, @scratch)) !>;
        g_pipeline_error.store(1);
        return false;
    }
    return true;
}

static inline bool sync_file_or_fail(CCFile* f, const char* what) {
    @errhandler(CCError e) {
        cc_error_log(e);
        g_pipeline_error.store(1);
        return false;
    }
    size_t ignored = f->sync() !>(e) {
        eprintln(@string(`${what} failed kind=${e.base.kind} os=${e.os_code}`,
                         @scratch)) !>;
        g_pipeline_error.store(1);
        return false;
    };
    (void)ignored;
    return true;
}

static inline bool path_is_stdout(const char* path) {
    return path && strcmp(path, "/dev/stdout") == 0;
}

static bool copy_path_checked(char* dst, size_t dst_cap, const char* src, const char* what) {
    if (!dst || dst_cap == 0 || !src) return false;
    CCString s = @string(`${src}`, @scratch);
    if (s.failed()) {
        @errhandler(CCError e) { cc_error_log(e); mark_pipeline_error(); return false; }
        eprintln(@string(`Error: ${what} path too long: ${src}`, @scratch)) !>;
        mark_pipeline_error();
        return false;
    }
    const char* c = cc_string_cstr(&s, __cc_str_scratch);
    size_t n = c ? strlen(c) : 0;
    if (n >= dst_cap) {
        @errhandler(CCError e) { cc_error_log(e); mark_pipeline_error(); return false; }
        eprintln(@string(`Error: ${what} path too long: ${src}`, @scratch)) !>;
        mark_pipeline_error();
        return false;
    }
    memcpy(dst, c, n + 1);
    return true;
}

static bool build_suffixed_path(char* dst, size_t dst_cap, const char* path, const char* suffix) {
    if (!dst || dst_cap == 0 || !path || !suffix) return false;
    CCString s = @string(`${path}${suffix}`, @scratch);
    if (s.failed()) {
        @errhandler(CCError e) { cc_error_log(e); return false; }
        eprintln(@string(`pigz_cc: output path too long: ${path}${suffix}`, @scratch)) !>;
        return false;
    }
    const char* c = cc_string_cstr(&s, __cc_str_scratch);
    size_t n = c ? strlen(c) : 0;
    if (n >= dst_cap) {
        @errhandler(CCError e) { cc_error_log(e); return false; }
        eprintln(@string(`pigz_cc: output path too long: ${path}${suffix}`, @scratch)) !>;
        return false;
    }
    memcpy(dst, c, n + 1);
    return true;
}

static bool open_output_checked(CCFile* file, const char* path) {
    if (!file || !path) return false;
    @errhandler(CCError e) { cc_error_log(e); mark_pipeline_error(); return false; }
    if (!g.force && !path_is_stdout(path) && access(path, F_OK) == 0) {
        eprintln(@string(`pigz_cc: ${path} exists -- use -f to overwrite`, @scratch)) !>;
        mark_pipeline_error();
        return false;
    }
    if (file->open(cc_slice_cstr(path), "wb") != 0) {
        eprintln(@string(`Failed to open output: ${path}`, @scratch)) !>;
        mark_pipeline_error();
        return false;
    }
    return true;
}

/*
 * Compression — pigz_idiomatic model.
 *
 * Seekable files: sequential-looking block loop. Annotations schedule it.
 *
 *   @parallel seq (use_par) wait (ts) cache (zs) for …
 *       — ordered spawn; PIGZ_SEQ=1 is the same body inline.
 *         cache (zs) is warm deflate scratch per in-flight ticket.
 *   @stage (ts.read, i)
 *       — hop the 32 KiB dict tail and the rsync rolling hash.
 *   @stage (ts.write, i)
 *       — combine CRC/Adler and write raw deflate in ticket order.
 *
 * Stdin / non-regular files cannot pread and do not know n. Same helpers,
 * sequential while-read (one held block so is_last is known).
 */

static int env_is_one(const char* name) {
    const char* s = getenv(name);
    return s && s[0] == '1' && s[1] == '\0';
}

static int stagger_cap(size_t block, size_t out_elem) {
    const char* s = getenv("PIGZ_CAP");
    if (s && s[0]) {
        int v = atoi(s);
        if (v < 1) return DEFAULT_CAP;
        if (v > MAX_CAP) return MAX_CAP;
        return v;
    }
    if (g.max_mem > 0) {
        size_t per = block + out_elem;
        int c = per ? (int)(g.max_mem / per) : DEFAULT_CAP;
        if (c < 1) c = 1;
        if (c > MAX_CAP) c = MAX_CAP;
        return c;
    }
    return DEFAULT_CAP;
}

static size_t deflate_cap(size_t n) {
    size_t extra = (n / 5) * 10 + 128;
    return n + (n >> 3) + 1024 + extra;
}

static size_t in_pool_elem(size_t block) {
    size_t hits = (block / 5) * sizeof(size_t);
    size_t align = sizeof(size_t);
    size_t pad = (block + align - 1) & ~(align - 1);
    return pad + hits;
}

static size_t* hits_at(unsigned char* buf, size_t block) {
    size_t align = sizeof(size_t);
    size_t pad = (block + align - 1) & ~(align - 1);
    return (size_t*)(buf + pad);
}

static void !>(CCError) write_all(CCFile* f, CCSlice s) {
    @errhandler(CCError e) { return cc_err(e); }
    size_t nw = f->write(s) !>;
    if (nw != s.len)
        return cc_err(CC_ERR_IO, "write");
    return cc_ok();
}

static void !>(CCError) check_interrupt(void) {
    if (g_pipeline_error.load())
        return cc_err(CC_ERR_IO, "interrupted");
    return cc_ok();
}

static unsigned char* !>(CCError) read_block(int in_fd, CCArenaPool* pool,
                                             size_t off, size_t want) {
    unsigned char* buf = (unsigned char*)pool.alloc();
    if (!buf)
        return cc_err(CC_ERR_OUT_OF_MEMORY, "block buf");
    ssize_t got = pread(in_fd, buf, want, (off_t)off);
    if (got < 0 || (size_t)got != want) {
        pool->free(buf);
        return cc_err(CC_ERR_IO, "pread");
    }
    return cc_ok(buf);
}

/* Consume predecessor tail; publish this block's tail for i+1. */
static CCSlice hop_dict(unsigned char dictbuf[DICT_SIZE], size_t* dict_len,
                        CCSlice data, unsigned char take[DICT_SIZE]) {
    size_t dlen = *dict_len;
    if (dlen)
        memcpy(take, dictbuf, dlen);
    size_t tail = data.len < (size_t)DICT_SIZE ? data.len : (size_t)DICT_SIZE;
    if (tail)
        memcpy(dictbuf, (const unsigned char*)data.ptr + (data.len - tail), tail);
    *dict_len = tail;
    return cc_slice_from_buffer(take, dlen);
}

/* Rolling hash continues across blocks (pigz reader). Hits live after data. */
static CCSlice rsync_scan(CCSlice data, unsigned long* rolling,
                          size_t* hits, size_t max_hits) {
    size_t n_hits = 0;
    size_t last = 0;
    @for (i, ch in data) {
        *rolling = ((*rolling << 1) ^ ch) & 0xFFF;
        if (*rolling == 2047 && n_hits < max_hits) {
            hits[n_hits++] = (i + 1) - last;
            last = i + 1;
        }
    }
    if (n_hits > 0 && last < data.len && n_hits < max_hits)
        hits[n_hits++] = data.len - last;
    if (!n_hits)
        return cc_slice_empty();
    return cc_slice_from_parts(hits, n_hits * sizeof(size_t), CC_SLICE_ID_UNTRACKED);
}

static void combine_cksum(unsigned long* crc, int* first,
                          unsigned long block_crc, size_t len) {
    if (*first) {
        *crc = block_crc;
        *first = 0;
        return;
    }
    if (g.form == 1)
        *crc = adler32_comb(*crc, block_crc, len);
    else
        *crc = crc32_comb_with_size(*crc, block_crc, len, g.block);
}

static ZipWriteInfo zip_info_from_globals(void) {
    ZipWriteInfo z = {0};
    if (g.form != 2)
        return z;
    z.zip_name = g.name ? g.name : (g.alias ? g.alias : "stdin");
    size_t nlen = strlen(z.zip_name);
    if (nlen > 0xffff) nlen = 0xffff;
    z.zip_name_len = (uint16_t)nlen;
    if (g.mtime != 0) {
        struct tm* tm = localtime(&g.mtime);
        if (tm) {
            z.zip_mtime = (uint16_t)((tm->tm_hour << 11) | (tm->tm_min << 5) | (tm->tm_sec / 2));
            int year = tm->tm_year + 1900;
            if (year < 1980) year = 1980;
            z.zip_mdate = (uint16_t)(((year - 1980) << 9) | ((tm->tm_mon + 1) << 5) | tm->tm_mday);
        }
    }
    return z;
}

static void !>(CCError) write_container_header(CCFile* out, const ZipWriteInfo* zip) {
    @errhandler(CCError e) { return cc_err(e); }
    if (g.form == 0) {
        unsigned char header[10] = {
            0x1f, 0x8b, 0x08,
            (unsigned char)((g.name != NULL ? 8 : 0) + (g.comment != NULL ? 16 : 0)),
            0, 0, 0, 0,
            (unsigned char)(g.level >= 9 ? 2 : g.level == 1 ? 4 : 0),
            0x03
        };
        put4le(header + 4, (unsigned long)g.mtime);
        write_all(out, cc_slice_from_parts(header, 10, CC_SLICE_ID_UNTRACKED)) !>;
        if (g.name != NULL) {
            size_t nlen = strlen(g.name) + 1;
            write_all(out, cc_slice_from_parts(g.name, nlen, CC_SLICE_ID_UNTRACKED)) !>;
        }
        if (g.comment != NULL) {
            size_t clen = strlen(g.comment) + 1;
            write_all(out, cc_slice_from_parts(g.comment, clen, CC_SLICE_ID_UNTRACKED)) !>;
        }
    } else if (g.form == 1) {
        unsigned head = (0x78 << 8) +
                       (g.level >= 9 ? 3 << 6 :
                        g.level == 1 ? 0 << 6 :
                        g.level >= 6 ? 1 << 6 : 2 << 6);
        head += 31 - (head % 31);
        unsigned char header[2];
        put2be(header, head);
        write_all(out, cc_slice_from_parts(header, 2, CC_SLICE_ID_UNTRACKED)) !>;
    } else if (g.form == 2) {
        unsigned char header[30] = {
            0x50, 0x4b, 0x03, 0x04,
            0x14, 0x00, 0x08, 0x00, 0x08, 0x00,
            0x00, 0x00, 0x00, 0x00,
            0x00, 0x00, 0x00, 0x00,
            0x00, 0x00, 0x00, 0x00,
            0x00, 0x00, 0x00, 0x00,
            0x00, 0x00, 0x00, 0x00
        };
        put2le(header + 10, zip->zip_mtime);
        put2le(header + 12, zip->zip_mdate);
        put2le(header + 26, zip->zip_name_len);
        write_all(out, cc_slice_from_parts(header, 30, CC_SLICE_ID_UNTRACKED)) !>;
        if (zip->zip_name_len) {
            write_all(out, cc_slice_from_parts((void*)zip->zip_name, zip->zip_name_len,
                                               CC_SLICE_ID_UNTRACKED)) !>;
        }
    }
    return cc_ok();
}

static void !>(CCError) write_container_trailer(CCFile* out, const ZipWriteInfo* zip,
                                               unsigned long crc, size_t total_len,
                                               size_t total_comp_len) {
    @errhandler(CCError e) { return cc_err(e); }
    if (g.form == 0) {
        unsigned char trailer[8];
        put4le(trailer, crc);
        put4le(trailer + 4, (unsigned long)total_len);
        write_all(out, cc_slice_from_parts(trailer, 8, CC_SLICE_ID_UNTRACKED)) !>;
    } else if (g.form == 1) {
        unsigned char trailer[4];
        put4be(trailer, crc);
        write_all(out, cc_slice_from_parts(trailer, 4, CC_SLICE_ID_UNTRACKED)) !>;
    } else if (g.form == 2) {
        if (total_len > 0xffffffffu || total_comp_len > 0xffffffffu)
            return cc_err(CC_ERR_IO, "zip output >4GiB not supported yet");
        uint32_t crc32v = (uint32_t)crc;
        uint32_t csize = (uint32_t)total_comp_len;
        uint32_t usize = (uint32_t)total_len;

        unsigned char dd[16];
        dd[0] = 0x50; dd[1] = 0x4b; dd[2] = 0x07; dd[3] = 0x08;
        put4le(dd + 4, crc32v);
        put4le(dd + 8, csize);
        put4le(dd + 12, usize);
        write_all(out, cc_slice_from_parts(dd, 16, CC_SLICE_ID_UNTRACKED)) !>;

        unsigned char cd[46];
        memset(cd, 0, sizeof(cd));
        cd[0] = 0x50; cd[1] = 0x4b; cd[2] = 0x01; cd[3] = 0x02;
        cd[4] = 0x14; cd[5] = 0x00;
        cd[6] = 0x14; cd[7] = 0x00;
        cd[8] = 0x08; cd[9] = 0x00;
        cd[10] = 0x08; cd[11] = 0x00;
        put2le(cd + 12, zip->zip_mtime);
        put2le(cd + 14, zip->zip_mdate);
        put4le(cd + 16, crc32v);
        put4le(cd + 20, csize);
        put4le(cd + 24, usize);
        put2le(cd + 28, zip->zip_name_len);
        write_all(out, cc_slice_from_parts(cd, 46, CC_SLICE_ID_UNTRACKED)) !>;
        if (zip->zip_name_len) {
            write_all(out, cc_slice_from_parts((void*)zip->zip_name, zip->zip_name_len,
                                               CC_SLICE_ID_UNTRACKED)) !>;
        }

        uint32_t cd_size = (uint32_t)(46 + zip->zip_name_len);
        uint32_t cd_off = (uint32_t)(30 + zip->zip_name_len + total_comp_len + 16);
        unsigned char eocd[22];
        memset(eocd, 0, sizeof(eocd));
        eocd[0] = 0x50; eocd[1] = 0x4b; eocd[2] = 0x05; eocd[3] = 0x06;
        eocd[8] = 0x01; eocd[10] = 0x01;
        put4le(eocd + 12, cd_size);
        put4le(eocd + 16, cd_off);
        write_all(out, cc_slice_from_parts(eocd, 22, CC_SLICE_ID_UNTRACKED)) !>;
    }
    return cc_ok();
}

/*
 * Compress one block into a pooled CompressedResult.
 * zlib: cache (zs) Reset / Init. zopfli (level 11): zs unused.
 */
CompressedResult* !>(CCError) compress_block(CCSlice data, CCSlice dict,
        CCSlice lens, bool is_last, ZState* zs, CCArenaPool* out_pool) {
    size_t max_out = deflate_cap(data.len ? data.len : 1);
    if (data.len > (size_t)UINT_MAX || dict.len > (size_t)UINT_MAX ||
        max_out > (size_t)UINT_MAX)
        return cc_err(CC_ERR_INVALID_ARG, "deflate chunk exceeds uInt");
    CompressedResult* res = (CompressedResult*)out_pool.alloc();
    @defer(err) out_pool->free(res);
    if (!res)
        return cc_err(CC_ERR_OUT_OF_MEMORY, "deflate buf");
    unsigned char* out_buf = (unsigned char*)(res + 1);

    res->original_len = data.len;
    if (g.form == 1)
        res->crc = adler32(1UL, (const Bytef*)data.ptr, (uInt)data.len);
    else
        res->crc = crc32(0UL, (const Bytef*)data.ptr, (uInt)data.len);

    if (g.level <= 9) {
        z_stream* strm = &zs->strm;
        if (zs->inited && deflateReset(strm) != Z_OK) {
            deflateEnd(strm);
            zs->inited = 0;
        }
        if (!zs->inited) {
            memset(strm, 0, sizeof(*strm));
            if (deflateInit2(strm, g.level, Z_DEFLATED, -15, 8, g.strategy) != Z_OK)
                return cc_err(CC_ERR_IO, "deflateInit2");
            zs->inited = 1;
        }
        if (g.setdict && dict.len)
            deflateSetDictionary(strm, (const Bytef*)dict.ptr, (uInt)dict.len);

        strm->next_in = (Bytef*)data.ptr;
        strm->avail_in = (uInt)data.len;
        strm->next_out = out_buf;
        strm->avail_out = (uInt)max_out;

        int ret;
        if (lens.len == 0) {
            ret = pigz_deflate_splice(strm, is_last, g.setdict);
            if (ret != (is_last ? Z_STREAM_END : Z_OK) || strm->avail_in != 0)
                return cc_err(CC_ERR_IO, "deflate");
        } else {
            size_t* segs = (size_t*)lens.ptr;
            size_t n_lens = lens.len / sizeof(size_t);
            size_t total_in = 0;
            ret = Z_OK;
            for (size_t i = 0; i < n_lens; i++) {
                size_t segment_len = segs[i];
                if (segment_len == 0) segment_len = data.len - total_in;
                if (segment_len > (size_t)UINT_MAX)
                    return cc_err(CC_ERR_INVALID_ARG, "deflate chunk exceeds uInt");
                strm->avail_in = (uInt)segment_len;
                total_in += segment_len;
                while (strm->avail_in > 0) {
                    ret = deflate(strm, Z_NO_FLUSH);
                    if (ret != Z_OK) break;
                    if (strm->avail_out == 0) { ret = Z_BUF_ERROR; break; }
                }
                if (ret != Z_OK) break;
                if (total_in < data.len || !is_last) {
                    int setdict = (g.setdict && (dict.len > 0 || i > 0));
                    ret = pigz_deflate_splice(strm, 0, setdict);
                    if (ret != Z_OK) break;
                }
            }
            if (ret == Z_OK && is_last)
                ret = pigz_deflate_all(strm, Z_FINISH);
            if (ret != (is_last ? Z_STREAM_END : Z_OK))
                return cc_err(CC_ERR_IO, "deflate");
        }

        size_t pos = (size_t)strm->total_out;
        res->data = cc_slice_from_parts(out_buf, pos, CC_SLICE_ID_UNTRACKED);
        g_bytes_out.fetch_add((int64_t)pos);
    } else {
        size_t dict_len = (g.setdict ? dict.len : 0);
        size_t in_len = dict_len + data.len;
        unsigned char* z_in = (unsigned char*)malloc(in_len ? in_len : 1);
        if (!z_in)
            return cc_err(CC_ERR_OUT_OF_MEMORY, "zopfli in");
        if (dict_len) memcpy(z_in, dict.ptr, dict_len);
        if (data.len) memcpy(z_in + dict_len, data.ptr, data.len);

        unsigned char* out = NULL;
        size_t outsize = 0;
        unsigned char bits = 0;
        ZopfliDeflatePart(&g.zopts, 2, is_last, z_in, dict_len, dict_len + data.len,
                          &bits, &out, &outsize);
        free(z_in);
        if (!out)
            return cc_err(CC_ERR_IO, "zopfli");

        size_t extra = 0;
        if (!is_last) {
            extra += 5;
            if (!g.setdict) extra += 5;
        }
        if (outsize + extra > max_out) {
            free(out);
            return cc_err(CC_ERR_IO, "zopfli overflow");
        }
        memcpy(out_buf, out, outsize);
        free(out);

        size_t out_len = outsize;
        if (!is_last) {
            bits &= 7;
            if ((bits & 1) || !g.setdict) {
                if (bits == 0 || bits > 5) out_buf[out_len++] = 0;
                out_buf[out_len++] = 0;
                out_buf[out_len++] = 0;
                out_buf[out_len++] = 0xff;
                out_buf[out_len++] = 0xff;
            } else if (bits) {
                do {
                    out_buf[out_len - 1] += (unsigned char)(2U << bits);
                    out_buf[out_len++] = 0;
                    bits = (unsigned char)(bits + 2);
                } while (bits < 8);
            }
            if (!g.setdict) {
                out_buf[out_len++] = 0;
                out_buf[out_len++] = 0;
                out_buf[out_len++] = 0;
                out_buf[out_len++] = 0xff;
                out_buf[out_len++] = 0xff;
            }
        }
        res->data = cc_slice_from_parts(out_buf, out_len, CC_SLICE_ID_UNTRACKED);
        g_bytes_out.fetch_add((int64_t)out_len);
    }

    g_bytes_in.fetch_add((int64_t)data.len);
    g_blocks_done.fetch_add(1);
    return cc_ok(res);
}

typedef struct {
    CCFile* out;
    ZipWriteInfo zip;
    unsigned long crc;
    size_t total_len;
    size_t total_comp_len;
    int first;
    unsigned char dictbuf[DICT_SIZE];
    size_t dict_len;
    unsigned long rolling;
    unsigned char in_pool_raw[CC__ARENA_POOL_HANDLE_BYTES];
    unsigned char out_pool_raw[CC__ARENA_POOL_HANDLE_BYTES];
    CCArenaPool *in_pool;
    CCArenaPool *out_pool;
    int pools_live;
} CompressRun;

static void compress_run_init_cksum(CompressRun* run) {
    run->crc = (g.form == 1 ? 1UL : 0UL);
    run->total_len = 0;
    run->total_comp_len = 0;
    run->first = 1;
    run->dict_len = 0;
    run->rolling = 2047;
}

static void !>(CCError) compress_run_open_pools(CompressRun* run, size_t block) {
    size_t out_elem = sizeof(CompressedResult) + deflate_cap(block);
    run->in_pool = cc__arena_pool_place(run->in_pool_raw, sizeof(run->in_pool_raw));
    if (!run->in_pool || cc_arena_pool(run->in_pool, in_pool_elem(block)) != 0)
        return cc_err(CC_ERR_OUT_OF_MEMORY, "input pool");
    run->out_pool = cc__arena_pool_place(run->out_pool_raw, sizeof(run->out_pool_raw));
    if (!run->out_pool || cc_arena_pool(run->out_pool, out_elem) != 0) {
        cc_arena_pool_destroy(run->in_pool);
        return cc_err(CC_ERR_OUT_OF_MEMORY, "output pool");
    }
    run->pools_live = 1;
    return cc_ok();
}

static void compress_run_close_pools(CompressRun* run) {
    if (!run->pools_live) return;
    cc_arena_pool_destroy(run->out_pool);
    cc_arena_pool_destroy(run->in_pool);
    run->pools_live = 0;
}

static void !>(CCError) emit_result(CompressRun* run, CompressedResult* r) {
    @errhandler(CCError e) { return cc_err(e); }
    combine_cksum(&run->crc, &run->first, r->crc, r->original_len);
    run->total_len += r->original_len;
    run->total_comp_len += r->data.len;
    write_all(run->out, r->data) !>;
    return cc_ok();
}

/* One ticket body without the stages — used by the stdin stream. */
static void !>(CCError) compress_one(CompressRun* run, CCSlice data, bool is_last,
                                     ZState* zs) {
    @errhandler(CCError e) { return cc_err(e); }
    check_interrupt() !>;

    unsigned char take[DICT_SIZE];
    CCSlice dict = cc_slice_empty();
    if (g.setdict)
        dict = hop_dict(run->dictbuf, &run->dict_len, data, take);

    CCSlice lens = cc_slice_empty();
    size_t max_hits = g.block / 5;
    size_t* hits = NULL;
    if (g.rsync && data.ptr) {
        hits = hits_at((unsigned char*)data.ptr, g.block);
        lens = rsync_scan(data, &run->rolling, hits, max_hits);
    }

    CompressedResult* r = compress_block(data, dict, lens, is_last, zs, run->out_pool) !>;
    emit_result(run, r) !>;
    cc_arena_pool_free(run->out_pool, r);
    return cc_ok();
}

static void !>(CCError) compress_seekable(CompressRun* run, int in_fd, size_t file_len) {
    @errhandler(CCError e) { return cc_err(e); }

    size_t block = g.block;
    size_t n_sz = file_len ? (file_len + block - 1) / block : 1;
    if (n_sz > (size_t)INT_MAX)
        return cc_err(CC_ERR_INVALID_ARG, "too many blocks");
    int n = (int)n_sz;
    size_t out_elem = sizeof(CompressedResult) + deflate_cap(block);
    int cap = stagger_cap(block, out_elem);
    int use_par = !env_is_one("PIGZ_SEQ");

    write_container_header(run->out, &run->zip) !>;
    compress_run_open_pools(run, block) !>;
    @defer compress_run_close_pools(run);

    CCArena ts_arena = cc_arena_heap(megabytes(2)) @destroy;
    CCTurnstileRW ts@(cap, ts_arena) !> @destroy;

    ZState zs = {0} @destroy {
        if (zs.inited)
            deflateEnd(&zs.strm);
    };

    int i;
    @parallel seq (use_par) wait (ts) cache (zs) for (i in 0..n) {
        check_interrupt() !>;
        size_t off = (size_t)i * block;
        size_t remain = file_len - off;
        size_t want = remain < block ? remain : block;
        bool is_last = (off + want >= file_len);

        unsigned char* buf = NULL;
        if (want)
            buf = read_block(in_fd, run->in_pool, off, want) !>;
        CCSlice data = buf
            ? cc_slice_from_parts(buf, want, CC_SLICE_ID_UNTRACKED)
            : cc_slice_empty();

        unsigned char take[DICT_SIZE];
        CCSlice dict = cc_slice_empty();
        CCSlice lens = cc_slice_empty();
        @stage (ts.read, i) {
            if (g.setdict)
                dict = hop_dict(run->dictbuf, &run->dict_len, data, take);
            if (g.rsync && buf) {
                size_t max_hits = block / 5;
                lens = rsync_scan(data, &run->rolling, hits_at(buf, block), max_hits);
            }
        }

        CompressedResult* r =
            compress_block(data, dict, lens, is_last, &zs, run->out_pool) !>;

        @stage (ts.write, i) {
            emit_result(run, r) !>;
        }

        if (buf) cc_arena_pool_free(run->in_pool, buf);
        cc_arena_pool_free(run->out_pool, r);
    } !>.wait()!>;

    write_container_trailer(run->out, &run->zip, run->crc, run->total_len,
                            run->total_comp_len) !>;
    return cc_ok();
}

static void !>(CCError) compress_stream(CompressRun* run, CCFile* in) {
    @errhandler(CCError e) { return cc_err(e); }

    write_container_header(run->out, &run->zip) !>;
    compress_run_open_pools(run, g.block) !>;
    @defer compress_run_close_pools(run);

    ZState zs = {0} @destroy {
        if (zs.inited)
            deflateEnd(&zs.strm);
    };

    unsigned char* pending = NULL;
    size_t pending_len = 0;
    for (;;) {
        check_interrupt() !>;
        unsigned char* buf = (unsigned char*)cc_arena_pool_alloc(run->in_pool);
        if (!buf)
            return cc_err(CC_ERR_OUT_OF_MEMORY, "block buf");
        size_t nread = 0;
        bool !>(CCIoError) rb = in->read_buf(buf, g.block, &nread);
        if (rb.is_err()) {
            cc_arena_pool_free(run->in_pool, buf);
            return cc_err(CC_ERR_IO, "read");
        }
        if (!rb.value() || nread == 0) {
            cc_arena_pool_free(run->in_pool, buf);
            if (pending) {
                CCSlice data = cc_slice_from_parts(pending, pending_len, CC_SLICE_ID_UNTRACKED);
                compress_one(run, data, true, &zs) !>;
                cc_arena_pool_free(run->in_pool, pending);
                pending = NULL;
            }
            break;
        }
        if (pending) {
            CCSlice data = cc_slice_from_parts(pending, pending_len, CC_SLICE_ID_UNTRACKED);
            compress_one(run, data, false, &zs) !>;
            cc_arena_pool_free(run->in_pool, pending);
        }
        pending = buf;
        pending_len = nread;
        if (nread < g.block) {
            CCSlice data = cc_slice_from_parts(pending, pending_len, CC_SLICE_ID_UNTRACKED);
            compress_one(run, data, true, &zs) !>;
            cc_arena_pool_free(run->in_pool, pending);
            pending = NULL;
            break;
        }
    }

    write_container_trailer(run->out, &run->zip, run->crc, run->total_len,
                            run->total_comp_len) !>;
    return cc_ok();
}

int process_path(char[:0] path, int num_workers, int level, int strategy);

int compress_file(const char* in_path, const char* out_path, int num_workers, int level, int strategy) {
    @errhandler(CCError e) {
        if (out_path && !path_is_stdout(out_path))
            unlink(out_path);
        return cc_err_log(e);
    }
    (void)num_workers;
    g.level = level;
    g.strategy = strategy;
    g.shift = x2nmodp(g.block, 3);
    g_pipeline_error.store(0);

    CCFile in_file = {0};
    const char* real_in = in_path ? in_path : "/dev/stdin";
    if (in_file.open(cc_slice_cstr(real_in), "rb") != 0) {
        eprintln(@string(`Failed to open input: ${real_in}`, @scratch)) !>;
        return 1;
    }
    @defer in_file.close();

    CCFile out_file = {0};
    if (!open_output_checked(&out_file, out_path))
        return 1;
    @defer out_file.close();

    CompressRun run = {0};
    run.out = &out_file;
    run.zip = zip_info_from_globals();
    compress_run_init_cksum(&run);

    int in_fd = fileno(in_file.handle);
    struct stat st;
    int seekable = (fstat(in_fd, &st) == 0 && S_ISREG(st.st_mode));
    if (seekable)
        compress_seekable(&run, in_fd, (size_t)st.st_size) !>;
    else
        compress_stream(&run, &in_file) !>;

    if (!sync_file_or_fail(&out_file, "failed to sync compressed output"))
        return 1;
    if (g.sync && !sync_file_or_fail(&out_file, "failed to deep sync compressed output"))
        return 1;
    return g_pipeline_error.load() ? 1 : 0;
}

/* Pipeline transfer: arena owns the slab; data is a view into it. */
typedef struct {
    CCArena arena;
    CCSlice data;
} DecompChunk;

int decompress_file(const char* in_path, const char* out_path, int num_workers) {
    @errhandler(CCError e) { return cc_err_log(e); }
    (void)num_workers;
    g_pipeline_error.store(0);
    
    CCFile in_file = {0};
    const char* real_in = in_path ? in_path : "/dev/stdin";
    if (in_file.open(cc_slice_cstr(real_in), "rb") != 0) {
        eprintln(@string(`Failed to open input: ${real_in}`, @scratch)) !>;
        return 1;
    }
    @defer in_file.close();

    CCFile out_file = {0};
    bool out_open = false;
    const char* real_out_path = out_path;
    char real_out_buf[4096];
    if (strcmp(out_path, "/dev/stdout") == 0) {
        real_out_path = "/dev/stdout";
    } else {
        // Remove .gz suffix for output name if it exists.
        if (!copy_path_checked(real_out_buf, sizeof(real_out_buf), out_path, "decompression output")) {
            return 1;
        }
        size_t len = strlen(real_out_buf);
        if (len > 3 && strcmp(real_out_buf + len - 3, ".gz") == 0) {
            real_out_buf[len - 3] = '\0';
        }
        real_out_path = real_out_buf;
    }
    
    if (!g.test && !g.list) {
        if (!open_output_checked(&out_file, real_out_path)) {
            return 1;
        }
        out_open = true;
    }
    @defer { if (out_open) out_file.close(); };

    CCFile* in_ptr = &in_file;
    CCFile* out_ptr = &out_file;

    /* =========================================================================
     * Parallel I/O Decompression Pipeline
     * 
     *  ┌─────────┐     ┌─────────────┐     ┌─────────┐
     *  │ Reader  │────►│ Decompressor│────►│ Writer  │
     *  └─────────┘     └─────────────┘     └─────────┘
     *    (reads          (CPU work)         (writes
     *     ahead)                             behind)
     * ========================================================================= */
    
    // Channel capacity: how many chunks can be buffered
    int pipe_cap = 4;
    
    // Channels for compressed and decompressed data
    DecompChunk[~pipe_cap >] compressed_tx;
    DecompChunk[~pipe_cap <] compressed_rx;
    DecompChunk[~pipe_cap >] decompressed_tx;
    DecompChunk[~pipe_cap <] decompressed_rx;
    
    CCChan* compressed_ch = cc_channel_pair(&compressed_tx, &compressed_rx) !> @destroy;
    CCChan* decompressed_ch = cc_channel_pair(&decompressed_tx, &decompressed_rx) !> @destroy;

    // Stats (shared across tasks)
    _Atomic size_t total_in = 0;
    _Atomic size_t total_out = 0;
    _Atomic size_t* p_total_in = &total_in;
    _Atomic size_t* p_total_out = &total_out;

    {
        /* Keep the writer outside the producer scopes so producer-owned close()
         * can close channels as soon as the upstream task exits. */
        CCClosure0 decomp_writer_task = () => [out_ptr, decompressed_rx, decompressed_ch, p_total_out] {
            @errhandler(CCError e) cc_error_exit(e);
            DecompChunk chunk;
            while (true) {
                bool !>(CCIoError) recv_res = decompressed_rx.recv(&chunk);
                if (recv_res.is_err()) {
                    report_io_error("failed to receive decompressed chunk", cc_unwrap_err_as(recv_res, CCIoError));
                    mark_pipeline_error();
                    cc_channel_close_err(decompressed_ch, EIO);
                    break;
                }
                if (!recv_res.value()) break;
                if (chunk.data.len > 0 && !g.test && !g.list) {
                    if (!write_all_or_fail(out_ptr, chunk.data, "decompressed output")) {
                        cc_channel_close_err(decompressed_ch, EIO);
                        chunk.arena.free();
                        break;
                    }
                }
                cc_atomic_fetch_add(p_total_out, chunk.data.len);
                chunk.arena.free();
                if (g_pipeline_error.load()) break;
            }
        };
        CCNursery writer = cc_nursery_create() !> @destroy;
        writer.spawn(decomp_writer_task) !>;

        CCClosure0 decomp_inflate_task = () => [compressed_rx, decompressed_tx, compressed_ch, decompressed_ch] {
            @errhandler(CCError e) cc_error_exit(e);
            z_stream strm;
            memset(&strm, 0, sizeof(strm));
            if (inflateInit2(&strm, 15 + 16) != Z_OK) {
                report_io_error("failed to initialize decompression", cc_io_error(CC_IO_OTHER));
                mark_pipeline_error();
                cc_channel_close_err(compressed_ch, EIO);
                cc_channel_close_err(decompressed_ch, EIO);
            } else {
                DecompChunk in_chunk;
                while (!g_pipeline_error.load()) {
                    bool !>(CCIoError) recv_res = compressed_rx.recv(&in_chunk);
                    if (recv_res.is_err()) {
                        report_io_error("failed to receive compressed chunk", cc_unwrap_err_as(recv_res, CCIoError));
                        mark_pipeline_error();
                        cc_channel_close_err(compressed_ch, EIO);
                        cc_channel_close_err(decompressed_ch, EIO);
                        break;
                    }
                    if (!recv_res.value()) break;
                    if (in_chunk.data.len > (size_t)UINT_MAX) {
                        eprintln(@string(`Error: inflate chunk exceeds uInt`, @scratch)) !>;
                        mark_pipeline_error();
                        cc_channel_close_err(compressed_ch, EIO);
                        in_chunk.arena.free();
                        break;
                    }
                    strm.next_in = (Bytef*)in_chunk.data.ptr;
                    strm.avail_in = (uInt)in_chunk.data.len;
                    
                    bool error = false;
                    // Decompress all available input.
                    while (!error && (strm.avail_in > 0 || strm.avail_out == 0)) {
                        CCArena out_arena = cc_arena_heap(BLOCK_SIZE + 256) @destroy;
                        unsigned char* out_buf = cc_arena_alloc_T_count(unsigned char, out_arena, BLOCK_SIZE);
                        if (!out_buf) {
                            eprintln(@string(`Error: failed to allocate decompression output chunk`, @scratch)) !>;
                            mark_pipeline_error();
                            cc_channel_close_err(compressed_ch, EIO);
                            cc_channel_close_err(decompressed_ch, EIO);
                            error = true;
                            break;
                        }
                        
                        strm.next_out = out_buf;
                        strm.avail_out = BLOCK_SIZE;
                        
                        int ret = inflate(&strm, Z_NO_FLUSH);
                        if (ret == Z_STREAM_ERROR || ret == Z_DATA_ERROR || ret == Z_MEM_ERROR) {
                            eprintln(@string(`Decompression error: ${ret}`, @scratch)) !>;
                            mark_pipeline_error();
                            cc_channel_close_err(compressed_ch, EIO);
                            cc_channel_close_err(decompressed_ch, EIO);
                            error = true;
                            break;
                        }
                        
                        size_t have = BLOCK_SIZE - strm.avail_out;
                        if (have > 0) {
                            DecompChunk out_chunk = {0};
                            out_chunk.data = out_arena.slice(out_buf, have);
                            out_chunk.arena = out_arena.detach() !>;
                            bool !>(CCIoError) send_res = decompressed_tx.send(out_chunk);
                            if (send_res.is_err()) {
                                report_io_error("failed to send decompressed chunk", cc_unwrap_err_as(send_res, CCIoError));
                                mark_pipeline_error();
                                cc_channel_close_err(decompressed_ch, EIO);
                                out_chunk.arena.free();
                                error = true;
                                break;
                            }
                            if (!send_res.value()) {
                                eprintln(@string(`Error: decompressed output channel closed early`, @scratch)) !>;
                                mark_pipeline_error();
                                cc_channel_close_err(decompressed_ch, EIO);
                                out_chunk.arena.free();
                                error = true;
                                break;
                            }
                        }
                        
                        if (ret == Z_STREAM_END) break;
                    }
                    
                    in_chunk.arena.free();
                }
                inflateEnd(&strm);
            }
        };
        CCNursery decompressor = writer.create_child() !> @destroy;
        (void)decompressor.close(decompressed_tx);
        decompressor.spawn(decomp_inflate_task) !>;

        CCClosure0 decomp_reader_task = () => [in_ptr, compressed_tx, compressed_ch, p_total_in] {
            @errhandler(CCError e) cc_error_exit(e);
            while (!g_pipeline_error.load()) {
                CCArena chunk_arena = cc_arena_heap(BLOCK_SIZE + 256) @destroy;
                unsigned char* buf = cc_arena_alloc_T_count(unsigned char, chunk_arena, BLOCK_SIZE);
                if (!buf) {
                    eprintln(@string(`Error: failed to allocate compressed input chunk`, @scratch)) !>;
                    mark_pipeline_error();
                    cc_channel_close_err(compressed_ch, EIO);
                    break;
                }
                
                size_t bytes_read = 0;
                bool !>(CCIoError) read_res = in_ptr->read_buf(buf, BLOCK_SIZE, &bytes_read);
                if (read_res.is_err()) {
                    report_io_error("failed to read compressed input", cc_unwrap_err_as(read_res, CCIoError));
                    mark_pipeline_error();
                    cc_channel_close_err(compressed_ch, EIO);
                    break;
                }
                if (!read_res.value()) {
                    break;
                }
                
                cc_atomic_fetch_add(p_total_in, bytes_read);
                
                DecompChunk chunk = {0};
                chunk.data = chunk_arena.slice(buf, bytes_read);
                chunk.arena = chunk_arena.detach() !>;
                bool !>(CCIoError) send_res = compressed_tx.send(chunk);
                if (send_res.is_err()) {
                    report_io_error("failed to send compressed chunk", cc_unwrap_err_as(send_res, CCIoError));
                    mark_pipeline_error();
                    cc_channel_close_err(compressed_ch, EIO);
                    chunk.arena.free();
                    break;
                }
                if (!send_res.value()) {
                    eprintln(@string(`Error: compressed input channel closed early`, @scratch)) !>;
                    mark_pipeline_error();
                    cc_channel_close_err(compressed_ch, EIO);
                    chunk.arena.free();
                    break;
                }
            }
        };
        CCNursery reader = decompressor.create_child() !> @destroy;
        (void)reader.close(compressed_tx);
        reader.spawn(decomp_reader_task) !>;
    }

    if (g.list) {
        size_t in_total = cc_atomic_load(p_total_in);
        size_t out_total = cc_atomic_load(p_total_out);
        // pigz-style: percentage saved = (out - in) / out
        double ratio = out_total > 0 ? 100.0 * (double)(out_total - in_total) / (double)out_total : 0.0;
        println(@string(`${in_total} ${out_total} ${ratio}% ${in_path ? in_path : "<stdin>"}`,
                        @scratch)) !>;
    }

    if (!g.test && !g.list) {
        if (!sync_file_or_fail(&out_file, "failed to sync decompressed output")) {
            return 1;
        }
    }
    return g_pipeline_error.load() ? 1 : 0;
}

/* Process a single path (file or directory) recursively (matches pigz.c:4600-4620) */
int process_path(char[:0] path, int num_workers, int level, int strategy) {
    @errhandler(CCError e) { return cc_err_log(e); }
    if (!path.ptr || path.len == 0) {
        /* Stdin - no stat needed */
        g.mtime = 0;
        g.name = g.alias;
        return compress_file(NULL, "/dev/stdout", num_workers, level, strategy);
    }

    const char* path_cstr = (const char*)path.ptr;
    struct stat st;
    if (stat(path_cstr, &st) != 0) {
        eprintln(@string(`pigz_cc: ${path_cstr}: ${strerror(errno)}`, @scratch)) !>;
        return 1;
    }

    if (S_ISDIR(st.st_mode)) {
        if (!g.recursive) {
            eprintln(@string(`pigz_cc: ${path_cstr} is a directory -- ignored`, @scratch)) !>;
            return 0;
        }

        {
            CCArena dir_arena = cc_arena_heap(megabytes(1)) @destroy;
            if (!cc_arena_is_live(dir_arena)) return 1;
            CCDirIter* !>(CCIoError) iter_res = cc_dir_open(dir_arena, path);
            if (cc_is_ok(iter_res)) {
                CCDirIter* iter = cc_unwrap_as(iter_res, CCDirIter*);
                @defer cc_dir_close(iter);

                int ret = 0;
                while (true) {
                    CCDirEntry !>(CCIoError) entry_res = cc_dir_next(iter, dir_arena);
                    if (cc_is_err(entry_res)) {
                        CCIoError err = cc_unwrap_err_as(entry_res, CCIoError);
                        if (err.base.kind == CC_IO_OTHER && err.os_code == 0) break; // EOF
                        eprintln(@string(`pigz_cc: ${path_cstr}: error reading directory`, @scratch)) !>;
                        ret = 1;
                        break;
                    }

                    CCDirEntry entry = cc_unwrap_as(entry_res, CCDirEntry);
                    char[:0] name = entry.name;
                    if (CCSlice_eq_cstr(&name, ".") || CCSlice_eq_cstr(&name, "..")) continue;

                    char[:0] full_path = cc_path_join(dir_arena, path, name);
                    ret |= process_path(full_path, num_workers, level, strategy);
                }
                return ret;
            } else {
                eprintln(@string(`pigz_cc: ${path_cstr}: failed to open directory`, @scratch)) !>;
                return 1;
            }
        }
    }

    /* It's a file - set metadata and build output name */
    g.mtime = (g.headis & 2) ? st.st_mtime : 0;
    g.name = (g.headis & 1) ? justname((char*)path_cstr) : NULL;

    char output_file[4096];
    if (g.to_stdout) {
        if (!copy_path_checked(output_file, sizeof(output_file), "/dev/stdout", "stdout")) {
            return 1;
        }
    } else if (g.decode) {
        // Decompression: remove suffix
        size_t len = path.len;
        size_t slen = strlen(g.sufx);
        if (len > slen && strcmp(path_cstr + len - slen, g.sufx) == 0) {
            if (len - slen >= sizeof(output_file)) {
                eprintln(@string(`pigz_cc: output path too long: ${path_cstr}`, @scratch)) !>;
                return 1;
            }
            memcpy(output_file, path_cstr, len - slen);
            output_file[len - slen] = '\0';
        } else {
            if (!g.force) {
                if (g.verbosity > 0) eprintln(@string(`pigz_cc: ${path_cstr} does not have ${g.sufx} suffix -- skipped`, @scratch)) !>;
                return 0;
            }
            if (!build_suffixed_path(output_file, sizeof(output_file), path_cstr, ".out")) {
                return 1;
            }
        }
    } else {
        // Compression: add suffix
        size_t len = path.len;
        size_t slen = strlen(g.sufx);
        if (!g.force && len > slen && strcmp(path_cstr + len - slen, g.sufx) == 0) {
            if (g.verbosity > 0) eprintln(@string(`pigz_cc: ${path_cstr} already has ${g.sufx} suffix -- skipped`, @scratch)) !>;
            return 0;
        }
        if (!build_suffixed_path(output_file, sizeof(output_file), path_cstr, g.sufx)) {
            return 1;
        }
    }

    int ret = g.decode ? decompress_file(path_cstr, output_file, num_workers)
                       : compress_file(path_cstr, output_file, num_workers, level, strategy);
    
    if (ret == 0 && !g.to_stdout && !g.test && !g.list) {
        copymeta(path_cstr, output_file);
        if (!g.keep) {
            unlink(path_cstr);
        }
    }
    
    return ret;
}

/* ============================================================================
 * Command Line Interface (matches pigz.c:4100-4600)
 * ============================================================================ */

@grammar(cli) PigzOpts {~~~~
    stdout: flag -c, --stdout, --to-stdout desc "Write to stdout"
    decompress: flag -d, --decompress, --uncompress desc "Decompress"
    test: flag -t, --test desc "Test integrity"
    list: flag -l, --list desc "List metadata"
    keep: flag -k, --keep desc "Keep original file"
    recursive: flag -r, --recursive desc "Recursive directory processing"
    rsyncable: flag -R, --rsyncable desc "Rsyncable output"
    force: flag -f, --force desc "Force overwrite"
    quiet: flag -q, --quiet, --silent desc "Quiet mode"
    verbose: count -v, --verbose desc "Verbose mode"
    version: flag -V, --version desc "Show version"
    zlib: flag -z, --zlib desc "Compress to zlib format"
    zip: flag -K, --zip desc "Compress to zip format"
    independent: flag -i, --independent desc "Independent blocks"
    synchronous: flag -Y, --synchronous desc "Synchronous output"
    huffman: flag -H, --huffman desc "Huffman-only strategy"
    rle: flag -U, --rle desc "RLE strategy"
    no_name: flag -n, --no-name desc "Do not store file name"
    name: flag -N, --name desc "Store file name"
    time: flag -M, --time desc "Store or restore modification time"
    no_time: flag -T, --no-time desc "Do not store modification time"
    help: flag -h, --help desc "Show this help"
    level: opt i64 --level, -0..-9, -11 alias --fast=1, --best=9 as LEVEL default 6 desc "Compression level (0-9, 11)"
    processes: opt i64 -p, --processes attach as N default 4 desc "Allow up to N compression workers"
    blocksize: opt i64 -b, --blocksize attach as KB default 128 desc "Block size in KB"
    max_memory: opt i64 --max-memory as MB default 0 desc "Max memory in MB"
    suffix: opt string -S, --suffix as SUFFIX default ".gz" desc "Suffix instead of .gz"
    comment: opt string -C, --comment as TEXT desc "Set comment"
    alias_name: opt string -A, --alias as TEXT desc "Set alias"
    file: rest string desc "Input files"
~~~~}

static void pigz_apply_opts(const PigzOpts *opts, int64_t *num_workers,
                            bool *user_set_num_workers, int64_t *block_kb,
                            int64_t *max_mem_mb, bool *show_version) {
    if (opts->stdout) g.to_stdout = 1;
    if (opts->decompress) g.decode = 1;
    if (opts->test) { g.decode = 1; g.test = 1; }
    if (opts->list) { g.decode = 1; g.list = 1; }
    if (opts->keep) g.keep = 1;
    if (opts->recursive) g.recursive = 1;
    if (opts->rsyncable) g.rsync = 1;
    if (opts->force) g.force = 1;
    if (opts->quiet) g.verbosity = 0;
    if (opts->verbose) g.verbosity += (int)opts->verbose;
    if (opts->version) *show_version = true;
    if (opts->zlib) { g.form = 1; g.sufx = ".zz"; }
    if (opts->zip) { g.form = 2; g.sufx = ".zip"; }
    if (opts->independent) g.setdict = 0;
    if (opts->synchronous) g.sync = 1;
    if (opts->huffman) g.strategy = Z_HUFFMAN_ONLY;
    if (opts->rle) g.strategy = Z_RLE;
    if (opts->time) g.headis |= 2;
    if (opts->no_name) g.headis &= ~1;
    if (opts->name) g.headis |= 1;
    if (opts->no_time) g.headis &= ~2;
    cc_cli_overlay_cstr(&g.comment, opts, comment);
    cc_cli_overlay_cstr(&g.alias, opts, alias_name);
    {
        int64_t level = g.level;
        cc_cli_overlay_i64(&level, opts, level);
        g.level = (int)level;
    }
    if (opts->processes_present) {
        *num_workers = opts->processes;
        *user_set_num_workers = true;
    }
    cc_cli_overlay_i64(block_kb, opts, blocksize);
    cc_cli_overlay_i64(max_mem_mb, opts, max_memory);
    cc_cli_overlay_cstr(&g.sufx, opts, suffix);
}

int main(int argc, char *argv[]) {
    @errhandler(CCError e) { return cc_err_log(e); }
    bool show_version = false;
    int64_t num_workers = 4;
    bool user_set_num_workers = false;
    int64_t block_kb = 128;
    int64_t max_mem_mb = 0;
    CCArena cli_arena = cc_arena_heap(kilobytes(16)) @destroy;
    PigzOpts opts = {0};

    g.verbosity = 1;
    g.sufx = ".gz";
    g.headis = 3;
    g.setdict = 1;
    g.block = BLOCK_SIZE;
    g.level = 6;
    g.strategy = Z_DEFAULT_STRATEGY;

    /* Set up signal handling (matches pigz.c:4627) */
    signal(SIGINT, cut_short);
    signal(SIGTERM, cut_short);
    {
        bool go = cc_prepare_args(PigzOpts, argc, argv, cli_arena, &opts, stderr) !>(e) {
            (void)e;
            return 2;
        };
        if (!go) return 0; /* --help */
        if (argc < 2 && isatty(1)) {
            cc_print_usage(PigzOpts, stderr, argv[0]);
            return 0;
        }
    }
    /* Seed locals from grammar defaults before apply overlays present fields. */
    num_workers = opts.processes;
    block_kb = opts.blocksize;
    max_mem_mb = opts.max_memory;
    pigz_apply_opts(&opts, &num_workers, &user_set_num_workers, &block_kb,
                    &max_mem_mb, &show_version);
    if (show_version) {
        eprintln(@string(`pigz_cc 1.0`, @scratch)) !>;
        if (g.verbosity > 1) eprintln(@string(`zlib ${zlibVersion()}`, @scratch)) !>;
        return 0;
    }

    g.max_mem = (size_t)max_mem_mb * 1024 * 1024;
    g.block = (size_t)(block_kb < 32 ? 32 : block_kb) * 1024;
    if (g.block > (size_t)UINT_MAX || deflate_cap(g.block) > (size_t)UINT_MAX) {
        eprintln(@string(`pigz_cc: -b block exceeds zlib uInt`, @scratch)) !>;
        return 1;
    }
    ZopfliInitOptions(&g.zopts);
    int worker_count = (int)num_workers;
    int level = g.level;
    int strategy = g.strategy;
    if (worker_count < 1) worker_count = 1;
    if (worker_count > MAX_WORKERS) worker_count = MAX_WORKERS;
    if (user_set_num_workers) {
        cc_sched_set_num_workers((size_t)worker_count);
    }
    
    /* Process path recursively for each input file (matches pigz.c:4600-4620) */
    int ret = 0;
    bool had_input = opts.file_len > 0;
    for (size_t i = 0; i < opts.file_len; i++) {
        char[:0] path = opts.file[i];
        if (!path.ptr) continue;
        if (CCSlice_eq_cstr(&path, "-")) {
            g.to_stdout = 1;
            ret |= process_path(cc_slice_empty(), worker_count, level, strategy);
        } else {
            ret |= process_path(path, worker_count, level, strategy);
        }
    }
    
    if (!had_input) {
        g.to_stdout = 1;
        ret = process_path(cc_slice_empty(), worker_count, level, strategy);
    }
    
    /* Print statistics */
    long bytes_in = g_bytes_in.load();
    long bytes_out = g_bytes_out.load();
    int blocks = g_blocks_done.load();
    if (g.verbosity > 0 && bytes_in > 0) {
        double pct = 100.0 * ((double)bytes_out / (double)bytes_in);
        eprintln(@string(`Total: ${bytes_in} -> ${bytes_out} bytes (${pct}%), ${blocks} blocks, ${worker_count} workers`,
                         @scratch)) !>;
    }

    return ret;
}

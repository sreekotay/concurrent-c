/*
 * pigz_unordered.ccs -- pigz WITHOUT ordered delivery (output will be corrupt)
 *
 * Identical to pigz_channel except the consumer reads results in completion
 * order rather than sequence order.  This removes the head-of-line blocking
 * from ordered_recv and lets us measure the pure scheduling overhead with no
 * pipeline stalls.
 *
 * Expected: if ordering is the bottleneck, this should approach pigz_pthread.
 * The output .gz file will be corrupt — for benchmarking only.
 */

#include <ccc/std/prelude.cch>
#include <ccc/cc_atomic.cch>
#include <ccc/stdio.cch>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <zlib.h>

#define BLOCK_SIZE (128 * 1024)
#define BLOCK_ARENA_OVERHEAD 1024
#define CHAN_CAP 16

typedef struct {
    long seq;
    CCSlice data;
    bool is_last;
    CCArena arena;
} Block;

typedef struct {
    long seq;
    CCSlice data;
    unsigned long crc;
    size_t original_len;
    bool is_last;
    CCArena arena;
} CompressedResult;

cc_atomic_i64 g_bytes_in = 0;
cc_atomic_i64 g_bytes_out = 0;
cc_atomic_int g_blocks_done = 0;

CompressedResult* !>(CCIoError) compress_block(Block* blk, int level) {
    size_t arena_size = blk->data.len + (blk->data.len >> 3) + 8192;
    
    {
        CCArena res_arena = @create(arena_size) @destroy;
        if (!cc_arena_is_live(res_arena)) return cc_err(cc_io_error(CC_IO_OUT_OF_MEMORY));
        CompressedResult* res = cc_arena_alloc_T(CompressedResult, res_arena);
        if (!res) return cc_err(cc_io_error(CC_IO_OUT_OF_MEMORY));
        
        res->seq = blk->seq;
        res->is_last = blk->is_last;
        res->original_len = blk->data.len;
        res->crc = crc32(0UL, (const Bytef*)blk->data.ptr, (uInt)blk->data.len);

        size_t max_out = blk->data.len + (blk->data.len >> 3) + 256;
        unsigned char* out_buf = cc_arena_alloc_T_count(unsigned char, res_arena, max_out);
        if (!out_buf) return cc_err(cc_io_error(CC_IO_OUT_OF_MEMORY));

        unsigned char header[10] = {0x1f, 0x8b, 0x08, 0x00, 0, 0, 0, 0, 0x00, 0x03};
        memcpy(out_buf, header, 10);
        size_t pos = 10;

        z_stream strm = {0};
        if (deflateInit2(&strm, level, Z_DEFLATED, -15, 8, Z_DEFAULT_STRATEGY) != Z_OK) {
            return cc_err(cc_io_error(CC_IO_OTHER));
        }
        strm.next_in = (Bytef*)blk->data.ptr;
        strm.avail_in = (uInt)blk->data.len;
        strm.next_out = out_buf + pos;
        strm.avail_out = (uInt)(max_out - pos - 8);
        
        int ret = deflate(&strm, Z_FINISH);
        pos += strm.total_out;
        deflateEnd(&strm);
        
        if (ret != Z_STREAM_END) return cc_err(cc_io_error(CC_IO_OTHER));
        
        unsigned long crc = res->crc;
        size_t in_len = blk->data.len;
        out_buf[pos++] = crc & 0xff;
        out_buf[pos++] = (crc >> 8) & 0xff;
        out_buf[pos++] = (crc >> 16) & 0xff;
        out_buf[pos++] = (crc >> 24) & 0xff;
        out_buf[pos++] = in_len & 0xff;
        out_buf[pos++] = (in_len >> 8) & 0xff;
        out_buf[pos++] = (in_len >> 16) & 0xff;
        out_buf[pos++] = (in_len >> 24) & 0xff;

        res->data = cc_slice_from_parts(out_buf, pos, CC_SLICE_ID_UNTRACKED);
        cc_atomic_fetch_add(&g_bytes_in, blk->data.len);
        cc_atomic_fetch_add(&g_bytes_out, pos);
        cc_atomic_fetch_add(&g_blocks_done, 1);

        res->arena = res_arena.detach() !>(e) {
            return cc_err(cc_io_error(CC_IO_OTHER));
        };
        return cc_ok(res);
    }
}

int compress_file(const char* in_path, const char* out_path, int level) {
    @errhandler(CCError e) cc_error_exit(e);
    (void)level;
    
    CCFile in_file = cc_file_open(cc_slice_cstr(in_path)) !>(e) {
        eprintln(@string(`Failed to open input: ${in_path}`, @scratch));
        return 1;
    } @destroy;

    CCFile out_file = CC_FILE_CLOSED @destroy;
    out_file.create(cc_slice_cstr(out_path)) !>(e) {
        eprintln(@string(`Failed to open output: ${out_path}`, @scratch));
        return 1;
    };

    /*
     * UNORDERED variant: compression tasks send CompressedResult* directly to
     * a result channel as they finish.  The consumer reads them in arrival
     * order — no head-of-line blocking from ordered_recv.
     *
     * The producer still throttles via a separate semaphore-like counter so
     * we don't spawn all 800 blocks at once (keeps memory bounded at CHAN_CAP
     * in-flight blocks, matching the original).
     */
    CompressedResult*[~CHAN_CAP >] res_tx;
    CompressedResult*[~CHAN_CAP <] res_rx;
    CCChan* res_ch = cc_channel_pair(&res_tx, &res_rx);
    @defer res_ch.free();

    CCFile* in_ptr = &in_file;
    CCFile* out_ptr = &out_file;

    {
    CCNursery consumer = @create() !> @destroy;
    consumer.spawn(() => [out_ptr, res_rx] {
        CompressedResult* r;
        while (cc_chan_recv(res_rx.raw, &r, sizeof(r)) == 0) {
            if (r) {
                (void)out_ptr->write(r->data);
                r->arena.free();
            }
        }
    }) !>;

    CCNursery producer = consumer.create_child() !> @destroy;
    (void)producer.close(res_tx);
    producer.spawn(() => [in_ptr, res_tx] {
        CCNursery workers = @create() !> @destroy;

        long seq = 0;
        while (true) {
            CCArena blk_arena = cc_arena_heap(BLOCK_SIZE + BLOCK_ARENA_OVERHEAD);
            CCSlice data;
            bool !>(CCIoError) read_res = in_ptr->read(blk_arena, BLOCK_SIZE, &data);
            
            if (cc_is_err(read_res) || !cc_io_avail(read_res)) {
                cc_arena_free(&blk_arena);
                break;
            }
            
            Block* blk = cc_arena_alloc_T(Block, blk_arena);
            if (!blk) {
                cc_arena_free(&blk_arena);
                break;
            }
            
            blk->seq = seq++;
            blk->data = data;
            blk->is_last = (data.len < BLOCK_SIZE);
            blk->arena = blk_arena;
            bool is_last = blk->is_last;

            // Spawn compression fiber; it sends result to res_tx directly.
            workers.spawn(() => [blk, res_tx] {
                CompressedResult* !>(CCIoError) res = compress_block(blk, 6);
                cc_arena_free(&blk->arena);
                CompressedResult* r = cc_is_err(res) ? NULL
                                                      : cc_unwrap_as(res, CompressedResult*);
                cc_chan_send(res_tx.raw, &r, sizeof(r));
            }) !>;

            if (is_last) break;
        }
        workers.wait() !>;
    }) !>;
    }

    cc_file_sync(&out_file);
    return 0;
}

int main(int argc, char *argv[]) {
    @errhandler(CCError e) { return cc_err_log(e); }

    if (argc < 2) {
        eprintln(@string(`Usage: ${argv[0]} <file>`, @scratch));
        return 1;
    }

    char[:0] in_path = cc_slice_cstr(argv[1]);
    CCString out_name = @string(`${in_path}.gz`, @scratch);
    if (out_name.failed())
        return cc_err_log(CC_ERROR(CC_ERR_OUT_OF_MEMORY, "output path"));

    int ret = compress_file((const char*)in_path.ptr, cc_string_cstr(&out_name, __cc_str_scratch), 6);

    if (ret == 0) {
        long long bin = (long long)cc_atomic_load(&g_bytes_in);
        long long bout = (long long)cc_atomic_load(&g_bytes_out);
        int blocks = cc_atomic_load(&g_blocks_done);
        @string(`Compressed ${in_path} -> ${out_name} (UNORDERED - output corrupt)`,
                @scratch).println();
        @string(`Stats: ${bin} bytes in, ${bout} bytes out, ${blocks} blocks`,
                @scratch).println();
    }

    return ret;
}

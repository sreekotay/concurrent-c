/*
 * pigz_hybrid.ccs -- Parallel gzip on the V2 hybrid scheduler.
 *
 * Same pipeline shape as pigz_idiomatic.ccs: ordered channel of plain
 * CompressedResult* (NULL from a task means compression failed; the consumer
 * closes the receive side). Tasks use send_task_hybrid so each compression
 * fiber runs on the V2 hybrid scheduler (cc_fiber_spawn_closure0_v2) while
 * CCTask handles still flow through the ordered results channel.
 */

#include <ccc/std/prelude.cch>
#include <ccc/cc_atomic.cch>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <zlib.h>

#define BLOCK_SIZE (128 * 1024)
#define BLOCK_ARENA_OVERHEAD 1024
#define CHAN_CAP 16

typedef struct {
    long seq;
    CCSlice data;
    bool is_last;
    CCArena arena;
} Block;

typedef struct {
    long seq;
    CCSlice data;
    unsigned long crc;
    size_t original_len;
    bool is_last;
    CCArena arena;
} CompressedResult;

cc_atomic_i64 g_bytes_in = 0;
cc_atomic_i64 g_bytes_out = 0;
cc_atomic_int g_blocks_done = 0;
cc_atomic_int g_pipeline_error = 0;

/* Returns NULL on allocation or zlib failure. */
static CompressedResult* compress_block(Block* blk, int level) {
    size_t arena_size = blk->data.len + (blk->data.len >> 3) + 8192;

    CCArena res_arena_storage = @create(arena_size) @destroy;
    if (!res_arena_storage.base) return NULL;
    CCArena* res_arena = &res_arena_storage;
    CompressedResult* res = cc_arena_alloc_T(CompressedResult, res_arena);
    if (!res) return NULL;

    res->seq = blk->seq;
    res->is_last = blk->is_last;
    res->original_len = blk->data.len;
    res->crc = crc32(0UL, (const Bytef*)blk->data.ptr, (uInt)blk->data.len);

    size_t max_out = blk->data.len + (blk->data.len >> 3) + 256;
    unsigned char* out_buf = cc_arena_alloc_T_count(unsigned char, res_arena, max_out);
    if (!out_buf) return NULL;

    unsigned char header[10] = {0x1f, 0x8b, 0x08, 0x00, 0, 0, 0, 0, 0x00, 0x03};
    memcpy(out_buf, header, 10);
    size_t pos = 10;

    z_stream strm = {0};
    if (deflateInit2(&strm, level, Z_DEFLATED, -15, 8, Z_DEFAULT_STRATEGY) != Z_OK) {
        return NULL;
    }
    strm.next_in = (Bytef*)blk->data.ptr;
    strm.avail_in = (uInt)blk->data.len;
    strm.next_out = out_buf + pos;
    strm.avail_out = (uInt)(max_out - pos - 8);

    int ret = deflate(&strm, Z_FINISH);
    pos += strm.total_out;
    deflateEnd(&strm);

    if (ret != Z_STREAM_END) return NULL;
    
    unsigned long crc = res->crc;
    size_t in_len = blk->data.len;
    out_buf[pos++] = crc & 0xff;
    out_buf[pos++] = (crc >> 8) & 0xff;
    out_buf[pos++] = (crc >> 16) & 0xff;
    out_buf[pos++] = (crc >> 24) & 0xff;
    out_buf[pos++] = in_len & 0xff;
    out_buf[pos++] = (in_len >> 8) & 0xff;
    out_buf[pos++] = (in_len >> 16) & 0xff;
    out_buf[pos++] = (in_len >> 24) & 0xff;

    res->data = cc_slice_from_parts(out_buf, pos, CC_SLICE_ID_UNTRACKED, pos);
    cc_atomic_fetch_add(&g_bytes_in, blk->data.len);
    cc_atomic_fetch_add(&g_bytes_out, pos);
    cc_atomic_fetch_add(&g_blocks_done, 1);

    res->arena = res_arena->detach();
    return res;
}

/* Owns `blk` (including blk->arena); frees block storage after compression. */
static CompressedResult* compress_owned_block(Block* blk) {
    CompressedResult* out = compress_block(blk, 6);
    blk->arena.free();
    return out;
}

static bool write_all_or_fail(CCFile* f, CCSlice data, const char* what) {
    CCResult_size_t_CCIoError wr = cc_file_write(f, data);
    if (cc_is_err(wr)) {
        CCIoError err = cc_unwrap_err_as(wr, CCIoError);
        fprintf(stderr, "%s failed kind=%d os=%d\n", what, err.kind, err.os_code);
        cc_atomic_store(&g_pipeline_error, 1);
        return false;
    }
    size_t n = cc_unwrap_as(wr, size_t);
    if (n != data.len) {
        fprintf(stderr, "%s short write %zu/%zu\n", what, n, data.len);
        cc_atomic_store(&g_pipeline_error, 1);
        return false;
    }
    return true;
}

int compress_file(const char* in_path, const char* out_path) {
    cc_atomic_store(&g_pipeline_error, 0);
    
    CCFile in_file;
    if (in_file.open(in_path, "rb") != 0) {
        fprintf(stderr, "Failed to open input: %s\n", in_path);
        return 1;
    }
    @defer in_file.close();

    CCFile out_file;
    if (out_file.open(out_path, "wb") != 0) {
        fprintf(stderr, "Failed to open output: %s\n", out_path);
        return 1;
    }
    @defer out_file.close();

    /* Ordered channel of CompressedResult* (NULL from a task means compress failed). */
    CompressedResult*[~CHAN_CAP >] results_tx;
    CompressedResult*[~CHAN_CAP ordered <] results_rx;
    CCChan* ch = cc_channel_pair(&results_tx, &results_rx);
    @defer ch.free();

    CCFile* in_ptr = &in_file;
    CCFile* out_ptr = &out_file;

    /* Keep the consumer outside the producer scope so results_tx closes when the
     * producer task exits, not later during nursery teardown. */
    CCNursery* consumer = @create(NULL, () => [out_ptr, results_rx] {
        CompressedResult* item = NULL;
        long expect_seq = 0;
        while (cc_io_avail(results_rx.recv(&item))) {
            if (!item) {
                fprintf(stderr, "compress task failed (OOM or zlib error)\n");
                cc_atomic_store(&g_pipeline_error, 1);
                cc_channel_close(results_rx, cc_io_error(CC_IO_OTHER));
                break;
            }
            if (item->seq != expect_seq) {
                fprintf(stderr, "ORDER: expected=%ld got=%ld\n", expect_seq, item->seq);
                cc_atomic_store(&g_pipeline_error, 1);
            }
            expect_seq++;
            if (!write_all_or_fail(out_ptr, item->data, "compressed output")) {
                item->arena.free();
                break;
            }
            item->arena.free();
        }
    }) @destroy;
    if (!consumer) {
        fprintf(stderr, "Failed to create consumer nursery\n");
        return 1;
    }

    CCNursery* producer = @create(consumer) @destroy {
        results_tx.close();
    };
    if (!producer) {
        fprintf(stderr, "Failed to create producer nursery\n");
        return 1;
    }
    producer->spawn(() => [in_ptr, results_tx] {
        long seq = 0;
        while (true) {
            if (cc_atomic_load(&g_pipeline_error)) break;

            CCArena blk_arena = @create(BLOCK_SIZE + BLOCK_ARENA_OVERHEAD) @destroy;
            CCSlice data;
            bool !>(CCIoError) read_res = in_ptr->read(&blk_arena, BLOCK_SIZE, &data);

            if (read_res.is_err() || !cc_io_avail(read_res)) {
                break;
            }

            Block* cap = NULL;
            cap = cc_arena_alloc_T(Block, &blk_arena);
            if (!cap) {
                break;
            }

            cap->seq = seq++;
            cap->data = data;
            cap->is_last = (data.len < BLOCK_SIZE);
            cap->arena = blk_arena.detach();

            bool is_last = cap->is_last;
            /* send_task_hybrid: compression runs on V2 hybrid scheduler; result
             * is still an ordered CCTask on this channel. */
            results_tx.send_task_hybrid(() => [cap] {
                return compress_owned_block(cap);
            });

            if (is_last) break;
        }
    });

    (void)out_file.sync();
    if (cc_atomic_load(&g_pipeline_error)) return 1;
    return 0;
}

int main(int argc, char *argv[]) {
    if (argc < 2) {
        fprintf(stderr, "Usage: %s <file>\n", argv[0]);
        return 1;
    }
    
    char out_name[4096];
    snprintf(out_name, sizeof(out_name), "%s.gz", argv[1]);
    
    int ret = compress_file(argv[1], out_name);
    
    if (ret == 0) {
        printf("Compressed %s -> %s\n", argv[1], out_name);
        printf("Stats: %lld bytes in, %lld bytes out, %d blocks\n",
               (long long)cc_atomic_load(&g_bytes_in),
               (long long)cc_atomic_load(&g_bytes_out),
               cc_atomic_load(&g_blocks_done));
    }
    
    return ret;
}

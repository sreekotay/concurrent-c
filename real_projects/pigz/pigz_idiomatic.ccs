#!ccc ccs
/*
 * pigz_idiomatic.ccs — pigz as the sequential loop, annotated.
 *
 * Read a block, hop the predecessor's 32 KiB tail, deflate, combine CRC,
 * write. `@parallel wait` / `cache` / `@stage`: ../../docs/cheatsheet.md
 */

#include <ccc/std/prelude.cch>
#include <ccc/script/stdio.cch>
#include <limits.h>
#include <stdio.h>
#include <string.h>
#include <unistd.h>
#include <zlib.h>

#define BLOCK_SIZE (128 * 1024)
#define DICT_SIZE  32768
/* zlib uInt is unsigned int. Shadow #if does not see UINT_MAX. */
_Static_assert(BLOCK_SIZE <= UINT_MAX, "BLOCK_SIZE must fit zlib uInt");
_Static_assert((BLOCK_SIZE + (BLOCK_SIZE >> 3) + 1024) <= UINT_MAX,
               "deflate_cap(BLOCK_SIZE) must fit zlib uInt");
/* ~2x the scheduler workers: spare in-flight tickets absorb out-of-order
 * deflate so the ordered write stage never starves a runner. */
#define CAP        32
#define LEVEL      6

static const unsigned char GZIP_HDR[10] = {
    0x1f, 0x8b, 0x08, 0x00, 0, 0, 0, 0, 0x00, 0x03
};

/* Pooled: this header followed by deflate_cap(BLOCK_SIZE) bytes. */
typedef struct {
    CCSlice data;
    unsigned long crc;
    size_t original_len;
} CompressedResult;

/* Reusable deflate state — pigz's deflateReset instead of Init/End per
 * block. cache (zs) gives one per in-flight ticket. */
typedef struct {
    z_stream strm;
    int inited;
} ZState;

static size_t deflate_cap(size_t n) {
    return n + (n >> 3) + 1024;
}

static void !>(CCError) zs_prepare(ZState* zs) {
    z_stream* strm = &zs->strm;
    if (zs->inited && deflateReset(strm) != Z_OK) {
        deflateEnd(strm);
        zs->inited = 0;
    }
    if (!zs->inited) {
        memset(strm, 0, sizeof(*strm));
        if (deflateInit2(strm, LEVEL, Z_DEFLATED, -15, 8,
                         Z_DEFAULT_STRATEGY) != Z_OK)
            return cc_err(CC_ERR_IO, "deflateInit2");
        zs->inited = 1;
    }
    return cc_ok();
}

static unsigned char* !>(CCError) read_block(int in_fd, CCArenaPool* pool,
                                             size_t off, size_t want) {
    unsigned char* buf = (unsigned char*)pool.alloc();
    if (!buf)
        return cc_err(CC_ERR_OUT_OF_MEMORY, "block buf");
    ssize_t got = pread(in_fd, buf, want, (off_t)off);
    if (got < 0 || (size_t)got != want) {
        pool->free(buf);
        return cc_err(CC_ERR_IO, "pread");
    }
    return cc_ok(buf);
}

/* Raw deflate, optional dictionary, Z_SYNC_FLUSH (Z_FINISH on last).
 * The Adler Z_BLOCK splice lives in pigz_cc — not the loop. */
static CompressedResult* !>(CCError) compress_slice(CCSlice data,
        char[:] dict, bool is_last,
        ZState* zs, CCArenaPool* out_pool) {
    @errhandler(CCError e) { return cc_err(e); }
    size_t max_out = deflate_cap((size_t)BLOCK_SIZE);
    if (data.len > (size_t)UINT_MAX || dict.len > (size_t)UINT_MAX ||
        max_out > (size_t)UINT_MAX)
        return cc_err(CC_ERR_INVALID_ARG, "deflate chunk exceeds uInt");
    CompressedResult* res = (CompressedResult*)out_pool.alloc();
    @defer(err) out_pool->free(res);
    if (!res)
        return cc_err(CC_ERR_OUT_OF_MEMORY, "deflate buf");
    unsigned char* out_buf = (unsigned char*)(res + 1);

    res->original_len = data.len;
    res->crc = crc32(0UL, (const Bytef*)data.ptr, (uInt)data.len);

    zs_prepare(zs) !>;
    z_stream* strm = &zs->strm;
    if (dict.len)
        deflateSetDictionary(strm, (const Bytef*)dict.ptr, (uInt)dict.len);

    strm->next_in = (Bytef*)data.ptr;
    strm->avail_in = (uInt)data.len;
    strm->next_out = out_buf;
    strm->avail_out = (uInt)max_out;

    int flush = is_last ? Z_FINISH : Z_SYNC_FLUSH;
    int ret = deflate(strm, flush);
    uInt left = strm->avail_in;
    uInt space = strm->avail_out;
    size_t pos = (size_t)strm->total_out;
    if (flush == Z_FINISH ? (ret != Z_STREAM_END)
                          : (ret != Z_OK || left != 0 || space == 0))
        return cc_err(CC_ERR_IO, "deflate");

    res->data = cc_slice_from_parts(out_buf, pos, CC_SLICE_ID_UNTRACKED);
    return cc_ok(res);
}

static void !>(CCError) write_all(CCFile* f, CCSlice s) {
    @errhandler(CCError e) { return cc_err(e); }
    size_t nw = f->write(s) !>;
    if (nw != s.len)
        return cc_err(CC_ERR_IO, "write");
    return cc_ok();
}

void !>(CCError) compress_file(char[:] in_path, char[:] out_path) {
    @errhandler(CCError e) { return cc_err(e); }

    CCFile in_file;
    if (in_file.open(in_path, "rb") != 0)
        return cc_err(CC_ERR_IO, "Failed to open input");
    @defer in_file.close();

    size_t file_len = in_file.size() !>;
    int in_fd = fileno(in_file.handle);

    CCFile out_file;
    if (out_file.open(out_path, "wb") != 0)
        return cc_err(CC_ERR_IO, "Failed to open output");
    @defer out_file.close();

    /* Empty file is one zero-length ticket, not a zero-byte .gz. */
    size_t n_sz = file_len ? (file_len + (size_t)BLOCK_SIZE - 1) / (size_t)BLOCK_SIZE : 1;
    if (n_sz > (size_t)INT_MAX)
        return cc_err(CC_ERR_INVALID_ARG, "too many blocks");
    int n = (int)n_sz;

    out_file.write(cc_slice_from_buffer((void*)GZIP_HDR, sizeof(GZIP_HDR))) !>;

    CCArena ts_arena = cc_arena_heap(megabytes(2)) @destroy;
    CCTurnstileRW ts@(CAP, ts_arena) !> @destroy;

    CCArenaPool in_pool;
    if (cc_arena_pool(&in_pool, (size_t)BLOCK_SIZE) != 0)
        return cc_err(CC_ERR_OUT_OF_MEMORY, "input pool");
    @defer in_pool.destroy();

    CCArenaPool out_pool;
    if (cc_arena_pool(&out_pool,
            sizeof(CompressedResult) + deflate_cap((size_t)BLOCK_SIZE)) != 0)
        return cc_err(CC_ERR_OUT_OF_MEMORY, "output pool");
    @defer out_pool.destroy();

    /* Loop-carried: dictbuf hops through the read stage (a copied tail,
     * not a view); crc through the write stage. zs is warm scratch. */
    unsigned long crc = crc32(0UL, NULL, 0);
    unsigned long crc_shift = crc32_combine_gen((z_off_t)BLOCK_SIZE);
    unsigned char dictbuf[DICT_SIZE];
    size_t dict_len = 0;
    ZState zs = {0} @destroy {
        if (zs.inited)
            deflateEnd(&zs.strm);
    };

    int i;
    @parallel wait (ts) cache (zs) for (i in 0..n) {
        size_t off = (size_t)i * (size_t)BLOCK_SIZE;
        size_t remain = file_len - off;
        size_t want = remain < (size_t)BLOCK_SIZE ? remain : (size_t)BLOCK_SIZE;
        bool is_last = (off + want >= file_len);

        unsigned char* buf = NULL;
        if (want)
            buf = read_block(in_fd, &in_pool, off, want) !>;
        CCSlice data = buf
            ? cc_slice_from_parts(buf, want, CC_SLICE_ID_UNTRACKED)
            : cc_slice_empty();

        unsigned char take[DICT_SIZE];
        char[:] dict = {0};
        @stage (ts.read, i) {
            size_t dlen = dict_len;          /* consume predecessor's tail */
            if (dlen)
                memcpy(take, dictbuf, dlen);
            dict = cc_slice_from_buffer(take, dlen);
            size_t tail = data.len < (size_t)DICT_SIZE ? data.len
                                                       : (size_t)DICT_SIZE;
            if (tail)
                memcpy(dictbuf, data.ptr + (data.len - tail), tail);
            dict_len = tail;                 /* publish mine for i+1 */
        }

        CompressedResult* r =
            compress_slice(data, dict, is_last, &zs, &out_pool) !>;

        @stage (ts.write, i) {
            size_t len = r->original_len;
            crc = (len == (size_t)BLOCK_SIZE)
                ? crc32_combine_op(crc, r->crc, crc_shift)
                : crc32_combine(crc, r->crc, (long)len);
            write_all(&out_file, r->data) !>;
        }

        if (buf) in_pool.free(buf);
        out_pool.free(r);
    } !>.wait()!>;

    unsigned long isize = (unsigned long)(file_len & 0xffffffffUL);
    unsigned char t[8] = {
        (unsigned char)crc, (unsigned char)(crc >> 8),
        (unsigned char)(crc >> 16), (unsigned char)(crc >> 24),
        (unsigned char)isize, (unsigned char)(isize >> 8),
        (unsigned char)(isize >> 16), (unsigned char)(isize >> 24),
    };
    out_file.write(cc_slice_from_buffer(t, sizeof(t))) !>;

    out_file.sync() !>;
    return cc_ok();
}

int main(int argc, char* argv[]) {
    @errhandler(CCError e) { return cc_err_log(e); }

    if (argc < 2) {
        @string(`Usage: ${argv[0]} <file>`, @scratch).eprintln() !>;
        return 1;
    }

    char[:0] in_path = cc_slice_cstr(argv[1]);
    CCString out_name = @string(`${in_path}.gz`, @scratch);
    if (out_name.failed())
        return cc_err_log(CC_ERROR(CC_ERR_OUT_OF_MEMORY, "output path"));

    compress_file(in_path, out_name.as_slice()) !>;
    @string(`Compressed ${in_path} -> ${out_name}`, @scratch).println() !>;
    return 0;
}

/*
 * pigz_pthread_profile.ccs -- Profiling version of pigz_pthread.
 *
 * Identical to pigz_profile.ccs but uses cc_thread_spawn (OS threads via CCExec)
 * instead of cc_fiber_spawn_task, so we can directly compare queue_wait
 * distributions between the M:N fiber scheduler and the pthread work pool.
 *
 * queue_wait = time from cc_thread_spawn call to when the task actually starts.
 */

#include <ccc/std/prelude.cch>
#include <ccc/cc_atomic.cch>
#include <ccc/stdio.cch>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <time.h>
#include <zlib.h>

#define BLOCK_SIZE (128 * 1024)
#define BLOCK_ARENA_OVERHEAD 1024
#define CHAN_CAP 16

typedef struct {
    long seq;
    CCSlice data;
    bool is_last;
    CCArena arena;
    unsigned long long spawn_ns;
} Block;

typedef struct {
    long seq;
    CCSlice data;
    unsigned long crc;
    size_t original_len;
    bool is_last;
    CCArena arena;
} CompressedResult;

cc_atomic_i64 g_bytes_in = 0;
cc_atomic_i64 g_bytes_out = 0;
cc_atomic_int g_blocks_done = 0;
cc_atomic_i64 g_queue_wait_ns = 0;
cc_atomic_i64 g_compress_ns = 0;
cc_atomic_i64 g_end_to_end_ns = 0;

CompressedResult* !>(CCIoError) compress_block(Block* blk, int level) {
    size_t arena_size = blk->data.len + (blk->data.len >> 3) + 8192;
    
    {
        CCArena res_arena = @create(arena_size) @destroy;
        if (!cc_arena_is_live(res_arena)) return cc_err(cc_io_error(CC_IO_OUT_OF_MEMORY));
        CompressedResult* res = cc_arena_alloc_T(CompressedResult, res_arena);
        if (!res) return cc_err(cc_io_error(CC_IO_OUT_OF_MEMORY));
        
        res->seq = blk->seq;
        res->is_last = blk->is_last;
        res->original_len = blk->data.len;
        res->crc = crc32(0UL, (const Bytef*)blk->data.ptr, (uInt)blk->data.len);

        size_t max_out = blk->data.len + (blk->data.len >> 3) + 256;
        unsigned char* out_buf = cc_arena_alloc_T_count(unsigned char, res_arena, max_out);
        if (!out_buf) return cc_err(cc_io_error(CC_IO_OUT_OF_MEMORY));

        unsigned char header[10] = {0x1f, 0x8b, 0x08, 0x00, 0, 0, 0, 0, 0x00, 0x03};
        memcpy(out_buf, header, 10);
        size_t pos = 10;

        z_stream strm = {0};
        if (deflateInit2(&strm, level, Z_DEFLATED, -15, 8, Z_DEFAULT_STRATEGY) != Z_OK)
            return cc_err(cc_io_error(CC_IO_OTHER));
        strm.next_in  = (Bytef*)blk->data.ptr;
        strm.avail_in = (uInt)blk->data.len;
        strm.next_out = out_buf + pos;
        strm.avail_out = (uInt)(max_out - pos - 8);
        
        int ret = deflate(&strm, Z_FINISH);
        pos += strm.total_out;
        deflateEnd(&strm);
        if (ret != Z_STREAM_END) return cc_err(cc_io_error(CC_IO_OTHER));

        unsigned long crc = res->crc;
        size_t in_len = blk->data.len;
        out_buf[pos++] = crc & 0xff;
        out_buf[pos++] = (crc >> 8) & 0xff;
        out_buf[pos++] = (crc >> 16) & 0xff;
        out_buf[pos++] = (crc >> 24) & 0xff;
        out_buf[pos++] = in_len & 0xff;
        out_buf[pos++] = (in_len >> 8) & 0xff;
        out_buf[pos++] = (in_len >> 16) & 0xff;
        out_buf[pos++] = (in_len >> 24) & 0xff;

        res->data = cc_slice_from_parts(out_buf, pos, CC_SLICE_ID_UNTRACKED);
        cc_atomic_fetch_add(&g_bytes_in, blk->data.len);
        cc_atomic_fetch_add(&g_bytes_out, pos);
        cc_atomic_fetch_add(&g_blocks_done, 1);

        res->arena = res_arena.detach() !>(e) {
            return cc_err(cc_io_error(CC_IO_OTHER));
        };
        return cc_ok(res);
    }
}

typedef struct {
    Block*   blk;
    unsigned long long spawn_ns;
} TaskArg;

void* compress_task_wrapper(void* arg) {
    TaskArg* ta = (TaskArg*)arg;
    Block*   blk = ta->blk;
    unsigned long long spawn_ns = ta->spawn_ns;
    free(ta);

    struct timespec start_ts;
    clock_gettime(CLOCK_MONOTONIC, &start_ts);
    unsigned long long start_ns =
        (unsigned long long)start_ts.tv_sec * 1000000000ULL +
        (unsigned long long)start_ts.tv_nsec;
    CompressedResult* !>(CCIoError) res = compress_block(blk, 6);
    cc_arena_free(&blk->arena);
    struct timespec done_ts;
    clock_gettime(CLOCK_MONOTONIC, &done_ts);
    unsigned long long done_ns =
        (unsigned long long)done_ts.tv_sec * 1000000000ULL +
        (unsigned long long)done_ts.tv_nsec;
    cc_atomic_fetch_add(&g_queue_wait_ns, (long long)(start_ns - spawn_ns));
    cc_atomic_fetch_add(&g_compress_ns, (long long)(done_ns - start_ns));
    cc_atomic_fetch_add(&g_end_to_end_ns, (long long)(done_ns - spawn_ns));

    /* cc_task_result_ptr returns NULL for OS thread tasks; use malloc instead */
    typedef struct { CompressedResult* __result; } __result_t;
    __result_t* storage = (__result_t*)cc_task_result_ptr(sizeof(__result_t));
    if (!storage) storage = (__result_t*)malloc(sizeof(__result_t));
    if (!storage) return NULL;
    storage->__result = cc_is_err(res) ? NULL : cc_unwrap_as(res, CompressedResult*);
    return storage;
}

static void print_stats(const char* label) {
    long blocks = cc_atomic_load(&g_blocks_done);
    if (blocks <= 0) return;
    double qw = (double)cc_atomic_load(&g_queue_wait_ns) / 1000.0 / (double)blocks;
    double comp = (double)cc_atomic_load(&g_compress_ns) / 1000.0 / (double)blocks;
    double e2e = (double)cc_atomic_load(&g_end_to_end_ns) / 1000.0 / (double)blocks;
    println(@string(`\n=== pigz block timing: ${label} (${blocks} blocks) ===`, @scratch)) !>;
    println(@string(`queue_wait avg:   ${qw} us`, @scratch)) !>;
    println(@string(`compress avg:     ${comp} us`, @scratch)) !>;
    println(@string(`end_to_end avg:   ${e2e} us`, @scratch)) !>;
    println(@string(`===`, @scratch)) !>;
}

int compress_file(const char* in_path, const char* out_path, int level) {
    @errhandler(CCError e) { return cc_err_log(e); }
    (void)level;
    cc_atomic_store(&g_queue_wait_ns, 0);
    cc_atomic_store(&g_compress_ns, 0);
    cc_atomic_store(&g_end_to_end_ns, 0);

    CCFile in_file;
    if (cc_file_open(&in_file, cc_slice_cstr(in_path), "rb") != 0) {
        eprintln(@string(`Failed to open input: ${in_path}`, @scratch)) !>; return 1;
    }
    @defer cc_file_close(&in_file);

    CCFile out_file;
    if (cc_file_open(&out_file, cc_slice_cstr(out_path), "wb") != 0) {
        eprintln(@string(`Failed to open output: ${out_path}`, @scratch)) !>; return 1;
    }
    @defer cc_file_close(&out_file);

    CCTask[~CHAN_CAP >] tasks_tx;
    CCTask[~CHAN_CAP <] tasks_rx;
    CCChan* ch = cc_channel_pair(&tasks_tx, &tasks_rx);
    @defer ch.free();

    CCFile* in_ptr = &in_file;
    CCFile* out_ptr = &out_file;

    CCNursery consumer = @create() !> @destroy;
    consumer.spawn(() => [out_ptr, tasks_rx] {
        void* result;
        while (ordered_recv(tasks_rx, &result) == 1) {
            CompressedResult* r = (CompressedResult*)result;
            if (r) {
                cc_file_write(out_ptr, r->data);
                cc_arena_free(&r->arena);
            }
        }
    }) !>;

    CCNursery producer = @create(consumer) !> @destroy {
        chan_close(tasks_tx);
    };
    producer.spawn(() => [in_ptr, tasks_tx] {
        long seq = 0;
        while (true) {
            CCArena blk_arena = cc_arena_heap(BLOCK_SIZE + BLOCK_ARENA_OVERHEAD);
            CCSlice data;
            bool !>(CCIoError) read_res = in_ptr->read(blk_arena, BLOCK_SIZE, &data);
            if (cc_is_err(read_res) || !cc_io_avail(read_res)) {
                cc_arena_free(&blk_arena); break;
            }
            Block* blk = cc_arena_alloc_T(Block, blk_arena);
            if (!blk) { cc_arena_free(&blk_arena); break; }
            blk->seq     = seq++;
            blk->data    = data;
            blk->is_last = (data.len < BLOCK_SIZE);
            blk->arena   = blk_arena;
            bool is_last = blk->is_last;

            TaskArg* ta = (TaskArg*)malloc(sizeof(TaskArg));
            struct timespec spawn_ts;
            clock_gettime(CLOCK_MONOTONIC, &spawn_ts);
            ta->blk = blk;
            ta->spawn_ns =
                (unsigned long long)spawn_ts.tv_sec * 1000000000ULL +
                (unsigned long long)spawn_ts.tv_nsec;

            CCTask task = cc_thread_spawn(compress_task_wrapper, ta);
            cc_chan_send(tasks_tx.raw, &task, sizeof(task));
            if (is_last) break;
        }
    }) !>;

    cc_file_sync(&out_file);
    return 0;
}

int main(int argc, char *argv[]) {
    @errhandler(CCError e) { return cc_err_log(e); }

    if (argc < 2) {
        eprintln(@string(`Usage: ${argv[0]} <file>`, @scratch)) !>;
        return 1;
    }

    char[:0] in_path = cc_slice_cstr(argv[1]);
    CCString out_name = @string(`${in_path}.gz`, @scratch);
    if (out_name.failed())
        return cc_err_log(CC_ERROR(CC_ERR_OUT_OF_MEMORY, "output path"));

    struct timespec t0, t1;
    clock_gettime(CLOCK_MONOTONIC, &t0);
    int rc = compress_file((const char*)in_path.ptr, cc_string_cstr(&out_name, __cc_str_scratch), 6);
    clock_gettime(CLOCK_MONOTONIC, &t1);

    if (rc == 0) {
        (void)t0;
        (void)t1;
        long blocks = cc_atomic_load(&g_blocks_done);
        long long bin = (long long)cc_atomic_load(&g_bytes_in);
        long long bout = (long long)cc_atomic_load(&g_bytes_out);
        eprintln(@string(`Compressed ${in_path} -> ${out_name}`, @scratch)) !>;
        eprintln(@string(`Stats: ${bin} bytes in, ${bout} bytes out, ${blocks} blocks`,
                          @scratch)) !>;
        print_stats("pthread tasks");
    }
    return rc;
}

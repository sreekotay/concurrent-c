#!/usr/bin/env -S ./cc/bin/ccc
/*
 * Regression: module-export (`cc_js_export` / `js_module::[T]`) must
 * compile when the .ccs lives outside the repo tree.  Guards
 * CC_GENERIC_FACTORY harvest via CC_INCLUDE_PATH (not checkout-only
 * `$repo/cc/include` keyed off the source path).
 *
 *   ./tools/out_of_tree_module_smoke.shcc
 *   make out-of-tree-module-smoke
 */

#include <stdio.h>
#include <string.h>
#include <unistd.h>

CCArena a = cc_arena_heap(megabytes(2)) @destroy;

char tmpl[] = "/tmp/cc_oot_mod.XXXXXX";
char* dir = mkdtemp(tmpl);
if (!dir) {
    "FAIL out-of-tree-module-smoke: mkdtemp".eprintln() !>;
    return 1;
}

char dst_path[512];
snprintf(dst_path, sizeof(dst_path), "%s/ic_mod.ccs", dir);

{
    CCResult_bool_CCError cp = cc_file_copy(
        @slice("tests/out_of_tree_module_mod.ccs"),
        char_to_slice_n(dst_path, strlen(dst_path)), &a);
    if (!cp.ok) {
        "FAIL out-of-tree-module-smoke: copy".eprintln() !>;
        rmdir(dir);
        return 1;
    }
}

unlink("bin/ic_counter.node"); /* stale from a prior run */

{
    CCCommand build = cc_command(a, @slice("./cc/bin/ccc"));
    build.arg("build");
    build.arg(dst_path); /* absolute path outside the tree */
    build.stderr_to_stdout();
    CCProcessOutput out = build.output(&a) !>;
    int rc = out.exit_code();
    if (rc != 0) {
        CCString em = @string(
            `FAIL out-of-tree-module-smoke: ccc build exited ${rc}`, &a);
        em.eprintln() !>;
        if (out.stdout_data.ptr && out.stdout_data.len)
            fwrite(out.stdout_data.ptr, 1, out.stdout_data.len, stderr);
        unlink(dst_path);
        return 1;
    }
}

/* Checkout `ccc` places the artifact under the repo's bin/. */
if (access("bin/ic_counter.node", F_OK) != 0) {
    "FAIL out-of-tree-module-smoke: missing bin/ic_counter.node".eprintln() !>;
    unlink(dst_path);
    return 1;
}

unlink(dst_path);
unlink("bin/ic_counter.node");
"OK out-of-tree-module-smoke".println() !>;
return 0;

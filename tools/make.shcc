#!/usr/bin/env -S ./cc/bin/ccc
/*
 * Make-facing check tasks (small, one job each).
 *
 *   ./tools/make.shcc @                 - list tasks
 *   ./tools/make.shcc @examples_check
 *   ./tools/make.shcc @stress_check
 *   ./tools/make.shcc @perf_check
 *
 * Make:  make examples-check / stress-check / perf-check
 */

static int run_all_flag(const char* flag) {
    CCArena arena = @create(megabytes(1)) @destroy;

    /* Exact CCIoError keeps os_code; CCError covers other Results. */
    @errhandler(CCError e) {
        CCString em = @string(
            `  failed: ${cc_error_str(e)} (kind=${(int)e.kind})`, arena);
        (void)em.eprintln();
        return 1;
    }
    @errhandler(CCIoError e) {
        CCString em = @string(
            `  failed: ${cc_io_error_str(e)} (kind=${(int)e.base.kind} os=${(int)e.os_code})`, arena);
        (void)em.eprintln();
        return 1;
    }

    CCCommand cmd = cc_command(arena, @slice("./cc/bin/ccc"));
    cmd.arg("run");
    cmd.arg("tools/run_all.ccs");
    cmd.arg("--");
    cmd.arg(flag);
    cmd.inherit_stdio();
    return cmd.status() !>;
}

/**
 * @task Compile-check top-level examples (--emit-c-only).
 */
static int examples_check() {
    CCArena arena = @create(megabytes(1)) @destroy;

    @errhandler(CCError e) {
        CCString em = @string(
            `  failed: ${cc_error_str(e)} (kind=${(int)e.kind})`, arena);
        (void)em.eprintln();
        return 1;
    }
    @errhandler(CCIoError e) {
        CCString em = @string(
            `  failed: ${cc_io_error_str(e)} (kind=${(int)e.base.kind} os=${(int)e.os_code})`, arena);
        (void)em.eprintln();
        return 1;
    }

    int failed = 0;

    "=== Checking examples compile ===".println();
    CCSliceArray files = cc_glob(@slice("examples/*.ccs"), arena) !>;
    for (size_t i = 0; i < files.len(); i++) {
        char[:0] path = files.get(i);

        CCCommand cmd = cc_command(arena, @slice("./ccc"));
        cmd.arg("--emit-c-only");
        cmd.arg_slice(path);
        cmd.arg("-o");
        cmd.arg("/dev/null");
        int rc = cmd.status() !>;
        CCString line = @string(`  ${path}  ${(rc == 0) ? "OK" : "FAIL"}`, arena);
        line.println();
        if (rc != 0) failed++;
    }

    if (failed > 0 || files.len() == 0) {
        @string(`${failed} example(s) failed`, arena).println();
        return 1;
    }
    "All examples OK".println();
    return 0;
}

/**
 * @task Run stress suite (timeouts/policies in tools/run_all.ccs).
 */
static int stress_check() {
    return run_all_flag("--stress");
}

/**
 * @task Run perf suite (timeouts/policies in tools/run_all.ccs).
 */
static int perf_check() {
    return run_all_flag("--perf");
}

"make: use @examples_check, @stress_check, @perf_check (or @ to list)".println();
return 2;

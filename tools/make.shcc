#!/usr/bin/env -S ./cc/bin/ccc
/*
 * Make-facing check tasks (small, one job each).
 *
 *   ./tools/make.shcc @                 - list tasks
 *   ./tools/make.shcc @examples_check
 *   ./tools/make.shcc @stress_check
 *   ./tools/make.shcc @perf_check
 *
 * Make:  make examples-check / stress-check / perf-check
 */

static int run_all_flag(const char* flag) {
    CCArena a = @create(megabytes(1)) @destroy;

    /* CCError catches cmd.status() (CCIoError) via @as face. */
    @errhandler(CCError e) {
        (void)cc_eprintln(@string(
            `  failed: ${cc_io_error_str(cc_io_error(e))} (kind=${(int)e.kind})`, &a));
        return 1;
    }

    CCCommand cmd = cc_command(&a, @slice("./cc/bin/ccc"));
    cmd.arg("run");
    cmd.arg("tools/run_all.ccs");
    cmd.arg("--");
    cmd.arg(flag);
    cmd.inherit_stdio();
    return cmd.status() !>;
}

/**
 * @task Compile-check top-level examples (--emit-c-only).
 */
static int examples_check() {
    CCArena a = @create(megabytes(1)) @destroy;

    /* One handler: println/glob are CCError; cmd.status is CCIoError @as. */
    @errhandler(CCError e) {
        (void)cc_eprintln(@string(
            `  failed: ${cc_io_error_str(cc_io_error(e))} (kind=${(int)e.kind})`, &a));
        return 1;
    }

    int failed = 0;

    cc_println("=== Checking examples compile ===") !>;
    CCSliceArray files = cc_glob(@slice("examples/*.ccs"), &a) !>;
    for (size_t i = 0; i < files.len(); i++) {
        char[:0] path = files.get(i);

        CCCommand cmd = cc_command(&a, @slice("./ccc"));
        cmd.arg("--emit-c-only");
        cmd.arg_slice(path);
        cmd.arg("-o");
        cmd.arg("/dev/null");
        int rc = cmd.status() !>;
        CCString line = @string(`  ${path}  ${(rc == 0) ? "OK" : "FAIL"}`, &a);
        line.println() !>;
        if (rc != 0) failed++;
    }

    if (failed > 0 || files.len() == 0) {
        cc_println(@string(`${failed} example(s) failed`, &a)) !>;
        return 1;
    }
    cc_println("All examples OK") !>;
    return 0;
}

/**
 * @task Run stress suite (timeouts/policies in tools/run_all.ccs).
 */
static int stress_check() {
    return run_all_flag("--stress");
}

/**
 * @task Run perf suite (timeouts/policies in tools/run_all.ccs).
 */
static int perf_check() {
    return run_all_flag("--perf");
}

cc_println("make: use @examples_check, @stress_check, @perf_check (or @ to list)") !>;
return 2;

#!/usr/bin/env -S ./cc/bin/ccc
/*
 * Make-facing check tasks (small, one job each).
 *
 *   ./tools/make.shcc @                 - list tasks
 *   ./tools/make.shcc @examples_check
 *
 * Make:  make examples-check
 */

/**
 * @task Compile-check top-level examples (--emit-c-only).
 */
static int examples_check() {
    CCArena a = @create(megabytes(1)) @destroy;
    CCStdio io = @create(&a) @destroy;

    @errhandler(CCIoError e) {
        fprintf(stderr, "  spawn failed: %s (os=%d)\n",
                cc_io_error_str(e), e.os_code);
        return 1;
    }

    int failed = 0;

    io.println(@slice("=== Checking examples compile ===")) !>;
    CCSliceArray files = cc_glob(@slice("examples/*.ccs"), &a);
    for (size_t i = 0; i < files.len(); i++) {
        char[:0] path = files.get(i);

        CCCommand cmd = cc_command(&a, @slice("./ccc"));
        cmd.arg("--emit-c-only");
        cmd.arg_slice(path);
        cmd.arg("-o");
        cmd.arg("/dev/null");
        int rc = cmd.status() !>;
        CCString line = @string(`  ${path}  ${(rc == 0) ? "OK" : "FAIL"}`, &a);
        io.println(line.as_slice()) !>;
        if (rc != 0) failed++;
    }

    if (failed > 0) {
        CCString line = @string(`${failed} example(s) failed`, &a);
        io.println(line.as_slice()) !>;
        return 1;
    }
    io.println(@slice("All examples OK")) !>;
    return 0;
}

io.println(@slice("make: use @examples_check (or @ to list)")) !>;
return 2;

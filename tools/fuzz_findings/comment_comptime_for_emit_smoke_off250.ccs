#include <ccc/std/prelude.cch>
#include <ccc/cc_instantiate.cch>
#include <stdio.h>

typedef struct { int a; double b; } PairFields;

/* field slot emit smoke: @comptime for unrolls ${f.index} into @emit templates. */

int main(void) {
    @comptime /*x*/for (f in type_of(PairFields).fields) {
        @emit(CC_EMIT_AFTER_PRELUDE, `
            enum { PairFields_slot_${f.index} = ${f.index} };
        `);
    }

    if (PairFields_slot_0 != 0) return 1;
    if (PairFields_slot_1 != 1) return 2;
    printf("comptime_for_emit_smoke ok\n");
    return 0;
}

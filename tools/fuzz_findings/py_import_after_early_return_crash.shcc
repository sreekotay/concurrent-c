#include <ccc/script/py.cch>
CCPy py = cc_py(&a) !> @destroy;
CCPyObj b = py.import("builtins") !> @destroy;

/* edges: huge int past int64, unicode, embedded NUL, empty, big payload */
int64_t big = b.int("9223372036854775808") !>(e) { println("big: rejected") !>; return 0; };
println(@string(`big=${big}`, &a)) !>;
CCSlice uni = b.str("héllo→")!>.as_slice()!>;
println(@string(`uni=${uni}`, &a)) !>;
CCSlice emb = b.str("a\0b")!>.as_slice()!>;
println(@string(`emb_len=${emb.len}`, &a)) !>;
CCPyObj json = py.import("json") !> @destroy;

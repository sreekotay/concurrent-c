/* Smoke: UFCS on CallExpr receivers (make_bool(true).is_err()). */
#include <ccc/std/prelude.cch>
#include <stdio.h>

static bool !>(CCError) make_bool(bool v) {
    if (!v) return cc_err(CC_ERR_NOT_FOUND, "false requested");
    return cc_ok(true);
}

int main(void) {
    if (make_bool(true).is_err()) return 1;
    if (!make_bool(false).is_err()) return 2;
    if (make_bool(true).is_ok/*x*/() != 1) return 3;
    printf("ufcs_rvalue_receiver_smoke: PASS\n");
    return 0;
}

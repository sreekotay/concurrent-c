/*
 * Run all examples, stress tests, or perf benchmarks.
 *
 * Usage:
 *   ccc run tools/run_all.ccs -- --examples   # run all examples
 *   ccc run tools/run_all.ccs -- --stress     # run all stress tests (10s timeout)
 *   ccc run tools/run_all.ccs -- --perf       # run all perf benchmarks
 *   ccc run tools/run_all.ccs -- --all        # run everything
 *
 * Make targets `stress-check` / `perf-check` thin-wrap --stress / --perf.
 * Compile-only `examples-check` stays a small Make recipe (not this tool).
 *
 * Pick one (or more) categories — --stress is what usually panics:
 *   ccc run tools/run_all.ccs -- --trace --stream --stress
 *
 * Add --trace to write a per-test-boundary log that is fflush+fsynced after
 * every START/END marker. Add --stream to inherit child stdout/stderr.
 */

#include <ccc/std/prelude.cch>
#include <ccc/std/cli.cch>
#include <ccc/std/exec.cch>
#include <unistd.h>
#include <sys/time.h>
#include <stdio.h>
#include <errno.h>
#include <string.h>
#include <stdarg.h>

#define STRESS_TIMEOUT_SEC 10
#define PERF_TIMEOUT_SEC 20

typedef struct {
    int passed;
    int failed;
    int skipped;
} Stats;

/* expected_exit: -1 skip; otherwise required exit code.
 * timeout_sec: 0 keep category default; else override.
 * extra_args: NULL-terminated argv after `--`, or NULL.
 * ccc_args: NULL-terminated extra `ccc run` flags before the path, or NULL. */
typedef struct {
    const char* needle;
    int expected_exit;
    int timeout_sec;
    const char* const* extra_args;
    const char* const* ccc_args;
} RunPolicy;

static const char* LOG_DIR = "tmp/run_all_logs";
static const char* TRACE_PATH = "tmp/run_all_logs/run_trace.log";
static const char* MEM_SAMPLE_O = "stress/out/mem_sample.o";

static FILE* g_trace = NULL;

static const char* TCP_ECHO_ARGS[] = { "--test", NULL };
static const char* MEM_SAMPLE_CCC_ARGS[] = { "--ld-flags", "stress/out/mem_sample.o", NULL };

/* First match wins. Keep comments next to the rows that need them. */
static const RunPolicy RUN_POLICIES[] = {
    /* Servers / long-lived listeners — not self-contained under the runner. */
    { "ping_server", -1, 0, NULL, NULL },

    /* MACHINE-CRASHER under aggregate load: multi-million spawn/join pressure
     * has paniced macOS Mach VM / pthread limits. See git history on this row. */
    { "perf_spawn_ladder", -1, 0, NULL, NULL },

    /* Deadlock demos abort with exit 124 by design (sched_v2). */
    { "deadlock_detect_demo", 124, 0, NULL, NULL },
    { "complex_deadlock", 124, 0, NULL, NULL },

    /* Shared-object recipes / Node addons: `ccc build` → *.abi3.so / *.node. */
    { "recipe_py_module", -1, 0, NULL, NULL },
    { "recipe_js_module", -1, 0, NULL, NULL },
    { "js_baseline", -1, 0, NULL, NULL },
    { "js_numpy", -1, 0, NULL, NULL },

    /* Host-C mem_sample.o (platform #if) — link via --ld-flags. */
    { "arena_mixed_lifetime_split_bench", 0, 0, NULL, MEM_SAMPLE_CCC_ARGS },
    { "arena_mixed_lifetime_bench", 0, 0, NULL, MEM_SAMPLE_CCC_ARGS },
    { "arena_lifetime_chaos", 0, 0, NULL, MEM_SAMPLE_CCC_ARGS },

    /* Slower under the full "all" aggregate load. */
    { "join_init_race", 0, 20, NULL, NULL },
    { "block_combinators_stress", 0, 20, NULL, NULL },
    { "cancellation_race_storm", 0, 30, NULL, NULL },
    /* mem_stress ~21s standalone; under full --perf load it can exceed 40s. */
    { "mem_stress", 0, 90, NULL, NULL },

    /* Self-testable recipe: opt into deterministic --test mode. */
    { "recipe_tcp_echo", 0, 0, TCP_ECHO_ARGS, NULL },
};

static long long epoch_ms(void) {
    struct timeval tv;
    gettimeofday(&tv, NULL);
    return (long long)tv.tv_sec * 1000LL + (long long)tv.tv_usec / 1000LL;
}

static void trace_write(const char* fmt, ...) {
    if (!g_trace) return;
    va_list ap;
    fprintf(g_trace, "[%lld] ", epoch_ms());
    va_start(ap, fmt);
    vfprintf(g_trace, fmt, ap);
    va_end(ap);
    fputc('\n', g_trace);
    fflush(g_trace);
    (void)fsync(fileno(g_trace));
}

static inline CCSlice slice_cstr(const char* s) {
    return cc_slice_from_buffer((void*)s, s ? strlen(s) : 0);
}

static const RunPolicy* policy_for(const char* path) {
    for (size_t i = 0; i < sizeof(RUN_POLICIES) / sizeof(RUN_POLICIES[0]); i++) {
        if (strstr(path, RUN_POLICIES[i].needle) != NULL) return &RUN_POLICIES[i];
    }
    return NULL;
}

static void ensure_log_dir(CCArena* arena) {
    CCCommand cmd = cc_command(arena, "mkdir");
    cmd.arg("-p");
    cmd.arg(LOG_DIR);
    (void)cmd.status();
}

/* Host-compile stress/mem_sample.c — #if stays out of shadow_lower. */
static int ensure_mem_sample_o(CCArena* arena) {
    CCCommand mkdir = cc_command(arena, "mkdir");
    mkdir.arg("-p");
    mkdir.arg("stress/out");
    (void)mkdir.status();

    CCCommand cc = cc_command(arena, "cc");
    cc.arg("-O2");
    cc.arg("-std=c11");
    cc.arg("-c");
    cc.arg("stress/mem_sample.c");
    cc.arg("-o");
    cc.arg(MEM_SAMPLE_O);
    CCResult_int_CCIoError st = cc.status();
    if (cc_is_err(st)) {
        fprintf(stderr, "run_all: cannot spawn cc for %s\n", MEM_SAMPLE_O);
        return 0;
    }
    if (cc_unwrap(st) != 0) {
        fprintf(stderr, "run_all: failed to build %s\n", MEM_SAMPLE_O);
        return 0;
    }
    return 1;
}

static const char* log_path_for(CCArena* arena, const char* path, const char* suffix) {
    CCSlice base = cc_path_basename(arena, slice_cstr(path));
    const char* base_cstr = base.ptr ? (const char*)base.ptr : "unknown";
    CCString full = @string(`${LOG_DIR}/${base_cstr}${suffix}`, arena);
    return full.cstr(arena);
}

static void write_log(CCArena* arena, const char* path, const char* suffix,
                      const char* data, size_t len) {
    if (!data || len == 0) return;
    const char* full_path = log_path_for(arena, path, suffix);
    if (!full_path) return;

    CCFile f;
    if (cc_file_open(&f, cc_slice_cstr(full_path), "w") != 0) return;
    CCSlice slice = cc_slice_from_parts((void*)data, len, CC_SLICE_ID_UNTRACKED);
    (void)cc_file_write(&f, slice);
    cc_file_close(&f);
}

static void write_process_logs(CCArena* arena, const char* path, const CCProcessOutput* out) {
    if (!out) return;
    write_log(arena, path, ".stdout.txt", (const char*)out->stdout_data.ptr, out->stdout_data.len);
    write_log(arena, path, ".stderr.txt", (const char*)out->stderr_data.ptr, out->stderr_data.len);
}

static void print_process_log_paths(CCArena* arena, const char* path) {
    const char* stdout_path = log_path_for(arena, path, ".stdout.txt");
    const char* stderr_path = log_path_for(arena, path, ".stderr.txt");
    CCString line = @string(`    logs: ${stdout_path}, ${stderr_path}\n`, arena);
    const char* p = line.cstr(arena);
    if (p) fputs(p, stdout);
}

static void print_process_output_excerpt(const CCProcessOutput* out) {
    if (!out) return;
    CCSlice stdout_data = out->stdout_data;
    CCSlice stderr_data = out->stderr_data;
    if (stdout_data.len > 0 && stdout_data.ptr) {
        int n = (int)(stdout_data.len > 200 ? 200 : stdout_data.len);
        printf("    stdout: %.*s", n, (const char*)stdout_data.ptr);
        if (stdout_data.len > 200) printf("...(truncated)");
        printf("\n");
    }
    if (stderr_data.len > 0 && stderr_data.ptr) {
        int n = (int)(stderr_data.len > 200 ? 200 : stderr_data.len);
        printf("    stderr: %.*s", n, (const char*)stderr_data.ptr);
        if (stderr_data.len > 200) printf("...(truncated)");
        printf("\n");
    }
    if (stdout_data.len == 0 && stderr_data.len == 0) {
        printf("    (no output captured)\n");
    }
}

static void record_outcome(Stats* stats, const char* path, int exit_code, int expected_exit,
                           int timeout_sec, CCArena* log_arena, const CCProcessOutput* out) {
    if (exit_code == expected_exit) {
        printf("OK%s\n", expected_exit != 0 ? " (expected failure)" : "");
        stats->passed++;
    } else if (exit_code == 124 && expected_exit != 124) {
        printf("TIMEOUT (>%ds)\n", timeout_sec);
        if (out) {
            write_process_logs(log_arena, path, out);
            print_process_log_paths(log_arena, path);
        }
        stats->failed++;
    } else {
        printf("FAIL (exit %d, expected %d)\n", exit_code, expected_exit);
        if (out) {
            print_process_output_excerpt(out);
            write_process_logs(log_arena, path, out);
            print_process_log_paths(log_arena, path);
        }
        stats->failed++;
    }
    fflush(stdout);
    trace_write("END   %s rc=%d expected=%d", path, exit_code, expected_exit);
}

static void run_files(CCArena* arena, const char* pattern, const char* label, Stats* stats,
                      int timeout_sec, bool stream_output, bool release) {
    printf("\n=== %s ===\n", label);
    ensure_log_dir(arena);

    CCSliceArray files = cc_glob(cc_slice_cstr(pattern), arena) !>(e) {
        printf("  glob failed for %s: %s (os=%d)\n", pattern,
               cc_io_error_str(e), (int)e.os_code);
        stats->failed++;
        return;
    };
    size_t n = files.len();
    if (n == 0) {
        printf("  (no files matching %s)\n", pattern);
        return;
    }

    for (size_t i = 0; i < n; i++) {
        const char* path = (const char*)files.get(i).ptr;
        const RunPolicy* pol = policy_for(path);
        int expected_exit = pol ? pol->expected_exit : 0;
        int timeout_for_file = (pol && pol->timeout_sec > 0) ? pol->timeout_sec : timeout_sec;
        const char* const* extra = (pol && pol->extra_args) ? pol->extra_args : NULL;
        const char* const* ccc_args = (pol && pol->ccc_args) ? pol->ccc_args : NULL;

        if (expected_exit == -1) {
            printf("  [%zu/%zu] %s ... SKIP (policy)\n", i + 1, n, path);
            stats->skipped++;
            continue;
        }

        printf("  [%zu/%zu] %s ... ", i + 1, n, path);
        fflush(stdout);
        trace_write("START [%zu/%zu] %s (timeout=%ds)", i + 1, n, path, timeout_for_file);

        usleep(1000); /* brief gap to reduce resource contention */

        CCArena test_arena = cc_arena_heap(megabytes(4)) @destroy;
        CCCommand cmd = cc_command(&test_arena, "./ccc");
        cmd.arg("run");
        cmd.arg_if(release, "--release");
        cmd.arg_if(timeout_for_file > 0, "--timeout");
        cmd.arg_i32_if(timeout_for_file > 0, timeout_for_file);
        if (ccc_args) {
            for (size_t k = 0; ccc_args[k] != NULL; k++) cmd.arg(ccc_args[k]);
        }
        cmd.arg(path);
        if (extra) {
            cmd.arg("--");
            for (size_t k = 0; extra[k] != NULL; k++) cmd.arg(extra[k]);
        }

        if (stream_output) {
            cmd.inherit_stdio();
            CCResult_int_CCIoError status = cmd.status();
            if (cc_is_err(status)) {
                CCIoError err = cc_unwrap_err_as(status, CCIoError);
                printf("SKIP (spawn error: %s, os=%d)\n", cc_io_error_str(err), err.os_code);
                fflush(stdout);
                trace_write("END   %s SKIP (spawn error os=%d)", path, err.os_code);
                stats->skipped++;
                continue;
            }
            record_outcome(stats, path, cc_unwrap(status), expected_exit, timeout_for_file,
                           &test_arena, NULL);
            continue;
        }

        CCResult_CCProcessOutput_CCIoError res = cmd.output(&test_arena);
        if (cc_is_err(res)) {
            CCIoError err = cc_unwrap_err_as(res, CCIoError);
            printf("SKIP (spawn error: %s, os=%d)\n", cc_io_error_str(err), err.os_code);
            fflush(stdout);
            trace_write("END   %s SKIP (spawn error os=%d)", path, err.os_code);
            stats->skipped++;
            continue;
        }

        CCProcessOutput out = cc_unwrap_as(res, CCProcessOutput);
        record_outcome(stats, path, out.exit_code(), expected_exit, timeout_for_file,
                       &test_arena, &out);
    }
}

@grammar(cli) RunAllOpts {~~~~
    help: flag -h, --help desc "Show this help"
    examples: flag --examples desc "Run all example programs"
    stress: flag --stress desc "Run all stress tests"
    perf: flag --perf desc "Run all performance benchmarks"
    all: flag --all desc "Run everything"
    trace: flag --trace desc "Hard-flushed trace log at tmp/run_all_logs/run_trace.log"
    stream: flag --stream desc "Stream per-test stdout/stderr to the terminal"
~~~~}

int main(int argc, char** argv) {
    CCArena arena = cc_arena_heap(megabytes(16)) @destroy;

    RunAllOpts opts = {0};
    {
        bool go = cc_prepare_args(RunAllOpts, argc, argv, &arena, &opts, stderr) !>(e) {
            (void)e;
            return 2;
        };
        if (!go) return 0; /* --help */
    }

    bool do_examples = opts.examples;
    bool do_stress = opts.stress;
    bool do_perf = opts.perf;
    bool do_all = opts.all;
    bool do_trace = opts.trace;
    bool do_stream = opts.stream;
    if (do_all) {
        do_examples = true;
        do_stress = true;
        do_perf = true;
    }
    if (!do_examples && !do_stress && !do_perf) {
        fprintf(stderr, "Select at least one category.\n");
        cc_print_usage(RunAllOpts, stderr, argv[0]);
        return 1;
    }

    Stats stats = {0};

    if (do_trace || do_stream) setvbuf(stdout, NULL, _IONBF, 0);

    if (do_trace) {
        ensure_log_dir(&arena);
        g_trace = fopen(TRACE_PATH, "a");
        if (!g_trace) {
            fprintf(stderr, "run_all: cannot open trace file %s: %s\n",
                    TRACE_PATH, strerror(errno));
            return 1;
        }
        trace_write("SESSION start pid=%d examples=%d stress=%d perf=%d",
                    (int)getpid(), do_examples, do_stress, do_perf);
        CCString tip = @string(`Trace log: ${TRACE_PATH} (fsynced per test)\n`, &arena);
        const char* tip_cstr = tip.cstr(&arena);
        if (tip_cstr) fputs(tip_cstr, stdout);
    }

    printf("Concurrent-C Test Runner\n");

    if (do_examples) {
        run_files(&arena, "examples/*.ccs", "Examples", &stats, 0, do_stream, false);
    }
    if (do_stress) {
        if (!ensure_mem_sample_o(&arena)) return 1;
        run_files(&arena, "stress/*.ccs", "Stress Tests", &stats, STRESS_TIMEOUT_SEC, do_stream,
                  false);
    }
    if (do_perf) {
        /* Always --release: debug lock/serial numbers are not comparable. */
        run_files(&arena, "perf/*.ccs", "Performance Benchmarks", &stats, PERF_TIMEOUT_SEC, true,
                  true);
    }

    printf("\n=== Summary ===\n");
    printf("  Passed:  %d\n", stats.passed);
    printf("  Failed:  %d\n", stats.failed);
    printf("  Skipped: %d\n", stats.skipped);
    printf("  Total:   %d\n", stats.passed + stats.failed + stats.skipped);

    if (g_trace) {
        trace_write("SESSION end passed=%d failed=%d skipped=%d",
                    stats.passed, stats.failed, stats.skipped);
        fclose(g_trace);
        g_trace = NULL;
    }

    return stats.failed > 0 ? 1 : 0;
}

#!/usr/bin/env -S ./cc/bin/ccc
/*
 * Make-facing task runner for everyday repo chores.
 *
 *   ./tools/dev.shcc @                 - list tasks
 *   ./tools/dev.shcc @fmt
 *   ./tools/dev.shcc @lint
 *   ./tools/dev.shcc @lint_scanners
 *   ./tools/dev.shcc @lint_soft_return_emit
 *   ./tools/dev.shcc @check_submodules
 */

/**
 * @task clang-format -i under cc/ (no-op if clang-format missing).
 */
static int fmt(int argc, char **argv) {
    return cc_script_task_exe(argc, argv, "scripts/format.sh");
}

/**
 * @task clang-format --dry-run --Werror under cc/.
 */
static int lint(int argc, char **argv) {
    return cc_script_task_exe(argc, argv, "scripts/lint.sh");
}

/**
 * @task Scanner-hygiene ratchet (hand-rolled comment/string machines).
 */
static int lint_scanners(int argc, char **argv) {
    return cc_script_task_shcc(argc, argv, "tools/lint_scanners.shcc");
}

/**
 * @task Soft-return / watermark emit-shape ratchet (spec §5.1).
 */
static int lint_soft_return_emit(int argc, char **argv) {
    return cc_script_task_exe(argc, argv, "scripts/lint_soft_return_emit.sh");
}

/**
 * @task Ensure git submodules are reachable / present.
 */
static int check_submodules(int argc, char **argv) {
    return cc_script_task_exe(argc, argv, "scripts/check_submodule_reachability.sh");
}

/**
 * @task Comment-insertion fuzzer: an inserted comment must not change behavior.
 */
static int fuzz_comment(int argc, char **argv) {
    return cc_script_task_shcc(argc, argv, "tools/fuzz_comment_insert.shcc");
}

/**
 * @task Mutation fuzzer: no input may crash the compiler or hit internal errors.
 */
static int fuzz_mutate(int argc, char **argv) {
    return cc_script_task_shcc(argc, argv, "tools/fuzz_mutate.shcc");
}

"dev: use @fmt, @lint, @lint_scanners, @lint_soft_return_emit, @check_submodules, @fuzz_comment, or @fuzz_mutate (or @ to list)".println() !>;
return 2;

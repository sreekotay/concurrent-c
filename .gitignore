*~

# Stray artifacts from misfired compiler invocations
# (e.g. `cc -o --` leaving a `--` binary, or `gcc -E` writing an `-E` file)
/--
-E
/build/
/dist/
/out/
cc/bin/
out/
/bin/
/tmp/

# Generated from third_party/jackson-allan-cc/cc.h (see scripts/cc_vendor_jackson_namespace.py)
third_party/jackson-allan-cc/cc_for_ccc.h

tools/cc_test
tools/toolbox.shcc

# Claude Code agent worktrees / session-local state
.claude/

# Stray build droppings from in-tree compiles
.cc-build/
*.c.diag
*.c.diag.*.tmp

# Accidental root lowered-C probes (c2.ccs → c2.c)
/c[0-9].c
/c[0-9][0-9].c

# cc-python package products (prepare-publish.sh regenerates)
npm/cc-python/bin/
npm/cc-python/vendor/

# python package build products
pypi/cc-node/build/
pypi/cc-node/*.egg-info/
__pycache__/

# Python virtual environments
venv/
.venv/

# VS Code / Cursor extension packages
*.vsix

# Upstream QuickJS — attach locally; CC does not vendor it
/quickjs/


/* Safety pass: `?>` protects @variant arm projection. */
#include <ccc/std/prelude.cch>
#include <stdint.h>

@variant RedisValue {
    txt: const char*;
    num: int64_t;
};

int main(void) {
    RedisValue v = { .num = 42 };
    RedisValue s = { .txt = "7" };
    int64_t a = v.num ?> -1;
    int64_t b = s.num ?> -1;
    RedisValue* p = &s;
    int64_t d = p->num ?> -9;
    const char* t = p->txt ?> "fallback";
    if (a != 42) return 1;
    if (b != -1) return 2;
    if (d != -9) return 3;
    if (t[0] != '7') return 4;
    return 0;
}

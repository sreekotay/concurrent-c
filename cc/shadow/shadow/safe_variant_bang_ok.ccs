/* Safety pass: `!>` protects @variant arm projection. */
#include <ccc/std/prelude.cch>
#include <stdint.h>

@variant RedisValue {
    txt: const char*;
    num: int64_t;
};

static int64_t read_num(RedisValue* cell) {
    int64_t v = cell->num !> { return -1; };
    return v;
}

int main(void) {
    RedisValue v = { .num = 42 };
    RedisValue s = { .txt = "abc" };
    int64_t a = v.num !> { return 1; };
    int64_t b = s.num !> { return -1; };
    if (read_num(&v) != 42) return 2;
    if (a != 42) return 3;
    if (b != -1) return 4;
    return 0;
}

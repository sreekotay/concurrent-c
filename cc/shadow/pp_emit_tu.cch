/* Emit: TU product — typedefs, Result specs, file-level switch.
 * Included from pp_emit_stmt.cch (after stmt/destroy helpers). */
#pragma once

/* True when a typedef-struct field type is a Map_/ArrayMap_/CCVec_ product
 * (pointer ok). Those DECL macros are emitted after the factory-hoist pass;
 * hoisting the enclosing struct early leaves an unknown type name. */
static int shadow_ty_is_generic_container(const char* ty) {
    const char* p;
    char base[128];
    size_t n;
    if (!ty || !ty[0]) return 0;
    while (*ty == ' ' || *ty == '\t') ty++;
    n = 0;
    while (ty[n] && ty[n] != ' ' && ty[n] != '\t' && ty[n] != '*') {
        if (n + 1 < sizeof(base)) base[n] = ty[n];
        n++;
    }
    if (n >= sizeof(base)) n = sizeof(base) - 1;
    base[n] = 0;
    p = base;
    return strncmp(p, "ArrayMap_", 9) == 0 || strncmp(p, "Map_", 4) == 0 ||
           strncmp(p, "CCVec_", 6) == 0;
}

static int shadow_typedef_struct_embeds_generic_container(const AstNode* it) {
    int k;
    if (!it) return 0;
    for (k = 0; k < it->nkids; k++) {
        AstNode* f = it->kids[k];
        if (!f) continue;
        if (f->kind == AST_FIELD_SIMPLE && shadow_ty_is_generic_container(f->a))
            return 1;
        if (f->kind == AST_FIELD_INT) continue;
        /* raw / other field shapes: best-effort scan of type text */
        if (f->a[0] && (strstr(f->a, "ArrayMap_") || strstr(f->a, "Map_") ||
                        strstr(f->a, "CCVec_")))
            return 1;
    }
    return 0;
}

/* Extracted local `.cch` stays an `AST_RAW_LINE` `#include "…h"`. */
static int shadow_raw_is_quoted_include(const AstNode* it) {
    const char* s;
    if (!it || it->kind != AST_RAW_LINE || !it->a[0]) return 0;
    if (it->e[0] && strcmp(it->e, "tape") == 0) return 0;
    s = it->a;
    while (*s == ' ' || *s == '\t') s++;
    return strncmp(s, "#include \"", 10) == 0;
}

static int shadow_item_is_type_decl(const AstNode* it) {
    if (!it) return 0;
    return it->kind == AST_STRUCT || it->kind == AST_TYPEDEF_STRUCT ||
           it->kind == AST_TYPEDEF_INT || it->kind == AST_TYPEDEF_ENUM;
}

/* Host text for a quoted include line (same rewrite as AST_RAW_LINE). */
static int shadow_emit_quoted_include_text(CEmit* out, const char* line) {
    char buf[768];
    const char* s;
    if (!line) return 0;
    snprintf(buf, sizeof(buf), "%s", line);
    s = buf;
    while (*s == ' ' || *s == '\t') s++;
    if (strncmp(s, "#include \"", 10) == 0) {
        size_t n = strlen(s);
        if (n >= 5 && strcmp(s + n - 5, ".cch\"") == 0) {
            char path[256];
            size_t plen = n - 10 - 5;
            if (plen > 0 && plen < sizeof(path)) {
                memcpy(path, s + 10, plen);
                path[plen] = 0;
                return cemit_fmt(out, "#include <%s.h>\n", path);
            }
        }
    }
    return cemit_fmt(out, "%s\n", s);
}

/* True when `alias` is a monomorph type argument of some factory instance
 * (e.g. Counter in py_expose::[Counter]). BufReader::[CCSocket] does not
 * require hoisting every user struct in the TU. */
static int shadow_alias_is_factory_type_arg(const char* alias) {
    int ii;
    if (!alias || !alias[0]) return 0;
    for (ii = 0; ii < g_shadow_nginst; ii++) {
        const char* p = g_shadow_ginst[ii].compact;
        while (*p) {
            char part[64];
            size_t n = 0;
            while (p[n] && p[n] != '_') n++;
            if (n >= sizeof(part)) n = sizeof(part) - 1;
            memcpy(part, p, n);
            part[n] = 0;
            if (part[0] && strcmp(part, alias) == 0) return 1;
            p += n;
            if (*p == '_') p++;
        }
    }
    return 0;
}

/* True when `params` text mentions `alias` as a type token (ident boundary). */
static int shadow_params_mention_type(const char* params, const char* alias) {
    const char* p;
    size_t al;
    if (!params || !alias || !alias[0]) return 0;
    al = strlen(alias);
    for (p = params; *p; p++) {
        if (strncmp(p, alias, al) != 0) continue;
        if (p > params && shadow_is_ident_char(p[-1])) continue;
        if (shadow_is_ident_char(p[al])) continue;
        return 1;
    }
    return 0;
}

static int shadow_typedef_struct_emitted(AstNode* td) {
    return td && td->e[0] &&
           (strcmp(td->e, "vech") == 0 || strcmp(td->e, "hoist") == 0);
}

/* Incomplete `typedef struct Name Name;` for TU structs named in `text`
 * that have not been emitted yet — hoisted prototypes next to a factory
 * type-arg (`RedisEntry*`) may also mention later structs (`RedisDb*`). */
static int shadow_emit_fwd_structs_in_text(AstNode** items, int n,
                                           const char* text, const char* skip,
                                           CEmit* out, char seen[][64],
                                           int* nseen, int seen_cap) {
    const char* p;
    if (!text || !items || !out || !nseen || !seen) return 1;
    for (p = text; *p; ) {
        char id[64];
        size_t k = 0;
        int i, s;
        if (!((p[0] >= 'A' && p[0] <= 'Z') || (p[0] >= 'a' && p[0] <= 'z') ||
              p[0] == '_')) {
            p++;
            continue;
        }
        while (((p[k] >= 'A' && p[k] <= 'Z') || (p[k] >= 'a' && p[k] <= 'z') ||
                (p[k] >= '0' && p[k] <= '9') || p[k] == '_') &&
               k + 1 < sizeof(id))
            k++;
        memcpy(id, p, k);
        id[k] = 0;
        p += k;
        if (skip && strcmp(id, skip) == 0) continue;
        for (s = 0; s < *nseen; s++)
            if (strcmp(seen[s], id) == 0) break;
        if (s < *nseen) continue;
        for (i = 0; i < n; i++) {
            AstNode* td = items[i];
            const char* alias;
            const char* tag;
            if (!td || td->kind != AST_TYPEDEF_STRUCT) continue;
            alias = td->b[0] ? td->b : td->a;
            tag = td->a[0] ? td->a : alias;
            if (!alias[0]) continue;
            if (strcmp(alias, id) != 0 && strcmp(tag, id) != 0) continue;
            if (shadow_typedef_struct_emitted(td)) break;
            if (*nseen >= seen_cap) break;
            snprintf(seen[*nseen], 64, "%s", alias);
            (*nseen)++;
            if (strcmp(tag, alias) != 0) {
                if (!cemit_fmt(out, "typedef struct %s %s;\n", tag, alias))
                    return 0;
            } else if (!cemit_fmt(out, "typedef struct %s %s;\n", alias, alias))
                return 0;
            break;
        }
    }
    return 1;
}

/* Incomplete `typedef struct Tag Alias;` for every tagged TU struct not yet
 * emitted. Hoisted Result/Vec/Map bodies may mention a later `RtxNode*` —
 * the forward makes the pointer field well-formed before the body. Tagless
 * `typedef struct { … } Alias` is skipped: a named forward would be a
 * different type from the anonymous body. */
static int shadow_emit_fwd_all_tu_structs(AstNode** items, int n, CEmit* out) {
    int i;
    if (!items || !out) return 1;
    for (i = 0; i < n; i++) {
        AstNode* td = items[i];
        const char* alias;
        const char* tag;
        if (!td || td->kind != AST_TYPEDEF_STRUCT) continue;
        if (!td->a[0]) continue;
        if (shadow_typedef_struct_emitted(td)) continue;
        alias = td->b[0] ? td->b : td->a;
        tag = td->a;
        if (!alias[0]) continue;
        if (strcmp(tag, alias) != 0) {
            if (!cemit_fmt(out, "typedef struct %s %s;\n", tag, alias))
                return 0;
        } else if (!cemit_fmt(out, "typedef struct %s %s;\n", alias, alias))
            return 0;
    }
    return 1;
}

/* Name/type/is_as for one reflectable field. 0 = skip (raw / unknown). */
static int shadow_reflect_field_info(const AstNode* f, const char** fname,
                                     char* fty, size_t fty_cap, int* is_as) {
    if (!f || !fname || !fty || fty_cap == 0 || !is_as) return 0;
    *fname = NULL;
    *is_as = 0;
    fty[0] = 0;
    if (f->kind == AST_FIELD_INT) {
        *fname = f->a;
        snprintf(fty, fty_cap, "int");
    } else if (f->kind == AST_FIELD_SIMPLE) {
        if (f->e[0] && strcmp(f->e, "raw") == 0) return 0;
        *fname = f->b;
        snprintf(fty, fty_cap, "%s", f->a);
        shadow_rewrite_char_slice_types(fty, fty_cap);
        if (f->e[0] && strcmp(f->e, "as") == 0) *is_as = 1;
    } else if (f->kind == AST_SLICE_VAR) {
        *fname = f->a;
        snprintf(fty, fty_cap, "%s", shadow_slice_ty("int"));
    } else {
        return 0;
    }
    return *fname && (*fname)[0];
}

/* Type-pass harvest: fill `cc_ct_field_reg_*` from typedef-struct AST.
 * Product pass still does safety + full emit; this walk is fields only. */
static int shadow_harvest_field_reg(AstNode** items, int n) {
    int i;
    if (!items) return n == 0;
    for (i = 0; i < n; i++) {
        AstNode* it = items[i];
        const char* names[64];
        const char* types_store[64];
        char typebuf[64][160];
        char namebuf[64][64];
        int is_as_arr[64];
        int nf = 0;
        int k;
        if (!it || it->kind != AST_TYPEDEF_STRUCT || !it->b[0] || it->nkids <= 0)
            continue;
        for (k = 0; k < it->nkids; k++) {
            const char* fname = NULL;
            char fty[160];
            int is_as = 0;
            const char* np;
            char one[64];
            char fnorm[64];
            if (!shadow_reflect_field_info(it->kids[k], &fname, fty, sizeof(fty),
                                           &is_as))
                continue;
            np = fname;
            while (shadow_field_next_name(&np, one, sizeof(one))) {
                shadow_field_ident_norm(one, fnorm, sizeof(fnorm));
                if (!fnorm[0]) continue;
                if (nf < 64) {
                    snprintf(namebuf[nf], sizeof(namebuf[nf]), "%s", fnorm);
                    names[nf] = namebuf[nf];
                    snprintf(typebuf[nf], sizeof(typebuf[nf]), "%s", fty);
                    types_store[nf] = typebuf[nf];
                    is_as_arr[nf] = is_as;
                }
                nf++;
            }
        }
        if (nf > 0 && nf <= 64)
            (void)cc_ct_field_reg_put(it->b, names, types_store, is_as_arr, nf);
    }
    return 1;
}

/* Emit C reflect table for a typedef alias (attrs are not on the struct).
 * Also registers the table in `cc_ct_field_reg_*` for lower-then-TCC comptime. */
static int shadow_emit_reflect_field_table(AstNode* it, CEmit* out) {
    const char* alias;
    int k, n = 0;
    const char* names[64];
    const char* types_store[64];
    char typebuf[64][160];
    char namebuf[64][64];
    int is_as_arr[64];
    if (!it || !out || !it->b[0] || it->nkids <= 0) return 1;
    alias = it->b;
    if (!cemit_fmt(out, "/* CC reflect fields:%s (is_as from AST; not on struct) */\n",
                   alias))
        return 0;
    /* Attr before `static`: Apple Clang 17 ignores unused between type and
     * name for `static const` aggregates (-Wunused-const-variable). */
    if (!cemit_fmt(out,
                   "__attribute__((unused)) static const struct { const char* name; "
                   "const char* type; int is_as; } __cc_rf_%s[] = {\n",
                   alias))
        return 0;
    for (k = 0; k < it->nkids; k++) {
        AstNode* f = it->kids[k];
        const char* fname = NULL;
        char fty[160];
        char fnorm[64];
        int is_as = 0;
        if (!shadow_reflect_field_info(f, &fname, fty, sizeof(fty), &is_as))
            continue;
        {
            const char* np = fname;
            char one[64];
            while (shadow_field_next_name(&np, one, sizeof(one))) {
                /* Reflect / UFCS share the base identifier (`args`, not `args[16]`). */
                shadow_field_ident_norm(one, fnorm, sizeof(fnorm));
                if (!fnorm[0]) continue;
                if (!cemit_fmt(out, "    { \"%s\", \"%s\", %d },\n", fnorm, fty,
                               is_as))
                    return 0;
                if (n < 64) {
                    snprintf(namebuf[n], sizeof(namebuf[n]), "%s", fnorm);
                    names[n] = namebuf[n];
                    snprintf(typebuf[n], sizeof(typebuf[n]), "%s", fty);
                    types_store[n] = typebuf[n];
                    is_as_arr[n] = is_as;
                }
                n++;
            }
        }
    }
    if (!cemit_fmt(out,
                   "};\n__attribute__((unused)) static const int __cc_rf_%s_n = "
                   "%d;\n\n",
                   alias, n))
        return 0;
    if (n > 0 && n <= 64)
        (void)cc_ct_field_reg_put(alias, names, types_store, is_as_arr, n);
    return 1;
}

/* Raw beachhead field: FileTape bytes when the span outgrew inline slots.
 * Caller frees *heap when non-NULL. */
static const char* shadow_raw_field_cstr(TapeCache* cache, const AstNode* f,
                                         char* small, size_t small_cap,
                                         char** heap) {
    size_t sl = 0;
    const char* tb = span_tape(cache, f, &sl);
    *heap = NULL;
    if (tb && sl > 0) {
        size_t cap = sl + 256;
        if (cap < 2048) cap = 2048;
        *heap = (char*)malloc(cap);
        if (!*heap) return NULL;
        memcpy(*heap, tb, sl);
        (*heap)[sl] = 0;
        /* Slice / Result spellings grow (`int[:]` → `CCSlice_int`). */
        shadow_rewrite_slice_types(*heap, cap);
        shadow_rewrite_result_types_in_text(*heap, cap);
        return *heap;
    }
    snprintf(small, small_cap, "%s", f->a);
    shadow_rewrite_slice_types(small, small_cap);
    shadow_rewrite_result_types_in_text(small, small_cap);
    return small;
}

/* typedef struct { … } Alias; — shared by prelude + main emit. */
static int shadow_emit_typedef_struct(AstNode* it, CEmit* out, TapeCache* cache,
                                      ShadowCtx* line_ctx) {
    if (it->nkids == 0 && it->a[0]) {
        if (it->b[0] && strcmp(it->a, it->b) != 0)
            shadow_td_alias_register(it->b, it->a);
        if (!cemit_fmt(out, "typedef struct %s %s;\n", it->a, it->b))
            return 0;
        return 1;
    }
    if (!it->a[0] && it->nkids == 1 &&
        it->kids[0]->kind == AST_FIELD_SIMPLE) {
        AstNode* f = it->kids[0];
        char fty[160];
        snprintf(fty, sizeof(fty), "%s", f->a);
        shadow_rewrite_char_slice_types(fty, sizeof(fty));
        if (it->b[0] && f->b[0])
            shadow_field_register_ex(it->b, f->b, fty[0] ? fty : NULL);
        if (f->e[0] && strcmp(f->e, "as") == 0 && it->b[0] && f->b[0])
            shadow_as_register(it->b, f->b, fty);
        if (f->e[0] && strcmp(f->e, "raw") == 0) {
            if (!cemit_fmt(out, "typedef struct { %s; } %s;\n\n", fty, it->b))
                return 0;
        } else if (!cemit_fmt(out, "typedef struct { %s %s; } %s;\n\n",
                              fty, f->b, it->b)) {
            return 0;
        }
        if (!shadow_emit_reflect_field_table(it, out)) return 0;
        return 1;
    }
    if (it->a[0]) {
        if (!cemit_fmt(out, "typedef struct %s {\n", it->a)) return 0;
    } else {
        if (!cemit_str(out, "typedef struct {\n")) return 0;
    }
    for (int k = 0; k < it->nkids; k++) {
        AstNode* f = it->kids[k];
        const char* find = shadow_stmt_indent(f, "    ");
        if (!shadow_emit_line(out, line_ctx, f, find)) return 0;
        if (f->kind == AST_FIELD_INT) {
            if (it->b[0] && f->a[0]) shadow_field_register(it->b, f->a);
            if (it->a[0] && f->a[0]) shadow_field_register(it->a, f->a);
            if (!cemit_fmt(out, "%sint %s;\n", find, f->a)) return 0;
        } else if (f->kind == AST_FIELD_SIMPLE) {
            char fty[160];
            if (f->e[0] && strcmp(f->e, "raw") == 0) {
                char* heap = NULL;
                char small[2048];
                const char* raw =
                    shadow_raw_field_cstr(cache, f, small, sizeof(small), &heap);
                if (!raw) return 0;
                if (it->b[0] && raw[0]) shadow_field_register_raw(it->b, raw);
                if (it->a[0] && raw[0]) shadow_field_register_raw(it->a, raw);
                if (!cemit_str(out, find) || !cemit_str(out, raw) ||
                    !cemit_str(out, ";\n")) {
                    free(heap);
                    return 0;
                }
                free(heap);
            } else {
                snprintf(fty, sizeof(fty), "%s", f->a);
                shadow_rewrite_char_slice_types(fty, sizeof(fty));
                if (it->b[0] && f->b[0])
                    shadow_field_register_ex(it->b, f->b, fty[0] ? fty : NULL);
                if (it->a[0] && f->b[0])
                    shadow_field_register_ex(it->a, f->b, fty[0] ? fty : NULL);
                if (f->e[0] && strcmp(f->e, "as") == 0) {
                    if (it->b[0] && f->b[0])
                        shadow_as_register(it->b, f->b, fty);
                    if (it->a[0] && f->b[0])
                        shadow_as_register(it->a, f->b, fty);
                }
                if (!cemit_fmt(out, "%s%s %s;\n", find, fty, f->b))
                    return 0;
            }
        } else if (f->kind == AST_SLICE_VAR) {
            if (it->b[0] && f->a[0]) shadow_field_register(it->b, f->a);
            if (!cemit_fmt(out, "%s%s %s;\n", find, shadow_slice_ty("int"), f->a))
                return 0;
        } else if (f->kind == AST_CHAN_VAR) {
            const char* cty = shadow_chan_handle_ty(f);
            if (it->b[0] && f->a[0])
                shadow_field_register_ex(it->b, f->a, cty);
            if (it->a[0] && f->a[0])
                shadow_field_register_ex(it->a, f->a, cty);
            if (!cemit_fmt(out, "%s%s %s;\n", find, cty, f->a)) return 0;
        } else if (f->kind == AST_RESULT_LOCAL) {
            char rname[256];
            char ok_host[128];
            shadow_result_ok_buf(ok_host, sizeof(ok_host), f->c);
            shadow_result_name(ok_host, f->b, rname, sizeof(rname));
            if (it->b[0] && f->a[0])
                shadow_field_register_ex(it->b, f->a, rname);
            if (it->a[0] && f->a[0])
                shadow_field_register_ex(it->a, f->a, rname);
            if (!cemit_fmt(out, "%s%s %s%s;\n", find, rname, f->a,
                           f->e[0] ? f->e : ""))
                return 0;
        } else if (f->kind == AST_RAW_LINE && f->e[0] &&
                   strcmp(f->e, "ppdir") == 0 && f->a[0]) {
            if (!cemit_fmt(out, "%s%s\n", find, f->a)) return 0;
        } else if (f->kind == AST_RAW_LINE && f->e[0] &&
                   strcmp(f->e, "raw") == 0) {
            char* heap = NULL;
            char small[2048];
            const char* raw =
                shadow_raw_field_cstr(cache, f, small, sizeof(small), &heap);
            if (!raw) return 0;
            if (!cemit_str(out, find) || !cemit_str(out, raw) ||
                !cemit_str(out, "\n")) {
                free(heap);
                return 0;
            }
            free(heap);
        } else {
            diag_at(cache, (Token){0}, "struct field not lowerable to C");
            out->err = 1;
            return 0;
        }
    }
    if (!cemit_fmt(out, "} %s;\n\n", it->b)) return 0;
    if (!shadow_emit_reflect_field_table(it, out)) return 0;
    return 1;
}

/* Shared lower: same AST → C text; H adds #pragma once and rejects fn bodies.
 * pass_inc: top-level #include <...> lines from stage 2 (not spliced).
 * pass_def: top-level #define lines preserved for .h API surface. */
/* True if emit will reference host `__cc_uw_*` / unwrap diag helpers. */
static int shadow_node_needs_uw(AstNode* n) {
    int k;
    if (!n) return 0;
    switch (n->kind) {
    case AST_PTR_UNWRAP:
    case AST_STMT_UNWRAP:
        return 1;
    case AST_VAR_UNWRAP:
        return 1; /* bang/qmark paths use err bind and/or `__cc_uw_*` */
    case AST_UFCS_STMT:
        if (strcmp(n->d, "bang") == 0 || strncmp(n->d, "bang_block:", 11) == 0)
            return 1;
        break;
    case AST_PRINTLN_BANG:
    case AST_PRINTLN_TPL:
        if (n->nbody > 0) return 1;
        break;
    case AST_CALL_ARGS:
        if (strcmp(n->c, "bang") == 0 || strcmp(n->c, "bang_stmt") == 0 ||
            strcmp(n->c, "bang_block") == 0)
            return 1;
        break;
    case AST_NURSERY_DESTROY:
        return 1;
    case AST_VAL_DESTROY:
        /* `T x = create() !> @destroy` — try_assign + as-face generic. */
        if (strstr(n->c, "!>") || strstr(n->c, "?>")) return 1;
        break;
    case AST_ERR_SYNTAX:
        return 1;
    default:
        break;
    }
    if (strstr(n->a, "?>") || strstr(n->b, "?>") || strstr(n->c, "?>") ||
        strstr(n->d, "?>") || strstr(n->e, "?>"))
        return 1;
    if (strstr(n->a, "!>") || strstr(n->b, "!>") || strstr(n->c, "!>") ||
        strstr(n->d, "!>") || strstr(n->e, "!>"))
        return 1;
    if (strcmp(n->e, "bang") == 0) return 1; /* return expr !> */
    for (k = 0; k < n->nbody; k++)
        if (shadow_node_needs_uw(n->body[k])) return 1;
    for (k = 0; k < n->ndbody; k++)
        if (shadow_node_needs_uw(n->dbody[k])) return 1;
    if (n->kids) {
        for (k = 0; k < n->nkids; k++)
            if (shadow_node_needs_uw(n->kids[k])) return 1;
    }
    return 0;
}

/* True if leftover text names Result API macros that live in cc_result.h. */
static int shadow_node_needs_result_api(AstNode* n) {
    int k;
    if (!n) return 0;
    if (strstr(n->a, "cc_is_ok") || strstr(n->a, "cc_is_err") ||
        strstr(n->a, "cc_unwrap") || strstr(n->a, "cc_value") ||
        strstr(n->a, "CC_ERROR") || strstr(n->a, "CC_ERR_") ||
        strstr(n->b, "cc_is_ok") || strstr(n->b, "cc_is_err") ||
        strstr(n->b, "cc_unwrap") || strstr(n->b, "cc_value") ||
        strstr(n->b, "CC_ERROR") || strstr(n->b, "CC_ERR_") ||
        strstr(n->c, "cc_is_ok") || strstr(n->c, "cc_is_err") ||
        strstr(n->c, "cc_unwrap") || strstr(n->c, "cc_value") ||
        strstr(n->c, "CC_ERROR") || strstr(n->c, "CC_ERR_") ||
        strstr(n->d, "cc_is_ok") || strstr(n->d, "cc_is_err") ||
        strstr(n->d, "cc_unwrap") || strstr(n->d, "cc_value") ||
        strstr(n->d, "CC_ERROR") || strstr(n->d, "CC_ERR_") ||
        strstr(n->e, "cc_is_ok") || strstr(n->e, "cc_is_err") ||
        strstr(n->e, "cc_unwrap") || strstr(n->e, "cc_value") ||
        strstr(n->e, "CC_ERROR") || strstr(n->e, "CC_ERR_"))
        return 1;
    for (k = 0; k < n->nbody; k++)
        if (shadow_node_needs_result_api(n->body[k])) return 1;
    for (k = 0; k < n->ndbody; k++)
        if (shadow_node_needs_result_api(n->dbody[k])) return 1;
    if (n->kids) {
        for (k = 0; k < n->nkids; k++)
            if (shadow_node_needs_result_api(n->kids[k])) return 1;
    }
    return 0;
}

/* Grammar entry-point dedup (`Name_match` / `Name_rule_count`) is per emit
 * only. Type-pass and main-pass each call shadow_emit; leaking this table
 * across them silently drops user helpers whose names merely end in
 * `_match` (e.g. redis `glob_match`) after the type-pass already emitted them. */
static char g_shadow_emitted_grammar_fns[16][64];
static int g_shadow_n_emitted_grammar_fns;

static int shadow_grammar_entry_fn_name(const char* name) {
    size_t n;
    if (!name || !name[0]) return 0;
    n = strlen(name);
    if (n >= 6 && strcmp(name + (n - 6), "_match") == 0) return 1;
    if (n >= 11 && strcmp(name + (n - 11), "_rule_count") == 0) return 1;
    return 0;
}

enum { SHADOW_SEEN_RESULT_CAP = 128 };

static int shadow_seen_result_add(char seen_ok[][128], char seen_err[][128],
                                  int* nseen, const char* ok, const char* err) {
    int j;
    if (!ok || !ok[0] || !err || !err[0] || !nseen) return 1;
    for (j = 0; j < *nseen; j++) {
        if (strcmp(seen_ok[j], ok) == 0 && strcmp(seen_err[j], err) == 0)
            return 1;
    }
    if (*nseen >= SHADOW_SEEN_RESULT_CAP) {
        fprintf(stderr,
                "error: Result unwrap table full (%d); '%s !>(%s)' is not "
                "in __cc_uw_*\n",
                SHADOW_SEEN_RESULT_CAP, ok, err);
        return 0;
    }
    snprintf(seen_ok[*nseen], 128, "%s", ok);
    snprintf(seen_err[*nseen], 128, "%s", err);
    (*nseen)++;
    return 1;
}

/* CC_DECL_RESULT_SPEC needs a complete Err type. Do not emit this at the
 * top of the TU — a quoted header that defines E may still be an item. */
/* Ok/E that stdlib headers already make complete. Seeded `__cc_uw_*`
 * arms (int64_t+CCError, int+CCIoError, …) must exist before any `!>`
 * use; TU unique-E still waits for the first AST_RESULT_FN. */
static int shadow_result_pair_is_prelude(const char* ok, const char* err) {
    static const char* oks[] = {"int",     "bool",     "char",    "size_t",
                                "int64_t", "uint64_t", "void",    "voidptr",
                                "charptr", NULL};
    int i;
    if (!ok || !ok[0] || !err || !err[0]) return 0;
    if (strcmp(err, "CCError") != 0 && strcmp(err, "CCIoError") != 0)
        return 0;
    for (i = 0; oks[i]; i++) {
        if (strcmp(ok, oks[i]) == 0) return 1;
    }
    return 0;
}

static int shadow_emit_collected_result_specs(CEmit* out,
                                              char seen_ok[][128],
                                              char seen_err[][128],
                                              int nseen, int prelude_only) {
    int i;
    int announced = 0;
    if (!out || nseen < 0) return 0;
    if (nseen && !cemit_str(out, "\n")) return 0;
    for (i = 0; i < nseen; i++) {
        char rname[256];
        if (prelude_only &&
            !shadow_result_pair_is_prelude(seen_ok[i], seen_err[i]))
            continue;
        shadow_result_name(seen_ok[i], seen_err[i], rname, sizeof(rname));
        /* Stdlib already defines these (cc_io_error.h) without *_DEFINED. */
        if (strcmp(seen_ok[i], "bool") == 0 &&
            strcmp(seen_err[i], "CCIoError") == 0)
            continue;
        /* Synthesized block: without a directive these physical lines keep
         * counting up from the last user #line and map past the source EOF
         * (test_async_line_map). Later user items re-anchor themselves. */
        if (!announced) {
            if (!cemit_str(out, "#line 1 \"<cc:result-specs>\"\n")) return 0;
            announced = 1;
        }
        /* Real layout + typed ctors when cc_result.h provided CC_DECL_RESULT_SPEC.
         * Void ok uses SPEC_VOID (no `void value` field). Split across cemit_fmt
         * calls (512-byte temp). */
        if (strcmp(seen_ok[i], "void") == 0) {
            if (!cemit_fmt(out,
                    "#ifndef %s_DEFINED\n#define %s_DEFINED 1\n"
                    "#ifdef CC_DECL_RESULT_SPEC_VOID\n"
                    "CC_DECL_RESULT_SPEC_VOID(%s, %s)\n#else\n",
                    rname, rname, rname, seen_err[i]))
                return 0;
            {
                ShadowTplBind renv[3];
                renv[0] = (ShadowTplBind){ "rname", SHADOW_TPL_IDENT, rname };
                renv[1] = (ShadowTplBind){ "ok_ty", SHADOW_TPL_IDENT, "void" };
                renv[2] =
                    (ShadowTplBind){ "err_ty", SHADOW_TPL_IDENT, seen_err[i] };
                if (!shadow_tpl_emit(out, k_tpl_result_spec_void, renv, 3))
                    return 0;
            }
            if (!cemit_fmt(out,
                    "static inline %s cc_ok_%s(void) {"
                    " %s r; r.ok = 1; return r; }\n"
                    "static inline %s cc_err_%s(%s e) {"
                    " %s r; r.ok = 0; r.u.error = e; return r; }\n"
                    "#endif\n#endif\n",
                    rname, rname, rname, rname, rname, seen_err[i], rname))
                return 0;
            continue;
        }
        if (!cemit_fmt(out,
                "#ifndef %s_DEFINED\n#define %s_DEFINED 1\n"
                "#ifdef CC_DECL_RESULT_SPEC\n"
                "CC_DECL_RESULT_SPEC(%s, %s, %s)\n#else\n",
                rname, rname, rname, seen_ok[i], seen_err[i]))
            return 0;
        {
            ShadowTplBind renv[3];
            renv[0] = (ShadowTplBind){ "rname", SHADOW_TPL_IDENT, rname };
            renv[1] = (ShadowTplBind){ "ok_ty", SHADOW_TPL_IDENT, seen_ok[i] };
            renv[2] = (ShadowTplBind){ "err_ty", SHADOW_TPL_IDENT, seen_err[i] };
            if (!shadow_tpl_emit(out, k_tpl_result_spec_value, renv, 3))
                return 0;
        }
        if (!cemit_fmt(out,
                "static inline %s cc_err_%s(%s e) {"
                " %s r; r.ok = 0; r.u.error = e; return r; }\n"
                "#endif\n#endif\n",
                rname, rname, seen_err[i], rname))
            return 0;
    }
    if (nseen && !cemit_str(out, "\n")) return 0;
    return 1;
}

static int shadow_emit(AstNode** items, int n, TapeCache* cache, CEmit* out,
                       ShadowEmitKind kind, char pass_inc[][256], int npass_inc,
                       char pass_def[][512], int npass_def,
                       const char* src_path) {
    memset(out, 0, sizeof(*out));
    shadow_chan_reset();
    shadow_grammar_ufcs_install();
    shadow_grammar_variant_install();
    g_sticky_lead_set = 0;
    g_file_header_lead_done = 0;
    g_shadow_async_id = 60000;
    g_shadow_closure_id = 1;
    shadow_par_helpers_reset();
    g_shadow_n_emitted_grammar_fns = 0;
    /* Pre-scan send_task receivers so ordered channel_pair can select task
     * machinery before the send_task site is emitted. */
    {
        int si;
        for (si = 0; si < n; si++) shadow_collect_task_sends(items[si]);
    }
    /* @as embeds + destroy hooks from included headers (not spliced into AST). */
    if (npass_inc > 0 && pass_inc) {
        char from_dir[512];
        from_dir[0] = 0;
        if (src_path && src_path[0])
            shadow_fill_quote_dir(src_path, from_dir, sizeof(from_dir));
        shadow_as_scan_pass_inc(pass_inc, npass_inc,
                               from_dir[0] ? from_dir : NULL);
    }
    /* Warmed angle-includes (@as / hooks still present in .cch text). */
    shadow_as_scan_tapes(cache);
    /* Quoted local `.cch` lowered to `.h` — scan the original source. */
    shadow_as_scan_lowered_local_cch();
    /* System `.cch` registered from spliced angle includes (not pass_inc). */
    shadow_as_scan_included_cch();
    /* Pre-blank TU source — stage1 blanks @comptime register bodies. */
    shadow_as_scan_src_path(src_path);
    shadow_as_resolve_transitive();
    /* Resolve runtime vs stub before collect_binds (slice/chan bind spellings).
     * Includes may live in pass_inc or in item lead trivia (source #include). */
    {
        int has_slice_rt = 0, has_chan_rt = 0;
        int i;
        for (i = 0; i < npass_inc; i++) {
            if (strstr(pass_inc[i], "cc_slice") ||
                strstr(pass_inc[i], "cc_runtime") ||
                strstr(pass_inc[i], "prelude"))
                has_slice_rt = 1;
            if (strstr(pass_inc[i], "cc_channel") ||
                strstr(pass_inc[i], "cc_chan") ||
                strstr(pass_inc[i], "cc_runtime") ||
                strstr(pass_inc[i], "prelude"))
                has_chan_rt = 1;
        }
        for (i = 0; i < n && (!has_slice_rt || !has_chan_rt); i++) {
            FileTape* ft;
            size_t off, len, k;
            if (!items[i] || !items[i]->lead_len || !items[i]->file_id) continue;
            ft = tape_by_id(cache, items[i]->file_id);
            if (!ft || !ft->bytes) continue;
            off = items[i]->lead_off;
            len = items[i]->lead_len;
            if (off + len > ft->len) continue;
            for (k = 0; k + 7 < len; k++) {
                const char* s = ft->bytes + off + k;
                if (!has_slice_rt &&
                    (strncmp(s, "prelude", 7) == 0 ||
                     strncmp(s, "cc_runtime", 10) == 0 ||
                     strncmp(s, "cc_slice", 8) == 0))
                    has_slice_rt = 1;
                if (!has_chan_rt &&
                    (strncmp(s, "prelude", 7) == 0 ||
                     strncmp(s, "cc_runtime", 10) == 0 ||
                     strncmp(s, "cc_channel", 10) == 0 ||
                     strncmp(s, "cc_chan", 7) == 0))
                    has_chan_rt = 1;
            }
        }
        g_shadow_slice_stub = !has_slice_rt;
        g_shadow_chan_stub = !has_chan_rt;
    }
    if (kind == SHADOW_EMIT_H) {
        if (!shadow_tpl_emit(out, k_tpl_tu_prelude_h, NULL, 0)) return 0;
    } else if (g_shadow_prelude_off) {
        if (!cemit_str(out,
                       "/* generated by Concurrent-C (ccc / shadow_lower) */\n"))
            return 0;
    } else {
        if (!shadow_tpl_emit(out, k_tpl_tu_prelude_c, NULL, 0)) return 0;
    }

    /* File banner only (before first `#…`); post-include comments stay on item 0. */
    if (n > 0) {
        if (!shadow_emit_preamble_ex(items[0], out, cache, 1)) return 0;
    }
    /* Blank line between banner and includes / first decl (hand-written headers). */
    if (out->len > 0 && out->buf[out->len - 1] == '\n' &&
        (out->len < 2 || out->buf[out->len - 2] != '\n')) {
        if (!cemit_str(out, "\n")) return 0;
    }

    {
        int need_task_h = 0;
        for (int i = 0; i < npass_inc; i++) {
            char line[256];
            int sse_hdr;
            shadow_rewrite_pass_inc(line, sizeof(line), pass_inc[i]);
            /* Only .ccs→.c: nursery/.cch surface must stay oracle-aligned. */
            if (kind == SHADOW_EMIT_C && strstr(line, "cc_sched"))
                need_task_h = 1;
            /* Stage2 harvests `#include <emmintrin.h>` even when it sat under
             * `#if defined(__SSE2__)` in grammar emit — re-wrap for arm64 hosts. */
            sse_hdr = (strstr(line, "emmintrin.h") != NULL ||
                       strstr(line, "xmmintrin.h") != NULL ||
                       strstr(line, "mmintrin.h") != NULL);
            if (sse_hdr) {
                if (!cemit_fmt(out, "#if defined(__SSE2__)\n%s\n#endif\n", line))
                    return 0;
            } else if (!cemit_fmt(out, "%s\n", line)) {
                return 0;
            }
        }
        /* cc_sched documents cc_block_on_intptr; the decl lives in std/task. */
        if (need_task_h &&
            !cemit_str(out, "#include <ccc/std/task.h>\n"))
            return 0;
    }
    if (npass_inc && !cemit_str(out, "\n")) return 0;

    for (int i = 0; i < npass_def; i++) {
        if (!cemit_fmt(out, "%s\n", pass_def[i])) return 0;
    }
    if (npass_def && !cemit_str(out, "\n")) return 0;

    /* Register CC_GENERIC_FACTORY / _EXTEND templates from the TU. */
    for (int i = 0; i < n; i++) {
        if (items[i]->kind == AST_GENERIC_FACTORY) {
            char ofile[128];
            int oline = 1;
            FileTape* ft = cache ? tape_by_id(cache, items[i]->file_id) : NULL;
            ofile[0] = 0;
            if (ft && ft->bytes)
                shadow_tape_logical_at(ft, items[i]->tok_off, ofile,
                                       sizeof(ofile), &oline);
            shadow_gfac_add(items[i]->a, atoi(items[i]->b), items[i]->d,
                            items[i]->c[0] == 'e' /* extend */, ofile, oline);
        }
    }
    /* `Name::[args]` rewritten at parse — drain those instance requests. */
    {
        int gi;
        char fam[96];
        char compact[96];
        char gargs[8][64];
        int ngargs = 0;
        for (gi = 0; gi < shadow_parse_ginst_count(); gi++) {
            ngargs = 0;
            if (!shadow_parse_ginst_at(gi, fam, sizeof(fam), compact,
                                      sizeof(compact), gargs, 8, &ngargs))
                continue;
            if (strcmp(fam, "CCSlice") == 0)
                shadow_slice_need(compact);
            shadow_ginst_need_ex(fam, compact, gargs, ngargs);
        }
    }
    /* AST+type: one normalize/bind walk before emit (not per-expr string soup). */
    shadow_collect_binds(items, n);
    /* Header protos → same ShadowFnParamMap (TU rows already present). */
    shadow_fnparam_ingest_headers();
    /* @typeview modes before UFCS/field checks (erased typedefs emit later).
     * Builtins first (slice family); TU decls may redeclare if compatible. */
    shadow_restrict_register_builtins();
    shadow_restrict_register_from_items(items, n);
    /* Glob typeview as: faces → exact embeds once fields / slice instances known. */
    shadow_as_materialize_all_globs();
    /* typeview `as:` faces may have been added after the header @as scan. */
    shadow_as_resolve_transitive();

    /* Collect Result Ok/Err pairs first — drives specs and __cc_uw_* arms. */
    ShadowCtx line_ctx = { .cache = cache };
    char seen_ok[SHADOW_SEEN_RESULT_CAP][128];
    char seen_err[SHADOW_SEEN_RESULT_CAP][128];
    int nseen = 0;
    int need_slice = 0, need_chan = 0, need_spawn_into = 0;
    int hoist_typedefs = 0;
    int has_result_hdr = 0;
    int need_uw = 0;
    int specs_emitted = 0;

    for (int i = 0; i < n; i++) {
        if (items[i]->kind == AST_RESULT_FN || items[i]->kind == AST_RESULT_LOCAL) {
            char ok_host[128];
            char rname[256];
            shadow_result_ok_buf(ok_host, sizeof(ok_host), items[i]->c);
            if (!shadow_seen_result_add(seen_ok, seen_err, &nseen, ok_host,
                                        items[i]->b))
                return 0;
            if (items[i]->kind == AST_RESULT_FN && items[i]->a[0]) {
                shadow_result_name(ok_host, items[i]->b, rname, sizeof(rname));
                shadow_rfn_register(items[i]->a, rname, items[i]->b);
            }
        }
        if (items[i]->kind == AST_TYPEDEF_INT && items[i]->c[0] && items[i]->d[0]) {
            if (!shadow_seen_result_add(seen_ok, seen_err, &nseen, items[i]->c,
                                        items[i]->d))
                return 0;
        }
        if (items[i]->kind == AST_SLICE_VAR) need_slice = 1;
        if (items[i]->kind == AST_CHAN_VAR) {
            need_chan = 1;
            /* Result-typed channel elems: ensure CCResult_* specs exist. */
            if (strncmp(items[i]->d, "CCResult_", 9) == 0) {
                const char* rest = items[i]->d + 9;
                const char* us = strrchr(rest, '_');
                char ok[64], err[64];
                if (us && us > rest) {
                    size_t ol = (size_t)(us - rest);
                    if (ol >= sizeof(ok)) ol = sizeof(ok) - 1;
                    memcpy(ok, rest, ol);
                    ok[ol] = 0;
                    snprintf(err, sizeof(err), "%s", us + 1);
                    if (!shadow_seen_result_add(seen_ok, seen_err, &nseen, ok,
                                                err))
                        return 0;
                }
            }
        }
        if (items[i]->kind == AST_STRUCT || items[i]->kind == AST_FN ||
            items[i]->kind == AST_STATIC_FN || items[i]->kind == AST_RESULT_FN) {
            for (int k = 0; k < items[i]->nkids; k++) {
                AstNode* kid = items[i]->kids[k];
                if (kid->kind == AST_SLICE_VAR) need_slice = 1;
                if (kid->kind == AST_CHAN_VAR) {
                    need_chan = 1;
                    if (strncmp(kid->d, "CCResult_", 9) == 0) {
                        const char* rest = kid->d + 9;
                        const char* us = strrchr(rest, '_');
                        char ok[64], err[64];
                        if (us && us > rest) {
                            size_t ol = (size_t)(us - rest);
                            if (ol >= sizeof(ok)) ol = sizeof(ok) - 1;
                            memcpy(ok, rest, ol);
                            ok[ol] = 0;
                            snprintf(err, sizeof(err), "%s", us + 1);
                            if (!shadow_seen_result_add(seen_ok, seen_err,
                                                        &nseen, ok, err))
                                return 0;
                        }
                    }
                }
            }
        }
    }

    /* Host-cc: builtins + TU-seen Result types (not a handwritten E allowlist). */
    if (kind == SHADOW_EMIT_C) {
        for (int i = 0; i < npass_inc; i++) {
            if (strstr(pass_inc[i], "cc_result") ||
                strstr(pass_inc[i], "cc_runtime") ||
                strstr(pass_inc[i], "prelude")) {
                has_result_hdr = 1;
                break;
            }
        }
        for (int i = 0; i < n && !need_uw; i++)
            need_uw = shadow_node_needs_uw(items[i]);
        if (need_uw && !has_result_hdr) {
            if (!cemit_str(out, "#include <ccc/cc_result.h>\n\n")) return 0;
            has_result_hdr = 1;
        }
        if (need_uw) {
            int si;
            char rname[128];
            char apath[64];
            /* Clang requires complete types in _Generic associations. Only
             * arm types fully declared by <ccc/cc_result.h> (+ TU-seen
             * specs emitted below). IoError Results need their header. */
            {
                int need_io = 0;
                for (si = 0; si < nseen; si++) {
                    if (strcmp(seen_err[si], "CCIoError") == 0) {
                        need_io = 1;
                        break;
                    }
                }
                /* Channel send/recv returns CCResult_bool_CCIoError even when
                 * the TU never declares a Result local of that shape. */
                if (need_chan) {
                    if (!shadow_seen_result_add(seen_ok, seen_err, &nseen,
                                                "bool", "CCIoError"))
                        return 0;
                    need_io = 1;
                }
                /* py_expose_* returns CCResult_CCPyptr_CCError — arm __cc_uw_*. */
                {
                    int gi;
                    for (gi = 0; gi < g_shadow_nginst; gi++) {
                        if (strcmp(g_shadow_ginst[gi].family, "py_expose") == 0)
                            break;
                    }
                    if (gi < g_shadow_nginst) {
                        if (!shadow_seen_result_add(seen_ok, seen_err, &nseen,
                                                    "CCPyptr", "CCError"))
                            return 0;
                    }
                }
                /* Header helpers like cc_add_i64_checked → CCResult_int64_t_CCError
                 * without a TU Result local; seed so __cc_uw_value arms it. */
                {
                    if (!shadow_seen_result_add(seen_ok, seen_err, &nseen,
                                                "int64_t", "CCError"))
                        return 0;
                }
                /* Header `void !>(CCError)` (wait, adopt, turnstile, …).
                 * Without this arm, __cc_uw_is_err hits the pointer default:
                 * bool ok is one byte, padding is not zeroed, so both Ok and
                 * Err look like non-NULL words and `!>` / `!>(e)` miss the
                 * error. */
                {
                    if (!shadow_seen_result_add(seen_ok, seen_err, &nseen,
                                                "void", "CCError"))
                        return 0;
                }
                /* cc_command_status / process APIs → CCResult_int_CCIoError.
                 * Without this arm, __cc_uw_is_err hits the pointer default and
                 * spawn failures silently look like success (script bang). */
                {
                    if (!shadow_seen_result_add(seen_ok, seen_err, &nseen,
                                                "int", "CCIoError"))
                        return 0;
                    need_io = 1;
                }
                if (need_io &&
                    !cemit_str(out, "#include <ccc/cc_io_error.h>\n"))
                    return 0;
                /* as: Io→CCError arms `CCResult_*_CCIoError` in `__cc_uw_*`.
                 * Declare those specs (and int64_t+CCError) before the
                 * macros; unique-E stays delayed. */
                if (!shadow_emit_collected_result_specs(out, seen_ok, seen_err,
                                                        nseen, 1))
                    return 0;
            }
            if (!cemit_str(out,
                    "#undef __cc_uw_is_err\n"
                    "#undef __cc_uw_value\n"
                    "#undef __cc_uw_err_at\n"
                    "#define __cc_uw_is_err(__x__) _Generic((__x__), "
                    "CCResult_int_CCError: "
                    "(!((CCResult_int_CCError*)(void*)&(__x__))->ok), "
                    "CCResult_bool_CCError: "
                    "(!((CCResult_bool_CCError*)(void*)&(__x__))->ok), "
                    "CCResult_char_CCError: "
                    "(!((CCResult_char_CCError*)(void*)&(__x__))->ok), "
                    "CCResult_size_t_CCError: "
                    "(!((CCResult_size_t_CCError*)(void*)&(__x__))->ok), "
                    "CCResult_voidptr_CCError: "
                    "(!((CCResult_voidptr_CCError*)(void*)&(__x__))->ok), "
                    "CCResult_charptr_CCError: "
                    "(!((CCResult_charptr_CCError*)(void*)&(__x__))->ok)"))
                return 0;
            for (si = 0; si < nseen; si++) {
                shadow_result_name(seen_ok[si], seen_err[si], rname,
                                   sizeof(rname));
                if (strcmp(rname, "CCResult_int_CCError") == 0 ||
                    strcmp(rname, "CCResult_bool_CCError") == 0 ||
                    strcmp(rname, "CCResult_char_CCError") == 0 ||
                    strcmp(rname, "CCResult_size_t_CCError") == 0 ||
                    strcmp(rname, "CCResult_voidptr_CCError") == 0 ||
                    strcmp(rname, "CCResult_charptr_CCError") == 0)
                    continue;
                if (!cemit_fmt(out,
                        ", %s: (!((%s*)(void*)&(__x__))->ok)", rname, rname))
                    return 0;
            }
            if (!cemit_str(out,
                    ", default: (*(void* const*)(void*)&(__x__) == (void*)0))\n"
                    "#define __cc_uw_value(__x__) _Generic((__x__), "
                    "CCResult_int_CCError: "
                    "((CCResult_int_CCError*)(void*)&(__x__))->u.value, "
                    "CCResult_bool_CCError: "
                    "((CCResult_bool_CCError*)(void*)&(__x__))->u.value, "
                    "CCResult_char_CCError: "
                    "((CCResult_char_CCError*)(void*)&(__x__))->u.value, "
                    "CCResult_size_t_CCError: "
                    "((CCResult_size_t_CCError*)(void*)&(__x__))->u.value, "
                    "CCResult_voidptr_CCError: "
                    "((CCResult_voidptr_CCError*)(void*)&(__x__))->u.value, "
                    "CCResult_charptr_CCError: "
                    "((CCResult_charptr_CCError*)(void*)&(__x__))->u.value"))
                return 0;
            for (si = 0; si < nseen; si++) {
                shadow_result_name(seen_ok[si], seen_err[si], rname,
                                   sizeof(rname));
                if (strcmp(rname, "CCResult_int_CCError") == 0 ||
                    strcmp(rname, "CCResult_bool_CCError") == 0 ||
                    strcmp(rname, "CCResult_char_CCError") == 0 ||
                    strcmp(rname, "CCResult_size_t_CCError") == 0 ||
                    strcmp(rname, "CCResult_voidptr_CCError") == 0 ||
                    strcmp(rname, "CCResult_charptr_CCError") == 0 ||
                    strcmp(seen_ok[si], "void") == 0)
                    continue;
                if (!cemit_fmt(out, ", %s: ((%s*)(void*)&(__x__))->u.value",
                               rname, rname))
                    return 0;
            }
            if (!cemit_str(out,
                    ", default: (__x__))\n"
                    "#define __cc_uw_err_at(__x__, __e__, __f__, __l__) "
                    "_Generic((__x__), "
                    "CCResult_int_CCError: "
                    "(cc_rt_diag_record_unwrap_site(__f__, __l__), "
                    "((CCResult_int_CCError*)(void*)&(__x__))->u.error), "
                    "CCResult_bool_CCError: "
                    "(cc_rt_diag_record_unwrap_site(__f__, __l__), "
                    "((CCResult_bool_CCError*)(void*)&(__x__))->u.error), "
                    "CCResult_char_CCError: "
                    "(cc_rt_diag_record_unwrap_site(__f__, __l__), "
                    "((CCResult_char_CCError*)(void*)&(__x__))->u.error), "
                    "CCResult_size_t_CCError: "
                    "(cc_rt_diag_record_unwrap_site(__f__, __l__), "
                    "((CCResult_size_t_CCError*)(void*)&(__x__))->u.error), "
                    "CCResult_voidptr_CCError: "
                    "(cc_rt_diag_record_unwrap_site(__f__, __l__), "
                    "((CCResult_voidptr_CCError*)(void*)&(__x__))->u.error), "
                    "CCResult_charptr_CCError: "
                    "(cc_rt_diag_record_unwrap_site(__f__, __l__), "
                    "((CCResult_charptr_CCError*)(void*)&(__x__))->u.error)"))
                return 0;
            for (si = 0; si < nseen; si++) {
                shadow_result_name(seen_ok[si], seen_err[si], rname,
                                   sizeof(rname));
                if (strcmp(rname, "CCResult_int_CCError") == 0 ||
                    strcmp(rname, "CCResult_bool_CCError") == 0 ||
                    strcmp(rname, "CCResult_char_CCError") == 0 ||
                    strcmp(rname, "CCResult_size_t_CCError") == 0 ||
                    strcmp(rname, "CCResult_voidptr_CCError") == 0 ||
                    strcmp(rname, "CCResult_charptr_CCError") == 0)
                    continue;
                /* Macro returns CCError: exact E, or @as face at offset 0. */
                apath[0] = 0;
                if (strcmp(seen_err[si], "CCError") == 0) {
                    if (!cemit_fmt(out,
                            ", %s: (cc_rt_diag_record_unwrap_site(__f__, __l__), "
                            "((%s*)(void*)&(__x__))->u.error)",
                            rname, rname))
                        return 0;
                } else if (shadow_as_path_to(seen_err[si], "CCError", apath,
                                            sizeof(apath)) > 0 &&
                           apath[0]) {
                    if (!cemit_fmt(out,
                            ", %s: (cc_rt_diag_record_unwrap_site(__f__, __l__), "
                            "(*(CCError*)(void*)&((%s*)(void*)&(__x__))->u.error))",
                            rname, rname))
                        return 0;
                }
            }
            if (!cemit_str(out,
                    ", default: (cc_rt_diag_record_unwrap_site(__f__, __l__), "
                    "__cc_err_null_at(__e__, __f__, __l__)))\n"
                    "\n"))
                return 0;
        }
    }
    /* Hoist typedefs when Result specs need prior names, Vec/Map element
     * types need to precede DECL macros, or a factory type-arg struct must
     * be complete before its factory body (py_expose::[Counter]). Factory
     * presence alone does not hoist every TU struct. */
    hoist_typedefs = (nseen > 0 || g_shadow_nginst > 0 || g_shadow_nvecs > 0 || g_shadow_nmaps > 0);

    if (hoist_typedefs) {
        /* All tagged forwards first, then bodies — a hoisted Result/Vec
         * payload with `Later*` must not require Later's complete type. */
        if (!shadow_emit_fwd_all_tu_structs(items, n, out)) return 0;
        /* Hoist typedefs referenced by @variant arm types so they are
         * visible when the variant helpers are emitted below. */
        for (int vi = 0; vi < n; vi++) {
            const char* vp;
            if (items[vi]->kind != AST_AT_STMT) continue;
            if (strcmp(items[vi]->a, "variant") != 0) continue;
            vp = items[vi]->c;
            while (*vp) {
                char arm_ty[96];
                size_t atl;
                int j2;
                while (*vp && *vp != ':') vp++;
                if (!*vp) break;
                vp++;
                while (*vp == ' ' || *vp == '\t') vp++;
                atl = 0;
                while (vp[atl] && vp[atl] != ';' && vp[atl] != '}')
                    atl++;
                while (atl > 0 && (vp[atl-1]==' ' || vp[atl-1]=='\t'))
                    atl--;
                if (atl == 0 || atl >= sizeof(arm_ty)) { vp += atl; continue; }
                memcpy(arm_ty, vp, atl);
                arm_ty[atl] = 0;
                vp += atl;
                while (*vp == ';' || *vp == ' ') vp++;
                for (j2 = 0; j2 < n; j2++) {
                    const char* a2;
                    if (items[j2]->kind == AST_TYPEDEF_STRUCT) {
                        if (strcmp(items[j2]->e, "hoist") == 0) continue;
                        a2 = items[j2]->b[0] ? items[j2]->b : items[j2]->a;
                        if (!a2[0] || strcmp(a2, arm_ty) != 0) continue;
                        if (!shadow_emit_preamble(items[j2], out, cache))
                            return 0;
                        items[j2]->lead_len = 0;
                        if (!shadow_emit_line(out, &line_ctx, items[j2], ""))
                            return 0;
                        if (!shadow_emit_typedef_struct(items[j2], out, cache,
                                                       &line_ctx))
                            return 0;
                        snprintf(items[j2]->e, sizeof(items[j2]->e), "hoist");
                    } else if (items[j2]->kind == AST_TYPEDEF_INT) {
                        if (strcmp(items[j2]->e, "vech") == 0) continue;
                        if (!items[j2]->a[0] || strcmp(items[j2]->a, arm_ty) != 0)
                            continue;
                        if (!shadow_emit_preamble(items[j2], out, cache))
                            return 0;
                        items[j2]->lead_len = 0;
                        if (!cemit_fmt(out, "typedef %s %s;\n",
                                       items[j2]->b, items[j2]->a))
                            return 0;
                        snprintf(items[j2]->e, sizeof(items[j2]->e), "vech");
                    }
                }
            }
        }
        /* Forward-declare destroy hooks that @variant drop helpers need.
         * The variant helpers are hoisted before the user static definitions,
         * so the host compiler must see the names. */
        {
            char fwd_done[16][64];
            int nfwd = 0;
            for (int i = 0; i < n; i++) {
                const char* vp;
                if (items[i]->kind != AST_AT_STMT) continue;
                if (strcmp(items[i]->a, "variant") != 0) continue;
                vp = items[i]->c;
                while (*vp) {
                    char arm_ty[96];
                    const char* hook;
                    size_t atl;
                    int dup, fi;
                    while (*vp && *vp != ':') vp++;
                    if (!*vp) break;
                    vp++;
                    while (*vp == ' ' || *vp == '\t') vp++;
                    atl = 0;
                    while (vp[atl] && vp[atl] != ';' && vp[atl] != '}')
                        atl++;
                    while (atl > 0 && (vp[atl-1]==' ' || vp[atl-1]=='\t'))
                        atl--;
                    if (atl == 0 || atl >= sizeof(arm_ty)) { vp += atl; continue; }
                    memcpy(arm_ty, vp, atl);
                    arm_ty[atl] = 0;
                    vp += atl;
                    while (*vp == ';' || *vp == ' ') vp++;
                    hook = shadow_destroy_hook_for(arm_ty);
                    if (!hook || !hook[0]) continue;
                    dup = 0;
                    for (fi = 0; fi < nfwd; fi++)
                        if (strcmp(fwd_done[fi], hook) == 0) { dup = 1; break; }
                    if (dup) continue;
                    if (nfwd < 16) {
                        snprintf(fwd_done[nfwd], sizeof(fwd_done[0]),
                                 "%s", hook);
                        nfwd++;
                    }
                    if (!cemit_fmt(out, "static void %s(%s*);\n",
                                   hook, arm_ty))
                        return 0;
                }
            }
        }
        /* Emit @variant decls before any hoisted struct that embeds them
         * (RedisEntry.val : RedisValue). Mark with e="hoist" so the main
         * loop does not re-emit. */
        for (int i = 0; i < n; i++) {
            AstNode* vit;
            ShadowCtx vctx;
            if (items[i]->kind != AST_AT_STMT) continue;
            if (strcmp(items[i]->a, "variant") != 0) continue;
            if (items[i]->e[0] && strcmp(items[i]->e, "hoist") == 0) continue;
            vit = items[i];
            if (!shadow_emit_preamble(vit, out, cache)) return 0;
            vit->lead_len = 0;
            if (!shadow_emit_line(out, &line_ctx, vit, "")) return 0;
            memset(&vctx, 0, sizeof(vctx));
            vctx.cache = cache;
            if (!shadow_emit_stmt_ctx(vit, out, &vctx, "", 0)) return 0;
            snprintf(vit->e, sizeof(vit->e), "hoist");
        }
        for (int i = 0; i < n; i++) {
            if (items[i]->kind == AST_TYPEDEF_INT) {
                int needed = 0;
                int vi;
                if (items[i]->e[0] && strcmp(items[i]->e, "vech") == 0)
                    continue;
                /* Result aliases (`typedef Ok!>Err Alias`) — not every INT
                 * typedef. Hoisting `typedef CompressedResult* Ptr` before the
                 * struct leaves an incomplete type (pigz_cc). */
                if (items[i]->c[0] && items[i]->d[0]) needed = 1;
                /* Hoist when this alias is a Vec/Map element type name. */
                for (vi = 0; vi < g_shadow_nvecs && !needed; vi++)
                    if (strcmp(g_shadow_vecs[vi], items[i]->a) == 0) needed = 1;
                if (!needed) continue;
                if (!shadow_emit_preamble(items[i], out, cache)) return 0;
                items[i]->lead_len = 0;
                if (!shadow_emit_line(out, &line_ctx, items[i], "")) return 0;
                if (items[i]->c[0] && items[i]->d[0]) {
                    char rname[256];
                    shadow_result_name(items[i]->c, items[i]->d, rname,
                                       sizeof(rname));
                    if (!cemit_fmt(out, "typedef %s %s;\n", rname, items[i]->a))
                        return 0;
                } else if (items[i]->b[0]) {
                    /* ArrayMap_/Map_/CCVec_ aliases need DECL macros first —
                     * hoisting them early leaves RedisDbMap as an unknown
                     * incomplete type. */
                    if (strncmp(items[i]->b, "ArrayMap_", 9) == 0 ||
                        strncmp(items[i]->b, "Map_", 4) == 0 ||
                        strncmp(items[i]->b, "CCVec_", 6) == 0 ||
                        strncmp(items[i]->b, "CCSlice", 7) == 0)
                        continue;
                    if (!cemit_fmt(out, "typedef %s %s;\n", items[i]->b,
                                   items[i]->a))
                        return 0;
                } else if (!cemit_fmt(out, "typedef int %s;\n", items[i]->a)) {
                    return 0;
                }
                snprintf(items[i]->e, sizeof(items[i]->e), "vech");
            }
            if (items[i]->kind == AST_TYPEDEF_STRUCT) {
                /* Hoist Result Ok/Err arms, and factory-needed structs
                 * (py_expose::[T]). Do NOT hoist structs that embed
                 * ArrayMap_/Map_/CCVec_ for factory reasons alone — those
                 * DECL macros land after this pass; early hoist is what
                 * broke ArrayMap + BufReader:: in one TU. */
                const char* alias =
                    items[i]->b[0] ? items[i]->b : items[i]->a;
                int needed = 0;
                int needed_result = 0;
                int j;
                for (j = 0; j < nseen; j++) {
                    if (strcmp(seen_ok[j], alias) == 0 ||
                        strcmp(seen_err[j], alias) == 0) {
                        needed_result = 1;
                        break;
                    }
                    {
                        char okptr[128];
                        snprintf(okptr, sizeof(okptr), "%s*", alias);
                        if (strcmp(seen_ok[j], okptr) == 0) {
                            needed_result = 1;
                            break;
                        }
                    }
                }
                if (needed_result) {
                    needed = 1;
                } else if (shadow_alias_is_factory_type_arg(alias) &&
                           !shadow_typedef_struct_embeds_generic_container(
                               items[i])) {
                    needed = 1;
                }
                if (!needed) continue;
                /* Hoist field-type typedefs first (FaceA/FaceB / RedisReplyKind
                 * before DualFaceErr / RedisReply). */
                {
                    int k, j2;
                    for (k = 0; k < items[i]->nkids; k++) {
                        AstNode* f = items[i]->kids[k];
                        const char* fty;
                        if (!f || f->kind != AST_FIELD_SIMPLE) continue;
                        fty = f->a;
                        if (!fty || !fty[0] || ast_field_is_ptr(f)) continue;
                        for (j2 = 0; j2 < n; j2++) {
                            const char* a2;
                            if (items[j2]->kind == AST_TYPEDEF_ENUM) {
                                if (strcmp(items[j2]->e, "hoist") == 0)
                                    continue;
                                a2 = items[j2]->b;
                                if (!a2[0] || strcmp(a2, fty) != 0) continue;
                                if (!shadow_emit_preamble(items[j2], out, cache))
                                    return 0;
                                items[j2]->lead_len = 0;
                                if (!shadow_emit_line(out, &line_ctx, items[j2],
                                                       ""))
                                    return 0;
                                if (items[j2]->a[0]) {
                                    if (!cemit_fmt(out, "typedef enum %s {\n",
                                                   items[j2]->a))
                                        return 0;
                                } else if (!cemit_str(out, "typedef enum {\n")) {
                                    return 0;
                                }
                                if (items[j2]->d[0] &&
                                    !cemit_str(out, items[j2]->d))
                                    return 0;
                                if (items[j2]->d[0] && !cemit_str(out, "\n"))
                                    return 0;
                                if (!cemit_fmt(out, "} %s;\n\n", items[j2]->b))
                                    return 0;
                                snprintf(items[j2]->e, sizeof(items[j2]->e),
                                         "hoist");
                                continue;
                            }
                            if (items[j2]->kind != AST_TYPEDEF_STRUCT)
                                continue;
                            if (strcmp(items[j2]->e, "hoist") == 0) continue;
                            a2 = items[j2]->b[0] ? items[j2]->b
                                                 : items[j2]->a;
                            if (strcmp(a2, fty) != 0) continue;
                            if (!shadow_emit_preamble(items[j2], out, cache))
                                return 0;
                            items[j2]->lead_len = 0;
                            if (!shadow_emit_line(out, &line_ctx, items[j2],
                                                   ""))
                                return 0;
                            if (!shadow_emit_typedef_struct(items[j2], out,
                                                            cache, &line_ctx))
                                return 0;
                            snprintf(items[j2]->e, sizeof(items[j2]->e),
                                     "hoist");
                        }
                    }
                }
                if (!shadow_emit_preamble(items[i], out, cache)) return 0;
                items[i]->lead_len = 0;
                if (!shadow_emit_line(out, &line_ctx, items[i], "")) return 0;
                if (!shadow_emit_typedef_struct(items[i], out, cache, &line_ctx))
                    return 0;
                snprintf(items[i]->e, sizeof(items[i]->e), "hoist");
            } else if (items[i]->kind == AST_TYPEDEF_FN_PTR) {
                char params[512];
                shadow_fnptr_ty_register(items[i]->b);
                if (!shadow_emit_preamble(items[i], out, cache)) return 0;
                items[i]->lead_len = 0;
                if (!shadow_emit_line(out, &line_ctx, items[i], "")) return 0;
                snprintf(params, sizeof(params), "%s",
                         items[i]->c[0] ? items[i]->c : "void");
                if (!cemit_fmt(out, "typedef %s (*%s)(%s);\n",
                               items[i]->a, items[i]->b, params))
                    return 0;
            }
        }
    }
    /* Typedefs named as Vec/slice elems or Map K/V bases (Entry, Pt, …)
     * before CC_VEC / CC_MAP / CCSlice factory emit. Skip ones already Result-hoisted. */
    {
        int i, vi;
        for (i = 0; i < n; i++) {
            AstNode* it = items[i];
            const char* alias;
            int needed = 0;
            if (!it || it->kind != AST_TYPEDEF_STRUCT) continue;
            if (strcmp(it->e, "hoist") == 0 || strcmp(it->e, "vech") == 0)
                continue;
            alias = it->b[0] ? it->b : it->a;
            if (!alias[0]) continue;
            for (vi = 0; vi < g_shadow_nvecs; vi++) {
                if (strcmp(g_shadow_vecs[vi], alias) == 0) {
                    needed = 1;
                    break;
                }
            }
            for (vi = 0; vi < g_shadow_nslices && !needed; vi++) {
                if (strcmp(g_shadow_slices[vi], alias) == 0) needed = 1;
            }
            for (vi = 0; vi < g_shadow_nmaps && !needed; vi++) {
                if (shadow_kv_compact_has_alias(g_shadow_maps[vi], alias))
                    needed = 1;
            }
            for (vi = 0; vi < g_shadow_nginst && !needed; vi++) {
                if (!shadow_ginst_after_vec(g_shadow_ginst[vi].family))
                    continue;
                if (shadow_kv_compact_has_alias(g_shadow_ginst[vi].compact,
                                               alias))
                    needed = 1;
            }
            for (vi = 0; vi < g_shadow_namaps && !needed; vi++) {
                if (shadow_kv_compact_has_alias(g_shadow_amaps[vi], alias))
                    needed = 1;
            }
            if (!needed) continue;
            if (!shadow_emit_preamble(it, out, cache)) return 0;
            it->lead_len = 0;
            if (!shadow_emit_line(out, &line_ctx, it, "")) return 0;
            if (!shadow_emit_typedef_struct(it, out, cache, &line_ctx))
                return 0;
            /* Skip duplicate emit in the main loop. */
            snprintf(it->e, sizeof(it->e), "vech");
        }
    }
    /* Factory bodies may land before helpers that live next to a hoisted
     * type-arg typedef (BufReader::[MemReader] fill's _Generic arms). Emit
     * forward decls for C-spelled helpers so every arm typechecks.
     * Skip AST_RESULT_FN (`T!>(E)`): early mangled Result names race
     * py_expose method wrappers and types not yet declared. */
    if (kind == SHADOW_EMIT_C && cache) {
        int i, j;
        char fwd_seen[32][64];
        int nfwd = 0;
        for (i = 0; i < n; i++) {
            AstNode* td = items[i];
            const char* alias;
            if (!td || td->kind != AST_TYPEDEF_STRUCT) continue;
            alias = td->b[0] ? td->b : td->a;
            if (!alias[0] || !shadow_alias_is_factory_type_arg(alias)) continue;
            for (j = 0; j < n; j++) {
                AstNode* fn = items[j];
                const char* params = NULL;
                if (!fn) continue;
                if (fn->kind == AST_STATIC_FN || fn->kind == AST_FN_PROTO) {
                    const char* pref =
                        (fn->kind == AST_FN_PROTO &&
                         strcmp(fn->e, "extern") == 0)
                            ? "extern "
                        : (fn->kind == AST_STATIC_FN)
                            ? ((fn->e[0] && strcmp(fn->e, "inline") == 0)
                                   ? "static inline "
                                   : "static ")
                            : "";
                    char params_buf[512];
                    char ret_buf[192];
                    params = fn->c[0] ? fn->c : "void";
                    if (!shadow_params_mention_type(params, alias)) continue;
                    snprintf(params_buf, sizeof(params_buf), "%s", params);
                    shadow_normalize_chan_params(params_buf,
                                                 sizeof(params_buf));
                    shadow_normalize_slice_sugar_sig(params_buf,
                                                     sizeof(params_buf));
                    snprintf(ret_buf, sizeof(ret_buf), "%s", fn->a);
                    shadow_normalize_slice_sugar_sig(ret_buf, sizeof(ret_buf));
                    if (!shadow_emit_fwd_structs_in_text(items, n, ret_buf,
                                                         alias, out, fwd_seen,
                                                         &nfwd, 32))
                        return 0;
                    if (!shadow_emit_fwd_structs_in_text(items, n, params_buf,
                                                         alias, out, fwd_seen,
                                                         &nfwd, 32))
                        return 0;
                    if (!cemit_fmt(out, "%s%s %s(%s);\n", pref, ret_buf,
                                   fn->b, params_buf))
                        return 0;
                }
            }
        }
        if (!cemit_str(out, "\n")) return 0;
    }
    /* Extracted chapter includes stay in source order (below a TU typedef).
     * Includes that precede every type decl must go out before factory
     * bodies — `BufReader::[MemReader]` names a type that lives only in
     * that `.h`. Do not splice every quoted `.cch` from a `.ccs` to get
     * this; that inlines helpers and breaks header-line provenance. */
    if (kind == SHADOW_EMIT_C && g_shadow_nginst > 0) {
        int hi;
        for (hi = 0; hi < n; hi++) {
            if (shadow_item_is_type_decl(items[hi])) break;
            if (!shadow_raw_is_quoted_include(items[hi])) continue;
            if (items[hi]->e[0] && strcmp(items[hi]->e, "ginc") == 0)
                continue;
            if (!shadow_emit_line(out, &line_ctx, items[hi], ""))
                return 0;
            if (!shadow_emit_quoted_include_text(out, items[hi]->a))
                return 0;
            snprintf(items[hi]->e, sizeof(items[hi]->e), "ginc");
        }
    }
    /* Family factory bodies after typedef hoist so user types (Counter) are complete.
     * Phase 0: CCSlice + user; 1: Vec; 2: Map / ArrayMap (nested
     * Map::[K, Vec::[T]] sees CCVec_T). */
    int ginst_phase = 0;
ginst_emit_pass:
    if (kind == SHADOW_EMIT_C && cache) {
        if (ginst_phase == 1 && g_shadow_nvecs > 0) {
            if (!cemit_str(out, "#include <ccc/std/vec.h>\n"
                                "#include <ccc/cc_type.h>\n"))
                return 0;
            for (int vi = 0; vi < g_shadow_nvecs; vi++) {
                const char* t = g_shadow_vecs[vi];
                int ai;
                for (ai = 0; ai < n; ai++) {
                    if (items[ai]->kind != AST_TYPEDEF_INT) continue;
                    if (strcmp(items[ai]->e, "vech") == 0) continue;
                    if (!items[ai]->a[0] || strcmp(items[ai]->a, t) != 0)
                        continue;
                    if (!items[ai]->b[0] ||
                        strncmp(items[ai]->b, "CCVec_", 6) != 0)
                        continue;
                    if (!cemit_fmt(out, "typedef %s %s;\n",
                                   items[ai]->b, items[ai]->a))
                        return 0;
                    snprintf(items[ai]->e, sizeof(items[ai]->e), "vech");
                }
            }
        }
        /* Instantiate CC_GENERIC_FACTORY templates / compiled factories. */
        for (int ii = 0; ii < g_shadow_nginst; ii++) {
            ShadowGenericInst* inst = &g_shadow_ginst[ii];
            if (shadow_ginst_phase(inst->family) != ginst_phase)
                continue;
            const char* tpl = NULL;
            char args[8][64];
            char args128[8][128];
            int nargs = 0;
            /* Arena-backed def text — py_module::[T] with hundreds of methods
             * outgrows any fixed stack buffer. */
            CCArena def_ar = cc_arena_heap(64 * 1024);
            char* body = NULL;
            int fi;
            if (!cc_arena_is_live(def_ar)) {
                fprintf(stderr,
                        "error: generic factory def arena create failed\n");
                out->err = 1;
                return 0;
            }
            for (fi = 0; fi < g_shadow_ngfac; fi++) {
                if (strcmp(g_shadow_gfac[fi].family, inst->family) == 0) {
                    tpl = g_shadow_gfac[fi].tpl;
                    break;
                }
            }
            /* No compiler-native Vec/Map/ArrayMap/CCSlice DECL. A missing
             * factory is a use-site error. Beachhead stub TUs skip a harvested
             * CCSlice splice; they must not swallow a missing factory. */
            if (g_shadow_slice_stub && strcmp(inst->family, "CCSlice") == 0 &&
                tpl) {
                cc_arena_free(&def_ar);
                continue;
            }
            if (strcmp(inst->family, "Vec") == 0 &&
                shadow_vec_already(inst->compact)) {
                cc_arena_free(&def_ar);
                continue;
            }
            if (strcmp(inst->family, "Map") == 0 &&
                shadow_map_already(inst->compact)) {
                cc_arena_free(&def_ar);
                continue;
            }
            if (strcmp(inst->family, "ArrayMap") == 0 &&
                shadow_amap_already(inst->compact)) {
                cc_arena_free(&def_ar);
                continue;
            }
            {
                int ai;
                if (inst->nargs > 0) {
                    nargs = inst->nargs;
                    if (nargs > 8) nargs = 8;
                    for (ai = 0; ai < nargs; ai++) {
                        snprintf(args[ai], sizeof(args[ai]), "%s",
                                 inst->args[ai]);
                        snprintf(args128[ai], sizeof(args128[ai]), "%s",
                                 inst->args[ai]);
                        shadow_map_decode_ptr_arg(args[ai], sizeof(args[ai]));
                        shadow_map_decode_ptr_arg(args128[ai],
                                                  sizeof(args128[ai]));
                    }
                } else {
                const char* p = inst->compact;
                if (strcmp(inst->family, "Vec") == 0) {
                    /* Compact is the whole element (size_t, long_long, Tptr). */
                    snprintf(args[0], sizeof(args[0]), "%s", p);
                    snprintf(args128[0], sizeof(args128[0]), "%s", p);
                    nargs = 1;
                    shadow_map_decode_ptr_arg(args[0], sizeof(args[0]));
                    shadow_map_decode_ptr_arg(args128[0], sizeof(args128[0]));
                } else if (shadow_ginst_after_vec(inst->family)) {
                    /* Compact is K_V; underscored C types stay one key token. */
                    int klen = shadow_kv_compact_key_len(p);
                    size_t kn;
                    if (klen > 0) {
                        kn = (size_t)klen;
                        if (kn >= sizeof(args[0])) kn = sizeof(args[0]) - 1;
                        memcpy(args[0], p, kn);
                        args[0][kn] = 0;
                        snprintf(args[1], sizeof(args[1]), "%s",
                                 p + klen + (p[klen] == '_' ? 1 : 0));
                        snprintf(args128[0], sizeof(args128[0]), "%s",
                                 args[0]);
                        snprintf(args128[1], sizeof(args128[1]), "%s",
                                 args[1]);
                        nargs = 2;
                    }
                } else {
                    while (*p && nargs < 8) {
                        size_t n = 0;
                        while (p[n] && p[n] != '_') n++;
                        if (n >= sizeof(args[0])) n = sizeof(args[0]) - 1;
                        memcpy(args[nargs], p, n);
                        args[nargs][n] = 0;
                        snprintf(args128[nargs], sizeof(args128[0]), "%s",
                                 args[nargs]);
                        nargs++;
                        p += n;
                        if (*p == '_') p++;
                    }
                }
                if (shadow_ginst_after_vec(inst->family) && nargs >= 2) {
                    shadow_map_decode_ptr_arg(args[1], sizeof(args[1]));
                    shadow_map_decode_ptr_arg(args128[1], sizeof(args128[1]));
                }
                }
            }
            {
                FileTape* root = cache->n > 0 ? cache->items[0] : NULL;
                const char* path = root && root->path ? root->path : "";
                const char* rsrc = root && root->bytes ? root->bytes : "";
                int use_line = 1, use_col = 5;
                if (rsrc) {
                    char needle[128];
                    const char* hit = NULL;
                    snprintf(needle, sizeof(needle), "%s::[", inst->family);
                    hit = strstr(rsrc, needle);
                    if (!hit) hit = strstr(rsrc, inst->mangled);
                    if (hit) {
                        const char* p;
                        use_line = 1;
                        use_col = 1;
                        for (p = rsrc; p < hit; p++) {
                            if (*p == '\n') {
                                use_line++;
                                use_col = 1;
                            } else
                                use_col++;
                        }
                    }
                }
                /* Prefer the compiled/registered factory when present.
                 * Textual tpl extraction only sees the first `@emit(\`…\`)`
                 * and cannot expand runtime slots like `${nm}` / `${box}`. */
                if (cc_emit_plan_has_generic_factory(inst->family)) {
                    char err[512];
                    size_t rlen = root ? root->len : 0;
                    int frag_line = 0;
                    CCGenProduceStatus st = cc_emit_plan_produce_generic_def(
                        inst->family, inst->mangled, args128, nargs, rsrc,
                        rlen, path, &def_ar, &body, err, sizeof(err));
                    if (st != CC_GEN_PRODUCE_OK) {
                        const char* path_base = path;
                        const char* slash = path_base ? strrchr(path_base, '/')
                                                     : NULL;
                        const char* tests = path_base ? strstr(path_base, "tests/")
                                                     : NULL;
                        if (tests)
                            path_base = tests;
                        else if (slash && slash[1])
                            path_base = slash + 1;
                        fprintf(stderr,
                                "%s:%d:%d: error: type: compiled generic "
                                "factory '%s' %s%s%s\n",
                                path_base && path_base[0] ? path_base
                                                          : "<input>",
                                use_line, use_col, inst->family,
                                st == CC_GEN_PRODUCE_ENSURE_FAILED
                                    ? "failed to compile"
                                    : "produced invalid C for '",
                                st == CC_GEN_PRODUCE_ENSURE_FAILED
                                    ? ""
                                    : inst->mangled,
                                st == CC_GEN_PRODUCE_ENSURE_FAILED ? "" : "'");
                        if (err[0]) fprintf(stderr, "  %s\n", err);
                        shadow_gfac_note_handler(inst->family, path);
                        out->err = 1;
                        cc_arena_free(&def_ar);
                        return 0;
                    }
                    if (!body) body = "";
                    if (cc_emit_plan_take_exec_error()) {
                        fprintf(stderr,
                                "%s:%d:%d: error: type: compiled generic "
                                "factory '%s' reported an error for '%s'\n",
                                path[0] ? path : "<input>", use_line, use_col,
                                inst->family, inst->mangled);
                        out->err = 1;
                        cc_arena_free(&def_ar);
                        return 0;
                    }
                    if (cc_comptime_validate_c_fragment(body, &frag_line, err,
                                                        sizeof(err)) != 0) {
                        if (cc_emit_plan_generic_invalid_report_once(
                                inst->mangled)) {
                            const char* path_base = path;
                            const char* slash =
                                path_base ? strrchr(path_base, '/') : NULL;
                            const char* tests =
                                path_base ? strstr(path_base, "tests/") : NULL;
                            if (tests)
                                path_base = tests;
                            else if (slash && slash[1])
                                path_base = slash + 1;
                            fprintf(stderr,
                                    "%s:%d:%d: error: type: compiled generic "
                                    "factory '%s' produced invalid C for "
                                    "'%s'\n",
                                    path_base && path_base[0] ? path_base
                                                              : "<input>",
                                    use_line, use_col, inst->family,
                                    inst->mangled);
                            if (frag_line > 0)
                                fprintf(stderr,
                                        "note: in generated definition, "
                                        "line %d\n",
                                        frag_line);
                            if (body[0]) {
                                const char* nl = strchr(body, '\n');
                                fprintf(stderr, ">    %d | %.*s\n",
                                        frag_line > 0 ? frag_line : 1,
                                        nl ? (int)(nl - body)
                                           : (int)strlen(body),
                                        body);
                            }
                            fprintf(stderr,
                                    "note: re-run with --emit-c-inspect to "
                                    "dump the full translation unit\n");
                            shadow_gfac_note_handler(inst->family, path);
                            if (fi < g_shadow_ngfac &&
                                g_shadow_gfac[fi].origin_file[0]) {
                                fprintf(stderr,
                                        "note: in @comptime factory "
                                        "'__cc_gfac_%s' at %s:%d\n",
                                        inst->family,
                                        g_shadow_gfac[fi].origin_file,
                                        g_shadow_gfac[fi].origin_line);
                            }
                        }
                        out->err = 1;
                        cc_arena_free(&def_ar);
                        return 0;
                    }
                } else if (tpl) {
                    int frag_line = 0;
                    char verr[256];
                    const char* path_base = path;
                    const char* slash;
                    int oob_arg = -1;
                    int irc;
                    size_t tpl_cap = 256 * 1024;
                    if (fi < g_shadow_ngfac && !g_shadow_gfac[fi].has_base) {
                        const char* tests = path ? strstr(path, "tests/") : NULL;
                        const char* pb = tests ? tests : path;
                        slash = pb ? strrchr(pb, '/') : NULL;
                        if (!tests && slash && slash[1]) pb = slash + 1;
                        fprintf(stderr,
                                "%s:%d:%d: error: type: compiled generic "
                                "factory '%s' failed to compile: generic '%s' "
                                "is extended but never defined (needs "
                                "CC_GENERIC_FACTORY(%s) or "
                                "cc_generic_register)\n",
                                pb && pb[0] ? pb : "<input>", use_line,
                                use_col, inst->family, inst->family,
                                inst->family);
                        out->err = 1;
                        cc_arena_free(&def_ar);
                        return 0;
                    }
                    body = (char*)cc_arena_alloc(&def_ar, tpl_cap, 1);
                    if (!body) {
                        fprintf(stderr,
                                "error: generic tpl buffer arena OOM for %s\n",
                                inst->mangled);
                        out->err = 1;
                        cc_arena_free(&def_ar);
                        return 0;
                    }
                    body[0] = 0;
                    irc = shadow_inst_generic_tpl(tpl, inst->mangled, args,
                                                  nargs, body, tpl_cap,
                                                  &oob_arg);
                    if (irc < 0) {
                        const char* tests = path ? strstr(path, "tests/") : NULL;
                        const char* pb = tests ? tests : path;
                        slash = pb ? strrchr(pb, '/') : NULL;
                        if (!tests && slash && slash[1]) pb = slash + 1;
                        fprintf(stderr,
                                "%s:%d: error: factory '%s': arg(%d) is out of "
                                "range (%d type argument%s)\n",
                                pb && pb[0] ? pb : "<input>", use_line,
                                inst->family, oob_arg, nargs,
                                nargs == 1 ? "" : "s");
                        out->err = 1;
                        cc_arena_free(&def_ar);
                        return 0;
                    }
                    if (irc == 0) {
                        fprintf(stderr,
                                "error: generic instantiate failed for %s\n",
                                inst->mangled);
                        out->err = 1;
                        cc_arena_free(&def_ar);
                        return 0;
                    }
                    if (cc_comptime_validate_c_fragment(body, &frag_line, verr,
                                                        sizeof(verr)) != 0) {
                        slash = path_base ? strrchr(path_base, '/') : NULL;
                        if (slash && slash[1]) path_base = slash + 1;
                        fprintf(stderr,
                                "%s:%d:%d: error: type: compiled generic "
                                "factory '%s' produced invalid C for '%s'\n",
                                path_base && path_base[0] ? path_base
                                                          : "<input>",
                                use_line, use_col, inst->family,
                                inst->mangled);
                        if (frag_line > 0)
                            fprintf(stderr,
                                    "note: in generated definition, line %d\n",
                                    frag_line);
                        if (body[0]) {
                            const char* nl = strchr(body, '\n');
                            fprintf(stderr, ">    %d | %.*s\n",
                                    frag_line > 0 ? frag_line : 1,
                                    nl ? (int)(nl - body) : (int)strlen(body),
                                    body);
                        }
                        fprintf(stderr,
                                "note: re-run with --emit-c-inspect to dump "
                                "the full translation unit\n");
                        if (fi < g_shadow_ngfac &&
                            g_shadow_gfac[fi].origin_file[0]) {
                            fprintf(stderr,
                                    "note: in @comptime factory "
                                    "'__cc_gfac_%s' at %s:%d\n",
                                    inst->family,
                                    g_shadow_gfac[fi].origin_file,
                                    g_shadow_gfac[fi].origin_line);
                        }
                        out->err = 1;
                        cc_arena_free(&def_ar);
                        return 0;
                    }
                } else {
                    const char* tests = path ? strstr(path, "tests/") : NULL;
                    const char* pb = tests ? tests : path;
                    const char* slash = pb ? strrchr(pb, '/') : NULL;
                    char fams[512];
                    if (!tests && slash && slash[1]) pb = slash + 1;
                    fprintf(stderr,
                            "%s:%d:%d: error: type: no generic factory for "
                            "'%s'\n",
                            pb && pb[0] ? pb : "<input>", use_line, use_col,
                            inst->family);
                    if (strcmp(inst->family, "Vec") == 0)
                        fprintf(stderr,
                                "  note: include <ccc/std/vec.cch> or "
                                "<ccc/std/prelude.cch> "
                                "(CC_GENERIC_FACTORY(Vec))\n");
                    else if (strcmp(inst->family, "Map") == 0)
                        fprintf(stderr,
                                "  note: include <ccc/std/map_forward.cch> or "
                                "<ccc/std/prelude.cch> "
                                "(CC_GENERIC_FACTORY(Map))\n");
                    else if (strcmp(inst->family, "ArrayMap") == 0)
                        fprintf(stderr,
                                "  note: include <ccc/std/array_map.cch> or "
                                "<ccc/std/prelude.cch> "
                                "(CC_GENERIC_FACTORY(ArrayMap))\n");
                    else if (strcmp(inst->family, "CCSlice") == 0)
                        fprintf(stderr,
                                "  note: include <ccc/cc_slice.cch> or "
                                "<ccc/std/prelude.cch> "
                                "(CC_GENERIC_FACTORY(CCSlice))\n");
                    else
                        fprintf(stderr,
                                "  note: define CC_GENERIC_FACTORY(%s) or "
                                "cc_generic_register(\"%s\", ...)\n",
                                inst->family, inst->family);
                    if (cc_emit_plan_generic_factory_names_csv(fams,
                                                               sizeof(fams)) >
                        0)
                        fprintf(stderr,
                                "  note: registered generic factory families: "
                                "%s\n",
                                fams);
                    out->err = 1;
                    cc_arena_free(&def_ar);
                    return 0;
                }
                if (!cemit_fmt(out, "/* generic %s */\n", inst->mangled)) {
                    cc_arena_free(&def_ar);
                    return 0;
                }
                if (!cemit_str(out, body)) {
                    cc_arena_free(&def_ar);
                    return 0;
                }
                if (!cemit_str(out, "\n\n")) {
                    cc_arena_free(&def_ar);
                    return 0;
                }
                shadow_ginst_ufcs_harvest_body(inst->mangled, body);
            }
            cc_arena_free(&def_ar);
        }
    }

    /* Leftover slice DECL after phase-0 factories, then Vec, then Map. */
    if (kind == SHADOW_EMIT_C && cache) {
        if (ginst_phase == 0) {
            if (g_shadow_nslices > 0 && !g_shadow_slice_stub) {
                int si, any = 0;
                for (si = 0; si < g_shadow_nslices; si++) {
                    if (!shadow_ginst_has("CCSlice", g_shadow_slices[si]))
                        any = 1;
                }
                if (any) {
                    if (!cemit_str(out, "#include <ccc/cc_slice.h>\n"))
                        return 0;
                    for (si = 0; si < g_shadow_nslices; si++) {
                        if (shadow_ginst_has("CCSlice", g_shadow_slices[si]))
                            continue;
                        if (!cemit_fmt(out, "CC_DECL_SLICE(%s)\n",
                                       g_shadow_slices[si]))
                            return 0;
                    }
                    if (!cemit_str(out, "\n")) return 0;
                }
            }
            ginst_phase = 1;
            goto ginst_emit_pass;
        }
        if (ginst_phase == 1) {
            ginst_phase = 2;
            goto ginst_emit_pass;
        }
    }
    /* Detect __spawn_into_call in fn bodies (typed inits / assigns). */
    for (int i = 0; i < n && !need_spawn_into; i++) {
        AstNode* it = items[i];
        if (!it || !it->kids) continue;
        for (int k = 0; k < it->nkids; k++) {
            AstNode* s = it->kids[k];
            if (!s) continue;
            if (strstr(s->a, "__spawn_into") || strstr(s->b, "__spawn_into") ||
                strstr(s->c, "__spawn_into") || strstr(s->d, "__spawn_into") ||
                strstr(s->e, "__spawn_into")) {
                need_spawn_into = 1;
                break;
            }
            if (s->kind == AST_BLOCK) {
                for (int b = 0; b < s->nbody; b++) {
                    AstNode* t = s->body[b];
                    if (!t) continue;
                    if (strstr(t->a, "__spawn_into") || strstr(t->b, "__spawn_into") ||
                        strstr(t->c, "__spawn_into") || strstr(t->d, "__spawn_into") ||
                        strstr(t->e, "__spawn_into")) {
                        need_spawn_into = 1;
                        break;
                    }
                }
            }
            if (need_spawn_into) break;
        }
    }
    if (need_spawn_into && kind == SHADOW_EMIT_C) {
        if (!cemit_str(out, "#include <ccc/cc_closure_helper.h>\n\n")) return 0;
    }
    /* Pull in cc_result.h for runtime error arms / Result API names. Local
     * `Err` stubs (mini) stay self-contained for host `cc -c` without -I. */
    if (kind == SHADOW_EMIT_C && nseen && !has_result_hdr) {
        int need_err_hdr = 0;
        for (int i = 0; i < nseen; i++) {
            if (strcmp(seen_err[i], "CCError") == 0 ||
                strcmp(seen_ok[i], "CCError") == 0) {
                need_err_hdr = 1;
                break;
            }
        }
        for (int i = 0; i < n && !need_err_hdr; i++)
            need_err_hdr = shadow_node_needs_result_api(items[i]);
        if (need_err_hdr) {
            if (!cemit_str(out, "#include <ccc/cc_result.h>\n")) return 0;
            has_result_hdr = 1;
        }
    }
    /* Result specs wait until the first AST_RESULT_FN so a quoted include
     * that defines E (or a TU typedef just above the fn) is already out. */
    {
        int has_slice_rt = 0, has_chan_rt = 0;
        for (int i = 0; i < npass_inc; i++) {
            if (strstr(pass_inc[i], "cc_slice") ||
                strstr(pass_inc[i], "cc_runtime") ||
                strstr(pass_inc[i], "prelude"))
                has_slice_rt = 1;
            if (strstr(pass_inc[i], "cc_channel") ||
                strstr(pass_inc[i], "cc_chan") ||
                strstr(pass_inc[i], "cc_runtime") ||
                strstr(pass_inc[i], "prelude"))
                has_chan_rt = 1;
        }
        /* Prefer real types whenever runtime headers are included. */
        g_shadow_slice_stub = !has_slice_rt;
        g_shadow_chan_stub = !has_chan_rt;
    }
    if (need_slice && g_shadow_slice_stub) {
        if (!cemit_str(out, "typedef struct { int *ptr; size_t len; } CCShadowSlice_int;\n\n"))
            return 0;
    }
    if (need_chan && g_shadow_chan_stub) {
        if (!cemit_str(out, "typedef struct { int unused; } CCShadowChan_int;\n\n"))
            return 0;
    }

    for (int i = 0; i < n; i++) {
        AstNode* it = items[i];
        if (!specs_emitted && nseen && it->kind == AST_RESULT_FN) {
            if (!shadow_emit_collected_result_specs(out, seen_ok, seen_err,
                                                    nseen, 0))
                return 0;
            specs_emitted = 1;
        }
        if (!shadow_emit_preamble(it, out, cache)) return 0;
        it->lead_len = 0;
        if (it->e[0] && strcmp(it->e, "ginc") == 0)
            continue;
        if (!shadow_emit_line(out, &line_ctx, it, "")) return 0;
        switch (it->kind) {
        case AST_TYPEDEF_INT:
            if (strcmp(it->e, "vech") == 0) break; /* hoisted before Vec/Map */
            if (it->c[0] && it->d[0]) {
                char rname[256];
                shadow_result_name(it->c, it->d, rname, sizeof(rname));
                if (!cemit_fmt(out, "typedef %s %s;\n", rname, it->a))
                    return 0;
            } else if (it->b[0]) {
                shadow_register_mangled_ty(it->b);
                shadow_ginst_need_from_type(it->b);
                shadow_td_alias_register(it->a, it->b);
                if (!cemit_fmt(out, "typedef %s %s;\n", it->b, it->a))
                    return 0;
            } else if (!cemit_fmt(out, "typedef int %s;\n", it->a)) {
                return 0;
            }
            break;
        case AST_TYPEDEF_STRUCT:
            if (strcmp(it->e, "hoist") == 0 || strcmp(it->e, "vech") == 0)
                break; /* already emitted before Result/Vec macros */
            if (!shadow_emit_typedef_struct(it, out, cache, &line_ctx))
                return 0;
            break;
        case AST_TYPEDEF_ENUM: {
            if (strcmp(it->e, "hoist") == 0)
                break; /* already emitted before Result specs */
            /* Enumerators can exceed cemit_fmt's 512 temp — emit in pieces. */
            if (it->a[0]) {
                if (!cemit_fmt(out, "typedef enum %s {\n", it->a)) return 0;
            } else {
                if (!cemit_str(out, "typedef enum {\n")) return 0;
            }
            if (it->d[0] && !cemit_str(out, it->d)) return 0;
            if (it->d[0] && !cemit_str(out, "\n")) return 0;
            if (!cemit_fmt(out, "} %s;\n\n", it->b)) return 0;
            break;
        }
        case AST_TYPEDEF_FN_PTR:
            shadow_fnptr_ty_register(it->b);
            if (hoist_typedefs) break; /* already emitted before Result specs */
            {
                char params[512];
                snprintf(params, sizeof(params), "%s",
                         it->c[0] ? it->c : "void");
                if (!cemit_fmt(out, "typedef %s (*%s)(%s);\n", it->a, it->b,
                               params))
                    return 0;
            }
            break;
        case AST_TYPEDEF_CHAN:
            shadow_chan_register_node(it);
            if (it->c[0] == '<') {
                if (!cemit_fmt(out, "typedef CCChanRx %s;\n\n", it->a)) return 0;
            } else {
                if (!cemit_fmt(out, "typedef CCChanTx %s;\n\n", it->a)) return 0;
            }
            break;
        case AST_FN_PROTO: {
            char* heap = NULL;
            char small[2048];
            char ret[192];
            const char* raw = it->c[0] ? it->c : NULL;
            const char* params;
            const char* pref =
                (strcmp(it->e, "extern") == 0) ? "extern " : "";
            snprintf(ret, sizeof(ret), "%s", it->a[0] ? it->a : "int");
            shadow_rewrite_slice_types(ret, sizeof(ret));
            if (!raw) {
                raw = shadow_raw_field_cstr(cache, it, small, sizeof(small),
                                            &heap);
            }
            if (!raw || !raw[0]) {
                snprintf(small, sizeof(small), "void");
            } else if (raw == small) {
                /* already in small from the raw-field helper */
            } else {
                snprintf(small, sizeof(small), "%s", raw);
            }
            shadow_normalize_chan_params(small, sizeof(small));
            shadow_rewrite_slice_types(small, sizeof(small));
            params = small;
            if (!cemit_str(out, pref) || !cemit_str(out, ret) ||
                !cemit_str(out, " ") || !cemit_str(out, it->b) ||
                !cemit_str(out, "(") || !cemit_str(out, params) ||
                !cemit_str(out, ");\n")) {
                free(heap);
                return 0;
            }
            free(heap);
            break;
        }
        case AST_VAR_INT:
            if (!cemit_fmt(out, "int %s;\n", it->a)) return 0;
            break;
        case AST_PTR_DECL:
            if (!cemit_fmt(out, "%s *%s;\n", it->a, it->b)) return 0;
            break;
        case AST_RESULT_FN: {
            char rname[256];
            char ok_host[128];
            shadow_result_ok_buf(ok_host, sizeof(ok_host), it->c);
            shadow_result_name(ok_host, it->b, rname, sizeof(rname));
            shadow_rfn_register(it->a, rname, it->b);
            const char* pref =
                (strcmp(it->e, "static inline") == 0) ? "static inline "
                : (strcmp(it->e, "static") == 0)      ? "static "
                                                       : "";
            /* Match AstNode.d (4096): multi-line redis Result protos exceed 288. */
            char dparams[4096];
            snprintf(dparams, sizeof(dparams), "%s",
                     it->d[0] ? it->d : "void");
            shadow_rewrite_slice_types(dparams, sizeof(dparams));
            shadow_normalize_chan_params(dparams, sizeof(dparams));
            if (it->nkids == 0) {
                if (!cemit_fmt(out, "%s%s %s(%s);\n", pref, rname, it->a, dparams))
                    return 0;
                break;
            }
            if (kind == SHADOW_EMIT_H) {
                fprintf(stderr, "error: result fn body not allowed in .cch → .h (%s)\n",
                        it->a);
                out->err = 1;
                return 0;
            }
            char body_ind[64];
            int bind_mark = shadow_push_fn_binds(it);
            int bind_ok = 1;
            AstNode* pars[16];
            int npars = 0;
            for (int k = 0; bind_ok && k < it->nkids; k++) {
                if (!shadow_collect_parallels(it->kids[k], pars, &npars, 16)) {
                    fprintf(stderr,
                            "error: too many @parallel for shadow beachhead\n");
                    out->err = 1;
                    bind_ok = 0;
                }
            }
            if (bind_ok && !shadow_emit_par_protos(out, pars, npars))
                bind_ok = 0;
            if (bind_ok &&
                !cemit_fmt(out, "%s%s %s(%s) {\n", pref, rname, it->a,
                           dparams))
                bind_ok = 0;
            if (!bind_ok) {
                shadow_pop_fn_binds(bind_mark);
                return 0;
            }
            shadow_pick_body_indent(it->kids, it->nkids, body_ind, sizeof(body_ind));
            ShadowCtx ctx = { .rname = rname, .cache = cache,
                              .body_indent = body_ind };
            AstNode* defers[16];
            AstNode* destroys[32];
            int ndefers = 0;
            int ndestroys = 0;
            for (int k = 0; k < it->nkids; k++) {
                if (!shadow_collect_scope_defers(&it->kids[k], 1, defers,
                                                 &ndefers, 16)) {
                    fprintf(stderr, "error: too many @defer for shadow beachhead\n");
                    out->err = 1;
                    bind_ok = 0;
                    break;
                }
                /* Fn-level @destroy only (block-scoped destroys emit at block end). */
                if (shadow_stmt_is_destroy(it->kids[k])) {
                    if (ndestroys >= 32) {
                        fprintf(stderr, "error: too many @destroy for shadow beachhead\n");
                        out->err = 1;
                        bind_ok = 0;
                        break;
                    }
                    destroys[ndestroys++] = it->kids[k];
                }
            }
            if (bind_ok) {
                ctx.defers = defers;
                ctx.ndefers = ndefers;
                ctx.destroys = destroys;
                ctx.ndestroys = ndestroys;
                ctx.defer_cleanup = ndefers > 0;
                ctx.goto_cleanup = (ndestroys > 0 || ndefers > 0);
                ctx.soft_ret_ty = rname;
                shadow_vdrop_mark_push(&ctx);
                if (ctx.goto_cleanup) {
                    if (ctx.defer_cleanup) {
                        if (!cemit_fmt(out,
                                "%s%s __cc_retval = {0};\n"
                                "%sint __cc_ret_set = 0;\n"
                                "%sint __cc_ret_err = 0;\n"
                                "%sint __cc_defer_hw = 0;\n",
                                body_ind, rname, body_ind, body_ind, body_ind))
                            bind_ok = 0;
                        if (bind_ok &&
                            !shadow_emit_named_defer_flags(out, defers, ndefers,
                                                           body_ind))
                            bind_ok = 0;
                    } else if (!shadow_emit_destroy_soft_vars(out, &ctx,
                                                              body_ind)) {
                        bind_ok = 0;
                    }
                }
                if (bind_ok &&
                    !shadow_emit_scratch_if_needed(it->kids, it->nkids,
                                                   destroys, ndestroys,
                                                   out, body_ind))
                    bind_ok = 0;
                for (int k = 0; bind_ok && k < it->nkids; k++) {
                    if (!shadow_emit_stmt_ctx(it->kids[k], out, &ctx, body_ind,
                                              ctx.goto_cleanup))
                        bind_ok = 0;
                    if (bind_ok && ctx.goto_cleanup &&
                        !shadow_emit_hw_bump(out, &ctx, it->kids[k], body_ind))
                        bind_ok = 0;
                }
                if (bind_ok &&
                    !shadow_vdrop_mark_pop_emit(out, &ctx, body_ind))
                    bind_ok = 0;
                if (bind_ok && ctx.defer_cleanup) {
                    if (!shadow_emit_defer_epilogue(out, &ctx)) bind_ok = 0;
                } else if (bind_ok && ctx.goto_cleanup && ndestroys > 0 &&
                           !shadow_emit_destroy_cleanup(out, &ctx, destroys,
                                                        ndestroys, body_ind)) {
                    bind_ok = 0;
                }
                if (bind_ok && !cemit_str(out, "}\n\n")) bind_ok = 0;
                if (bind_ok && !shadow_flush_par_helpers(out)) bind_ok = 0;
            }
            shadow_pop_fn_binds(bind_mark);
            if (!bind_ok) return 0;
            break;
        }
        case AST_SLICE_VAR:
            if (!cemit_fmt(out, "%s %s;\n", shadow_slice_ty("int"), it->a))
                return 0;
            break;
        case AST_CHAN_VAR:
            shadow_chan_register_node(it);
            {
                const char* init = NULL;
                const char* pe = it->e;
                while (pe && (pe = strstr(pe, ";=")) != NULL) {
                    init = pe + 2;
                    break;
                }
                if (init && init[0]) {
                    if (!cemit_fmt(out, "%s %s = %s;\n",
                                   shadow_chan_handle_ty(it), it->a, init))
                        return 0;
                } else if (!cemit_fmt(out, "%s %s;\n",
                                      shadow_chan_handle_ty(it), it->a)) {
                    return 0;
                }
            }
            break;
        case AST_ASYNC_FN: {
            if (kind == SHADOW_EMIT_H) {
                fprintf(stderr, "error: async fn body not allowed in .cch → .h\n");
                out->err = 1;
                return 0;
            }
            if (!shadow_emit_async_fn(it, out, cache)) return 0;
            break;
        }
        case AST_STATIC_FN: {
            char params[512];
            char ret[160];
            /* Skip duplicate grammar entry-point functions (Name_match).
             * Grammar rules expansion can produce multiple parse passes of
             * the same entry function within one emit. */
            {
                int dup = 0, ef;
                if (shadow_grammar_entry_fn_name(it->b)) {
                    for (ef = 0; ef < g_shadow_n_emitted_grammar_fns; ef++) {
                        if (strcmp(g_shadow_emitted_grammar_fns[ef], it->b) == 0) {
                            dup = 1;
                            break;
                        }
                    }
                    if (dup) break;
                    if (g_shadow_n_emitted_grammar_fns < 16)
                        snprintf(g_shadow_emitted_grammar_fns
                                     [g_shadow_n_emitted_grammar_fns++],
                                 sizeof(g_shadow_emitted_grammar_fns[0]), "%s",
                                 it->b);

/* Emit: TU product — typedefs, Result specs, file-level switch.
 * Included from pp_emit_stmt.cch (after stmt/destroy helpers). */
#pragma once

/* True when a typedef-struct field type is a Map_/ArrayMap_/CCVec_ product
 * (pointer ok). Those DECL macros are emitted after the factory-hoist pass;
 * hoisting the enclosing struct early leaves an unknown type name. */
static int shadow_ty_is_generic_container(const char* ty) {
    const char* p;
    char base[128];
    size_t n;
    if (!ty || !ty[0]) return 0;
    while (*ty == ' ' || *ty == '\t') ty++;
    n = 0;
    while (ty[n] && ty[n] != ' ' && ty[n] != '\t' && ty[n] != '*') {
        if (n + 1 < sizeof(base)) base[n] = ty[n];
        n++;
    }
    if (n >= sizeof(base)) n = sizeof(base) - 1;
    base[n] = 0;
    p = base;
    return strncmp(p, "ArrayMap_", 9) == 0 || strncmp(p, "Map_", 4) == 0 ||
           strncmp(p, "CCVec_", 6) == 0;
}

static int shadow_typedef_struct_embeds_generic_container(const AstNode* it) {
    int k;
    if (!it) return 0;
    for (k = 0; k < it->nkids; k++) {
        AstNode* f = it->kids[k];
        if (!f) continue;
        if (f->kind == AST_FIELD_SIMPLE && shadow_ty_is_generic_container(f->a))
            return 1;
        if (f->kind == AST_FIELD_INT) continue;
        /* raw / other field shapes: best-effort scan of type text */
        if (f->a[0] && (strstr(f->a, "ArrayMap_") || strstr(f->a, "Map_") ||
                        strstr(f->a, "CCVec_")))
            return 1;
    }
    return 0;
}

/* True when `alias` is a monomorph type argument of some factory instance
 * (e.g. Counter in py_expose::[Counter]). BufReader::[CCSocket] does not
 * require hoisting every user struct in the TU. */
static int shadow_alias_is_factory_type_arg(const char* alias) {
    int ii;
    if (!alias || !alias[0]) return 0;
    for (ii = 0; ii < g_shadow_nginst; ii++) {
        const char* p = g_shadow_ginst[ii].compact;
        while (*p) {
            char part[64];
            size_t n = 0;
            while (p[n] && p[n] != '_') n++;
            if (n >= sizeof(part)) n = sizeof(part) - 1;
            memcpy(part, p, n);
            part[n] = 0;
            if (part[0] && strcmp(part, alias) == 0) return 1;
            p += n;
            if (*p == '_') p++;
        }
    }
    return 0;
}

/* True when `params` text mentions `alias` as a type token (ident boundary). */
static int shadow_params_mention_type(const char* params, const char* alias) {
    const char* p;
    size_t al;
    if (!params || !alias || !alias[0]) return 0;
    al = strlen(alias);
    for (p = params; *p; p++) {
        if (strncmp(p, alias, al) != 0) continue;
        if (p > params && shadow_is_ident_char(p[-1])) continue;
        if (shadow_is_ident_char(p[al])) continue;
        return 1;
    }
    return 0;
}

/* typedef struct { … } Alias; — shared by prelude + main emit. */
static int shadow_emit_typedef_struct(AstNode* it, CEmit* out, TapeCache* cache,
                                      ShadowCtx* line_ctx) {
    if (it->nkids == 0 && it->a[0]) {
        if (!cemit_fmt(out, "typedef struct %s %s;\n", it->a, it->b))
            return 0;
        return 1;
    }
    if (!it->a[0] && it->nkids == 1 &&
        it->kids[0]->kind == AST_FIELD_SIMPLE) {
        AstNode* f = it->kids[0];
        char fty[160];
        const char* asuf =
            (f->e[0] && strcmp(f->e, "as") == 0) ? " /*@as*/" : "";
        snprintf(fty, sizeof(fty), "%s", f->a);
        shadow_rewrite_char_slice_types(fty, sizeof(fty));
        if (it->b[0] && f->b[0])
            shadow_field_register_ex(it->b, f->b, fty[0] ? fty : NULL);
        if (!cemit_fmt(out, "typedef struct { %s %s%s; } %s;\n\n",
                       fty, f->b, asuf, it->b))
            return 0;
        return 1;
    }
    if (it->a[0]) {
        if (!cemit_fmt(out, "typedef struct %s {\n", it->a)) return 0;
    } else {
        if (!cemit_str(out, "typedef struct {\n")) return 0;
    }
    for (int k = 0; k < it->nkids; k++) {
        AstNode* f = it->kids[k];
        const char* find = shadow_stmt_indent(f, "    ");
        if (!shadow_emit_line(out, line_ctx, f, find)) return 0;
        if (f->kind == AST_FIELD_INT) {
            if (it->b[0] && f->a[0]) shadow_field_register(it->b, f->a);
            if (it->a[0] && f->a[0]) shadow_field_register(it->a, f->a);
            if (!cemit_fmt(out, "%sint %s;\n", find, f->a)) return 0;
        } else if (f->kind == AST_FIELD_SIMPLE) {
            char fty[160];
            const char* asuf =
                (f->e[0] && strcmp(f->e, "as") == 0) ? " /*@as*/" : "";
            if (f->e[0] && strcmp(f->e, "raw") == 0) {
                char raw[512];
                snprintf(raw, sizeof(raw), "%s", f->a);
                shadow_rewrite_char_slice_types(raw, sizeof(raw));
                if (it->b[0] && f->a[0]) shadow_field_register_raw(it->b, f->a);
                if (it->a[0] && f->a[0]) shadow_field_register_raw(it->a, f->a);
                if (!cemit_fmt(out, "%s%s;\n", find, raw)) return 0;
            } else {
                snprintf(fty, sizeof(fty), "%s", f->a);
                shadow_rewrite_char_slice_types(fty, sizeof(fty));
                if (it->b[0] && f->b[0])
                    shadow_field_register_ex(it->b, f->b, fty[0] ? fty : NULL);
                if (it->a[0] && f->b[0])
                    shadow_field_register_ex(it->a, f->b, fty[0] ? fty : NULL);
                if (!cemit_fmt(out, "%s%s %s%s;\n", find, fty, f->b, asuf))
                    return 0;
            }
        } else if (f->kind == AST_SLICE_VAR) {
            if (it->b[0] && f->a[0]) shadow_field_register(it->b, f->a);
            if (!cemit_fmt(out, "%s%s %s;\n", find, shadow_slice_ty("int"), f->a))
                return 0;
        } else if (f->kind == AST_CHAN_VAR) {
            const char* cty = shadow_chan_handle_ty(f);
            if (it->b[0] && f->a[0])
                shadow_field_register_ex(it->b, f->a, cty);
            if (it->a[0] && f->a[0])
                shadow_field_register_ex(it->a, f->a, cty);
            if (!cemit_fmt(out, "%s%s %s;\n", find, cty, f->a)) return 0;
        } else if (f->kind == AST_RESULT_LOCAL) {
            char rname[256];
            shadow_result_name(f->c, f->b, rname, sizeof(rname));
            if (it->b[0] && f->a[0])
                shadow_field_register_ex(it->b, f->a, rname);
            if (it->a[0] && f->a[0])
                shadow_field_register_ex(it->a, f->a, rname);
            if (!cemit_fmt(out, "%s%s %s%s;\n", find, rname, f->a,
                           f->e[0] ? f->e : ""))
                return 0;
        } else {
            diag_at(cache, (Token){0}, "struct field not lowerable to C");
            out->err = 1;
            return 0;
        }
    }
    if (!cemit_fmt(out, "} %s;\n\n", it->b)) return 0;
    return 1;
}

/* Shared lower: same AST → C text; H adds #pragma once and rejects fn bodies.
 * pass_inc: top-level #include <...> lines from stage 2 (not spliced).
 * pass_def: top-level #define lines preserved for .h API surface. */
/* True if emit will reference host `__cc_uw_*` / unwrap diag helpers. */
static int shadow_node_needs_uw(AstNode* n) {
    int k;
    if (!n) return 0;
    switch (n->kind) {
    case AST_PTR_UNWRAP:
    case AST_STMT_UNWRAP:
        return 1;
    case AST_VAR_UNWRAP:
        return 1; /* bang/qmark paths use err bind and/or `__cc_uw_*` */
    case AST_UFCS_STMT:
        if (strcmp(n->d, "bang") == 0 || strncmp(n->d, "bang_block:", 11) == 0)
            return 1;
        break;
    case AST_PRINTLN_BANG:
    case AST_PRINTLN_TPL:
        if (n->nbody > 0) return 1;
        break;
    case AST_CALL_ARGS:
        if (strcmp(n->c, "bang") == 0 || strcmp(n->c, "bang_stmt") == 0 ||
            strcmp(n->c, "bang_block") == 0)
            return 1;
        break;
    case AST_NURSERY_DESTROY:
        return 1;
    case AST_ERR_SYNTAX:
        return 1;
    default:
        break;
    }
    if (strstr(n->a, "?>") || strstr(n->b, "?>") || strstr(n->c, "?>") ||
        strstr(n->d, "?>") || strstr(n->e, "?>"))
        return 1;
    if (strcmp(n->e, "bang") == 0) return 1; /* return expr !> */
    for (k = 0; k < n->nbody; k++)
        if (shadow_node_needs_uw(n->body[k])) return 1;
    for (k = 0; k < n->ndbody; k++)
        if (shadow_node_needs_uw(n->dbody[k])) return 1;
    if (n->kids) {
        for (k = 0; k < n->nkids; k++)
            if (shadow_node_needs_uw(n->kids[k])) return 1;
    }
    return 0;
}

/* True if leftover text names Result API macros that live in cc_result.h. */
static int shadow_node_needs_result_api(AstNode* n) {
    int k;
    if (!n) return 0;
    if (strstr(n->a, "cc_is_ok") || strstr(n->a, "cc_is_err") ||
        strstr(n->a, "cc_unwrap") || strstr(n->a, "cc_value") ||
        strstr(n->a, "CC_ERROR") || strstr(n->a, "CC_ERR_") ||
        strstr(n->b, "cc_is_ok") || strstr(n->b, "cc_is_err") ||
        strstr(n->b, "cc_unwrap") || strstr(n->b, "cc_value") ||
        strstr(n->b, "CC_ERROR") || strstr(n->b, "CC_ERR_") ||
        strstr(n->c, "cc_is_ok") || strstr(n->c, "cc_is_err") ||
        strstr(n->c, "cc_unwrap") || strstr(n->c, "cc_value") ||
        strstr(n->c, "CC_ERROR") || strstr(n->c, "CC_ERR_") ||
        strstr(n->d, "cc_is_ok") || strstr(n->d, "cc_is_err") ||
        strstr(n->d, "cc_unwrap") || strstr(n->d, "cc_value") ||
        strstr(n->d, "CC_ERROR") || strstr(n->d, "CC_ERR_") ||
        strstr(n->e, "cc_is_ok") || strstr(n->e, "cc_is_err") ||
        strstr(n->e, "cc_unwrap") || strstr(n->e, "cc_value") ||
        strstr(n->e, "CC_ERROR") || strstr(n->e, "CC_ERR_"))
        return 1;
    for (k = 0; k < n->nbody; k++)
        if (shadow_node_needs_result_api(n->body[k])) return 1;
    for (k = 0; k < n->ndbody; k++)
        if (shadow_node_needs_result_api(n->dbody[k])) return 1;
    if (n->kids) {
        for (k = 0; k < n->nkids; k++)
            if (shadow_node_needs_result_api(n->kids[k])) return 1;
    }
    return 0;
}

static int shadow_emit(AstNode** items, int n, TapeCache* cache, CEmit* out,
                       ShadowEmitKind kind, char pass_inc[][256], int npass_inc,
                       char pass_def[][512], int npass_def,
                       const char* src_path) {
    memset(out, 0, sizeof(*out));
    shadow_chan_reset();
    shadow_grammar_ufcs_install();
    shadow_grammar_variant_install();
    g_sticky_lead_set = 0;
    g_file_header_lead_done = 0;
    g_shadow_async_id = 60000;
    g_shadow_closure_id = 1;
    /* Pre-scan send_task receivers so ordered channel_pair can select task
     * machinery before the send_task site is emitted. */
    {
        int si;
        for (si = 0; si < n; si++) shadow_collect_task_sends(items[si]);
    }
    /* @as embeds + destroy hooks from included headers (not spliced into AST). */
    if (npass_inc > 0 && pass_inc)
        shadow_as_scan_pass_inc(pass_inc, npass_inc);
    /* Warmed angle-includes (@as / hooks still present in .cch text). */
    shadow_as_scan_tapes(cache);
    /* Pre-blank TU source — stage1 blanks @comptime register bodies. */
    shadow_as_scan_src_path(src_path);
    shadow_as_resolve_transitive();
    /* Resolve runtime vs stub before collect_binds (slice/chan bind spellings).
     * Includes may live in pass_inc or in item lead trivia (source #include). */
    {
        int has_slice_rt = 0, has_chan_rt = 0;
        int i;
        for (i = 0; i < npass_inc; i++) {
            if (strstr(pass_inc[i], "cc_slice") ||
                strstr(pass_inc[i], "cc_runtime") ||
                strstr(pass_inc[i], "prelude"))
                has_slice_rt = 1;
            if (strstr(pass_inc[i], "cc_channel") ||
                strstr(pass_inc[i], "cc_chan") ||
                strstr(pass_inc[i], "cc_runtime") ||
                strstr(pass_inc[i], "prelude"))
                has_chan_rt = 1;
        }
        for (i = 0; i < n && (!has_slice_rt || !has_chan_rt); i++) {
            FileTape* ft;
            size_t off, len, k;
            if (!items[i] || !items[i]->lead_len || !items[i]->file_id) continue;
            ft = tape_by_id(cache, items[i]->file_id);
            if (!ft || !ft->bytes) continue;
            off = items[i]->lead_off;
            len = items[i]->lead_len;
            if (off + len > ft->len) continue;
            for (k = 0; k + 7 < len; k++) {
                const char* s = ft->bytes + off + k;
                if (!has_slice_rt &&
                    (strncmp(s, "prelude", 7) == 0 ||
                     strncmp(s, "cc_runtime", 10) == 0 ||
                     strncmp(s, "cc_slice", 8) == 0))
                    has_slice_rt = 1;
                if (!has_chan_rt &&
                    (strncmp(s, "prelude", 7) == 0 ||
                     strncmp(s, "cc_runtime", 10) == 0 ||
                     strncmp(s, "cc_channel", 10) == 0 ||
                     strncmp(s, "cc_chan", 7) == 0))
                    has_chan_rt = 1;
            }
        }
        g_shadow_slice_stub = !has_slice_rt;
        g_shadow_chan_stub = !has_chan_rt;
    }
    if (kind == SHADOW_EMIT_H) {
        if (!shadow_tpl_emit(out, k_tpl_tu_prelude_h, NULL, 0)) return 0;
    } else {
        if (!shadow_tpl_emit(out, k_tpl_tu_prelude_c, NULL, 0)) return 0;
    }

    /* File banner only (before first `#…`); post-include comments stay on item 0. */
    if (n > 0) {
        if (!shadow_emit_preamble_ex(items[0], out, cache, 1)) return 0;
    }
    /* Blank line between banner and includes / first decl (hand-written headers). */
    if (out->len > 0 && out->buf[out->len - 1] == '\n' &&
        (out->len < 2 || out->buf[out->len - 2] != '\n')) {
        if (!cemit_str(out, "\n")) return 0;
    }

    {
        int need_task_h = 0;
        for (int i = 0; i < npass_inc; i++) {
            char line[256];
            int sse_hdr;
            shadow_rewrite_pass_inc(line, sizeof(line), pass_inc[i]);
            /* Only .ccs→.c: nursery/.cch surface must stay oracle-aligned. */
            if (kind == SHADOW_EMIT_C && strstr(line, "cc_sched"))
                need_task_h = 1;
            /* Stage2 harvests `#include <emmintrin.h>` even when it sat under
             * `#if defined(__SSE2__)` in grammar emit — re-wrap for arm64 hosts. */
            sse_hdr = (strstr(line, "emmintrin.h") != NULL ||
                       strstr(line, "xmmintrin.h") != NULL ||
                       strstr(line, "mmintrin.h") != NULL);
            if (sse_hdr) {
                if (!cemit_fmt(out, "#if defined(__SSE2__)\n%s\n#endif\n", line))
                    return 0;
            } else if (!cemit_fmt(out, "%s\n", line)) {
                return 0;
            }
        }
        /* cc_sched documents cc_block_on_intptr; the decl lives in std/task. */
        if (need_task_h &&
            !cemit_str(out, "#include <ccc/std/task.h>\n"))
            return 0;
    }
    if (npass_inc && !cemit_str(out, "\n")) return 0;

    for (int i = 0; i < npass_def; i++) {
        if (!cemit_fmt(out, "%s\n", pass_def[i])) return 0;
    }
    if (npass_def && !cemit_str(out, "\n")) return 0;

    /* Register CC_GENERIC_FACTORY / _EXTEND templates from the TU. */
    for (int i = 0; i < n; i++) {
        if (items[i]->kind == AST_GENERIC_FACTORY) {
            char ofile[128];
            int oline = 1;
            FileTape* ft = cache ? tape_by_id(cache, items[i]->file_id) : NULL;
            ofile[0] = 0;
            if (ft && ft->bytes)
                shadow_tape_logical_at(ft->bytes, ft->len, items[i]->tok_off,
                                       ft->path, ofile, sizeof(ofile), &oline);
            shadow_gfac_add(items[i]->a, atoi(items[i]->b), items[i]->d,
                            items[i]->c[0] == 'e' /* extend */, ofile, oline);
        }
    }
    /* AST+type: one normalize/bind walk before emit (not per-expr string soup). */
    shadow_collect_binds(items, n);

    /* Collect Result Ok/Err pairs first — drives specs and __cc_uw_* arms. */
    ShadowCtx line_ctx = { .cache = cache };
    char seen_ok[32][128];
    char seen_err[32][128];
    int nseen = 0;
    int need_slice = 0, need_chan = 0, need_spawn_into = 0;
    int hoist_typedefs = 0;
    int has_result_hdr = 0;
    int need_uw = 0;

    for (int i = 0; i < n; i++) {
        if (items[i]->kind == AST_RESULT_FN || items[i]->kind == AST_RESULT_LOCAL) {
            int dup = 0;
            for (int j = 0; j < nseen; j++) {
                if (strcmp(seen_ok[j], items[i]->c) == 0 &&
                    strcmp(seen_err[j], items[i]->b) == 0) { dup = 1; break; }
            }
            if (!dup && nseen < 32) {
                snprintf(seen_ok[nseen], sizeof(seen_ok[0]), "%s", items[i]->c);
                snprintf(seen_err[nseen], sizeof(seen_err[0]), "%s", items[i]->b);
                nseen++;
            }
        }
        if (items[i]->kind == AST_TYPEDEF_INT && items[i]->c[0] && items[i]->d[0]) {
            int dup = 0;
            for (int j = 0; j < nseen; j++) {
                if (strcmp(seen_ok[j], items[i]->c) == 0 &&
                    strcmp(seen_err[j], items[i]->d) == 0) { dup = 1; break; }
            }
            if (!dup && nseen < 32) {
                snprintf(seen_ok[nseen], sizeof(seen_ok[0]), "%s", items[i]->c);
                snprintf(seen_err[nseen], sizeof(seen_err[0]), "%s", items[i]->d);
                nseen++;
            }
        }
        if (items[i]->kind == AST_SLICE_VAR) need_slice = 1;
        if (items[i]->kind == AST_CHAN_VAR) {
            need_chan = 1;
            /* Result-typed channel elems: ensure CCResult_* specs exist. */
            if (strncmp(items[i]->d, "CCResult_", 9) == 0) {
                const char* rest = items[i]->d + 9;
                const char* us = strrchr(rest, '_');
                char ok[64], err[64];
                int dup = 0, j;
                if (us && us > rest) {
                    size_t ol = (size_t)(us - rest);
                    if (ol >= sizeof(ok)) ol = sizeof(ok) - 1;
                    memcpy(ok, rest, ol);
                    ok[ol] = 0;
                    snprintf(err, sizeof(err), "%s", us + 1);
                    for (j = 0; j < nseen; j++) {
                        if (strcmp(seen_ok[j], ok) == 0 &&
                            strcmp(seen_err[j], err) == 0) {
                            dup = 1;
                            break;
                        }
                    }
                    if (!dup && nseen < 32) {
                        snprintf(seen_ok[nseen], sizeof(seen_ok[0]), "%s", ok);
                        snprintf(seen_err[nseen], sizeof(seen_err[0]), "%s",
                                 err);
                        nseen++;
                    }
                }
            }
        }
        if (items[i]->kind == AST_STRUCT || items[i]->kind == AST_FN ||
            items[i]->kind == AST_STATIC_FN || items[i]->kind == AST_RESULT_FN) {
            for (int k = 0; k < items[i]->nkids; k++) {
                AstNode* kid = items[i]->kids[k];
                if (kid->kind == AST_SLICE_VAR) need_slice = 1;
                if (kid->kind == AST_CHAN_VAR) {
                    need_chan = 1;
                    if (strncmp(kid->d, "CCResult_", 9) == 0) {
                        const char* rest = kid->d + 9;
                        const char* us = strrchr(rest, '_');
                        char ok[64], err[64];
                        int dup = 0, j;
                        if (us && us > rest) {
                            size_t ol = (size_t)(us - rest);
                            if (ol >= sizeof(ok)) ol = sizeof(ok) - 1;
                            memcpy(ok, rest, ol);
                            ok[ol] = 0;
                            snprintf(err, sizeof(err), "%s", us + 1);
                            for (j = 0; j < nseen; j++) {
                                if (strcmp(seen_ok[j], ok) == 0 &&
                                    strcmp(seen_err[j], err) == 0) {
                                    dup = 1;
                                    break;
                                }
                            }
                            if (!dup && nseen < 32) {
                                snprintf(seen_ok[nseen], sizeof(seen_ok[0]),
                                         "%s", ok);
                                snprintf(seen_err[nseen], sizeof(seen_err[0]),
                                         "%s", err);
                                nseen++;
                            }
                        }
                    }
                }
            }
        }
    }

    /* Host-cc: builtins + TU-seen Result types (not a handwritten E allowlist). */
    if (kind == SHADOW_EMIT_C) {
        for (int i = 0; i < npass_inc; i++) {
            if (strstr(pass_inc[i], "cc_result") ||
                strstr(pass_inc[i], "cc_runtime") ||
                strstr(pass_inc[i], "prelude")) {
                has_result_hdr = 1;
                break;
            }
        }
        for (int i = 0; i < n && !need_uw; i++)
            need_uw = shadow_node_needs_uw(items[i]);
        if (need_uw && !has_result_hdr) {
            if (!cemit_str(out, "#include <ccc/cc_result.h>\n\n")) return 0;
            has_result_hdr = 1;
        }
        if (need_uw) {
            int si;
            char rname[128];
            char apath[64];
            /* Clang requires complete types in _Generic associations. Only
             * arm types fully declared by <ccc/cc_result.h> (+ TU-seen
             * specs emitted below). IoError Results need their header. */
            {
                int need_io = 0;
                for (si = 0; si < nseen; si++) {
                    if (strcmp(seen_err[si], "CCIoError") == 0) {
                        need_io = 1;
                        break;
                    }
                }
                /* Channel send/recv returns CCResult_bool_CCIoError even when
                 * the TU never declares a Result local of that shape. */
                if (need_chan) {
                    int has_bool_io = 0;
                    for (si = 0; si < nseen; si++) {
                        if (strcmp(seen_ok[si], "bool") == 0 &&
                            strcmp(seen_err[si], "CCIoError") == 0) {
                            has_bool_io = 1;
                            break;
                        }
                    }
                    if (!has_bool_io && nseen < 32) {
                        snprintf(seen_ok[nseen], sizeof(seen_ok[0]), "bool");
                        snprintf(seen_err[nseen], sizeof(seen_err[0]),
                                 "CCIoError");
                        nseen++;
                    }
                    need_io = 1;
                }
                /* py_expose_* returns CCResult_CCPyptr_CCError — arm __cc_uw_*. */
                {
                    int gi, has_pyptr = 0;
                    for (gi = 0; gi < g_shadow_nginst; gi++) {
                        if (strcmp(g_shadow_ginst[gi].family, "py_expose") == 0)
                            break;
                    }
                    if (gi < g_shadow_nginst) {
                        for (si = 0; si < nseen; si++) {
                            if (strcmp(seen_ok[si], "CCPyptr") == 0 &&
                                strcmp(seen_err[si], "CCError") == 0) {
                                has_pyptr = 1;
                                break;
                            }
                        }
                        if (!has_pyptr && nseen < 32) {
                            snprintf(seen_ok[nseen], sizeof(seen_ok[0]),
                                     "CCPyptr");
                            snprintf(seen_err[nseen], sizeof(seen_err[0]),
                                     "CCError");
                            nseen++;
                        }
                    }
                }
                /* Header helpers like cc_add_i64_checked → CCResult_int64_t_CCError
                 * without a TU Result local; seed so __cc_uw_value arms it. */
                {
                    int has_i64 = 0;
                    for (si = 0; si < nseen; si++) {
                        if (strcmp(seen_ok[si], "int64_t") == 0 &&
                            strcmp(seen_err[si], "CCError") == 0) {
                            has_i64 = 1;
                            break;
                        }
                    }
                    if (!has_i64 && nseen < 32) {
                        snprintf(seen_ok[nseen], sizeof(seen_ok[0]), "int64_t");
                        snprintf(seen_err[nseen], sizeof(seen_err[0]),
                                 "CCError");
                        nseen++;
                    }
                }
                if (need_io &&
                    !cemit_str(out, "#include <ccc/cc_io_error.h>\n"))
                    return 0;
            }
            if (!cemit_str(out,
                    "#undef __cc_uw_is_err\n"
                    "#undef __cc_uw_value\n"
                    "#undef __cc_uw_err_at\n"
                    "#define __cc_uw_is_err(__x__) _Generic((__x__), "
                    "CCResult_int_CCError: "
                    "(!((CCResult_int_CCError*)(void*)&(__x__))->ok), "
                    "CCResult_bool_CCError: "
                    "(!((CCResult_bool_CCError*)(void*)&(__x__))->ok), "
                    "CCResult_char_CCError: "
                    "(!((CCResult_char_CCError*)(void*)&(__x__))->ok), "
                    "CCResult_size_t_CCError: "
                    "(!((CCResult_size_t_CCError*)(void*)&(__x__))->ok), "
                    "CCResult_voidptr_CCError: "
                    "(!((CCResult_voidptr_CCError*)(void*)&(__x__))->ok), "
                    "CCResult_charptr_CCError: "
                    "(!((CCResult_charptr_CCError*)(void*)&(__x__))->ok)"))
                return 0;
            for (si = 0; si < nseen; si++) {
                shadow_result_name(seen_ok[si], seen_err[si], rname,
                                   sizeof(rname));
                if (strcmp(rname, "CCResult_int_CCError") == 0 ||
                    strcmp(rname, "CCResult_bool_CCError") == 0 ||
                    strcmp(rname, "CCResult_char_CCError") == 0 ||
                    strcmp(rname, "CCResult_size_t_CCError") == 0 ||
                    strcmp(rname, "CCResult_voidptr_CCError") == 0 ||
                    strcmp(rname, "CCResult_charptr_CCError") == 0)
                    continue;
                if (!cemit_fmt(out,
                        ", %s: (!((%s*)(void*)&(__x__))->ok)", rname, rname))
                    return 0;
            }
            if (!cemit_str(out,
                    ", default: (*(void* const*)(void*)&(__x__) == (void*)0))\n"
                    "#define __cc_uw_value(__x__) _Generic((__x__), "
                    "CCResult_int_CCError: "
                    "((CCResult_int_CCError*)(void*)&(__x__))->u.value, "
                    "CCResult_bool_CCError: "
                    "((CCResult_bool_CCError*)(void*)&(__x__))->u.value, "
                    "CCResult_char_CCError: "
                    "((CCResult_char_CCError*)(void*)&(__x__))->u.value, "
                    "CCResult_size_t_CCError: "
                    "((CCResult_size_t_CCError*)(void*)&(__x__))->u.value, "
                    "CCResult_voidptr_CCError: "
                    "((CCResult_voidptr_CCError*)(void*)&(__x__))->u.value, "
                    "CCResult_charptr_CCError: "
                    "((CCResult_charptr_CCError*)(void*)&(__x__))->u.value"))
                return 0;
            for (si = 0; si < nseen; si++) {
                shadow_result_name(seen_ok[si], seen_err[si], rname,
                                   sizeof(rname));
                if (strcmp(rname, "CCResult_int_CCError") == 0 ||
                    strcmp(rname, "CCResult_bool_CCError") == 0 ||
                    strcmp(rname, "CCResult_char_CCError") == 0 ||
                    strcmp(rname, "CCResult_size_t_CCError") == 0 ||
                    strcmp(rname, "CCResult_voidptr_CCError") == 0 ||
                    strcmp(rname, "CCResult_charptr_CCError") == 0 ||
                    strcmp(seen_ok[si], "void") == 0)
                    continue;
                if (!cemit_fmt(out, ", %s: ((%s*)(void*)&(__x__))->u.value",
                               rname, rname))
                    return 0;
            }
            if (!cemit_str(out,
                    ", default: (__x__))\n"
                    "#define __cc_uw_err_at(__x__, __e__, __f__, __l__) "
                    "_Generic((__x__), "
                    "CCResult_int_CCError: "
                    "(cc_rt_diag_record_unwrap_site(__f__, __l__), "
                    "((CCResult_int_CCError*)(void*)&(__x__))->u.error), "
                    "CCResult_bool_CCError: "
                    "(cc_rt_diag_record_unwrap_site(__f__, __l__), "
                    "((CCResult_bool_CCError*)(void*)&(__x__))->u.error), "
                    "CCResult_char_CCError: "
                    "(cc_rt_diag_record_unwrap_site(__f__, __l__), "
                    "((CCResult_char_CCError*)(void*)&(__x__))->u.error), "
                    "CCResult_size_t_CCError: "
                    "(cc_rt_diag_record_unwrap_site(__f__, __l__), "
                    "((CCResult_size_t_CCError*)(void*)&(__x__))->u.error), "
                    "CCResult_voidptr_CCError: "
                    "(cc_rt_diag_record_unwrap_site(__f__, __l__), "
                    "((CCResult_voidptr_CCError*)(void*)&(__x__))->u.error), "
                    "CCResult_charptr_CCError: "
                    "(cc_rt_diag_record_unwrap_site(__f__, __l__), "
                    "((CCResult_charptr_CCError*)(void*)&(__x__))->u.error)"))
                return 0;
            for (si = 0; si < nseen; si++) {
                shadow_result_name(seen_ok[si], seen_err[si], rname,
                                   sizeof(rname));
                if (strcmp(rname, "CCResult_int_CCError") == 0 ||
                    strcmp(rname, "CCResult_bool_CCError") == 0 ||
                    strcmp(rname, "CCResult_char_CCError") == 0 ||
                    strcmp(rname, "CCResult_size_t_CCError") == 0 ||
                    strcmp(rname, "CCResult_voidptr_CCError") == 0 ||
                    strcmp(rname, "CCResult_charptr_CCError") == 0)
                    continue;
                /* Macro returns CCError: exact E, or @as face at offset 0. */
                apath[0] = 0;
                if (strcmp(seen_err[si], "CCError") == 0) {
                    if (!cemit_fmt(out,
                            ", %s: (cc_rt_diag_record_unwrap_site(__f__, __l__), "
                            "((%s*)(void*)&(__x__))->u.error)",
                            rname, rname))
                        return 0;
                } else if (shadow_as_path_to(seen_err[si], "CCError", apath,
                                            sizeof(apath)) > 0 &&
                           apath[0]) {
                    if (!cemit_fmt(out,
                            ", %s: (cc_rt_diag_record_unwrap_site(__f__, __l__), "
                            "(*(CCError*)(void*)&((%s*)(void*)&(__x__))->u.error))",
                            rname, rname))
                        return 0;
                }
            }
            if (!cemit_str(out,
                    ", default: (cc_rt_diag_record_unwrap_site(__f__, __l__), "
                    "__cc_err_null_at(__e__, __f__, __l__)))\n"
                    "\n"))
                return 0;
        }
    }
    /* Hoist typedefs when Result specs need prior names, Vec/Map element
     * types need to precede DECL macros, or a factory type-arg struct must
     * be complete before its factory body (py_expose::[Counter]). Factory
     * presence alone does not hoist every TU struct. */
    hoist_typedefs = (nseen > 0 || g_shadow_nginst > 0 || g_shadow_nvecs > 0 || g_shadow_nmaps > 0 ||
                      g_shadow_namaps > 0);

    if (hoist_typedefs) {
        /* Hoist typedefs referenced by @variant arm types so they are
         * visible when the variant helpers are emitted below. */
        for (int vi = 0; vi < n; vi++) {
            const char* vp;
            if (items[vi]->kind != AST_AT_STMT) continue;
            if (strcmp(items[vi]->a, "variant") != 0) continue;
            vp = items[vi]->c;
            while (*vp) {
                char arm_ty[96];
                size_t atl;
                int j2;
                while (*vp && *vp != ':') vp++;
                if (!*vp) break;
                vp++;
                while (*vp == ' ' || *vp == '\t') vp++;
                atl = 0;
                while (vp[atl] && vp[atl] != ';' && vp[atl] != '}')
                    atl++;
                while (atl > 0 && (vp[atl-1]==' ' || vp[atl-1]=='\t'))
                    atl--;
                if (atl == 0 || atl >= sizeof(arm_ty)) { vp += atl; continue; }
                memcpy(arm_ty, vp, atl);
                arm_ty[atl] = 0;
                vp += atl;
                while (*vp == ';' || *vp == ' ') vp++;
                for (j2 = 0; j2 < n; j2++) {
                    const char* a2;
                    if (items[j2]->kind == AST_TYPEDEF_STRUCT) {
                        if (strcmp(items[j2]->e, "hoist") == 0) continue;
                        a2 = items[j2]->b[0] ? items[j2]->b : items[j2]->a;
                        if (!a2[0] || strcmp(a2, arm_ty) != 0) continue;
                        if (!shadow_emit_preamble(items[j2], out, cache))
                            return 0;
                        items[j2]->lead_len = 0;
                        if (!shadow_emit_line(out, &line_ctx, items[j2], ""))
                            return 0;
                        if (!shadow_emit_typedef_struct(items[j2], out, cache,
                                                       &line_ctx))
                            return 0;
                        snprintf(items[j2]->e, sizeof(items[j2]->e), "hoist");
                    } else if (items[j2]->kind == AST_TYPEDEF_INT) {
                        if (strcmp(items[j2]->e, "vech") == 0) continue;
                        if (!items[j2]->a[0] || strcmp(items[j2]->a, arm_ty) != 0)
                            continue;
                        if (!shadow_emit_preamble(items[j2], out, cache))
                            return 0;
                        items[j2]->lead_len = 0;
                        if (!cemit_fmt(out, "typedef %s %s;\n",
                                       items[j2]->b, items[j2]->a))
                            return 0;
                        snprintf(items[j2]->e, sizeof(items[j2]->e), "vech");
                    }
                }
            }
        }
        /* Forward-declare destroy hooks that @variant drop helpers need.
         * The variant helpers are hoisted before the user static definitions,
         * so the host compiler must see the names. */
        {
            char fwd_done[16][64];
            int nfwd = 0;
            for (int i = 0; i < n; i++) {
                const char* vp;
                if (items[i]->kind != AST_AT_STMT) continue;
                if (strcmp(items[i]->a, "variant") != 0) continue;
                vp = items[i]->c;
                while (*vp) {
                    char arm_ty[96];
                    const char* hook;
                    size_t atl;
                    int dup, fi;
                    while (*vp && *vp != ':') vp++;
                    if (!*vp) break;
                    vp++;
                    while (*vp == ' ' || *vp == '\t') vp++;
                    atl = 0;
                    while (vp[atl] && vp[atl] != ';' && vp[atl] != '}')
                        atl++;
                    while (atl > 0 && (vp[atl-1]==' ' || vp[atl-1]=='\t'))
                        atl--;
                    if (atl == 0 || atl >= sizeof(arm_ty)) { vp += atl; continue; }
                    memcpy(arm_ty, vp, atl);
                    arm_ty[atl] = 0;
                    vp += atl;
                    while (*vp == ';' || *vp == ' ') vp++;
                    hook = shadow_destroy_hook_for(arm_ty);
                    if (!hook || !hook[0]) continue;
                    dup = 0;
                    for (fi = 0; fi < nfwd; fi++)
                        if (strcmp(fwd_done[fi], hook) == 0) { dup = 1; break; }
                    if (dup) continue;
                    if (nfwd < 16) {
                        snprintf(fwd_done[nfwd], sizeof(fwd_done[0]),
                                 "%s", hook);
                        nfwd++;
                    }
                    if (!cemit_fmt(out, "static void %s(%s*);\n",
                                   hook, arm_ty))
                        return 0;
                }
            }
        }
        /* Emit @variant decls before any hoisted struct that embeds them
         * (RedisEntry.val : RedisValue). Mark with e="hoist" so the main
         * loop does not re-emit. */
        for (int i = 0; i < n; i++) {
            AstNode* vit;
            ShadowCtx vctx;
            if (items[i]->kind != AST_AT_STMT) continue;
            if (strcmp(items[i]->a, "variant") != 0) continue;
            if (items[i]->e[0] && strcmp(items[i]->e, "hoist") == 0) continue;
            vit = items[i];
            if (!shadow_emit_preamble(vit, out, cache)) return 0;
            vit->lead_len = 0;
            if (!shadow_emit_line(out, &line_ctx, vit, "")) return 0;
            memset(&vctx, 0, sizeof(vctx));
            vctx.cache = cache;
            if (!shadow_emit_stmt_ctx(vit, out, &vctx, "", 0)) return 0;
            snprintf(vit->e, sizeof(vit->e), "hoist");
        }
        for (int i = 0; i < n; i++) {
            if (items[i]->kind == AST_TYPEDEF_INT) {
                int needed = 0;
                int vi;
                if (items[i]->e[0] && strcmp(items[i]->e, "vech") == 0)
                    continue;
                /* Result aliases (`typedef Ok!>Err Alias`) — not every INT
                 * typedef. Hoisting `typedef CompressedResult* Ptr` before the
                 * struct leaves an incomplete type (pigz_cc). */
                if (items[i]->c[0] && items[i]->d[0]) needed = 1;
                /* Hoist when this alias is a Vec/Map element type name. */
                for (vi = 0; vi < g_shadow_nvecs && !needed; vi++)
                    if (strcmp(g_shadow_vecs[vi], items[i]->a) == 0) needed = 1;
                if (!needed) continue;
                if (!shadow_emit_preamble(items[i], out, cache)) return 0;
                items[i]->lead_len = 0;
                if (!shadow_emit_line(out, &line_ctx, items[i], "")) return 0;
                if (items[i]->c[0] && items[i]->d[0]) {
                    char rname[256];
                    shadow_result_name(items[i]->c, items[i]->d, rname,
                                       sizeof(rname));
                    if (!cemit_fmt(out, "typedef %s %s;\n", rname, items[i]->a))
                        return 0;
                } else if (items[i]->b[0]) {
                    /* ArrayMap_/Map_/CCVec_ aliases need DECL macros first —
                     * hoisting them early leaves RedisDbMap as an unknown
                     * incomplete type. */
                    if (strncmp(items[i]->b, "ArrayMap_", 9) == 0 ||
                        strncmp(items[i]->b, "Map_", 4) == 0 ||
                        strncmp(items[i]->b, "CCVec_", 6) == 0 ||
                        strncmp(items[i]->b, "CCSlice", 7) == 0)
                        continue;
                    if (!cemit_fmt(out, "typedef %s %s;\n", items[i]->b,
                                   items[i]->a))
                        return 0;
                } else if (!cemit_fmt(out, "typedef int %s;\n", items[i]->a)) {
                    return 0;
                }
                snprintf(items[i]->e, sizeof(items[i]->e), "vech");
            }
            if (items[i]->kind == AST_TYPEDEF_STRUCT) {
                /* Hoist Result Ok/Err arms, and factory-needed structs
                 * (py_expose::[T]). Do NOT hoist structs that embed
                 * ArrayMap_/Map_/CCVec_ for factory reasons alone — those
                 * DECL macros land after this pass; early hoist is what
                 * broke ArrayMap + BufReader:: in one TU. */
                const char* alias =
                    items[i]->b[0] ? items[i]->b : items[i]->a;
                int needed = 0;
                int needed_result = 0;
                int j;
                for (j = 0; j < nseen; j++) {
                    if (strcmp(seen_ok[j], alias) == 0 ||
                        strcmp(seen_err[j], alias) == 0) {
                        needed_result = 1;
                        break;
                    }
                    {
                        char okptr[128];
                        snprintf(okptr, sizeof(okptr), "%s*", alias);
                        if (strcmp(seen_ok[j], okptr) == 0) {
                            needed_result = 1;
                            break;
                        }
                    }
                }
                if (needed_result) {
                    needed = 1;
                } else if (shadow_alias_is_factory_type_arg(alias) &&
                           !shadow_typedef_struct_embeds_generic_container(
                               items[i])) {
                    needed = 1;
                }
                if (!needed) continue;
                /* Hoist field-type typedefs first (FaceA/FaceB / RedisReplyKind
                 * before DualFaceErr / RedisReply). */
                {
                    int k, j2;
                    for (k = 0; k < items[i]->nkids; k++) {
                        AstNode* f = items[i]->kids[k];
                        const char* fty;
                        if (!f || f->kind != AST_FIELD_SIMPLE) continue;
                        fty = f->a;
                        if (!fty || !fty[0] || strchr(fty, '*')) continue;
                        for (j2 = 0; j2 < n; j2++) {
                            const char* a2;
                            if (items[j2]->kind == AST_TYPEDEF_ENUM) {
                                if (strcmp(items[j2]->e, "hoist") == 0)
                                    continue;
                                a2 = items[j2]->b;
                                if (!a2[0] || strcmp(a2, fty) != 0) continue;
                                if (!shadow_emit_preamble(items[j2], out, cache))
                                    return 0;
                                items[j2]->lead_len = 0;
                                if (!shadow_emit_line(out, &line_ctx, items[j2],
                                                       ""))
                                    return 0;
                                if (items[j2]->a[0]) {
                                    if (!cemit_fmt(out, "typedef enum %s {\n",
                                                   items[j2]->a))
                                        return 0;
                                } else if (!cemit_str(out, "typedef enum {\n")) {
                                    return 0;
                                }
                                if (items[j2]->d[0] &&
                                    !cemit_str(out, items[j2]->d))
                                    return 0;
                                if (items[j2]->d[0] && !cemit_str(out, "\n"))
                                    return 0;
                                if (!cemit_fmt(out, "} %s;\n\n", items[j2]->b))
                                    return 0;
                                snprintf(items[j2]->e, sizeof(items[j2]->e),
                                         "hoist");
                                continue;
                            }
                            if (items[j2]->kind != AST_TYPEDEF_STRUCT)
                                continue;
                            if (strcmp(items[j2]->e, "hoist") == 0) continue;
                            a2 = items[j2]->b[0] ? items[j2]->b
                                                 : items[j2]->a;
                            if (strcmp(a2, fty) != 0) continue;
                            if (!shadow_emit_preamble(items[j2], out, cache))
                                return 0;
                            items[j2]->lead_len = 0;
                            if (!shadow_emit_line(out, &line_ctx, items[j2],
                                                   ""))
                                return 0;
                            if (!shadow_emit_typedef_struct(items[j2], out,
                                                            cache, &line_ctx))
                                return 0;
                            snprintf(items[j2]->e, sizeof(items[j2]->e),
                                     "hoist");
                        }
                    }
                }
                if (!shadow_emit_preamble(items[i], out, cache)) return 0;
                items[i]->lead_len = 0;
                if (!shadow_emit_line(out, &line_ctx, items[i], "")) return 0;
                if (!shadow_emit_typedef_struct(items[i], out, cache, &line_ctx))
                    return 0;
                snprintf(items[i]->e, sizeof(items[i]->e), "hoist");
            } else if (items[i]->kind == AST_TYPEDEF_FN_PTR) {
                char params[512];
                shadow_fnptr_ty_register(items[i]->b);
                if (!shadow_emit_preamble(items[i], out, cache)) return 0;
                items[i]->lead_len = 0;
                if (!shadow_emit_line(out, &line_ctx, items[i], "")) return 0;
                snprintf(params, sizeof(params), "%s",
                         items[i]->c[0] ? items[i]->c : "void");
                if (!cemit_fmt(out, "typedef %s (*%s)(%s);\n",
                               items[i]->a, items[i]->b, params))
                    return 0;
            }
        }
    }
    /* Typedefs named as Vec/slice elems or Map K/V bases (Entry, Pt, …)
     * before CC_VEC / CC_MAP / CC_DECL_SLICE. Skip ones already Result-hoisted. */
    {
        int i, vi;
        for (i = 0; i < n; i++) {
            AstNode* it = items[i];
            const char* alias;
            int needed = 0;
            if (!it || it->kind != AST_TYPEDEF_STRUCT) continue;
            if (strcmp(it->e, "hoist") == 0 || strcmp(it->e, "vech") == 0)
                continue;
            alias = it->b[0] ? it->b : it->a;
            if (!alias[0]) continue;
            for (vi = 0; vi < g_shadow_nvecs; vi++) {
                if (strcmp(g_shadow_vecs[vi], alias) == 0) {
                    needed = 1;
                    break;
                }
            }
            for (vi = 0; vi < g_shadow_nslices && !needed; vi++) {
                if (strcmp(g_shadow_slices[vi], alias) == 0) needed = 1;
            }
            for (vi = 0; vi < g_shadow_nmaps && !needed; vi++) {
                const char* kv = g_shadow_maps[vi];
                const char* us = strchr(kv, '_');
                char part[64];
                size_t plen, pl;
                int side;
                if (!us) continue;
                for (side = 0; side < 2 && !needed; side++) {
                    if (side == 0) {
                        plen = (size_t)(us - kv);
                        if (plen >= sizeof(part)) continue;
                        memcpy(part, kv, plen);
                        part[plen] = 0;
                    } else {
                        snprintf(part, sizeof(part), "%s", us + 1);
                    }
                    pl = strlen(part);
                    while (pl >= 3 && strcmp(part + pl - 3, "ptr") == 0) {
                        part[pl - 3] = 0;
                        pl -= 3;
                    }
                    if (pl && strcmp(part, alias) == 0) needed = 1;
                }
            }
            for (vi = 0; vi < g_shadow_namaps && !needed; vi++) {
                const char* kv = g_shadow_amaps[vi];
                const char* us = strchr(kv, '_');
                char part[64];
                size_t plen, pl;
                int side;
                if (!us) continue;
                for (side = 0; side < 2 && !needed; side++) {
                    if (side == 0) {
                        plen = (size_t)(us - kv);
                        if (plen >= sizeof(part)) continue;
                        memcpy(part, kv, plen);
                        part[plen] = 0;
                    } else {
                        snprintf(part, sizeof(part), "%s", us + 1);
                    }
                    pl = strlen(part);
                    while (pl >= 3 && strcmp(part + pl - 3, "ptr") == 0) {
                        part[pl - 3] = 0;
                        pl -= 3;
                    }
                    if (pl && strcmp(part, alias) == 0) needed = 1;
                }
            }
            if (!needed) continue;
            if (!shadow_emit_preamble(it, out, cache)) return 0;
            it->lead_len = 0;
            if (!shadow_emit_line(out, &line_ctx, it, "")) return 0;
            if (!shadow_emit_typedef_struct(it, out, cache, &line_ctx))
                return 0;
            /* Skip duplicate emit in the main loop. */
            snprintf(it->e, sizeof(it->e), "vech");
        }
    }
    /* Factory bodies may land before helpers that live next to a hoisted
     * type-arg typedef (BufReader::[MemReader] fill's _Generic arms). Emit
     * forward decls for C-spelled helpers so every arm typechecks.
     * Skip AST_RESULT_FN (`T!>(E)`): early mangled Result names race
     * py_expose method wrappers and types not yet declared. */
    if (kind == SHADOW_EMIT_C && cache) {
        int i, j;
        for (i = 0; i < n; i++) {
            AstNode* td = items[i];
            const char* alias;
            if (!td || td->kind != AST_TYPEDEF_STRUCT) continue;
            alias = td->b[0] ? td->b : td->a;
            if (!alias[0] || !shadow_alias_is_factory_type_arg(alias)) continue;
            for (j = 0; j < n; j++) {
                AstNode* fn = items[j];
                const char* params = NULL;
                if (!fn) continue;
                if (fn->kind == AST_STATIC_FN || fn->kind == AST_FN_PROTO) {
                    const char* pref =
                        (fn->kind == AST_FN_PROTO &&
                         strcmp(fn->e, "extern") == 0)
                            ? "extern "
                        : (fn->kind == AST_STATIC_FN)
                            ? ((fn->e[0] && strcmp(fn->e, "inline") == 0)
                                   ? "static inline "
                                   : "static ")
                            : "";
                    char params_buf[512];
                    params = fn->c[0] ? fn->c : "void";
                    if (!shadow_params_mention_type(params, alias)) continue;
                    snprintf(params_buf, sizeof(params_buf), "%s", params);
                    shadow_normalize_chan_params(params_buf,
                                                 sizeof(params_buf));
                    if (!cemit_fmt(out, "%s%s %s(%s);\n", pref, fn->a, fn->b,
                                   params_buf))
                        return 0;
                }
            }
        }
        if (!cemit_str(out, "\n")) return 0;
    }
    /* Family factory bodies after typedef hoist so user types (Counter) are complete. */
    if (kind == SHADOW_EMIT_C && cache) {
        /* Instantiate CC_GENERIC_FACTORY templates / compiled factories. */
        for (int ii = 0; ii < g_shadow_nginst; ii++) {
            ShadowGenericInst* inst = &g_shadow_ginst[ii];
            const char* tpl = NULL;
            char args[8][64];
            char args128[8][128];
            int nargs = 0;
            /* py_module::[T] and friends exceed 8 KiB once methods + glue land. */
            char body[65536];
            int fi;
            for (fi = 0; fi < g_shadow_ngfac; fi++) {
                if (strcmp(g_shadow_gfac[fi].family, inst->family) == 0) {
                    tpl = g_shadow_gfac[fi].tpl;
                    break;
                }
            }
            {
                const char* p = inst->compact;
                while (*p && nargs < 8) {
                    size_t n = 0;
                    while (p[n] && p[n] != '_') n++;
                    if (n >= sizeof(args[0])) n = sizeof(args[0]) - 1;
                    memcpy(args[nargs], p, n);
                    args[nargs][n] = 0;
                    snprintf(args128[nargs], sizeof(args128[0]), "%s",
                             args[nargs]);
                    nargs++;
                    p += n;
                    if (*p == '_') p++;
                }
            }
            {
                FileTape* root = cache->n > 0 ? cache->items[0] : NULL;
                const char* path = root && root->path ? root->path : "";
                const char* rsrc = root && root->bytes ? root->bytes : "";
                int use_line = 1, use_col = 5;
                if (rsrc) {
                    char needle[128];
                    const char* hit = NULL;
                    snprintf(needle, sizeof(needle), "%s::[", inst->family);
                    hit = strstr(rsrc, needle);
                    if (!hit) hit = strstr(rsrc, inst->mangled);
                    if (hit) {
                        const char* p;
                        use_line = 1;
                        use_col = 1;
                        for (p = rsrc; p < hit; p++) {
                            if (*p == '\n') {
                                use_line++;
                                use_col = 1;
                            } else
                                use_col++;
                        }
                    }
                }
                /* Prefer the compiled/registered factory when present.
                 * Textual tpl extraction only sees the first `@emit(\`…\`)`
                 * and cannot expand runtime slots like `${nm}` / `${box}`. */
                if (cc_emit_plan_has_generic_factory(inst->family)) {
                    char err[512];
                    size_t rlen = root ? root->len : 0;
                    int frag_line = 0;
                    CCGenProduceStatus st = cc_emit_plan_produce_generic_def(
                        inst->family, inst->mangled, args128, nargs, rsrc,
                        rlen, path, body, sizeof(body), err, sizeof(err));
                    if (st != CC_GEN_PRODUCE_OK) {
                        const char* path_base = path;
                        const char* slash = path_base ? strrchr(path_base, '/')
                                                     : NULL;
                        const char* tests = path_base ? strstr(path_base, "tests/")
                                                     : NULL;
                        if (tests)
                            path_base = tests;
                        else if (slash && slash[1])
                            path_base = slash + 1;
                        fprintf(stderr,
                                "%s:%d:%d: error: type: compiled generic "
                                "factory '%s' %s%s%s\n",
                                path_base && path_base[0] ? path_base
                                                          : "<input>",
                                use_line, use_col, inst->family,
                                st == CC_GEN_PRODUCE_ENSURE_FAILED
                                    ? "failed to compile"
                                    : "produced invalid C for '",
                                st == CC_GEN_PRODUCE_ENSURE_FAILED
                                    ? ""
                                    : inst->mangled,
                                st == CC_GEN_PRODUCE_ENSURE_FAILED ? "" : "'");
                        if (err[0]) fprintf(stderr, "  %s\n", err);
                        shadow_gfac_note_handler(inst->family, path);
                        out->err = 1;
                        return 0;
                    }
                    if (cc_emit_plan_take_exec_error()) {
                        fprintf(stderr,
                                "%s:%d:%d: error: type: compiled generic "
                                "factory '%s' reported an error for '%s'\n",
                                path[0] ? path : "<input>", use_line, use_col,
                                inst->family, inst->mangled);
                        out->err = 1;
                        return 0;
                    }
                    if (cc_comptime_validate_c_fragment(body, &frag_line, err,
                                                        sizeof(err)) != 0) {
                        if (cc_emit_plan_generic_invalid_report_once(
                                inst->mangled)) {
                            const char* path_base = path;
                            const char* slash =
                                path_base ? strrchr(path_base, '/') : NULL;
                            const char* tests =
                                path_base ? strstr(path_base, "tests/") : NULL;
                            if (tests)
                                path_base = tests;
                            else if (slash && slash[1])
                                path_base = slash + 1;
                            fprintf(stderr,
                                    "%s:%d:%d: error: type: compiled generic "
                                    "factory '%s' produced invalid C for "
                                    "'%s'\n",
                                    path_base && path_base[0] ? path_base
                                                              : "<input>",
                                    use_line, use_col, inst->family,
                                    inst->mangled);
                            if (frag_line > 0)
                                fprintf(stderr,
                                        "note: in generated definition, "
                                        "line %d\n",
                                        frag_line);
                            if (body[0]) {
                                const char* nl = strchr(body, '\n');
                                fprintf(stderr, ">    %d | %.*s\n",
                                        frag_line > 0 ? frag_line : 1,
                                        nl ? (int)(nl - body)
                                           : (int)strlen(body),
                                        body);
                            }
                            fprintf(stderr,
                                    "note: re-run with --emit-c-inspect to "
                                    "dump the full translation unit\n");
                            shadow_gfac_note_handler(inst->family, path);
                            if (fi < g_shadow_ngfac &&
                                g_shadow_gfac[fi].origin_file[0]) {
                                fprintf(stderr,
                                        "note: in @comptime factory "
                                        "'__cc_gfac_%s' at %s:%d\n",
                                        inst->family,
                                        g_shadow_gfac[fi].origin_file,
                                        g_shadow_gfac[fi].origin_line);
                            }
                        }
                        out->err = 1;
                        return 0;
                    }
                } else if (tpl) {
                    int frag_line = 0;
                    char verr[256];
                    const char* path_base = path;
                    const char* slash;
                    int oob_arg = -1;
                    int irc;
                    if (fi < g_shadow_ngfac && !g_shadow_gfac[fi].has_base) {
                        const char* tests = path ? strstr(path, "tests/") : NULL;
                        const char* pb = tests ? tests : path;
                        slash = pb ? strrchr(pb, '/') : NULL;
                        if (!tests && slash && slash[1]) pb = slash + 1;
                        fprintf(stderr,
                                "%s:%d:%d: error: type: compiled generic "
                                "factory '%s' failed to compile: generic '%s' "
                                "is extended but never defined (needs "
                                "CC_GENERIC_FACTORY(%s) or "
                                "cc_generic_register)\n",
                                pb && pb[0] ? pb : "<input>", use_line,
                                use_col, inst->family, inst->family,
                                inst->family);
                        out->err = 1;
                        return 0;
                    }
                    irc = shadow_inst_generic_tpl(tpl, inst->mangled, args,
                                                  nargs, body, sizeof(body),
                                                  &oob_arg);
                    if (irc < 0) {
                        const char* tests = path ? strstr(path, "tests/") : NULL;
                        const char* pb = tests ? tests : path;
                        slash = pb ? strrchr(pb, '/') : NULL;
                        if (!tests && slash && slash[1]) pb = slash + 1;
                        fprintf(stderr,
                                "%s:%d: error: factory '%s': arg(%d) is out of "
                                "range (%d type argument%s)\n",
                                pb && pb[0] ? pb : "<input>", use_line,
                                inst->family, oob_arg, nargs,
                                nargs == 1 ? "" : "s");
                        out->err = 1;
                        return 0;
                    }
                    if (irc == 0) {
                        fprintf(stderr,
                                "error: generic instantiate failed for %s\n",
                                inst->mangled);
                        out->err = 1;
                        return 0;
                    }
                    if (cc_comptime_validate_c_fragment(body, &frag_line, verr,
                                                        sizeof(verr)) != 0) {
                        slash = path_base ? strrchr(path_base, '/') : NULL;
                        if (slash && slash[1]) path_base = slash + 1;
                        fprintf(stderr,
                                "%s:%d:%d: error: type: compiled generic "
                                "factory '%s' produced invalid C for '%s'\n",
                                path_base && path_base[0] ? path_base
                                                          : "<input>",
                                use_line, use_col, inst->family,
                                inst->mangled);
                        if (frag_line > 0)
                            fprintf(stderr,
                                    "note: in generated definition, line %d\n",
                                    frag_line);
                        if (body[0]) {
                            const char* nl = strchr(body, '\n');
                            fprintf(stderr, ">    %d | %.*s\n",
                                    frag_line > 0 ? frag_line : 1,
                                    nl ? (int)(nl - body) : (int)strlen(body),
                                    body);
                        }
                        fprintf(stderr,
                                "note: re-run with --emit-c-inspect to dump "
                                "the full translation unit\n");
                        if (fi < g_shadow_ngfac &&
                            g_shadow_gfac[fi].origin_file[0]) {
                            fprintf(stderr,
                                    "note: in @comptime factory "
                                    "'__cc_gfac_%s' at %s:%d\n",
                                    inst->family,
                                    g_shadow_gfac[fi].origin_file,
                                    g_shadow_gfac[fi].origin_line);
                        }
                        out->err = 1;
                        return 0;
                    }
                } else {
                    continue;
                }
                if (!cemit_fmt(out, "/* generic %s */\n", inst->mangled))
                    return 0;
                if (!cemit_str(out, body)) return 0;
                if (!cemit_str(out, "\n\n")) return 0;
            }
        }
    }

    /* Map/Vec/slice macros after typedef hoist (element types in scope). */
    if (kind == SHADOW_EMIT_C && cache) {
        if (g_shadow_nslices > 0 && !g_shadow_slice_stub) {
            if (!cemit_str(out, "#include <ccc/cc_slice.h>\n")) return 0;
            for (int si = 0; si < g_shadow_nslices; si++) {
                if (!cemit_fmt(out, "CC_DECL_SLICE(%s)\n", g_shadow_slices[si]))
                    return 0;
            }
            if (!cemit_str(out, "\n")) return 0;
        }
        if (g_shadow_nvecs > 0) {
            if (!cemit_str(out, "#include <ccc/std/vec.h>\n"
                                "#include <ccc/cc_type.h>\n"))
                return 0;
            for (int vi = 0; vi < g_shadow_nvecs; vi++) {
                const char* t = g_shadow_vecs[vi];
                int typed_slice =
                    !strcmp(t, "int") || !strcmp(t, "double") ||
                    !strcmp(t, "float") || !strcmp(t, "bool") ||
                    !strcmp(t, "long") || !strcmp(t, "long_long");
                /* vec.h already provides CCVec_char / CCVec_size_t DECL — still
                 * emit the `_new` helper the beachhead lowers `cc_vec_new` to. */
                if (!strcmp(t, "char") || !strcmp(t, "size_t")) {
                    if (!cemit_fmt(out,
                            "static inline CCVec_%s CCVec_%s_new(CCArena* __a) {\n"
                            "    return CCVec_%s_init(__a, 0);\n"
                            "}\n",
                            t, t, t))
                        return 0;
                    continue;
                }
                /* Emit skipped CCVec_ typedef aliases before the DECL that
                 * references them (CharVec = CCVec_char before
                 * CC_VEC_DECL_ARENA(CharVec, …)). */
                {
                    int ai;
                    for (ai = 0; ai < n; ai++) {
                        if (items[ai]->kind != AST_TYPEDEF_INT) continue;
                        if (strcmp(items[ai]->e, "vech") == 0) continue;
                        if (!items[ai]->a[0] || strcmp(items[ai]->a, t) != 0)
                            continue;
                        if (!items[ai]->b[0] ||
                            strncmp(items[ai]->b, "CCVec_", 6) != 0)
                            continue;
                        if (!cemit_fmt(out, "typedef %s %s;\n",
                                       items[ai]->b, items[ai]->a))
                            return 0;
                        snprintf(items[ai]->e, sizeof(items[ai]->e), "vech");
                    }
                }
                if (typed_slice) {
                    if (!cemit_fmt(out,
                            "CC_VEC_DECL_ARENA_TSLICE(%s, CCVec_%s, CCSlice_%s)\n"
                            "static inline CCVec_%s CCVec_%s_new(CCArena* __a) {\n"
                            "    return CCVec_%s_init(__a, 0);\n"
                            "}\n",
                            t, t, t, t, t, t))
                        return 0;
                } else if (!cemit_fmt(out,
                               "CC_VEC_DECL_ARENA(%s, CCVec_%s)\n"
                               "static inline CCVec_%s CCVec_%s_new(CCArena* __a) {\n"
                               "    return CCVec_%s_init(__a, 0);\n"
                               "}\n",
                               t, t, t, t, t)) {
                    return 0;
                }
                /* Mirror oracle visit_codegen container cc_type_info. */
                if (!cemit_fmt(out,
                        "\n/* cc_type_info for CCVec_%s (serdes) */\n"
                        "static const cc_type_info __cc_ti_CCVec_%s = {\n"
                        "    .name = \"CCVec_%s\", .mangled = \"CCVec_%s\",\n"
                        "    .id = 0, .size = (uint32_t)sizeof(CCVec_%s),\n"
                        "    .align = (uint32_t)_Alignof(CCVec_%s),\n"
                        "    .kind = (uint16_t)CC_TK_GENERIC_INST, .nfields = 0,\n"
                        "    .flags = (uint16_t)CC_TF_ERASABLE, ._reserved = 0,\n"
                        "    .fields = NULL, .copy_fn = NULL, .drop_fn = NULL,\n"
                        "};\n"
                        "__attribute__((constructor)) static void "
                        "cc__ti_reg_CCVec_%s(void) {\n"
                        "    cc_type_info_register(&__cc_ti_CCVec_%s);\n"
                        "}\n",
                        t, t, t, t, t, t, t, t))
                    return 0;
            }
            if (!cemit_str(out, "\n")) return 0;
        }
        if (g_shadow_nmaps > 0) {
            if (!cemit_str(out,
                    "#include <ccc/std/map.h>\n"
                    "#include <ccc/std/map_impl.h>\n"
                    "#include <ccc/cc_type.h>\n"))
                return 0;
            for (int mi = 0; mi < g_shadow_nmaps; mi++) {
                const char* kv = g_shadow_maps[mi];
                const char* hash = NULL;
                const char* eq = NULL;
                char k[64], v[64], vty[80];
                size_t vl, o;
                int user_key = 0;
                if (!shadow_map_hash_eq(kv, &hash, &eq, k, sizeof(k), v,
                                        sizeof(v), &user_key))
                    continue;
                /* Mangled value `intptr` → C type `int*` for the DECL. */
                {
                    char base[64];
                    int stars = 0;
                    snprintf(base, sizeof(base), "%s", v);
                    vl = strlen(base);
                    while (vl >= 3 && strcmp(base + vl - 3, "ptr") == 0) {
                        base[vl - 3] = 0;
                        vl -= 3;
                        stars++;
                    }
                    snprintf(vty, sizeof(vty), "%s", base);
                    o = strlen(vty);
                    while (stars-- > 0 && o + 1 < sizeof(vty))
                        vty[o++] = '*';
                    vty[o] = 0;
                }
                /* Fwd protos so DECL thunks see hash/eq before TU defs. */
                if (user_key &&
                    !cemit_fmt(out,
                               "static size_t %s(%s);\n"
                               "static int %s(%s, %s);\n",
                               hash, k, eq, k, k))
                    return 0;
                if (!cemit_fmt(out,
                        "CC_MAP_DECL_ARENA(%s, %s, Map_%s, %s, %s)\n"
                        "static inline Map_%s* Map_%s_new(CCArena* __a) {\n"
                        "    return Map_%s_init(__a);\n"
                        "}\n"
                        "\n/* cc_type_info for Map_%s (serdes) */\n"
                        "static const cc_type_info __cc_ti_Map_%s = {\n"
                        "    .name = \"Map_%s\", .mangled = \"Map_%s\",\n"
                        "    .id = 0, .size = (uint32_t)sizeof(Map_%s),\n"
                        "    .align = (uint32_t)_Alignof(Map_%s),\n"
                        "    .kind = (uint16_t)CC_TK_GENERIC_INST, .nfields = 0,\n"
                        "    .flags = (uint16_t)CC_TF_ERASABLE, ._reserved = 0,\n"
                        "    .fields = NULL, .copy_fn = NULL, .drop_fn = NULL,\n"
                        "};\n"
                        "__attribute__((constructor)) static void "
                        "cc__ti_reg_Map_%s(void) {\n"
                        "    cc_type_info_register(&__cc_ti_Map_%s);\n"
                        "}\n",
                        k, vty, kv, hash, eq, kv, kv, kv, kv, kv, kv, kv, kv, kv,
                        kv, kv))
                    return 0;
            }
            if (!cemit_str(out, "\n")) return 0;
        }
        if (g_shadow_namaps > 0) {
            if (!cemit_str(out, "#include <ccc/std/array_map.h>\n")) return 0;
            for (int ai = 0; ai < g_shadow_namaps; ai++) {
                const char* kv = g_shadow_amaps[ai];
                const char* hash = NULL;
                const char* eq = NULL;
                char k[64], v[64], vty[80];
                size_t vl, o;
                int user_key = 0;
                if (!shadow_map_hash_eq(kv, &hash, &eq, k, sizeof(k), v,
                                        sizeof(v), &user_key))
                    continue;
                {
                    char base[64];
                    int stars = 0;
                    snprintf(base, sizeof(base), "%s", v);
                    vl = strlen(base);
                    while (vl >= 3 && strcmp(base + vl - 3, "ptr") == 0) {
                        base[vl - 3] = 0;
                        vl -= 3;
                        stars++;
                    }
                    snprintf(vty, sizeof(vty), "%s", base);
                    o = strlen(vty);
                    while (stars-- > 0 && o + 1 < sizeof(vty))
                        vty[o++] = '*';
                    vty[o] = 0;
                }
                if (user_key &&
                    !cemit_fmt(out,
                               "static size_t %s(%s);\n"
                               "static int %s(%s, %s);\n",
                               hash, k, eq, k, k))
                    return 0;
                if (!cemit_fmt(out,
                        "CC_ARRAY_MAP_DECL(%s, %s, ArrayMap_%s, %s, %s)\n"
                        "static inline ArrayMap_%s* array_map_new_%s(CCArena* __a) {\n"
                        "    return ArrayMap_%s_init(__a);\n"
                        "}\n"
                        "static inline ArrayMap_%s* array_map_new_count_%s("
                        "CCArena* __a, size_t __n) {\n"
                        "    return ArrayMap_%s_init_count(__a, __n);\n"
                        "}\n",
                        k, vty, kv, hash, eq, kv, kv, kv, kv, kv, kv))
                    return 0;
            }
            if (!cemit_str(out, "\n")) return 0;
        }
    }
    /* Detect __spawn_into_call in fn bodies (typed inits / assigns). */
    for (int i = 0; i < n && !need_spawn_into; i++) {
        AstNode* it = items[i];
        if (!it || !it->kids) continue;
        for (int k = 0; k < it->nkids; k++) {
            AstNode* s = it->kids[k];
            if (!s) continue;
            if (strstr(s->a, "__spawn_into") || strstr(s->b, "__spawn_into") ||
                strstr(s->c, "__spawn_into") || strstr(s->d, "__spawn_into") ||
                strstr(s->e, "__spawn_into")) {
                need_spawn_into = 1;
                break;
            }
            if (s->kind == AST_BLOCK) {
                for (int b = 0; b < s->nbody; b++) {
                    AstNode* t = s->body[b];
                    if (!t) continue;
                    if (strstr(t->a, "__spawn_into") || strstr(t->b, "__spawn_into") ||
                        strstr(t->c, "__spawn_into") || strstr(t->d, "__spawn_into") ||
                        strstr(t->e, "__spawn_into")) {
                        need_spawn_into = 1;
                        break;
                    }
                }
            }
            if (need_spawn_into) break;
        }
    }
    if (need_spawn_into && kind == SHADOW_EMIT_C) {
        if (!cemit_str(out, "#include <ccc/cc_closure_helper.h>\n\n")) return 0;
    }
    /* Pull in cc_result.h for runtime error arms / Result API names. Local
     * `Err` stubs (mini) stay self-contained for host `cc -c` without -I. */
    if (kind == SHADOW_EMIT_C && nseen && !has_result_hdr) {
        int need_err_hdr = 0;
        for (int i = 0; i < nseen; i++) {
            if (strcmp(seen_err[i], "CCError") == 0 ||
                strcmp(seen_ok[i], "CCError") == 0) {
                need_err_hdr = 1;
                break;
            }
        }
        for (int i = 0; i < n && !need_err_hdr; i++)
            need_err_hdr = shadow_node_needs_result_api(items[i]);
        if (need_err_hdr) {
            if (!cemit_str(out, "#include <ccc/cc_result.h>\n")) return 0;
            has_result_hdr = 1;
        }
    }
    if (nseen && !cemit_str(out, "\n")) return 0;
    for (int i = 0; i < nseen; i++) {
        char rname[256];
        shadow_result_name(seen_ok[i], seen_err[i], rname, sizeof(rname));
        /* Stdlib already defines these (cc_io_error.h) without *_DEFINED. */
        if (strcmp(seen_ok[i], "bool") == 0 &&
            strcmp(seen_err[i], "CCIoError") == 0)
            continue;
        /* Real layout + typed ctors when cc_result.h provided CC_DECL_RESULT_SPEC.
         * Void ok uses SPEC_VOID (no `void value` field). Split across cemit_fmt
         * calls (512-byte temp). */
        if (strcmp(seen_ok[i], "void") == 0) {
            if (!cemit_fmt(out,
                    "#ifndef %s_DEFINED\n#define %s_DEFINED 1\n"
                    "#ifdef CC_DECL_RESULT_SPEC_VOID\n"
                    "CC_DECL_RESULT_SPEC_VOID(%s, %s)\n#else\n",
                    rname, rname, rname, seen_err[i]))
                return 0;
            {
                ShadowTplBind renv[3];
                renv[0] = (ShadowTplBind){ "rname", SHADOW_TPL_IDENT, rname };
                renv[1] = (ShadowTplBind){ "ok_ty", SHADOW_TPL_IDENT, "void" };
                renv[2] =
                    (ShadowTplBind){ "err_ty", SHADOW_TPL_IDENT, seen_err[i] };
                if (!shadow_tpl_emit(out, k_tpl_result_spec_void, renv, 3))
                    return 0;
            }
            if (!cemit_fmt(out,
                    "static inline %s cc_ok_%s(void) {"
                    " %s r; r.ok = 1; return r; }\n"
                    "static inline %s cc_err_%s(%s e) {"
                    " %s r; r.ok = 0; r.u.error = e; return r; }\n"
                    "#endif\n#endif\n",
                    rname, rname, rname, rname, rname, seen_err[i], rname))
                return 0;
            continue;
        }
        if (!cemit_fmt(out,
                "#ifndef %s_DEFINED\n#define %s_DEFINED 1\n"
                "#ifdef CC_DECL_RESULT_SPEC\n"
                "CC_DECL_RESULT_SPEC(%s, %s, %s)\n#else\n",
                rname, rname, rname, seen_ok[i], seen_err[i]))
            return 0;
        {
            ShadowTplBind renv[3];
            renv[0] = (ShadowTplBind){ "rname", SHADOW_TPL_IDENT, rname };
            renv[1] = (ShadowTplBind){ "ok_ty", SHADOW_TPL_IDENT, seen_ok[i] };
            renv[2] = (ShadowTplBind){ "err_ty", SHADOW_TPL_IDENT, seen_err[i] };
            if (!shadow_tpl_emit(out, k_tpl_result_spec_value, renv, 3))
                return 0;
        }
        if (!cemit_fmt(out,
                "static inline %s cc_err_%s(%s e) {"
                " %s r; r.ok = 0; r.u.error = e; return r; }\n"
                "#endif\n#endif\n",
                rname, rname, seen_err[i], rname))
            return 0;
    }
    if (nseen && !cemit_str(out, "\n")) return 0;
    {
        int has_slice_rt = 0, has_chan_rt = 0;
        for (int i = 0; i < npass_inc; i++) {
            if (strstr(pass_inc[i], "cc_slice") ||
                strstr(pass_inc[i], "cc_runtime") ||
                strstr(pass_inc[i], "prelude"))
                has_slice_rt = 1;
            if (strstr(pass_inc[i], "cc_channel") ||
                strstr(pass_inc[i], "cc_chan") ||
                strstr(pass_inc[i], "cc_runtime") ||
                strstr(pass_inc[i], "prelude"))
                has_chan_rt = 1;
        }
        /* Prefer real types whenever runtime headers are included. */
        g_shadow_slice_stub = !has_slice_rt;
        g_shadow_chan_stub = !has_chan_rt;
    }
    if (need_slice && g_shadow_slice_stub) {
        if (!cemit_str(out, "typedef struct { int *ptr; size_t len; } CCShadowSlice_int;\n\n"))
            return 0;
    }
    if (need_chan && g_shadow_chan_stub) {
        if (!cemit_str(out, "typedef struct { int unused; } CCShadowChan_int;\n\n"))
            return 0;
    }

    for (int i = 0; i < n; i++) {
        AstNode* it = items[i];
        if (!shadow_emit_preamble(it, out, cache)) return 0;
        it->lead_len = 0;
        if (!shadow_emit_line(out, &line_ctx, it, "")) return 0;
        switch (it->kind) {
        case AST_TYPEDEF_INT:
            if (strcmp(it->e, "vech") == 0) break; /* hoisted before Vec/Map */
            if (it->c[0] && it->d[0]) {
                char rname[256];
                shadow_result_name(it->c, it->d, rname, sizeof(rname));
                if (!cemit_fmt(out, "typedef %s %s;\n", rname, it->a))
                    return 0;
            } else if (it->b[0]) {
                if (!cemit_fmt(out, "typedef %s %s;\n", it->b, it->a))
                    return 0;
            } else if (!cemit_fmt(out, "typedef int %s;\n", it->a)) {
                return 0;
            }
            break;
        case AST_TYPEDEF_STRUCT:
            if (strcmp(it->e, "hoist") == 0 || strcmp(it->e, "vech") == 0)
                break; /* already emitted before Result/Vec macros */
            if (!shadow_emit_typedef_struct(it, out, cache, &line_ctx))
                return 0;
            break;
        case AST_TYPEDEF_ENUM: {
            if (strcmp(it->e, "hoist") == 0)
                break; /* already emitted before Result specs */
            /* Enumerators can exceed cemit_fmt's 512 temp — emit in pieces. */
            if (it->a[0]) {
                if (!cemit_fmt(out, "typedef enum %s {\n", it->a)) return 0;
            } else {
                if (!cemit_str(out, "typedef enum {\n")) return 0;
            }
            if (it->d[0] && !cemit_str(out, it->d)) return 0;
            if (it->d[0] && !cemit_str(out, "\n")) return 0;
            if (!cemit_fmt(out, "} %s;\n\n", it->b)) return 0;
            break;
        }
        case AST_TYPEDEF_FN_PTR:
            shadow_fnptr_ty_register(it->b);
            if (hoist_typedefs) break; /* already emitted before Result specs */
            {
                char params[512];
                snprintf(params, sizeof(params), "%s",
                         it->c[0] ? it->c : "void");
                if (!cemit_fmt(out, "typedef %s (*%s)(%s);\n", it->a, it->b,
                               params))
                    return 0;
            }
            break;
        case AST_TYPEDEF_CHAN:
            shadow_chan_register_node(it);
            if (it->c[0] == '<') {
                if (!cemit_fmt(out, "typedef CCChanRx %s;\n\n", it->a)) return 0;
            } else {
                if (!cemit_fmt(out, "typedef CCChanTx %s;\n\n", it->a)) return 0;
            }
            break;
        case AST_FN_PROTO: {
            char params[512];
            const char* pref =
                (strcmp(it->e, "extern") == 0) ? "extern " : "";
            snprintf(params, sizeof(params), "%s",
                     it->c[0] ? it->c : "void");
            shadow_normalize_chan_params(params, sizeof(params));
            if (!cemit_fmt(out, "%s%s %s(%s);\n", pref, it->a, it->b, params))
                return 0;
            break;
        }
        case AST_VAR_INT:
            if (!cemit_fmt(out, "int %s;\n", it->a)) return 0;
            break;
        case AST_PTR_DECL:
            if (!cemit_fmt(out, "%s *%s;\n", it->a, it->b)) return 0;
            break;
        case AST_RESULT_FN: {
            char rname[256];
            shadow_result_name(it->c, it->b, rname, sizeof(rname));
            shadow_rfn_register(it->a, rname, it->b);
            const char* pref =
                (strcmp(it->e, "static inline") == 0) ? "static inline "
                : (strcmp(it->e, "static") == 0)      ? "static "
                                                       : "";
            /* Match AstNode.d (4096): multi-line redis Result protos exceed 288. */
            char dparams[4096];
            snprintf(dparams, sizeof(dparams), "%s",
                     it->d[0] ? it->d : "void");
            shadow_normalize_chan_params(dparams, sizeof(dparams));
            if (it->nkids == 0) {
                if (!cemit_fmt(out, "%s%s %s(%s);\n", pref, rname, it->a, dparams))
                    return 0;
                break;
            }
            if (kind == SHADOW_EMIT_H) {
                fprintf(stderr, "error: result fn body not allowed in .cch → .h (%s)\n",
                        it->a);
                out->err = 1;
                return 0;
            }
            if (!cemit_fmt(out, "%s%s %s(%s) {\n", pref, rname, it->a, dparams))
                return 0;
            char body_ind[64];
            int bind_mark = shadow_push_fn_binds(it);
            int bind_ok = 1;
            shadow_pick_body_indent(it->kids, it->nkids, body_ind, sizeof(body_ind));
            ShadowCtx ctx = { .rname = rname, .cache = cache,
                              .body_indent = body_ind };
            AstNode* defers[16];
            int ndefers = 0;
            for (int k = 0; k < it->nkids; k++) {
                if (it->kids[k]->kind == AST_ERRHANDLER)
                    shadow_eh_push_node(&ctx, it->kids[k]);
                if (it->kids[k]->kind == AST_DEFER) {
                    if (ndefers >= 16) {
                        fprintf(stderr, "error: too many @defer for shadow beachhead\n");
                        out->err = 1;
                        bind_ok = 0;
                        break;
                    }
                    defers[ndefers++] = it->kids[k];
                }
            }
            if (bind_ok) {
                ctx.defers = defers;
                ctx.ndefers = ndefers;
                ctx.defer_cleanup = ndefers > 0;
                ctx.soft_ret_ty = rname;
                shadow_vdrop_mark_push(&ctx);
                if (ctx.defer_cleanup) {
                    if (!cemit_fmt(out,
                            "%s%s __cc_retval = {0};\n"
                            "%sint __cc_ret_set = 0;\n"
                            "%sint __cc_ret_err = 0;\n"
                            "%sint __cc_defer_hw = 0;\n",
                            body_ind, rname, body_ind, body_ind, body_ind))
                        bind_ok = 0;
                }
                if (bind_ok &&
                    !shadow_emit_scratch_if_needed(it->kids, it->nkids, NULL, 0,
                                                   out, body_ind))
                    bind_ok = 0;
                for (int k = 0; bind_ok && k < it->nkids; k++) {
                    if (!shadow_emit_stmt_ctx(it->kids[k], out, &ctx, body_ind,
                                              0))
                        bind_ok = 0;
                    if (bind_ok && ctx.defer_cleanup &&
                        !shadow_emit_hw_bump(out, &ctx, it->kids[k], body_ind))
                        bind_ok = 0;
                }
                if (bind_ok &&
                    !shadow_vdrop_mark_pop_emit(out, &ctx, body_ind))
                    bind_ok = 0;
                if (bind_ok && ctx.defer_cleanup) {
                    if (!shadow_emit_defer_epilogue(out, &ctx)) bind_ok = 0;
                }
                if (bind_ok && !cemit_str(out, "}\n\n")) bind_ok = 0;
            }
            shadow_pop_fn_binds(bind_mark);
            if (!bind_ok) return 0;
            break;
        }
        case AST_SLICE_VAR:
            if (!cemit_fmt(out, "%s %s;\n", shadow_slice_ty("int"), it->a))
                return 0;
            break;
        case AST_CHAN_VAR:
            shadow_chan_register_node(it);
            {
                const char* init = NULL;
                const char* pe = it->e;
                while (pe && (pe = strstr(pe, ";=")) != NULL) {
                    init = pe + 2;
                    break;
                }
                if (init && init[0]) {
                    if (!cemit_fmt(out, "%s %s = %s;\n",
                                   shadow_chan_handle_ty(it), it->a, init))
                        return 0;
                } else if (!cemit_fmt(out, "%s %s;\n",
                                      shadow_chan_handle_ty(it), it->a)) {
                    return 0;
                }
            }
            break;
        case AST_ASYNC_FN: {
            if (kind == SHADOW_EMIT_H) {
                fprintf(stderr, "error: async fn body not allowed in .cch → .h\n");
                out->err = 1;
                return 0;
            }
            if (!shadow_emit_async_fn(it, out, cache)) return 0;
            break;
        }
        case AST_STATIC_FN: {
            char params[512];
            /* Skip duplicate grammar entry-point functions (Name_match).
             * Grammar rules expansion can produce multiple parse passes of
             * the same entry function. */
            {
                static char emitted_fns[16][64];
                static int n_emitted_fns;
                int dup = 0, ef;
                if (strstr(it->b, "_match") || strstr(it->b, "_rule_count")) {
                    for (ef = 0; ef < n_emitted_fns; ef++) {
                        if (strcmp(emitted_fns[ef], it->b) == 0) { dup = 1; break; }
                    }
                    if (dup) break;
                    if (n_emitted_fns < 16)
                        snprintf(emitted_fns[n_emitted_fns++],
                                 sizeof(emitted_fns[0]), "%s", it->b);
                }
            }
            snprintf(params, sizeof(params), "%s",
                     it->c[0] ? it->c : "void");
            shadow_normalize_chan_params(params, sizeof(params));
            const char* inl =
                (it->e[0] && strcmp(it->e, "inline") == 0) ? "inline " : "";
            /* One-liner wrapper before emitting `{` + newline. */
            if (it->nkids == 1 && it->kids[0]->kind == AST_CALL_ARGS) {
                AstNode* c = it->kids[0];
                /* Long fprintf/printf format strings (usage text) exceed 512. */
                char args[8192];
                char fn[96];
                shadow_emit_expr_text(c, c->b, args, sizeof(args), NULL);
                if (strcmp(c->a, "println") == 0)
                    snprintf(fn, sizeof(fn), "cc_println");
                else if (strcmp(c->a, "eprintln") == 0)
                    snprintf(fn, sizeof(fn), "cc_eprintln");
                else
                    snprintf(fn, sizeof(fn), "%s", c->a);
                /* Emit args via cemit_str — they often contain `%s` format
                 * text; never feed that through a cemit_fmt value slot that
                 * shares a short temp with the whole one-liner. */
                if (!shadow_tpl_kv(out,
                                   "static ${inl}${ret} ${name}(${params}) { "
                                   "${fn}(",
                                   "inl", inl, "ret", it->a, "name", it->b,
                                   "params", params, "fn", fn, NULL) ||
                    !cemit_str(out, args) ||
                    !cemit_str(out, "); }\n\n"))
                    return 0;
                break;
            }
            if (it->d[0] && it->nkids == 0 && strchr(it->d, '\n') == NULL) {
                char body[2048];
                shadow_rewrite_ufcs(body, sizeof(body), it->d, NULL);
                while (body[0] == ' ' || body[0] == '\t')
                    memmove(body, body + 1, strlen(body));
                size_t bl = strlen(body);
                while (bl && (body[bl - 1] == ' ' || body[bl - 1] == '\t'))
                    body[--bl] = 0;
                if (!cemit_fmt(out, "static %s%s %s(%s) { %s }\n\n", inl, it->a,
                               it->b, params, body))
                    return 0;
                break;
            }
            if (it->d[0] && it->nkids == 0) {
                if (!cemit_fmt(out, "static %s%s %s(%s) {\n", inl, it->a, it->b,
                               params))
                    return 0;
                char body[2048];
                shadow_rewrite_ufcs(body, sizeof(body), it->d, NULL);
                if (!cemit_fmt(out, "%s\n}\n\n", body)) return 0;
                break;
            }
            char body_ind[64];
            int bind_mark = shadow_push_fn_binds(it);
            int bind_ok = 1;
            shadow_pick_body_indent(it->kids, it->nkids, body_ind, sizeof(body_ind));
            ShadowCtx sctx = { .cache = cache, .body_indent = body_ind };
            AstNode* sdestroys[32];
            AstNode* sspawns[16];
            AstNode* sdefers[16];
            int nsdestroys = 0, nsspawns = 0, nsdefers = 0;
            for (int k = 0; bind_ok && k < it->nkids; k++) {
                if (it->kids[k]->kind == AST_ERRHANDLER)
                    shadow_eh_push_node(&sctx, it->kids[k]);
                if (it->kids[k]->kind == AST_DEFER) {
                    if (nsdefers >= 16) {
                        fprintf(stderr, "error: too many @defer for shadow beachhead\n");
                        out->err = 1;
                        bind_ok = 0;
                        break;
                    }
                    sdefers[nsdefers++] = it->kids[k];
                }
                if (shadow_stmt_is_destroy(it->kids[k])) {
                    if (nsdestroys >= 32) {
                        fprintf(stderr, "error: too many @destroy for shadow beachhead\n");
                        out->err = 1;
                        bind_ok = 0;
                        break;
                    }
                    sdestroys[nsdestroys++] = it->kids[k];
                }
                if (!shadow_collect_spawns(it->kids[k], sspawns, &nsspawns, 16)) {
                    fprintf(stderr, "error: too many spawns for shadow beachhead\n");
                    out->err = 1;
                    bind_ok = 0;
                    break;
                }
            }
            if (bind_ok) {
                sctx.destroys = sdestroys;
                sctx.ndestroys = nsdestroys;
                sctx.defers = sdefers;
                sctx.ndefers = nsdefers;
                sctx.defer_cleanup = nsdefers > 0;
                if (nsspawns) {
                    if (!cemit_str(out, "\n/* --- CC closure declarations --- */\n"))
                        bind_ok = 0;
                    for (int s = 0; bind_ok && s < nsspawns; s++) {
                        char proto[256];
                        int ar = shadow_closure_arity(sspawns[s]);
                        const char* ccty = shadow_closure_cc_ty(sspawns[s]);
                        if (!shadow_caps_proto(sspawns[s]->e, proto, sizeof(proto)))
                            bind_ok = 0;
                        else if (ar == 1) {
                            if (!cemit_fmt(out,
                                    "static void* cc_closure__N%s_entry(void*, intptr_t);\n"
                                    "static %s cc_closure__N%s_make(%s);\n",
                                    sspawns[s]->d, ccty, sspawns[s]->d, proto))
                                bind_ok = 0;
                        } else if (ar == 2) {
                            if (!cemit_fmt(out,
                                    "static void* cc_closure__N%s_entry(void*, intptr_t, intptr_t);\n"
                                    "static %s cc_closure__N%s_make(%s);\n",
                                    sspawns[s]->d, ccty, sspawns[s]->d, proto))
                                bind_ok = 0;
                        } else if (!cemit_fmt(out,
                                "static void* cc_closure__N%s_entry(void*);\n"
                                "static CCClosure0 cc_closure__N%s_make(%s);\n",
                                sspawns[s]->d, sspawns[s]->d, proto)) {
                            bind_ok = 0;
                        }
                    }
                    if (bind_ok &&
                        !cemit_str(out, "/* --- end closure declarations --- */\n\n"))
                        bind_ok = 0;
                }
            }
            if (bind_ok &&
                !cemit_fmt(out, "static %s%s %s(%s) {\n", inl, it->a, it->b,
                           params))
                bind_ok = 0;
            /* Soft returns + watermark for any return type (void skips retval). */
            int use_c = (nsdestroys > 0 || nsdefers > 0);
            if (bind_ok) {
                sctx.soft_ret_ty = it->a[0] ? it->a : "int";
                sctx.goto_cleanup = use_c;
                shadow_vdrop_mark_push(&sctx);
                if (!shadow_emit_scratch_if_needed(it->kids, it->nkids, sdestroys,
                                                  nsdestroys, out, body_ind))
                    bind_ok = 0;
                if (bind_ok && use_c &&
                    !shadow_emit_destroy_soft_vars(out, &sctx, body_ind))
                    bind_ok = 0;
                for (int k = 0; bind_ok && k < it->nkids; k++) {
                    if (!shadow_emit_stmt_ctx(it->kids[k], out, &sctx, body_ind,
                                              use_c))
                        bind_ok = 0;
                    if (bind_ok && use_c &&
                        !shadow_emit_hw_bump(out, &sctx, it->kids[k], body_ind))
                        bind_ok = 0;
                }
                if (bind_ok &&
                    !shadow_vdrop_mark_pop_emit(out, &sctx, body_ind))
                    bind_ok = 0;
                if (bind_ok && nsdefers > 0 && use_c) {
                    if (!shadow_emit_defer_epilogue(out, &sctx)) bind_ok = 0;
                } else if (bind_ok && use_c && nsdestroys > 0 &&
                           !shadow_emit_destroy_cleanup(out, &sctx, sdestroys,
                                                        nsdestroys, body_ind)) {
                    bind_ok = 0;
                }
                if (bind_ok && !cemit_str(out, "}\n\n")) bind_ok = 0;
                if (bind_ok && nsspawns) {
                    if (!cemit_str(out, "\n/* --- CC generated closures --- */\n"))
                        bind_ok = 0;
                    for (int s = 0; bind_ok && s < nsspawns; s++) {
                        if (!shadow_emit_closure_def(sspawns[s], out, cache))
                            bind_ok = 0;
                    }
                }
            }
            shadow_pop_fn_binds(bind_mark);
            if (!bind_ok) return 0;
            break;
        }
        case AST_STATIC_VAR: {
            char ty[160];
            const char* pref =
                (strcmp(it->e, "global") == 0) ? "" : "static ";
            snprintf(ty, sizeof(ty), "%s", it->a);
            if (it->d[0]) {
                if (it->c[0] == '*') {
                    if (!cemit_fmt(out, "%s%s* %s = %s;\n", pref, ty, it->b, it->d))
                        return 0;
                } else if (it->c[0] == '[') {
                    if (!cemit_fmt(out, "%s%s %s%s = %s;\n", pref, ty, it->b, it->c,
                                   it->d))
                        return 0;
                } else {
                    if (!cemit_fmt(out, "%s%s %s = %s;\n", pref, ty, it->b, it->d))
                        return 0;
                }
            } else if (it->c[0] == '*') {
                if (!cemit_fmt(out, "%s%s* %s;\n", pref, ty, it->b)) return 0;
            } else if (it->c[0] == '[') {
                if (!cemit_fmt(out, "%s%s %s%s;\n", pref, ty, it->b, it->c)) return 0;
            } else {
                if (!cemit_fmt(out, "%s%s %s;\n", pref, ty, it->b)) return 0;
            }
            break;
        }
        case AST_FN: {
            if (kind == SHADOW_EMIT_H) {
                fprintf(stderr, "error: function body not allowed in .cch → .h shadow emit (%s)\n",
                        it->a);
                out->err = 1;
                return 0;
            }
            int bind_mark = shadow_push_fn_binds(it);
            int bind_ok = 1;
            ShadowCtx ctx = { .cache = cache };
            int deadline = 0;
            ctx.deadline_i = &deadline;
            AstNode* spawns[16];
            AstNode* destroys[32];
            AstNode* defers[16];
            int nspawns = 0, ndestroys = 0, ndefers = 0;
            for (int k = 0; bind_ok && k < it->nkids; k++) {
                if (it->kids[k]->kind == AST_ERRHANDLER)
                    shadow_eh_push_node(&ctx, it->kids[k]);
                if (it->kids[k]->kind == AST_DEFER) {
                    if (ndefers >= 16) {
                        fprintf(stderr, "error: too many @defer for shadow beachhead\n");
                        out->err = 1;
                        bind_ok = 0;
                        break;
                    }
                    defers[ndefers++] = it->kids[k];
                }
                /* Fn-level @destroy only (block-scoped destroys emit at block end). */
                if (shadow_stmt_is_destroy(it->kids[k])) {
                    if (ndestroys >= 32) {
                        fprintf(stderr, "error: too many @destroy for shadow beachhead\n");
                        out->err = 1;
                        bind_ok = 0;
                        break;
                    }
                    destroys[ndestroys++] = it->kids[k];
                }
                if (!shadow_collect_spawns(it->kids[k], spawns, &nspawns, 16)) {
                    fprintf(stderr, "error: too many spawns for shadow beachhead\n");
                    out->err = 1;
                    bind_ok = 0;
                    break;
                }
            }
            if (bind_ok) {
                ctx.destroys = destroys;
                ctx.ndestroys = ndestroys;
                ctx.defers = defers;
                ctx.ndefers = ndefers;
                ctx.defer_cleanup = ndefers > 0;
                /* Soft-return cleanup for any return type (void skips retval). */
                {
                    const char* rty = it->e[0] ? it->e : "int";
                    ctx.soft_ret_ty = rty;
                    ctx.goto_cleanup = (ndestroys > 0 || ndefers > 0);
                }
                if (nspawns) {
                    if (!cemit_str(out, "\n/* --- CC closure declarations --- */\n"))
                        bind_ok = 0;
                    for (int s = 0; bind_ok && s < nspawns; s++) {
                        char proto[1024];
                        int ar = shadow_closure_arity(spawns[s]);
                        const char* ccty = shadow_closure_cc_ty(spawns[s]);
                        if (!shadow_caps_proto(spawns[s]->e, proto, sizeof(proto))) {
                            fprintf(stderr,
                                    "error: closure caps proto failed in '%s' "
                                    "(spawn %d caps='%s')\n",
                                    it->a, s,
                                    spawns[s]->e[0] ? spawns[s]->e : "");
                            bind_ok = 0;
                        }
                        else if (ar == 1) {
                            if (!cemit_fmt(out,
                                    "static void* cc_closure__N%s_entry(void*, intptr_t);\n"
                                    "static %s cc_closure__N%s_make(%s);\n",
                                    spawns[s]->d, ccty, spawns[s]->d, proto))
                                bind_ok = 0;
                        } else if (ar == 2) {
                            if (!cemit_fmt(out,
                                    "static void* cc_closure__N%s_entry(void*, intptr_t, intptr_t);\n"
                                    "static %s cc_closure__N%s_make(%s);\n",
                                    spawns[s]->d, ccty, spawns[s]->d, proto))
                                bind_ok = 0;
                        } else if (!cemit_fmt(out,
                                "static void* cc_closure__N%s_entry(void*);\n"
                                "static CCClosure0 cc_closure__N%s_make(%s);\n",
                                spawns[s]->d, spawns[s]->d, proto)) {
                            bind_ok = 0;
                        }
                    }
                    if (bind_ok &&
                        !cemit_str(out, "/* --- end closure declarations --- */\n\n"))
                        bind_ok = 0;
                }
            }
            if (bind_ok) {
                const char* rty = it->e[0] ? it->e : "int";
                char params[512];
                /* Host linkers require `int main`; coerce void main. */
                if (strcmp(it->a, "main") == 0 && strcmp(rty, "void") == 0)
                    rty = "int";
                params[0] = 0;
                if (it->b[0]) {
                    snprintf(params, sizeof(params), "%s", it->b);
                    shadow_normalize_chan_params(params, sizeof(params));
                }
                if (params[0])
                    cemit_fmt(out, "%s %s(%s) {\n", rty, it->a, params);
                else
                    cemit_fmt(out, "%s %s(void) {\n", rty, it->a);
                if (out->err) bind_ok = 0;
            }
            if (bind_ok) {
                char body_ind[64];
                shadow_pick_body_indent(it->kids, it->nkids, body_ind, sizeof(body_ind));
                ctx.body_indent = body_ind;
                shadow_vdrop_mark_push(&ctx);
                if (!shadow_emit_scratch_if_needed(it->kids, it->nkids, destroys,
                                                  ndestroys, out, body_ind))
                    bind_ok = 0;
                if (bind_ok && ctx.goto_cleanup &&
                    !shadow_emit_destroy_soft_vars(out, &ctx, body_ind))
                    bind_ok = 0;
                for (int k = 0; bind_ok && k < it->nkids; k++) {
                    if (!shadow_emit_stmt_ctx(it->kids[k], out, &ctx, body_ind,
                                              ctx.goto_cleanup))
                        bind_ok = 0;
                    if (bind_ok &&
                        !shadow_emit_hw_bump(out, &ctx, it->kids[k], body_ind))
                        bind_ok = 0;
                }
                if (bind_ok &&
                    !shadow_vdrop_mark_pop_emit(out, &ctx, body_ind))
                    bind_ok = 0;
                if (bind_ok && ndefers > 0 && ctx.goto_cleanup) {
                    if (!shadow_emit_defer_epilogue(out, &ctx)) bind_ok = 0;
                } else if (bind_ok && ctx.goto_cleanup &&
                           !shadow_emit_destroy_cleanup(out, &ctx, destroys,
                                                        ndestroys, body_ind)) {
                    bind_ok = 0;
                }
                /* void main coerced to int — ensure a return. */
                if (bind_ok && strcmp(it->a, "main") == 0 && it->e[0] &&
                    strcmp(it->e, "void") == 0) {
                    if (!cemit_fmt(out, "%sreturn 0;\n", body_ind)) bind_ok = 0;
                }
                if (bind_ok && !cemit_str(out, "}\n")) bind_ok = 0;
                if (bind_ok && nspawns) {
                    if (!cemit_str(out, "\n/* --- CC generated closures --- */\n"))
                        bind_ok = 0;
                    for (int s = 0; bind_ok && s < nspawns; s++) {
                        if (!shadow_emit_closure_def(spawns[s], out, cache))
                            bind_ok = 0;
                    }
                }
            }
            shadow_pop_fn_binds(bind_mark);
            if (!bind_ok) return 0;
            break;
        }
        case AST_STRUCT: {
            if (strcmp(it->e, "fwd") == 0) {
                if (it->d[0]) {
                    if (!cemit_fmt(out, "struct %s; %s\n", it->a, it->d)) return 0;
                } else if (!cemit_fmt(out, "struct %s;\n", it->a)) {
                    return 0;
                }
                break;
            }
            if (!cemit_fmt(out, "struct %s {\n", it->a)) return 0;
            for (int k = 0; k < it->nkids; k++) {
                AstNode* f = it->kids[k];
                const char* find = shadow_stmt_indent(f, "    ");
                if (f->kind == AST_FIELD_INT) {
                    if (!cemit_fmt(out, "%sint %s;\n", find, f->a)) return 0;
                } else if (f->kind == AST_FIELD_SIMPLE) {
                    const char* asuf =
                        (f->e[0] && strcmp(f->e, "as") == 0) ? " /*@as*/" : "";
                    if (!cemit_fmt(out, "%s%s %s%s;\n", find, f->a, f->b, asuf))
                        return 0;
                } else if (f->kind == AST_SLICE_VAR) {
                    if (!cemit_fmt(out, "%s%s %s;\n", find, shadow_slice_ty("int"),
                                   f->a))
                        return 0;
                } else if (f->kind == AST_CHAN_VAR) {
                    const char* cty = shadow_chan_handle_ty(f);
                    if (it->a[0] && f->a[0])
                        shadow_field_register_ex(it->a, f->a, cty);
                    if (!cemit_fmt(out, "%s%s %s;\n", find, cty, f->a))
                        return 0;
                } else {
                    diag_at(cache, (Token){0}, "struct field not lowerable to C");
                    out->err = 1;
                    return 0;
                }
            }
            if (!cemit_str(out, "};\n")) return 0;
            break;
        }
        case AST_GLOBAL_ARR:
            if (!cemit_fmt(out, "%s %s[] = %s;\n", it->a, it->b, it->c))
                return 0;
            break;
        case AST_RAW_LINE:
            if (it->e[0] && strcmp(it->e, "tape") == 0 && cache) {
                /* Opaque stage1 span (grammar matchers) — copy tape bytes. */
                FileTape* ft = tape_by_id(cache, it->file_id);
                size_t o0 = 0, o1 = 0;
                char* endp = NULL;
                if (!ft || !ft->bytes) {
                    diag_at(cache, (Token){0}, "raw tape span missing file");
                    out->err = 1;
                    return 0;
                }
                o0 = (size_t)strtoull(it->a, &endp, 10);
                o1 = (size_t)strtoull(it->b, &endp, 10);
                if (o1 > ft->len) o1 = ft->len;
                if (o0 > o1) o0 = o1;
                if (o1 > o0) {
                    char span[512];
                    size_t sn = o1 - o0;
                    if (sn < sizeof(span)) {
                        memcpy(span, ft->bytes + o0, sn);
                        span[sn] = 0;
                        if (strncmp(span, "static void", 11) == 0 &&
                            strstr(span, "[]")) {
                            const char* rest = span + 11;
                            while (*rest == ' ' || *rest == '\t') rest++;
                            if (*rest == '*') rest++;
                            while (*rest == ' ' || *rest == '\t') rest++;
                            if (!cemit_fmt(out, "static void* %s\n", rest))
                                return 0;
                            break;
                        }
                    }
                    if (!cemit_buf(out, ft->bytes + o0, o1 - o0))
                        return 0;
                }
                if (!cemit_str(out, "\n")) return 0;
                break;
            }
            /* Install map UFCS before bodies use map->insert / … */
            shadow_map_ufcs_install_from_raw(it->a);
            shadow_slice_note_raw(it->a);
            if (it->a[0] && strncmp(it->a, "static void", 11) == 0 &&
                strstr(it->a, "[]")) {
                const char* rest = it->a + 11;
                while (*rest == ' ' || *rest == '\t') rest++;
                if (*rest == '*') rest++;
                while (*rest == ' ' || *rest == '\t') rest++;
                if (!cemit_fmt(out, "static void* %s\n", rest)) return 0;
                break;
            }
            {
                char line[768];
                const char* s;
                snprintf(line, sizeof(line), "%s", it->a);
                s = line;
                while (*s == ' ' || *s == '\t') s++;
                /* Host includes / directives: never run type_of text rewrite. */
                if (*s != '#')
                    shadow_lower_type_of_constexpr(line, sizeof(line));
                /* Quoted local .cch → angle .h for host cc (match pass_inc). */
                if (strncmp(s, "#include \"", 10) == 0) {
                    size_t n = strlen(s);
                    if (n >= 5 && strcmp(s + n - 5, ".cch\"") == 0) {
                        char path[256];
                        size_t plen = n - 10 - 5; /* after '#include "' before '.cch"' */
                        if (plen > 0 && plen < sizeof(path)) {
                            memcpy(path, s + 10, plen);
                            path[plen] = 0;
                            if (!cemit_fmt(out, "#include <%s.h>\n", path))
                                return 0;
                            break;
                        }
                    }
                }
                if (!cemit_fmt(out, "%s\n", line)) return 0;
            }
            break;
        case AST_GENERIC_FACTORY:
            if (!cemit_fmt(out, "/* CC_GENERIC_FACTORY(%s) — instantiated above */\n",
                           it->a))
                return 0;
            break;
        case AST_AT_STMT: {
            /* grammar / variant / … — shared stmt emitter. */
            ShadowCtx at_ctx = { .cache = cache };
            if (strcmp(it->e, "hoist") == 0) break; /* already emitted */
            if (!shadow_emit_stmt_ctx(it, out, &at_ctx, "", 0)) return 0;
            break;
        }
        case AST_MUL_EXPR:
        case AST_EXPR_STMT:
        case AST_CLOSURE_LIT:
        case AST_FIELD_INT:
        case AST_RETURN_INT:
        case AST_RETURN_CC:
        case AST_RETURN_EXPR:
        case AST_ERRHANDLER:
        case AST_PRINTLN_BANG:
        case AST_PRINTLN_BANG_BIND:
        case AST_PRINTLN_TPL:
        case AST_ERR_FWD:
        case AST_ERR_SYNTAX:
        case AST_NURSERY_DESTROY:
        case AST_SPAWN_CLOSURE:
        case AST_CALL_NUM:
        case AST_CALL_ARGS:
        case AST_IF:
        case AST_BLOCK:
        case AST_VAR_UNWRAP:
        case AST_PTR_INIT:
        case AST_PTR_UNWRAP:
        case AST_STMT_UNWRAP:
        case AST_RESULT_LOCAL:
        case AST_DEFER:
        case AST_VOID_CAST:
        case AST_STATIC_ARR:
        case AST_VAL_DESTROY:
        case AST_FOR:
        case AST_TYPED_INIT:
        case AST_SLICE_INIT:
        case AST_UFCS_STMT:
        case AST_UFCS_EXPR:
        case AST_ASSIGN:
        case AST_VAR_DECL:
        case AST_WHILE:
        case AST_WITH_DEADLINE:
        case AST_INC:
        case AST_FIELD_SIMPLE:
        case AST_BREAK:
        case AST_CONTINUE:
        case AST_GOTO:
        case AST_LABEL:
        case AST_DO_WHILE:
        case AST_SWITCH:
            fprintf(stderr, "error: AST node %s is not part of the C-emit shadow subset\n",
                    ast_kind_name(it->kind));
            out->err = 1;
            return 0;
        }
        if (out->err) return 0;
    }
    if (g_shadow_ufcs_miss) return 0;
    if (g_shadow_string_stack_diag) return 0;
    if (!out->err && out->buf && out->len) {
        const char* hit = NULL;
        if (!shadow_product_host_c_ok(out->buf, out->len, &hit)) {
            const char* path = src_path ? src_path : "<emit>";
            size_t off = (hit && hit >= out->buf && hit < out->buf + out->len)
                             ? (size_t)(hit - out->buf)
                             : 0;
            size_t line = 1, col = 1, k;
            const char* ls = out->buf;
            const char* le;
            char tok[32];
            size_t tl = 0;
            for (k = 0; k < off && k < out->len; k++) {
                if (out->buf[k] == '\n') {
                    line++;
                    col = 1;
                    ls = out->buf + k + 1;
                } else
                    col++;
            }
            le = ls;
            while (le < out->buf + out->len && *le && *le != '\n') le++;
            if (hit && hit[0] == '@') {
                while (tl + 1 < sizeof(tok) && hit[tl] &&
                       (shadow_is_id((unsigned char)hit[tl]) || hit[tl] == '@'))
                    tok[tl] = hit[tl], tl++;
            } else if (hit && hit[0] && hit[1]) {
                tok[0] = hit[0];
                tok[1] = hit[1];
                tl = 2;
            }
            tok[tl] = 0;
            fprintf(stderr,
                    "%s:%zu:%zu: error: unlowered Concurrent-C token '%s' in "
                    "emit product (refuse host C)\n",
                    path, line, col, tok[0] ? tok : "?");
            if (le > ls)
                fprintf(stderr, "  %.*s\n", (int)(le - ls), ls);
            out->err = 1;
            return 0;
        }
    }
    return !out->err;
}

static int shadow_emit_c(AstNode** items, int n, TapeCache* cache, CEmit* out) {
    return shadow_emit(items, n, cache, out, SHADOW_EMIT_C, NULL, 0, NULL, 0,
                       NULL);
}

static int shadow_emit_h(AstNode** items, int n, TapeCache* cache, CEmit* out) {
    return shadow_emit(items, n, cache, out, SHADOW_EMIT_H, NULL, 0, NULL, 0,
                       NULL);
}

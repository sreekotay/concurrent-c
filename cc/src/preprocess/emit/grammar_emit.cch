/* CC-AUTHORED EMITTER SECTIONS — grammar_rules.c peeled into the language
 * itself, one section at a time.  This file is user CC (@string templates,
 * CCString, arenas), lowered at compiler-build time by the SAME shared
 * passes as every user header (lower_headers stage) and compiled into ccc.
 * The lowered .h is CHECKED IN beside this file (bootstrap: lower_headers
 * itself links grammar_rules.c); `make engine-headers` regenerates it.
 *
 * INVARIANT: engine source is user CC.  Any construct valid in a .ccs is
 * valid here; a lowering gap is a BUG in header-lowering convergence, not
 * a boundary to write around.
 *
 * PORT RULE: every section must emit BYTE-IDENTICAL text to the printf
 * emitter it replaces — verified by diffing the generated C of the five
 * reference TUs (json bench, write bench, resp bench, union smoke,
 * shaped-dom smoke) before landing. */
#ifndef CC_GRAMMAR_EMIT_CCH
#define CC_GRAMMAR_EMIT_CCH

/* Compiler-internal consumers (ccc itself, lower_headers) get the
 * header-only bodies — same standalone flavor comptime dylibs use — so
 * no runtime link is required wherever this header lands. */
#ifndef CC_COMPTIME
#define CC_COMPTIME 1
#endif

#include <ccc/cc_arena.cch>
#include <ccc/std/string.cch>

static inline void cc_gr__cat(CCString* o, CCString piece, CCArena* a) {
    cc_string_push_slice(o, cc_string_as_slice(&piece), a);
}

/* ---- run-scanner: stop set {b < T} u {b1} u {b2} as an arch ladder ----
 * 16 B SSE2 where the host compiler has it, portable 8 B SWAR otherwise
 * (also what the TCC front-end parses).  On a hit every arm advances p to
 * the FIRST stop byte.  NO NEON ARM by measurement: 33% regression on
 * Apple Silicon (vector->GPR lane-extract latency dominates ~11-byte
 * median runs); re-adding needs a stay-in-vector-domain design plus
 * on-hardware interleaved numbers. */
static inline CCString cc_gr_swar_run_text(CCArena* a, int k, int T, int b1, int b2) {
    CCString o = cc_string_new();
    cc_gr__cat(&o, @string(`#if defined(__SSE2__)
    { while (p + 16 <= n) {
        __m128i w${k} = _mm_loadu_si128((const __m128i*)(s + p));
        __m128i m${k} = _mm_setzero_si128();
`, a), a);
    if (T > 0)
        cc_gr__cat(&o, @string(`        m${k} = _mm_cmpeq_epi8(_mm_min_epu8(w${k}, _mm_set1_epi8((char)${T - 1})), w${k});
`, a), a);
    if (b1 >= 0)
        cc_gr__cat(&o, @string(`        m${k} = _mm_or_si128(m${k}, _mm_cmpeq_epi8(w${k}, _mm_set1_epi8((char)${b1})));
`, a), a);
    if (b2 >= 0)
        cc_gr__cat(&o, @string(`        m${k} = _mm_or_si128(m${k}, _mm_cmpeq_epi8(w${k}, _mm_set1_epi8((char)${b2})));
`, a), a);
    cc_gr__cat(&o, @string(`        { int hm${k} = _mm_movemask_epi8(m${k});
          if (hm${k}) { p += (size_t)__builtin_ctz((unsigned)hm${k}); break; } }
        p += 16;
    } }
#else
    { const unsigned long long L${k} = 0x0101010101010101ULL, H${k} = 0x8080808080808080ULL;
    while (p + 8 <= n) { unsigned long long w${k}; memcpy(&w${k}, s + p, 8);
        unsigned long long m${k} = 0;
`, a), a);
    if (T > 0)
        cc_gr__cat(&o, @string(`        m${k} |= (w${k} - L${k} * ${T}) & ~w${k} & H${k};
`, a), a);
    if (b1 >= 0)
        cc_gr__cat(&o, @string(`        { unsigned long long x = w${k} ^ (L${k} * ${b1}); m${k} |= (x - L${k}) & ~x & H${k}; }
`, a), a);
    if (b2 >= 0)
        cc_gr__cat(&o, @string(`        { unsigned long long x = w${k} ^ (L${k} * ${b2}); m${k} |= (x - L${k}) & ~x & H${k}; }
`, a), a);
    cc_gr__cat(&o, @string(`        if (m${k}) { p += (size_t)(__builtin_ctzll(m${k}) >> 3); break; }
        p += 8;
    } }
#endif
`, a), a);
    return o;
}

/* ---- JSON-number fast path, the tail after the int part ----
 * Emitted after the int-shape scan: if the next byte is not . / e / E the
 * frac/exp scaffolding is skipped entirely (the common path for ids and
 * plain integers).  svf/sve rollbacks preserve the grammar's opt-frac /
 * opt-exp semantics ("1.5e" parses as the number "1.5"). */
static inline CCString cc_gr_number_fast_tail_text(CCArena* a, int k) {
    return @string(`    if (p < n && (s[p] == 46 || s[p] == 69 || s[p] == 101)) {
    if (s[p] == 46) {
      size_t svf${k} = p; p++;
      if (!(p < n && ((unsigned)(s[p] - 48) <= 9u))) p = svf${k};
      else { p++; while (p < n && ((unsigned)(s[p] - 48) <= 9u)) p++; }
    }
    if (p < n && (s[p] == 69 || s[p] == 101)) {
      size_t sve${k} = p; p++;
      if (p < n && (s[p] == 43 || s[p] == 45)) p++;
      if (!(p < n && ((unsigned)(s[p] - 48) <= 9u))) p = sve${k};
      else { p++; while (p < n && ((unsigned)(s[p] - 48) <= 9u)) p++; }
    }
    }
`, a);
}

/* ---- tape-node API: adjacency and span ARE the tree ----
 * Spans live in meta (bits 10+) for interior nodes; u stays a byte pointer
 * everywhere.  Includes the lazy ffc number accessor (borrow stays the
 * default; ffc runs on use; FFC_IMPL lives in cc/runtime/arena_state.c). */
static inline CCString cc_gr_node_api_text(CCArena* a, const char* n) {
    /* unused: full node API is always emitted; TU may use only a subset.
     * Attr after `static` (not between type and name) — CC parse accepts that. */
    return @string(`static __attribute__((unused)) int ${n}Node_id(const ${n}Node* nd) { return (int)(nd->meta & 0xFFu); }
static __attribute__((unused)) int ${n}Node_is_list(const ${n}Node* nd) { return (int)((nd->meta >> 8) & 1u); }
static __attribute__((unused)) size_t ${n}Node_len(const ${n}Node* nd) { return (size_t)(nd->meta >> 10); }
static __attribute__((unused)) ${n}Node* ${n}Node_first(${n}Node* nd) {
    return ${n}Node_is_list(nd) && (nd->meta >> 10) > 1 ? nd + 1 : 0; }
static __attribute__((unused)) ${n}Node* ${n}Node_next(${n}Node* nd, ${n}Node* parent) {
    ${n}Node* nx = nd + (${n}Node_is_list(nd) ? (size_t)(nd->meta >> 10) : 1);
    return nx < parent + (size_t)(parent->meta >> 10) ? nx : 0; }
static __attribute__((unused)) size_t ${n}Node_count(${n}Node* nd) {
    size_t k = 0;
    for (${n}Node* ch = ${n}Node_first(nd); ch; ch = ${n}Node_next(ch, nd)) k++;
    return k; }
static __attribute__((unused)) void ${n}Node_slice(const ${n}Node* nd, CCSlice* out) {
    size_t l = (size_t)(nd->meta >> 10);
    if ((nd->meta >> 9) & 1u)
        *out = cc_slice_from_parts((void*)nd->u.bytes, l,
                   cc_slice_make_id(3ULL, true, false, false), l);
    else
        *out = cc_slice_from_buffer((void*)nd->u.bytes, l);
}
#include <ccc/vendor/ffc.h>
static inline __attribute__((unused)) double ${n}Node_as_f64(const ${n}Node* nd) {
    if ((nd->meta >> 8) & 1u) return 0.0;
    { double v = 0.0; size_t l = (size_t)(nd->meta >> 10);
      ffc_parse_options o; o.format = FFC_PRESET_JSON; o.decimal_point = '.';
      ffc_result r = ffc_from_chars_double_options(
          nd->u.bytes, nd->u.bytes + l, &v, o);
      return r.outcome == FFC_OUTCOME_OK ? v : 0.0; }
}
`, a);
}

/* ---- tape substrate: Node, ctx, tgrow ----
 * The ctx only holds POINTERS to shape types so the substrate stays
 * dependency-free (plain struct forward decls); full definitions are
 * needed only when cc_dom is demanded.  mat_* is the eager keep/decode
 * stash: dirty keeps decode while the span is hot, u.bytes stays the
 * SOURCE anchor so __unwind works; materialize installs without a
 * re-scan.  tgrow doubles the tape (and, when the grammar has codecs,
 * the stash arrays in lockstep). */
static inline CCString cc_gr_tape_substrate_text(CCArena* a, const char* n, int has_codecs) {
    CCString o = cc_string_new();
    cc_gr__cat(&o, @string(`typedef struct { unsigned long long meta;
    union { const char* bytes; } u; } ${n}Node;
struct CCShapeB; struct CCShapeVal;
typedef struct { ${n}Node* tape; size_t total, cap;
    size_t bstack[512]; size_t bdepth; CCArena* arena;
    const char** mat_ptr; size_t* mat_len; unsigned char* mat_cow;
    /* shaped-DOM hook (armed by _dom; NULL for plain parse):
     * completed containers hand their value up this stack —
     * one push per container, anchored for derived restore */
    struct CCShapeB* sb;
    struct CCShapeVal* vstack; const unsigned char** vanchor;
    size_t vsp, vcap;
    size_t vbase[512]; } ${n}__ctx;
static __attribute__((noinline)) int ${n}__tgrow(${n}__ctx* c) {
    size_t nc = c->cap * 2;
    ${n}Node* nt = (${n}Node*)cc_arena_realloc(c->arena, c->arena, c->tape,
        c->cap * sizeof(${n}Node), nc * sizeof(${n}Node), _Alignof(${n}Node));
    if (!nt) return 0;
    c->tape = nt;
`, a), a);
    if (has_codecs)
        cc_gr__cat(&o, @string(`    if (c->mat_ptr) {
        const char** np = (const char**)cc_arena_realloc(c->arena, c->arena, c->mat_ptr,
            c->cap * sizeof(char*), nc * sizeof(char*), 8);
        size_t* nl = (size_t*)cc_arena_realloc(c->arena, c->arena, c->mat_len,
            c->cap * sizeof(size_t), nc * sizeof(size_t), 8);
        unsigned char* ncw = (unsigned char*)cc_arena_realloc(c->arena, c->arena, c->mat_cow,
            c->cap, nc, 1);
        if (!np || !nl || !ncw) return 0;
        memset(np + c->cap, 0, (nc - c->cap) * sizeof(char*));
        c->mat_ptr = np; c->mat_len = nl; c->mat_cow = ncw;
    }
`, a), a);
    cc_gr__cat(&o, @string(`    c->cap = nc; return 1;
}
`, a), a);
    return o;
}

/* ---- write tier: measure/put/chk text generators ----
 * Mode values mirror grammar_rules.c's RW_MEASURE/RW_PUT/RW_CHK.  Label
 * allocation and constant-run flushing stay with the C callers so the
 * emitted label sequence (and therefore the bytes) cannot drift. */
enum { CC_GR_WMEASURE = 0, CC_GR_WPUT = 1, CC_GR_WCHK = 2 };

/* printable-byte annotation for emitted compares: 61 -> "'='". '*' and '/'
 * stay hex so a comment can never contain a comment terminator. */
static inline CCString cc_gr_chr_text(CCArena* a, int b) {
    if (b >= 0x21 && b <= 0x7e && b != '\'' && b != '\\' && b != '*' && b != '/') {
        char ch = (char)b;
        return @string(`'${ch}'`, a);
    }
    if (b == ' ')  return @string(`' '`, a);
    if (b == '\n') return @string(`nl`, a);
    if (b == '\r') return @string(`cr`, a);
    if (b == '\t') return @string(`tab`, a);
    {
        const char* hx = "0123456789ABCDEF";
        char hi = hx[(b >> 4) & 0xF];
        char lo = hx[b & 0xF];
        return @string(`0x${hi}${lo}`, a);
    }
}

/* C-string-literal escape for emitted byte runs: identifier-ish bytes pass,
 * everything else becomes \NNN octal (always 3 digits, so a following
 * digit can't extend the escape). */
static inline CCString cc_gr_esc_text(CCArena* a, const unsigned char* src, int len) {
    CCString o = cc_string_new();
    for (int i = 0; i < len; i++) {
        unsigned char c = src[i];
        if ((c >= '0' && c <= '9') || (c >= 'A' && c <= 'Z') ||
            (c >= 'a' && c <= 'z') || c == '_' || c == ' ' || c == '-') {
            char ch = (char)c;
            cc_string_push_buffer(&o, &ch, 1, a);
        } else {
            char b[4];
            b[0] = '\\';
            b[1] = (char)('0' + ((c >> 6) & 7));
            b[2] = (char)('0' + ((c >> 3) & 7));
            b[3] = (char)('0' + (c & 7));
            cc_string_push_buffer(&o, b, 4, a);
        }
    }
    return o;
}

/* pending constant-byte run: short runs as annotated stores, long runs as
 * one memcpy of an escaped literal; chk proves space once per run */
static inline CCString cc_gr_wflush_text(CCArena* a, int md, const unsigned char* lit, int nlit) {
    CCString o = cc_string_new();
    if (md == CC_GR_WCHK)
        cc_gr__cat(&o, @string(`    if (cap - o < ${nlit}) return 0;
`, a), a);
    if (nlit <= 4) {
        for (int i = 0; i < nlit; i++) {
            int b = (int)lit[i];
            CCString c = cc_gr_chr_text(a, b);
            cc_gr__cat(&o, @string(`    dst[o++] = (char)${b}; /*${c}*/
`, a), a);
        }
    } else {
        CCString esc = cc_gr_esc_text(a, lit, nlit);
        cc_gr__cat(&o, @string(`    memcpy(dst + o, "${esc}", ${nlit}); o += ${nlit};
`, a), a);
    }
    return o;
}

/* compare-chain digit count into `dest` — no divisions on the 1-6 digit
 * values wire formats actually carry; full 20-digit chain so it's total */
static inline CCString cc_gr_digits_expr_text(CCArena* a, int k, CCString dest) {
    CCString o = cc_string_new();
    unsigned long long p = 10;
    cc_gr__cat(&o, @string(`      ${dest} `, a), a);
    for (int d = 1; d <= 19; d++) {
        cc_gr__cat(&o, @string(`u${k} < ${p}ULL ? ${d}
         : `, a), a);
        if (d < 19) p *= 10;
    }
    cc_gr__cat(&o, @string(`20;
`, a), a);
    return o;
}

/* integer writer body (flush already done by the caller):
 *   measure — digit count by compare chain, no divisions
 *   put     — reversed digit buffer, space already proven
 *   chk     — count first, prove space, then write BACKWARD in place */
static inline CCString cc_gr_wint_text(CCArena* a, int k, int md, const char* expr, int is_unsigned) {
    CCString o = cc_string_new();
    if (md == CC_GR_WPUT && is_unsigned) {
        cc_gr__cat(&o, @string(`    { unsigned long long u${k} = (unsigned long long)(${expr});
      char nb${k}[21]; int nl${k} = 0;
      do { nb${k}[nl${k}++] = (char)('0' + (u${k} % 10)); u${k} /= 10; } while (u${k});
      while (nl${k}) dst[o++] = nb${k}[--nl${k}]; }
`, a), a);
    } else if (md == CC_GR_WPUT) {
        cc_gr__cat(&o, @string(`    { long long x${k} = (long long)(${expr});
      char nb${k}[21]; int nl${k} = 0;
      unsigned long long u${k} = x${k} < 0 ? (unsigned long long)-x${k} : (unsigned long long)x${k};
      if (x${k} < 0) dst[o++] = '-';
      do { nb${k}[nl${k}++] = (char)('0' + (u${k} % 10)); u${k} /= 10; } while (u${k});
      while (nl${k}) dst[o++] = nb${k}[--nl${k}]; }
`, a), a);
    } else if (md == CC_GR_WCHK && is_unsigned) {
        cc_gr__cat(&o, @string(`    { unsigned long long u${k} = (unsigned long long)(${expr});
      size_t nd${k};
`, a), a);
        cc_gr__cat(&o, cc_gr_digits_expr_text(a, k, @string(`nd${k} =`, a)), a);
        cc_gr__cat(&o, @string(`      if (cap - o < nd${k}) return 0;
      o += nd${k};
      { size_t q${k} = o;
        do { dst[--q${k}] = (char)('0' + (u${k} % 10)); u${k} /= 10; } while (u${k}); } }
`, a), a);
    } else if (md == CC_GR_WCHK) {
        cc_gr__cat(&o, @string(`    { long long x${k} = (long long)(${expr});
      unsigned long long u${k} = x${k} < 0 ? (unsigned long long)-x${k} : (unsigned long long)x${k};
      size_t nd${k};
`, a), a);
        cc_gr__cat(&o, cc_gr_digits_expr_text(a, k, @string(`nd${k} =`, a)), a);
        cc_gr__cat(&o, @string(`      if (x${k} < 0) nd${k}++;
      if (cap - o < nd${k}) return 0;
      o += nd${k};
      { size_t q${k} = o;
        do { dst[--q${k}] = (char)('0' + (u${k} % 10)); u${k} /= 10; } while (u${k});
        if (x${k} < 0) dst[--q${k}] = '-'; } }
`, a), a);
    } else if (is_unsigned) {
        cc_gr__cat(&o, @string(`    { unsigned long long u${k} = (unsigned long long)(${expr});
`, a), a);
        cc_gr__cat(&o, cc_gr_digits_expr_text(a, k, @string(`o +=`, a)), a);
        cc_gr__cat(&o, @string(`    }
`, a), a);
    } else {
        cc_gr__cat(&o, @string(`    { long long x${k} = (long long)(${expr});
      unsigned long long u${k} = x${k} < 0 ? (unsigned long long)-x${k} : (unsigned long long)x${k};
      if (x${k} < 0) o++;
`, a), a);
        cc_gr__cat(&o, cc_gr_digits_expr_text(a, k, @string(`o +=`, a)), a);
        cc_gr__cat(&o, @string(`    }
`, a), a);
    }
    return o;
}

/* float writer body (flush already done by the caller): %.17g round-trips
 * doubles exactly; chk asks snprintf for the exact need first */
static inline CCString cc_gr_wfloat_text(CCArena* a, int k, int md, const char* field) {
    if (md == CC_GR_WPUT)
        return @string(`    { char tb${k}[64]; int n${k} = snprintf(tb${k}, sizeof tb${k}, "%.17g", v->${field});
      memcpy(dst + o, tb${k}, (size_t)n${k}); o += (size_t)n${k}; }
`, a);
    if (md == CC_GR_WCHK)
        return @string(`    { char tb${k}[64]; int n${k} = snprintf(tb${k}, sizeof tb${k}, "%.17g", v->${field});
      if (n${k} < 0 || cap - o < (size_t)n${k}) return 0;
      memcpy(dst + o, tb${k}, (size_t)n${k}); o += (size_t)n${k}; }
`, a);
    return @string(`    { char tb${k}[64]; o += (size_t)snprintf(tb${k}, sizeof tb${k}, "%.17g", v->${field}); }
`, a);
}

/* slice-leaf payload body (pre/post literal runs and flush stay with the
 * caller): encoded when the rule's codec has an /encode inverse, memcpy
 * otherwise; k is meaningful only for the chk+encoder arm (the caller
 * allocates it only then, keeping the label sequence stable) */
static inline CCString cc_gr_wleaf_body_text(CCArena* a, int md, int k, const char* enc,
                                             const char* pexpr, const char* lexpr) {
    if (enc && md == CC_GR_WPUT)
        return @string(`    o += ${enc}((const char*)${pexpr}, ${lexpr}, dst + o, (size_t)-1);
`, a);
    if (enc && md == CC_GR_WCHK)
        return @string(`    { size_t en${k} = ${enc}((const char*)${pexpr}, ${lexpr}, dst + o, cap - o);
      if (en${k} > cap - o) return 0;
      o += en${k}; }
`, a);
    if (enc)
        return @string(`    o += ${enc}((const char*)${pexpr}, ${lexpr}, 0, 0);
`, a);
    if (md == CC_GR_WPUT)
        return @string(`    memcpy(dst + o, ${pexpr}, ${lexpr}); o += ${lexpr};
`, a);
    if (md == CC_GR_WCHK)
        return @string(`    if (cap - o < ${lexpr}) return 0;
    memcpy(dst + o, ${pexpr}, ${lexpr}); o += ${lexpr};
`, a);
    return @string(`    o += ${lexpr};
`, a);
}

/* raw bytes field: measure is just the length; put/chk memcpy (flush done
 * by the caller on the non-measure paths) */
static inline CCString cc_gr_wbytes_text(CCArena* a, int md, const char* field) {
    if (md == CC_GR_WMEASURE)
        return @string(`    o += v->${field}.len;
`, a);
    CCString o = cc_string_new();
    if (md == CC_GR_WCHK)
        cc_gr__cat(&o, @string(`    if (cap - o < v->${field}.len) return 0;
`, a), a);
    cc_gr__cat(&o, @string(`    memcpy(dst + o, v->${field}.ptr, v->${field}.len); o += v->${field}.len;
`, a), a);
    return o;
}

/* count-driven items: delegate each element to its own writer triplet */
static inline CCString cc_gr_witems_text(CCArena* a, int k, int md,
                                         const char* field, const char* etype) {
    CCString o = cc_string_new();
    cc_gr__cat(&o, @string(`    { size_t i${k};
    for (i${k} = 0; i${k} < v->${field}_n; i${k}++)
`, a), a);
    if (md == CC_GR_WPUT)
        cc_gr__cat(&o, @string(`        o += ${etype}__wput(&v->${field}[i${k}], dst + o);
`, a), a);
    else if (md == CC_GR_WCHK)
        cc_gr__cat(&o, @string(`        if (!${etype}__wchk(&v->${field}[i${k}], dst, cap, &o)) return 0;
`, a), a);
    else
        cc_gr__cat(&o, @string(`        o += ${etype}__wmeasure(&v->${field}[i${k}]);
`, a), a);
    cc_gr__cat(&o, @string(`    }
`, a), a);
    return o;
}

/* narrowed delimited list: separator byte between elements comes from the
 * decomposed rule; open/close bytes ride the caller's constant-run WAcc */
static inline CCString cc_gr_wnarrow_list_text(CCArena* a, int k, int md,
                                               const char* field, const char* etype, int sep_b) {
    CCString o = cc_string_new();
    cc_gr__cat(&o, @string(`    { size_t i${k};
    for (i${k} = 0; i${k} < v->${field}_n; i${k}++) {
`, a), a);
    if (md == CC_GR_WPUT)
        cc_gr__cat(&o, @string(`        if (i${k}) dst[o++] = (char)${sep_b};
        o += ${etype}__wput(&v->${field}[i${k}], dst + o);
`, a), a);
    else if (md == CC_GR_WCHK)
        cc_gr__cat(&o, @string(`        if (i${k}) { if (cap - o < 1) return 0; dst[o++] = (char)${sep_b}; }
        if (!${etype}__wchk(&v->${field}[i${k}], dst, cap, &o)) return 0;
`, a), a);
    else
        cc_gr__cat(&o, @string(`        if (i${k}) o++;
        o += ${etype}__wmeasure(&v->${field}[i${k}]);
`, a), a);
    cc_gr__cat(&o, @string(`    }
    }
`, a), a);
    return o;
}

/* tagged-union (`one of`) write dispatch: switch on the stored kind, each
 * arm re-derives its own constant skeleton (arms are exclusive, so measure's
 * whole-function fold cannot absorb them). An out-of-range kind refuses to
 * emit anything: the writers return 0 — the same didn't-fit/error value the
 * checked entry already reports — never garbage bytes. */
static inline CCString cc_gr_wunion_head_text(CCArena* a) {
    return @string(`    switch (v->kind) {
`, a);
}

static inline CCString cc_gr_wunion_case_text(CCArena* a, const char* sname, const char* vname) {
    return @string(`    case ${sname}_${vname}: {
`, a);
}

static inline CCString cc_gr_wunion_arm_fix_text(CCArena* a, long cfix) {
    return @string(`    o += ${cfix};   /* variant skeleton */
`, a);
}

static inline CCString cc_gr_wunion_break_text(CCArena* a) {
    return @string(`    break; }
`, a);
}

static inline CCString cc_gr_wunion_default_text(CCArena* a) {
    return @string(`    default: return 0;   /* invalid kind: refuse to emit garbage */
    }
`, a);
}

/* Field-discriminated write: emit the discriminant int from arm tag
 * (EQ → literal imm; GE → derived length expression), never from a stored lie. */
static inline CCString cc_gr_wdisc_open_text(CCArena* a) {
    return @string(`    { long long __wd;
      switch (v->kind) {
`, a);
}

static inline CCString cc_gr_wdisc_eq_text(CCArena* a, const char* sname,
                                           const char* vname, long long imm) {
    return @string(`      case ${sname}_${vname}: __wd = ${imm}LL; break;
`, a);
}

static inline CCString cc_gr_wdisc_ge_text(CCArena* a, const char* sname,
                                           const char* vname, const char* expr) {
    return @string(`      case ${sname}_${vname}: __wd = (long long)(${expr}); break;
`, a);
}

static inline CCString cc_gr_wdisc_close_text(CCArena* a) {
    return @string(`      default: return 0;
      }
`, a);
}

static inline CCString cc_gr_wdisc_end_text(CCArena* a) {
    return @string(`    }
`, a);
}

/* writer-triplet function heads/tails and the checked _write entry.
 * measure's tail folds the whole structural skeleton to ONE constant. */
static inline CCString cc_gr_write_head_text(CCArena* a, int md, const char* n) {
    if (md == CC_GR_WPUT)
        return @string(`static __attribute__((unused)) size_t ${n}__wput(const ${n}* v, char* dst) {
    size_t o = 0;
    (void)v;
`, a);
    if (md == CC_GR_WCHK)
        return @string(`static __attribute__((unused)) int ${n}__wchk(const ${n}* v, char* dst, size_t cap, size_t* io) {
    size_t o = *io;
    (void)v;
`, a);
    return @string(`static __attribute__((unused)) size_t ${n}__wmeasure(const ${n}* v) {
    size_t o = 0;
    (void)v;
`, a);
}

static inline CCString cc_gr_write_tail_text(CCArena* a, int md, long cfix) {
    CCString o = cc_string_new();
    if (md == CC_GR_WMEASURE && cfix)
        cc_gr__cat(&o, @string(`    o += ${cfix};   /* structural skeleton */
`, a), a);
    if (md == CC_GR_WCHK)
        cc_gr__cat(&o, @string(`    *io = o;
    return 1;
}
`, a), a);
    else
        cc_gr__cat(&o, @string(`    return o;
}
`, a), a);
    return o;
}

static inline CCString cc_gr_write_entry_text(CCArena* a, const char* n) {
    return @string(`static __attribute__((unused)) size_t ${n}_write(const ${n}* v, char* dst, size_t cap) {
    size_t o = 0;
    if (!${n}__wchk(v, dst, cap, &o)) return 0;
    return o;
}
`, a);
}

/* ---- schema read tier: leaf term text generators ----
 * These carry only scalar/string parameters; recursion, key-dispatch
 * loops, and pad interleaving stay with the C drivers.  pfx is the
 * union-variant field prefix ("" or "u.<variant>."). */

/* extractor head/tail: G__x_R captures a span (xa,xb) + dirty flag */
static inline CCString cc_gr_x_head_text(CCArena* a, const char* g, const char* r) {
    return @string(`static int ${g}__x_${r}(const unsigned char* s, size_t n, size_t* io,
        size_t* xa, size_t* xb, int* xdr) {
    size_t p = *io;
    (void)s; (void)n;
    *xdr = 0;
`, a);
}

static inline CCString cc_gr_x_tail_text(CCArena* a, const char* fail) {
    /* Some matchers never jump to fail (unfailing bodies); keep the label. */
    return @string(`    *io = p; return 1;
${fail}: __attribute__((unused));
    return 0;
}
`, a);
}

/* matcher/pad call: G__<class>_<rule>(s, n, &p) or fail */
static inline CCString cc_gr_pad_call_text(CCArena* a, const char* g, const char* cls,
                                           const char* r, const char* fail) {
    return @string(`    if (!${g}__${cls}_${r}(s, n, &p)) goto ${fail};
`, a);
}

/* fused int run: ONE accumulate-while-scan loop, no second conversion
 * pass, no charset loads — the hand-parser inner loop, derived */
static inline CCString cc_gr_bind_int_run_text(CCArena* a, int k, int neg,
                                               const char* pfx, const char* field,
                                               const char* fail) {
    CCString o = cc_string_new();
    cc_gr__cat(&o, @string(`    { long long v${k} = 0; size_t d${k};
`, a), a);
    if (neg)
        cc_gr__cat(&o, @string(`      int ng${k} = 0;
      if (p < n && s[p] == '-') { ng${k} = 1; p++; }
`, a), a);
    cc_gr__cat(&o, @string(`      d${k} = p;
      for (; p < n && s[p] >= '0' && s[p] <= '9'; p++)
          v${k} = v${k} * 10 + (s[p] - '0');
      if (p == d${k}) { if (p >= n) *cc_inc = 1; goto ${fail}; }
`, a), a);
    if (neg)
        cc_gr__cat(&o, @string(`      out->${pfx}${field} = ng${k} ? -v${k} : v${k}; }
`, a), a);
    else
        cc_gr__cat(&o, @string(`      out->${pfx}${field} = v${k}; }
`, a), a);
    return o;
}

/* span-bind openers: call the extractor, or set up locals for an inline
 * expansion (the C driver recurses rg_emit_node between open and close) */
static inline CCString cc_gr_bind_span_call_text(CCArena* a, int k, const char* g,
                                                 const char* r, const char* fail) {
    return @string(`    { size_t xa${k}, xb${k}; int xd${k};
      if (!${g}__x_${r}(s, n, &p, &xa${k}, &xb${k}, &xd${k})) goto ${fail};
`, a);
}

static inline CCString cc_gr_bind_span_inline_text(CCArena* a, int k) {
    return @string(`    { size_t xa${k}, xb${k}; int xd${k} = 0;
      { size_t* xa = &xa${k}; size_t* xb = &xb${k}; int* xdr = &xd${k};
        (void)xa; (void)xb; (void)xdr;
`, a);
}

/* int over the captured span: matcher validated the digits already */
static inline CCString cc_gr_bind_int_span_text(CCArena* a, int k,
                                                const char* pfx, const char* field) {
    return @string(`      (void)xd${k};
      { long long v${k} = 0; size_t q${k} = xa${k}; int ng${k} = 0;
        if (q${k} < xb${k} && s[q${k}] == '-') { ng${k} = 1; q${k}++; }
        for (; q${k} < xb${k} && s[q${k}] >= '0' && s[q${k}] <= '9'; q${k}++)
            v${k} = v${k} * 10 + (s[q${k}] - '0');
        out->${pfx}${field} = ng${k} ? -v${k} : v${k}; } }
`, a);
}

/* float over the captured span: ffc parses JSON doubles */
static inline CCString cc_gr_bind_float_span_text(CCArena* a, int k, const char* pfx,
                                                  const char* field, const char* fail) {
    return @string(`      (void)xd${k};
      { ffc_parse_options o${k}; o${k}.format = FFC_PRESET_JSON; o${k}.decimal_point = '.';
        double v${k} = 0.0;
        ffc_result r${k} = ffc_from_chars_double_options(
            (const char*)(s + xa${k}), (const char*)(s + xb${k}), &v${k}, o${k});
        if (r${k}.outcome != FFC_OUTCOME_OK) goto ${fail};
        out->${pfx}${field} = v${k}; } }
`, a);
}

/* slice bind closers: clean spans borrow raw, dirty spans decode through
 * the rule's codec (same provenance contract as the collect/DOM tiers) */
static inline CCString cc_gr_bind_slice_codec_text(CCArena* a, int k, const char* pfx,
                                                   const char* field, const char* codec,
                                                   const char* fail) {
    return @string(`      if (!xd${k}) out->${pfx}${field} = cc_slice_from_buffer((void*)(s + xa${k}), xb${k} - xa${k});
      else if (!${codec}((const char*)(s + xa${k}), xb${k} - xa${k}, &out->${pfx}${field}, arena)) goto ${fail};
    }
`, a);
}

static inline CCString cc_gr_bind_slice_borrow_text(CCArena* a, int k,
                                                    const char* pfx, const char* field) {
    return @string(`      (void)xd${k};
      out->${pfx}${field} = cc_slice_from_buffer((void*)(s + xa${k}), xb${k} - xa${k});
    }
`, a);
}

/* counted opaque payload: exactly out->cfield bytes, borrowed */
/* cpfx: prefix for the length int; fpfx: prefix for the payload bind.
 * They differ when a field-discriminated arm reads a product-level len. */
static inline CCString cc_gr_bytes_term_text(CCArena* a, int k, const char* cpfx,
                                             const char* cfield, const char* fpfx,
                                             const char* field, const char* fail) {
    return @string(`    { long long L${k} = out->${cpfx}${cfield};
      if (L${k} < 0) goto ${fail};
      if ((unsigned long long)L${k} > (unsigned long long)(n - p)) { *cc_inc = 1; goto ${fail}; }
      out->${fpfx}${field} = cc_slice_from_buffer((void*)(s + p), (size_t)L${k});
      p += (size_t)L${k}; }
`, a);
}

/* count-driven items: cap > 0 fills the struct's INLINE array (zero
 * alloc; larger count is a protocol error), else exact-size allocation.
 * cpfx = count int prefix; fpfx = items bind prefix (may differ). */
static inline CCString cc_gr_items_counted_text(CCArena* a, int k, const char* T,
                                                const char* cpfx, const char* cfield,
                                                const char* fpfx, const char* field,
                                                int cap, const char* fail) {
    if (cap > 0)
        return @string(`    { long long C${k} = out->${cpfx}${cfield};
      if (C${k} < 0 || C${k} > ${cap}) goto ${fail};
      if ((unsigned long long)C${k} > n - p) { *cc_inc = 1; goto ${fail}; }
      for (long long i${k} = 0; i${k} < C${k}; i${k}++)
          if (!${T}__fill(s, n, &p, arena, &out->${fpfx}${field}[i${k}], cc_inc, cc_depth + 1)) goto ${fail};
      out->${fpfx}${field}_n = (size_t)C${k}; }
`, a);
    return @string(`    { long long C${k} = out->${cpfx}${cfield};
      if (C${k} < 0) goto ${fail};
      if ((unsigned long long)C${k} > n - p) { *cc_inc = 1; goto ${fail}; }
      size_t cap${k} = C${k} > 0 ? (size_t)C${k} : 1;
      ${T}* v${k} = (${T}*)cc_arena_alloc_local(arena, cap${k} * sizeof(${T}), _Alignof(${T}));
      if (!v${k}) goto ${fail};
      for (long long i${k} = 0; i${k} < C${k}; i${k}++)
          if (!${T}__fill(s, n, &p, arena, &v${k}[i${k}], cc_inc, cc_depth + 1)) goto ${fail};
      out->${fpfx}${field} = v${k}; out->${fpfx}${field}_n = (size_t)C${k}; }
`, a);
}

/* growable element-vector pieces, shared by the delimited items form and

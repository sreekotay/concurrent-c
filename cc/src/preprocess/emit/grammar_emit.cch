/* derived restore: cold backward pop of nodes born at/after the resume pos */
static inline CCString cc_gr_unwind_fn_text(CCArena* a, const char* n) {
    return @string(`static __attribute__((noinline, unused)) void ${n}__unwind(${n}__ctx* c, const unsigned char* sv) {
    while (c->total > 1 && (const unsigned char*)c->tape[c->total - 1].u.bytes >= sv)
        c->total--;
    while (c->bdepth > 0 && c->bstack[c->bdepth - 1] >= c->total) c->bdepth--;
    if (c->vanchor)
        while (c->vsp > 0 && c->vanchor[c->vsp - 1] >= sv) c->vsp--;
}
`, a);
}


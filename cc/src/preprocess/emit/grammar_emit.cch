static inline CCString cc_gr_empty_member_text(CCArena* a) {
    return @string(`    char cc__empty;
`, a);
}

/* Unit variant arms (literals only): C forbids empty structs. */
static inline CCString cc_gr_uempty_member_text(CCArena* a) {
    return @string(`            char cc__empty;
`, a);
}

static inline CCString cc_gr_struct_close_text(CCArena* a, const char* n) {
    return @string(`} ${n};
`, a);
}

/* Comptime capacity for `items Elem count cap N` — call sites derive array
 * sizes from this instead of restating N. */
static inline CCString cc_gr_items_cap_text(CCArena* a, const char* sname,
                                            const char* field, int cap) {
    return @string(`enum { ${sname}_${field}_cap = ${cap} };
`, a);
}

static inline CCString cc_gr_fill_head_text(CCArena* a, const char* n) {
    return @string(`static int ${n}__fill(const unsigned char* s, size_t n, size_t* io,
        CCArena* arena, ${n}* out, int* cc_inc, int cc_depth) {
    (void)cc_inc; (void)cc_depth;
    size_t p = *io;
    (void)arena;
`, a);
}

static inline CCString cc_gr_fill_zero_text(CCArena* a) {
    return @string(`    memset(out, 0, sizeof *out);
`, a);
}

static inline CCString cc_gr_fill_tail_text(CCArena* a, const char* fail) {
    return @string(`    *io = p;
    return 1;
${fail}: __attribute__((unused));
    return 0;
}
`, a);
}

static inline CCString cc_gr_parse_fn_text(CCArena* a, const char* n) {
    return @string(`static int ${n}_parse(const char* s0, size_t n, CCArena* arena, ${n}* out) {
    const unsigned char* s = (const unsigned char*)s0;
    size_t p = 0;
    { int cc_i0 = 0;
    if (!${n}__fill(s, n, &p, arena, out, &cc_i0, 0)) return 0; }
    return p == n;
}
`, a);
}

/* Public measure face: exact encoded size (0 = cannot emit / invalid kind).
 * Same substrate as cc_write / cc_format; no destination buffer. */
static inline CCString cc_gr_measure_fn_text(CCArena* a, const char* n) {
    return @string(`static __attribute__((unused)) size_t ${n}_measure(const ${n}* v) {
    return ${n}__wmeasure(v);
}
`, a);
}

/* CCString face: measure once, allocate exactly, write unchecked */
static inline CCString cc_gr_tostr_fn_text(CCArena* a, const char* n) {
    return @string(`static __attribute__((unused)) CCString ${n}_to_str(const ${n}* v, CCArena* arena) {
    CCString s = cc_string_new();
    size_t need = ${n}__wmeasure(v);
    char* buf = (char*)cc_arena_alloc_local(arena, need ? need : 1, 1);
    if (!buf) return s;
    ${n}__wput(v, buf);
    cc_string_push_buffer(&s, buf, (uint32_t)need, arena);
    return s;
}
`, a);
}

/* ---- recursive rules core (rg_emit_node): every text shape the node
 * walker emits.  Recursion, mode logic, and FIRST-set analysis stay in C;
 * the backtracking tails compose from shared save/restore/ok pieces. ---- */

/* charset membership expressions (rg_cs_expr forms) */
static inline CCString cc_gr_cse_eq_text(CCArena* a, int lo) {
    return @string(`s[p] == ${lo}`, a);
}

static inline CCString cc_gr_cse_range_text(CCArena* a, int lo, unsigned int span) {
    return @string(`((unsigned)(s[p] - ${lo}) <= ${span}u)`, a);
}

static inline CCString cc_gr_cse_bytes_text(CCArena* a, int b0, int b1, int b2, int b3, int nb) {
    CCString o = cc_string_new();
    int bs[4];
    bs[0] = b0; bs[1] = b1; bs[2] = b2; bs[3] = b3;
    if (nb > 1) cc_gr__cat(&o, @string(`(`, a), a);
    for (int i = 0; i < nb; i++) {
        int b = bs[i];
        if (i) cc_gr__cat(&o, @string(` || `, a), a);
        cc_gr__cat(&o, @string(`s[p] == ${b}`, a), a);
    }
    if (nb > 1) cc_gr__cat(&o, @string(`)`, a), a);
    return o;
}

static inline CCString cc_gr_cse_bitset_text(CCArena* a, const char* n, int cs) {
    return @string(`(${n}__cs[${cs}][((unsigned char)s[p]) >> 3] & (1u << (((unsigned char)s[p]) & 7u)))`, a);
}

/* literal matches: single byte, 4/5-byte word compare, pool memcmp */
static inline CCString cc_gr_m_lit1_text(CCArena* a, int b, const char* fail) {
    CCString c = cc_gr_chr_text(a, b);
    return @string(`    if (!(p < n && s[p] == ${b} /*${c}*/)) goto ${fail};
    p++;
`, a);
}

static inline CCString cc_gr_m_word_text(CCArena* a, unsigned int w, const unsigned char* bytes,
                                         int len, const char* fail) {
    CCString lit = cc_gr_esc_text(a, bytes, len);
    if (len == 4)
        return @string(`    if (!(p + 4 <= n)) goto ${fail};
    { unsigned int w; memcpy(&w, s + p, 4); if (w != ${w}u) goto ${fail}; }  /* "${lit}" */
    p += 4;
`, a);
    {
        int b4 = (int)bytes[4];
        return @string(`    if (!(p + 5 <= n)) goto ${fail};
    { unsigned int w; memcpy(&w, s + p, 4); if (w != ${w}u || s[p + 4] != ${b4}) goto ${fail}; }  /* "${lit}" */
    p += 5;
`, a);
    }
}

static inline CCString cc_gr_m_litn_text(CCArena* a, const char* n, int off, int len,
                                         const unsigned char* bytes, const char* fail) {
    CCString lit = cc_gr_esc_text(a, bytes, len);
    return @string(`    if (!(p + ${len} <= n && memcmp(s + p, ${n}__pool + ${off}, ${len}) == 0)) goto ${fail};   /* "${lit}" */
    p += ${len};
`, a);
}

static inline CCString cc_gr_m_cs1_text(CCArena* a, CCString cx, const char* fail) {
    return @string(`    if (!(p < n && ${cx})) goto ${fail};
    p++;
`, a);
}

static inline CCString cc_gr_m_skip_text(CCArena* a, const char* fail) {
    return @string(`    if (!(p < n)) goto ${fail};
    p++;
`, a);
}

/* pp-token kind terminal: host supplies `cc_grammar_ppkind_at` (weak default
 * in <ccc/cc_grammar.cch> returns 0). On match the hook advances *io. */
static inline CCString cc_gr_m_ppkind_text(CCArena* a, const char* n, const char* kind,
                                           int klen, const char* fail) {
    (void)n;
    CCString kn = cc_gr_esc_text(a, (const unsigned char*)kind, klen);
    return @string(`    if (!cc_grammar_ppkind_at(s, n, &p, "${kn}")) goto ${fail};
`, a);
}

/* Fallible miss leaf: zero-width tape node at the restored cursor (collect). */
static inline CCString cc_gr_fallible_leaf_text(CCArena* a, const char* n, int rid,
                                                 const char* fail) {
    return @string(`    if (c->total == c->cap && !${n}__tgrow(c)) goto ${fail};
    { ${n}Node* ndf = &c->tape[c->total++];
      ndf->meta = ${rid}u;
      ndf->u.bytes = (const char*)(s + p); }
`, a);
}

/* rule reference call: class r/m (plain) or b (collect ctx), opt. __np */
static inline CCString cc_gr_ref_call_text(CCArena* a, const char* n, const char* cls,
                                           const char* r, const char* suf, int with_ctx,
                                           const char* fail) {
    if (with_ctx)
        return @string(`    if (!${n}__${cls}_${r}${suf}(c, s, n, &p)) goto ${fail};
`, a);
    return @string(`    if (!${n}__${cls}_${r}${suf}(s, n, &p)) goto ${fail};
`, a);
}

/* keep: span anchor open, extract-mode close, tape writes */
static inline CCString cc_gr_keep_open_text(CCArena* a, int k, int has_codec) {
    if (has_codec)
        return @string(`    { size_t ka${k} = p; int dr${k} = 0; (void)dr${k};
`, a);
    return @string(`    { size_t ka${k} = p;
`, a);
}

static inline CCString cc_gr_keep_x_close_text(CCArena* a, int k, int has_codec) {
    if (has_codec)
        return @string(`    *xa = ka${k}; *xb = p; *xdr = dr${k};
    }
`, a);
    return @string(`    *xa = ka${k}; *xb = p;
    }
`, a);
}

static inline CCString cc_gr_tgrow_guard_text(CCArena* a, const char* n, const char* fail) {
    return @string(`    if (c->total == c->cap && !${n}__tgrow(c)) goto ${fail};
`, a);
}

static inline CCString cc_gr_keep_tape_text(CCArena* a, const char* n, int k, int rid) {
    return @string(`    { ${n}Node* nd${k} = &c->tape[c->total++];
      nd${k}->meta = ${rid}u | (((unsigned long long)(p - ka${k})) << 10);
      nd${k}->u.bytes = (const char*)(s + ka${k}); }
    }
`, a);
}

/* codec keep: raw span on the tape (unwind anchor); dirty spans decode NOW
 * into the mat_* stash while hot */
static inline CCString cc_gr_keep_codec_tape_text(CCArena* a, const char* n, int k, int rid,
                                                  int cb, const char* codec, const char* fail) {
    return @string(`    { size_t ti${k} = c->total;
      ${n}Node* nd${k} = &c->tape[c->total++];
      nd${k}->meta = ${rid}u | (dr${k} ? 0x200u : 0u) | (((unsigned long long)(p - ka${k})) << 10);
      nd${k}->u.bytes = (const char*)(s + ka${k});
      if (dr${k}) {
        if (!c->mat_ptr) {
          c->mat_ptr = (const char**)cc_arena_alloc_local(c->arena, c->cap * sizeof(char*), 8);
          c->mat_len = (size_t*)cc_arena_alloc_local(c->arena, c->cap * sizeof(size_t), 8);
          c->mat_cow = (unsigned char*)cc_arena_alloc_local(c->arena, c->cap, 1);
          if (!c->mat_ptr || !c->mat_len || !c->mat_cow) goto ${fail};
          memset(c->mat_ptr, 0, c->cap * sizeof(char*));
        }
        { CCSlice v${k};
          switch (${cb}) {
          case ${cb}: if (!${codec}((const char*)(s + ka${k}), (size_t)(p - ka${k}), &v${k}, c->arena)) goto ${fail}; break;
          default: goto ${fail};
          }
          c->mat_ptr[ti${k}] = (const char*)v${k}.ptr;
          c->mat_len[ti${k}] = v${k}.len;
          c->mat_cow[ti${k}] = (unsigned char)cc_slice_is_unique(v${k});
        }
      }
    }
    }
`, a);
}

/* collect: BEGIN/END markers bracket the child's span */
static inline CCString cc_gr_collect_begin_text(CCArena* a, const char* n, int rid,
                                                const char* fail, int dom) {
    CCString o = cc_string_new();
    cc_gr__cat(&o, @string(`    { if (c->bdepth >= 512) goto ${fail};
        if (c->total == c->cap && !${n}__tgrow(c)) goto ${fail};
        c->tape[c->total].meta = 0x100u | ${rid}u;
        c->tape[c->total].u.bytes = (const char*)(s + p);   /* source anchor */
`, a), a);
    if (dom)
        cc_gr__cat(&o, @string(`        if (c->sb) c->vbase[c->bdepth] = c->vsp;
`, a), a);
    cc_gr__cat(&o, @string(`        c->bstack[c->bdepth++] = c->total++; }
`, a), a);
    return o;
}

static inline CCString cc_gr_collect_end_text(CCArena* a, const char* n,
                                              const char* fail, int dom) {
    if (dom)
        return @string(`    { size_t bi = c->bstack[--c->bdepth];
        c->tape[bi].meta |= ((unsigned long long)(c->total - bi)) << 10;
        if (c->sb && !${n}__shape_end(c, bi)) goto ${fail};
    }
`, a);
    return @string(`    { size_t bi = c->bstack[--c->bdepth];
        c->tape[bi].meta |= ((unsigned long long)(c->total - bi)) << 10; }
`, a);
}

/* ALT first-set dispatch skeleton */
static inline CCString cc_gr_alt_disp_head_text(CCArena* a, int k) {
    return @string(`    {
    if (p >= n) goto Lb${k};
    switch (s[p]) {
`, a);
}

static inline CCString cc_gr_alt_case_text(CCArena* a, int bch) {
    return @string(`    case ${bch}:
`, a);
}

static inline CCString cc_gr_mark_dirty_text(CCArena* a, int dk) {
    return @string(`    dr${dk} = 1;
`, a);
}

static inline CCString cc_gr_break_text(CCArena* a) {
    return @string(`    break;
`, a);
}

static inline CCString cc_gr_default_text(CCArena* a) {
    return @string(`    default:
`, a);
}

static inline CCString cc_gr_alt_default_fail_text(CCArena* a, int k) {
    return @string(`    default: goto Lb${k};
`, a);
}

static inline CCString cc_gr_alt_disp_tail_text(CCArena* a, int k, const char* fail) {
    return @string(`    }
    goto Lok${k};
Lb${k}: goto ${fail};
Lok${k}: ; }
`, a);
}

/* backtracking building blocks: cursor (+tape snapshot) save and restore.
 * risky = keeps under a codec keep: tape/bdepth/vsp roll back by value;
 * unwind = plain keeps: the engine's __unwind truncates the tape. */
static inline CCString cc_gr_save_text(CCArena* a, int k, int risky) {
    if (risky)
        return @string(`    { size_t sv${k} = p; size_t lt${k} = c->total, ld${k} = c->bdepth, lv${k} = c->vsp;
`, a);
    return @string(`    { size_t sv${k} = p;
`, a);
}

static inline CCString cc_gr_goto_ok_text(CCArena* a, int k) {
    return @string(`    goto Lok${k};
`, a);
}

/* rk: 0 plain cursor restore, 1 unwind call, 2 by-value tape restore */
static inline CCString cc_gr_restore_text(CCArena* a, const char* br, int k, int rk,
                                          const char* n) {
    if (rk == 2)
        return @string(`${br}: p = sv${k}; { c->total = lt${k}; c->bdepth = ld${k}; c->vsp = lv${k}; }
`, a);
    if (rk == 1)
        return @string(`${br}: p = sv${k}; ${n}__unwind(c, s + p);
`, a);
    return @string(`${br}: p = sv${k};
`, a);
}

static inline CCString cc_gr_goto_fail_text(CCArena* a, const char* fail) {
    return @string(`    goto ${fail};
`, a);
}

static inline CCString cc_gr_ok_close_text(CCArena* a, int k) {
    return @string(`Lok${k}: ; }
`, a);
}

/* fused string-body scan: SWAR run + escape arm */
static inline CCString cc_gr_forever_open_text(CCArena* a) {
    return @string(`    for (;;) {
`, a);
}

static inline CCString cc_gr_cs_run_text(CCArena* a, CCString cx) {
    return @string(`    while (p < n && ${cx}) p++;
`, a);
}

static inline CCString cc_gr_scan_esc_tail_text(CCArena* a, const char* br, int k) {
    return @string(`    continue;
${br}: p = sv${k}; }
    break;
    }
`, a);
}

/* any/some generic loop frame */
static inline CCString cc_gr_loop_head_text(CCArena* a, int k, int risky) {
    if (risky)
        return @string(`    { size_t sv${k}; size_t lt${k} = 0, ld${k} = 0, lv${k} = 0;
    for (;;) { sv${k} = p; lt${k} = c->total; ld${k} = c->bdepth; lv${k} = c->vsp;
`, a);
    return @string(`    { size_t sv${k};
    for (;;) { sv${k} = p;
`, a);
}

static inline CCString cc_gr_loop_break_text(CCArena* a, int k) {
    return @string(`    if (p == sv${k}) break;
    }
`, a);
}


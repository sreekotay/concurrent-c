/* vk: 0 int, 1 float, 2 slice, 3 cap-array, 4 arena pointer */
static inline CCString cc_gr_member_text(CCArena* a, int vk, const char* T,
                                         const char* field, int cap) {
    if (vk == 0) return @string(`    long long ${field};
`, a);
    if (vk == 1) return @string(`    double ${field};
`, a);
    if (vk == 2) return @string(`    CCSlice ${field};
`, a);
    if (vk == 3) return @string(`    ${T} ${field}[${cap}]; size_t ${field}_n;
`, a);
    return @string(`    ${T}* ${field}; size_t ${field}_n;
`, a);
}

/* union-variant member: deeper indent, self-references need `struct` */
static inline CCString cc_gr_umember_text(CCArena* a, int vk, const char* T,
                                          const char* field, int cap) {
    if (vk == 0) return @string(`            long long ${field};
`, a);
    if (vk == 1) return @string(`            double ${field};
`, a);
    if (vk == 2) return @string(`            CCSlice ${field};
`, a);
    if (vk == 3) return @string(`            ${T} ${field}[${cap}]; size_t ${field}_n;
`, a);
    return @string(`            struct ${T}* ${field}; size_t ${field}_n;
`, a);
}


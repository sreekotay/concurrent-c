`, a);
}

static inline CCString cc_gr_ffc_include_text(CCArena* a) {
    return @string(`#include <ccc/vendor/ffc.h>
`, a);
}

static inline CCString cc_gr_struct_open_text(CCArena* a, const char* n) {
    return @string(`typedef struct ${n} {
`, a);

/* rule function prototype / head; al carries the linkage+inline attr text */
static inline CCString cc_gr_rule_proto_text(CCArena* a, const char* al, const char* n,
                                             const char* cls, const char* r, const char* suf,
                                             int with_ctx) {
    if (with_ctx)
        return @string(`${al}${n}__${cls}_${r}${suf}(${n}__ctx* c, const unsigned char* s, size_t n, size_t* io);
`, a);
    return @string(`${al}${n}__${cls}_${r}${suf}(const unsigned char* s, size_t n, size_t* io);
`, a);
}

static inline CCString cc_gr_rule_head_text(CCArena* a, const char* al, const char* n,
                                            const char* cls, const char* r, const char* suf,
                                            int with_ctx) {
    if (with_ctx)
        return @string(`${al}${n}__${cls}_${r}${suf}(${n}__ctx* c, const unsigned char* s, size_t n, size_t* io) {
    size_t p = *io;
    (void)c; (void)s; (void)n;
`, a);
    return @string(`${al}${n}__${cls}_${r}${suf}(const unsigned char* s, size_t n, size_t* io) {
    size_t p = *io;
    (void)s; (void)n;
`, a);
}


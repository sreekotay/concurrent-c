            cap${k} * sizeof(${T}), cap${k} * 2 * sizeof(${T}), _Alignof(${T}));
        if (!nv${k}) goto ${fail};
        v${k} = nv${k}; cap${k} *= 2;
    }
`, a);
}

static inline CCString cc_gr_lvec_fill_text(CCArena* a, int k, const char* T, const char* fail) {

/* parse entry: tape ctx setup, entry dispatch, root span back-patch */
static inline CCString cc_gr_parse_entry_head_text(CCArena* a, const char* n) {
    return @string(`static ${n}Node* ${n}_parse(const char* s, size_t n, CCArena* arena) {
    ${n}__ctx c0;
    size_t p = 0;
    c0.cap = 2048 + (n / 24);  /* ~real density; tgrow covers denser input */
    c0.tape = (${n}Node*)cc_arena_alloc_local(arena, c0.cap * sizeof(${n}Node), _Alignof(${n}Node));
    if (!c0.tape) return 0;
    c0.total = 1; c0.bdepth = 0; c0.arena = arena;
    c0.mat_ptr = 0; c0.mat_len = 0; c0.mat_cow = 0;
    c0.sb = 0; c0.vstack = 0; c0.vanchor = 0; c0.vsp = 0; c0.vcap = 0;
    c0.tape[0].meta = 0x100u | 0xFFu;   /* root list */
    c0.tape[0].u.bytes = s;             /* source anchor */
#if ${n}__ENTRY_PURE
    if (!${n}__ENTRY_B((const unsigned char*)s, n, &p) || p != n) return 0;
#else
    if (!${n}__ENTRY_B(&c0, (const unsigned char*)s, n, &p) || p != n) return 0;
#endif
    c0.tape[0].meta |= ((unsigned long long)c0.total) << 10;
`, a);
}

/* materialize: install the eager mat_* stash; fallback codec decode */
static inline CCString cc_gr_mat_head_text(CCArena* a, const char* n) {
    return @string(`    { size_t t;
    for (t = 1; t < c0.total; t++) {
        unsigned long long m = c0.tape[t].meta;
        if ((m & 0x300u) != 0x200u) continue;   /* dirty leaves only */
        { int id = (int)(m & 0xFFu);
          if (c0.mat_ptr && c0.mat_ptr[t]) {
            c0.tape[t].meta = (unsigned long long)id
                | (c0.mat_cow[t] ? 0x200u : 0u)
                | (((unsigned long long)c0.mat_len[t]) << 10);
            c0.tape[t].u.bytes = c0.mat_ptr[t];
            continue;
          }
          { CCSlice v;
            const char* kp = c0.tape[t].u.bytes;
            size_t kl = (size_t)(m >> 10);
            switch (${n}__codec_of[id]) {
`, a);
}

static inline CCString cc_gr_mat_case_text(CCArena* a, int ci, const char* codec) {
    return @string(`            case ${ci}: if (!${codec}(kp, kl, &v, arena)) return 0; break;
`, a);
}

static inline CCString cc_gr_mat_tail_text(CCArena* a) {
    return @string(`            default: continue;
            }
            c0.tape[t].meta = (unsigned long long)id
                | (cc_slice_is_unique(v) ? 0x200u : 0u)
                | (((unsigned long long)v.len) << 10);
            c0.tape[t].u.bytes = (const char*)v.ptr; } }
    } }
`, a);
}

static inline CCString cc_gr_parse_entry_tail_text(CCArena* a) {
    return @string(`    return c0.tape;
}
`, a);
}

static inline CCString cc_gr_collect_fn_text(CCArena* a, const char* n) {
    return @string(`static int ${n}_collect(const char* s, size_t n, CCArena* arena,
        int (*cb)(void* env, int id, CCSlice v), void* env) {
    ${n}Node* tape = ${n}_parse(s, n, arena);
    if (!tape) return 0;
    { size_t total = (size_t)(tape[0].meta >> 10);
    for (size_t t = 1; t < total; t++) {
        if ((tape[t].meta >> 8) & 1u) continue;   /* interior */
        { CCSlice v; ${n}Node_slice(&tape[t], &v);
          if (cb(env, (int)(tape[t].meta & 0xFFu), v)) return 0; }
    } }
    return 1;
}
`, a);
}

/* shaped-DOM substrate: container classification, value-stack grow,
 * leaf shaping, bottom-up shape_end, and the dom entry */
static inline CCString cc_gr_dynobj_head_text(CCArena* a, const char* n, int nrules) {
    return @string(`static const unsigned char ${n}__dynobj[${nrules}] = {`, a);
}

static inline CCString cc_gr_dynobj_item_text(CCArena* a, const char* sep, int v) {
    return @string(`${sep}${v}`, a);
}

static inline CCString cc_gr_vgrow_fn_text(CCArena* a, const char* n) {
    return @string(`static __attribute__((noinline)) int ${n}__vgrow(${n}__ctx* c) {
    size_t nc = c->vcap * 2;
    CCShapeVal* nv = (CCShapeVal*)cc_arena_realloc(c->arena, c->arena, c->vstack,
        c->vcap * sizeof(CCShapeVal), nc * sizeof(CCShapeVal), 16);
    const unsigned char** na = (const unsigned char**)cc_arena_realloc(c->arena, c->arena,
        (void*)c->vanchor, c->vcap * sizeof(void*), nc * sizeof(void*), 16);
    if (!nv || !na) return 0;
    c->vstack = nv; c->vanchor = na; c->vcap = nc; return 1;
}
`, a);
}

static inline CCString cc_gr_shape_leaf_head_text(CCArena* a, const char* n) {
    return @string(`static int ${n}__shape_leaf(${n}__ctx* c, const ${n}Node* ln, CCShapeVal* out) {
    unsigned long long m = ln->meta;
    int id = (int)(m & 0xFFu);
`, a);
}

static inline CCString cc_gr_shape_leaf_dirty_head_text(CCArena* a, const char* n) {
    return @string(`    if (m & 0x200u) {   /* dirty: prefer keep-commit stash; else decode */
        size_t ti = (size_t)(ln - c->tape);
        if (c->mat_ptr && c->mat_ptr[ti]) {
            *out = cc_shape_leaf(id, c->mat_ptr[ti], c->mat_len[ti], c->mat_cow[ti]);
            return 1;
        }
        { CCSlice v;
        switch (${n}__codec_of[id]) {
`, a);
}

static inline CCString cc_gr_shape_leaf_case_text(CCArena* a, int ci, const char* codec) {
    return @string(`        case ${ci}: if (!${codec}((const char*)ln->u.bytes, (size_t)(m >> 10), &v, c->arena)) return 0; break;
`, a);
}

static inline CCString cc_gr_shape_leaf_dirty_tail_text(CCArena* a) {
    return @string(`        default: *out = cc_shape_leaf(id, ln->u.bytes, (size_t)(m >> 10), 0); return 1;
        }
        *out = cc_shape_leaf(id, (const char*)v.ptr, v.len, cc_slice_is_unique(v));
        return 1; }
    }
`, a);
}

static inline CCString cc_gr_shape_leaf_tail_text(CCArena* a) {
    return @string(`    *out = cc_shape_leaf(id, ln->u.bytes, (size_t)(m >> 10), 0);
    return 1;
}
`, a);
}

static inline CCString cc_gr_shape_end_fn_text(CCArena* a, const char* n, int nrules) {
    return @string(`static int ${n}__shape_end(${n}__ctx* c, size_t bi) {
    ${n}Node* nd = c->tape + bi;
    size_t span = c->total - bi;
    int id = (int)(nd->meta & 0xFFu);
    size_t vb = c->vbase[c->bdepth];
    size_t vidx = vb;
    CCShapeVal out;
    size_t cnt = 0;
    int pairs = id != 0xFF && id < ${nrules} && ${n}__dynobj[id];
    { size_t t = 1; int odd = 0;
      while (t < span) {
          unsigned long long cm = nd[t].meta;
          if (pairs && !odd && ((cm >> 8) & 1u)) pairs = 0;
          odd ^= 1; cnt++;
          t += ((cm >> 8) & 1u) ? (size_t)(cm >> 10) : 1;
      }
      if (odd) pairs = 0;   /* dangling key */
    }
    if (pairs) {
        CCShapeObjD od;
        if (!cc_shape_objd_begin(c->sb, &od, (unsigned)(cnt / 2))) return 0;
        { size_t t = 1;
          while (t < span) {
              const ${n}Node* kn = nd + t;
              t++;
              { unsigned long long vm = nd[t].meta;
                CCShapeVal* tgt = cc_shape_objd_slot(c->sb, &od,
                    kn->u.bytes, (unsigned)(kn->meta >> 10));
                if (!tgt) return 0;
                if (!((vm >> 8) & 1u)) {
                    if (!${n}__shape_leaf(c, nd + t, tgt)) return 0;
                    t += 1;
                } else {
                    *tgt = c->vstack[vidx++];
                    t += (size_t)(vm >> 10);
                } }
          } }
        if (!cc_shape_objd_end(c->sb, &od, &out)) return 0;
    } else {
        CCShapeVal av;
        CCShapeVal* items = cc_shape_arrd(c->sb, cnt, &av);
        if (!items) return 0;
        { size_t t = 1, i = 0;
          while (t < span) {
              unsigned long long cm = nd[t].meta;
              if (!((cm >> 8) & 1u)) {
                  if (!${n}__shape_leaf(c, nd + t, &items[i++])) return 0;
                  t += 1;
              } else {
                  items[i++] = c->vstack[vidx++];
                  t += (size_t)(cm >> 10);
              }
          } }
        out = av;
    }
    /* consume children values, push own (anchored at the open) */
    c->vsp = vb;
    if (c->vsp == c->vcap && !${n}__vgrow(c)) return 0;
    c->vanchor[c->vsp] = (const unsigned char*)nd->u.bytes;
    c->vstack[c->vsp++] = out;
    return 1;
}
`, a);
}

static inline CCString cc_gr_dom_entry_text(CCArena* a, const char* n) {
    return @string(`static __attribute__((unused)) int ${n}_dom(const char* s0, size_t n,
        CCShapeReg* reg, CCArena* arena, CCShapeVal* out) {
    const unsigned char* s = (const unsigned char*)s0;
    ${n}__ctx c0;
    size_t p = 0;
    CCShapeB b;
    c0.cap = 2048 + (n / 24);  /* ~real density; tgrow covers denser input */
    c0.tape = (${n}Node*)cc_arena_alloc_local(arena, c0.cap * sizeof(${n}Node), _Alignof(${n}Node));
    if (!c0.tape) return 0;
    c0.total = 1; c0.bdepth = 0; c0.arena = arena;
    c0.mat_ptr = 0; c0.mat_len = 0; c0.mat_cow = 0;
    c0.tape[0].meta = 0x100u | 0xFFu;
    c0.tape[0].u.bytes = (const char*)s;
    cc_shape_build(&b, reg, arena);
    c0.sb = &b;
    c0.vcap = 256 + (n / 32);
    c0.vstack = (CCShapeVal*)cc_arena_alloc_local(arena, c0.vcap * sizeof(CCShapeVal), 16);
    c0.vanchor = (const unsigned char**)cc_arena_alloc_local(arena, c0.vcap * sizeof(void*), 16);
    if (!c0.vstack || !c0.vanchor) return 0;
    c0.vsp = 0;
    c0.vbase[0] = 0;
#if ${n}__ENTRY_PURE
    if (!${n}__ENTRY_B((const unsigned char*)s, n, &p) || p != n) return 0;
#else
    if (!${n}__ENTRY_B(&c0, (const unsigned char*)s, n, &p) || p != n) return 0;
#endif
    c0.tape[0].meta |= ((unsigned long long)c0.total) << 10;
    c0.bdepth = 0;
    if (!${n}__shape_end(&c0, 0)) return 0;
    *out = c0.vstack[0];
    if (cc_shape_kind(out) == CC_SHAPE_ARR && out->u.arr->n == 1)
        *out = out->u.arr->items[0];   /* single root: unwrap */
    return 1;
}
`, a);
}

/* ---- rules-tier match entry ---- */
static inline CCString cc_gr_match_entry_text(CCArena* a, const char* n) {
    return @string(`static int ${n}_match(const char* s, size_t n) {
    size_t p = 0;
    if (!${n}__ENTRY_M((const unsigned char*)s, n, &p)) return 0;
    return p == n;
}
`, a);
}

/* ---- schema streaming face: try_read / read / Reader cursor ----
 * try_read speaks the channel-recv Result contract: Ok(true) frame
 * parsed + pos advanced; Ok(false) clean end AT a frame boundary;
 * Err(WOULD_BLOCK) partial frame, pos unmoved (refill and retry — the
 * caller, who alone knows whether more bytes can exist, escalates to
 * truncation); Err(PARSE) malformed with the evidence in hand.  The
 * Reader is a CURSOR over resources (buffer, position, arena) — all
 * behavior was specialized at compile time; _next returns 0 at clean
 * end AND on parse error, distinguished by _at_end.  Methods are named
 * after the RECEIVER type so instance UFCS resolves by convention.
 * The `!>` in the emitted signature is SURFACE syntax: generated code
 * speaks the language's own idiom (the result rewriter runs after the
 * grammar seam). */
static inline CCString cc_gr_stream_face_text(CCArena* a, const char* n) {
    return @string(`static bool !>(CCError) ${n}_try_read(const char* s0, size_t n,
        size_t* pos, CCArena* arena, ${n}* out) {
    size_t p = *pos;
    int cc_i0 = 0;
    if (p >= n) return cc_ok(false);   /* clean end at frame boundary */
    if (${n}__fill((const unsigned char*)s0, n, &p, arena, out, &cc_i0, 0)) {
        *pos = p;
        return cc_ok(true);
    }
    if (cc_i0) return cc_err(CC_ERROR(CC_ERR_WOULD_BLOCK, "${n}: incomplete frame"));
    return cc_err(CC_ERROR(CC_ERR_PARSE, "${n}: malformed input"));
}
static int ${n}_read(const char* s0, size_t n, size_t* pos, CCArena* arena, ${n}* out) {
    int cc_i0 = 0;
    return ${n}__fill((const unsigned char*)s0, n, pos, arena, out, &cc_i0, 0);
}
typedef struct ${n}Reader {
    const char* s; size_t n; size_t pos; CCArena* arena;
} ${n}Reader;
static ${n}Reader ${n}_reader(const char* s, size_t n, CCArena* arena) {
    ${n}Reader r; r.s = s; r.n = n; r.pos = 0; r.arena = arena; return r;
}
static int ${n}Reader_next(${n}Reader* r, ${n}* out) {
    if (r->pos >= r->n) return 0;
    int cc_i0 = 0;
    return ${n}__fill((const unsigned char*)r->s, r->n, &r->pos, r->arena, out, &cc_i0, 0);
}
static int ${n}Reader_at_end(const ${n}Reader* r) { return r->pos == r->n; }
`, a);
}

#endif /* CC_GRAMMAR_EMIT_CCH */

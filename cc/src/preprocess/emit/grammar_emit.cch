static inline CCString cc_gr_rules_manifest_dom_text(CCArena* a, const char* n) {
    return @string(` *   cc_dom(${n}, s, n, reg, arena, &out)      -> ${n}_dom (shaped: hidden-class DOM)
`, a);
}

static inline CCString cc_gr_rules_manifest_nodes_text(CCArena* a, const char* n) {

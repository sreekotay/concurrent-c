#pragma(@per_tu)
/* Clean lowerer, step: generic instances. `Vec::[T]` in a type position is
 * its instance name (`CCVec_int`); `snake(Family)_member::[args](call-args)`
 * is `<Instance>_member(call-args)`; and every instance the unit mentions
 * gets the family factory's expansion, as the index instantiated it, spliced
 * after the leading includes under a guard, type arguments' instances first.
 * A hand-declared instance (a header's `CC_VEC_DECL_ARENA(...)`) suppresses
 * the splice. Lifetime: the lowerer arena. */
#ifndef CC_LOWER_GENERICS_CCH
#define CC_LOWER_GENERICS_CCH
#include "lower.cch"
#include "parse.cch"
#include "typing.cch"

typedef struct GStep {
    CcLowerer* L;
    CcNameList order;           /* instance names in emission order */
} GStep;

static bool gn_seen(GStep* st, CCSlice name) {
    CcNameList* o = &st->order;
    size_t n = o->len();
    size_t i;
    for (i = 0; i < n; i++) {
        CCSlice s = *o->get_ptr(i);
        if (cc_slice_eq(&s, name)) return true;
    }
    return false;
}

/* Note an instance for emission, its type arguments' instances first. */
static void gn_note(GStep* st, CcTypeInfo* info, int depth) {
    CcIndex* ix = st->L->ix;
    CcTypeList* targv;
    size_t n;
    size_t i;
    if (!info || !info->family.len || depth > 8) return;
    if (gn_seen(st, info->name)) return;
    targv = &info->targs;
    n = targv->len();
    for (i = 0; i < n; i++) {
        CcType* at = *targv->get_ptr(i);
        CCSlice an = ix->canon(at);
        CcTypeInfo* ai = ix->type_get(an);
        gn_note(st, ai, depth + 1);
    }
    st->order.push(info->name);
}

/* Does the instance's constructor return a pointer to it? `cc__<name>_new`
 * (the factory's wrapper) or `<name>_init` (the declaration macro's). */
static bool gn_instance_is_pointer(CcLowerer* L, CCSlice name) {
    CcIndex* ix = L->ix;
    const char* suffixes[2];
    const char* prefixes[2];
    int i;
    suffixes[0] = "_new"; prefixes[0] = "cc__";
    suffixes[1] = "_init"; prefixes[1] = "";
    for (i = 0; i < 2; i++) {
        CCString nm = @string(`${prefixes[i]}${name}${suffixes[i]}`, L->arena);
        CCSlice fname = lw_keep(L, &nm);
        CcSym* sym = ix->sym(fname) ?> NULL;
        while (sym && sym->kind != CC_SYM_FUNC) sym = sym->same_name;
        if (!sym || !sym->type) continue;
        @switch (sym->type->k) {
            case .func(ft): return ft.ret && ft.ret->k.kind == CcTypeK_pointer;
            default: break;
        }
    }
    return false;
}

static bool gn_type_visit(CcType* t, void* env) {
    GStep* st = (GStep*)env;
    CcIndex* ix = st->L->ix;
    bool is_generic = false;
    @switch (t->k) {
        case .generic: is_generic = true; break;
        /* `T[:]` is an instance of the slice family, named by the same
         * canonical spelling: `CCSlice` for the char family, `CCSlice_T`
         * for anything else */
        case .slice: is_generic = true; break;
        default: break;
    }
    if (!is_generic) return true;
    {
        CCSlice name = ix->canon(t);      /* instantiates on first use */
        CcTypeInfo* info = ix->type_get(name);
        CcNamedType nt;
        gn_note(st, info, 0);
        memset(&nt, 0, sizeof(nt));
        nt.name = name;
        if (gn_instance_is_pointer(st->L, name)) {
            /* a family whose constructor returns `Instance*` (Map, ArrayMap):
             * the spelled type is the pointer */
            CcType* base = cc_type_named(name, t->span, st->L->arena);
            CcPointerType pt;
            pt.pointee = base;
            t->k = { .pointer = pt };
        } else {
            t->k = { .named = nt };
        }
    }
    return false;
}

/* `snake(Family)`: lowercased, `_` before an uppercase letter that follows a lowercase one. */
static CCSlice gn_snake(CcLowerer* L, CCSlice fam) {
    CCString sb = cc_string_new();
    size_t i;
    for (i = 0; i < fam.len; i++) {
        char c = fam.ptr[i];
        if (c >= 'A' && c <= 'Z') {
            if (i > 0 && fam.ptr[i - 1] >= 'a' && fam.ptr[i - 1] <= 'z') cc_string_push_char(&sb, '_', L->arena);
            cc_string_push_char(&sb, (char)(c - 'A' + 'a'), L->arena);
        } else {
            cc_string_push_char(&sb, c, L->arena);
        }
    }
    return lw_keep(L, &sb);
}

static bool gn_expr_visit(CcExpr* e, void* env) {
    GStep* st = (GStep*)env;
    CcLowerer* L = st->L;
    CcIndex* ix = L->ix;
    CcGenericFn gf;
    bool hit = false;
    CCSlice name;
    CcDeclList* factv;
    size_t nf;
    size_t f;
    @switch (e->k) {
        case .generic_fn(x): gf = x; hit = true; break;
        default: break;
    }
    if (!hit) return true;
    name = gf.name;
    if (name.len > 3 && memcmp(name.ptr, "cc_", 3) == 0) name = cc_slice_from_buffer((char*)name.ptr + 3, name.len - 3);
    factv = &ix->factories;
    nf = factv->len();
    for (f = 0; f < nf; f++) {
        CcDecl* d = *factv->get_ptr(f);
        CCSlice fam = cc__factory_name(d);
        CCSlice snake;
        if (!fam.len || cc__factory_is_extend(d)) continue;
        snake = gn_snake(L, fam);
        /* `family::[T](args)`: the family itself, not one of its members.
         * What the factory writes for that instance IS the function, so
         * the instance name is the callee — `js_module::[Counter](…)` is
         * `js_module_Counter(…)`. */
        if (slice_eq(name, snake)) {
            CcType tmp;
            CcGenericType g;
            CCSlice mangled;
            CcTypeInfo* info;
            CcCall call;
            memset(&tmp, 0, sizeof(tmp));
            tmp.span = e->span;
            g.family = fam;
            g.args = gf.targs;
            tmp.k = { .generic = g };
            mangled = ix->canon(&tmp);
            info = ix->type_get(mangled);
            gn_note(st, info, 0);
            call.callee = lw_ident(L, mangled, e->span);
            call.args = gf.args;
            e->k = { .call = call };
            return true;
        }
        if (name.len > snake.len + 1 && memcmp(name.ptr, snake.ptr, snake.len) == 0 && name.ptr[snake.len] == '_') {
            CCSlice member = cc_slice_from_buffer((char*)name.ptr + snake.len + 1, name.len - snake.len - 1);
            CcType tmp;
            CcGenericType g;
            CCSlice mangled;
            CcTypeInfo* info;
            CCString callee;
            CcCall call;
            memset(&tmp, 0, sizeof(tmp));
            tmp.span = e->span;
            g.family = fam;
            g.args = gf.targs;
            tmp.k = { .generic = g };
            mangled = ix->canon(&tmp);
            info = ix->type_get(mangled);
            gn_note(st, info, 0);
            callee = @string(`${mangled}_${member}`, L->arena);
            call.callee = lw_ident(L, lw_keep(L, &callee), e->span);
            call.args = gf.args;
            e->k = { .call = call };
            return true;
        }
    }
    {
        CCString fams = cc_string_new();
        for (f = 0; f < nf; f++) {
            CcDecl* d = *factv->get_ptr(f);
            CCSlice fam = cc__factory_name(d);
            if (!fam.len || cc__factory_is_extend(d)) continue;
            if (cc_string_len(&fams)) cc_string_push_cstr(&fams, ", ", L->arena);
            cc_string_push_slice(&fams, fam, L->arena);
        }
        {
            CCString m = @string(`'${gf.name}::[...]' matches no registered generic family (registered: ${fams})`, L->arena);
            lw_error(L, e->span, m);
        }
    }
    return true;
}

/* Is the instance declared by hand (a header's declaration macro), not by
 * the factory expansion? */
static bool gn_hand_declared(CcLowerer* L, CCSlice name) {
    CcIndex* ix = L->ix;
    CcSym* s = ix->sym(name) ?> NULL;
    while (s && s->kind != CC_SYM_TYPE) s = s->same_name;
    if (!s || !s->unit) return false;
    {
        CCSlice p = s->unit->tape.path;
        return !(p.len > 20 && memcmp(p.ptr, "<CC_GENERIC_FACTORY", 19) == 0);
    }
}

static CCString gn_upper(CcLowerer* L, CCSlice s) {
    CCString sb = cc_string_new();
    size_t i;
    for (i = 0; i < s.len; i++) {
        char c = s.ptr[i];
        cc_string_push_char(&sb, (c >= 'a' && c <= 'z') ? (char)(c - 'a' + 'A') : c, L->arena);
    }
    return sb;
}

/* The `@emit` template of a factory declaration: the template token that
 * follows `@emit (`. NULL when the factory has none. */
static const CcToken* gn_emit_template(CcUnit* fu, CcDecl* d) {
    uint32_t i;
    for (i = d->span.first; i <= d->span.last; i++) {
        const CcToken* t = cc__tok(fu, i);
        const CcToken* p1;
        const CcToken* p2;
        if (!t || t->kind != CC_TK_TEMPLATE || i < 2) continue;
        p1 = cc__tok(fu, i - 1);
        p2 = cc__tok(fu, i - 2);
        if (p1 && p2 && p1->kind == CC_TK_PUNCT && p1->punct == CC_P_LPAREN && p2->kind == CC_TK_AT_WORD &&
            p2->text.len == 5 && memcmp(p2->text.ptr, "@emit", 5) == 0)
            return t;
    }
    return NULL;
}

/* A slot the index cannot fill: not `${mangled}`, `${arg(i)}`, a type
 * argument or a factory local bound to one. Returns its spelling, empty
 * when every slot is fillable. */
static CCSlice gn_computed_slot(CcLowerer* L, const CcToken* t, CcSlotBindList* binds, CcNameList* args) {
    const char* text = t->text.ptr + 1;
    size_t len = t->text.len - 2;
    size_t i = 0;
    while (i < len) {
        if (text[i] == '$' && i + 1 < len && text[i + 1] == '{') {
            size_t j = i + 2;
            size_t depth = 1;
            const char* inner;
            size_t inner_len;
            bool found = false;
            while (j < len && depth) {
                if (text[j] == '{') depth++;
                else if (text[j] == '}') depth--;
                if (depth) j++;
            }
            inner = text + i + 2;
            inner_len = j - (i + 2);
            while (inner_len && (inner[0] == ' ' || inner[0] == '\t')) { inner++; inner_len--; }
            while (inner_len && (inner[inner_len - 1] == ' ' || inner[inner_len - 1] == '\t')) inner_len--;
            if (!(inner_len == 7 && memcmp(inner, "mangled", 7) == 0) &&
                !(inner_len > 4 && memcmp(inner, "arg(", 4) == 0) &&
                !(inner_len > 12 && memcmp(inner, "arg_mangled(", 12) == 0) &&
                !(inner_len > 16 && memcmp(inner, "type_args.items[", 16) == 0)) {
                cc__bind_lookup(binds, inner, inner_len, args, &found);
                if (!found) return cc_slice_from_buffer((char*)inner, inner_len);
            }
            i = j + 1;
            continue;
        }
        i++;
    }
    (void)L;
    return cc_slice_empty();
}

/* ---- running a compiled factory ---------------------------------------- */

/* The file the engine reads its prelude and its diagnostics from.
 *
 * The source this lowerer was handed is a staged copy under the build
 * directory, and the engine compiles a translation unit out of the file it
 * is given — so it has to be the file the user wrote, which the staged
 * copy's `#line` names. Handing it the staged path compiles a TU whose
 * includes were already rewritten once. */
static const char* gn_unit_path(CcLowerer* L, CcSpan sp) {
    CcLoc at = L->unit->loc(sp);
    CCSlice p = at.path.len ? at.path : L->unit->tape.path;
    CCString s = @string(`${p}`, L->arena);
    return s.cstr(L->arena);
}

static const char* gn_family_cstr(CcLowerer* L, CcTypeInfo* info) {
    CCSlice f = info->family;
    CCString s = @string(`${f}`, L->arena);
    return s.cstr(L->arena);
}

/* The source text of one factory declaration, as written.
 *
 * The tokens of a span point into the unit's own source, so the first
 * token's start and the last token's end bracket the text — which is what
 * the sugar rewrite has to be handed, since it reads `CC_GENERIC_FACTORY`
 * and not an AST. */
static CCSlice gn_decl_text(CcUnit* fu, CcDecl* d) {
    const CcToken* a = cc__tok(fu, d->span.first);
    const CcToken* b = cc__tok(fu, d->span.last);
    if (!a || !b || !a->text.ptr || !b->text.ptr) return cc_slice_empty();
    if (b->text.ptr < a->text.ptr) return cc_slice_empty();
    return cc_slice_from_buffer((char*)a->text.ptr,
                                (size_t)(b->text.ptr - a->text.ptr) + b->text.len);
}

/* Bind every family that has a compiled factory to its handler, once.
 *
 * The `CC_GENERIC_FACTORY` sugar lowers to a registration block and a
 * `@comptime` function, so the three steps are: rewrite the sugar to get
 * both, scan the result so the handler's definition is in the function
 * registry, then RUN the registration blocks — which is what binds the
 * family, extensions included, whose handler symbol carries a sequence
 * number only the rewrite knows.
 *
 * The scan takes this unit's source too: it clears what was registered
 * before, and the unit's own `@comptime` functions have to survive it. */
static bool gn_factories_ready(CcLowerer* L, CcSpan sp) {
    CcIndex* ix = L->ix;
    CcDeclList* factv = &ix->factories;
    CcUnitList* funitv = &ix->factory_units;
    size_t nf = factv->len();
    size_t f;
    CCString text = cc_string_new();
    CCSlice usrc = L->unit->tape.src;
    char* expanded;
    if (L->factories_ready) return L->factories_ok;
    L->factories_ready = true;
    L->factories_ok = false;
    if (!nf) return false;
    for (f = 0; f < nf; f++) {
        CcDecl* d = *factv->get_ptr(f);
        CcUnit* fu = *funitv->get_ptr(f);
        CCSlice t = gn_decl_text(fu, d);
        if (!t.len) continue;
        cc_string_push_slice(&text, t, L->arena);
        cc_string_push_cstr(&text, "\n", L->arena);
    }
    if (!cc_string_len(&text)) return false;
    {
        CCSlice raw = text.as_slice();
        size_t elen = raw.len;
        expanded = malloc(elen + 1);
        if (!expanded) return false;
        memcpy(expanded, raw.ptr, elen);
        expanded[elen] = '\0';
        if (cc_comptime_prepare_source_ex(&expanded, &elen, gn_unit_path(L, sp), CC_FAC_PREPARE) != 0) {
            free(expanded);
            return false;
        }
    }
    {
        CCString all = cc_string_new();
        cc_string_push_slice(&all, usrc, L->arena);
        cc_string_push_cstr(&all, "\n", L->arena);
        cc_string_push_cstr(&all, expanded, L->arena);
        {
            CCSlice a = all.as_slice();
            if (cc_comptime_fn_registry_scan(a.ptr, a.len) < 0) return false;
            cc_emit_plan_clear_generic_factory_registrations();
            /* the registrations only: the unit's own `@comptime` blocks are
             * the comptime step's, and collecting their emits here would
             * queue a second copy of every fragment it already spliced */
            cc_emit_plan_collect_comptime_emits(expanded, strlen(expanded));
            cc_emit_plan_clear_comptime_fragments();
        }
    }
    free(expanded);
    L->factories_ok = true;
    return true;
}

/* One instance, written by its factory. Empty when the factory could not
 * be run or produced nothing — the caller reports at the use site. */
static CCString gn_run_factory(CcLowerer* L, CcTypeInfo* info, CcSpan sp, bool* ok) {
    CcIndex* ix = L->ix;
    CcTypeList* targv = &info->targs;
    size_t nt = targv->len();
    size_t i;
    char* args;
    char err[512];
    char* def = NULL;
    int rc;
    CCString out = cc_string_new();
    *ok = false;
    if (nt > CC_FAC_MAX_ARGS) return out;
    args = cc_arena_alloc(L->arena, CC_FAC_MAX_ARGS * CC_FAC_ARG_CAP, 1);
    memset(args, 0, CC_FAC_MAX_ARGS * CC_FAC_ARG_CAP);
    for (i = 0; i < nt; i++) {
        CcType* at = *targv->get_ptr(i);
        CCSlice asp = cc__type_arg_spelling(ix, at);
        char* row = args + i * CC_FAC_ARG_CAP;
        size_t cap = CC_FAC_ARG_CAP - 1;
        size_t n = asp.len < cap ? asp.len : cap;
        if (asp.ptr) memcpy(row, asp.ptr, n);
        row[n] = '\0';
    }
    err[0] = '\0';
    {
        CCSlice usrc = L->unit->tape.src;
        CCString mangled = @string(`${info->name}`, L->arena);
        const char* mz = mangled.cstr(L->arena);
        rc = cc_emit_plan_produce_generic_def(gn_family_cstr(L, info), mz,
                                              args, (int)nt,
                                              usrc.ptr, usrc.len, gn_unit_path(L, sp),
                                              L->arena, &def, err, sizeof(err));
    }
    if (rc != 0 || !def || !def[0]) {
        CCSlice fam = info->family;
        CCSlice nm = info->name;
        CCSlice why = err[0] ? cc_slice_from_buffer(err, strlen(err)) : cstr_slice("it produced nothing");
        CCString m = @string(`the factory of generic family '${fam}' could not write '${nm}': ${why}`, L->arena);
        lw_error(L, sp, m);
        return out;
    }
    cc_string_push_cstr(&out, def, L->arena);
    *ok = true;
    return out;
}

/* The expansion text of one instance: the family factory's `@emit`
 * template (then each extension's), filled by the index's rules. Empty,
 * after the diagnostic, when a slot needs the factory body run. */
static CCString gn_instance_text(CcLowerer* L, CcTypeInfo* info, CcSpan sp, bool* ok) {
    CcIndex* ix = L->ix;
    CcDeclList* factv = &ix->factories;
    CcUnitList* funitv = &ix->factory_units;
    size_t nf = factv->len();
    size_t f;
    CCString text = cc_string_new();
    CcNameList args = vec_new::[CCSlice](L->arena);
    CcTypeList* targv = &info->targs;
    size_t nt = targv->len();
    size_t i;
    CCString up = gn_upper(L, info->family);
    CCString guard = @string(`CC_HEADER_${up}_${info->name}`, L->arena);
    bool needs_run = false;
    CCString head = @string(`#ifndef ${guard}
#define ${guard}
`, L->arena);
    *ok = true;
    for (i = 0; i < nt; i++) { CcType* at = *targv->get_ptr(i); CCSlice asp = cc__type_arg_spelling(ix, at); args.push(asp); }
    cc_string_push_slice(&text, head.as_slice(), L->arena);
    cc_string_push_cstr(&text, "/" "* generic ", L->arena);
    cc_string_push_slice(&text, info->name, L->arena);
    cc_string_push_cstr(&text, " *" "/\n", L->arena);
    /* the base factory first, then the extensions, in declaration order */
    for (f = 0; f < 2 * nf; f++) {
        size_t fi = f < nf ? f : f - nf;
        bool want_extend = f >= nf;
        CcDecl* d = *factv->get_ptr(fi);
        CcUnit* fu = *funitv->get_ptr(fi);
        const CcToken* t;
        CcSlotBindList binds;
        CCSlice computed;
        if (!cc_slice_eq(&info->family, cc__factory_name(d))) continue;
        if (cc__factory_is_extend(d) != want_extend) continue;
        t = gn_emit_template(fu, d);
        if (!t) continue;
        binds = vec_new::[CcSlotBind](L->arena);
        cc__factory_bindings(ix, fu, cc__factory_body(d), &binds);
        computed = gn_computed_slot(L, t, &binds, &args);
        if (computed.len) needs_run = true;
        {
            CCSlice frag = cc__template_instance(ix, t->text.ptr + 1, t->text.len - 2, info, &binds, &args);
            cc_string_push_slice(&text, frag, L->arena);
            if (frag.len && frag.ptr[frag.len - 1] != '\n') cc_string_push_char(&text, '\n', L->arena);
        }
    }
    if (needs_run) {
        /* a fragment that computes is not a template this step can fill:
         * what the instance is, is whatever the factory writes. It writes
         * the base and every extension together, so the run replaces all
         * of them and none of the templated text is kept. */
        bool ran = false;
        CCString def;
        CCString whole = cc_string_new();
        cc_string_push_slice(&whole, head.as_slice(), L->arena);
        if (!gn_factories_ready(L, sp)) {
            CCSlice fam = info->family;
            CCString m = @string(`instance '${info->name}' of generic family '${fam}' needs its factory run, and the factories of this unit could not be bound to their handlers`, L->arena);
            lw_error(L, sp, m);
            *ok = false;
            return whole;
        }
        def = gn_run_factory(L, info, sp, &ran);
        if (!ran) { *ok = false; return whole; }
        cc_string_push_slice(&whole, def.as_slice(), L->arena);
        cc_string_push_cstr(&whole, "\n#endif\n", L->arena);
        return whole;
    }
    cc_string_push_cstr(&text, "#endif\n", L->arena);
    return text;
}

/* How deep an expansion may nest before the step calls it a cycle: an
 * expansion whose own text names the family that produced it would
 * otherwise expand forever. */
enum { GN_MAX_DEPTH = 8 };

/* The steps a spliced expansion goes through: the pipeline without the
 * include rewrite (an expansion records no local headers of its own) and
 * without the banner (the unit it is spliced into carries one). */
static void gn_lower_steps(CcLowerer* L) {
    CcLowerer_async(L);
    CcLowerer_parallel(L);
    CcLowerer_chan(L);
    CcLowerer_closures(L);
    CcLowerer_create(L);
    CcLowerer_forin(L);
    CcLowerer_slices(L);
    CcLowerer_generics(L);
    CcLowerer_variants(L);
    CcLowerer_ufcs(L);
    CcLowerer_slice_args(L);
    CcLowerer_strings(L);
    CcLowerer_results(L);
    CcLowerer_cleanup(L);
    lw_drop_cc_only(L);
}

/* What went wrong inside an expansion, said at the site that asked for it:
 * the expansion has no position in the file the user can open. */
static void gn_fragment_error(CcLowerer* L, CcSpan sp, CcDiags* ds, CCSlice stage) {
    Vec::[CcDiag]* items = &ds->items;
    size_t n = items->len();
    size_t i;
    CCSlice first = cc_slice_empty();
    uint32_t line = 0;
    for (i = 0; i < n; i++) {
        CcDiag* d = items->get_ptr(i);
        if (d->sev != CC_SEV_ERROR) continue;
        first = d->msg;
        line = d->at.line;
        break;
    }
    {
        CCString m = @string(`the expansion of this unit's generic instances does not ${stage}: line ${line}: ${first}`, L->arena);
        lw_error(L, sp, m);
    }
}

/* The C an expansion lowers to. The expansion is a unit in its own right:
 * parsed against the same index, put through the same steps, printed. It
 * carries the language it was written in — Result returns, methods, string
 * templates — so splicing its text unlowered would hand the host compiler
 * Concurrent-C to compile. */
static bool gn_lower_fragment(CcLowerer* L, CCString text, CcSpan sp, CCString* out) {
    CCArena a = L->arena;
    CcIndex* ix = L->ix;
    CcDiags ds = CcDiags_new(a);
    CcParseOpts opts;
    CcPrintOpts po;
    CcUnit* u;
    CcLowerer sub;
    CCSlice path = cstr_slice("<generic expansion>");
    /* the expansion is spliced into whatever the unit is, so it is read and
     * printed as source: bodies kept, no include guard of its own */
    opts.mode = CC_UNIT_SOURCE;
    opts.known_types = ix->known_types();
    u = cc_parse_unit(path, text.as_slice(), opts, &ds, a);
    if (!u || ds.has_errors()) { gn_fragment_error(L, sp, &ds, cstr_slice("parse")); return false; }
    sub = cc_lowerer_new(u, ix, L->opts, &ds);
    sub.depth = L->depth + 1;
    sub.fragment = true;
    gn_lower_steps(&sub);
    if (ds.has_errors()) { gn_fragment_error(L, sp, &ds, cstr_slice("lower")); return false; }
    /* the Results the expansion names are the unit's to declare: it is
     * spliced into the unit, and the expansion declares none itself */
    {
        Vec::[CcTypeInfoRef]* got = &sub.specs;
        Vec::[CcTypeInfoRef]* mine = &L->specs;
        size_t ng = got->len();
        size_t g;
        for (g = 0; g < ng; g++) {
            CcTypeInfo* ti = *got->get_ptr(g);
            size_t nm = mine->len();
            size_t m;
            bool listed = false;
            for (m = 0; m < nm; m++) if (*mine->get_ptr(m) == ti) listed = true;
            if (!listed) mine->push(ti);
        }
    }
    po.identity = false;
    po.line_directives = false;
    po.header_mode = false;
    po.path = path;
    CcProduct prod = cc_print_unit(u, NULL, po, &ds, a) !>(e) {
        CCSlice why = e.msg;
        CCString m = @string(`the expansion of this unit's generic instances does not print: ${why}`, L->arena);
        lw_error(L, sp, m);
        return false;
    };
    if (ds.has_errors()) { gn_fragment_error(L, sp, &ds, cstr_slice("print")); return false; }
    *out = prod.text;
    return true;
}

/* Whether a declaration is what makes `name` a type in this unit. */
static bool gn_decl_defines(CcDecl* d, CCSlice name) {
    CCSlice got = cc_slice_empty();
    if (!name.len) return false;
    @switch (d->k) {
        case .typedef_(td): got = td.name; break;
        case .tagged(tg): { if (tg.type) (void)type_named_name(tg.type, &got); break; }
        case .variant(vd): got = vd.name; break;
        default: break;
    }
    return got.len != 0 && slice_eq(got, name);
}

/* Where an expansion may land: after the leading includes, and after the
 * last declaration this unit makes of any type the expansion names. An
 * `ArrayMap::[int, Entr]` spells `Entr` in its fields, so it cannot be
 * spliced above the `typedef struct Entr` that says what one is. */
/* The name a type argument's declaration is written under: `Entry*` and
 * `const Entry *` are both declared by `Entry`. An instance mentioning a
 * pointer still cannot stand above the declaration of what it points at --
 * the macro that builds it names the pointee -- so the decoration comes off
 * before the search for the declaration that defines it. */
static CCSlice gn_undecorate(CCSlice t) {
    size_t n = t.len;
    while (n && (t.ptr[n - 1] == '*' || t.ptr[n - 1] == ' ')) n--;
    t = cc_slice_from_buffer((char*)t.ptr, n);
    if (cc__has_prefix(t, "const ")) t = cc__skip(t, 6);
    if (cc__has_prefix(t, "volatile ")) t = cc__skip(t, 9);
    return cc__strip_tag(t);
}

static size_t gn_anchor(CcLowerer* L, CCSlice name, size_t base) {
    CcIndex* ix = L->ix;
    CcDeclList* decls = &L->unit->decls;
    size_t nd = decls->len();
    size_t at = base;
    CcTypeInfo* info = ix->type_get(name);
    CcTypeList* tv;
    size_t k;
    size_t nt;
    if (!info) return at;
    tv = &info->targs;
    nt = tv->len();
    for (k = 0; k < nt; k++) {
        CcType* at_k = *tv->get_ptr(k);
        CCSlice tn = gn_undecorate(ix->canon(at_k));
        size_t j;
        for (j = 0; j < nd; j++) {
            CcDecl* d = *decls->get_ptr(j);
            if (gn_decl_defines(d, tn) && j + 1 > at) at = j + 1;
        }
    }
    return at;
}

static void CcLowerer_generics(CcLowerer* L) {
    GStep st;
    CcVisitor v;
    CcIndex* ix = L->ix;
    memset(&st, 0, sizeof(st));
    st.L = L;
    st.order = vec_new::[CCSlice](L->arena);
    memset(&v, 0, sizeof(v));
    v.type = gn_type_visit;
    v.expr = gn_expr_visit;
    v.env = &st;
    CcUnit_walk(L->unit, v);
    {
        CcNameList* o = &st.order;
        size_t n = o->len();
        size_t i;
        Vec::[CCString] texts = vec_new::[CCString](L->arena);
        CcNameList names = vec_new::[CCSlice](L->arena);
        bool any = false;
        for (i = 0; i < n; i++) {
            CCSlice name = *o->get_ptr(i);
            CcTypeInfo* info = ix->type_get(name);
            CCString one;
            bool ok;
            CcSpan sp0;
            sp0.first = 0;
            sp0.last = 0;
            if (gn_hand_declared(L, name)) continue;
            if (L->depth >= (uint32_t)GN_MAX_DEPTH) {
                int deep = GN_MAX_DEPTH;
                CCString m = @string(`generic instance '${name}' expands into itself: the expansion nests ${deep} deep and still asks for another`, L->arena);
                lw_error(L, sp0, m);
                continue;
            }
            one = gn_instance_text(L, info, sp0, &ok);
            if (!ok) continue;
            texts.push(one);
            names.push(name);
            any = true;
        }
        if (!any) return;
        /* Each expansion lands after the leading includes and after the
         * last declaration this unit makes of a type it names — its own,
         * not the latest of them all: one instance whose argument is
         * declared at the end of the file would otherwise carry every
         * other expansion down there with it, past their uses. They keep
         * their order among themselves, since an instance may name
         * another. */
        {
            CcDeclList* decls = &L->unit->decls;
            size_t nd = decls->len();
            size_t base = 0;
            size_t run;
            size_t k;
            CcNameList* nv = &names;
            size_t nt2 = nv->len();
            CcDeclList with = vec_new::[CcDeclRef](L->arena);
            Vec::[size_t] at = vec_new::[size_t](L->arena);
            for (k = 0; k < nd; k++) {
                CcDecl* dd = *decls->get_ptr(k);
                bool is_pp = false;
                @switch (dd->k) {
                    case .pp: is_pp = true; break;
                    case .empty: is_pp = true; break;
                    case .pragma_cc: is_pp = true; break;
                    case .raw: is_pp = true; break;
                    default: break;
                }
                if (!is_pp) break;
                base = k + 1;
            }
            run = base;
            for (k = 0; k < nt2; k++) {
                CCSlice nm = *nv->get_ptr(k);
                size_t a = gn_anchor(L, nm, base);
                if (a < run) a = run;
                run = a;
                at.push(a);
            }
            for (k = 0; k <= nd; k++) {
                CCString group = cc_string_new();
                bool grouped = false;
                size_t j;
                CcSpan sp;
                sp.first = 0;
                sp.last = 0;
                if (k < nd) { CcDecl* dk2 = *decls->get_ptr(k); sp = dk2->span; }
                else if (nd) { CcDecl* dl = *decls->get_ptr(nd - 1); sp = dl->span; }
                for (j = 0; j < nt2; j++) {
                    size_t aj = *at.get_ptr(j);
                    CCString tj;
                    if (aj != k) continue;
                    tj = *texts.get_ptr(j);
                    cc_string_push_slice(&group, tj.as_slice(), L->arena);
                    grouped = true;
                }
                if (grouped) {
                    CCString lowered = cc_string_new();
                    CcSpan zero;
                    zero.first = 0;
                    zero.last = 0;
                    if (!gn_lower_fragment(L, group, zero, &lowered)) return;
                    with.push(lw_raw_decl(L, lowered, sp));
                }
                if (k < nd) { CcDecl* dk3 = *decls->get_ptr(k); with.push(dk3); }
            }
            *decls = with;
        }
    }
}

#endif

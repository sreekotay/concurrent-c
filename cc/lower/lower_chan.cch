#pragma(@module) "lower"
/* Clean lowerer, step: channels. An endpoint is declared by what travels
 * through it and how much can wait: `int64_t[~4 >] tx;` is a sending end
 * of a four-deep channel of int64_t. In C it is the runtime's untyped
 * handle, and the element type, the depth and the policy travel with the
 * declaration so the pair that creates the channel and the sends that use
 * it can be built from them.
 *
 * A send carries its value through a temporary of the element type. The
 * runtime sizes the copy with `sizeof` of what it is handed, so sending
 * `7` down a channel of int64_t without that temporary would copy four
 * bytes and leave four behind — a wrong value that still compiles.
 *
 * A policy or topology this step does not know is a diagnostic naming it,
 * never a silent fall back to the blocking default: the difference
 * between blocking and dropping is the difference between a slow program
 * and one that loses messages. Lifetime: the lowerer arena. */
#ifndef CC_LOWER_CHAN_CCH
#define CC_LOWER_CHAN_CCH
#include "lower.cch"
#include "typing.cch"

typedef struct HEnd {
    CCSlice name;               /* the declared endpoint */
    CcType* elem;
    CcExpr* cap;
    CCSlice mode;               /* CC_CHAN_MODE_* */
    CCSlice topo;               /* CC_CHAN_TOPO_* */
    char dir;
    bool ordered;               /* `ordered`: the receiver sees the sends in send order */
    bool carries_task;          /* a `send_task` sends on it: what it carries is a CCTask */
} HEnd;
typedef HEnd* HEndRef;
typedef Vec::[HEndRef] HEndList;

typedef struct HStep {
    Vec::[CCSlice] task_ends;   /* endpoints a `send_task` names: what they carry is a CCTask */
    CcLowerer* L;
    Walker* w;
    HEndList ends;
    uint32_t next_id;
} HStep;

/* The endpoint a name refers to here: the most recent declaration of it.
 *
 * Endpoints are collected as the walk reaches them, so the last one
 * recorded is the one in scope at the site being lowered. Taking the first
 * would hand a later function the modifiers of an endpoint that another
 * function happened to give the same name — an `ordered` receiver reading
 * as unordered because an earlier `rx` was not. */
static HEnd* hc_find(HStep* st, CCSlice name) {
    HEndList* v = &st->ends;
    size_t n = v->len();
    size_t i;
    if (!name.len) return NULL;
    for (i = n; i > 0; i--) {
        HEnd* e = *v->get_ptr(i - 1);
        if (slice_eq(e->name, name)) return e;
    }
    return NULL;
}

/* The runtime's mode for a declared drop policy. */
static bool hc_mode_of(CcLowerer* L, CcChanType ch, CcSpan sp, CCSlice* out) {
    CCSlice p = ch.policy;
    if (!p.len) { *out = cstr_slice("CC_CHAN_MODE_BLOCK"); return true; }
    if (cc_slice_eq_cstr(&p, "Drop")) { *out = cstr_slice("CC_CHAN_MODE_DROP_NEW"); return true; }
    if (cc_slice_eq_cstr(&p, "DropOld")) { *out = cstr_slice("CC_CHAN_MODE_DROP_OLD"); return true; }
    {
        CCString m = @string(`channel policy '${p}' is not one the clean lowerer knows; it would otherwise block where you asked it to drop`, L->arena);
        lw_error(L, sp, m);
    }
    return false;
}

/* The runtime's topology for a declared one. */
static bool hc_topo_of(CcLowerer* L, CcChanType ch, CcSpan sp, CCSlice* out) {
    CCSlice t = ch.topology;
    if (!t.len) { *out = cstr_slice("CC_CHAN_TOPO_DEFAULT"); return true; }
    if (cc_slice_eq_cstr(&t, "1:1")) { *out = cstr_slice("CC_CHAN_TOPO_1_1"); return true; }
    if (cc_slice_eq_cstr(&t, "1:N")) { *out = cstr_slice("CC_CHAN_TOPO_1_N"); return true; }
    if (cc_slice_eq_cstr(&t, "N:1")) { *out = cstr_slice("CC_CHAN_TOPO_N_1"); return true; }
    if (cc_slice_eq_cstr(&t, "N:N")) { *out = cstr_slice("CC_CHAN_TOPO_N_N"); return true; }
    {
        CCString m = @string(`channel topology '${t}' is not one the clean lowerer knows`, L->arena);
        lw_error(L, sp, m);
    }
    return false;
}

static bool hc_is_chan(CcType* t, CcChanType* out) {
    if (!t) return false;
    @switch (t->k) {
        case .chan(ch): *out = ch; return true;
        default: return false;
    }
}

/* The same endpoint through the name it was given.
 *
 * `typedef int[~4 >] WorkerTx; WorkerTx tx;` declares the endpoint an
 * `int[~4 >]` declares -- the capacity, the element and the direction are
 * the typedef's, and the pair that creates the channel needs them. So a
 * named type is followed to what it aliases. The hop count is bounded
 * because a typedef chain that does not end is not this step's to diagnose. */
static bool hc_type_name(CcType* t, CCSlice* out) {
    if (!t) return false;
    @switch (t->k) {
        case .named(n): *out = n.name; return n.name.len != 0;
        default: return false;
    }
}

static bool hc_is_chan_named(CcIndex* ix, CcType* t, CcChanType* out) {
    int hops = 0;
    while (t && hops < 8) {
        CCSlice nm;
        CcSym* sym;
        if (hc_is_chan(t, out)) return true;
        if (!hc_type_name(t, &nm)) return false;
        sym = ix->sym(nm) ?> NULL;
        while (sym && sym->kind != CC_SYM_TYPE) sym = sym->same_name;
        if (!sym || !sym->type || sym->type == t) return false;
        t = sym->type;
        hops++;
    }
    return false;
}

/* A channel endpoint type anywhere but a local declaration.
 *
 * `int[~4 >]` is the same handle whether it names a local, a struct field,
 * a typedef or a parameter: the element type and the capacity belong to
 * the pair that creates it, and what the declarator holds is a `CCChanTx`
 * / `CCChanRx`. Left as written, the endpoint type reaches C, which has no
 * such declarator.
 *
 * Only the type is rewritten. None of these is a site: nothing pairs,
 * sends or receives by being declared, so there is no endpoint to record —
 * which is why this runs after the sites are read, when every endpoint the
 * step needs is already recorded against its local.
 *
 * The node is replaced in place, so every position is covered by the one
 * rule rather than by a list of the places a declarator can appear. */
static bool hc_endpoint_types(CcType* t, void* env) {
    CcLowerer* L = (CcLowerer*)env;
    CcChanType ch;
    if (!hc_is_chan(t, &ch)) return true;
    {
        CCSlice nm = ch.dir == '<' ? cstr_slice("CCChanRx") : cstr_slice("CCChanTx");
        CcNamedType nt;
        memset(&nt, 0, sizeof(nt));
        nt.name = nm;
        t->k = { .named = nt };
    }
    (void)L;
    return true;
}

/* The endpoints a `send_task` sends on.
 *
 * What such a channel carries is the task handle, whatever its element
 * type says: the receiver blocks on the handle, and the value the task
 * computed is read out of it. The uses are collected before the
 * declarations are read, because the pair call that sizes the channel is
 * built from the declaration and may come first.
 *
 * A `send_task` written as a UFCS call is still one here: this step runs
 * before UFCS. */
static bool hc_is_send_task_name(CCSlice n) {
    return cc_slice_eq_cstr(&n, "cc_channel_send_task") ||
           cc_slice_eq_cstr(&n, "cc_channel_send_task_hybrid") ||
           cc_slice_eq_cstr(&n, "cc_chan_send_task") ||
           cc_slice_eq_cstr(&n, "send_task") ||
           cc_slice_eq_cstr(&n, "send_task_hybrid");
}

static bool hc_mark_task_visit(CcExpr* e, void* env) {
    HStep* st = (HStep*)env;
    Vec::[CCSlice]* ends = &st->task_ends;
    CCSlice recv = cc_slice_empty();
    @switch (e->k) {
        case .call(cl): {
            CCSlice fn;
            CcExprList* av = &cl.args;
            if (av->len() != 2) break;
            if (!expr_ident(strip_parens_expr(cl.callee), &fn)) break;
            if (!hc_is_send_task_name(fn)) break;
            (void)expr_ident(strip_parens_expr(*av->get_ptr(0)), &recv);
            break;
        }
        case .ufcs(uf): {
            if (!hc_is_send_task_name(uf.method)) break;
            (void)expr_ident(strip_parens_expr(uf.recv), &recv);
            break;
        }
        default: break;
    }
    if (recv.len) {
        ends->push(recv);
    }
    return true;
}

static bool hc_is_task_end(HStep* st, CCSlice name) {
    Vec::[CCSlice]* ends = &st->task_ends;
    size_t n = ends->len();
    size_t i;
    for (i = 0; i < n; i++) {
        CCSlice s = *ends->get_ptr(i);
        if (slice_eq(s, name)) return true;
    }
    return false;
}

/* The endpoint a type is, by any route the unit can read it: written out,
 * behind a typedef the index carries, or behind one this function opened.
 * A typedef declared inside a body is in the walker's scope and nowhere
 * else, and an endpoint declared through one is still an endpoint. */
static bool hc_chan_of(HStep* st, CcType* t, CcChanType* out) {
    if (hc_is_chan_named(st->L->ix, t, out)) return true;
    return hc_is_chan(unalias_local(st->w, t), out);
}

/* A payload handed over rather than copied: a pointer, or a slice header. */
static bool hc_elem_takes(CcLowerer* L, CcType* elem) {
    CCSlice canon;
    if (!elem) return false;
    if (elem->k.kind == CcTypeK_pointer) return true;
    if (elem->k.kind == CcTypeK_slice) return true;
    canon = L->ix->canon(elem);
    return canon.len >= 7 && memcmp(canon.ptr, "CCSlice", 7) == 0;
}

/* The width the channel carries: a taken payload travels as its handle. */
static CCString hc_elem_size(CcLowerer* L, CcType* elem, CCSlice canon) {
    if (elem && elem->k.kind == CcTypeK_pointer) return @string(`sizeof(void*)`, L->arena);
    if (hc_elem_takes(L, elem)) return @string(`sizeof(CCSlice)`, L->arena);
    return @string(`sizeof(${canon})`, L->arena);
}

/* ---- `T[~N owned { .create, .destroy, .reset }]`: the pool ------------- */

/* An owned channel is a pool. What travels through it is lent and given
 * back rather than handed over, and the lifecycle block says how an item
 * is made, unmade, and made fit to lend again.
 *
 * The runtime holds the three as closure handles -- `cc_chan_create_owned`
 * takes a `CCClosure0` and two `CCClosure1` -- so the hook expressions are
 * moved into the create call as written and the closures step lowers each
 * one where it now sits. That is why a hook that reads an outer local
 * needs nothing special here: a capture is what the closure environment is
 * for, and the environment is built by the step that owns closures.
 *
 * The declaration becomes the handle the runtime answers with:
 * `CCChan* pool = cc_chan_create_owned(cap, sizeof(elem), ...)`. A pool is
 * not an endpoint -- it has no send end and no receive end, and nothing
 * pairs with it -- so no `HEnd` is recorded against the name and the
 * operations on it are the runtime calls the author writes. */

/* The expression a lifecycle field was given, or NULL when the block does
 * not name that field. */
static CcExpr* hc_hook(CcInit* hooks, CCSlice want) {
    CcInitList* items;
    size_t n;
    size_t i;
    if (!hooks) return NULL;
    items = &hooks->items;
    n = items->len();
    for (i = 0; i < n; i++) {
        CcInit* it = *items->get_ptr(i);
        Vec::[CcDesignator]* ds;
        CcDesignator* d0;
        if (!it) continue;
        ds = &it->designators;
        if (ds->len() != 1) continue;
        d0 = ds->get_ptr(0);
        if (slice_eq(d0->field, want)) return it->expr;
    }
    return NULL;
}

/* Every entry in the lifecycle block names one of the three hooks.
 *
 * An entry this step does not know would be read by nobody: the pool would
 * be built without it and the program would run as though the line had not
 * been written, which is a lifecycle silently missing a half. */
static bool hc_hooks_named(CcLowerer* L, CcInit* hooks) {
    CcInitList* items = &hooks->items;
    size_t n = items->len();
    size_t i;
    for (i = 0; i < n; i++) {
        CcInit* it = *items->get_ptr(i);
        Vec::[CcDesignator]* ds;
        CcDesignator* d0;
        CCSlice f;
        if (!it) continue;
        ds = &it->designators;
        if (ds->len() != 1) {
            CCString m = @string(`owned channel: a lifecycle entry is written '.create = ...', '.destroy = ...' or '.reset = ...'`, L->arena);
            lw_error(L, it->span, m);
            return false;
        }
        d0 = ds->get_ptr(0);
        f = d0->field;
        if (cc_slice_eq_cstr(&f, "create")) continue;
        if (cc_slice_eq_cstr(&f, "destroy")) continue;
        if (cc_slice_eq_cstr(&f, "reset")) continue;
        {
            CCString m = @string(`owned channel: '.${f}' is not a lifecycle hook; a pool states '.create', '.destroy' and '.reset'`, L->arena);
            lw_error(L, it->span, m);
        }
        return false;
    }
    return true;
}

/* A pool takes none of the modifiers a transferring channel does: it is
 * bidirectional and it blocks until an item comes back, and
 * `cc_chan_create_owned` has no argument to carry a direction, a drop
 * policy, a topology or an order through. Each would be dropped on the
 * floor, so each is named at the declaration that wrote it. */
static bool hc_owned_bare(CcLowerer* L, CcChanType ch, CcSpan sp) {
    if (ch.dir) {
        CCString m = @string(`owned channel: a pool lends and takes back on the same handle, so it states no direction; drop the '<' or '>'`, L->arena);
        lw_error(L, sp, m);
        return false;
    }
    if (ch.ordered) {
        CCString m = @string(`owned channel: 'ordered' names the order a receiver observes; a pool hands back whichever item is free`, L->arena);
        lw_error(L, sp, m);
        return false;
    }
    if (ch.topology.len) {
        CCSlice t = ch.topology;
        CCString m = @string(`owned channel: a pool has no topology to state; '${t}' would be read by nobody`, L->arena);
        lw_error(L, sp, m);
        return false;
    }
    if (ch.policy.len) {
        CCSlice p = ch.policy;
        CCString m = @string(`owned channel: a pool blocks until an item is returned; the drop policy '${p}' would be read by nobody`, L->arena);
        lw_error(L, sp, m);
        return false;
    }
    return true;
}

/* `= e` as the initializer of a declaration. */
static CcInit* hc_init_expr(CcLowerer* L, CcExpr* e, CcSpan sp) {
    CcInit* in = cc_arena_alloc(L->arena, sizeof(CcInit), _Alignof(CcInit));
    memset(in, 0, sizeof(*in));
    in->span = sp;
    in->designators = vec_new::[CcDesignator](L->arena);
    in->items = vec_new::[CcInitRef](L->arena);
    in->expr = e;
    return in;
}

/* `T[~N owned { ... }] pool;` becomes the pool the runtime creates. */
static void hc_owned(HStep* st, CcDecl* d, CcVarDecl v, CcChanType ch) {
    CcLowerer* L = st->L;
    CcSpan sp = d->span;
    CCSlice nm = v.name;
    CcExpr* create;
    CcExpr* destroy;
    CcExpr* reset;
    if (!hc_owned_bare(L, ch, sp)) return;
    if (v.init) {
        CCString m = @string(`owned channel '${nm}': the pool is what the lifecycle block builds, so the declaration takes no initializer`, L->arena);
        lw_error(L, sp, m);
        return;
    }
    if (!ch.hooks) {
        CCString m = @string(`owned channel '${nm}': a pool states its lifecycle, '{ .create = ..., .destroy = ... }'; with none, nothing makes or unmakes what it lends`, L->arena);
        lw_error(L, sp, m);
        return;
    }
    if (!hc_hooks_named(L, ch.hooks)) return;
    if (!ch.cap) {
        CCString m = @string(`owned channel '${nm}': a pool needs a capacity, and the runtime creates no pool at 0`, L->arena);
        lw_error(L, sp, m);
        return;
    }
    create = hc_hook(ch.hooks, cstr_slice("create"));
    destroy = hc_hook(ch.hooks, cstr_slice("destroy"));
    reset = hc_hook(ch.hooks, cstr_slice("reset"));
    if (!create) {
        CCString m = @string(`owned channel '${nm}': no '.create', so a receive on the empty pool has nothing to hand back and waits forever`, L->arena);
        lw_error(L, sp, m);
        return;
    }
    if (!destroy) {
        CCString m = @string(`owned channel '${nm}': no '.destroy', so what the pool made is never unmade; write '.destroy = (T item) => { ... }'`, L->arena);
        lw_error(L, sp, m);
        return;
    }
    {
        CCSlice canon = L->ix->canon(ch.elem);
        CCString capt = lw_spell_expr(L, ch.cap);
        CCString szt = hc_elem_size(L, ch.elem, canon);
        CCString nulls = @string(`cc_closure1_make(NULL, NULL, NULL)`, L->arena);
        CcExpr* none = lw_text(L, nulls, sp);
        CcExpr* on_reset = reset ? reset : none;
        CcExpr* call = cc__expr_blank(sp, L->arena);
        CcType* handle = cc_type_pointer(cc_type_named(cstr_slice("CCChan"), sp, L->arena), sp, L->arena);
        CcCall out;
        out.callee = lw_ident(L, cstr_slice("cc_chan_create_owned"), sp);
        out.args = vec_new::[CcExprRef](L->arena);
        out.args.push(lw_text(L, capt, sp));
        out.args.push(lw_text(L, szt, sp));
        out.args.push(create);
        out.args.push(destroy);
        out.args.push(on_reset);
        call->k = { .call = out };
        v.type = handle;
        v.init = hc_init_expr(L, call, sp);
        d->k = { .var = v };
    }
}

/* `int64_t[~4 >] tx;` keeps what it carries, and becomes the handle. */
static void hc_decl(HStep* st, CcDecl* d, CcVarDecl v) {
    CcLowerer* L = st->L;
    CcChanType ch;
    HEnd* e;
    CCSlice mode;
    CCSlice topo;
    if (!hc_chan_of(st, v.type, &ch)) return;
    if (ch.owned) { hc_owned(st, d, v, ch); return; }
    if (!hc_mode_of(L, ch, d->span, &mode)) return;
    if (!hc_topo_of(L, ch, d->span, &topo)) return;
    e = cc_arena_alloc(L->arena, sizeof(HEnd), _Alignof(HEnd));
    memset(e, 0, sizeof(*e));
    e->name = v.name;
    e->elem = ch.elem;
    e->cap = ch.cap;
    e->mode = mode;
    e->topo = topo;
    e->dir = ch.dir;
    e->ordered = ch.ordered;
    e->carries_task = hc_is_task_end(st, v.name);
    st->ends.push(e);
    v.type = cc_type_named(ch.dir == '<' ? cstr_slice("CCChanRx") : cstr_slice("CCChanTx"),
                           d->span, L->arena);
    d->k = { .var = v };
}

/* The name an `&x` argument names. */
static CCSlice hc_addr_name(CcExpr* e) {
    CcExpr* s = strip_parens_expr(e);
    CCSlice nm;
    if (!s) return cc_slice_empty();
    @switch (s->k) {
        case .unary(un): {
            if (un.op != CC_OP_ADDR) return cc_slice_empty();
            if (!expr_ident(strip_parens_expr(un.a), &nm)) return cc_slice_empty();
            return nm;
        }
        default: return cc_slice_empty();
    }
}

/* `cc_channel_pair(&tx, &rx)` is built from what the two ends declared. */
static void hc_pair(HStep* st, CcExpr* e, CcCall cl) {
    CcLowerer* L = st->L;
    CcExprList* av = &cl.args;
    CCSlice n1;
    CCSlice n2;
    HEnd* a;
    HEnd* b;
    CcSpan sp = e->span;
    if (av->len() != 2) return;
    n1 = hc_addr_name(*av->get_ptr(0));
    n2 = hc_addr_name(*av->get_ptr(1));
    a = hc_find(st, n1);
    b = hc_find(st, n2);
    if (!a || !b) {
        /* The pair is built from what the two ends declared: the capacity,
         * the element width, the mode and the topology all come off the
         * declarators. A name that is not an endpoint declares none of
         * them, and left alone the call reaches C as a two-argument
         * function nobody declares -- so the operand that broke it is
         * named at the position of the call. A receiver written as
         * anything but `&name` is a shape this step does not read, and is
         * left to the steps that do. */
        if (n1.len && n2.len) {
            CCSlice bad = a ? n2 : n1;
            CCString m = @string(`channel: cc_channel_pair needs a send endpoint and a receive endpoint; '${bad}' is not declared as one`, L->arena);
            lw_error(L, sp, m);
        }
        return;
    }
    {
        /* a real call, so the unwrap that follows can see the Result the
         * runtime declares it returns */
        /* a channel a `send_task` sends on carries the task handle, not
         * what the task computes: the receiver blocks on the handle and
         * the value it yields is read out of the task */
        bool task = a->carries_task || b->carries_task;
        CCSlice elem = task ? cstr_slice("CCTask") : L->ix->canon(a->elem);
        /* `ordered` is one property read against the channel's payload kind.
         * On a channel of task handles it is the runtime's to enforce: the
         * receiver awaits each handle, so the flag goes in. On a channel of
         * data it is a contract the buffered backend already keeps -- items
         * from one sender arrive in that sender's order -- and passing the
         * runtime flag would break the channel rather than tighten it, because
         * the runtime reads an ordered payload as a `CCTask` and a plain typed
         * send no longer matches the element width. */
        bool ordered = (a->ordered || b->ordered) && task;
        /* A payload that is a pointer or a slice can be handed over rather
         * than copied: the send-take path carries the address and the receiver
         * takes ownership of what it points at. */
        bool take = !task && hc_elem_takes(L, a->elem);
        CCString capt = a->cap ? lw_spell_expr(L, a->cap) : @string(`0`, L->arena);
        CCString szt = task ? @string(`sizeof(CCTask)`, L->arena) : hc_elem_size(L, a->elem, elem);
        CCString ord = ordered ? @string(`1`, L->arena) : @string(`0`, L->arena);
        CCString tk = take ? @string(`1`, L->arena) : @string(`0`, L->arena);
        CCString names = @string(`"${n1},${n2}"`, L->arena);
        CcCall out;
        out.callee = lw_ident(L, cstr_slice("cc_channel_pair_create_named"), sp);
        out.args = vec_new::[CcExprRef](L->arena);
        out.args.push(lw_text(L, capt, sp));
        out.args.push(lw_ident(L, a->mode, sp));
        out.args.push(lw_text(L, tk, sp));
        out.args.push(lw_text(L, szt, sp));
        out.args.push(lw_text(L, @string(`0`, L->arena), sp));
        out.args.push(lw_ident(L, a->topo, sp));
        out.args.push(lw_text(L, ord, sp));
        out.args.push(cc_expr_unary(CC_OP_ADDR, lw_ident(L, n1, sp), sp, L->arena));
        out.args.push(cc_expr_unary(CC_OP_ADDR, lw_ident(L, n2, sp), sp, L->arena));
        out.args.push(lw_text(L, names, sp));
        out.args.push(lw_text(L, @string(`__FILE__`, L->arena), sp));
        out.args.push(lw_text(L, @string(`__LINE__`, L->arena), sp));
        e->k = { .call = out };
    }
}

/* A send hands the runtime a value it sizes with `sizeof`: the value
 * travels through a temporary of the element type so the copy is the
 * width the channel carries. */
static bool hc_is_value_send(CCSlice m) {
    return cc_slice_eq_cstr(&m, "send") || cc_slice_eq_cstr(&m, "try_send") ||
           cc_slice_eq_cstr(&m, "send_task") || cc_slice_eq_cstr(&m, "send_task_hybrid");
}

static void hc_send(HStep* st, CcExpr* e, CcUfcs uf) {
    CcLowerer* L = st->L;
    CCSlice recv;
    HEnd* end;
    CcExprList* av = &uf.args;
    if (!hc_is_value_send(uf.method)) return;
    if (av->len() != 1) return;
    {
        /* `send_task(() => …)` sends a task spawned from the closure, not
         * the closure as a value: the closures step owns that shape. */
        CcExpr* a0 = strip_parens_expr(*av->get_ptr(0));
        if (a0 && a0->k.kind == CcExprK_closure) return;
    }
    if (!expr_ident(strip_parens_expr(uf.recv), &recv)) return;
    end = hc_find(st, recv);
    if (!end || end->dir == '<') return;
    {
        CcSpan sp = e->span;
        uint32_t id = st->next_id++;
        CCSlice elem = L->ix->canon(end->elem);
        CCString nm = @string(`__cc_snd${id}`, L->arena);
        CCSlice tmp = lw_keep(L, &nm);
        CcExpr* val = *av->get_ptr(0);
        CcStmt* blk = lw_block(L, sp);
        CcExpr* wrapped = cc__expr_blank(sp, L->arena);
        CcStmtExpr se;
        lw_push(blk, lw_decl_stmt(L, cc_type_named(elem, sp, L->arena), tmp, lw_paren(L, val, sp), sp));
        lw_push(blk, lw_expr_stmt(L, lw_ident(L, tmp, sp), sp));
        se.block = blk;
        wrapped->k = { .stmt_expr = se };
        *av->get_ptr(0) = wrapped;
    }
}

/* `ch.recv(&v)` where `ch` is the runtime's own `CCChan*`.
 *
 * A raw channel is not an endpoint: it carries no element type, so the
 * width comes off what the caller hands the receiver, and the direction
 * comes off the method. The generic UFCS resolution would land on
 * `cc_chan_recv`, which takes that width as a third argument and answers
 * with an errno -- neither of which is what the call site reads. The
 * surface here is the one every other channel operation answers with:
 * `bool !>(CCIoError)`, built from the errno the raw receive returns.
 *
 * The receiver is spelled twice, so it has to be a name: any other shape
 * would be evaluated twice, and this step does not read it. */
static bool hc_raw_recv(HStep* st, CcExpr* e, CcUfcs uf, CcType* rt) {
    CcLowerer* L = st->L;
    CcExprList* av = &uf.args;
    CCSlice recv;
    CCSlice tn;
    CcType* pointee = NULL;
    CcSpan sp = e->span;
    if (!cc_slice_eq_cstr(&uf.method, "recv")) return false;
    if (av->len() != 1) return false;
    if (!rt) return false;
    @switch (rt->k) {
        case .pointer(pt): pointee = pt.pointee; break;
        default: return false;
    }
    if (!pointee || !type_named_name(pointee, &tn)) return false;
    if (!cc_slice_eq_cstr(&tn, "CCChan")) return false;
    if (!expr_ident(strip_parens_expr(uf.recv), &recv)) return false;
    {
        CCString spelled = lw_spell_expr(L, *av->get_ptr(0));
        CCSlice into = cc_string_as_slice(&spelled);
        CCString t = @string(`cc_chan_result_with((${recv}), cc_channel_raw_recv((${recv}), (void*)(${into}), sizeof(*(${into}))), 1)`, L->arena);
        CcExpr* out = lw_text(L, t, sp);
        *e = *out;
    }
    return true;
}

/* The closure a call hands over, or false for anything else. */
static bool hc_closure_of(CcExpr* e, CcClosure* out) {
    if (!e) return false;
    @switch (e->k) {
        case .closure(c): *out = c; return true;
        default: return false;
    }
}

/* The same closure's body, written through. */
static void hc_closure_set_body(CcExpr* e, CcStmt* b) {
    @switch (e->k) {
        case .closure: e->k.closure.body = b; break;
        default: break;
    }
}

static bool hc_is_send_into(CCSlice m) {
    return cc_slice_eq_cstr(&m, "send_into") || cc_slice_eq_cstr(&m, "try_send_into");
}

/* `ep.send_into((slot, arena) => { ... }, a)` and `try_send_into`.
 *
 * The builder writes into the slot the channel admitted, so what it takes
 * is the channel's element by address and the arena the caller named.
 * Written bare, those parameters carry no type at all, and an untyped
 * closure parameter is given the `intptr_t` the runtime carries it in --
 * which is the width, not the meaning: the body then dereferences a
 * `long`. The element type is the endpoint's, so it is filled in here,
 * where the endpoint is known.
 *
 * The arena does not fit in an `intptr_t`, and the runtime hands over its
 * address (`cc_closure2_call(b, (intptr_t)slot, (intptr_t)&arena)`), so
 * the parameter that arrives is the pointer and the name the body reads is
 * a local the block opens with.
 *
 * A parameter the author typed is left as written: this fills in what was
 * not said, it does not overrule what was. */
static void hc_send_into(HStep* st, CcUfcs uf, CcType* rt) {
    CcLowerer* L = st->L;
    CcExprList* av = &uf.args;
    CcChanType ch;
    CcType* elem = NULL;
    CcExpr* a0;
    CcClosure cl;
    CcParam* p0;
    CcParam* p1;
    if (!hc_is_send_into(uf.method)) return;
    if (av->len() != 2) return;
    a0 = strip_parens_expr(*av->get_ptr(0));
    if (!hc_closure_of(a0, &cl)) return;
    if (cl.params.len() != 2) return;
    p0 = cl.params.get_ptr(0);
    p1 = cl.params.get_ptr(1);
    if (p0->type || p1->type) return;
    if (!p0->name.len || !p1->name.len) return;
    {
        CCSlice recv = cc_slice_empty();
        HEnd* end = NULL;
        if (expr_ident(strip_parens_expr(uf.recv), &recv)) end = hc_find(st, recv);
        if (end) elem = end->elem;
        else if (hc_chan_of(st, rt, &ch)) elem = ch.elem;
    }
    if (!elem) return;
    {
        CcSpan sp = a0->span;
        uint32_t id = st->next_id++;
        CCString hn = @string(`__cc_si_a${id}`, L->arena);
        CCSlice hid = lw_keep(L, &hn);
        CcType* at = cc_type_named(cstr_slice("CCArena"), sp, L->arena);
        CCSlice given = p1->name;
        CcStmt* nb = lw_block(L, sp);
        CcStmtList* into = lw_block_stmts(nb);
        CcExpr* val = cc_expr_unary(CC_OP_DEREF, lw_ident(L, hid, sp), sp, L->arena);
        p0->type = cc_type_pointer(elem, sp, L->arena);
        p1->type = cc_type_pointer(at, sp, L->arena);
        p1->name = hid;
        into->push(lw_decl_stmt(L, at, given, val, sp));
        if (cl.body) {
            CcStmtList* old = lw_block_stmts(cl.body);
            if (old) {
                size_t n = old->len();
                size_t i;
                for (i = 0; i < n; i++) {
                    CcStmt* q = *old->get_ptr(i);
                    into->push(q);
                }
            } else {
                into->push(cl.body);
            }
        }
        hc_closure_set_body(a0, nb);
    }
}

/* ---- `@await ep.send(v)` / `@await ep.recv(&v)` -------------------------- */

/* An awaited endpoint call is the endpoint's synchronous surface.
 *
 * What the runtime's send and recv tasks carry is an errno, and a task
 * carries one `intptr_t`: there is no callee return type for the wait to
 * read the value at. So the await is not lowered as a wait on a named
 * `@async` function. It is the wait plus that errno read back as the
 * `bool !>(CCIoError)` every other channel operation answers with -- the
 * surface the `!>` on the line unwraps.
 *
 * That is channel knowledge, so it is spent here rather than in the async
 * step, and before the endpoints are read so the argument reaches the
 * runtime task as written: the temporary `hc_send` puts a plain send
 * through is the copy `sizeof` sizes, and the task takes the value
 * directly. */

static CcExpr* hc_cast(CcLowerer* L, CCSlice ty, CcExpr* a, CcSpan sp) {
    CcExpr* e = cc__expr_blank(sp, L->arena);
    CcCast ca;
    ca.type = lw_named_type(L, ty, sp);
    ca.a = a;
    { CcExprK ek = { .cast = ca }; e->k = ek; }
    return e;
}

/* `cc_chan_result_from_errno((int)cc_block_on(intptr_t, cc_channel_X_task(ep, args)))` */
static CcExpr* hc_await_surface(CcLowerer* L, CcUfcs uf, CcSpan sp) {
    CCSlice fn;
    CcExpr* task;
    CcExprList* ta;
    CcExprList* av = &uf.args;
    size_t n = av->len();
    size_t i;
    CcExpr* wait;
    CcExpr* width;
    if (cc_slice_eq_cstr(&uf.method, "send")) fn = cstr_slice("cc_channel_send_task");
    else fn = cstr_slice("cc_channel_recv_task");
    task = lw_call1(L, fn, uf.recv, sp);
    ta = lw_call_args(task);
    for (i = 0; i < n; i++) {
        CcExpr* a = *av->get_ptr(i);
        ta->push(a);
    }
    width = lw_text(L, @string(`intptr_t`, L->arena), sp);
    wait = lw_call2(L, cstr_slice("cc_block_on"), width, task, sp);
    return lw_call1(L, cstr_slice("cc_chan_result_from_errno"),
                    hc_cast(L, cstr_slice("int"), wait, sp), sp);
}

/* What an `@await` waits on, or NULL for any other expression. */
static CcExpr* hc_await_child(CcExpr* e) {
    @switch (e->k) {
        case .await_(w): return w.a;
        default: return NULL;
    }
}

/* What one tail the grammar binds under an await stands on:
 * `@await ep.send(v) !>` parses as `@await ((ep.send(v)) !>)`. */
static CcExpr* hc_tail_child(CcExpr* e) {
    @switch (e->k) {
        case .paren(p): return p.a;
        case .unwrap(u): return u.a;
        case .unwrap_body(ub): return ub.a;
        case .unwrap_or(uo): return uo.a;
        case .unwrap_destroy(ud): return ud.a;
        default: return NULL;
    }
}

/* The same tails, written through. */
static void hc_tail_set(CcExpr* e, CcExpr* v) {
    @switch (e->k) {
        case .paren: e->k.paren.a = v; break;
        case .unwrap: e->k.unwrap.a = v; break;
        case .unwrap_body: e->k.unwrap_body.a = v; break;
        case .unwrap_or: e->k.unwrap_or.a = v; break;
        case .unwrap_destroy: e->k.unwrap_destroy.a = v; break;
        default: break;
    }
}

/* A `send` / `recv` on an endpoint. The method name is what says so, as it
 * is in the reference: inside `@async` a channel operation is the only
 * thing an await may be written on, and a receiver that is not an endpoint
 * hands `cc_channel_send_task` a first argument the host compiler rejects
 * by name. */
static bool hc_await_op(CcExpr* e, CcUfcs* out) {
    @switch (e->k) {
        case .ufcs(u): {
            if (!cc_slice_eq_cstr(&u.method, "send") &&
                !cc_slice_eq_cstr(&u.method, "recv")) return false;
            *out = u;
            return true;
        }
        default: return false;
    }
}

static bool hc_await_visit(CcExpr* e, void* env) {
    HStep* st = (HStep*)env;
    CcLowerer* L = st->L;
    CcExpr* top = hc_await_child(e);
    CcExpr* above = NULL;       /* the tail the endpoint call stands under */
    CcExpr* cur = top;
    CcUfcs uf;
    int hops = 0;
    if (!top) return true;
    /* the hop count is bounded because a tail chain that does not end is
     * not this step's to diagnose */
    while (cur && hops < 8) {
        CcExpr* next = hc_tail_child(cur);
        if (!next) break;
        above = cur;
        cur = next;
        hops++;
    }
    if (!cur || !hc_await_op(cur, &uf)) return true;
    {
        CcExpr* surface = hc_await_surface(L, uf, e->span);
        /* the surface carries the wait, so the await has nothing left to
         * do: what stands in its place is the tail it was written around */
        if (!above) { e->k = surface->k; return true; }
        hc_tail_set(above, surface);
        e->k = top->k;
    }
    return true;
}

static CcStmt* hc_fn_body(CcDecl* d) {
    @switch (d->k) {
        case .func(fd): return fd.body;
        default: return NULL;
    }
}

/* Every function body: an `@await` on an endpoint is the endpoint's own
 * synchronous surface, whatever the function around it does with the tail. */
static void hc_awaits(HStep* st) {
    CcDeclList* ds = &st->L->unit->decls;
    size_t n = ds->len();
    size_t i;
    for (i = 0; i < n; i++) {
        CcDecl* d = *ds->get_ptr(i);
        CcStmt* body = hc_fn_body(d);
        CcVisitor av;
        if (!body) continue;
        memset(&av, 0, sizeof(av));
        av.expr = hc_await_visit;
        av.env = st;
        CcStmt_walk(body, av);
    }
}

/* The message, assembled rather than templated: a backtick would close an
 * `@string` template, and an `@word` inside a literal reads as a sigil. */
static CCString hc_closing_retired(CcLowerer* L) {
    CCString m = cc_string_new();
    cc_string_push_cstr(&m, "async: ", L->arena);
    cc_string_push_char(&m, '`', L->arena);
    cc_string_push_cstr(&m, "@", L->arena);
    cc_string_push_cstr(&m, "closing(...)", L->arena);
    cc_string_push_char(&m, '`', L->arena);
    cc_string_push_cstr(&m, " is retired; use explicit ownership with ", L->arena);
    cc_string_push_char(&m, '`', L->arena);
    cc_string_push_cstr(&m, "T name", L->arena);
    cc_string_push_cstr(&m, "@", L->arena);
    cc_string_push_cstr(&m, "(args) ", L->arena);
    cc_string_push_cstr(&m, "@", L->arena);
    cc_string_push_cstr(&m, "destroy { chan.close(); }", L->arena);
    cc_string_push_char(&m, '`', L->arena);
    return m;
}

/* `@closing(tx) { }` is retired: what closes a channel is the owner that
 * declared it, so the close is written where the ownership is. No step
 * consumes the node, so left alone the form reaches C as written -- which
 * is not a diagnosis of anything. Kept out of `hc_on_stmt` because that one
 * already switches on `CcDeclK`, and two switches on different variant
 * types in one function do not lower. */
static void hc_closing(HStep* st, CcStmt* s) {
    CcLowerer* L = st->L;
    bool hit = false;
    @switch (s->k) {
        case .closing: hit = true; break;
        default: break;
    }
    if (!hit) return;
    {
        CCString m = hc_closing_retired(L);
        lw_error(L, s->span, m);
    }
}

static void hc_on_stmt(Walker* w, CcStmt* s, bool enter) {
    HStep* st = (HStep*)w->env;
    CcDecl* d = NULL;
    if (!enter) return;
    hc_closing(st, s);
    if (!stmt_is_decl(s, &d) || !d) return;
    @switch (d->k) {
        case .var(v): hc_decl(st, d, v); break;
        default: break;
    }
}

static void hc_on_decl(Walker* w, CcDecl* d) {
    HStep* st = (HStep*)w->env;
    @switch (d->k) {
        case .var(v): hc_decl(st, d, v); break;
        default: break;
    }
}

static void hc_on_call(Walker* w, CcExpr* e, CcCall cl) {
    HStep* st = (HStep*)w->env;
    CCSlice nm;
    if (!expr_ident(strip_parens_expr(cl.callee), &nm)) return;
    if (!cc_slice_eq_cstr(&nm, "cc_channel_pair")) return;
    hc_pair(st, e, cl);
}

static void hc_on_ufcs(Walker* w, CcExpr* e, CcUfcs uf, CcType* rt, CcMethod* m, CCSlice tn, CCSlice reason) {
    HStep* st = (HStep*)w->env;
    (void)m; (void)tn; (void)reason;
    if (hc_raw_recv(st, e, uf, rt)) return;
    hc_send_into(st, uf, rt);
    hc_send(st, e, uf);
}

void CcLowerer_chan(CcLowerer* L) {
    Walker w;
    HStep st;
    memset(&st, 0, sizeof(st));
    st.L = L;
    st.w = &w;
    st.ends = vec_new::[HEndRef](L->arena);
    st.task_ends = vec_new::[CCSlice](L->arena);
    memset(&w, 0, sizeof(w));
    w.arena = L->arena;
    w.ix = L->ix;
    w.unit = L->unit;
    w.on_stmt = hc_on_stmt;
    w.on_decl = hc_on_decl;
    w.on_call = hc_on_call;
    w.on_ufcs = hc_on_ufcs;
    w.env = &st;
    {
        CcVisitor tv;
        memset(&tv, 0, sizeof(tv));
        tv.expr = hc_mark_task_visit;
        tv.env = &st;
        CcUnit_walk(L->unit, tv);   /* the uses, before the declarations size the channel */
    }
    /* after the `send_task` uses are read, so the task call this builds is
     * not itself read as one, and before the walk, so the send it replaces
     * never reaches the temporary a plain send travels through */
    hc_awaits(&st);
    tw_unit(&w);
    {
        CcVisitor fv;
        memset(&fv, 0, sizeof(fv));
        fv.type = hc_endpoint_types;
        fv.env = L;
        /* after the sites: every endpoint a local declares is recorded, and
         * what is left is the declarators C has to read */
        CcUnit_walk(L->unit, fv);
    }
}

#endif

/* Gate: every face parses and lowers as one unit under today's compiler. */
#include "lower.cch"
#include "print.cch"
#include <stdio.h>

int main(void) {
    CCArena a = cc_arena_heap(kilobytes(64)) @destroy;
    CcSpan s = { 1, 3 };
    CcExpr* e = cc_arena_alloc(a, sizeof(CcExpr), _Alignof(CcExpr));
    e->span = s;
    e->k = { .ident = CC_SLICE_LIT("x") };
    CcExpr* c = cc_arena_alloc(a, sizeof(CcExpr), _Alignof(CcExpr));
    c->span = s;
    CcCall call;
    call.callee = e;
    call.args = vec_new::[CcExprRef](a);
    CcExprList* args = &call.args;   /* header-declared struct fields are not UFCS receivers today */
    args->push(e);
    c->k = { .call = call };
    int n = 0;
    @switch (c->k) {
        case .ident(name): n = (int)name.len; break;
        case .call(cl): {
            CcExprList* xs = &cl.args;
            n = (int)xs->len() + 10;
            break;
        }
        default: n = -1; break;
    }
    printf("%d\n", n);
    return 0;
}

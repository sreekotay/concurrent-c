#pragma(@per_tu)
/* Clean lowerer, step: `@parallel`. The arms of
 * `@parallel { a = f(); b = g(); }` may run at the same time: the first
 * stays on the caller, and each of the others becomes a thunk the runtime
 * may put on another fiber. The block joins before it ends, so every arm
 * has finished by the statement after it — a lexical fork and join, not a
 * nursery that outlives the scope.
 *
 * An arm reaches the locals it names through their addresses, because the
 * caller's frame is still live while the arm runs and the arm is meant to
 * see what the caller sees. The assignment target is one of those
 * addresses.
 *
 * The runtime may refuse to spawn (`cc_parallel_deny_fast`), and a spawn
 * may fail. Both fall back to running the thunk inline, so the arms run
 * either way and the difference is only whether they overlapped.
 *
 * Everything the form can carry beyond plain arms — `spawn`, a predicate,
 * `seq`, `wait`, `worker`, `cache`, a bound handle, `@serial`, and the
 * `for` and dest forms — is a diagnostic naming it. A concurrency
 * construct that quietly ran as something else would be a program that
 * behaves differently for reasons the page does not show.
 * Lifetime: the lowerer arena. */
#ifndef CC_LOWER_PARALLEL_CCH
#define CC_LOWER_PARALLEL_CCH
#include "lower.cch"
#include "typing.cch"

typedef struct PCap {
    CCSlice name;
    CcType* type;
    bool by_addr;               /* the handle the site binds: always the caller's own */
} PCap;
typedef PCap* PCapRef;
typedef Vec::[PCapRef] PCapList;

/* A site that binds a handle: the handle outlives the block, so its
 * declaration goes before it, in the list the block sits in. */
typedef struct PBind {
    CcStmt* at;
    CCSlice name;
    CcType* type;
} PBind;
typedef PBind* PBindRef;
typedef Vec::[PBindRef] PBindList;

typedef struct PStep {
    CcLowerer* L;
    Walker* w;
    uint32_t next_id;
    CcDeclList made;            /* the thunks, in order */
    CCString fwd;               /* their forward declarations */
    PBindList binds;            /* sites whose handle is declared before the block */
    CcStmtList stages;          /* `@stage` statements a `@parallel wait for` claimed */
    CcType* fn_ret;             /* the enclosing function's return type: a walk records
                                 * a `return` into a cell of it */
    bool any;
} PStep;

static CCSlice pl_name(CcLowerer* L, uint32_t id, uint32_t k, const char* suffix) {
    CCString s = @string(`__cc_par_${id}_${k}${suffix}`, L->arena);
    return lw_keep(L, &s);
}

static CCSlice pl_join_type(CcLowerer* L, uint32_t id) {
    CCString s = @string(`__cc_pj_${id}_t`, L->arena);
    return lw_keep(L, &s);
}

/* ---- captures ----------------------------------------------------------- */

/* The local a gated site tests once: true when the arms run in order. */
static CCSlice pl_gate_name(CcLowerer* L, uint32_t id) {
    CCString g = @string(`__cc_par_${id}_seq`, L->arena);
    return lw_keep(L, &g);
}

typedef struct PScan {
    PStep* st;
    Walker* w;
    PCapList caps;
    CcNameList seen;
    CCSlice skip;               /* the assignment target: carried separately */
} PScan;

static bool pl_seen(PScan* sc, CCSlice name) {
    CcNameList* v = &sc->seen;
    size_t n = v->len();
    size_t i;
    for (i = 0; i < n; i++) {
        CCSlice s = *v->get_ptr(i);
        if (slice_eq(s, name)) return true;
    }
    return false;
}

static bool pl_scan_expr(CcExpr* e, void* env) {
    PScan* sc = (PScan*)env;
    CCSlice nm;
    CcType* t;
    @switch (e->k) {
        case .ident(x): nm = x; break;
        default: return true;
    }
    if (!nm.len || pl_seen(sc, nm)) return true;
    if (sc->skip.len && slice_eq(nm, sc->skip)) return true;
    t = sc_lookup(sc->w, nm);
    if (!t) return true;                    /* not a local: a function, an enumerator */
    {
        PCap* c = cc_arena_alloc(sc->st->L->arena, sizeof(PCap), _Alignof(PCap));
        memset(c, 0, sizeof(*c));
        c->name = nm;
        c->type = t;
        sc->caps.push(c);
        sc->seen.push(nm);
    }
    return true;
}

/* Every use of `name` read through `through` instead. */
typedef struct PRef {
    CCArena arena; CCSlice name; CCSlice through; } PRef;

/* The captured name, read through the pointer the environment carries.
 *
 * A deref node, not the text `(*p)`: an identifier whose spelling happens
 * to be that text is one the typing walk cannot look up, so a UFCS call on
 * the captured name would lose its receiver's type. The node types from
 * the pointer's own declaration. */
static bool pl_ref_expr(CcExpr* e, void* env) {
    PRef* r = (PRef*)env;
    CCSlice nm;
    @switch (e->k) {
        case .ident(x): nm = x; break;
        default: return true;
    }
    if (!slice_eq(nm, r->name)) return true;
    {
        CcExpr* p = cc_expr_ident(r->through, e->span, r->arena);
        CcExpr* deref = cc_expr_unary(CC_OP_DEREF, p, e->span, r->arena);
        CcUnary pr;
        pr.op = CC_OP_NONE;
        pr.a = deref;
        e->k = { .paren = pr };
    }
    return true;
}

static void pl_rewrite(CcLowerer* L, CcExpr* e, CcStmt* s, CCSlice name, CCSlice through) {
    CcVisitor v;
    PRef r;
    r.arena = L->arena;
    r.name = name;
    r.through = through;
    memset(&v, 0, sizeof(v));
    v.expr = pl_ref_expr;
    v.env = &r;
    if (e) CcExpr_walk(e, v);
    if (s) CcStmt_walk(s, v);
}

/* A name the arm's own block declares: the rewrite would name the wrong
 * thing, so the step says so instead. */
typedef struct PShadow { PCapList* caps; CCSlice hit; } PShadow;

static bool pl_shadow_stmt(CcStmt* s, void* env) {
    PShadow* sh = (PShadow*)env;
    CcDecl* d = NULL;
    if (sh->hit.len) return true;
    if (!stmt_is_decl(s, &d) || !d) return true;
    @switch (d->k) {
        case .var(v): {
            PCapList* cv = sh->caps;
            size_t n = cv->len();
            size_t i;
            for (i = 0; i < n; i++) {
                PCap* c = *cv->get_ptr(i);
                if (slice_eq(c->name, v.name)) { sh->hit = v.name; return true; }
            }
            break;
        }
        default: break;
    }
    return true;
}

/* The block inside `@serial { ... }`, as an ordinary block: the arm is
 * where the ordering is decided, so the marker itself has nothing left to
 * say to C. */
static CcStmt* pl_serial_body(CcLowerer* L, CcStmt* s) {
    CcStmt* blk;
    CcBlock b;
    bool hit = false;
    if (!s) return NULL;
    @switch (s->k) {
        case .serial(x): b = x; hit = true; break;
        default: break;
    }
    if (!hit) return s;
    blk = cc__stmt_blank(s->span, L->arena);
    blk->k = { .block = b };
    return blk;
}

/* ---- the generated C ---------------------------------------------------- */

/* The environment one arm carries: a pointer per name it reads, and the
 * one it writes. */
static CCString pl_env_text(PStep* st, uint32_t id, uint32_t k, PCapList* caps, CCSlice out_type,
                            bool snapshot) {
    CcLowerer* L = st->L;
    CCArena a = L->arena;
    CCString sb = cc_string_new();
    CCSlice env = pl_name(L, id, k, "_env_t");
    size_t n = caps->len();
    size_t i;
    sb.push_cstr("typedef struct {\n", a);
    for (i = 0; i < n; i++) {
        PCap* c = *caps->get_ptr(i);
        CCSlice tn = L->ix->canon(c->type);
        sb.push_cstr("    ", a);
        sb.push_slice(tn, a);
        sb.push_cstr((snapshot && !c->by_addr) ? " " : "* ", a);
        sb.push_slice(c->name, a);
        sb.push_cstr(";\n", a);
    }
    if (out_type.len) {
        sb.push_cstr("    ", a);
        sb.push_slice(out_type, a);
        sb.push_cstr("* __cc_out;\n", a);
    }
    sb.push_cstr("    CCParallel* __cc_par_h;\n", a);
    sb.push_cstr("} ", a);
    sb.push_slice(env, a);
    sb.push_cstr(";\n", a);
    return sb;
}

/* `static void* <thunk>(void*);` and the site slot the runtime keys its
 * deny decision on. */
static void pl_forward(PStep* st, uint32_t id, uint32_t k) {
    CcLowerer* L = st->L;
    CCArena a = L->arena;
    CCString* sb = &st->fwd;
    sb->push_cstr("static void* ", a);
    sb->push_slice(pl_name(L, id, k, "_thunk"), a);
    sb->push_cstr("(void*);\nstatic void* ", a);
    sb->push_slice(pl_name(L, id, k, "_site"), a);
    sb->push_cstr(";\n", a);
}

/* `(*__e->__cc_out)`: where an arm's one outer name lives on the caller. */
static CcExpr* pl_out_slot(CcLowerer* L, CcSpan sp) {
    CcExpr* read = cc_expr_member(lw_ident(L, cstr_slice("__e"), sp), cstr_slice("__cc_out"), true, sp, L->arena);
    return cc_expr_unary(CC_OP_DEREF, lw_paren(L, read, sp), sp, L->arena);
}

/* A bare `return;` in an arm body leaves the arm, and the thunk it becomes
 * returns `void*` — so what it returns is the same NULL every other exit
 * from the thunk returns. Left bare it is a return with no value from a
 * function that has one. */
static bool pl_bare_return(CcStmt* s, void* env) {
    CcLowerer* L = (CcLowerer*)env;
    @switch (s->k) {
        case .return_(r): {
            CcReturn nr;
            if (r.value) break;
            nr.value = lw_text(L, @string(`NULL`, L->arena), s->span);
            s->k = { .return_ = nr };
            break;
        }
        default: break;
    }
    return true;
}

/* The thunk: the environment, the names it reads, then the arm. */
static CcDecl* pl_thunk_decl(PStep* st, uint32_t id, uint32_t k, PCapList* caps,
                             CcExpr* expr, CcStmt* arm_body, CCSlice out_type,
                             CCSlice target, bool snapshot, CcSpan sp) {
    CcLowerer* L = st->L;
    CCSlice env = pl_name(L, id, k, "_env_t");
    CcStmt* body = lw_block(L, sp);
    CcParamList params = vec_new::[CcParam](L->arena);
    CcType* fn_type = cc__type_blank(sp, L->arena);
    CcType* voidp = cc_type_pointer(cc_type_named(cstr_slice("void"), sp, L->arena), sp, L->arena);
    CcFuncType ft;
    CcFuncDecl fd;
    CcDecl* d;
    size_t n = caps->len();
    size_t i;
    {
        /* `<env>* __e = (<env>*)__p;` */
        CcType* pt = cc_type_pointer(cc_type_named(env, sp, L->arena), sp, L->arena);
        CcExpr* cast = cc__expr_blank(sp, L->arena);
        CcCast ca;
        ca.type = pt;
        ca.a = lw_ident(L, cstr_slice("__p"), sp);
        cast->k = { .cast = ca };
        lw_push(body, lw_decl_stmt(L, pt, cstr_slice("__e"), cast, sp));
    }
    for (i = 0; i < n; i++) {
        PCap* c = *caps->get_ptr(i);
        CcExpr* read = cc_expr_member(lw_ident(L, cstr_slice("__e"), sp), c->name, true, sp, L->arena);
        if (snapshot && !c->by_addr) {
            /* the arm outlives the block, so what it read is what was
             * there when it started, not what the caller has since */
            lw_push(body, lw_decl_stmt(L, c->type, c->name, read, sp));
        } else {
            CcType* pt = cc_type_pointer(c->type, sp, L->arena);
            CCString rn = @string(`__cc_ref_${c->name}`, L->arena);
            CCSlice ref = lw_keep(L, &rn);
            lw_push(body, lw_decl_stmt(L, pt, ref, read, sp));
            pl_rewrite(L, expr, arm_body, c->name, ref);
        }
    }
    /* a bound site pauses and resumes through the handle */
    lw_push(body, lw_expr_stmt(L, lw_call1(L, cstr_slice("cc_parallel_honor"),
                                           cc_expr_member(lw_ident(L, cstr_slice("__e"), sp),
                                                          cstr_slice("__cc_par_h"), true, sp, L->arena), sp), sp));
    if (arm_body) {
        {
            CcVisitor rv;
            memset(&rv, 0, sizeof(rv));
            rv.stmt = pl_bare_return;
            rv.env = L;
            CcStmt_walk(arm_body, rv);
        }
        /* a block arm writes its one outer name as an ordinary local, so
         * the name is bound from the out pointer before the body and
         * stored back after it: a copy the caller never reads would make
         * the assignment look like it happened */
        bool has_out = out_type.len != 0 && target.len != 0;
        if (has_out) {
            CcExpr* slot = pl_out_slot(L, sp);
            lw_push(body, lw_decl_stmt(L, cc_type_named(out_type, sp, L->arena), target, slot, sp));
        }
        lw_push(body, arm_body);
        if (has_out) {
            CcExpr* slot = pl_out_slot(L, sp);
            lw_push(body, lw_expr_stmt(L, lw_assign(L, slot, lw_ident(L, target, sp), sp), sp));
        }
    } else if (out_type.len) {
        CcExpr* read = cc_expr_member(lw_ident(L, cstr_slice("__e"), sp), cstr_slice("__cc_out"), true, sp, L->arena);
        CcExpr* store = lw_assign(L, cc_expr_unary(CC_OP_DEREF, lw_paren(L, read, sp), sp, L->arena), expr, sp);
        lw_push(body, lw_expr_stmt(L, store, sp));
    } else {
        lw_push(body, lw_expr_stmt(L, expr, sp));
    }
    lw_push(body, cc_stmt_return(lw_text(L, @string(`NULL`, L->arena), sp), sp, L->arena));
    {
        CcParam p0;
        memset(&p0, 0, sizeof(p0));
        p0.span = sp;
        p0.type = voidp;
        p0.name = cstr_slice("__p");
        p0.attrs = vec_new::[CcAttr](L->arena);
        params.push(p0);
    }
    memset(&ft, 0, sizeof(ft));
    ft.ret = voidp;
    ft.params = params;
    ft.has_prototype = true;
    { CcTypeK tk = { .func = ft }; fn_type->k = tk; }
    memset(&fd, 0, sizeof(fd));
    fd.type = fn_type;
    fd.name = pl_name(L, id, k, "_thunk");
    fd.body = body;
    d = cc_arena_alloc(L->arena, sizeof(CcDecl), _Alignof(CcDecl));
    memset(d, 0, sizeof(*d));
    d->span = sp;
    d->specs = CC_SPEC_STATIC;
    d->attrs = vec_new::[CcAttr](L->arena);
    { CcDeclK dk = { .func = fd }; d->k = dk; }
    return d;
}

/* The spawn, and the join that always runs: a refused or failed spawn
 * runs the same thunk inline, so the arm happens either way. */
static CcExpr* pl_sizeof(CcLowerer* L, CCSlice name, CcSpan sp) {
    CCString s = @string(`sizeof(${name})`, L->arena);
    return lw_text(L, s, sp);
}

static void pl_zero(CcLowerer* L, CcStmt* blk, CCSlice name, CcSpan sp) {
    CcExpr* addr = cc_expr_unary(CC_OP_ADDR, lw_ident(L, name, sp), sp, L->arena);
    lw_push(blk, lw_expr_stmt(L, lw_call2(L, cstr_slice("cc__bytes_zero"), addr,
                                          pl_sizeof(L, name, sp), sp), sp));
}

/* The environment an arm runs from: declared, zeroed and filled. Nothing
 * here starts anything, so it stands on both schedules -- a gated site
 * fills the environment once and then decides whether to spawn. */
static void pl_env_stmts(CcLowerer* L, CcStmt* blk, uint32_t id, uint32_t k,
                         PCapList* caps, CCSlice target, CCSlice bind, CcSpan sp) {
    CCSlice env = pl_name(L, id, k, "_env_t");
    CCSlice e = pl_name(L, id, k, "_e");
    CCSlice task = pl_name(L, id, k, "_t");
    CCSlice denied = pl_name(L, id, k, "_d");
    size_t n = caps->len();
    size_t i;
    if (bind.len) {
        /* the arm outlives the block, so its environment does too */
        CcType* pt = cc_type_pointer(cc_type_named(env, sp, L->arena), sp, L->arena);
        CCString mk = @string(`(${env}*)cc__heap_alloc(sizeof(${env}))`, L->arena);
        lw_push(blk, lw_decl_stmt(L, pt, e, lw_text(L, mk, sp), sp));
        lw_push(blk, lw_if(L, lw_not(L, lw_ident(L, e, sp), sp),
                           lw_expr_stmt(L, lw_call1(L, cstr_slice("cc_parallel_die"),
                                                    lw_text(L, @string(`"dest-live oom"`, L->arena), sp), sp), sp),
                           NULL, sp));
        lw_push(blk, lw_expr_stmt(L, lw_call2(L, cstr_slice("cc__bytes_zero"), lw_ident(L, e, sp),
                                              pl_sizeof(L, env, sp), sp), sp));
    } else {
        lw_push(blk, lw_decl_stmt(L, cc_type_named(env, sp, L->arena), e, NULL, sp));
        pl_zero(L, blk, e, sp);
    }
    lw_push(blk, lw_decl_stmt(L, cc_type_named(cstr_slice("CCTask"), sp, L->arena), task, NULL, sp));
    lw_push(blk, lw_decl_stmt(L, cc_type_named(cstr_slice("int"), sp, L->arena), denied,
                              lw_text(L, @string(`0`, L->arena), sp), sp));
    pl_zero(L, blk, task, sp);
    for (i = 0; i < n; i++) {
        PCap* c = *caps->get_ptr(i);
        CcExpr* slot = cc_expr_member(lw_ident(L, e, sp), c->name, bind.len != 0, sp, L->arena);
        CcExpr* val = lw_ident(L, c->name, sp);
        if (!bind.len || c->by_addr) val = cc_expr_unary(CC_OP_ADDR, val, sp, L->arena);
        lw_push(blk, lw_expr_stmt(L, lw_assign(L, slot, val, sp), sp));
    }
    if (target.len) {
        CcExpr* slot = cc_expr_member(lw_ident(L, e, sp), cstr_slice("__cc_out"), bind.len != 0, sp, L->arena);
        CcExpr* addr = cc_expr_unary(CC_OP_ADDR, lw_ident(L, target, sp), sp, L->arena);
        lw_push(blk, lw_expr_stmt(L, lw_assign(L, slot, addr, sp), sp));
    }
    {
        CcExpr* slot = cc_expr_member(lw_ident(L, e, sp), cstr_slice("__cc_par_h"), bind.len != 0, sp, L->arena);
        CcExpr* val = lw_text(L, @string(`NULL`, L->arena), sp);
        if (bind.len) val = cc_expr_unary(CC_OP_ADDR, lw_paren(L, lw_ident(L, bind, sp), sp), sp, L->arena);
        lw_push(blk, lw_expr_stmt(L, lw_assign(L, slot, val, sp), sp));
    }
}

/* Offering the arm to the runtime. This is the half a gate skips: when the
 * site runs its arms in order, nothing is spawned and the thunks are
 * called on the caller instead. */
static void pl_fire_stmts(CcLowerer* L, CcStmt* blk, uint32_t id, uint32_t k,
                          CCSlice bind, CcSpan sp) {
    CCSlice thunk = pl_name(L, id, k, "_thunk");
    CCSlice e = pl_name(L, id, k, "_e");
    CCSlice site = pl_name(L, id, k, "_site");
    CCSlice task = pl_name(L, id, k, "_t");
    CCSlice denied = pl_name(L, id, k, "_d");
    if (bind.len) {
        /* the handle promised a live arm: a refused or failed spawn is
         * not something to quietly run inline here */
        CcExpr* sp_call = lw_call2(L, cstr_slice("cc_parallel_spawn_admit"), lw_ident(L, thunk, sp),
                                   lw_ident(L, e, sp), sp);
        CcExpr* invalid = cc_expr_binary(CC_OP_EQ,
                                         cc_expr_member(lw_ident(L, task, sp), cstr_slice("kind"), false, sp, L->arena),
                                         lw_ident(L, cstr_slice("CC_TASK_KIND_INVALID"), sp), sp, L->arena);
        CcExpr* admit = lw_call0(L, cstr_slice("cc_parallel_admit"), sp);
        CcExprList* aa = lw_call_args(admit);
        lw_push(blk, lw_expr_stmt(L, lw_assign(L, lw_ident(L, task, sp), sp_call, sp), sp));
        lw_push(blk, lw_if(L, invalid,
                           lw_expr_stmt(L, lw_call1(L, cstr_slice("cc_parallel_die"),
                                                    lw_text(L, @string(`"dest-live spawn failed"`, L->arena), sp), sp), sp),
                           NULL, sp));
        aa->push(cc_expr_unary(CC_OP_ADDR, lw_paren(L, lw_ident(L, bind, sp), sp), sp, L->arena));
        aa->push(lw_ident(L, task, sp));
        aa->push(lw_ident(L, e, sp));
        lw_push(blk, lw_expr_stmt(L, admit, sp));
        (void)site;
        (void)denied;
        return;
    }
    {
        /* the runtime may refuse this site outright */
        CcExpr* cond = lw_call0(L, cstr_slice("cc_parallel_deny_fast"), sp);
        CcExprList* args = lw_call_args(cond);
        CcStmt* then = lw_block(L, sp);
        CcStmt* els = lw_block(L, sp);
        args->push(lw_ident(L, cstr_slice("__cc_pt"), sp));
        args->push(cc_expr_unary(CC_OP_ADDR, lw_ident(L, site, sp), sp, L->arena));
        args->push(lw_ident(L, thunk, sp));
        lw_push(then, lw_expr_stmt(L, lw_assign(L, lw_ident(L, denied, sp),
                                                lw_text(L, @string(`1`, L->arena), sp), sp), sp));
        lw_push(then, lw_expr_stmt(L, lw_call1(L, cstr_slice("cc_parallel_note_denied"),
                                               lw_ident(L, cstr_slice("__cc_pt"), sp), sp), sp));
        lw_push(els, lw_expr_stmt(L, lw_assign(L, lw_ident(L, task, sp),
                                               lw_call2(L, cstr_slice("cc_parallel_spawn"),
                                                        lw_ident(L, thunk, sp),
                                                        cc_expr_unary(CC_OP_ADDR, lw_ident(L, e, sp), sp, L->arena),
                                                        sp), sp), sp));
        lw_push(blk, lw_if(L, cond, then, els, sp));
    }
}

static void pl_spawn_stmts(CcLowerer* L, CcStmt* blk, uint32_t id, uint32_t k,
                           PCapList* caps, CCSlice target, CCSlice bind, CcSpan sp) {
    pl_env_stmts(L, blk, id, k, caps, target, bind, sp);
    pl_fire_stmts(L, blk, id, k, bind, sp);
}

/* The arm on the caller: the same thunk a spawn would have run, called
 * straight through. The arms are emitted once and the gate picks the route
 * to them, so this is how the sequential schedule reaches an arm. */
static void pl_inline_call(CcLowerer* L, CcStmt* blk, uint32_t id, uint32_t k, CcSpan sp) {
    CCSlice thunk = pl_name(L, id, k, "_thunk");
    CCSlice e = pl_name(L, id, k, "_e");
    CcExpr* call = lw_call1(L, thunk, cc_expr_unary(CC_OP_ADDR, lw_ident(L, e, sp), sp, L->arena), sp);
    CcExpr* cast = cc__expr_blank(sp, L->arena);
    CcCast ca;
    ca.type = cc_type_named(cstr_slice("void"), sp, L->arena);
    ca.a = call;
    cast->k = { .cast = ca };
    lw_push(blk, lw_expr_stmt(L, cast, sp));
}

static void pl_join_stmts(CcLowerer* L, CcStmt* blk, uint32_t id, uint32_t k, CcSpan sp) {
    CCSlice thunk = pl_name(L, id, k, "_thunk");
    CCSlice e = pl_name(L, id, k, "_e");
    CCSlice task = pl_name(L, id, k, "_t");
    CCSlice denied = pl_name(L, id, k, "_d");
    CcStmt* then = lw_block(L, sp);
    CcStmt* els = lw_block(L, sp);
    CcExpr* live = cc_expr_binary(CC_OP_NE,
                                  cc_expr_member(lw_ident(L, task, sp), cstr_slice("kind"), false, sp, L->arena),
                                  lw_ident(L, cstr_slice("CC_TASK_KIND_INVALID"), sp), sp, L->arena);
    CcExpr* cond = cc_expr_binary(CC_OP_LAND, lw_not(L, lw_ident(L, denied, sp), sp), live, sp, L->arena);
    lw_push(then, lw_expr_stmt(L, lw_call1(L, cstr_slice("cc_parallel_join"), lw_ident(L, task, sp), sp), sp));
    lw_push(els, lw_expr_stmt(L, lw_call1(L, cstr_slice("CC_PAR_NOTE_INLINE_ARM"),
                                          lw_ident(L, cstr_slice("__cc_pt"), sp), sp), sp));
    pl_inline_call(L, els, id, k, sp);
    lw_push(blk, lw_if(L, cond, then, els, sp));
}


/* ---- `@parallel for (i in lo..hi)` --------------------------------------
 *
 * A walk over a range, split rather than queued: the span halves until a
 * half is small enough to run, and each split offers its right half to the
 * runtime while the caller takes its left. What the body reads it reads by
 * address, so both halves see the caller's own objects.
 *
 * `break` and `return` leave a walk that is running in several places at
 * once, so they are not a jump: they write the first one to arrive into a
 * cell every half checks, and the site reads it after the walk. */

/* An array capture is its first element's address: a walk that reads
 * `par[i]` wants the same pointer C would decay it to, under the same name,
 * so the body is left exactly as written. Anything else is reached through
 * its address. */
static CcType* pl_for_decayed(CcType* t) {
    if (!t) return NULL;
    @switch (t->k) {
        case .array(ar): return ar.elem;
        default: return NULL;
    }
}

static CCSlice pl_for_name(CcLowerer* L, uint32_t id, const char* suffix) {
    CCString s = @string(`__cc_parfor_${id}${suffix}`, L->arena);
    return lw_keep(L, &s);
}

static CCSlice pl_for_ex_type(CcLowerer* L, uint32_t id) {
    CCString s = @string(`__cc_pf_ex_${id}_t`, L->arena);
    return lw_keep(L, &s);
}

/* The cell an exit is recorded in, and the environment each half carries. */
static CCString pl_for_env_text(PStep* st, uint32_t id, PCapList* caps, CCSlice ret_ty) {
    CcLowerer* L = st->L;
    CCArena a = L->arena;
    CCString sb = cc_string_new();
    CCSlice env = pl_for_name(L, id, "_env_t");
    CCSlice ex = pl_for_ex_type(L, id);
    size_t n = caps->len();
    size_t i;
    sb.push_cstr("typedef struct { cc_atomic_int lock; cc_atomic_int xk; ", a);
    sb.push_slice(ret_ty, a);
    sb.push_cstr(" rv; } ", a);
    sb.push_slice(ex, a);
    sb.push_cstr(";\n", a);
    sb.push_cstr("typedef struct {\n", a);
    for (i = 0; i < n; i++) {
        PCap* c = *caps->get_ptr(i);
        CcType* el = pl_for_decayed(c->type);
        CCSlice tn = L->ix->canon(el ? el : c->type);
        sb.push_cstr("    ", a);
        sb.push_slice(tn, a);
        sb.push_cstr("* ", a);
        sb.push_slice(c->name, a);
        sb.push_cstr(";\n", a);
    }
    sb.push_cstr("    int lo;\n    int hi;\n    ", a);
    sb.push_slice(ex, a);
    sb.push_cstr("* __cc_pf_ex;\n    CCParallel* __cc_par_h;\n} ", a);
    sb.push_slice(env, a);
    sb.push_cstr(";\n", a);
    return sb;
}

static void pl_for_forward(PStep* st, uint32_t id) {
    CcLowerer* L = st->L;
    CCSlice walk = pl_for_name(L, id, "_walk");
    CCSlice thunk = pl_for_name(L, id, "_thunk");
    CCSlice site = pl_for_name(L, id, "_site");
    CCString t = @string(`static void ${walk}(int, int, void*);
static void* ${thunk}(void*);
static void* ${site};
`, L->arena);
    st->fwd.push_slice(t.as_slice(), L->arena);
}

/* `break` and `return v` inside the walked body.
 *
 * The body runs in several halves at once, so neither can simply leave:
 * the first to arrive claims the cell under its lock, every half sees it on
 * its next step, and the site reads it once the walk is done. A `break`
 * that belongs to a loop the body itself opened is that loop's, and is left
 * alone -- which is why this walks with a depth rather than visiting. */
/* `leave`: the label a converted exit jumps to instead of returning outright,
 * for a body that has something to run on the way out -- a walked ticket gives
 * its place back. Empty when returning is the whole of leaving. */
typedef struct PForExit { CcLowerer* L; uint32_t id; bool has_ret; CCSlice leave; } PForExit;

static void pl_for_leave(PForExit* fx, CcStmt* blk, CcSpan sp) {
    CcLowerer* L = fx->L;
    if (fx->leave.len) {
        lw_push(blk, lw_goto(L, fx->leave, sp));
    } else {
        lw_push(blk, cc_stmt_return(NULL, sp, L->arena));
    }
}

static void pl_for_exits(PForExit* fx, CcStmt* s, int depth) {
    CcLowerer* L = fx->L;
    CcStmtList* bs;
    size_t n;
    size_t i;
    CcSpan sp;
    if (!s) return;
    sp = s->span;
    {
        bool is_break = false;
        bool is_ret = false;
        bool is_cont = false;
        CcReturn r;
        @switch (s->k) {
            case .break_: is_break = true; break;
            case .continue_: is_cont = true; break;
            case .return_(x): r = x; is_ret = true; break;
            default: break;
        }
        if (is_cont && depth == 0 && fx->leave.len) {
            /* one ticket ends where the next begins: this body is a function
             * of its own by the time C sees it, so there is no loop here to
             * continue -- ending the ticket is the whole of it */
            CcStmt* g = lw_goto(L, fx->leave, sp);
            s->k = g->k;
            return;
        }
        if (is_break && depth == 0) {
            CCSlice ex = cstr_slice("__cc_pf_ex");
            CCString t = @string(`{ int __cc_z = 0; while (!cc_atomic_cas(&e->${ex}->lock, &__cc_z, 1)) __cc_z = 0; if (cc_atomic_load(&e->${ex}->xk) == 0) cc_atomic_store(&e->${ex}->xk, 1); cc_atomic_store(&e->${ex}->lock, 0); }`, L->arena);
            CcStmt* blk = lw_block(L, sp);
            lw_push(blk, lw_expr_stmt(L, lw_text(L, t, sp), sp));
            pl_for_leave(fx, blk, sp);
            s->k = blk->k;
            return;
        }
        if (is_ret) {
            CCString spelled = r.value ? lw_spell_expr(L, r.value) : @string(`0`, L->arena);
            CCSlice v = lw_keep(L, &spelled);
            CCString t = @string(`{ int __cc_z = 0; while (!cc_atomic_cas(&e->__cc_pf_ex->lock, &__cc_z, 1)) __cc_z = 0; if (cc_atomic_load(&e->__cc_pf_ex->xk) != 2) { e->__cc_pf_ex->rv = (${v}); cc_atomic_store(&e->__cc_pf_ex->xk, 2); } cc_atomic_store(&e->__cc_pf_ex->lock, 0); }`, L->arena);
            CcStmt* blk = lw_block(L, sp);
            lw_push(blk, lw_expr_stmt(L, lw_text(L, t, sp), sp));
            pl_for_leave(fx, blk, sp);
            s->k = blk->k;
            return;
        }
    }
    {
        /* a loop or switch the body opened owns its own `break` */
        int inner = depth;
        bool opens = false;
        @switch (s->k) {
            case .for_: opens = true; break;
            case .while_: opens = true; break;
            case .do_: opens = true; break;
            case .switch_: opens = true; break;
            default: break;
        }
        if (opens) inner = depth + 1;
        bs = lw_block_stmts(s);
        if (bs) {
            n = bs->len();
            for (i = 0; i < n; i++) {
                CcStmt* k = *bs->get_ptr(i);
                pl_for_exits(fx, k, inner);
            }
            return;
        }
        {
            CcStmt* a = NULL;
            CcStmt* b = NULL;
            @switch (s->k) {
                case .if_(x): a = x.then; b = x.els; break;
                case .for_(x): a = x.body; break;
                case .while_(x): a = x.body; break;
                case .do_(x): a = x.body; break;
                case .switch_(x): a = x.body; break;
                case .label(x): a = x.inner; break;
                default: break;
            }
            if (a) pl_for_exits(fx, a, inner);
            if (b) pl_for_exits(fx, b, inner);
        }
    }
}


/* The walk. One function, called on the caller and on every half the
 * runtime accepts. The leaf loop is emitted once: a span of one skips the
 * split, and a split whose spawn was refused falls through to it. */
static CcDecl* pl_for_walk_decl(PStep* st, uint32_t id, PCapList* caps, CcForIn loop,
                                CcExpr* lo, CcExpr* hi, bool has_ex, CcSpan sp) {
    CcLowerer* L = st->L;
    CCSlice env = pl_for_name(L, id, "_env_t");
    CCSlice walk = pl_for_name(L, id, "_walk");
    CCSlice thunk = pl_for_name(L, id, "_thunk");
    CCSlice site = pl_for_name(L, id, "_site");
    CcStmt* fnbody = lw_block(L, sp);
    CcParamList params = vec_new::[CcParam](L->arena);
    CcType* fn_type = cc__type_blank(sp, L->arena);
    CcType* voidp = cc_type_pointer(cc_type_named(cstr_slice("void"), sp, L->arena), sp, L->arena);
    CcType* intt = cc_type_named(cstr_slice("int"), sp, L->arena);
    CcFuncType ft;
    CcFuncDecl fd;
    CcDecl* d;
    size_t n = caps->len();
    size_t i;
    CCSlice bind = loop.bind;
    (void)lo; (void)hi;
    {
        CcType* pt = cc_type_pointer(cc_type_named(env, sp, L->arena), sp, L->arena);
        CcExpr* cast = cc__expr_blank(sp, L->arena);
        CcCast ca;
        ca.type = pt;
        ca.a = lw_ident(L, cstr_slice("__p"), sp);
        cast->k = { .cast = ca };
        lw_push(fnbody, lw_decl_stmt(L, pt, cstr_slice("e"), cast, sp));
    }
    for (i = 0; i < n; i++) {
        PCap* c = *caps->get_ptr(i);
        CcExpr* read = cc_expr_member(lw_ident(L, cstr_slice("e"), sp), c->name, true, sp, L->arena);
        CcType* el = pl_for_decayed(c->type);
        CCSlice cn = c->name;
        if (el) {
            lw_push(fnbody, lw_decl_stmt(L, cc_type_pointer(el, sp, L->arena), cn, read, sp));
        } else {
            CcType* pt = cc_type_pointer(c->type, sp, L->arena);
            CCString rn = @string(`__cc_ref_${cn}`, L->arena);
            CCSlice ref = lw_keep(L, &rn);
            lw_push(fnbody, lw_decl_stmt(L, pt, ref, read, sp));
            pl_rewrite(L, NULL, loop.body, cn, ref);
        }
    }
    {
        CCString t = @string(`if (__cc_lo >= __cc_hi) return`, L->arena);
        lw_push(fnbody, lw_expr_stmt(L, lw_text(L, t, sp), sp));
    }
    lw_push(fnbody, lw_expr_stmt(L, lw_call1(L, cstr_slice("cc_parallel_honor"),
                cc_expr_member(lw_ident(L, cstr_slice("e"), sp), cstr_slice("__cc_par_h"), true, sp, L->arena), sp), sp));
    {
        /* the split: offer the right half, take the left */
        CcStmt* split = lw_block(L, sp);
        CCString head = @string(`CCParTls* __cc_pt = cc__par_tls()`, L->arena);
        CCString mid = @string(`int __cc_mid = __cc_lo + (__cc_hi - __cc_lo) / 2`, L->arena);
        CcStmt* offer = lw_block(L, sp);
        CCString ch = cc_string_new();
        size_t k;
        lw_push(split, lw_expr_stmt(L, lw_text(L, head, sp), sp));
        lw_push(split, lw_expr_stmt(L, lw_text(L, mid, sp), sp));
        ch.push_slice(env.len ? env : cstr_slice(""), L->arena);
        {
            CCString decl = @string(`${env} __cc_child`, L->arena);
            lw_push(offer, lw_expr_stmt(L, lw_text(L, decl, sp), sp));
        }
        lw_push(offer, lw_expr_stmt(L, lw_text(L, @string(`CCTask __cc_t`, L->arena), sp), sp));
        for (k = 0; k < n; k++) {
            PCap* c = *caps->get_ptr(k);
            CCSlice cn = c->name;
            CCString as = @string(`__cc_child.${cn} = e->${cn}`, L->arena);
            lw_push(offer, lw_expr_stmt(L, lw_text(L, as, sp), sp));
        }
        lw_push(offer, lw_expr_stmt(L, lw_text(L, @string(`__cc_child.lo = __cc_mid`, L->arena), sp), sp));
        lw_push(offer, lw_expr_stmt(L, lw_text(L, @string(`__cc_child.hi = __cc_hi`, L->arena), sp), sp));
        lw_push(offer, lw_expr_stmt(L, lw_text(L, @string(`__cc_child.__cc_pf_ex = e->__cc_pf_ex`, L->arena), sp), sp));
        lw_push(offer, lw_expr_stmt(L, lw_text(L, @string(`__cc_child.__cc_par_h = e->__cc_par_h`, L->arena), sp), sp));
        {
            CCString spawn = @string(`__cc_t = cc_parallel_spawn(${thunk}, &__cc_child)`, L->arena);
            CCString took = @string(`if (__cc_t.kind != CC_TASK_KIND_INVALID) { ${walk}(__cc_lo, __cc_mid, __p); cc_parallel_join(__cc_t); return; }`, L->arena);
            lw_push(offer, lw_expr_stmt(L, lw_text(L, spawn, sp), sp));
            lw_push(offer, lw_expr_stmt(L, lw_text(L, took, sp), sp));
        }
        {
            CCString cond = @string(`!cc_parallel_deny_fast(__cc_pt, &${site}, ${thunk})`, L->arena);
            lw_push(split, lw_if(L, lw_text(L, cond, sp), offer, NULL, sp));
        }
        lw_push(split, lw_expr_stmt(L, lw_text(L, @string(`CC_PAR_NOTE_INLINE_ARM(__cc_pt)`, L->arena), sp), sp));
        lw_push(fnbody, lw_if(L, lw_text(L, @string(`(__cc_hi - __cc_lo) > 1`, L->arena), sp), split, NULL, sp));
    }
    {
        /* the leaf, once */
        CcStmt* lbody = lw_block(L, sp);
        CcFor fl;
        CcStmt* fs;
        if (has_ex) {
            CCString ck = @string(`if (e->__cc_pf_ex) { int __cc_xk = cc_atomic_load(&e->__cc_pf_ex->xk); if (__cc_xk) break; }`, L->arena);
            lw_push(lbody, lw_expr_stmt(L, lw_text(L, ck, sp), sp));
        }
        lw_push(lbody, lw_expr_stmt(L, lw_call1(L, cstr_slice("cc_parallel_honor"),
                    cc_expr_member(lw_ident(L, cstr_slice("e"), sp), cstr_slice("__cc_par_h"), true, sp, L->arena), sp), sp));
        if (loop.body) { lw_push(lbody, loop.body); }
        memset(&fl, 0, sizeof(fl));
        fl.init_decl = NULL;
        fl.init_expr = lw_assign(L, lw_ident(L, bind, sp), lw_ident(L, cstr_slice("__cc_lo"), sp), sp);
        fl.cond = cc_expr_binary(CC_OP_LT, lw_ident(L, bind, sp), lw_ident(L, cstr_slice("__cc_hi"), sp), sp, L->arena);
        fl.step = cc_expr_unary(CC_OP_PREINC, lw_ident(L, bind, sp), sp, L->arena);
        fl.body = lbody;
        fl.more = vec_new::[CcStmtRef](L->arena);
        fs = cc__stmt_blank(sp, L->arena);
        { CcStmtK sk = { .for_ = fl }; fs->k = sk; }
        lw_push(fnbody, lw_decl_stmt(L, intt, bind, NULL, sp));
        lw_push(fnbody, fs);
    }
    {
        CcParam p0;
        CcParam p1;
        CcParam p2;
        memset(&p0, 0, sizeof(p0));
        memset(&p1, 0, sizeof(p1));
        memset(&p2, 0, sizeof(p2));
        p0.span = sp; p0.type = intt; p0.name = cstr_slice("__cc_lo"); p0.attrs = vec_new::[CcAttr](L->arena);
        p1.span = sp; p1.type = intt; p1.name = cstr_slice("__cc_hi"); p1.attrs = vec_new::[CcAttr](L->arena);
        p2.span = sp; p2.type = voidp; p2.name = cstr_slice("__p"); p2.attrs = vec_new::[CcAttr](L->arena);
        params.push(p0);
        params.push(p1);
        params.push(p2);
    }
    memset(&ft, 0, sizeof(ft));
    ft.ret = cc_type_named(cstr_slice("void"), sp, L->arena);
    ft.params = params;
    ft.has_prototype = true;
    { CcTypeK tk = { .func = ft }; fn_type->k = tk; }
    memset(&fd, 0, sizeof(fd));
    fd.name = walk;
    fd.type = fn_type;
    fd.body = fnbody;
    d = cc_arena_alloc(L->arena, sizeof(CcDecl), _Alignof(CcDecl));
    memset(d, 0, sizeof(*d));
    d->span = sp;
    d->specs = CC_SPEC_STATIC;
    d->attrs = vec_new::[CcAttr](L->arena);
    { CcDeclK dk = { .func = fd }; d->k = dk; }
    return d;
}

/* The thunk the runtime starts a half through. */
static CcDecl* pl_for_thunk_decl(PStep* st, uint32_t id, CcSpan sp) {
    CcLowerer* L = st->L;
    CCSlice env = pl_for_name(L, id, "_env_t");
    CCSlice walk = pl_for_name(L, id, "_walk");
    CCSlice thunk = pl_for_name(L, id, "_thunk");
    CcStmt* body = lw_block(L, sp);
    CcParamList params = vec_new::[CcParam](L->arena);
    CcType* fn_type = cc__type_blank(sp, L->arena);
    CcType* voidp = cc_type_pointer(cc_type_named(cstr_slice("void"), sp, L->arena), sp, L->arena);
    CcFuncType ft;
    CcFuncDecl fd;
    CcDecl* d;
    {
        CCString t = @string(`${env}* e = (${env}*)__p`, L->arena);
        lw_push(body, lw_expr_stmt(L, lw_text(L, t, sp), sp));
    }
    {
        CCString t = @string(`${walk}(e->lo, e->hi, __p)`, L->arena);
        lw_push(body, lw_expr_stmt(L, lw_text(L, t, sp), sp));
    }
    lw_push(body, cc_stmt_return(lw_text(L, @string(`NULL`, L->arena), sp), sp, L->arena));
    {
        CcParam p0;
        memset(&p0, 0, sizeof(p0));
        p0.span = sp; p0.type = voidp; p0.name = cstr_slice("__p"); p0.attrs = vec_new::[CcAttr](L->arena);
        params.push(p0);
    }
    memset(&ft, 0, sizeof(ft));
    ft.ret = voidp;
    ft.params = params;
    ft.has_prototype = true;
    { CcTypeK tk = { .func = ft }; fn_type->k = tk; }
    memset(&fd, 0, sizeof(fd));
    fd.name = thunk;
    fd.type = fn_type;
    fd.body = body;
    d = cc_arena_alloc(L->arena, sizeof(CcDecl), _Alignof(CcDecl));
    memset(d, 0, sizeof(*d));
    d->span = sp;
    d->specs = CC_SPEC_STATIC;
    d->attrs = vec_new::[CcAttr](L->arena);
    { CcDeclK dk = { .func = fd }; d->k = dk; }
    return d;
}

/* ---- one site ----------------------------------------------------------- */

/* What the arms form can carry that this step does not lower. */
/* The leftmost name of a handle expression: `wk` of `wk.h`, `srv` of
 * `srv->app`. An arm that pauses through the handle reaches the caller's
 * own object, so that name is captured by address rather than copied. */
static bool pl_base_name(CcExpr* e, CCSlice* out) {
    CcExpr* inner = NULL;
    if (!e) return false;
    @switch (e->k) {
        case .ident(x): *out = x; return true;
        case .paren(u): inner = u.a; break;
        case .unary(u): inner = u.a; break;
        case .member(m): inner = m.a; break;
        case .index(ix): inner = ix.a; break;
        default: return false;
    }
    return pl_base_name(inner, out);
}

/* How a site names the handle it fills. `CCParallel h = @parallel …`
 * declares one; `h = @parallel …` and `wk.h = @parallel …` name one that
 * already exists. Both are the caller's own -- the arms pause and resume
 * through its address -- so the step carries the C the handle reads as and
 * reaches it the same way either way. Only the declaration differs, and
 * that is what `declared` is for. */
static CCSlice pl_handle_spell(CcLowerer* L, CcParallel p, bool* declared, CCSlice* base) {
    *declared = false;
    *base = cc_slice_empty();
    if (p.bind.len) {
        *declared = true;
        *base = p.bind;
        return p.bind;
    }
    if (p.target) {
        CCString sp2 = lw_spell_expr(L, p.target);
        (void)pl_base_name(p.target, base);
        return lw_keep(L, &sp2);
    }
    return cc_slice_empty();
}

static bool pl_reject(CcLowerer* L, CcParallel p, CcSpan sp) {
    CCString m;
    if (p.spawn && !p.bind.len && !p.target) {
        /* with a handle, `spawn` is what the handle already says: the arms
         * outlive the block and something joins them later. Without one
         * there is nothing to join them by. */
        m = @string(`'${"@"}parallel spawn' without a handle to join by is not lowered by the clean lowerer yet`, L->arena);
        lw_error(L, sp, m);
        return true;
    }
    if ((p.pred || p.seq) && (p.bind.len || p.target)) {
        m = @string(`a gated '${"@"}parallel' that also binds a handle is not lowered by the clean lowerer yet: the sequential schedule has nothing to hand back`, L->arena);
        lw_error(L, sp, m);
        return true;
    }
    if (p.wait || p.cache.len()) {
        /* Assembled rather than templated: the message carries backticks,
         * which close a template, and an `@`, which reads as a sigil. */
        m = cc_string_new();
        cc_string_push_cstr(&m, "@parallel wait (...) [cache (...)] requires `for (name in lo..hi)`", L->arena);
        lw_error(L, sp, m);
        return true;
    }
    if (p.worker.len) {
        m = @string(`'${"@"}parallel' with 'worker' is not lowered by the clean lowerer yet`, L->arena);
        lw_error(L, sp, m);
        return true;
    }
    return false;
}

static bool pl_arm_ok(CcLowerer* L, CcParallelArm* arm, CcSpan sp) {
    CCString m;
    if (arm->unwrap) {
        m = @string(`an arm that unwraps its own Result is not lowered by the clean lowerer yet: the error has to reach the join`, L->arena);
        lw_error(L, sp, m);
        return false;
    }
    if (!arm->expr && !arm->serial) {
        m = @string(`an empty '${"@"}parallel' arm`, L->arena);
        lw_error(L, sp, m);
        return false;
    }
    return true;
}

static void pl_lower(PStep* st, CcStmt* s, CcParallel p) {
    CcLowerer* L = st->L;
    Walker* w = st->w;
    CcSpan sp = s->span;
    Vec::[CcParallelArm]* armv = &p.arms;
    size_t n = armv->len();
    size_t i;
    uint32_t id;
    CcStmt* blk;
    CCSlice hspell;
    CCSlice hbase;
    bool hdeclared;
    CcExpr* gate;
    bool gated;
    CCSlice gname;
    if (pl_reject(L, p, sp)) return;
    if (!n) {
        /* an empty block would run and join nothing, which is what the
         * caller asked for only by accident */
        CCString m = @string(`${"@"}parallel needs at least one arm`, L->arena);
        lw_error(L, sp, m);
        return;
    }
    for (i = 0; i < n; i++) {
        CcParallelArm* arm = armv->get_ptr(i);
        if (!pl_arm_ok(L, arm, sp)) return;
    }
    id = st->next_id++;
    blk = lw_block(L, sp);
    hspell = pl_handle_spell(L, p, &hdeclared, &hbase);
    if (hspell.len) {
        /* the handle is the caller's: the block fills it and leaves it live */
        lw_push(blk, lw_expr_stmt(L, lw_assign(L, lw_ident(L, hspell, sp),
                                               lw_call0(L, cstr_slice("cc_parallel_dest"), sp), sp), sp));
    }
    lw_push(blk, lw_decl_stmt(L, cc_type_pointer(cc_type_named(cstr_slice("CCParTls"), sp, L->arena), sp, L->arena),
                              cstr_slice("__cc_pt"), lw_call0(L, cstr_slice("cc__par_tls"), sp), sp));
    gate = p.pred ? p.pred : p.seq;
    gated = gate != NULL;
    gname = gated ? pl_gate_name(L, id) : cc_slice_empty();
    if (!gated) {
        CcExpr* who = lw_text(L, @string(`NULL`, L->arena), sp);
        if (hspell.len) who = cc_expr_unary(CC_OP_ADDR, lw_paren(L, lw_ident(L, hspell, sp), sp), sp, L->arena);
        lw_push(blk, lw_expr_stmt(L, lw_call2(L, cstr_slice("cc_parallel_deny_enter"),
                                              lw_ident(L, cstr_slice("__cc_pt"), sp), who, sp), sp));
    }
    /* every arm but the first is offered to the runtime */
    for (i = 1; i < n; i++) {
        CcParallelArm* arm = armv->get_ptr(i);
        PScan sc;
        PCapList caps;
        CCSlice out_type = cc_slice_empty();
        memset(&sc, 0, sizeof(sc));
        sc.st = st;
        sc.w = w;
        sc.caps = vec_new::[PCapRef](L->arena);
        sc.seen = vec_new::[CCSlice](L->arena);
        sc.skip = arm->target;
        {
            CcVisitor v;
            memset(&v, 0, sizeof(v));
            v.expr = pl_scan_expr;
            v.env = &sc;
            if (arm->serial) CcStmt_walk(arm->serial, v);
            else CcExpr_walk(arm->expr, v);
        }
        caps = sc.caps;
        if (hbase.len) {
            /* the handle the arms pause and resume through is the
             * caller's: a copy of it is a handle nothing else can see */
            PCapList* cv = &caps;
            size_t nc = cv->len();
            size_t ci;
            for (ci = 0; ci < nc; ci++) {
                PCap* c = *cv->get_ptr(ci);
                if (slice_eq(c->name, hbase)) c->by_addr = true;
            }
        }
        if (arm->serial) {
            CcVisitor v;
            PShadow sh;
            memset(&sh, 0, sizeof(sh));
            sh.caps = &caps;
            memset(&v, 0, sizeof(v));
            v.stmt = pl_shadow_stmt;
            v.env = &sh;
            CcStmt_walk(arm->serial, v);
            if (sh.hit.len) {
                CCSlice nm = sh.hit;
                CCString m = @string(`the arm reads '${nm}' from the enclosing scope and declares one of its own; the clean lowerer does not lower an arm that shadows what it captures`, L->arena);
                lw_error(L, sp, m);
                return;
            }
        }
        if (arm->target.len) {
            CcType* t = sc_lookup(w, arm->target);
            if (!t) {
                CCSlice nm = arm->target;
                CCString m = @string(`the arm assigns to '${nm}', which is not declared in the enclosing scope`, L->arena);
                lw_error(L, sp, m);
                return;
            }
            out_type = L->ix->canon(t);
        }
        {
            /* the caller builds the environment, so its type is declared
             * with the forwards, above every function that fills one */
            CCString et = pl_env_text(st, id, (uint32_t)i, &caps, out_type, hspell.len != 0);
            st->fwd.push_slice(et.as_slice(), L->arena);
        }
        pl_forward(st, id, (uint32_t)i);
        st->made.push(pl_thunk_decl(st, id, (uint32_t)i, &caps, arm->expr, pl_serial_body(L, arm->serial),
                                    out_type, arm->target, hspell.len != 0, sp));
        pl_env_stmts(L, blk, id, (uint32_t)i, &caps, arm->target, hspell, sp);
        if (!gated) pl_fire_stmts(L, blk, id, (uint32_t)i, hspell, sp);
    }
    if (gated) {
        /* One test, once: true when the arms run in order. The arms
         * themselves are emitted once either way -- this chooses the route
         * to them, not a second copy of them, because the bodies have
         * already been rewritten in place for the thunk. */
        CcStmt* fire = lw_block(L, sp);
        lw_push(blk, lw_decl_stmt(L, cc_type_named(cstr_slice("int"), sp, L->arena), gname,
                                  lw_not(L, lw_paren(L, gate, sp), sp), sp));
        lw_push(fire, lw_expr_stmt(L, lw_call2(L, cstr_slice("cc_parallel_deny_enter"),
                                               lw_ident(L, cstr_slice("__cc_pt"), sp),
                                               lw_text(L, @string(`NULL`, L->arena), sp), sp), sp));
        for (i = 1; i < n; i++) pl_fire_stmts(L, fire, id, (uint32_t)i, hspell, sp);
        lw_push(blk, lw_if(L, lw_not(L, lw_ident(L, gname, sp), sp), fire, NULL, sp));
    }
    /* the first arm stays here */
    {
        CcParallelArm* arm = armv->get_ptr(0);
        if (arm->serial) {
            lw_push(blk, pl_serial_body(L, arm->serial));
        } else {
            CcExpr* e0 = arm->expr;
            if (arm->target.len) e0 = lw_assign(L, lw_ident(L, arm->target, sp), e0, sp);
            lw_push(blk, lw_expr_stmt(L, e0, sp));
        }
    }
    if (gated) {
        CcStmt* joins = lw_block(L, sp);
        CcStmt* order = lw_block(L, sp);
        for (i = 1; i < n; i++) pl_join_stmts(L, joins, id, (uint32_t)i, sp);
        lw_push(joins, lw_expr_stmt(L, lw_call1(L, cstr_slice("cc_parallel_deny_leave"),
                                                lw_ident(L, cstr_slice("__cc_pt"), sp), sp), sp));
        /* nothing was denied on this schedule, so no note: the arms simply
         * run after the first, in the order they were written */
        for (i = 1; i < n; i++) pl_inline_call(L, order, id, (uint32_t)i, sp);
        lw_push(blk, lw_if(L, lw_not(L, lw_ident(L, gname, sp), sp), joins, order, sp));
    } else if (!hspell.len) {
        /* the block joins before it ends; a bound handle joins later */
        for (i = 1; i < n; i++) pl_join_stmts(L, blk, id, (uint32_t)i, sp);
        lw_push(blk, lw_expr_stmt(L, lw_call1(L, cstr_slice("cc_parallel_deny_leave"),
                                              lw_ident(L, cstr_slice("__cc_pt"), sp), sp), sp));
    } else if (hdeclared) {
        /* the block declares it, so it is hoisted above the block */
        PBind* b = cc_arena_alloc(L->arena, sizeof(PBind), _Alignof(PBind));
        memset(b, 0, sizeof(*b));
        b->at = s;
        b->name = p.bind;
        b->type = p.bind_type ? p.bind_type : cc_type_named(cstr_slice("CCParallel"), sp, L->arena);
        st->binds.push(b);
    }
    s->k = blk->k;
    st->any = true;
}

/* `@parallel(h) { body }`: one more arm on a handle that already exists.
 *
 * The handle was bound by an earlier `@parallel spawn { … } !>`, and this
 * hands it another arm — same environment, same thunk, same admit as an
 * arm of a bound block, minus everything that belongs to opening one:
 * nothing creates the dest, nothing joins at the end, and nothing enters
 * the deny scope, because the block that did those still owns them.
 *
 * The captures are the bound shape: a copy taken when the arm starts,
 * except the handle itself, which is the caller's own. */
static void pl_dest(PStep* st, CcStmt* s, CcParallelDest pd) {
    CcLowerer* L = st->L;
    Walker* w = st->w;
    CcSpan sp = s->span;
    CCSlice bind;
    uint32_t id;
    CcStmt* blk;
    CcStmt* body;
    PScan sc;
    PCapList caps;
    if (!pd.dest || !expr_ident(strip_parens_expr(pd.dest), &bind) || !bind.len) {
        CCString m = @string(`'${"@"}parallel(h)' needs a handle a name reaches: bind it with 'CCParallel h = ${"@"}parallel spawn { ... } !>;'`, L->arena);
        lw_error(L, sp, m);
        return;
    }
    id = st->next_id++;
    body = lw_block(L, sp);
    {
        CcStmtList* bs = lw_block_stmts(body);
        CcStmtList* src = &pd.stmts;
        size_t n = src->len();
        size_t i;
        for (i = 0; i < n; i++) {
            CcStmt* one = *src->get_ptr(i);
            bs->push(one);
        }
    }
    memset(&sc, 0, sizeof(sc));
    sc.st = st;
    sc.w = w;
    sc.caps = vec_new::[PCapRef](L->arena);
    sc.seen = vec_new::[CCSlice](L->arena);
    sc.skip = cc_slice_empty();
    {
        CcVisitor v;
        memset(&v, 0, sizeof(v));
        v.expr = pl_scan_expr;
        v.env = &sc;
        CcStmt_walk(body, v);
    }
    caps = sc.caps;
    {
        PCapList* cv = &caps;
        size_t nc = cv->len();
        size_t ci;
        for (ci = 0; ci < nc; ci++) {
            PCap* c = *cv->get_ptr(ci);
            if (slice_eq(c->name, bind)) c->by_addr = true;
        }
    }
    {
        CCString et = pl_env_text(st, id, 0, &caps, cc_slice_empty(), true);
        st->fwd.push_slice(et.as_slice(), L->arena);
    }
    pl_forward(st, id, 0);
    st->made.push(pl_thunk_decl(st, id, 0, &caps, NULL, body, cc_slice_empty(),
                                cc_slice_empty(), true, sp));
    blk = lw_block(L, sp);
    pl_spawn_stmts(L, blk, id, 0, &caps, cc_slice_empty(), bind, sp);
    s->k = blk->k;
    st->any = true;
}

/* A `@stage` this step already claimed for the walk it belongs to. */
static bool pl_stage_owned(PStep* st, CcStmt* s) {
    CcStmtList* v = &st->stages;
    size_t n = v->len();
    size_t i;
    for (i = 0; i < n; i++) if (*v->get_ptr(i) == s) return true;
    return false;
}

/* A `@stage` below the top level of a walk's body: it orders that walk's
 * tickets, so it has to be a statement of the walk, not of something inside
 * it. Reported here because the walk's own statement is about to be dropped
 * and its body with it. */
static bool pl_stage_visit(CcStmt* s, void* env) {
    PStep* st = (PStep*)env;
    bool is_stage = false;
    @switch (s->k) {
        case .stage: is_stage = true; break;
        default: break;
    }
    if (is_stage) {
        CCString m = cc_string_new();
        cc_string_push_cstr(&m, "@stage must be a top-level statement of a '@parallel wait for' body", st->L->arena);
        lw_error(st->L, s->span, m);
    }
    return true;
}

static void pl_stray_stages(PStep* st, CcStmt* body) {
    CcStmtList* bs = lw_block_stmts(body);
    size_t n;
    size_t i;
    if (!bs) return;
    n = bs->len();
    for (i = 0; i < n; i++) {
        CcStmt* k = *bs->get_ptr(i);
        bool is_stage = false;
        CcVisitor v;
        @switch (k->k) {
            case .stage: is_stage = true; break;
            default: break;
        }
        if (is_stage) continue;   /* a statement of the walk: that is where it belongs */
        memset(&v, 0, sizeof(v));
        v.stmt = pl_stage_visit;
        v.env = st;
        CcStmt_walk(k, v);
    }
}


/* The site: build the environment, walk the whole span on the caller, then
 * read back whichever exit arrived first. */
static void pl_for_lower(PStep* st, CcStmt* s, CcParallelFor pf, CcRange rg) {
    CcLowerer* L = st->L;
    Walker* w = st->w;
    CcSpan sp = s->span;
    uint32_t id = st->next_id++;
    PScan sc;
    PCapList caps;
    CcStmt* blk = lw_block(L, sp);
    CCSlice env = pl_for_name(L, id, "_env_t");
    CCSlice walk = pl_for_name(L, id, "_walk");
    CCSlice ex = pl_for_ex_type(L, id);
    CCSlice cell = pl_for_name(L, id, "_ex");
    CCSlice ev = pl_for_name(L, id, "_e");
    CCSlice ret_ty = cstr_slice("int");
    bool has_ret = false;
    size_t n;
    size_t i;
    memset(&sc, 0, sizeof(sc));
    sc.st = st;
    sc.w = w;
    sc.caps = vec_new::[PCapRef](L->arena);
    sc.seen = vec_new::[CCSlice](L->arena);
    sc.skip = pf.loop.bind;
    {
        CcVisitor v;
        memset(&v, 0, sizeof(v));
        v.expr = pl_scan_expr;
        v.env = &sc;
        if (pf.loop.body) CcStmt_walk(pf.loop.body, v);
    }
    caps = sc.caps;
    n = caps.len();
    for (i = 0; i < n; i++) {
        PCap* c = *caps.get_ptr(i);
        c->by_addr = true;
    }
    if (st->fn_ret) {
        CCSlice rn = L->ix->canon(st->fn_ret);
        if (rn.len) ret_ty = rn;
    }
    {
        PForExit fx;
        fx.L = L;
        fx.id = id;
        fx.has_ret = false;
        fx.leave = cc_slice_empty();   /* the split walk returns, and that is all */
        if (pf.loop.body) pl_for_exits(&fx, pf.loop.body, 0);
        has_ret = true;
    }
    {
        CCString et = pl_for_env_text(st, id, &caps, ret_ty);
        st->fwd.push_slice(et.as_slice(), L->arena);
    }
    pl_for_forward(st, id);
    st->made.push(pl_for_thunk_decl(st, id, sp));
    st->made.push(pl_for_walk_decl(st, id, &caps, pf.loop, rg.lo, rg.hi, has_ret, sp));
    {
        CCString d1 = @string(`${env} ${ev}`, L->arena);
        CCString d2 = @string(`${ex} ${cell}`, L->arena);
        lw_push(blk, lw_expr_stmt(L, lw_text(L, d1, sp), sp));
        lw_push(blk, lw_expr_stmt(L, lw_text(L, d2, sp), sp));
    }
    for (i = 0; i < n; i++) {
        PCap* c = *caps.get_ptr(i);
        CCSlice cn = c->name;
        CCString as = pl_for_decayed(c->type)
            ? @string(`${ev}.${cn} = (${cn})`, L->arena)
            : @string(`${ev}.${cn} = &(${cn})`, L->arena);
        lw_push(blk, lw_expr_stmt(L, lw_text(L, as, sp), sp));
    }
    {
        CCString z = @string(`cc__bytes_zero(&${cell}, sizeof(${cell}))`, L->arena);
        CCString a1 = @string(`${ev}.__cc_pf_ex = &${cell}`, L->arena);
        CCString a2 = @string(`${ev}.__cc_par_h = 0`, L->arena);
        lw_push(blk, lw_expr_stmt(L, lw_text(L, z, sp), sp));
        lw_push(blk, lw_expr_stmt(L, lw_text(L, a1, sp), sp));
        lw_push(blk, lw_expr_stmt(L, lw_text(L, a2, sp), sp));
    }
    {
        CCString lo = lw_spell_expr(L, rg.lo);
        CCString hi = lw_spell_expr(L, rg.hi);
        CCSlice los = lw_keep(L, &lo);
        CCSlice his = lw_keep(L, &hi);
        CCString call = @string(`${walk}((int)(${los}), (int)(${his}), &${ev})`, L->arena);
        lw_push(blk, lw_expr_stmt(L, lw_text(L, call, sp), sp));
    }
    {
        /* a `return` inside the walk is the caller's to make */
        CcStmt* then = lw_block(L, sp);
        CCString rv = @string(`${cell}.rv`, L->arena);
        CCString cond = @string(`cc_atomic_load(&${cell}.xk) == 2`, L->arena);
        lw_push(then, cc_stmt_return(lw_text(L, rv, sp), sp, L->arena));
        lw_push(blk, lw_if(L, lw_text(L, cond, sp), then, NULL, sp));
    }
    s->k = blk->k;
    st->any = true;
}


/* ---- `@parallel [seq (c)] wait (gate) for (i in lo..hi)` -----------------
 *
 * A walk whose tickets are handed out under a gate: the turnstile caps how
 * many iterations are in flight at once, and a pool of runners the size of
 * that cap takes tickets off a channel in the order the caller sent them.
 * What the body reads it reads by address, the same as the split walk.
 *
 * The body is emitted once, as `__cc_pw_<id>_run`, and every schedule goes
 * through it. When the runtime hands back no runner -- no nursery, a failed
 * allocation, a spawn that never took, or a `seq` that denied the site --
 * the caller calls that same function in ticket order, holding one slot of
 * its own. Nothing about the function changes between the two schedules: it
 * enters nothing (the caller holds the ticket before the call either way),
 * it records into the slot it was handed, and it leaves the turnstile once
 * on the way out however the body ended.
 *
 * A ticket error is a slot, not a jump: the body's `!>` writes the slot,
 * cancels the nursery so the tickets that have not started stop starting,
 * and jumps to the one exit. The site reads the slots after the pool has
 * drained and re-raises the first one where the walk stood. */

static CCSlice pl_pw_name(CcLowerer* L, uint32_t id, const char* suffix) {
    CCString s = @string(`__cc_pw_${id}${suffix}`, L->arena);
    return lw_keep(L, &s);
}

/* C the later steps have nothing to say about: the pool's own plumbing. */
static void pl_pw_text(CcLowerer* L, CcStmt* blk, CCString t, CcSpan sp) {
    lw_push(blk, lw_expr_stmt(L, lw_text(L, t, sp), sp));
}

static CcStmt* pl_pw_for(CcLowerer* L, CCString init, CCString cond, CCString step,
                         CcStmt* body, CcSpan sp) {
    CcFor fl;
    CcStmt* fs;
    memset(&fl, 0, sizeof(fl));
    fl.init_decl = NULL;
    fl.init_expr = lw_text(L, init, sp);
    fl.cond = lw_text(L, cond, sp);
    fl.step = lw_text(L, step, sp);
    fl.body = body;
    fl.more = vec_new::[CcStmtRef](L->arena);
    fs = cc__stmt_blank(sp, L->arena);
    { CcStmtK sk = { .for_ = fl }; fs->k = sk; }
    return fs;
}

/* What the site, the runners and the body all read: the gate and the
 * nursery the pool shares, one slot per runner for the error it saw, the
 * argument a runner starts from, the cell an exit is recorded in, and the
 * environment the body reaches its captures through. */
static CCString pl_pw_env_text(PStep* st, uint32_t id, PCapList* caps, CCSlice ret_ty) {
    CcLowerer* L = st->L;
    CCArena a = L->arena;
    CCString sb = cc_string_new();
    CCSlice env = pl_pw_name(L, id, "_env_t");
    CCSlice sht = pl_pw_name(L, id, "_sh_t");
    CCSlice slt = pl_pw_name(L, id, "_slot_t");
    CCSlice agt = pl_pw_name(L, id, "_arg_t");
    CCSlice ex = pl_for_ex_type(L, id);
    size_t n = caps->len();
    size_t i;
    sb.push_cstr("typedef struct { CCTurnstile* gate; CCNurseryHost* nur; CCChan* work; CCParallel* dest; } ", a);
    sb.push_slice(sht, a);
    sb.push_cstr(";\ntypedef struct { int failed; int i; CCError err; } ", a);
    sb.push_slice(slt, a);
    sb.push_cstr(";\ntypedef struct { CCChan* work; void* env; int slot; } ", a);
    sb.push_slice(agt, a);
    sb.push_cstr(";\ntypedef struct { cc_atomic_int lock; cc_atomic_int xk; ", a);
    sb.push_slice(ret_ty, a);
    sb.push_cstr(" rv; } ", a);
    sb.push_slice(ex, a);
    sb.push_cstr(";\ntypedef struct {\n    ", a);
    sb.push_slice(sht, a);
    sb.push_cstr("* sh;\n    ", a);
    sb.push_slice(slt, a);
    sb.push_cstr("* slots;\n", a);
    for (i = 0; i < n; i++) {
        PCap* c = *caps->get_ptr(i);
        CcType* el = pl_for_decayed(c->type);
        CCSlice tn = L->ix->canon(el ? el : c->type);
        sb.push_cstr("    ", a);
        sb.push_slice(tn, a);
        sb.push_cstr("* ", a);
        sb.push_slice(c->name, a);
        sb.push_cstr(";\n", a);
    }
    sb.push_cstr("    ", a);
    sb.push_slice(ex, a);
    sb.push_cstr("* __cc_pf_ex;\n} ", a);
    sb.push_slice(env, a);
    sb.push_cstr(";\n", a);
    return sb;
}

static void pl_pw_forward(PStep* st, uint32_t id) {
    CcLowerer* L = st->L;
    CCSlice run = pl_pw_name(L, id, "_run");
    CCSlice worker = pl_pw_name(L, id, "_worker");
    CCString t = @string(`static void ${run}(void*, int, int);
static void* ${worker}(void*);
`, L->arena);
    st->fwd.push_slice(t.as_slice(), L->arena);
}

/* A runner: one ticket at a time off the channel, through the one body,
 * until the site closes the channel behind the last ticket it sent. */
static CcDecl* pl_pw_worker_decl(PStep* st, uint32_t id, CcSpan sp) {
    CcLowerer* L = st->L;
    CCSlice run = pl_pw_name(L, id, "_run");
    CCSlice worker = pl_pw_name(L, id, "_worker");
    CCSlice agt = pl_pw_name(L, id, "_arg_t");
    CCString t = @string(`static void* ${worker}(void* __p) {
    ${agt}* __cc_pw_a = (${agt}*)__p;
    int __cc_pw_i;
    while (cc_chan_recv(__cc_pw_a->work, &__cc_pw_i, sizeof(__cc_pw_i)) == 0)
        ${run}(__cc_pw_a->env, __cc_pw_i, __cc_pw_a->slot);
    return NULL;
}
`, L->arena);
    return lw_raw_decl(L, t, sp);
}

/* The body, once. Called on a runner and on the caller, told which ticket it
 * is and which slot is its own; the ticket is already held when it starts and
 * is given back before it returns, so both schedules keep the gate balanced. */
static CcDecl* pl_pw_run_decl(PStep* st, uint32_t id, PCapList* caps, CcForIn loop, CcSpan sp) {
    CcLowerer* L = st->L;
    CCSlice env = pl_pw_name(L, id, "_env_t");
    CCSlice run = pl_pw_name(L, id, "_run");
    CCSlice sht = pl_pw_name(L, id, "_sh_t");
    CCSlice slt = pl_pw_name(L, id, "_slot_t");
    CCSlice done = pl_pw_name(L, id, "_done");
    CcStmt* fnbody = lw_block(L, sp);
    CcParamList params = vec_new::[CcParam](L->arena);
    CcType* fn_type = cc__type_blank(sp, L->arena);
    CcType* voidp = cc_type_pointer(cc_type_named(cstr_slice("void"), sp, L->arena), sp, L->arena);
    CcType* intt = cc_type_named(cstr_slice("int"), sp, L->arena);
    CcFuncType ft;
    CcFuncDecl fd;
    CcDecl* d;
    size_t n = caps->len();
    size_t i;
    CCSlice bind = loop.bind;
    {
        CcType* pt = cc_type_pointer(cc_type_named(env, sp, L->arena), sp, L->arena);
        CcExpr* cast = cc__expr_blank(sp, L->arena);
        CcCast ca;
        ca.type = pt;
        ca.a = lw_ident(L, cstr_slice("__p"), sp);
        cast->k = { .cast = ca };
        lw_push(fnbody, lw_decl_stmt(L, pt, cstr_slice("e"), cast, sp));
    }
    {
        CCString d1 = @string(`${sht}* __cc_pw_sh = e->sh`, L->arena);
        CCString d2 = @string(`${slt}* __cc_pw_sl = &e->slots[__cc_pw_slot]`, L->arena);
        CCString d3 = @string(`cc_parallel_honor(__cc_pw_sh->dest)`, L->arena);
        pl_pw_text(L, fnbody, d1, sp);
        pl_pw_text(L, fnbody, d2, sp);
        pl_pw_text(L, fnbody, d3, sp);
    }
    lw_push(fnbody, lw_decl_stmt(L, intt, bind, lw_ident(L, cstr_slice("__cc_pw_i"), sp), sp));
    for (i = 0; i < n; i++) {
        PCap* c = *caps->get_ptr(i);
        CcExpr* read = cc_expr_member(lw_ident(L, cstr_slice("e"), sp), c->name, true, sp, L->arena);
        CcType* el = pl_for_decayed(c->type);
        CCSlice cn = c->name;
        if (el) {
            lw_push(fnbody, lw_decl_stmt(L, cc_type_pointer(el, sp, L->arena), cn, read, sp));
        } else {
            CcType* pt = cc_type_pointer(c->type, sp, L->arena);
            CCString rn = @string(`__cc_ref_${cn}`, L->arena);
            CCSlice ref = lw_keep(L, &rn);
            lw_push(fnbody, lw_decl_stmt(L, pt, ref, read, sp));
            pl_rewrite(L, NULL, loop.body, cn, ref);
        }
    }
    {
        /* `break` and `return` leave the body, not the runner: the first to
         * arrive claims the cell the site reads, and both jump to the one
         * exit, so the ticket is given back however the body ended */
        PForExit fx;
        fx.L = L;
        fx.id = id;
        fx.has_ret = false;
        fx.leave = done;
        if (loop.body) pl_for_exits(&fx, loop.body, 0);
    }
    {
        /* every `!>` in the body is this ticket's error: the slot the site
         * reads, the cancel that stops the tickets that have not started,
         * and the same exit the body's own ending takes.
         * `CcLowerer_results` runs after this step and registers a handler
         * per statement list, so a synthesized one needs nothing further. */
        CcStmt* hb = lw_block(L, sp);
        CcStmt* hs = cc__stmt_blank(sp, L->arena);
        CcErrhandler eh;
        CCString ht = @string(`__cc_pw_sl->err = __cc_pw_eb; __cc_pw_sl->failed = 1; __cc_pw_sl->i = __cc_pw_i; cc_nursery_cancel_host(__cc_pw_sh->nur)`, L->arena);
        pl_pw_text(L, hb, ht, sp);
        lw_push(hb, lw_goto(L, done, sp));
        memset(&eh, 0, sizeof(eh));
        eh.err_type = cc_type_named(cstr_slice("CCError"), sp, L->arena);
        eh.binder = cstr_slice("__cc_pw_eb");
        eh.body = hb;
        { CcStmtK sk = { .errhandler = eh }; hs->k = sk; }
        lw_push(fnbody, hs);
    }
    if (loop.body) { lw_push(fnbody, loop.body); }
    {
        /* the one exit. The `return` after it is what keeps the ordinary
         * ending out of the handler the results step hoists below. */
        CcStmt* lv = lw_block(L, sp);
        CCString lt = @string(`__typeof__(cc_turnstile_leave(__cc_pw_sh->gate)) __cc_pw_lr = cc_turnstile_leave(__cc_pw_sh->gate); if (!__cc_pw_lr.ok && !__cc_pw_sl->failed) { __cc_pw_sl->err = __cc_pw_lr.u.error.base; __cc_pw_sl->failed = 1; __cc_pw_sl->i = __cc_pw_i; cc_nursery_cancel_host(__cc_pw_sh->nur); }`, L->arena);
        pl_pw_text(L, lv, lt, sp);
        lw_push(fnbody, lw_label(L, done, lv, sp));
        lw_push(fnbody, cc_stmt_return(NULL, sp, L->arena));
    }
    {
        CcParam p0;
        CcParam p1;
        CcParam p2;
        memset(&p0, 0, sizeof(p0));
        memset(&p1, 0, sizeof(p1));
        memset(&p2, 0, sizeof(p2));
        p0.span = sp; p0.type = voidp; p0.name = cstr_slice("__p"); p0.attrs = vec_new::[CcAttr](L->arena);
        p1.span = sp; p1.type = intt; p1.name = cstr_slice("__cc_pw_i"); p1.attrs = vec_new::[CcAttr](L->arena);
        p2.span = sp; p2.type = intt; p2.name = cstr_slice("__cc_pw_slot"); p2.attrs = vec_new::[CcAttr](L->arena);
        params.push(p0);
        params.push(p1);
        params.push(p2);
    }
    memset(&ft, 0, sizeof(ft));
    ft.ret = cc_type_named(cstr_slice("void"), sp, L->arena);
    ft.params = params;
    ft.has_prototype = true;
    { CcTypeK tk = { .func = ft }; fn_type->k = tk; }
    memset(&fd, 0, sizeof(fd));
    fd.name = run;
    fd.type = fn_type;
    fd.body = fnbody;
    d = cc_arena_alloc(L->arena, sizeof(CcDecl), _Alignof(CcDecl));
    memset(d, 0, sizeof(*d));
    d->span = sp;
    d->specs = CC_SPEC_STATIC;
    d->attrs = vec_new::[CcAttr](L->arena);
    { CcDeclK dk = { .func = fd }; d->k = dk; }
    return d;
}

/* What `wait (...)` names: 2 a turnstile reached by pointer, 1 one held by
 * value, 0 not a turnstile at all. The pool caps on the caller's own, so a
 * value is taken by address; anything else is not a gate this site can cap on
 * and saying so beats a C type error at a line about something else. */
static int pl_pw_gate_form(Walker* w, CcExpr* g) {
    CcType* t = type_of_expr(w, g);
    CcType* p = NULL;
    CCSlice nm = cc_slice_empty();
    CCSlice want = cstr_slice("CCTurnstile");
    if (!t) return 0;
    @switch (t->k) {
        case .pointer(pt): p = pt.pointee; break;
        default: break;
    }
    if (p) {
        if (type_named_name(p, &nm) && slice_eq(nm, want)) return 2;
        return 0;
    }
    if (type_named_name(t, &nm) && slice_eq(nm, want)) return 1;
    return 0;
}

/* The site: open the pool, hand out the tickets under the gate, then read
 * what the pool left behind. */
static void pl_pw_lower(PStep* st, CcStmt* s, CcParallelFor pf, CcRange rg) {
    CcLowerer* L = st->L;
    Walker* w = st->w;
    CcSpan sp = s->span;
    uint32_t id = st->next_id++;
    PScan sc;
    PCapList caps;
    CcStmt* blk = lw_block(L, sp);
    CCSlice env = pl_pw_name(L, id, "_env_t");
    CCSlice sht = pl_pw_name(L, id, "_sh_t");
    CCSlice slt = pl_pw_name(L, id, "_slot_t");
    CCSlice agt = pl_pw_name(L, id, "_arg_t");
    CCSlice ext = pl_for_ex_type(L, id);
    CCSlice run = pl_pw_name(L, id, "_run");
    CCSlice worker = pl_pw_name(L, id, "_worker");
    CCSlice ev = pl_pw_name(L, id, "_e");
    CCSlice shv = pl_pw_name(L, id, "_sh");
    CCSlice cell = pl_pw_name(L, id, "_ex");
    CCSlice s0 = pl_pw_name(L, id, "_s0");
    CCSlice nur = pl_pw_name(L, id, "_n");
    CCSlice gv = pl_pw_name(L, id, "_ts");
    CCSlice work = pl_pw_name(L, id, "_work");
    CCSlice slots = pl_pw_name(L, id, "_slots");
    CCSlice args = pl_pw_name(L, id, "_args");
    CCSlice ferr = pl_pw_name(L, id, "_ferr");
    CCSlice fail = pl_pw_name(L, id, "_fail");
    CCSlice echo = pl_pw_name(L, id, "_echo");
    CCSlice best = pl_pw_name(L, id, "_best");
    CCSlice wv = pl_pw_name(L, id, "_w");
    CCSlice nw = pl_pw_name(L, id, "_nw");
    CCSlice nh = pl_pw_name(L, id, "_nh");
    CCSlice spawned = pl_pw_name(L, id, "_spawned");
    CCSlice iv = pl_pw_name(L, id, "_i");
    CCSlice eok = pl_pw_name(L, id, "_eok");
    CCSlice sf = pl_pw_name(L, id, "_sf");
    CCSlice ret_ty = cstr_slice("int");
    CCSlice gspell = cc_slice_empty();
    CCSlice wspell = cc_slice_empty();
    CCSlice los = cc_slice_empty();
    CCSlice his = cc_slice_empty();
    int gform = pl_pw_gate_form(w, pf.wait);
    size_t n;
    size_t i;
    memset(&sc, 0, sizeof(sc));
    sc.st = st;
    sc.w = w;
    sc.caps = vec_new::[PCapRef](L->arena);
    sc.seen = vec_new::[CCSlice](L->arena);
    sc.skip = pf.loop.bind;
    {
        CcVisitor v;
        memset(&v, 0, sizeof(v));
        v.expr = pl_scan_expr;
        v.env = &sc;
        if (pf.loop.body) CcStmt_walk(pf.loop.body, v);
    }
    caps = sc.caps;
    n = caps.len();
    for (i = 0; i < n; i++) {
        PCap* c = *caps.get_ptr(i);
        c->by_addr = true;
    }
    if (st->fn_ret) {
        /* the cell a `return` lands in is typed by the function it leaves;
         * a `void` one still needs a cell C can declare */
        CCSlice rn = L->ix->canon(st->fn_ret);
        CCSlice vd = cstr_slice("void");
        if (rn.len && !slice_eq(rn, vd)) ret_ty = rn;
    }
    { CCString t = lw_spell_expr(L, pf.wait); wspell = lw_keep(L, &t); }
    if (pf.seq) { CCString t = lw_spell_expr(L, pf.seq); gspell = lw_keep(L, &t); }
    { CCString t = lw_spell_expr(L, rg.lo); los = lw_keep(L, &t); }
    { CCString t = lw_spell_expr(L, rg.hi); his = lw_keep(L, &t); }
    {
        CCString et = pl_pw_env_text(st, id, &caps, ret_ty);
        st->fwd.push_slice(et.as_slice(), L->arena);
    }
    pl_pw_forward(st, id);
    st->made.push(pl_pw_run_decl(st, id, &caps, pf.loop, sp));
    st->made.push(pl_pw_worker_decl(st, id, sp));
    {
        CCString a1 = @string(`${env} ${ev}`, L->arena);
        CCString a2 = @string(`${sht} ${shv}`, L->arena);
        CCString a3 = @string(`${ext} ${cell}`, L->arena);
        CCString a4 = @string(`${slt} ${s0}`, L->arena);
        CCString a5 = @string(`CCNurseryHost* ${nur} = 0`, L->arena);
        CCString a6 = @string(`CCChan* ${work} = 0`, L->arena);
        CCString a7 = @string(`${slt}* ${slots} = 0`, L->arena);
        CCString a8 = @string(`${agt}* ${args} = 0`, L->arena);
        CCString a9 = (gform == 1)
            ? @string(`CCTurnstile* ${gv} = &(${wspell})`, L->arena)
            : @string(`CCTurnstile* ${gv} = (${wspell})`, L->arena);
        pl_pw_text(L, blk, a1, sp);
        pl_pw_text(L, blk, a2, sp);
        pl_pw_text(L, blk, a3, sp);
        pl_pw_text(L, blk, a4, sp);
        pl_pw_text(L, blk, a5, sp);
        pl_pw_text(L, blk, a6, sp);
        pl_pw_text(L, blk, a7, sp);
        pl_pw_text(L, blk, a8, sp);
        pl_pw_text(L, blk, a9, sp);
    }
    {
        CCString b1 = @string(`CCError ${ferr}`, L->arena);
        CCString b2 = @string(`int ${fail} = 0`, L->arena);
        CCString b3 = @string(`int ${echo} = 0`, L->arena);
        CCString b4 = @string(`int ${best} = 0`, L->arena);
        CCString b5 = @string(`int ${wv} = 0`, L->arena);
        CCString b6 = @string(`int ${nw} = 1`, L->arena);
        CCString b7 = @string(`int ${nh} = 1`, L->arena);
        CCString b8 = @string(`int ${spawned} = 0`, L->arena);
        CCString b9 = @string(`int ${iv} = 0`, L->arena);
        CCString b10 = @string(`int ${eok} = 0`, L->arena);
        CCString b11 = @string(`int ${sf} = 0`, L->arena);
        pl_pw_text(L, blk, b1, sp);
        pl_pw_text(L, blk, b2, sp);
        pl_pw_text(L, blk, b3, sp);
        pl_pw_text(L, blk, b4, sp);
        pl_pw_text(L, blk, b5, sp);
        pl_pw_text(L, blk, b6, sp);
        pl_pw_text(L, blk, b7, sp);
        pl_pw_text(L, blk, b8, sp);
        pl_pw_text(L, blk, b9, sp);
        pl_pw_text(L, blk, b10, sp);
        pl_pw_text(L, blk, b11, sp);
    }
    {
        CCString z1 = @string(`cc__bytes_zero(&${ferr}, sizeof(${ferr}))`, L->arena);
        CCString z2 = @string(`cc__bytes_zero(&${cell}, sizeof(${cell}))`, L->arena);
        CCString z3 = @string(`cc__bytes_zero(&${s0}, sizeof(${s0}))`, L->arena);
        CCString z4 = @string(`cc__bytes_zero(&${ev}, sizeof(${ev}))`, L->arena);
        CCString z5 = @string(`cc__bytes_zero(&${shv}, sizeof(${shv}))`, L->arena);
        CCString z6 = @string(`if (${gv} && ${gv}->cap > 1) ${nw} = ${gv}->cap`, L->arena);
        pl_pw_text(L, blk, z1, sp);
        pl_pw_text(L, blk, z2, sp);
        pl_pw_text(L, blk, z3, sp);
        pl_pw_text(L, blk, z4, sp);
        pl_pw_text(L, blk, z5, sp);
        pl_pw_text(L, blk, z6, sp);
    }
    /* the gate is read once, here: a site it denies opens no pool at all and
     * the tickets go through the same body on the caller */
    if (gspell.len) {
        CCString c1 = @string(`if ((${gspell})) { __typeof__(cc_nursery_create()) __cc_pw_nr = cc_nursery_create(); if (__cc_pw_nr.ok) ${nur} = __cc_pw_nr.u.value.p; }`, L->arena);
        pl_pw_text(L, blk, c1, sp);
    } else {
        CCString c1 = @string(`{ __typeof__(cc_nursery_create()) __cc_pw_nr = cc_nursery_create(); if (__cc_pw_nr.ok) ${nur} = __cc_pw_nr.u.value.p; }`, L->arena);
        pl_pw_text(L, blk, c1, sp);
    }
    {
        /* an allocation that did not come back closes the pool again rather
         * than running half of one: the caller takes the tickets instead */
        CCString c2 = @string(`if (${nur}) { ${work} = cc_chan_create((size_t)${nw}); if (${work}) ${slots} = cc_nursery_closure_env_alloc_host(${nur}, (size_t)${nw} * sizeof(*${slots}), 16); if (${slots}) ${args} = cc_nursery_closure_env_alloc_host(${nur}, (size_t)${nw} * sizeof(*${args}), 16); }`, L->arena);
        CCString c3 = @string(`if (${nur} && (!${work} || !${slots} || !${args})) { if (${work}) cc_chan_free(${work}); ${work} = 0; ${slots} = 0; ${args} = 0; cc_nursery_free_host(${nur}); ${nur} = 0; }`, L->arena);
        pl_pw_text(L, blk, c2, sp);
        pl_pw_text(L, blk, c3, sp);
    }
    {
        /* the caller's own slot stands in for a runner's when there is no
         * pool, so the body is handed the same shape on either schedule */
        CCString f1 = @string(`${shv}.gate = ${gv}`, L->arena);
        CCString f2 = @string(`${shv}.nur = ${nur}`, L->arena);
        CCString f3 = @string(`${shv}.work = ${work}`, L->arena);
        CCString f4 = @string(`${shv}.dest = 0`, L->arena);
        CCString f5 = @string(`${ev}.sh = &${shv}`, L->arena);
        CCString f6 = @string(`${ev}.slots = ${slots} ? ${slots} : &${s0}`, L->arena);
        CCString f7 = @string(`${ev}.__cc_pf_ex = &${cell}`, L->arena);
        CCString f8 = @string(`${nh} = ${slots} ? ${nw} : 1`, L->arena);
        pl_pw_text(L, blk, f1, sp);
        pl_pw_text(L, blk, f2, sp);
        pl_pw_text(L, blk, f3, sp);
        pl_pw_text(L, blk, f4, sp);
        pl_pw_text(L, blk, f5, sp);
        pl_pw_text(L, blk, f6, sp);
        pl_pw_text(L, blk, f7, sp);
        pl_pw_text(L, blk, f8, sp);
    }
    for (i = 0; i < n; i++) {
        PCap* c = *caps.get_ptr(i);
        CCSlice cn = c->name;
        CCString as = pl_for_decayed(c->type)
            ? @string(`${ev}.${cn} = (${cn})`, L->arena)
            : @string(`${ev}.${cn} = &(${cn})`, L->arena);
        pl_pw_text(L, blk, as, sp);
    }
    {
        CCString g1 = @string(`if (${nur}) cc__bytes_zero(${slots}, (size_t)${nw} * sizeof(*${slots}))`, L->arena);
        CCString g2 = @string(`if (${nur}) for (${wv} = 0; ${wv} < ${nw}; ${wv}++) { ${args}[${wv}].work = ${work}; ${args}[${wv}].env = &${ev}; ${args}[${wv}].slot = ${wv}; if (cc_is_ok(cc_nursery_spawn_host(${nur}, ${worker}, &${args}[${wv}]))) ${spawned}++; }`, L->arena);
        pl_pw_text(L, blk, g1, sp);
        pl_pw_text(L, blk, g2, sp);
    }
    {
        /* the tickets, in order and under the gate. The ticket is held
         * before the body is reached on either schedule, and the body gives
         * it back; a ticket that was held but never reached gives it back
         * here. */
        CcStmt* lb = lw_block(L, sp);
        CCString k1 = @string(`if (cc_nursery_is_cancelled_host(${nur})) break`, L->arena);
        CCString k2 = @string(`if (cc_atomic_load(&${cell}.xk)) break`, L->arena);
        CCString k3 = @string(`if (!${spawned} && ${ev}.slots[0].failed) break`, L->arena);
        CCString k4 = @string(`{ __typeof__(cc_turnstile_enter(${gv}, ${iv})) __cc_pw_r = cc_turnstile_enter(${gv}, ${iv}); ${eok} = __cc_pw_r.ok; if (!__cc_pw_r.ok) ${ferr} = __cc_pw_r.u.error.base; }`, L->arena);
        CCString k5 = @string(`if (!${eok}) { ${fail} = 1; ${best} = ${iv}; break; }`, L->arena);
        CCString k6 = @string(`${sf} = 0`, L->arena);
        CCString k7 = @string(`if (${spawned} && cc_chan_send(${work}, &${iv}, sizeof(${iv})) != 0) ${sf} = 1`, L->arena);
        CCString k8 = @string(`if (!${spawned}) ${run}(&${ev}, ${iv}, 0)`, L->arena);
        CCString k9 = @string(`if (${sf}) { (void)cc_turnstile_leave(${gv}); ${ferr} = CC_ERROR(CC_ERR_IO, "parallel wait send"); ${fail} = 1; ${best} = ${iv}; break; }`, L->arena);
        CCString ki = @string(`${iv} = (int)(${los})`, L->arena);
        CCString kc = @string(`${iv} < (int)(${his})`, L->arena);
        CCString ks = @string(`${iv}++`, L->arena);
        pl_pw_text(L, lb, k1, sp);
        pl_pw_text(L, lb, k2, sp);
        pl_pw_text(L, lb, k3, sp);
        pl_pw_text(L, lb, k4, sp);
        pl_pw_text(L, lb, k5, sp);
        pl_pw_text(L, lb, k6, sp);
        pl_pw_text(L, lb, k7, sp);
        pl_pw_text(L, lb, k8, sp);
        pl_pw_text(L, lb, k9, sp);
        lw_push(blk, pl_pw_for(L, ki, kc, ks, lb, sp));
    }
    {
        CCString h1 = @string(`if (${work}) cc_chan_close(${work})`, L->arena);
        CCString h2 = @string(`if (${nur}) (void)cc_nursery_wait_host(${nur})`, L->arena);
        pl_pw_text(L, blk, h1, sp);
        pl_pw_text(L, blk, h2, sp);
    }
    {
        /* which ticket error re-raises: the earliest one that is not just an
         * echo of the cancel the first error asked for */
        CcStmt* hb = lw_block(L, sp);
        CCString p1 = @string(`${slt}* __cc_pw_it = &${ev}.slots[${wv}]; int __cc_pw_ec = __cc_pw_it->failed && (__cc_pw_it->err.kind == CC_ERR_CANCELLED)`, L->arena);
        CCString p2 = @string(`if (__cc_pw_it->failed && (!${fail} || (!__cc_pw_ec && ${echo}) || (__cc_pw_ec == ${echo} && __cc_pw_it->i < ${best}))) { ${ferr} = __cc_pw_it->err; ${fail} = 1; ${best} = __cc_pw_it->i; ${echo} = __cc_pw_ec; }`, L->arena);
        CCString hi = @string(`${wv} = 0`, L->arena);
        CCString hc = @string(`${wv} < ${nh}`, L->arena);
        CCString hs = @string(`${wv}++`, L->arena);
        pl_pw_text(L, hb, p1, sp);
        pl_pw_text(L, hb, p2, sp);
        lw_push(blk, pl_pw_for(L, hi, hc, hs, hb, sp));
    }
    {
        CCString r1 = @string(`if (${work}) cc_chan_free(${work})`, L->arena);
        CCString r2 = @string(`if (${nur}) cc_nursery_free_host(${nur})`, L->arena);
        pl_pw_text(L, blk, r1, sp);
        pl_pw_text(L, blk, r2, sp);
    }
    {
        /* the `!>` the site was written with: the error the pool left is the
         * enclosing handler's, raised where the walk stood */
        CcStmt* then = lw_block(L, sp);
        CcStmt* fw = cc__stmt_blank(sp, L->arena);
        CcErrFwd fe;
        CCString cnd = @string(`${fail}`, L->arena);
        fe.err = lw_paren(L, lw_ident(L, ferr, sp), sp);
        { CcStmtK sk = { .err_fwd = fe }; fw->k = sk; }
        lw_push(then, fw);
        lw_push(blk, lw_if(L, lw_text(L, cnd, sp), then, NULL, sp));
    }
    {
        /* a `return` inside the body is the caller's to make */
        CcStmt* then = lw_block(L, sp);
        CCString rv = @string(`${cell}.rv`, L->arena);
        CCString cnd = @string(`cc_atomic_load(&${cell}.xk) == 2`, L->arena);
        lw_push(then, cc_stmt_return(lw_text(L, rv, sp), sp, L->arena));
        lw_push(blk, lw_if(L, lw_text(L, cnd, sp), then, NULL, sp));
    }
    s->k = blk->k;
    st->any = true;
}

/* A `@stage` of the walk's own body: it sequences the tickets, which is not
 * this shape. */
static bool pl_pw_has_stage(CcStmt* body) {
    CcStmtList* bs = lw_block_stmts(body);
    size_t n;
    size_t i;
    if (!bs) return false;
    n = bs->len();
    for (i = 0; i < n; i++) {
        CcStmt* k = *bs->get_ptr(i);
        bool is_stage = false;
        @switch (k->k) {
            case .stage: is_stage = true; break;
            default: break;
        }
        if (is_stage) return true;
    }
    return false;
}

/* `} !>` after the body: the tail that says a ticket error leaves the site.
 * A join that keeps its Result says something else, and the site has nowhere
 * to put the error it collected. */
static bool pl_pw_tail_raises(CcExpr* tail) {
    bool raises = false;
    if (!tail) return false;
    @switch (tail->k) {
        case .unwrap: raises = true; break;
        default: break;
    }
    return raises;
}

/* A `break` that belongs to the walk itself, not to a loop the body opened.
 * It makes the site's join answer a question -- did every ticket run? -- and
 * that answer is the bound form (`bool fin = ${"@"}parallel ... !>.wait()!>`),
 * which this step does not lower. Discarding it is what
 * `parallel_wait_result_discard_fail` is about, so the walk with the `break`
 * is refused rather than the discard alone. */
static bool pl_pw_break_at(CcStmt* s, int depth) {
    CcStmtList* bs;
    size_t n;
    size_t i;
    int inner = depth;
    bool opens = false;
    bool is_break = false;
    CcStmt* a = NULL;
    CcStmt* b = NULL;
    if (!s) return false;
    @switch (s->k) {
        case .break_: is_break = true; break;
        case .for_(x): opens = true; a = x.body; break;
        case .while_(x): opens = true; a = x.body; break;
        case .do_(x): opens = true; a = x.body; break;
        case .switch_(x): opens = true; a = x.body; break;
        case .if_(x): a = x.then; b = x.els; break;
        case .label(x): a = x.inner; break;
        default: break;
    }
    if (is_break) return depth == 0;
    if (opens) inner = depth + 1;
    bs = lw_block_stmts(s);
    if (bs) {
        n = bs->len();
        for (i = 0; i < n; i++) {
            CcStmt* k = *bs->get_ptr(i);
            if (pl_pw_break_at(k, inner)) return true;
        }
        return false;
    }
    if (a && pl_pw_break_at(a, inner)) return true;
    if (b && pl_pw_break_at(b, inner)) return true;
    return false;
}

/* A `goto` anywhere in a walked body. The body becomes a function of its own,
 * so a label the site can see is one the body cannot jump to; C would say so
 * at a line that reads as the walk's, which is not where the jump is. */
static bool pl_pw_goto_visit(CcStmt* s, void* env) {
    bool* hit = (bool*)env;
    @switch (s->k) {
        case .goto_: *hit = true; break;
        default: break;
    }
    return true;
}

static bool pl_pw_has_goto(CcStmt* body) {
    CcVisitor v;
    bool hit = false;
    if (!body) return false;
    memset(&v, 0, sizeof(v));
    v.stmt = pl_pw_goto_visit;
    v.env = &hit;
    CcStmt_walk(body, v);
    return hit;
}

/* `@parallel [seq (c)] [wait (ts)] for (i in lo..hi) [worker (w)] [cache (…)]`.
 *
 * None of it is lowered yet, but the shape is checked here rather than left
 * to the host: a walk left standing keeps its `!>` tail, and the tail's
 * left operand is the identifier `@parallel`, which the Result step reads
 * as a plain name and reports as needing a Result -- twice, at a line that
 * says nothing about what is wrong. So every path out of this function
 * replaces the statement with an empty block, which takes the tail with it. */
static void pl_for(PStep* st, CcStmt* s, CcParallelFor pf) {
    CcLowerer* L = st->L;
    CcSpan sp = s->span;
    CCString m;
    CcStmt* gone = lw_block(L, sp);
    if (pf.spawn) {
        m = @string(`'${"@"}parallel spawn': do not combine with for or wait`, L->arena);
        lw_error(L, sp, m);
        s->k = gone->k;
        return;
    }
    if (pf.seq && !pf.wait) {
        m = cc_string_new();
        cc_string_push_cstr(&m, "@parallel seq (...) with 'for' requires 'wait (gate)'", L->arena);
        lw_error(L, sp, m);
        s->k = gone->k;
        return;
    }
    if (pf.cache.len() && !pf.wait) {
        m = @string(`cache (name) requires the wait (gate) form`, L->arena);
        lw_error(L, sp, m);
        s->k = gone->k;
        return;
    }
    /* the walk's own `@stage`s are its own: a stage anywhere else is stray,
     * and saying so is this step's job even before the walk itself lowers */
    if (pf.wait && pf.loop.body) {
        CcStmtList* bs = lw_block_stmts(pf.loop.body);
        if (bs) {
            size_t n = bs->len();
            size_t i;
            for (i = 0; i < n; i++) {
                CcStmt* k = *bs->get_ptr(i);
                bool is_stage = false;
                @switch (k->k) {
                    case .stage: is_stage = true; break;
                    default: break;
                }
                if (is_stage) st->stages.push(k);
            }
        }
    }
    /* the body goes with the statement below, so anything in it this step
     * would have reported has to be reported before it does */
    if (pf.loop.body) pl_stray_stages(st, pf.loop.body);
    if (!pf.wait) {
        CcRange rg;
        CcExprList* itv = &pf.loop.iterables;
        bool ranged = itv->len() == 1 && fi_is_range(*itv->get_ptr(0), &rg);
        if (!ranged || pf.loop.bind2.len || pf.loop.by_ref) {
            m = cc_string_new();
            cc_string_push_cstr(&m, "@parallel for walks a range: write 'for (name in lo..hi)'", L->arena);
            lw_error(L, sp, m);
            s->k = gone->k;
            return;
        }
        pl_for_lower(st, s, pf, rg);
        return;
    }
    if (pf.pred) {
        m = @string(`a gated '${"@"}parallel wait (...) for' spells its gate 'seq (...)': the predicate form is not lowered by the clean lowerer yet`, L->arena);
        lw_error(L, sp, m);
        s->k = gone->k;
        return;
    }
    if (pf.worker.len) {
        m = @string(`'${"@"}parallel wait (...) for' with 'worker' is not lowered by the clean lowerer yet`, L->arena);
        lw_error(L, sp, m);
        s->k = gone->k;
        return;
    }
    if (pf.cache.len()) {
        m = @string(`'${"@"}parallel wait (...) for' with 'cache' is not lowered by the clean lowerer yet`, L->arena);
        lw_error(L, sp, m);
        s->k = gone->k;
        return;
    }
    if (pf.bind.len || pf.target) {
        m = @string(`'${"@"}parallel wait (...) for' that also binds a handle is not lowered by the clean lowerer yet: the pool joins before the brace ends`, L->arena);
        lw_error(L, sp, m);
        s->k = gone->k;
        return;
    }
    if (!pl_pw_gate_form(st->w, pf.wait)) {
        m = @string(`'${"@"}parallel wait (...)' caps on a 'CCTurnstile': the gate here is something else`, L->arena);
        lw_error(L, sp, m);
        s->k = gone->k;
        return;
    }
    if (pf.loop.body && pl_pw_break_at(pf.loop.body, 0)) {
        m = @string(`a 'break' out of a '${"@"}parallel wait (...) for' body is not lowered by the clean lowerer yet: the walk it leaves unfinished is the bound form's answer`, L->arena);
        lw_error(L, sp, m);
        s->k = gone->k;
        return;
    }
    if (pl_pw_has_goto(pf.loop.body)) {
        m = @string(`a 'goto' out of a '${"@"}parallel wait (...) for' body is not lowered by the clean lowerer yet: the body becomes a function of its own and the label stays the caller's`, L->arena);
        lw_error(L, sp, m);
        s->k = gone->k;
        return;
    }
    if (pl_pw_has_stage(pf.loop.body)) {
        m = cc_string_new();
        cc_string_push_cstr(&m, "@stage in a '@parallel wait for' body is not lowered by the clean lowerer yet", L->arena);
        lw_error(L, sp, m);
        s->k = gone->k;
        return;
    }
    if (!pl_pw_tail_raises(pf.tail)) {
        /* Assembled rather than templated: the message carries an `@` and a
         * `!>`, and a template reads the first as a sigil. */
        m = cc_string_new();
        cc_string_push_cstr(&m, "@parallel wait (gate) for needs its '!>.wait()!>' tail: a ticket error has nowhere else to go", L->arena);
        lw_error(L, sp, m);
        s->k = gone->k;
        return;
    }
    {
        CcRange rg;
        CcExprList* itv = &pf.loop.iterables;
        bool ranged = itv->len() == 1 && fi_is_range(*itv->get_ptr(0), &rg);
        if (!ranged || pf.loop.bind2.len || pf.loop.by_ref) {
            m = cc_string_new();
            cc_string_push_cstr(&m, "@parallel wait (gate) for walks a range: write 'for (name in lo..hi)'", L->arena);
            lw_error(L, sp, m);
            s->k = gone->k;
            return;
        }
        pl_pw_lower(st, s, pf, rg);
    }
}

/* The walk records a `return` into a cell typed by the function it leaves. */
static void pl_on_decl(Walker* w, CcDecl* d) {
    PStep* st = (PStep*)w->env;
    CcFuncDecl f;
    bool is_fn = false;
    st->fn_ret = NULL;
    @switch (d->k) {
        case .func(x): f = x; is_fn = true; break;
        default: break;
    }
    if (!is_fn || !f.type) return;
    @switch (f.type->k) {
        case .func(ft): st->fn_ret = ft.ret; break;
        default: break;
    }
}

static void pl_on_stmt(Walker* w, CcStmt* s, bool enter) {
    PStep* st = (PStep*)w->env;
    CcParallel p;
    CcParallelDest pd;
    CcParallelFor pf;
    int shape = 0;              /* 1 arms, 2 dest, 3 for, 4 stage */
    if (!enter) return;
    @switch (s->k) {
        case .parallel(x): p = x; shape = 1; break;
        case .parallel_dest(x): pd = x; shape = 2; break;
        case .parallel_for(x): pf = x; shape = 3; break;
        case .stage: shape = 4; break;
        default: break;
    }
    if (shape == 1) pl_lower(st, s, p);
    else if (shape == 2) pl_dest(st, s, pd);
    else if (shape == 3) pl_for(st, s, pf);
    else if (shape == 4 && !pl_stage_owned(st, s)) {
        CCString m = cc_string_new();
        cc_string_push_cstr(&m, "@stage must be a top-level statement of a '@parallel wait for' body", st->L->arena);
        lw_error(st->L, s->span, m);
    }
}

/* The handle a bound site fills is the caller's, so its declaration goes
 * before the block, in the list the block sits in. */
static PBind* pl_bind_at(PStep* st, CcStmt* s) {
    PBindList* v = &st->binds;
    size_t n = v->len();
    size_t i;
    for (i = 0; i < n; i++) {
        PBind* b = *v->get_ptr(i);
        if (b->at == s) return b;
    }
    return NULL;
}

static void pl_declare_binds(PStep* st, CcStmtList* list);

static void pl_declare_in(PStep* st, CcStmt* s) {
    StmtView v;
    if (!s) return;
    view_stmt(&v, s);
    if (v.is_block || (v.has_stmts && v.stmts.len())) {
        CcStmtList inner = v.stmts;
        pl_declare_binds(st, &inner);
        @switch (s->k) {
            case .block(b): b.stmts = inner; s->k = { .block = b }; break;
            default: break;
        }
    }
    pl_declare_in(st, v.body);
    pl_declare_in(st, v.else_body);
}

static void pl_declare_binds(PStep* st, CcStmtList* list) {
    CcLowerer* L = st->L;
    CcStmtList out = vec_new::[CcStmtRef](L->arena);
    size_t n = list->len();
    size_t i;
    for (i = 0; i < n; i++) {
        CcStmt* s = *list->get_ptr(i);
        PBind* b = pl_bind_at(st, s);
        if (b) out.push(lw_decl_stmt(L, b->type, b->name, NULL, s->span));
        pl_declare_in(st, s);
        out.push(s);
    }
    *list = out;
}

static void CcLowerer_parallel(CcLowerer* L) {
    Walker w;
    PStep st;
    memset(&st, 0, sizeof(st));
    st.L = L;
    st.w = &w;
    st.made = vec_new::[CcDeclRef](L->arena);
    st.fwd = cc_string_new();
    st.binds = vec_new::[PBindRef](L->arena);
    st.stages = vec_new::[CcStmtRef](L->arena);
    memset(&w, 0, sizeof(w));
    w.arena = L->arena;
    w.ix = L->ix;
    w.unit = L->unit;
    w.on_decl = pl_on_decl;
    w.on_stmt = pl_on_stmt;
    w.env = &st;
    tw_unit(&w);
    if (!st.any) return;
    if (st.binds.len()) {
        CcDeclList* dv = &L->unit->decls;
        size_t nd0 = dv->len();
        size_t j;
        for (j = 0; j < nd0; j++) {
            CcDecl* d0 = *dv->get_ptr(j);
            CcFuncDecl f0;
            bool is_fn = false;
            @switch (d0->k) {
                case .func(x): f0 = x; is_fn = true; break;
                default: break;
            }
            if (is_fn && f0.body) pl_declare_in(&st, f0.body);
        }
    }
    {
        CcDeclList* decls = &L->unit->decls;
        CcDeclList with = vec_new::[CcDeclRef](L->arena);
        size_t nd = decls->len();
        size_t at = 0;
        size_t k;
        CcSpan sp;
        sp.first = 0;
        sp.last = 0;
        for (k = 0; k < nd; k++) {
            CcDecl* dd = *decls->get_ptr(k);
            bool is_pp = false;
            @switch (dd->k) {
                case .pp: is_pp = true; break;
                case .empty: is_pp = true; break;
                case .pragma_cc: is_pp = true; break;
                case .raw: is_pp = true; break;
                default: break;
            }
            if (!is_pp) break;
            at = k + 1;
        }
        {
            CCString head = cc_string_new();
            head.push_cstr("/* --- CC parallel declarations --- */\n", L->arena);
            head.push_slice(cc_string_as_slice(&st.fwd), L->arena);
            head.push_cstr("/* --- end parallel declarations --- */", L->arena);
            for (k = 0; k < nd; k++) {
                CcDecl* dk = *decls->get_ptr(k);
                if (k == at) with.push(lw_raw_decl(L, head, sp));
                with.push(dk);
            }
            if (at >= nd) with.push(lw_raw_decl(L, head, sp));
        }
        {
            CcDeclList* madev = &st.made;
            size_t nm2 = madev->len();
            with.push(lw_raw_decl(L, @string(`/* --- CC parallel arms --- */`, L->arena), sp));
            for (k = 0; k < nm2; k++) {
                CcDecl* md = *madev->get_ptr(k);
                with.push(md);
            }
        }
        *decls = with;
    }
}

#endif

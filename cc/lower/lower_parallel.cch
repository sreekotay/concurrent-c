#pragma(@per_tu)
/* Clean lowerer, step: `@parallel`. The arms of
 * `@parallel { a = f(); b = g(); }` may run at the same time: the first
 * stays on the caller, and each of the others becomes a thunk the runtime
 * may put on another fiber. The block joins before it ends, so every arm
 * has finished by the statement after it — a lexical fork and join, not a
 * nursery that outlives the scope.
 *
 * An arm reaches the locals it names through their addresses, because the
 * caller's frame is still live while the arm runs and the arm is meant to
 * see what the caller sees. The assignment target is one of those
 * addresses.
 *
 * The runtime may refuse to spawn (`cc_parallel_deny_fast`), and a spawn
 * may fail. Both fall back to running the thunk inline, so the arms run
 * either way and the difference is only whether they overlapped.
 *
 * `spawn` is the same block with one promise added: every arm but the
 * first is running while the block is, so the runtime may not deny one and
 * run it on the caller instead — a rendezvous written across two arms would
 * be waiting on itself. A site that asks for it and does not get it dies
 * rather than running.
 *
 * What the form can still carry and this step does not lower — a predicate,
 * `cache`, and the dest forms — is a diagnostic naming it. A concurrency
 * construct that quietly ran as something else would be a program that
 * behaves differently for reasons the page does not show.
 * Lifetime: the lowerer arena. */
#ifndef CC_LOWER_PARALLEL_CCH
#define CC_LOWER_PARALLEL_CCH
#include "lower.cch"
#include "typing.cch"

typedef struct PCap {
    CCSlice name;
    CcType* type;
    bool by_addr;               /* the handle the site binds: always the caller's own */
} PCap;
typedef PCap* PCapRef;
typedef Vec::[PCapRef] PCapList;

/* A site that binds a handle: the handle outlives the block, so its
 * declaration goes before it, in the list the block sits in. */
typedef struct PBind {
    CcStmt* at;
    CCSlice name;
    CcType* type;
    bool destroy;               /* `!> @destroy` on the bind: the hook goes on the declaration,
                                 * and the cleanup step arms it after the block that fills it */
    CcStmt* destroy_body;
} PBind;
typedef PBind* PBindRef;
typedef Vec::[PBindRef] PBindList;

typedef struct PStep {
    CcLowerer* L;
    Walker* w;
    uint32_t next_id;
    CcDeclList made;            /* the thunks, in order */
    CcDeclList protos;          /* prototypes the frame calls before the thunks are declared:
                                 * the drop of a cached name, whose Result type the later
                                 * steps spell */
    CCString fwd;               /* their forward declarations */
    PBindList binds;            /* sites whose handle is declared before the block */
    CcStmtList stages;          /* `@stage` statements a `@parallel wait for` claimed */
    CcDecl* at_decl;            /* the unit declaration the walk is inside */
    CcDecl* first_host;         /* the first one that needed a forward declaration */
    CcType* fn_ret;             /* the enclosing function's return type: a walk records
                                 * a `return` into a cell of it */
    CcStmtList eh_top;          /* the `@errhandler`s the enclosing function carries, in order:
                                 * a bare `!>` in an arm raises into one of them after the
                                 * join, and the exit cell is typed by what they take */
    bool eh_any;
    int dest_depth;             /* how many dest bodies the walk is inside: the arms of a bound
                                 * construct and the body of an attach, lowered before they move */
    size_t eh_in_scope;         /* the `@errhandler`s in scope at the statement the walk is on:
                                 * every one declared above it in a block still open */
    Vec::[size_t] eh_marks;     /* `eh_in_scope` as it was on entering each open statement */
    bool any;
    /* `#pragma(@parallel) off` regions, as token spans: off_from[i] ..
     * off_to[i]. A site inside one is inert -- its arms and its iterations
     * run in source order on the caller frame. */
    Vec::[uint32_t] off_from;
    Vec::[uint32_t] off_to;
} PStep;

/* ---- `#pragma(@parallel) off` ------------------------------------------- */

/* `#pragma(@parallel) off` / `... on`, as the preprocessor token spells it.
 * `bad` is set when the token is this pragma with some other operand: the
 * spec allows exactly the two, and a scan that skipped a third would leave
 * the block parallel for a user who wrote the pragma to make it not so. */
static bool pl_pragma_par(CCSlice text, bool* is_off, bool* is_on, bool* bad) {
    const char* p = text.ptr;
    size_t n = text.len;
    size_t i = 0;
    size_t k;
    static const char* head = "#pragma(@parallel)";
    size_t hn = 18;
    while (i < n && (p[i] == ' ' || p[i] == '\t')) i++;
    if (n - i < hn) return false;
    for (k = 0; k < hn; k++)
        if (p[i + k] != head[k]) return false;
    i += hn;
    while (i < n && (p[i] == ' ' || p[i] == '\t')) i++;
    if (n - i >= 3 && p[i] == 'o' && p[i + 1] == 'f' && p[i + 2] == 'f') { *is_off = true; return true; }
    if (n - i >= 2 && p[i] == 'o' && p[i + 1] == 'n') { *is_on = true; return true; }
    *bad = true;
    return false;
}

/* The `#pragma(@parallel) off` regions of the unit, read off the token tape.
 * The pragma is one preprocessor token whether it stands at file scope or
 * between two statements, so one scan covers both placements and the
 * question a site asks is the same either way: was the toggle nearest above
 * me `off`? A region runs to the matching `on`, or to the end of the file. */
static void pl_read_par_off(PStep* st) {
    CcUnit* u = st->L->unit;
    CcTape* tp = &u->tape;
    Vec::[CcToken]* toks = &tp->toks;
    size_t n = toks->len();
    size_t i;
    bool off = false;
    for (i = 0; i < n; i++) {
        const CcToken* t = toks->get_ptr(i);
        CCSlice tx = t->text;
        bool is_off = false;
        bool is_on = false;
        bool bad = false;
        if (t->kind != CC_TK_PP) continue;
        if (!pl_pragma_par(tx, &is_off, &is_on, &bad)) {
            if (bad) {
                CcSpan sp;
                CCString msg = @string(`#pragma(${"@"}parallel) takes 'off' or 'on'`, st->L->arena);
                sp.first = (uint32_t)i;
                sp.last = (uint32_t)i;
                lw_error(st->L, sp, msg);
            }
            continue;
        }
        if (is_off && !off) {
            Vec::[uint32_t]* fv = &st->off_from;
            off = true;
            fv->push((uint32_t)i);
        } else if (is_on && off) {
            Vec::[uint32_t]* tv = &st->off_to;
            off = false;
            tv->push((uint32_t)i);
        }
    }
    if (off) {
        Vec::[uint32_t]* tv = &st->off_to;
        tv->push((uint32_t)(n ? n - 1 : 0));
    }
}

static bool pl_par_off_at(PStep* st, uint32_t tok) {
    Vec::[uint32_t]* fv = &st->off_from;
    Vec::[uint32_t]* tv = &st->off_to;
    size_t n = fv->len();
    size_t i;
    if (tv->len() < n) n = tv->len();
    for (i = 0; i < n; i++) {
        uint32_t a = *fv->get_ptr(i);
        uint32_t b = *tv->get_ptr(i);
        if (tok >= a && tok <= b) return true;
    }
    return false;
}

static CCSlice pl_name(CcLowerer* L, uint32_t id, uint32_t k, const char* suffix) {
    CCString s = @string(`__cc_par_${id}_${k}${suffix}`, L->arena);
    return lw_keep(L, &s);
}

static CCSlice pl_join_type(CcLowerer* L, uint32_t id) {
    CCString s = @string(`__cc_pj_${id}_t`, L->arena);
    return lw_keep(L, &s);
}

/* ---- captures ----------------------------------------------------------- */

/* The local a gated site tests once: true when the arms run in order. */
static CCSlice pl_gate_name(CcLowerer* L, uint32_t id) {
    CCString g = @string(`__cc_par_${id}_seq`, L->arena);
    return lw_keep(L, &g);
}

typedef struct PScan {
    PStep* st;
    Walker* w;
    PCapList caps;
    CcNameList seen;
    CCSlice skip;               /* the assignment target: carried separately */
} PScan;

static bool pl_seen(PScan* sc, CCSlice name) {
    CcNameList* v = &sc->seen;
    size_t n = v->len();
    size_t i;
    for (i = 0; i < n; i++) {
        CCSlice s = *v->get_ptr(i);
        if (slice_eq(s, name)) return true;
    }
    return false;
}

static bool pl_scan_expr(CcExpr* e, void* env) {
    PScan* sc = (PScan*)env;
    CCSlice nm;
    CcType* t;
    @switch (e->k) {
        case .ident(x): nm = x; break;
        default: return true;
    }
    if (!nm.len || pl_seen(sc, nm)) return true;
    if (sc->skip.len && slice_eq(nm, sc->skip)) return true;
    t = sc_lookup(sc->w, nm);
    if (!t) return true;                    /* not a local: a function, an enumerator */
    {
        PCap* c = cc_arena_alloc(sc->st->L->arena, sizeof(PCap), _Alignof(PCap));
        memset(c, 0, sizeof(*c));
        c->name = nm;
        c->type = t;
        sc->caps.push(c);
        sc->seen.push(nm);
    }
    return true;
}

/* Every use of `name` read through `through` instead. */
typedef struct PRef {
    CCArena arena; CCSlice name; CCSlice through; } PRef;

/* The captured name, read through the pointer the environment carries.
 *
 * A deref node, not the text `(*p)`: an identifier whose spelling happens
 * to be that text is one the typing walk cannot look up, so a UFCS call on
 * the captured name would lose its receiver's type. The node types from
 * the pointer's own declaration. */
static bool pl_ref_expr(CcExpr* e, void* env) {
    PRef* r = (PRef*)env;
    CCSlice nm;
    @switch (e->k) {
        case .ident(x): nm = x; break;
        default: return true;
    }
    if (!slice_eq(nm, r->name)) return true;
    {
        CcExpr* p = cc_expr_ident(r->through, e->span, r->arena);
        CcExpr* deref = cc_expr_unary(CC_OP_DEREF, p, e->span, r->arena);
        CcUnary pr;
        pr.op = CC_OP_NONE;
        pr.a = deref;
        e->k = { .paren = pr };
    }
    return true;
}

static void pl_rewrite(CcLowerer* L, CcExpr* e, CcStmt* s, CCSlice name, CCSlice through) {
    CcVisitor v;
    PRef r;
    r.arena = L->arena;
    r.name = name;
    r.through = through;
    memset(&v, 0, sizeof(v));
    v.expr = pl_ref_expr;
    v.env = &r;
    if (e) CcExpr_walk(e, v);
    if (s) CcStmt_walk(s, v);
}

/* What a site asks of an arm, and the name that answered. Which of these
 * captures does the arm declare again, which one does it write a copy of,
 * does it wait on the handle the site is filling: the questions differ in
 * what they hand in, never in what an answer looks like. */
typedef struct PAsk {
    PCapList* caps;             /* the captures asked about, or NULL */
    CCSlice want;               /* the one name asked about, or empty */
    CCSlice hit;                /* the name that answered */
} PAsk;

static bool pl_shadow_stmt(CcStmt* s, void* env) {
    PAsk* sh = (PAsk*)env;
    CcDecl* d = NULL;
    if (sh->hit.len) return true;
    if (!stmt_is_decl(s, &d) || !d) return true;
    @switch (d->k) {
        case .var(v): {
            PCapList* cv = sh->caps;
            size_t n = cv->len();
            size_t i;
            for (i = 0; i < n; i++) {
                PCap* c = *cv->get_ptr(i);
                if (slice_eq(c->name, v.name)) { sh->hit = v.name; return true; }
            }
            break;
        }
        default: break;
    }
    return true;
}

/* The block inside `@serial { ... }`, as an ordinary block: the arm is
 * where the ordering is decided, so the marker itself has nothing left to
 * say to C. */
static CcStmt* pl_serial_body(CcLowerer* L, CcStmt* s) {
    CcStmt* blk;
    CcBlock b;
    bool hit = false;
    if (!s) return NULL;
    @switch (s->k) {
        case .serial(x): b = x; hit = true; break;
        default: break;
    }
    if (!hit) return s;
    blk = cc__stmt_blank(s->span, L->arena);
    blk->k = { .block = b };
    return blk;
}

/* ---- the generated C ---------------------------------------------------- */

/* The environment one arm carries: a pointer per name it reads, and the
 * one it writes. */
static CCString pl_env_text(PStep* st, uint32_t id, uint32_t k, PCapList* caps, CCSlice out_type,
                            bool snapshot, CCSlice join_ty) {
    CcLowerer* L = st->L;
    CCArena a = L->arena;
    CCString sb = cc_string_new();
    CCSlice env = pl_name(L, id, k, "_env_t");
    size_t n = caps->len();
    size_t i;
    sb.push_cstr("typedef struct {\n", a);
    for (i = 0; i < n; i++) {
        PCap* c = *caps->get_ptr(i);
        CCSlice tn = L->ix->canon(c->type);
        sb.push_cstr("    ", a);
        sb.push_slice(tn, a);
        sb.push_cstr((snapshot && !c->by_addr) ? " " : "* ", a);
        sb.push_slice(c->name, a);
        sb.push_cstr(";\n", a);
    }
    if (out_type.len) {
        sb.push_cstr("    ", a);
        sb.push_slice(out_type, a);
        sb.push_cstr("* __cc_out;\n", a);
    }
    if (join_ty.len) {
        sb.push_cstr("    ", a);
        sb.push_slice(join_ty, a);
        sb.push_cstr("* __cc_pj_ex;\n", a);
    }
    sb.push_cstr("    CCParallel* __cc_par_h;\n", a);
    sb.push_cstr("} ", a);
    sb.push_slice(env, a);
    sb.push_cstr(";\n", a);
    return sb;
}

/* `static void* <thunk>(void*);` and the site slot the runtime keys its
 * deny decision on. */
/* The declaration a forward block has to stand above: an env struct names
 * the types the body captured, and those are as often as not typedefs of
 * this unit. Above the first declaration that needed one, every type it
 * reads is declared -- and nothing before it calls a thunk. */
static void pl_host(PStep* st) {
    if (!st->first_host) st->first_host = st->at_decl;
}

static void pl_forward(PStep* st, uint32_t id, uint32_t k) {
    CcLowerer* L = st->L;
    CCArena a = L->arena;
    CCString* sb = &st->fwd;
    pl_host(st);
    sb->push_cstr("static void* ", a);
    sb->push_slice(pl_name(L, id, k, "_thunk"), a);
    sb->push_cstr("(void*);\nstatic void* ", a);
    sb->push_slice(pl_name(L, id, k, "_site"), a);
    sb->push_cstr(";\n", a);
}

/* `(*__e->__cc_out)`: where an arm's one outer name lives on the caller. */
static CcExpr* pl_out_slot(CcLowerer* L, CcSpan sp) {
    CcExpr* read = cc_expr_member(lw_ident(L, cstr_slice("__e"), sp), cstr_slice("__cc_out"), true, sp, L->arena);
    return cc_expr_unary(CC_OP_DEREF, lw_paren(L, read, sp), sp, L->arena);
}

/* An exit a body converts, and where it goes instead.
 *
 * `leave`: the label a converted exit jumps to instead of returning outright,
 * for a body that has something to run on the way out -- a walked ticket gives
 * its place back. Empty when returning is the whole of leaving.
 * `cancel`: a body whose exit ends the whole walk, not just this half --
 * a ticket that returns leaves the tickets behind it nothing to finish, and
 * the pool is what carries that. A split walk has no pool and sets it false.
 * `cell`: what the exit is recorded in, spelled as the body reaches it --
 * empty when the body has nothing to record and leaving is all of it. */
typedef struct PForExit {
    CcLowerer* L;
    uint32_t id;
    bool has_ret;
    bool cancel;
    CCSlice leave;
    CCSlice cell;
} PForExit;

/* The names the block's own exit goes by. */
static CCSlice pl_pj_name(CcLowerer* L, uint32_t id, const char* suffix) {
    CCString s = @string(`__cc_pj_${id}${suffix}`, L->arena);
    return lw_keep(L, &s);
}

/* A `return` inside a closure the arm holds leaves that closure, not the
 * arm: the walk stops at one rather than claiming its exit. */
static bool pl_arm_closure_stop(CcExpr* e, void* env) {
    bool is_closure = false;
    (void)env;
    @switch (e->k) {
        case .closure: is_closure = true; break;
        default: break;
    }
    return !is_closure;
}

static bool pl_ret_any_stmt(CcStmt* s, void* env) {
    CcStmt** at = (CcStmt**)env;
    @switch (s->k) {
        case .return_: if (!*at) *at = s; break;
        default: break;
    }
    return true;
}

/* A dest body is a fiber: it has no frame to hand a value to. */
static bool pl_dest_ret_stmt(CcStmt* s, void* env) {
    CcStmt** at = (CcStmt**)env;
    @switch (s->k) {
        case .return_(r): if (r.value && !*at) *at = s; break;
        default: break;
    }
    return true;
}

/* The first `return` an arm makes, or the first that hands a value back. */
static CcStmt* pl_arm_first_return(CcExpr* e, CcStmt* s, bool valued) {
    CcVisitor v;
    CcStmt* at = NULL;
    memset(&v, 0, sizeof(v));
    if (valued) v.stmt = pl_dest_ret_stmt;
    else v.stmt = pl_ret_any_stmt;
    v.expr = pl_arm_closure_stop;
    v.env = &at;
    if (e) CcExpr_walk(e, v);
    if (s) CcStmt_walk(s, v);
    return at;
}

/* A bare `e !>` -- one that names no handler of its own. */
static bool pl_bare_unwrap_expr(CcExpr* e, void* env) {
    bool* hit = (bool*)env;
    @switch (e->k) {
        case .unwrap: *hit = true; break;
        default: break;
    }
    return true;
}

static bool pl_has_bare_unwrap(CcStmt* s) {
    CcVisitor v;
    bool hit = false;
    if (!s) return false;
    memset(&v, 0, sizeof(v));
    v.expr = pl_bare_unwrap_expr;
    v.env = &hit;
    CcStmt_walk(s, v);
    return hit;
}

/* Whether a block already opens with a handler of its own. */
static bool pl_block_has_handler(CcStmt* s) {
    CcStmtList b;
    bool is_block = false;
    size_t i;
    size_t n;
    if (!s) return false;
    @switch (s->k) {
        case .serial(x): b = x.stmts; is_block = true; break;
        case .block(x): b = x.stmts; is_block = true; break;
        default: break;
    }
    if (!is_block) return false;
    n = b.len();
    for (i = 0; i < n; i++) {
        CcStmt* t = *b.get_ptr(i);
        bool is_eh = false;
        @switch (t->k) {
            case .errhandler: is_eh = true; break;
            default: break;
        }
        if (is_eh) return true;
    }
    return false;
}

/* `return` inside an arm.
 *
 * The block joins before it ends, so a `return` written in an arm is not a
 * return from the function it stands in: the first arm to arrive claims a
 * cell every arm can reach, and the site reads that cell once the joins are
 * done. On the caller the arm jumps to the join; in a thunk it ends the
 * thunk, whose one value is the NULL every other exit from it returns.
 * A cell-less arm is one whose exit carries nothing -- a fiber of a handle
 * -- and leaving is the whole of it. */
static bool pl_arm_exit_stmt(CcStmt* s, void* env) {
    PForExit* fx = (PForExit*)env;
    CcLowerer* L = fx->L;
    CcSpan sp = s->span;
    CcStmt* blk;
    CcReturn r;
    bool is_ret = false;
    @switch (s->k) {
        case .return_(x): r = x; is_ret = true; break;
        default: break;
    }
    if (!is_ret) return true;
    blk = lw_block(L, sp);
    if (fx->cell.len) {
        CCSlice cell = fx->cell;
        CCSlice setter = cc_slice_empty();
        if (fx->has_ret && r.value) {
            CCString spelled = lw_spell_expr(L, r.value);
            CCSlice val = lw_keep(L, &spelled);
            CCString sv = @string(`${cell}->rv = (${val});`, L->arena);
            setter = lw_keep(L, &sv);
        }
        {
            CCString t = @string(`{ int __cc_z = 0; while (!cc_atomic_cas(&${cell}->lock, &__cc_z, 1)) __cc_z = 0; if (cc_atomic_load(&${cell}->xk) < 2) { ${setter} cc_atomic_store(&${cell}->xk, 2); } cc_atomic_store(&${cell}->lock, 0); }`, L->arena);
            lw_push(blk, lw_expr_stmt(L, lw_text(L, t, sp), sp));
        }
    }
    if (fx->leave.len) lw_push(blk, lw_goto(L, fx->leave, sp));
    else lw_push(blk, cc_stmt_return(lw_text(L, @string(`NULL`, L->arena), sp), sp, L->arena));
    s->k = blk->k;
    return false;
}

static void pl_arm_exits(CcLowerer* L, CcExpr* e, CcStmt* s, CCSlice cell,
                         CCSlice leave, bool has_rv) {
    CcVisitor v;
    PForExit fx;
    memset(&fx, 0, sizeof(fx));
    fx.L = L;
    fx.cell = cell;
    fx.leave = leave;
    fx.has_ret = has_rv;
    memset(&v, 0, sizeof(v));
    v.stmt = pl_arm_exit_stmt;
    v.expr = pl_arm_closure_stop;
    v.env = &fx;
    if (e) CcExpr_walk(e, v);
    if (s) CcStmt_walk(s, v);
}

/* The thunk: the environment, the names it reads, then the arm. */
static CcDecl* pl_thunk_decl(PStep* st, uint32_t id, uint32_t k, PCapList* caps,
                             CcExpr* expr, CcStmt* arm_body, CCSlice out_type,
                             CCSlice target, bool snapshot, CCSlice pj_cell,
                             bool pj_rv, CcSpan sp) {
    CcLowerer* L = st->L;
    CCSlice env = pl_name(L, id, k, "_env_t");
    CcStmt* body = lw_block(L, sp);
    CcParamList params = vec_new::[CcParam](L->arena);
    CcType* fn_type = cc__type_blank(sp, L->arena);
    CcType* voidp = cc_type_pointer(cc_type_named(cstr_slice("void"), sp, L->arena), sp, L->arena);
    CcFuncType ft;
    CcFuncDecl fd;
    CcDecl* d;
    size_t n = caps->len();
    size_t i;
    {
        /* `<env>* __e = (<env>*)__p;` */
        CcType* pt = cc_type_pointer(cc_type_named(env, sp, L->arena), sp, L->arena);
        CcExpr* cast = cc__expr_blank(sp, L->arena);
        CcCast ca;
        ca.type = pt;
        ca.a = lw_ident(L, cstr_slice("__p"), sp);
        cast->k = { .cast = ca };
        lw_push(body, lw_decl_stmt(L, pt, cstr_slice("__e"), cast, sp));
    }
    for (i = 0; i < n; i++) {
        PCap* c = *caps->get_ptr(i);
        CcExpr* read = cc_expr_member(lw_ident(L, cstr_slice("__e"), sp), c->name, true, sp, L->arena);
        if (snapshot && !c->by_addr) {
            /* the arm outlives the block, so what it read is what was
             * there when it started, not what the caller has since */
            lw_push(body, lw_decl_stmt(L, c->type, c->name, read, sp));
        } else {
            CcType* pt = cc_type_pointer(c->type, sp, L->arena);
            CCString rn = @string(`__cc_ref_${c->name}`, L->arena);
            CCSlice ref = lw_keep(L, &rn);
            lw_push(body, lw_decl_stmt(L, pt, ref, read, sp));
            pl_rewrite(L, expr, arm_body, c->name, ref);
        }
    }
    /* a bound site pauses and resumes through the handle */
    lw_push(body, lw_expr_stmt(L, lw_call1(L, cstr_slice("cc_parallel_honor"),
                                           cc_expr_member(lw_ident(L, cstr_slice("__e"), sp),
                                                          cstr_slice("__cc_par_h"), true, sp, L->arena), sp), sp));
    /* after the captures were rewritten: a returned value is spelled as the
     * thunk reads it, not as the caller wrote it */
    pl_arm_exits(L, expr, arm_body, pj_cell, cc_slice_empty(), pj_rv);
    if (arm_body) {
        /* a block arm writes its one outer name as an ordinary local, so
         * the name is bound from the out pointer before the body and
         * stored back after it: a copy the caller never reads would make
         * the assignment look like it happened */
        bool has_out = out_type.len != 0 && target.len != 0;
        if (has_out) {
            CcExpr* slot = pl_out_slot(L, sp);
            lw_push(body, lw_decl_stmt(L, cc_type_named(out_type, sp, L->arena), target, slot, sp));
        }
        lw_push(body, arm_body);
        if (has_out) {
            CcExpr* slot = pl_out_slot(L, sp);
            lw_push(body, lw_expr_stmt(L, lw_assign(L, slot, lw_ident(L, target, sp), sp), sp));
        }
    } else if (out_type.len) {
        CcExpr* read = cc_expr_member(lw_ident(L, cstr_slice("__e"), sp), cstr_slice("__cc_out"), true, sp, L->arena);
        CcExpr* store = lw_assign(L, cc_expr_unary(CC_OP_DEREF, lw_paren(L, read, sp), sp, L->arena), expr, sp);
        lw_push(body, lw_expr_stmt(L, store, sp));
    } else {
        lw_push(body, lw_expr_stmt(L, expr, sp));
    }
    lw_push(body, cc_stmt_return(lw_text(L, @string(`NULL`, L->arena), sp), sp, L->arena));
    {
        CcParam p0;
        memset(&p0, 0, sizeof(p0));
        p0.span = sp;
        p0.type = voidp;
        p0.name = cstr_slice("__p");
        p0.attrs = vec_new::[CcAttr](L->arena);
        params.push(p0);
    }
    memset(&ft, 0, sizeof(ft));
    ft.ret = voidp;
    ft.params = params;
    ft.has_prototype = true;
    { CcTypeK tk = { .func = ft }; fn_type->k = tk; }
    memset(&fd, 0, sizeof(fd));
    fd.type = fn_type;
    fd.name = pl_name(L, id, k, "_thunk");
    fd.body = body;
    d = cc_arena_alloc(L->arena, sizeof(CcDecl), _Alignof(CcDecl));
    memset(d, 0, sizeof(*d));
    d->span = sp;
    d->specs = CC_SPEC_STATIC;
    d->attrs = vec_new::[CcAttr](L->arena);
    { CcDeclK dk = { .func = fd }; d->k = dk; }
    return d;
}

/* The spawn, and the join that always runs: a refused or failed spawn
 * runs the same thunk inline, so the arm happens either way. */
static CcExpr* pl_sizeof(CcLowerer* L, CCSlice name, CcSpan sp) {
    CCString s = @string(`sizeof(${name})`, L->arena);
    return lw_text(L, s, sp);
}

static void pl_zero(CcLowerer* L, CcStmt* blk, CCSlice name, CcSpan sp) {
    CcExpr* addr = cc_expr_unary(CC_OP_ADDR, lw_ident(L, name, sp), sp, L->arena);
    lw_push(blk, lw_expr_stmt(L, lw_call2(L, cstr_slice("cc__bytes_zero"), addr,
                                          pl_sizeof(L, name, sp), sp), sp));
}

/* The environment an arm runs from: declared, zeroed and filled. Nothing
 * here starts anything, so it stands on both schedules -- a gated site
 * fills the environment once and then decides whether to spawn. */
static void pl_env_stmts(CcLowerer* L, CcStmt* blk, uint32_t id, uint32_t k,
                         PCapList* caps, CCSlice target, CCSlice bind,
                         CCSlice join_cell, CcSpan sp) {
    CCSlice env = pl_name(L, id, k, "_env_t");
    CCSlice e = pl_name(L, id, k, "_e");
    CCSlice task = pl_name(L, id, k, "_t");
    CCSlice denied = pl_name(L, id, k, "_d");
    size_t n = caps->len();
    size_t i;
    if (bind.len) {
        /* the arm outlives the block, so its environment does too */
        CcType* pt = cc_type_pointer(cc_type_named(env, sp, L->arena), sp, L->arena);
        CCString mk = @string(`(${env}*)cc__heap_alloc(sizeof(${env}))`, L->arena);
        lw_push(blk, lw_decl_stmt(L, pt, e, lw_text(L, mk, sp), sp));
        lw_push(blk, lw_if(L, lw_not(L, lw_ident(L, e, sp), sp),
                           lw_expr_stmt(L, lw_call1(L, cstr_slice("cc_parallel_die"),
                                                    lw_text(L, @string(`"dest-live oom"`, L->arena), sp), sp), sp),
                           NULL, sp));
        lw_push(blk, lw_expr_stmt(L, lw_call2(L, cstr_slice("cc__bytes_zero"), lw_ident(L, e, sp),
                                              pl_sizeof(L, env, sp), sp), sp));
    } else {
        lw_push(blk, lw_decl_stmt(L, cc_type_named(env, sp, L->arena), e, NULL, sp));
        pl_zero(L, blk, e, sp);
    }
    lw_push(blk, lw_decl_stmt(L, cc_type_named(cstr_slice("CCTask"), sp, L->arena), task, NULL, sp));
    lw_push(blk, lw_decl_stmt(L, cc_type_named(cstr_slice("int"), sp, L->arena), denied,
                              lw_text(L, @string(`0`, L->arena), sp), sp));
    pl_zero(L, blk, task, sp);
    for (i = 0; i < n; i++) {
        PCap* c = *caps->get_ptr(i);
        CcExpr* slot = cc_expr_member(lw_ident(L, e, sp), c->name, bind.len != 0, sp, L->arena);
        CcExpr* val = lw_ident(L, c->name, sp);
        if (!bind.len || c->by_addr) val = cc_expr_unary(CC_OP_ADDR, val, sp, L->arena);
        lw_push(blk, lw_expr_stmt(L, lw_assign(L, slot, val, sp), sp));
    }
    if (target.len) {
        CcExpr* slot = cc_expr_member(lw_ident(L, e, sp), cstr_slice("__cc_out"), bind.len != 0, sp, L->arena);
        CcExpr* addr = cc_expr_unary(CC_OP_ADDR, lw_ident(L, target, sp), sp, L->arena);
        lw_push(blk, lw_expr_stmt(L, lw_assign(L, slot, addr, sp), sp));
    }
    if (join_cell.len) {
        CcExpr* slot = cc_expr_member(lw_ident(L, e, sp), cstr_slice("__cc_pj_ex"), bind.len != 0, sp, L->arena);
        lw_push(blk, lw_expr_stmt(L, lw_assign(L, slot, lw_ident(L, join_cell, sp), sp), sp));
    }
    {
        CcExpr* slot = cc_expr_member(lw_ident(L, e, sp), cstr_slice("__cc_par_h"), bind.len != 0, sp, L->arena);
        CcExpr* val = lw_text(L, @string(`NULL`, L->arena), sp);
        if (bind.len) val = cc_expr_unary(CC_OP_ADDR, lw_paren(L, lw_ident(L, bind, sp), sp), sp, L->arena);
        lw_push(blk, lw_expr_stmt(L, lw_assign(L, slot, val, sp), sp));
    }
}

/* Offering the arm to the runtime. This is the half a gate skips: when the
 * site runs its arms in order, nothing is spawned and the thunks are
 * called on the caller instead. */
static void pl_fire_stmts(CcLowerer* L, CcStmt* blk, uint32_t id, uint32_t k,
                          CCSlice bind, bool spawn, CcSpan sp) {
    CCSlice thunk = pl_name(L, id, k, "_thunk");
    CCSlice e = pl_name(L, id, k, "_e");
    CCSlice site = pl_name(L, id, k, "_site");
    CCSlice task = pl_name(L, id, k, "_t");
    CCSlice denied = pl_name(L, id, k, "_d");
    if (bind.len) {
        /* the handle promised a live arm: a refused or failed spawn is
         * not something to quietly run inline here */
        CcExpr* sp_call = lw_call2(L, cstr_slice("cc_parallel_spawn_admit"), lw_ident(L, thunk, sp),
                                   lw_ident(L, e, sp), sp);
        CcExpr* invalid = cc_expr_binary(CC_OP_EQ,
                                         cc_expr_member(lw_ident(L, task, sp), cstr_slice("kind"), false, sp, L->arena),
                                         lw_ident(L, cstr_slice("CC_TASK_KIND_INVALID"), sp), sp, L->arena);
        CcExpr* admit = lw_call0(L, cstr_slice("cc_parallel_admit"), sp);
        CcExprList* aa = lw_call_args(admit);
        lw_push(blk, lw_expr_stmt(L, lw_assign(L, lw_ident(L, task, sp), sp_call, sp), sp));
        lw_push(blk, lw_if(L, invalid,
                           lw_expr_stmt(L, lw_call1(L, cstr_slice("cc_parallel_die"),
                                                    lw_text(L, @string(`"dest-live spawn failed"`, L->arena), sp), sp), sp),
                           NULL, sp));
        aa->push(cc_expr_unary(CC_OP_ADDR, lw_paren(L, lw_ident(L, bind, sp), sp), sp, L->arena));
        aa->push(lw_ident(L, task, sp));
        aa->push(lw_ident(L, e, sp));
        lw_push(blk, lw_expr_stmt(L, admit, sp));
        (void)site;
        (void)denied;
        return;
    }
    if (spawn) {
        /* `spawn` promises the arm is running while the block is: an arm the
         * runtime denied and the caller ran instead is a rendezvous waiting
         * on itself, so this site is not one a deny may take */
        CcExpr* sp_call = lw_call2(L, cstr_slice("cc_parallel_spawn_admit"), lw_ident(L, thunk, sp),
                                   cc_expr_unary(CC_OP_ADDR, lw_ident(L, e, sp), sp, L->arena), sp);
        lw_push(blk, lw_expr_stmt(L, lw_assign(L, lw_ident(L, task, sp), sp_call, sp), sp));
        (void)site;
        (void)denied;
        return;
    }
    {
        /* the runtime may refuse this site outright */
        CcExpr* cond = lw_call0(L, cstr_slice("cc_parallel_deny_fast"), sp);
        CcExprList* args = lw_call_args(cond);
        CcStmt* then = lw_block(L, sp);
        CcStmt* els = lw_block(L, sp);
        args->push(lw_ident(L, cstr_slice("__cc_pt"), sp));
        args->push(cc_expr_unary(CC_OP_ADDR, lw_ident(L, site, sp), sp, L->arena));
        args->push(lw_ident(L, thunk, sp));
        lw_push(then, lw_expr_stmt(L, lw_assign(L, lw_ident(L, denied, sp),
                                                lw_text(L, @string(`1`, L->arena), sp), sp), sp));
        lw_push(then, lw_expr_stmt(L, lw_call1(L, cstr_slice("cc_parallel_note_denied"),
                                               lw_ident(L, cstr_slice("__cc_pt"), sp), sp), sp));
        lw_push(els, lw_expr_stmt(L, lw_assign(L, lw_ident(L, task, sp),
                                               lw_call2(L, cstr_slice("cc_parallel_spawn"),
                                                        lw_ident(L, thunk, sp),
                                                        cc_expr_unary(CC_OP_ADDR, lw_ident(L, e, sp), sp, L->arena),
                                                        sp), sp), sp));
        lw_push(blk, lw_if(L, cond, then, els, sp));
    }
}

static void pl_spawn_stmts(CcLowerer* L, CcStmt* blk, uint32_t id, uint32_t k,
                           PCapList* caps, CCSlice target, CCSlice bind, CcSpan sp) {
    pl_env_stmts(L, blk, id, k, caps, target, bind, cc_slice_empty(), sp);
    pl_fire_stmts(L, blk, id, k, bind, false, sp);
}

/* The arm on the caller: the same thunk a spawn would have run, called
 * straight through. The arms are emitted once and the gate picks the route
 * to them, so this is how the sequential schedule reaches an arm. */
static void pl_inline_call(CcLowerer* L, CcStmt* blk, uint32_t id, uint32_t k, CcSpan sp) {
    CCSlice thunk = pl_name(L, id, k, "_thunk");
    CCSlice e = pl_name(L, id, k, "_e");
    CcExpr* call = lw_call1(L, thunk, cc_expr_unary(CC_OP_ADDR, lw_ident(L, e, sp), sp, L->arena), sp);
    CcExpr* cast = cc__expr_blank(sp, L->arena);
    CcCast ca;
    ca.type = cc_type_named(cstr_slice("void"), sp, L->arena);
    ca.a = call;
    cast->k = { .cast = ca };
    lw_push(blk, lw_expr_stmt(L, cast, sp));
}

static void pl_join_stmts(CcLowerer* L, CcStmt* blk, uint32_t id, uint32_t k, bool spawn, CcSpan sp) {
    CCSlice thunk = pl_name(L, id, k, "_thunk");
    CCSlice e = pl_name(L, id, k, "_e");
    CCSlice task = pl_name(L, id, k, "_t");
    CCSlice denied = pl_name(L, id, k, "_d");
    CcStmt* then = lw_block(L, sp);
    CcStmt* els = lw_block(L, sp);
    CcExpr* live = cc_expr_binary(CC_OP_NE,
                                  cc_expr_member(lw_ident(L, task, sp), cstr_slice("kind"), false, sp, L->arena),
                                  lw_ident(L, cstr_slice("CC_TASK_KIND_INVALID"), sp), sp, L->arena);
    CcExpr* cond = cc_expr_binary(CC_OP_LAND, lw_not(L, lw_ident(L, denied, sp), sp), live, sp, L->arena);
    if (spawn) {
        /* nothing ran here, so there is no inline arm to fall back to: an
         * arm that never started is the promise `spawn` made, broken */
        CCString dm = cc_string_new();
        /* Assembled rather than templated: the text is a C string literal
         * carrying an `@`, and a template reads that as a sigil. */
        cc_string_push_cstr(&dm, "\"@parallel spawn failed\"", L->arena);
        lw_push(then, lw_expr_stmt(L, lw_call1(L, cstr_slice("cc_parallel_join"), lw_ident(L, task, sp), sp), sp));
        lw_push(els, lw_expr_stmt(L, lw_call1(L, cstr_slice("cc_parallel_die"),
                                              lw_text(L, dm, sp), sp), sp));
        lw_push(blk, lw_if(L, live, then, els, sp));
        (void)thunk;
        (void)e;
        (void)denied;
        (void)cond;
        return;
    }
    lw_push(then, lw_expr_stmt(L, lw_call1(L, cstr_slice("cc_parallel_join"), lw_ident(L, task, sp), sp), sp));
    lw_push(els, lw_expr_stmt(L, lw_call1(L, cstr_slice("CC_PAR_NOTE_INLINE_ARM"),
                                          lw_ident(L, cstr_slice("__cc_pt"), sp), sp), sp));
    pl_inline_call(L, els, id, k, sp);
    lw_push(blk, lw_if(L, cond, then, els, sp));
}


/* ---- `@parallel for (i in lo..hi)` --------------------------------------
 *
 * A walk over a range, split rather than queued: the span halves until a
 * half is small enough to run, and each split offers its right half to the
 * runtime while the caller takes its left. What the body reads it reads by
 * address, so both halves see the caller's own objects.
 *
 * `break` and `return` leave a walk that is running in several places at
 * once, so they are not a jump: they write the first one to arrive into a
 * cell every half checks, and the site reads it after the walk. */

/* An array capture is its first element's address: a walk that reads
 * `par[i]` wants the same pointer C would decay it to, under the same name,
 * so the body is left exactly as written. Anything else is reached through
 * its address. */
static CcType* pl_for_decayed(CcType* t) {
    if (!t) return NULL;
    @switch (t->k) {
        case .array(ar): return ar.elem;
        default: return NULL;
    }
}

static CCSlice pl_for_name(CcLowerer* L, uint32_t id, const char* suffix) {
    CCString s = @string(`__cc_parfor_${id}${suffix}`, L->arena);
    return lw_keep(L, &s);
}

static CCSlice pl_for_ex_type(CcLowerer* L, uint32_t id) {
    CCString s = @string(`__cc_pf_ex_${id}_t`, L->arena);
    return lw_keep(L, &s);
}

static CcStmt* pl_raise_handler(CcLowerer* L, CCSlice ety, CCSlice cell, CcStmt* leave, CcSpan sp);

/* The cell an exit is recorded in, and the environment each half carries.
 * `xk`: 0 nothing yet, 1 a `break`, 2 a `return` (`rv`), 3 a raise (`err`,
 * present when `err_ty` names a type). */
static CCString pl_for_env_text(PStep* st, uint32_t id, PCapList* caps, CCSlice ret_ty, CCSlice err_ty) {
    CcLowerer* L = st->L;
    CCArena a = L->arena;
    CCString sb = cc_string_new();
    CCSlice env = pl_for_name(L, id, "_env_t");
    CCSlice ex = pl_for_ex_type(L, id);
    size_t n = caps->len();
    size_t i;
    sb.push_cstr("typedef struct { cc_atomic_int lock; cc_atomic_int xk; ", a);
    sb.push_slice(ret_ty, a);
    sb.push_cstr(" rv; ", a);
    if (err_ty.len) {
        sb.push_slice(err_ty, a);
        sb.push_cstr(" err; ", a);
    }
    sb.push_cstr("} ", a);
    sb.push_slice(ex, a);
    sb.push_cstr(";\n", a);
    sb.push_cstr("typedef struct {\n", a);
    for (i = 0; i < n; i++) {
        PCap* c = *caps->get_ptr(i);
        CcType* el = pl_for_decayed(c->type);
        CCSlice tn = L->ix->canon(el ? el : c->type);
        sb.push_cstr("    ", a);
        sb.push_slice(tn, a);
        sb.push_cstr("* ", a);
        sb.push_slice(c->name, a);
        sb.push_cstr(";\n", a);
    }
    sb.push_cstr("    int lo;\n    int hi;\n    ", a);
    sb.push_slice(ex, a);
    sb.push_cstr("* __cc_pf_ex;\n    CCParallel* __cc_par_h;\n} ", a);
    sb.push_slice(env, a);
    sb.push_cstr(";\n", a);
    return sb;
}

static void pl_for_forward(PStep* st, uint32_t id) {
    CcLowerer* L = st->L;
    CCSlice walk = pl_for_name(L, id, "_walk");
    CCSlice thunk = pl_for_name(L, id, "_thunk");
    CCSlice site = pl_for_name(L, id, "_site");
    CCString t = @string(`static void ${walk}(int, int, void*);
static void* ${thunk}(void*);
static void* ${site};
`, L->arena);
    pl_host(st); st->fwd.push_slice(t.as_slice(), L->arena);
}

/* `break` and `return v` inside the walked body.
 *
 * The body runs in several halves at once, so neither can simply leave:
 * the first to arrive claims the cell under its lock, every half sees it on
 * its next step, and the site reads it once the walk is done. A `break`
 * that belongs to a loop the body itself opened is that loop's, and is left
 * alone -- which is why this walks with a depth rather than visiting. */
static void pl_for_leave(PForExit* fx, CcStmt* blk, CcSpan sp) {
    CcLowerer* L = fx->L;
    if (fx->leave.len) {
        lw_push(blk, lw_goto(L, fx->leave, sp));
    } else {
        lw_push(blk, cc_stmt_return(NULL, sp, L->arena));
    }
}

static void pl_for_exits(PForExit* fx, CcStmt* s, int depth) {
    CcLowerer* L = fx->L;
    CcStmtList* bs;
    size_t n;
    size_t i;
    CcSpan sp;
    if (!s) return;
    sp = s->span;
    {
        bool is_break = false;
        bool is_ret = false;
        bool is_cont = false;
        CcReturn r;
        @switch (s->k) {
            case .break_: is_break = true; break;
            case .continue_: is_cont = true; break;
            case .return_(x): r = x; is_ret = true; break;
            default: break;
        }
        if (is_cont && depth == 0 && fx->leave.len) {
            /* one ticket ends where the next begins: this body is a function
             * of its own by the time C sees it, so there is no loop here to
             * continue -- ending the ticket is the whole of it */
            CcStmt* g = lw_goto(L, fx->leave, sp);
            s->k = g->k;
            return;
        }
        if (is_break && depth == 0) {
            CCSlice ex = cstr_slice("__cc_pf_ex");
            CCString t = @string(`{ int __cc_z = 0; while (!cc_atomic_cas(&e->${ex}->lock, &__cc_z, 1)) __cc_z = 0; if (cc_atomic_load(&e->${ex}->xk) == 0) cc_atomic_store(&e->${ex}->xk, 1); cc_atomic_store(&e->${ex}->lock, 0); }`, L->arena);
            CcStmt* blk = lw_block(L, sp);
            lw_push(blk, lw_expr_stmt(L, lw_text(L, t, sp), sp));
            if (fx->cancel) {
                CCString c = @string(`cc_nursery_cancel_host(__cc_pw_sh->nur)`, L->arena);
                lw_push(blk, lw_expr_stmt(L, lw_text(L, c, sp), sp));
            }
            pl_for_leave(fx, blk, sp);
            s->k = blk->k;
            return;
        }
        if (is_ret) {
            CCString spelled = r.value ? lw_spell_expr(L, r.value) : @string(`0`, L->arena);
            CCSlice v = lw_keep(L, &spelled);
            CCString t = @string(`{ int __cc_z = 0; while (!cc_atomic_cas(&e->__cc_pf_ex->lock, &__cc_z, 1)) __cc_z = 0; if (cc_atomic_load(&e->__cc_pf_ex->xk) < 2) { e->__cc_pf_ex->rv = (${v}); cc_atomic_store(&e->__cc_pf_ex->xk, 2); } cc_atomic_store(&e->__cc_pf_ex->lock, 0); }`, L->arena);
            CcStmt* blk = lw_block(L, sp);
            lw_push(blk, lw_expr_stmt(L, lw_text(L, t, sp), sp));
            if (fx->cancel) {
                /* the tickets that have not started stop starting, and the
                 * ones in flight skip their ordered sections: the walk the
                 * caller returns out of has no work left to do */
                CCString c = @string(`cc_nursery_cancel_host(__cc_pw_sh->nur)`, L->arena);
                lw_push(blk, lw_expr_stmt(L, lw_text(L, c, sp), sp));
            }
            pl_for_leave(fx, blk, sp);
            s->k = blk->k;
            return;
        }
    }
    {
        /* a loop or switch the body opened owns its own `break` */
        int inner = depth;
        bool opens = false;
        @switch (s->k) {
            case .for_: opens = true; break;
            case .while_: opens = true; break;
            case .do_: opens = true; break;
            case .switch_: opens = true; break;
            default: break;
        }
        if (opens) inner = depth + 1;
        bs = lw_block_stmts(s);
        if (bs) {
            n = bs->len();
            for (i = 0; i < n; i++) {
                CcStmt* k = *bs->get_ptr(i);
                pl_for_exits(fx, k, inner);
            }
            return;
        }
        {
            CcStmt* a = NULL;
            CcStmt* b = NULL;
            @switch (s->k) {
                case .if_(x): a = x.then; b = x.els; break;
                case .for_(x): a = x.body; break;
                case .while_(x): a = x.body; break;
                case .do_(x): a = x.body; break;
                case .switch_(x): a = x.body; break;
                case .label(x): a = x.inner; break;
                default: break;
            }
            if (a) pl_for_exits(fx, a, inner);
            if (b) pl_for_exits(fx, b, inner);
        }
    }
}


/* The walk. One function, called on the caller and on every half the
 * runtime accepts. The leaf loop is emitted once: a span of one skips the
 * split, and a split whose spawn was refused falls through to it. */
static CcDecl* pl_for_walk_decl(PStep* st, uint32_t id, PCapList* caps, CcForIn loop,
                                CcExpr* lo, CcExpr* hi, bool has_ex, CCSlice err_ty, CcSpan sp) {
    CcLowerer* L = st->L;
    CCSlice env = pl_for_name(L, id, "_env_t");
    CCSlice walk = pl_for_name(L, id, "_walk");
    CCSlice thunk = pl_for_name(L, id, "_thunk");
    CCSlice site = pl_for_name(L, id, "_site");
    CcStmt* fnbody = lw_block(L, sp);
    CcParamList params = vec_new::[CcParam](L->arena);
    CcType* fn_type = cc__type_blank(sp, L->arena);
    CcType* voidp = cc_type_pointer(cc_type_named(cstr_slice("void"), sp, L->arena), sp, L->arena);
    CcType* intt = cc_type_named(cstr_slice("int"), sp, L->arena);
    CcFuncType ft;
    CcFuncDecl fd;
    CcDecl* d;
    size_t n = caps->len();
    size_t i;
    CCSlice bind = loop.bind;
    (void)lo; (void)hi;
    {
        CcType* pt = cc_type_pointer(cc_type_named(env, sp, L->arena), sp, L->arena);
        CcExpr* cast = cc__expr_blank(sp, L->arena);
        CcCast ca;
        ca.type = pt;
        ca.a = lw_ident(L, cstr_slice("__p"), sp);
        cast->k = { .cast = ca };
        lw_push(fnbody, lw_decl_stmt(L, pt, cstr_slice("e"), cast, sp));
    }
    for (i = 0; i < n; i++) {
        PCap* c = *caps->get_ptr(i);
        CcExpr* read = cc_expr_member(lw_ident(L, cstr_slice("e"), sp), c->name, true, sp, L->arena);
        CcType* el = pl_for_decayed(c->type);
        CCSlice cn = c->name;
        if (el) {
            lw_push(fnbody, lw_decl_stmt(L, cc_type_pointer(el, sp, L->arena), cn, read, sp));
        } else {
            CcType* pt = cc_type_pointer(c->type, sp, L->arena);
            CCString rn = @string(`__cc_ref_${cn}`, L->arena);
            CCSlice ref = lw_keep(L, &rn);
            lw_push(fnbody, lw_decl_stmt(L, pt, ref, read, sp));
            pl_rewrite(L, NULL, loop.body, cn, ref);
        }
    }
    {
        CCString t = @string(`if (__cc_lo >= __cc_hi) return`, L->arena);
        lw_push(fnbody, lw_expr_stmt(L, lw_text(L, t, sp), sp));
    }
    lw_push(fnbody, lw_expr_stmt(L, lw_call1(L, cstr_slice("cc_parallel_honor"),
                cc_expr_member(lw_ident(L, cstr_slice("e"), sp), cstr_slice("__cc_par_h"), true, sp, L->arena), sp), sp));
    {
        /* the split: offer the right half, take the left */
        CcStmt* split = lw_block(L, sp);
        CCString head = @string(`CCParTls* __cc_pt = cc__par_tls()`, L->arena);
        CCString mid = @string(`int __cc_mid = __cc_lo + (__cc_hi - __cc_lo) / 2`, L->arena);
        CcStmt* offer = lw_block(L, sp);
        CCString ch = cc_string_new();
        size_t k;
        lw_push(split, lw_expr_stmt(L, lw_text(L, head, sp), sp));
        lw_push(split, lw_expr_stmt(L, lw_text(L, mid, sp), sp));
        ch.push_slice(env.len ? env : cstr_slice(""), L->arena);
        {
            CCString decl = @string(`${env} __cc_child`, L->arena);
            lw_push(offer, lw_expr_stmt(L, lw_text(L, decl, sp), sp));
        }
        lw_push(offer, lw_expr_stmt(L, lw_text(L, @string(`CCTask __cc_t`, L->arena), sp), sp));
        for (k = 0; k < n; k++) {
            PCap* c = *caps->get_ptr(k);
            CCSlice cn = c->name;
            CCString as = @string(`__cc_child.${cn} = e->${cn}`, L->arena);
            lw_push(offer, lw_expr_stmt(L, lw_text(L, as, sp), sp));
        }
        lw_push(offer, lw_expr_stmt(L, lw_text(L, @string(`__cc_child.lo = __cc_mid`, L->arena), sp), sp));
        lw_push(offer, lw_expr_stmt(L, lw_text(L, @string(`__cc_child.hi = __cc_hi`, L->arena), sp), sp));
        lw_push(offer, lw_expr_stmt(L, lw_text(L, @string(`__cc_child.__cc_pf_ex = e->__cc_pf_ex`, L->arena), sp), sp));
        lw_push(offer, lw_expr_stmt(L, lw_text(L, @string(`__cc_child.__cc_par_h = e->__cc_par_h`, L->arena), sp), sp));
        {
            CCString spawn = @string(`__cc_t = cc_parallel_spawn(${thunk}, &__cc_child)`, L->arena);
            CCString took = @string(`if (__cc_t.kind != CC_TASK_KIND_INVALID) { ${walk}(__cc_lo, __cc_mid, __p); cc_parallel_join(__cc_t); return; }`, L->arena);
            lw_push(offer, lw_expr_stmt(L, lw_text(L, spawn, sp), sp));
            lw_push(offer, lw_expr_stmt(L, lw_text(L, took, sp), sp));
        }
        {
            CCString cond = @string(`!cc_parallel_deny_fast(__cc_pt, &${site}, ${thunk})`, L->arena);
            lw_push(split, lw_if(L, lw_text(L, cond, sp), offer, NULL, sp));
        }
        lw_push(split, lw_expr_stmt(L, lw_text(L, @string(`CC_PAR_NOTE_INLINE_ARM(__cc_pt)`, L->arena), sp), sp));
        lw_push(fnbody, lw_if(L, lw_text(L, @string(`(__cc_hi - __cc_lo) > 1`, L->arena), sp), split, NULL, sp));
    }
    {
        /* the leaf, once */
        CcStmt* lbody = lw_block(L, sp);
        CcFor fl;
        CcStmt* fs;
        if (has_ex) {
            CCString ck = @string(`if (e->__cc_pf_ex) { int __cc_xk = cc_atomic_load(&e->__cc_pf_ex->xk); if (__cc_xk) break; }`, L->arena);
            lw_push(lbody, lw_expr_stmt(L, lw_text(L, ck, sp), sp));
        }
        lw_push(lbody, lw_expr_stmt(L, lw_call1(L, cstr_slice("cc_parallel_honor"),
                    cc_expr_member(lw_ident(L, cstr_slice("e"), sp), cstr_slice("__cc_par_h"), true, sp, L->arena), sp), sp));
        if (loop.body) { lw_push(lbody, loop.body); }
        memset(&fl, 0, sizeof(fl));
        fl.init_decl = NULL;
        fl.init_expr = lw_assign(L, lw_ident(L, bind, sp), lw_ident(L, cstr_slice("__cc_lo"), sp), sp);
        fl.cond = cc_expr_binary(CC_OP_LT, lw_ident(L, bind, sp), lw_ident(L, cstr_slice("__cc_hi"), sp), sp, L->arena);
        fl.step = cc_expr_unary(CC_OP_PREINC, lw_ident(L, bind, sp), sp, L->arena);
        fl.body = lbody;
        fl.more = vec_new::[CcStmtRef](L->arena);
        fs = cc__stmt_blank(sp, L->arena);
        { CcStmtK sk = { .for_ = fl }; fs->k = sk; }
        lw_push(fnbody, lw_decl_stmt(L, intt, bind, NULL, sp));
        if (err_ty.len) {
            /* a bare `!>` in the body: this half is a function of its own,
             * so the handler the frame carries is not here. The body opens
             * under a handler that records the error in the exit cell and
             * ends the walk; the site raises the record after the join.
             * Added after the exit rewriting walked the body, so the
             * `return` it ends in is its own. */
            lw_push(fnbody, pl_raise_handler(L, err_ty, cstr_slice("e->__cc_pf_ex"),
                                             cc_stmt_return(NULL, sp, L->arena), sp));
        }
        lw_push(fnbody, fs);
    }
    {
        CcParam p0;
        CcParam p1;
        CcParam p2;
        memset(&p0, 0, sizeof(p0));
        memset(&p1, 0, sizeof(p1));
        memset(&p2, 0, sizeof(p2));
        p0.span = sp; p0.type = intt; p0.name = cstr_slice("__cc_lo"); p0.attrs = vec_new::[CcAttr](L->arena);
        p1.span = sp; p1.type = intt; p1.name = cstr_slice("__cc_hi"); p1.attrs = vec_new::[CcAttr](L->arena);
        p2.span = sp; p2.type = voidp; p2.name = cstr_slice("__p"); p2.attrs = vec_new::[CcAttr](L->arena);
        params.push(p0);
        params.push(p1);
        params.push(p2);
    }
    memset(&ft, 0, sizeof(ft));
    ft.ret = cc_type_named(cstr_slice("void"), sp, L->arena);
    ft.params = params;
    ft.has_prototype = true;
    { CcTypeK tk = { .func = ft }; fn_type->k = tk; }
    memset(&fd, 0, sizeof(fd));
    fd.name = walk;
    fd.type = fn_type;
    fd.body = fnbody;
    d = cc_arena_alloc(L->arena, sizeof(CcDecl), _Alignof(CcDecl));
    memset(d, 0, sizeof(*d));
    d->span = sp;
    d->specs = CC_SPEC_STATIC;
    d->attrs = vec_new::[CcAttr](L->arena);
    { CcDeclK dk = { .func = fd }; d->k = dk; }
    return d;
}

/* The thunk the runtime starts a half through. */
static CcDecl* pl_for_thunk_decl(PStep* st, uint32_t id, CcSpan sp) {
    CcLowerer* L = st->L;
    CCSlice env = pl_for_name(L, id, "_env_t");
    CCSlice walk = pl_for_name(L, id, "_walk");
    CCSlice thunk = pl_for_name(L, id, "_thunk");
    CcStmt* body = lw_block(L, sp);
    CcParamList params = vec_new::[CcParam](L->arena);
    CcType* fn_type = cc__type_blank(sp, L->arena);
    CcType* voidp = cc_type_pointer(cc_type_named(cstr_slice("void"), sp, L->arena), sp, L->arena);
    CcFuncType ft;
    CcFuncDecl fd;
    CcDecl* d;
    {
        CCString t = @string(`${env}* e = (${env}*)__p`, L->arena);
        lw_push(body, lw_expr_stmt(L, lw_text(L, t, sp), sp));
    }
    {
        CCString t = @string(`${walk}(e->lo, e->hi, __p)`, L->arena);
        lw_push(body, lw_expr_stmt(L, lw_text(L, t, sp), sp));
    }
    lw_push(body, cc_stmt_return(lw_text(L, @string(`NULL`, L->arena), sp), sp, L->arena));
    {
        CcParam p0;
        memset(&p0, 0, sizeof(p0));
        p0.span = sp; p0.type = voidp; p0.name = cstr_slice("__p"); p0.attrs = vec_new::[CcAttr](L->arena);
        params.push(p0);
    }
    memset(&ft, 0, sizeof(ft));
    ft.ret = voidp;
    ft.params = params;
    ft.has_prototype = true;
    { CcTypeK tk = { .func = ft }; fn_type->k = tk; }
    memset(&fd, 0, sizeof(fd));
    fd.name = thunk;
    fd.type = fn_type;
    fd.body = body;
    d = cc_arena_alloc(L->arena, sizeof(CcDecl), _Alignof(CcDecl));
    memset(d, 0, sizeof(*d));
    d->span = sp;
    d->specs = CC_SPEC_STATIC;
    d->attrs = vec_new::[CcAttr](L->arena);
    { CcDeclK dk = { .func = fd }; d->k = dk; }
    return d;
}

/* What the exit cell carries: the type the function the arms stand in
 * returns. A `void` one leaves nothing to carry but the fact that an arm
 * exited; a Result is built where the `return` was written, and the C
 * return type is not the one the source names, so neither is answered
 * with a cell field. */
/* The function the arms stand in returns a Result: its C return type is
 * the box, which no arm return here can spell. */
static bool pl_fn_returns_result(PStep* st) {
    if (!st->fn_ret) return false;
    @switch (st->fn_ret->k) {
        case .result: return true;
        default: return false;
    }
}

static CCSlice pl_ret_type(PStep* st) {
    CcLowerer* L = st->L;
    CCSlice nm = cc_slice_empty();
    CCSlice v = cstr_slice("void");
    bool is_result = false;
    if (!st->fn_ret) return cc_slice_empty();
    @switch (st->fn_ret->k) {
        case .result: is_result = true; break;
        default: break;
    }
    /* A Result return would type the cell as `CCResult_T_E`, but the value an
     * arm hands back is written `cc_err(e)` / `cc_ok(v)`, and the call that
     * spells is chosen by the Result the enclosing function returns -- which,
     * in a thunk, is the thunk. Until that is settled the site says so rather
     * than emit a cell the arm cannot fill. */
    if (is_result) return cc_slice_empty();
    if (type_named_name(st->fn_ret, &nm) && slice_eq(nm, v)) return cc_slice_empty();
    return L->ix->canon(st->fn_ret);
}

/* A capture that is its own identity: an atomic and a `CCParallel` are the
 * object, not a value with a copy. A bound arm outlives the block, so it
 * reads what it captured as it was when the arm started -- except these,
 * which the arm reaches on the caller or does not reach at all. */
static bool pl_cap_identity(CcType* t) {
    CCSlice nm = cc_slice_empty();
    CCSlice par = cstr_slice("CCParallel");
    CCSlice at = cstr_slice("cc_atomic");
    if (!t) return false;
    if (!type_named_name(t, &nm)) return false;
    if (slice_eq(nm, par)) return true;
    return nm.starts_with(at);
}

/* The copy a bound arm holds. An array and a pointer carry the caller's
 * own object either way; everything else is a copy the caller never
 * reads back. */
static bool pl_cap_byvalue(PCap* c) {
    bool aggregate = false;
    if (!c || c->by_addr || !c->type) return false;
    @switch (c->type->k) {
        case .pointer: aggregate = true; break;
        case .array: aggregate = true; break;
        default: break;
    }
    return !aggregate;
}

/* Writing that copy, taking its address, or calling a method on it reads
 * as work on the frame object and is not: the frame moved on before the
 * arm ran. */
static bool pl_byval_named(PAsk* q, CcExpr* e) {
    CCSlice nm = cc_slice_empty();
    CCSlice minted = cstr_slice("__cc_");
    PCapList* cv;
    size_t n;
    size_t i;
    if (!e || !expr_ident(strip_parens_expr(e), &nm) || !nm.len) return false;
    /* this is a rule about what the page says: a name a lowering minted is
     * not one the page wrote, and it is reached the way its lowering meant */
    if (nm.starts_with(minted)) return false;
    cv = q->caps;
    n = cv->len();
    for (i = 0; i < n; i++) {
        PCap* c = *cv->get_ptr(i);
        if (!pl_cap_byvalue(c)) continue;
        if (!slice_eq(c->name, nm)) continue;
        q->hit = c->name;
        return true;
    }
    return false;
}

static bool pl_byval_expr(CcExpr* e, void* env) {
    PAsk* q = (PAsk*)env;
    CcExpr* touched = NULL;
    if (q->hit.len) return true;
    @switch (e->k) {
        case .assign(b): touched = b.a; break;
        case .unary(u): if (u.op == CC_OP_ADDR) touched = u.a; break;
        case .ufcs(uf): touched = uf.recv; break;
        default: break;
    }
    if (touched) (void)pl_byval_named(q, touched);
    return true;
}

/* The labels a body declares, so a `goto` to one of them is a jump that
 * stays inside it. */
static bool pl_label_stmt(CcStmt* s, void* env) {
    CcNameList* names = (CcNameList*)env;
    @switch (s->k) {
        case .label(x): names->push(x.name); break;
        default: break;
    }
    return true;
}

/* The first statement that leaves a dest body: a `break` or `continue` that
 * no loop or switch inside the body owns, or a `goto` to a label the body
 * does not declare. A dest body is a fiber, and the only way out of it is
 * `return;` -- the frame that wrote it has moved on, so there is nothing
 * outside it for a jump to reach. Walked with a depth, as `pl_for_exits`
 * is: a loop the body opened owns its own `break`. */
static CcStmt* pl_dest_body_leaves(CcStmt* s, int depth, CcNameList* labels) {
    CcStmtList* bs;
    size_t n;
    size_t i;
    int inner = depth;
    bool opens = false;
    bool leaves = false;
    bool is_goto = false;
    CcGoto gt;
    CcStmt* a = NULL;
    CcStmt* b = NULL;
    if (!s) return NULL;
    @switch (s->k) {
        case .break_: leaves = depth == 0; break;
        case .continue_: leaves = depth == 0; break;
        case .goto_(g): gt = g; is_goto = true; break;
        case .for_(x): opens = true; a = x.body; break;
        case .while_(x): opens = true; a = x.body; break;
        case .do_(x): opens = true; a = x.body; break;
        case .switch_(x): opens = true; a = x.body; break;
        case .if_(x): a = x.then; b = x.els; break;
        case .label(x): a = x.inner; break;
        default: break;
    }
    if (is_goto) {
        /* a computed `goto *e` names no label the body could declare */
        size_t nl = labels->len();
        size_t li;
        bool known = false;
        CCSlice want = gt.label;
        for (li = 0; li < nl; li++) {
            CCSlice nm = *labels->get_ptr(li);
            if (want.len && slice_eq(nm, want)) known = true;
        }
        leaves = !known;
    }
    if (leaves) return s;
    if (opens) inner = depth + 1;
    bs = lw_block_stmts(s);
    if (bs) {
        n = bs->len();
        for (i = 0; i < n; i++) {
            CcStmt* k = *bs->get_ptr(i);
            CcStmt* hit = pl_dest_body_leaves(k, inner, labels);
            if (hit) return hit;
        }
        return NULL;
    }
    if (a) {
        CcStmt* hit = pl_dest_body_leaves(a, inner, labels);
        if (hit) return hit;
    }
    if (b) return pl_dest_body_leaves(b, inner, labels);
    return NULL;
}

/* Whether a dest body -- an arm of a bound construct, the body of an attach
 * -- ends only by running out or by `return;`. Says so at the statement
 * that leaves it otherwise. */
static bool pl_dest_body_stays(PStep* st, CcStmt* body) {
    CcLowerer* L = st->L;
    CcNameList labels = vec_new::[CCSlice](L->arena);
    CcVisitor v;
    CcStmt* hit;
    bool is_goto = false;
    bool is_cont = false;
    if (!body) return true;
    memset(&v, 0, sizeof(v));
    v.stmt = pl_label_stmt;
    v.env = &labels;
    CcStmt_walk(body, v);
    hit = pl_dest_body_leaves(body, 0, &labels);
    if (!hit) return true;
    @switch (hit->k) {
        case .goto_: is_goto = true; break;
        case .continue_: is_cont = true; break;
        default: break;
    }
    {
        CCString m = cc_string_new();
        if (is_goto) m.push_cstr("'goto' to a label outside a dest body: the body is a fiber of the dest and the frame that wrote it has moved on; write 'return;' to end the fiber, or put the label inside the body", L->arena);
        else if (is_cont) m.push_cstr("'continue' leaves a dest body: the body is a fiber of the dest, not an iteration of a loop outside it; write 'return;' to end the fiber", L->arena);
        else m.push_cstr("'break' leaves a dest body: the body is a fiber of the dest, not a loop outside it; write 'return;' to end the fiber", L->arena);
        lw_error(L, hit->span, m);
    }
    return false;
}

static bool pl_dest_body_ok(PStep* st, CcStmt* body, PCapList* caps, CcSpan sp) {
    CcLowerer* L = st->L;
    if (!pl_dest_body_stays(st, body)) return false;
    {
        CcVisitor v;
        CcStmt* at = NULL;
        memset(&v, 0, sizeof(v));
        v.stmt = pl_dest_ret_stmt;
        v.env = &at;
        CcStmt_walk(body, v);
        if (at) {
            CCString m = cc_string_new();
            m.push_cstr("return with a value in a dest body; `return;` ends the fiber, `h.fail(e)` records an error", L->arena);
            lw_error(L, at->span, m);
            return false;
        }
    }
    {
        CcVisitor v;
        PAsk q;
        memset(&q, 0, sizeof(q));
        q.caps = caps;
        memset(&v, 0, sizeof(v));
        v.expr = pl_byval_expr;
        v.env = &q;
        CcStmt_walk(body, v);
        if (q.hit.len) {
            CCSlice nm = q.hit;
            CCString m = cc_string_new();
            m.push_cstr("'", L->arena);
            m.push_slice(nm, L->arena);
            m.push_cstr("' is a dest-bound by-value capture (a copy); assign, address-take, or UFCS receiver is ill-formed. Shared: `T* p = &", L->arena);
            m.push_slice(nm, L->arena);
            m.push_cstr("` in the frame and pass `p`. Moved: stop naming `", L->arena);
            m.push_slice(nm, L->arena);
            m.push_cstr("` in the frame", L->arena);
            lw_error(L, sp, m);
            return false;
        }
    }
    return true;
}

/* The arms of a `@parallel` that binds a handle are fibers: the statement
 * ends and the caller walks on while they still run, so each one is handed
 * a snapshot of what it named. Writing that snapshot, taking its address,
 * or calling a method on it reads as work on the caller's object and is
 * not -- the caller never sees it. Named here rather than left to run: the
 * emitted C assigns to a real object, compiles, and quietly drops the work.
 *
 * The `@parallel(h) { ... }` form asks the same question through
 * `pl_dest_body_ok`; this is the bound-handle form of the same site. */
static bool pl_dest_caps_ok(PStep* st, Walker* w, CcParallel p, CCSlice hbase, CcSpan sp) {
    CcLowerer* L = st->L;
    Vec::[CcParallelArm]* armv = &p.arms;
    size_t n = armv->len();
    size_t i;
    for (i = 0; i < n; i++) {
        CcParallelArm* arm = armv->get_ptr(i);
        PScan sc;
        PCapList caps;
        PAsk q;
        CcVisitor v;
        memset(&sc, 0, sizeof(sc));
        sc.st = st;
        sc.w = w;
        sc.caps = vec_new::[PCapRef](L->arena);
        sc.seen = vec_new::[CCSlice](L->arena);
        sc.skip = arm->target;
        memset(&v, 0, sizeof(v));
        v.expr = pl_scan_expr;
        v.env = &sc;
        if (arm->serial) CcStmt_walk(arm->serial, v);
        else if (arm->expr) CcExpr_walk(arm->expr, v);
        caps = sc.caps;
        {
            PCapList* cv = &caps;
            size_t nc = cv->len();
            size_t ci;
            for (ci = 0; ci < nc; ci++) {
                PCap* c = *cv->get_ptr(ci);
                if (hbase.len && slice_eq(c->name, hbase)) c->by_addr = true;
                else if (pl_cap_identity(c->type)) c->by_addr = true;
            }
        }
        memset(&q, 0, sizeof(q));
        q.caps = &caps;
        memset(&v, 0, sizeof(v));
        v.expr = pl_byval_expr;
        v.env = &q;
        if (arm->serial) CcStmt_walk(arm->serial, v);
        else if (arm->expr) CcExpr_walk(arm->expr, v);
        if (!q.hit.len) continue;
        {
            CCSlice nm = q.hit;
            CCString m = cc_string_new();
            m.push_cstr("'", L->arena);
            m.push_slice(nm, L->arena);
            m.push_cstr("' is a dest-bound by-value capture (a copy); assign, address-take, or UFCS receiver is ill-formed. Shared: `T* p = &", L->arena);
            m.push_slice(nm, L->arena);
            m.push_cstr("` in the frame and pass `p`. Moved: stop naming `", L->arena);
            m.push_slice(nm, L->arena);
            m.push_cstr("` in the frame", L->arena);
            lw_error(L, sp, m);
        }
        return false;
    }
    return true;
}

/* ---- one site ----------------------------------------------------------- */

/* What the arms form can carry that this step does not lower. */
/* The leftmost name of a handle expression: `wk` of `wk.h`, `srv` of
 * `srv->app`. An arm that pauses through the handle reaches the caller's
 * own object, so that name is captured by address rather than copied. */
static bool pl_base_name(CcExpr* e, CCSlice* out) {
    CcExpr* inner = NULL;
    if (!e) return false;
    @switch (e->k) {
        case .ident(x): *out = x; return true;
        case .paren(u): inner = u.a; break;
        case .unary(u): inner = u.a; break;
        case .member(m): inner = m.a; break;
        case .index(ix): inner = ix.a; break;
        default: return false;
    }
    return pl_base_name(inner, out);
}

/* `!>.wait()!>`: the tail joins the block where it stands, so the handle
 * the block made is consumed by the time the statement ends. A bare `!>`
 * hands that handle back instead, and something has to be holding it. */
static bool pl_tail_wait_expr(CcExpr* e, void* env) {
    bool* hit = (bool*)env;
    CCSlice nm = cc_slice_empty();
    CCSlice want = cstr_slice("wait");
    @switch (e->k) {
        case .ufcs(u): nm = u.method; break;
        case .member(m): nm = m.name; break;
        default: break;
    }
    if (nm.len && slice_eq(nm, want)) *hit = true;
    return true;
}

static bool pl_tail_waits(CcExpr* tail) {
    CcVisitor v;
    bool hit = false;
    if (!tail) return false;
    memset(&v, 0, sizeof(v));
    v.expr = pl_tail_wait_expr;
    v.env = &hit;
    CcExpr_walk(tail, v);
    return hit;
}

/* `} !> @destroy [{ D }]` after the block: the hook the bind carries. */
typedef struct PTailDestroy { bool hit; CcStmt* body; } PTailDestroy;

static bool pl_tail_destroy_expr(CcExpr* e, void* env) {
    PTailDestroy* td = (PTailDestroy*)env;
    @switch (e->k) {
        case .unwrap_destroy(ud): td->hit = true; td->body = ud.destroy_body; break;
        default: break;
    }
    return true;
}

static bool pl_tail_destroys(CcExpr* tail, CcStmt** body) {
    CcVisitor v;
    PTailDestroy td;
    if (!tail) return false;
    memset(&td, 0, sizeof(td));
    memset(&v, 0, sizeof(v));
    v.expr = pl_tail_destroy_expr;
    v.env = &td;
    CcExpr_walk(tail, v);
    if (body) *body = td.body;
    return td.hit;
}

/* The handle a site declares: hoisted above the block, into the list the
 * block sits in, with the `@destroy` the tail wrote on the declaration. */
static PBind* pl_bind_new(PStep* st, CcStmt* s, CcParallel p, CcSpan sp) {
    CcLowerer* L = st->L;
    PBind* b = cc_arena_alloc(L->arena, sizeof(PBind), _Alignof(PBind));
    memset(b, 0, sizeof(*b));
    b->at = s;
    b->name = p.bind;
    b->type = p.bind_type ? p.bind_type : cc_type_named(cstr_slice("CCParallel"), sp, L->arena);
    b->destroy = pl_tail_destroys(p.tail, &b->destroy_body);
    return b;
}

/* An arm that waits on the very handle the block is filling. The arms run
 * before the block joins, so the wait is on a block that has not begun to
 * join: it waits for itself. */
static bool pl_self_wait_expr(CcExpr* e, void* env) {
    PAsk* q = (PAsk*)env;
    CCSlice nm = cc_slice_empty();
    CCSlice want = cstr_slice("wait");
    CCSlice base = cc_slice_empty();
    CcExpr* recv = NULL;
    @switch (e->k) {
        case .ufcs(u): nm = u.method; recv = u.recv; break;
        default: break;
    }
    if (!recv || !slice_eq(nm, want)) return true;
    if (!pl_base_name(recv, &base)) return true;
    if (slice_eq(base, q->want)) q->hit = base;
    return true;
}

static bool pl_arm_self_waits(CcExpr* e, CcStmt* s, CCSlice name) {
    CcVisitor v;
    PAsk q;
    if (!name.len) return false;
    memset(&q, 0, sizeof(q));
    q.want = name;
    memset(&v, 0, sizeof(v));
    v.expr = pl_self_wait_expr;
    v.env = &q;
    if (e) CcExpr_walk(e, v);
    if (s) CcStmt_walk(s, v);
    return q.hit.len != 0;
}

/* How a site names the handle it fills. `CCParallel h = @parallel …`
 * declares one; `h = @parallel …` and `wk.h = @parallel …` name one that
 * already exists. Both are the caller's own -- the arms pause and resume
 * through its address -- so the step carries the C the handle reads as and
 * reaches it the same way either way. Only the declaration differs, and
 * that is what `declared` is for. */
static CCSlice pl_handle_spell(CcLowerer* L, CcParallel p, bool* declared, CCSlice* base) {
    *declared = false;
    *base = cc_slice_empty();
    if (p.bind.len) {
        *declared = true;
        *base = p.bind;
        return p.bind;
    }
    if (p.target) {
        CCString sp2 = lw_spell_expr(L, p.target);
        (void)pl_base_name(p.target, base);
        return lw_keep(L, &sp2);
    }
    return cc_slice_empty();
}

static bool pl_reject(CcLowerer* L, CcParallel p, CcSpan sp) {
    CCString m;
    if (p.spawn && (p.pred || p.seq)) {
        /* a gate that denies runs the arms on the caller in order, which is
         * the one schedule `spawn` says this site does not have */
        m = @string(`'${"@"}parallel spawn' does not take a gate: a denied site runs its arms in order, which is what 'spawn' rules out`, L->arena);
        lw_error(L, sp, m);
        return true;
    }
    if ((p.pred || p.seq) && (p.bind.len || p.target)) {
        m = @string(`a gated '${"@"}parallel' that also binds a handle is not lowered by the clean lowerer yet: the sequential schedule has nothing to hand back`, L->arena);
        lw_error(L, sp, m);
        return true;
    }
    if (p.wait || p.cache.len()) {
        /* Assembled rather than templated: the message carries backticks,
         * which close a template, and an `@`, which reads as a sigil. */
        m = cc_string_new();
        cc_string_push_cstr(&m, "@parallel wait (...) [cache (...)] requires `for (name in lo..hi)`", L->arena);
        lw_error(L, sp, m);
        return true;
    }
    if (p.worker.len) {
        m = @string(`'${"@"}parallel' with 'worker' is not lowered by the clean lowerer yet`, L->arena);
        lw_error(L, sp, m);
        return true;
    }
    return false;
}

static CcStmt* pl_unwrap_stmt(CcLowerer* L, CcExpr* call, CcSpan sp);

/* `@err(e);` forwards to the handler in scope the way a bare `!>` does. */
static bool pl_err_fwd_stmt(CcStmt* s, void* env) {
    bool* hit = (bool*)env;
    @switch (s->k) {
        case .err_fwd: *hit = true; break;
        default: break;
    }
    return true;
}

/* A body whose error reaches nothing of its own -- a bare `!>`, or an
 * `@err(e);` forward -- and so raises through the join. A block that opens
 * with a handler of its own belongs to that one. */
static bool pl_body_raises(CcStmt* body) {
    CcVisitor v;
    bool hit = false;
    if (!body) return false;
    if (pl_block_has_handler(body)) return false;
    memset(&v, 0, sizeof(v));
    v.expr = pl_bare_unwrap_expr;
    v.stmt = pl_err_fwd_stmt;
    v.env = &hit;
    CcStmt_walk(body, v);
    return hit;
}

static bool pl_arm_raises(CcParallelArm* arm) {
    if (!arm->serial) return false;
    return pl_body_raises(arm->serial);
}

/* The error type the exit cell carries: the one the handlers of the
 * function take. The join raises the cell into the innermost handler in scope after
 * the block, so every handler the function carries has to take that one
 * type, or the arm could not say which of them the cell is for. Empty when
 * there is none or they disagree, with the diagnostic emitted. */
static CCSlice pl_eh_type(PStep* st, CcSpan sp) {
    CcLowerer* L = st->L;
    CCSlice canon = cc_slice_empty();
    size_t n = st->eh_top.len();
    size_t i;
    for (i = 0; i < n; i++) {
        CcStmt* t = *st->eh_top.get_ptr(i);
        CcType* et = NULL;
        CCSlice c;
        @switch (t->k) {
            case .errhandler(x): et = x.err_type; break;
            default: break;
        }
        if (!et) continue;
        c = L->ix->canon(et);
        if (!canon.len) canon = c;
        else if (!slice_eq(canon, c)) {
            CCString m = @string(`a bare '!>' in this arm raises after the join into the handler of the function it stands in, and that function declares handlers for both '${canon}' and '${c}'; handle the Result in the arm with '!>(e) { ... }'`, L->arena);
            lw_error(L, sp, m);
            return cc_slice_empty();
        }
    }
    if (!canon.len) {
        CCString m = cc_string_new();
        m.push_cstr("an arm that unwraps needs an @errhandler on the function it stands in", L->arena);
        lw_error(L, sp, m);
    }
    return canon;
}

/* `@errhandler(E __cc_pe) { <claim>; <leave> }`: the handler an arm that
 * raises opens with. It is not the handler the function carries and holds
 * none of that body: it records the error in the exit cell, first arrival winning, and
 * leaves the arm -- to the join on the caller, out of the thunk elsewhere.
 * The join then raises what the cell holds into the one handler the
 * function emits. `cell` is the pointer the arm reaches the cell through;
 * `leave` is the statement that ends the arm once the cell is claimed. */
static CcStmt* pl_raise_handler(CcLowerer* L, CCSlice ety, CCSlice cell, CcStmt* leave, CcSpan sp) {
    CcStmt* s = cc__stmt_blank(sp, L->arena);
    CcStmt* body = lw_block(L, sp);
    CcErrhandler eh;
    CCString claim = @string(`{ int __cc_z = 0; while (!cc_atomic_cas(&${cell}->lock, &__cc_z, 1)) __cc_z = 0; if (cc_atomic_load(&${cell}->xk) < 2) { ${cell}->err = __cc_pe; cc_atomic_store(&${cell}->xk, 3); } cc_atomic_store(&${cell}->lock, 0); }`, L->arena);
    lw_push(body, lw_expr_stmt(L, lw_text(L, claim, sp), sp));
    lw_push(body, leave);
    eh.err_type = cc_type_named(ety, sp, L->arena);
    eh.binder = cstr_slice("__cc_pe");
    eh.body = body;
    { CcStmtK sk = { .errhandler = eh }; s->k = sk; }
    return s;
}

/* The handler goes first in the arm block, ahead of the statement that
 * unwraps. It is added after the exit rewriting has walked the arm, so the
 * `return` it ends in is its own and not an exit the cell records. */
static void pl_arm_open_with(CcLowerer* L, CcStmt* body, CcStmt* handler) {
    CcStmtList* bs = lw_block_stmts(body);
    CcStmtList joined = vec_new::[CcStmtRef](L->arena);
    size_t n;
    size_t i;
    if (!bs) return;
    n = bs->len();
    joined.push(handler);
    for (i = 0; i < n; i++) {
        CcStmt* t = *bs->get_ptr(i);
        joined.push(t);
    }
    *bs = joined;
}

/* `@errhandler((<cell>.err));` after the join: the error an arm recorded,
 * raised where the block stands, into the handler the function carries. The
 * delegation spelling is the statement form of `!>`: the handler runs and,
 * unless it leaves, the statement after the block follows. */
static CcStmt* pl_raise_after_join(CcLowerer* L, CCSlice cellv, CcSpan sp) {
    CcStmt* then = lw_block(L, sp);
    CcStmt* fw = cc__stmt_blank(sp, L->arena);
    CcErrFwd fe;
    CCString cnd = @string(`cc_atomic_load(&${cellv}.xk) == 3`, L->arena);
    fe.err = lw_paren(L, lw_member(L, lw_ident(L, cellv, sp), "err", sp), sp);
    fe.delegate = true;
    { CcStmtK sk = { .err_fwd = fe }; fw->k = sk; }
    lw_push(then, fw);
    return lw_if(L, lw_text(L, cnd, sp), then, NULL, sp);
}

/* `e !>;` as an arm, and any arm whose block unwraps.
 *
 * `e !>;` is the statement, not the operand with the unwrap dropped: the
 * handler in scope is where the error goes. So the arm becomes a block.
 *
 * An arm block that unwraps does not run where the handler of the function
 * stands: all but the first run in thunks of their own, and even the first
 * has to leave through the join rather than out of the frame while the arms
 * behind it run. The handler is emitted once, where the results step puts
 * it, and the arm reaches it by way of the exit cell: `pl_lower` opens the
 * arm with a handler that records the error and leaves, and raises the
 * record after the join. Here the arm is only checked for a handler to
 * raise into. */
static bool pl_arm_unfold_unwrap(PStep* st, CcParallelArm* arm) {
    CcLowerer* L = st->L;
    if (arm->unwrap && arm->expr) {
        CcStmt* ser;
        CcBlock sb;
        sb.stmts = vec_new::[CcStmtRef](L->arena);
        sb.stmts.push(pl_unwrap_stmt(L, arm->expr, arm->span));
        ser = cc__stmt_blank(arm->span, L->arena);
        { CcStmtK sk = { .serial = sb }; ser->k = sk; }
        arm->serial = ser;
        arm->expr = NULL;
        arm->unwrap = false;
    }
    if (!pl_arm_raises(arm)) return true;
    if (!st->eh_any) {
        CCString m = cc_string_new();
        m.push_cstr("an arm that unwraps needs an @errhandler on the function it stands in", L->arena);
        lw_error(L, arm->span, m);
        return false;
    }
    return true;
}

static bool pl_arm_ok(CcLowerer* L, CcParallelArm* arm, CcSpan sp) {
    CCString m;
    if (!arm->expr && !arm->serial) {
        m = @string(`an empty '${"@"}parallel' arm`, L->arena);
        lw_error(L, sp, m);
        return false;
    }
    return true;
}

/* `@parallel { arms } [tail]` under `#pragma(@parallel) off`: the arms run
 * where the block stands, in the order they were written, on the frame the
 * caller already has. Nothing is spawned, nothing is denied, and a gate --
 * `(pred)` or `seq (cond)` -- is not evaluated at all: this schedule is the
 * one it would have chosen, so asking it costs a call nothing reads.
 *
 * A site that binds a handle still plants one, so `h.fail(e)` and
 * `h.cancel()` inside an arm behave and a later `h.wait()` reports what
 * they recorded. It is joined where the block ends, because by then every
 * arm has finished: `h.live()` is false from the next statement on.
 *
 * The tail goes with the statement it was written on. There is no task to
 * wait for, so there is nothing for `!>.wait()!>` to join. */
static void pl_lower_inert(PStep* st, CcStmt* s, CcParallel p) {
    CcLowerer* L = st->L;
    CcSpan sp = s->span;
    Vec::[CcParallelArm]* armv = &p.arms;
    size_t n = armv->len();
    size_t i;
    CcStmt* blk = lw_block(L, sp);
    bool hdeclared = false;
    CCSlice hbase = cc_slice_empty();
    CCSlice hspell = pl_handle_spell(L, p, &hdeclared, &hbase);
    if (hspell.len)
        lw_push(blk, lw_expr_stmt(L, lw_assign(L, lw_ident(L, hspell, sp),
                                               lw_call0(L, cstr_slice("cc_parallel_dest"), sp), sp), sp));
    for (i = 0; i < n; i++) {
        CcParallelArm* arm = armv->get_ptr(i);
        if (arm->serial) {
            lw_push(blk, pl_serial_body(L, arm->serial));
        } else if (arm->unwrap) {
            /* the arm stands on the frame the caller has, so its `!>`
             * reaches the handler this function already carries: no copy */
            lw_push(blk, pl_unwrap_stmt(L, arm->expr, arm->span));
        } else {
            CcExpr* e0 = arm->expr;
            if (arm->target.len) e0 = lw_assign(L, lw_ident(L, arm->target, sp), e0, sp);
            lw_push(blk, lw_expr_stmt(L, e0, sp));
        }
    }
    if (hspell.len) {
        /* parenthesised because the handle may be written `*hp`, and the
         * member would otherwise bind before the dereference */
        CCString j = @string(`(${hspell}).joined = 1`, L->arena);
        lw_push(blk, lw_expr_stmt(L, lw_text(L, j, sp), sp));
    }
    if (hdeclared) {
        /* the handle outlives the block, so its declaration is hoisted
         * above it, into the list the block sits in */
        PBind* b = pl_bind_new(st, s, p, sp);
        st->binds.push(b);
    }
    s->k = blk->k;
    st->any = true;
}

static void pl_lower(PStep* st, CcStmt* s, CcParallel p) {
    CcLowerer* L = st->L;
    Walker* w = st->w;
    CcSpan sp = s->span;
    Vec::[CcParallelArm]* armv = &p.arms;
    size_t n = armv->len();
    size_t i;
    size_t first = 1;           /* the first arm the runtime is offered; 0 when none stays on the caller */
    uint32_t id;
    CcStmt* blk;
    CCSlice hspell;
    CCSlice hbase;
    bool hdeclared;
    CcExpr* gate;
    bool gated;
    CCSlice gname;
    CCSlice pj_ty = cc_slice_empty();       /* the exit cell's type, when there is one */
    CCSlice pj_var = cc_slice_empty();      /* the cell itself, on the caller */
    CCSlice pj_ptr = cc_slice_empty();      /* what the caller's arm claims through */
    CCSlice pj_leave = cc_slice_empty();    /* where a caller-arm exit jumps to */
    CCSlice pj_rty = cc_slice_empty();
    CCSlice pj_ety = cc_slice_empty();      /* the error the cell carries, when an arm raises */
    bool pj_any = false;
    bool raise_any = false;
    /* Inert or not, the site is checked as written: `off` says which
     * schedule the arms run on, not which forms are legal. */
    bool inert = pl_par_off_at(st, sp.first);
    if (pl_reject(L, p, sp)) return;
    if (!n) {
        /* an empty block would run and join nothing, which is what the
         * caller asked for only by accident */
        CCString m = @string(`${"@"}parallel needs at least one arm`, L->arena);
        lw_error(L, sp, m);
        return;
    }
    for (i = 0; i < n; i++) {
        CcParallelArm* arm = armv->get_ptr(i);
        /* an inert arm runs where it stands, so it reaches the handler
         * this function carries and needs no cell to raise through */
        if (!inert && !pl_arm_unfold_unwrap(st, arm)) return;
        if (!pl_arm_ok(L, arm, sp)) return;
    }
    {
        /* The block is `CCParallel !>(CCError)`, and the handle it makes
         * has to reach someone. `!>.wait()!>` joins it here; a bind or an
         * assignment keeps it live for a later join. A bare `!>` has
         * neither, so the arms would run with nothing able to wait. */
        bool waits = pl_tail_waits(p.tail);
        bool held = p.bind.len != 0 || p.target != NULL;
        if (!p.tail) {
            CCString m = cc_string_new();
            m.push_cstr("@parallel {…} is CCParallel !>(CCError); unconsumed Result", L->arena);
            lw_error(L, sp, m);
            return;
        }
        if (!waits && !held) {
            CCString m = cc_string_new();
            m.push_cstr("@parallel {…} !>; discards the handle; bind CCParallel h = … !>; or !>.wait()!>", L->arena);
            lw_error(L, sp, m);
            return;
        }
        if (!p.bind.len && pl_tail_destroys(p.tail, NULL)) {
            /* the hook goes on a declaration, and an assignment join has
             * none of its own to carry it */
            CCString m = cc_string_new();
            m.push_cstr("'!> @destroy' on an assignment join has no declaration to attach the hook to; write 'CCParallel h = @parallel { ... } !> @destroy;'", L->arena);
            lw_error(L, sp, m);
            return;
        }
        if (held && !waits) {
            CcParallelArm* a0 = armv->get_ptr(0);
            CCSlice hb = cc_slice_empty();
            if (n == 1 && !a0->serial && a0->target.len) {
                /* the one arm is the kick, and an assignment kick runs on
                 * the caller: by the time the statement ends the handle
                 * names nothing that is still running. A bare expression
                 * arm is the worker instead, and is spawned. */
                CCString m = cc_string_new();
                m.push_cstr("this dest is never live on the caller", L->arena);
                lw_error(L, sp, m);
                return;
            }
            /* a dest-live one-arm construct has no kick: that arm is the
             * worker, spawned and attached, and the dest is live on the
             * caller from the binding on (spec 8.11.1) */
            if (n == 1) first = 0;
            if (p.bind.len) hb = p.bind;
            else (void)pl_base_name(p.target, &hb);
            for (i = 0; i < n; i++) {
                CcParallelArm* arm = armv->get_ptr(i);
                if (!pl_arm_self_waits(arm->expr, arm->serial, hb)) continue;
                {
                    CCString m = cc_string_new();
                    m.push_cstr("cannot .wait() the same @parallel handle from an arm of it", L->arena);
                    lw_error(L, sp, m);
                }
                return;
            }
        }
    }
    if (inert) {
        pl_lower_inert(st, s, p);
        return;
    }
    id = st->next_id++;
    blk = lw_block(L, sp);
    hspell = pl_handle_spell(L, p, &hdeclared, &hbase);
    /* An arm that leaves for a thunk is gone by the time the walk reaches
     * the statement, so whatever `@parallel` it holds is lowered here,
     * first. The arms of a bound construct are dest bodies, the caller-run
     * first one included: an attach inside one ends the fiber on a refused
     * admit, and no jump leaves one. */
    for (i = 0; i < n; i++) {
        CcParallelArm* arm = armv->get_ptr(i);
        if (!arm->serial) continue;
        if (i < first && !hspell.len) continue;
        if (hspell.len) st->dest_depth++;
        tw_stmt(w, arm->serial);
        if (hspell.len) st->dest_depth--;
        if (hspell.len && !pl_dest_body_stays(st, pl_serial_body(L, arm->serial))) return;
    }
    for (i = 0; i < n; i++) {
        CcParallelArm* arm = armv->get_ptr(i);
        CcStmt* valued = pl_arm_first_return(arm->expr, arm->serial, true);
        if (valued && hspell.len) {
            /* the arms of a bound block are fibers of the handle: the
             * caller went on, and there is no frame left waiting on this
             * one to hand a value to */
            CCString m = cc_string_new();
            m.push_cstr("return with a value in a dest body; `return;` ends the fiber, `h.fail(e)` records an error", L->arena);
            lw_error(L, valued->span, m);
            return;
        }
        if (pl_arm_first_return(arm->expr, arm->serial, false)) pj_any = true;
        if (pl_arm_raises(arm)) {
            if (hspell.len) {
                /* the arms of a bound block are fibers of the handle: the
                 * frame has moved on by the time this one errs, and the
                 * handler it carries is not reachable from a fiber */
                CCString m = cc_string_new();
                m.push_cstr("!> in a dest body has no handler inside the body: the arm of a dest-bound @parallel runs after the frame has moved on; handle the Result in the arm with '!>(e) { h.fail(e); return; }' or open the arm with '@errhandler(CCError e) { ... }'", L->arena);
                lw_error(L, arm->span, m);
                return;
            }
            raise_any = true;
        }
    }
    if (hspell.len && !pl_dest_caps_ok(st, w, p, hbase, sp)) return;
    if (raise_any) {
        pj_ety = pl_eh_type(st, sp);
        if (!pj_ety.len) return;
    }
    if ((pj_any || raise_any) && first == 1) {
        /* an exit needs the join only where an arm runs on the caller: a
         * spawned worker with no kick leaves its thunk and nothing else */
        pj_leave = pl_pj_name(L, id, "_join");
        if (!hspell.len) {
            pj_rty = pl_ret_type(st);
            pj_ty = pl_join_type(L, id);
            pj_var = pl_pj_name(L, id, "");
            pj_ptr = pl_pj_name(L, id, "_p");
        }
    }
    if (pj_any && !pj_rty.len && !hspell.len) {
        for (i = 0; i < n; i++) {
            CcParallelArm* arm = armv->get_ptr(i);
            CcStmt* valued = pl_arm_first_return(arm->expr, arm->serial, true);
            if (!valued) continue;
            {
                CCString m = cc_string_new();
                m.push_cstr("a '@parallel' arm hands back a value the join has nowhere to put: the exit cell is typed by what the function the arms stand in returns", L->arena);
                lw_error(L, valued->span, m);
            }
            return;
        }
    }
    if (pj_ty.len) {
        /* the cell stands above every function that fills one, because an
         * arm's environment names it */
        CCSlice rv = pj_rty;
        CCSlice ev = pj_ety;
        CCString t;
        CCString ef = cc_string_new();
        /* `xk`: 0 nothing yet, 2 an arm returned (`rv`), 3 an arm raised
         * (`err`); whichever claims first is the exit the block takes */
        if (ev.len) ef = @string(` ${ev} err;`, L->arena);
        if (rv.len) t = @string(`typedef struct { cc_atomic_int lock; cc_atomic_int xk; ${rv} rv;${ef} } ${pj_ty};
`, L->arena);
        else t = @string(`typedef struct { cc_atomic_int lock; cc_atomic_int xk;${ef} } ${pj_ty};
`, L->arena);
        pl_host(st); st->fwd.push_slice(t.as_slice(), L->arena);
    }
    if (hspell.len) {
        /* the handle is the caller's: the block fills it and leaves it live */
        lw_push(blk, lw_expr_stmt(L, lw_assign(L, lw_ident(L, hspell, sp),
                                               lw_call0(L, cstr_slice("cc_parallel_dest"), sp), sp), sp));
    }
    lw_push(blk, lw_decl_stmt(L, cc_type_pointer(cc_type_named(cstr_slice("CCParTls"), sp, L->arena), sp, L->arena),
                              cstr_slice("__cc_pt"), lw_call0(L, cstr_slice("cc__par_tls"), sp), sp));
    if (pj_ty.len) {
        CcType* pt = cc_type_pointer(cc_type_named(pj_ty, sp, L->arena), sp, L->arena);
        CcExpr* addr = cc_expr_unary(CC_OP_ADDR, lw_ident(L, pj_var, sp), sp, L->arena);
        lw_push(blk, lw_decl_stmt(L, cc_type_named(pj_ty, sp, L->arena), pj_var, NULL, sp));
        pl_zero(L, blk, pj_var, sp);
        lw_push(blk, lw_decl_stmt(L, pt, pj_ptr, addr, sp));
    }
    gate = p.pred ? p.pred : p.seq;
    gated = gate != NULL;
    gname = gated ? pl_gate_name(L, id) : cc_slice_empty();
    if (!gated) {
        CcExpr* who = lw_text(L, @string(`NULL`, L->arena), sp);
        if (hspell.len) who = cc_expr_unary(CC_OP_ADDR, lw_paren(L, lw_ident(L, hspell, sp), sp), sp, L->arena);
        lw_push(blk, lw_expr_stmt(L, lw_call2(L, cstr_slice("cc_parallel_deny_enter"),
                                              lw_ident(L, cstr_slice("__cc_pt"), sp), who, sp), sp));
    }
    /* every arm but the first is offered to the runtime -- the first too,
     * when it is the one worker of a dest-live construct */
    for (i = first; i < n; i++) {
        CcParallelArm* arm = armv->get_ptr(i);
        PScan sc;
        PCapList caps;
        CCSlice out_type = cc_slice_empty();
        memset(&sc, 0, sizeof(sc));
        sc.st = st;
        sc.w = w;
        sc.caps = vec_new::[PCapRef](L->arena);
        sc.seen = vec_new::[CCSlice](L->arena);
        sc.skip = arm->target;
        {
            CcVisitor v;
            memset(&v, 0, sizeof(v));
            v.expr = pl_scan_expr;
            v.env = &sc;
            if (arm->serial) CcStmt_walk(arm->serial, v);
            else CcExpr_walk(arm->expr, v);
        }
        caps = sc.caps;
        {
            /* the handle the arms pause and resume through is the
             * caller's: a copy of it is a handle nothing else can see.
             * So is anything else that is its own identity -- an atomic an
             * arm adds to is the caller's counter, or it counts nothing. */
            PCapList* cv = &caps;
            size_t nc = cv->len();
            size_t ci;
            for (ci = 0; ci < nc; ci++) {
                PCap* c = *cv->get_ptr(ci);
                if (hbase.len && slice_eq(c->name, hbase)) c->by_addr = true;
                else if (pl_cap_identity(c->type)) c->by_addr = true;
            }
        }
        if (arm->serial) {
            CcVisitor v;
            PAsk sh;
            memset(&sh, 0, sizeof(sh));
            sh.caps = &caps;
            memset(&v, 0, sizeof(v));
            v.stmt = pl_shadow_stmt;
            v.env = &sh;
            CcStmt_walk(arm->serial, v);
            if (sh.hit.len) {
                CCSlice nm = sh.hit;
                CCString m = @string(`the arm reads '${nm}' from the enclosing scope and declares one of its own; the clean lowerer does not lower an arm that shadows what it captures`, L->arena);
                lw_error(L, sp, m);
                return;
            }
        }
        if (arm->target.len) {
            CcType* t = sc_lookup(w, arm->target);
            if (!t) {
                CCSlice nm = arm->target;
                CCString m = @string(`the arm assigns to '${nm}', which is not declared in the enclosing scope`, L->arena);
                lw_error(L, sp, m);
                return;
            }
            out_type = L->ix->canon(t);
        }
        {
            /* the caller builds the environment, so its type is declared
             * with the forwards, above every function that fills one */
            CCString et = pl_env_text(st, id, (uint32_t)i, &caps, out_type, hspell.len != 0, pj_ty);
            pl_host(st); st->fwd.push_slice(et.as_slice(), L->arena);
        }
        pl_forward(st, id, (uint32_t)i);
        {
            CCSlice pj_cell = cc_slice_empty();
            CcStmt* ab = pl_serial_body(L, arm->serial);
            CcDecl* th;
            if (pj_ty.len) pj_cell = cstr_slice("__e->__cc_pj_ex");
            th = pl_thunk_decl(st, id, (uint32_t)i, &caps, arm->expr, ab,
                               out_type, arm->target, hspell.len != 0, pj_cell,
                               pj_rty.len != 0, sp);
            /* a bare `!>` in the thunk records its error in the cell and
             * ends the thunk; the join raises it on the caller */
            if (pl_arm_raises(arm))
                pl_arm_open_with(L, ab, pl_raise_handler(L, pj_ety, pj_cell,
                                                         cc_stmt_return(lw_text(L, @string(`NULL`, L->arena), sp), sp, L->arena), sp));
            st->made.push(th);
            /* a bound handle makes the arms fibers of a dest */
            if (hspell.len) {
                CcDeclList* dv = &L->dest_bodies;
                dv->push(th);
            }
        }
        pl_env_stmts(L, blk, id, (uint32_t)i, &caps, arm->target, hspell, pj_ptr, sp);
        if (!gated) pl_fire_stmts(L, blk, id, (uint32_t)i, hspell, p.spawn, sp);
    }
    if (gated) {
        /* One test, once: true when the arms run in order. The arms
         * themselves are emitted once either way -- this chooses the route
         * to them, not a second copy of them, because the bodies have
         * already been rewritten in place for the thunk. */
        CcStmt* fire = lw_block(L, sp);
        lw_push(blk, lw_decl_stmt(L, cc_type_named(cstr_slice("int"), sp, L->arena), gname,
                                  lw_not(L, lw_paren(L, gate, sp), sp), sp));
        lw_push(fire, lw_expr_stmt(L, lw_call2(L, cstr_slice("cc_parallel_deny_enter"),
                                               lw_ident(L, cstr_slice("__cc_pt"), sp),
                                               lw_text(L, @string(`NULL`, L->arena), sp), sp), sp));
        for (i = first; i < n; i++) pl_fire_stmts(L, fire, id, (uint32_t)i, hspell, false, sp);
        lw_push(blk, lw_if(L, lw_not(L, lw_ident(L, gname, sp), sp), fire, NULL, sp));
    }
    /* the first arm stays here -- unless it is the one worker of a
     * dest-live construct, which has no kick: that arm was spawned and
     * attached above, and the caller goes on past the binding */
    if (first == 1) {
        CcParallelArm* arm = armv->get_ptr(0);
        /* it reads the caller's own names, so its exit is spelled as
         * written -- and it leaves through the join, not out of the
         * function, because the arms behind it are still running */
        if (pj_any) pl_arm_exits(L, arm->expr, arm->serial, pj_ptr, pj_leave, pj_rty.len != 0);
        if (arm->serial) {
            CcStmt* ab = pl_serial_body(L, arm->serial);
            /* a bare `!>` here records its error in the cell and goes to
             * the join: the handler it raises into stands on this frame,
             * but a `return` from it would leave while the arms behind
             * this one run */
            if (pl_arm_raises(arm))
                pl_arm_open_with(L, ab, pl_raise_handler(L, pj_ety, pj_ptr, lw_goto(L, pj_leave, sp), sp));
            lw_push(blk, ab);
        } else {
            CcExpr* e0 = arm->expr;
            if (arm->target.len) e0 = lw_assign(L, lw_ident(L, arm->target, sp), e0, sp);
            lw_push(blk, lw_expr_stmt(L, e0, sp));
        }
    }
    if (pj_leave.len) lw_push(blk, lw_label(L, pj_leave, lw_block(L, sp), sp));
    if (gated) {
        CcStmt* joins = lw_block(L, sp);
        CcStmt* order = lw_block(L, sp);
        for (i = first; i < n; i++) pl_join_stmts(L, joins, id, (uint32_t)i, false, sp);
        lw_push(joins, lw_expr_stmt(L, lw_call1(L, cstr_slice("cc_parallel_deny_leave"),
                                                lw_ident(L, cstr_slice("__cc_pt"), sp), sp), sp));
        /* nothing was denied on this schedule, so no note: the arms simply
         * run after the first, in the order they were written */
        for (i = first; i < n; i++) pl_inline_call(L, order, id, (uint32_t)i, sp);
        if (pj_ty.len) {
            /* an arm that left ended the block, and on this schedule the
             * arms behind it were never started: they do not start now */
            CCSlice cellv = pj_var;
            CCString c = @string(`cc_atomic_load(&${cellv}.xk) < 2`, L->arena);
            order = lw_if(L, lw_text(L, c, sp), order, NULL, sp);
        }
        lw_push(blk, lw_if(L, lw_not(L, lw_ident(L, gname, sp), sp), joins, order, sp));
    } else if (!hspell.len) {
        /* the block joins before it ends; a bound handle joins later */
        for (i = first; i < n; i++) pl_join_stmts(L, blk, id, (uint32_t)i, p.spawn, sp);
        lw_push(blk, lw_expr_stmt(L, lw_call1(L, cstr_slice("cc_parallel_deny_leave"),
                                              lw_ident(L, cstr_slice("__cc_pt"), sp), sp), sp));
    } else if (hdeclared) {
        /* the block declares it, so it is hoisted above the block */
        PBind* b = pl_bind_new(st, s, p, sp);
        st->binds.push(b);
    }
    if (pj_ty.len) {
        /* every arm has finished, so whichever exit arrived first is the
         * one the block leaves through */
        CCSlice cellv = pj_var;
        CCString t;
        if (pj_ety.len) lw_push(blk, pl_raise_after_join(L, cellv, sp));
        /* the return an arm claimed, when any arm returns: a cell that only
         * carries a raise has no value to hand back, and a function that
         * returns a Result has no C spelling for one here -- said, not
         * returned as nothing */
        if (pj_any && pl_fn_returns_result(st)) {
            CCString m = @string(`a 'return' from a '${"@"}parallel' arm in a function returning a Result is not lowered: hand the value back through an arm destination and return it after the join`, L->arena);
            lw_error(L, sp, m);
            return;
        }
        if (pj_any) {
            if (pj_rty.len) t = @string(`if (cc_atomic_load(&${cellv}.xk) == 2) return ${cellv}.rv`, L->arena);
            else t = @string(`if (cc_atomic_load(&${cellv}.xk) == 2) return`, L->arena);
            lw_push(blk, lw_expr_stmt(L, lw_text(L, t, sp), sp));
        }
    }
    s->k = blk->k;
    st->any = true;
}

/* `@parallel(h) { body }`: one more arm on a handle that already exists.
 *
 * The handle was bound by an earlier `@parallel spawn { … } !>`, and this
 * hands it another arm — same environment, same thunk, same admit as an
 * arm of a bound block, minus everything that belongs to opening one:
 * nothing creates the dest, nothing joins at the end, and nothing enters
 * the deny scope, because the block that did those still owns them.
 *
 * The captures are the bound shape: a copy taken when the arm starts,
 * except the handle itself, which is the caller's own. */
static CcExpr* pl_admit_call(CcLowerer* L, CCSlice bind, CcSpan sp) {
    return lw_call1(L, cstr_slice("cc_parallel_admit_ok"),
                    cc_expr_unary(CC_OP_ADDR, lw_paren(L, lw_ident(L, bind, sp), sp), sp, L->arena), sp);
}

/* `cc_parallel_admit_ok(&h)` before the admit: a dest that was cancelled
 * takes no more work, and the refusal is `CC_ERR_CANCELLED`. On the frame
 * it is the unwrap the site was written as, into the enclosing handler.
 * Inside a dest body it is a seam, not a user `!>`: the fiber ends. */
static void pl_admit_gate(PStep* st, CcStmt* blk, CCSlice bind, CcSpan sp) {
    CcLowerer* L = st->L;
    if (st->dest_depth > 0) {
        CcType* t = cc__type_blank(sp, L->arena);
        CcTypeofType tf;
        CcStmt* then = lw_block(L, sp);
        CCSlice adm = cstr_slice("__cc_adm");
        tf.expr = pl_admit_call(L, bind, sp);
        tf.type = NULL;
        { CcTypeK tk = { .typeof_ = tf }; t->k = tk; }
        lw_push(blk, lw_decl_stmt(L, t, adm, pl_admit_call(L, bind, sp), sp));
        lw_push(then, cc_stmt_return(NULL, sp, L->arena));
        lw_push(blk, lw_if(L, lw_not(L, lw_member(L, lw_ident(L, adm, sp), "ok", sp), sp), then, NULL, sp));
        return;
    }
    if (st->eh_in_scope == 0) {
        /* no handler above the site: the refusal is reported and the
         * process exits, the default the shadow lowerer gives this seam */
        CcType* t = cc__type_blank(sp, L->arena);
        CcTypeofType tf;
        CcStmt* then = lw_block(L, sp);
        CCSlice adm = cstr_slice("__cc_adm");
        CcExpr* err = lw_member(L, lw_member(L, lw_ident(L, adm, sp), "u", sp), "error", sp);
        tf.expr = pl_admit_call(L, bind, sp);
        tf.type = NULL;
        { CcTypeK tk = { .typeof_ = tf }; t->k = tk; }
        lw_push(blk, lw_decl_stmt(L, t, adm, pl_admit_call(L, bind, sp), sp));
        lw_push(then, lw_expr_stmt(L, lw_call1(L, cstr_slice("cc_error_exit"), err, sp), sp));
        lw_push(blk, lw_if(L, lw_not(L, lw_member(L, lw_ident(L, adm, sp), "ok", sp), sp), then, NULL, sp));
        return;
    }
    lw_push(blk, pl_unwrap_stmt(L, pl_admit_call(L, bind, sp), sp));
}

static void pl_dest(PStep* st, CcStmt* s, CcParallelDest pd) {
    CcLowerer* L = st->L;
    Walker* w = st->w;
    CcSpan sp = s->span;
    CCSlice bind;
    CCSlice hbase = cc_slice_empty();
    uint32_t id;
    CcStmt* blk;
    CcStmt* body;
    PScan sc;
    PCapList caps;
    if (!pd.dest || !pl_base_name(pd.dest, &hbase) || !hbase.len) {
        CCString m = @string(`'${"@"}parallel(h)' needs a handle a name reaches: bind it with 'CCParallel h = ${"@"}parallel spawn { ... } !>;'`, L->arena);
        lw_error(L, sp, m);
        return;
    }
    {
        /* the handle reads as it was written -- a name, a field of one, a
         * field through a pointer -- and the admit is onto the caller's
         * own object either way */
        CCString hs = lw_spell_expr(L, pd.dest);
        bind = lw_keep(L, &hs);
    }
    id = st->next_id++;
    body = lw_block(L, sp);
    {
        CcStmtList* bs = lw_block_stmts(body);
        CcStmtList* src = &pd.stmts;
        size_t n = src->len();
        size_t i;
        for (i = 0; i < n; i++) {
            CcStmt* one = *src->get_ptr(i);
            bs->push(one);
        }
    }
    /* the body leaves for the thunk before the walk reaches the statement:
     * whatever `@parallel` it holds is lowered here, first, as a dest body */
    st->dest_depth++;
    tw_stmt(w, body);
    st->dest_depth--;
    memset(&sc, 0, sizeof(sc));
    sc.st = st;
    sc.w = w;
    sc.caps = vec_new::[PCapRef](L->arena);
    sc.seen = vec_new::[CCSlice](L->arena);
    sc.skip = cc_slice_empty();
    {
        CcVisitor v;
        memset(&v, 0, sizeof(v));
        v.expr = pl_scan_expr;
        v.env = &sc;
        CcStmt_walk(body, v);
    }
    caps = sc.caps;
    {
        PCapList* cv = &caps;
        size_t nc = cv->len();
        size_t ci;
        for (ci = 0; ci < nc; ci++) {
            PCap* c = *cv->get_ptr(ci);
            if (slice_eq(c->name, hbase)) c->by_addr = true;
            else if (pl_cap_identity(c->type)) c->by_addr = true;
        }
    }
    if (!pl_dest_body_ok(st, body, &caps, sp)) return;
    {
        CCString et = pl_env_text(st, id, 0, &caps, cc_slice_empty(), true, cc_slice_empty());
        pl_host(st); st->fwd.push_slice(et.as_slice(), L->arena);
    }
    pl_forward(st, id, 0);
    {
        CcDecl* th = pl_thunk_decl(st, id, 0, &caps, NULL, body, cc_slice_empty(),
                                   cc_slice_empty(), true, cc_slice_empty(), false, sp);
        CcDeclList* dv = &L->dest_bodies;
        st->made.push(th);
        dv->push(th);
    }
    blk = lw_block(L, sp);
    pl_admit_gate(st, blk, bind, sp);
    pl_spawn_stmts(L, blk, id, 0, &caps, cc_slice_empty(), bind, sp);
    s->k = blk->k;
    st->any = true;
}

/* A `@stage` this step already claimed for the walk it belongs to. */
static bool pl_stage_owned(PStep* st, CcStmt* s) {
    CcStmtList* v = &st->stages;
    size_t n = v->len();
    size_t i;
    for (i = 0; i < n; i++) if (*v->get_ptr(i) == s) return true;
    return false;
}

/* A `@stage` below the top level of a walk's body: it orders that walk's
 * tickets, so it has to be a statement of the walk, not of something inside
 * it. Reported here because the walk's own statement is about to be dropped
 * and its body with it. */
static bool pl_stage_visit(CcStmt* s, void* env) {
    PStep* st = (PStep*)env;
    bool is_stage = false;
    @switch (s->k) {
        case .stage: is_stage = true; break;
        default: break;
    }
    if (is_stage) {
        CCString m = cc_string_new();
        cc_string_push_cstr(&m, "@stage must be a top-level statement of a '@parallel wait for' body", st->L->arena);
        lw_error(st->L, s->span, m);
    }
    return true;
}

static void pl_stray_stages(PStep* st, CcStmt* body) {
    CcStmtList* bs = lw_block_stmts(body);
    size_t n;
    size_t i;
    if (!bs) return;
    n = bs->len();
    for (i = 0; i < n; i++) {
        CcStmt* k = *bs->get_ptr(i);
        bool is_stage = false;
        CcVisitor v;
        @switch (k->k) {
            case .stage: is_stage = true; break;
            default: break;
        }
        if (is_stage) continue;   /* a statement of the walk: that is where it belongs */
        memset(&v, 0, sizeof(v));
        v.stmt = pl_stage_visit;
        v.env = st;
        CcStmt_walk(k, v);
    }
}


/* `(T)(e)` as a node. */
static CcExpr* pl_cast(CcLowerer* L, CcType* t, CcExpr* a, CcSpan sp) {
    CcExpr* e = cc__expr_blank(sp, L->arena);
    CcCast ca;
    ca.type = t;
    ca.a = a;
    { CcExprK ek = { .cast = ca }; e->k = ek; }
    return e;
}

/* The site: build the environment, walk the whole span on the caller, then
 * read back whichever exit arrived first. */
static void pl_for_lower(PStep* st, CcStmt* s, CcParallelFor pf, CcRange rg) {
    CcLowerer* L = st->L;
    Walker* w = st->w;
    CcSpan sp = s->span;
    uint32_t id = st->next_id++;
    PScan sc;
    PCapList caps;
    CcStmt* blk = lw_block(L, sp);
    CCSlice env = pl_for_name(L, id, "_env_t");
    CCSlice walk = pl_for_name(L, id, "_walk");
    CCSlice ex = pl_for_ex_type(L, id);
    CCSlice cell = pl_for_name(L, id, "_ex");
    CCSlice ev = pl_for_name(L, id, "_e");
    CCSlice ret_ty = cstr_slice("int");
    CCSlice err_ty = cc_slice_empty();
    bool has_ret = false;
    bool fn_void = false;
    size_t n;
    size_t i;
    if (pf.loop.body) {
        /* The body leaves for the walk function before the outer walk
         * reaches it, so whatever `@parallel` it holds is lowered here,
         * first, in the scope the body was written in -- the binder
         * included, which the inner construct captures as the leaf loop
         * variable of the walk. */
        sc_push(w);
        sc_declare(w, pf.loop.bind, cc_type_named(cstr_slice("int"), sp, L->arena));
        tw_stmt(w, pf.loop.body);
        sc_pop(w);
    }
    if (pl_body_raises(pf.loop.body)) {
        /* a bare `!>` in the body raises after the walk joins, into the
         * handler the frame carries: the cell has to carry its error */
        if (!st->eh_any) {
            CCString m = cc_string_new();
            m.push_cstr("a bare '!>' in a @parallel for body raises after the walk joins, into an @errhandler on the function it stands in, and this function declares none; declare one above the walk or handle the Result in the body with '!>(e) { ... }'", L->arena);
            lw_error(L, sp, m);
            return;
        }
        err_ty = pl_eh_type(st, sp);
        if (!err_ty.len) return;
    }
    memset(&sc, 0, sizeof(sc));
    sc.st = st;
    sc.w = w;
    sc.caps = vec_new::[PCapRef](L->arena);
    sc.seen = vec_new::[CCSlice](L->arena);
    sc.skip = pf.loop.bind;
    {
        CcVisitor v;
        memset(&v, 0, sizeof(v));
        v.expr = pl_scan_expr;
        v.env = &sc;
        if (pf.loop.body) CcStmt_walk(pf.loop.body, v);
    }
    caps = sc.caps;
    n = caps.len();
    for (i = 0; i < n; i++) {
        PCap* c = *caps.get_ptr(i);
        c->by_addr = true;
    }
    if (st->fn_ret) {
        /* the cell a `return` lands in is typed by the function it leaves;
         * a `void` one still needs a cell C can declare, and returns nothing */
        CCSlice rn = L->ix->canon(st->fn_ret);
        CCSlice vd = cstr_slice("void");
        if (rn.len && slice_eq(rn, vd)) fn_void = true;
        else if (rn.len) ret_ty = rn;
    }
    {
        PForExit fx;
        fx.L = L;
        fx.id = id;
        fx.has_ret = false;
        fx.cancel = false;             /* no pool: the halves stop by the cell alone */
        fx.leave = cc_slice_empty();   /* the split walk returns, and that is all */
        if (pf.loop.body) pl_for_exits(&fx, pf.loop.body, 0);
        has_ret = true;
    }
    {
        CCString et = pl_for_env_text(st, id, &caps, ret_ty, err_ty);
        pl_host(st); st->fwd.push_slice(et.as_slice(), L->arena);
    }
    pl_for_forward(st, id);
    st->made.push(pl_for_thunk_decl(st, id, sp));
    st->made.push(pl_for_walk_decl(st, id, &caps, pf.loop, rg.lo, rg.hi, has_ret, err_ty, sp));
    {
        CCString d1 = @string(`${env} ${ev}`, L->arena);
        CCString d2 = @string(`${ex} ${cell}`, L->arena);
        lw_push(blk, lw_expr_stmt(L, lw_text(L, d1, sp), sp));
        lw_push(blk, lw_expr_stmt(L, lw_text(L, d2, sp), sp));
    }
    for (i = 0; i < n; i++) {
        /* nodes, not text: a walk inside another walk is captured by the
         * outer one through these, so the names have to be names it can
         * see and rewrite */
        PCap* c = *caps.get_ptr(i);
        CCSlice cn = c->name;
        CcExpr* slot = cc_expr_member(lw_ident(L, ev, sp), cn, false, sp, L->arena);
        CcExpr* what = lw_paren(L, lw_ident(L, cn, sp), sp);
        if (!pl_for_decayed(c->type)) what = cc_expr_unary(CC_OP_ADDR, what, sp, L->arena);
        lw_push(blk, lw_expr_stmt(L, lw_assign(L, slot, what, sp), sp));
    }
    {
        CCString z = @string(`cc__bytes_zero(&${cell}, sizeof(${cell}))`, L->arena);
        CCString a1 = @string(`${ev}.__cc_pf_ex = &${cell}`, L->arena);
        CCString a2 = @string(`${ev}.__cc_par_h = 0`, L->arena);
        lw_push(blk, lw_expr_stmt(L, lw_text(L, z, sp), sp));
        lw_push(blk, lw_expr_stmt(L, lw_text(L, a1, sp), sp));
        lw_push(blk, lw_expr_stmt(L, lw_text(L, a2, sp), sp));
    }
    {
        /* the bounds as written, so an outer walk sees what they name */
        CcExpr* call = cc_expr_call(lw_ident(L, walk, sp), sp, L->arena);
        CcExprList* args = lw_call_args(call);
        CcType* intt = cc_type_named(cstr_slice("int"), sp, L->arena);
        args->push(pl_cast(L, intt, lw_paren(L, rg.lo, sp), sp));
        args->push(pl_cast(L, intt, lw_paren(L, rg.hi, sp), sp));
        args->push(cc_expr_unary(CC_OP_ADDR, lw_ident(L, ev, sp), sp, L->arena));
        lw_push(blk, lw_expr_stmt(L, call, sp));
    }
    if (err_ty.len) {
        /* a bare `!>` in the walk: the error the first half to err
         * recorded, raised where the walk stands, once every half is done */
        lw_push(blk, pl_raise_after_join(L, cell, sp));
    }
    {
        /* a `return` inside the walk is the caller's to make */
        CcStmt* then = lw_block(L, sp);
        CCString rv = @string(`${cell}.rv`, L->arena);
        CCString cond = @string(`cc_atomic_load(&${cell}.xk) == 2`, L->arena);
        /* inside a dest body the walk stands in a fiber, and the value a
         * `return` there could carry is refused above it: ending the fiber
         * is the whole of the exit */
        if (fn_void || st->dest_depth > 0) lw_push(then, cc_stmt_return(NULL, sp, L->arena));
        else lw_push(then, cc_stmt_return(lw_text(L, rv, sp), sp, L->arena));
        lw_push(blk, lw_if(L, lw_text(L, cond, sp), then, NULL, sp));
    }
    s->k = blk->k;
    st->any = true;
}


/* ---- `@parallel [seq (c)] wait (gate) for (i in lo..hi)` -----------------
 *
 * A walk whose tickets are handed out under a gate: the turnstile caps how
 * many iterations are in flight at once, and a pool of runners the size of
 * that cap takes tickets off a channel in the order the caller sent them.
 * What the body reads it reads by address, the same as the split walk.
 *
 * The body is emitted once, as `__cc_pw_<id>_run`, and every schedule goes
 * through it. When the runtime hands back no runner -- no nursery, a failed
 * allocation, a spawn that never took, or a `seq` that denied the site --
 * the caller calls that same function in ticket order, holding one slot of
 * its own. Nothing about the function changes between the two schedules: it
 * enters nothing (the caller holds the ticket before the call either way),
 * it records into the slot it was handed, and it leaves the turnstile once
 * on the way out however the body ended.
 *
 * A ticket error is a slot, not a jump: the body's `!>` writes the slot,
 * cancels the nursery so the tickets that have not started stop starting,
 * and jumps to the one exit. The site reads the slots after the pool has
 * drained and re-raises the first one where the walk stood. */

static CCSlice pl_pw_name(CcLowerer* L, uint32_t id, const char* suffix) {
    CCString s = @string(`__cc_pw_${id}${suffix}`, L->arena);
    return lw_keep(L, &s);
}

/* C the later steps have nothing to say about: the pool's own plumbing. */
static void pl_pw_text(CcLowerer* L, CcStmt* blk, CCString t, CcSpan sp) {
    lw_push(blk, lw_expr_stmt(L, lw_text(L, t, sp), sp));
}

static CcStmt* pl_pw_for(CcLowerer* L, CCString init, CCString cond, CCString step,
                         CcStmt* body, CcSpan sp) {
    CcFor fl;
    CcStmt* fs;
    memset(&fl, 0, sizeof(fl));
    fl.init_decl = NULL;
    fl.init_expr = lw_text(L, init, sp);
    fl.cond = lw_text(L, cond, sp);
    fl.step = lw_text(L, step, sp);
    fl.body = body;
    fl.more = vec_new::[CcStmtRef](L->arena);
    fs = cc__stmt_blank(sp, L->arena);
    { CcStmtK sk = { .for_ = fl }; fs->k = sk; }
    return fs;
}

/* What the site, the runners and the body all read: the gate and the
 * nursery the pool shares, one slot per runner for the error it saw, the
 * argument a runner starts from, the cell an exit is recorded in, and the
 * environment the body reaches its captures through. */
/* Whether `nm` is one of the names a `cache (...)` clause adopts. */
static bool pl_pw_is_cache(CcNameList* cache, CCSlice nm) {
    size_t n = cache->len();
    size_t i;
    for (i = 0; i < n; i++) {
        CCSlice c = *cache->get_ptr(i);
        if (slice_eq(c, nm)) return true;
    }
    return false;
}

static CCString pl_pw_env_text(PStep* st, uint32_t id, PCapList* caps, CCSlice ret_ty, CcNameList* cache) {
    CcLowerer* L = st->L;
    CCArena a = L->arena;
    CCString sb = cc_string_new();
    CCSlice env = pl_pw_name(L, id, "_env_t");
    CCSlice sht = pl_pw_name(L, id, "_sh_t");
    CCSlice slt = pl_pw_name(L, id, "_slot_t");
    CCSlice agt = pl_pw_name(L, id, "_arg_t");
    CCSlice ex = pl_for_ex_type(L, id);
    size_t n = caps->len();
    size_t i;
    sb.push_cstr("typedef struct { CCTurnstile* gate; CCNurseryHost* nur; CCChan* work; CCParallel* dest; } ", a);
    sb.push_slice(sht, a);
    sb.push_cstr(";\ntypedef struct { int failed; int i; CCError err; } ", a);
    sb.push_slice(slt, a);
    sb.push_cstr(";\ntypedef struct { CCChan* work; void* env; int slot; } ", a);
    sb.push_slice(agt, a);
    sb.push_cstr(";\ntypedef struct { cc_atomic_int lock; cc_atomic_int xk; ", a);
    sb.push_slice(ret_ty, a);
    sb.push_cstr(" rv; } ", a);
    sb.push_slice(ex, a);
    sb.push_cstr(";\ntypedef struct {\n    ", a);
    sb.push_slice(sht, a);
    sb.push_cstr("* sh;\n    ", a);
    sb.push_slice(slt, a);
    sb.push_cstr("* slots;\n", a);
    for (i = 0; i < n; i++) {
        PCap* c = *caps->get_ptr(i);
        CcType* el = pl_for_decayed(c->type);
        CCSlice tn = L->ix->canon(el ? el : c->type);
        sb.push_cstr("    ", a);
        sb.push_slice(tn, a);
        sb.push_cstr("* ", a);
        sb.push_slice(c->name, a);
        sb.push_cstr(";\n", a);
        if (pl_pw_is_cache(cache, c->name)) {
            /* the extra instances of a cached name, one per runner slot
             * past the first; slot 0 is the declared instance above */
            sb.push_cstr("    ", a);
            sb.push_slice(tn, a);
            sb.push_cstr("* __cc_pw_cx_", a);
            sb.push_slice(c->name, a);
            sb.push_cstr(";\n", a);
        }
    }
    sb.push_cstr("    ", a);
    sb.push_slice(ex, a);
    sb.push_cstr("* __cc_pf_ex;\n} ", a);
    sb.push_slice(env, a);
    sb.push_cstr(";\n", a);
    return sb;
}

static void pl_pw_forward(PStep* st, uint32_t id) {
    CcLowerer* L = st->L;
    CCSlice run = pl_pw_name(L, id, "_run");
    CCSlice worker = pl_pw_name(L, id, "_worker");
    CCString t = @string(`static void ${run}(void*, int, int);
static void* ${worker}(void*);
`, L->arena);
    pl_host(st); st->fwd.push_slice(t.as_slice(), L->arena);
}

/* A runner: one ticket at a time off the channel, through the one body,
 * until the site closes the channel behind the last ticket it sent. */
static CcDecl* pl_pw_worker_decl(PStep* st, uint32_t id, CcSpan sp) {
    CcLowerer* L = st->L;
    CCSlice run = pl_pw_name(L, id, "_run");
    CCSlice worker = pl_pw_name(L, id, "_worker");
    CCSlice agt = pl_pw_name(L, id, "_arg_t");
    CCString t = @string(`static void* ${worker}(void* __p) {
    ${agt}* __cc_pw_a = (${agt}*)__p;
    int __cc_pw_i;
    while (cc_chan_recv(__cc_pw_a->work, &__cc_pw_i, sizeof(__cc_pw_i)) == 0)
        ${run}(__cc_pw_a->env, __cc_pw_i, __cc_pw_a->slot);
    return NULL;
}
`, L->arena);
    return lw_raw_decl(L, t, sp);
}


/* ---- `@stage` inside a walked body -------------------------------------- */

static int pl_pw_gate_form(Walker* w, CcExpr* g);
static int pl_stage_gate_form(Walker* w, CcExpr* g);
static bool pl_stage_is_face(int gform);

/* The flag a stage sets once it has passed. The exit reads it, so a ticket
 * that left the body early still hands the phase on to its successor. */
static CCSlice pl_pw_stg_name(CcLowerer* L, uint32_t id, uint32_t k) {
    CCString s = @string(`__cc_pw_${id}_stg_${k}`, L->arena);
    return lw_keep(L, &s);
}

/* The three parts of a `@stage`, or false for a statement that is not one. */
static bool pl_stage_parts(CcStmt* s, CcExpr** gate, CcExprList* args, CcStmtList* stmts) {
    bool hit = false;
    if (!s) return false;
    @switch (s->k) {
        case .stage(x): {
            *gate = x.gate;
            *args = x.args;
            *stmts = x.stmts;
            hit = true;
            break;
        }
        default: break;
    }
    return hit;
}

/* The gate as the pointer the turnstile calls take. A gate held by value is
 * taken by address; one that is already a pointer is passed on. The inner
 * node is shared with every other call this stage makes, so the capture
 * rewrite reaches all of them through the one that stays in the body. */
static CcExpr* pl_stage_addr(CcLowerer* L, int gform, CcExpr* gate, CcSpan sp) {
    if (gform == 1 || gform == 5) return cc_expr_unary(CC_OP_ADDR, gate, sp, L->arena);
    return gate;
}

static CcExpr* pl_stage_call(CcLowerer* L, const char* fn, CcExpr* gaddr,
                             CcExprList* args, CcSpan sp) {
    CcExpr* c = lw_call0(L, cstr_slice(fn), sp);
    CcExprList* into = lw_call_args(c);
    size_t n = args->len();
    size_t i;
    into->push(gaddr);
    for (i = 0; i < n; i++) {
        CcExpr* a = *args->get_ptr(i);
        into->push(a);
    }
    return c;
}

/* `<call> !>;`: a turn the ticket cannot take fails the way the body's own
 * `!>` does, through the handler this function carries -- the slot, the
 * cancel, and the one exit. */
static CcStmt* pl_unwrap_stmt(CcLowerer* L, CcExpr* call, CcSpan sp) {
    CcExpr* uw = cc__expr_blank(sp, L->arena);
    CcStmt* s = cc__stmt_blank(sp, L->arena);
    CcUnwrap u;
    CcUnwrapStmt us;
    u.a = call;
    { CcExprK ek = { .unwrap = u }; uw->k = ek; }
    us.e = uw;
    { CcStmtK sk = { .unwrap = us }; s->k = sk; }
    return s;
}

/* `@stage (gate, phase, ticket) { body }` in the body of a walk, as the
 * ordered section it is: wait for this ticket's turn, run the block unless
 * the pool has been cancelled behind it, then pass the turn on. The flag is
 * what the exit reads to tell a stage that retired from one that did not.
 *
 * `cc_parallel_honor` sits between the wait and the block because a pause
 * does not complete the wait: the ticket holds its turn while it parks.
 *
 * The `fail`/`pass` the exit discharges with are built here and handed back,
 * not emitted here: they share this stage's gate and arguments, so the
 * capture rewrite that runs after this reaches them, and the exit spells
 * them once the names they read are the ones the body sees. */
static void pl_pw_stage_lower(PStep* st, uint32_t id, uint32_t k, CcStmt* s,
                              CcExprList* dis_fail, CcExprList* dis_pass) {
    CcLowerer* L = st->L;
    CcSpan sp = s->span;
    CcExpr* gate = NULL;
    CcExprList args;
    CcStmtList stmts;
    CcStmt* blk;
    CCSlice flag = pl_pw_stg_name(L, id, k);
    int gform;
    bool face;
    if (!pl_stage_parts(s, &gate, &args, &stmts)) return;
    gform = pl_stage_gate_form(st->w, gate);
    face = pl_stage_is_face(gform);
    blk = lw_block(L, sp);
    {
        CcExpr* ga = pl_stage_addr(L, gform, gate, sp);
        CcExpr* c = pl_stage_call(L, face ? "cc_turnstile_stage_wait" : "cc_turnstile_wait", ga, &args, sp);
        lw_push(blk, pl_unwrap_stmt(L, c, sp));
    }
    {
        CCString t = @string(`cc_parallel_honor(__cc_pw_sh->dest)`, L->arena);
        pl_pw_text(L, blk, t, sp);
    }
    {
        CcStmt* inner = lw_block(L, sp);
        CcStmtList* into = lw_block_stmts(inner);
        CCString c = @string(`!cc_nursery_is_cancelled_host(__cc_pw_sh->nur)`, L->arena);
        size_t n = stmts.len();
        size_t i;
        for (i = 0; i < n; i++) {
            CcStmt* q = *stmts.get_ptr(i);
            into->push(q);
        }
        lw_push(blk, lw_if(L, lw_text(L, c, sp), inner, NULL, sp));
    }
    {
        CcExpr* ga = pl_stage_addr(L, gform, gate, sp);
        CcExpr* c = pl_stage_call(L, face ? "cc_turnstile_stage_pass" : "cc_turnstile_pass", ga, &args, sp);
        lw_push(blk, pl_unwrap_stmt(L, c, sp));
    }
    {
        CCString t = @string(`${flag} = 1`, L->arena);
        pl_pw_text(L, blk, t, sp);
    }
    {
        CcExpr* ga = pl_stage_addr(L, gform, gate, sp);
        CcExpr* c = pl_stage_call(L, face ? "cc_turnstile_stage_fail" : "cc_turnstile_fail", ga, &args, sp);
        dis_fail->push(c);
    }
    {
        CcExpr* ga = pl_stage_addr(L, gform, gate, sp);
        CcExpr* c = pl_stage_call(L, face ? "cc_turnstile_stage_pass" : "cc_turnstile_pass", ga, &args, sp);
        dis_pass->push(c);
    }
    s->k = blk->k;
}

/* `@stage (gate, phase, ticket) { body }` in an inert walk: the turn is
 * taken and passed on the frame the caller has, against a turnstile that
 * nothing entered. No pool stands behind the ticket, so there is no cancel
 * to test and no flag for an exit to read -- the iterations already run in
 * ticket order, which is what the stage was ordering them into.
 *
 * The `wait` and the `pass` are still made: they are what the page wrote,
 * and dropping them would make an over-subscribed gate look like one that
 * simply let every ticket through. */
static void pl_stage_inert(PStep* st, CcStmt* s) {
    CcLowerer* L = st->L;
    CcSpan sp = s->span;
    CcExpr* gate = NULL;
    CcExprList args;
    CcStmtList stmts;
    CcStmt* blk;
    CcStmt* inner;
    CcStmtList* into;
    int gform;
    bool face;
    size_t i;
    size_t n;
    if (!pl_stage_parts(s, &gate, &args, &stmts)) return;
    gform = pl_stage_gate_form(st->w, gate);
    face = pl_stage_is_face(gform);
    blk = lw_block(L, sp);
    {
        CcExpr* ga = pl_stage_addr(L, gform, gate, sp);
        CcExpr* c = pl_stage_call(L, face ? "cc_turnstile_stage_wait" : "cc_turnstile_wait", ga, &args, sp);
        lw_push(blk, pl_unwrap_stmt(L, c, sp));
    }
    inner = lw_block(L, sp);
    into = lw_block_stmts(inner);
    n = stmts.len();
    for (i = 0; i < n; i++) {
        CcStmt* q = *stmts.get_ptr(i);
        into->push(q);
    }
    lw_push(blk, inner);
    {
        CcExpr* ga = pl_stage_addr(L, gform, gate, sp);
        CcExpr* c = pl_stage_call(L, face ? "cc_turnstile_stage_pass" : "cc_turnstile_pass", ga, &args, sp);
        lw_push(blk, pl_unwrap_stmt(L, c, sp));
    }
    s->k = blk->k;
}

/* `@parallel [wait (gate)] for (i in lo..hi) [worker (w)] { body }` under
 * `#pragma(@parallel) off`: the linear program the walk stands for. One
 * loop, on the frame the caller has, over the range as written.
 *
 * Nothing is spawned, so nothing is denied and no nursery is opened; the
 * turnstile a `wait (gate)` names is never entered, and the `@stage`s of
 * the walk order tickets that are already in order. `worker (w)` binds 0:
 * one runner ran every ticket, and it is the caller.
 *
 * `break`, `continue` and `return` in the body are plain C here, and the
 * `!>.wait()!>` tail goes with the statement -- there is no handle to
 * join. A `!>` inside the body reaches the handler this function carries,
 * the same as any other statement of it. */
static void pl_for_inert(PStep* st, CcStmt* s, CcParallelFor pf, CcRange rg) {
    CcLowerer* L = st->L;
    CcSpan sp = s->span;
    CcStmt* blk = lw_block(L, sp);
    CcStmt* body = pf.loop.body;
    CCSlice nm = pf.loop.bind;
    CCSlice wk = pf.worker;
    CCString lo = lw_spell_expr(L, rg.lo);
    CCString hi = lw_spell_expr(L, rg.hi);
    CCSlice los = lw_keep(L, &lo);
    CCSlice his = lw_keep(L, &hi);
    CCString init = @string(`${nm} = (int)(${los})`, L->arena);
    CCString cond = @string(`${nm} < (int)(${his})`, L->arena);
    CCString step = @string(`${nm}++`, L->arena);
    CcType* ity = cc_type_named(cstr_slice("int"), sp, L->arena);
    if (!body) body = lw_block(L, sp);
    if (pf.wait) {
        CcStmtList* bs = lw_block_stmts(body);
        if (bs) {
            size_t n = bs->len();
            size_t i;
            for (i = 0; i < n; i++) {
                CcStmt* q = *bs->get_ptr(i);
                if (pl_stage_owned(st, q)) pl_stage_inert(st, q);
            }
        }
    }
    /* the binder belongs to the loop: the body reads the names in scope
     * directly, and this one shadows nothing the site had to capture */
    lw_push(blk, lw_decl_stmt(L, ity, nm, NULL, sp));
    if (wk.len) {
        CcType* wty = cc_type_named(cstr_slice("int"), sp, L->arena);
        CCString z = @string(`0`, L->arena);
        lw_push(blk, lw_decl_stmt(L, wty, wk, lw_text(L, z, sp), sp));
    }
    lw_push(blk, pl_pw_for(L, init, cond, step, body, sp));
    s->k = blk->k;
    st->any = true;
}

/* What a `@stage` of a walked body may name. The gate is the turnstile the
 * tickets are ordered on, and its `wait`/`pass`/`fail` take a phase and a
 * ticket; a gate of another shape orders something this walk does not run,
 * and reading it as a turnstile would be a C type error at a line about the
 * walk. Checked where the gate still spells the caller's names. */
static bool pl_pw_stages_ok(PStep* st, CcStmt* body) {
    CcLowerer* L = st->L;
    CcStmtList* bs = lw_block_stmts(body);
    bool ok = true;
    size_t n;
    size_t i;
    if (!bs) return true;
    n = bs->len();
    for (i = 0; i < n; i++) {
        CcStmt* q = *bs->get_ptr(i);
        CcExpr* gate = NULL;
        CcExprList args;
        CcStmtList stmts;
        uint32_t na;
        uint32_t want;
        int gform;
        if (!pl_stage_parts(q, &gate, &args, &stmts)) continue;
        gform = gate ? pl_stage_gate_form(st->w, gate) : 0;
        if (!gform) {
            CCString m = @string(`'${"@"}stage' orders the walk's tickets on a 'CCTurnstile' or on one of the stages a 'CCTurnstileRW' embeds: the gate here is something else`, L->arena);
            lw_error(L, q->span, m);
            ok = false;
            continue;
        }
        na = (uint32_t)args.len();
        want = pl_stage_is_face(gform) ? 1u : 2u;
        if (na != want) {
            if (want == 1u) {
                CCString m = @string(`'${"@"}stage (ts.read, ticket)' names a ticket beside its stage: this one names ${na}`, L->arena);
                lw_error(L, q->span, m);
            } else {
                CCString m = @string(`'${"@"}stage (gate, phase, ticket)' names a phase and a ticket beside its gate: this one names ${na}`, L->arena);
                lw_error(L, q->span, m);
            }
            ok = false;
        }
    }
    return ok;
}

/* The body, once. Called on a runner and on the caller, told which ticket it
 * is and which slot is its own; the ticket is already held when it starts and
 * is given back before it returns, so both schedules keep the gate balanced. */
static CcDecl* pl_pw_run_decl(PStep* st, uint32_t id, PCapList* caps, CcForIn loop,
                              CCSlice worker, CcNameList* cache, CcSpan sp) {
    CcLowerer* L = st->L;
    CCSlice env = pl_pw_name(L, id, "_env_t");
    CCSlice run = pl_pw_name(L, id, "_run");
    CCSlice sht = pl_pw_name(L, id, "_sh_t");
    CCSlice slt = pl_pw_name(L, id, "_slot_t");
    CCSlice done = pl_pw_name(L, id, "_done");
    CcStmt* fnbody = lw_block(L, sp);
    CcParamList params = vec_new::[CcParam](L->arena);
    CcType* fn_type = cc__type_blank(sp, L->arena);
    CcType* voidp = cc_type_pointer(cc_type_named(cstr_slice("void"), sp, L->arena), sp, L->arena);
    CcType* intt = cc_type_named(cstr_slice("int"), sp, L->arena);
    CcFuncType ft;
    CcFuncDecl fd;
    CcDecl* d;
    size_t n = caps->len();
    size_t i;
    CCSlice bind = loop.bind;
    CcExprList dis_fail = vec_new::[CcExprRef](L->arena);
    CcExprList dis_pass = vec_new::[CcExprRef](L->arena);
    uint32_t nstg = 0;
    {
        CcType* pt = cc_type_pointer(cc_type_named(env, sp, L->arena), sp, L->arena);
        CcExpr* cast = cc__expr_blank(sp, L->arena);
        CcCast ca;
        ca.type = pt;
        ca.a = lw_ident(L, cstr_slice("__p"), sp);
        cast->k = { .cast = ca };
        lw_push(fnbody, lw_decl_stmt(L, pt, cstr_slice("e"), cast, sp));
    }
    {
        CCString d1 = @string(`${sht}* __cc_pw_sh = e->sh`, L->arena);
        CCString d2 = @string(`${slt}* __cc_pw_sl = &e->slots[__cc_pw_slot]`, L->arena);
        CCString d3 = @string(`cc_parallel_honor(__cc_pw_sh->dest)`, L->arena);
        pl_pw_text(L, fnbody, d1, sp);
        pl_pw_text(L, fnbody, d2, sp);
        pl_pw_text(L, fnbody, d3, sp);
    }
    lw_push(fnbody, lw_decl_stmt(L, intt, bind, lw_ident(L, cstr_slice("__cc_pw_i"), sp), sp));
    if (worker.len) {
        /* the slot the runner took this ticket on: the caller, which holds
         * one slot of its own, is slot 0 on either schedule */
        lw_push(fnbody, lw_decl_stmt(L, intt, worker, lw_ident(L, cstr_slice("__cc_pw_slot"), sp), sp));
    }
    {
        /* the walk's own `@stage`s, numbered in the order they stand in.
         * Lowered before the captures, because the gate a stage names is read
         * against the caller's scope, and after this the body reads through
         * the environment instead. */
        CcStmtList* bs = lw_block_stmts(loop.body);
        if (bs) {
            size_t nb = bs->len();
            size_t bi;
            for (bi = 0; bi < nb; bi++) {
                CcStmt* q = *bs->get_ptr(bi);
                CcExpr* g = NULL;
                CcExprList qa;
                CcStmtList qs;
                if (!pl_stage_parts(q, &g, &qa, &qs)) continue;
                {
                    CCSlice flag = pl_pw_stg_name(L, id, nstg);
                    CCString t = @string(`int ${flag} = 0`, L->arena);
                    pl_pw_text(L, fnbody, t, sp);
                }
                pl_pw_stage_lower(st, id, nstg, q, &dis_fail, &dis_pass);
                nstg++;
            }
        }
    }
    for (i = 0; i < n; i++) {
        PCap* c = *caps->get_ptr(i);
        CcExpr* read = cc_expr_member(lw_ident(L, cstr_slice("e"), sp), c->name, true, sp, L->arena);
        CcType* el = pl_for_decayed(c->type);
        CCSlice cn = c->name;
        if (el) {
            lw_push(fnbody, lw_decl_stmt(L, cc_type_pointer(el, sp, L->arena), cn, read, sp));
        } else if (pl_pw_is_cache(cache, cn)) {
            /* a cached name is checked out per runner slot: slot 0 takes
             * the declared instance, every other slot its own extra. One
             * runner runs one ticket at a time, so the checkout is
             * exclusive; the caller, which runs tickets only when no pool
             * was spawned, is slot 0 */
            CcType* pt = cc_type_pointer(c->type, sp, L->arena);
            CCString rn = @string(`__cc_ref_${cn}`, L->arena);
            CCSlice ref = lw_keep(L, &rn);
            CCString pick = @string(`(__cc_pw_slot > 0 && e->__cc_pw_cx_${cn}) ? &e->__cc_pw_cx_${cn}[__cc_pw_slot - 1] : e->${cn}`, L->arena);
            lw_push(fnbody, lw_decl_stmt(L, pt, ref, lw_text(L, pick, sp), sp));
            pl_rewrite(L, NULL, loop.body, cn, ref);
        } else {
            CcType* pt = cc_type_pointer(c->type, sp, L->arena);
            CCString rn = @string(`__cc_ref_${cn}`, L->arena);
            CCSlice ref = lw_keep(L, &rn);
            lw_push(fnbody, lw_decl_stmt(L, pt, ref, read, sp));
            pl_rewrite(L, NULL, loop.body, cn, ref);
        }
    }
    {
        /* `break` and `return` leave the body, not the runner: the first to
         * arrive claims the cell the site reads, and both jump to the one
         * exit, so the ticket is given back however the body ended */
        PForExit fx;
        fx.L = L;
        fx.id = id;
        fx.has_ret = false;
        fx.cancel = true;
        fx.leave = done;
        if (loop.body) pl_for_exits(&fx, loop.body, 0);
    }
    {
        /* every `!>` in the body is this ticket's error: the slot the site
         * reads, the cancel that stops the tickets that have not started,
         * and the same exit the body's own ending takes.
         * `CcLowerer_results` runs after this step and registers a handler
         * per statement list, so a synthesized one needs nothing further. */
        CcStmt* hb = lw_block(L, sp);
        CcStmt* hs = cc__stmt_blank(sp, L->arena);
        CcErrhandler eh;
        CCString ht = @string(`__cc_pw_sl->err = __cc_pw_eb; __cc_pw_sl->failed = 1; __cc_pw_sl->i = __cc_pw_i; cc_nursery_cancel_host(__cc_pw_sh->nur)`, L->arena);
        pl_pw_text(L, hb, ht, sp);
        lw_push(hb, lw_goto(L, done, sp));
        memset(&eh, 0, sizeof(eh));
        eh.err_type = cc_type_named(cstr_slice("CCError"), sp, L->arena);
        eh.binder = cstr_slice("__cc_pw_eb");
        eh.body = hb;
        { CcStmtK sk = { .errhandler = eh }; hs->k = sk; }
        lw_push(fnbody, hs);
    }
    if (loop.body) { lw_push(fnbody, loop.body); }
    {
        /* the one exit. The `return` after it is what keeps the ordinary
         * ending out of the handler the results step hoists below. */
        CcStmt* lv = lw_block(L, sp);
        CCString lt = @string(`__typeof__(cc_turnstile_leave(__cc_pw_sh->gate)) __cc_pw_lr = cc_turnstile_leave(__cc_pw_sh->gate); if (!__cc_pw_lr.ok && !__cc_pw_sl->failed) { __cc_pw_sl->err = __cc_pw_lr.u.error.base; __cc_pw_sl->failed = 1; __cc_pw_sl->i = __cc_pw_i; cc_nursery_cancel_host(__cc_pw_sh->nur); }`, L->arena);
        {
            /* a stage the body left before passing is discharged here, so a
             * successor parked in its `wait` wakes either way: with the error
             * when this ticket failed, and with its turn when it merely
             * skipped ahead. Spelled now, because the calls read the captures
             * the way the body does. */
            uint32_t sk;
            for (sk = 0; sk < nstg; sk++) {
                CCSlice flag = pl_pw_stg_name(L, id, sk);
                CcExpr* fe = *dis_fail.get_ptr(sk);
                CcExpr* pe = *dis_pass.get_ptr(sk);
                CCString fs = lw_spell_expr(L, fe);
                CCString ps = lw_spell_expr(L, pe);
                CCSlice fc = lw_keep(L, &fs);
                CCSlice pc = lw_keep(L, &ps);
                CCString t = @string(`if (!${flag}) { if (__cc_pw_sl->failed) { __typeof__(${fc}) __cc_pw_dr = ${fc}; (void)__cc_pw_dr; } else { __typeof__(${pc}) __cc_pw_dr = ${pc}; if (!__cc_pw_dr.ok) { __cc_pw_sl->err = __cc_pw_dr.u.error; __cc_pw_sl->failed = 1; __cc_pw_sl->i = __cc_pw_i; cc_nursery_cancel_host(__cc_pw_sh->nur); } } }`, L->arena);
                pl_pw_text(L, lv, t, sp);
            }
        }
        pl_pw_text(L, lv, lt, sp);
        lw_push(fnbody, lw_label(L, done, lv, sp));
        lw_push(fnbody, cc_stmt_return(NULL, sp, L->arena));
    }
    {
        CcParam p0;
        CcParam p1;
        CcParam p2;
        memset(&p0, 0, sizeof(p0));
        memset(&p1, 0, sizeof(p1));
        memset(&p2, 0, sizeof(p2));
        p0.span = sp; p0.type = voidp; p0.name = cstr_slice("__p"); p0.attrs = vec_new::[CcAttr](L->arena);
        p1.span = sp; p1.type = intt; p1.name = cstr_slice("__cc_pw_i"); p1.attrs = vec_new::[CcAttr](L->arena);
        p2.span = sp; p2.type = intt; p2.name = cstr_slice("__cc_pw_slot"); p2.attrs = vec_new::[CcAttr](L->arena);
        params.push(p0);
        params.push(p1);
        params.push(p2);
    }
    memset(&ft, 0, sizeof(ft));
    ft.ret = cc_type_named(cstr_slice("void"), sp, L->arena);
    ft.params = params;
    ft.has_prototype = true;
    { CcTypeK tk = { .func = ft }; fn_type->k = tk; }
    memset(&fd, 0, sizeof(fd));
    fd.name = run;
    fd.type = fn_type;
    fd.body = fnbody;
    d = cc_arena_alloc(L->arena, sizeof(CcDecl), _Alignof(CcDecl));
    memset(d, 0, sizeof(*d));
    d->span = sp;
    d->specs = CC_SPEC_STATIC;
    d->attrs = vec_new::[CcAttr](L->arena);
    { CcDeclK dk = { .func = fd }; d->k = dk; }
    return d;
}

/* A bound wait-for names one of two things. A typed `CCParallel` is the live
 * handle the tickets pause and resume through, and outlives the walk. Anything
 * else -- a `bool` the site declares, or an lvalue it assigns -- is the walk's
 * own answer: did every ticket run? */
static bool pl_pw_handle_bind(CcParallelFor pf) {
    CCSlice nm = cc_slice_empty();
    CCSlice want = cstr_slice("CCParallel");
    if (!pf.bind.len || !pf.bind_type) return false;
    if (!type_named_name(pf.bind_type, &nm)) return false;
    return slice_eq(nm, want);
}

static bool pl_pw_result_dest(CcParallelFor pf) {
    if (!pf.bind.len && !pf.target) return false;
    return !pl_pw_handle_bind(pf);
}

/* What `wait (...)` names: 2 a turnstile reached by pointer, 1 one held by
 * value, 0 not a turnstile at all. The pool caps on the caller's own, so a
 * value is taken by address; anything else is not a gate this site can cap on
 * and saying so beats a C type error at a line about something else. */
/* The name a gate's type carries, and whether the gate is already a
 * pointer: the same gate reached two ways is the same gate. */
static bool pl_gate_named(CcType* t, CCSlice* out, bool* is_ptr) {
    CcType* p = NULL;
    *is_ptr = false;
    if (!t) return false;
    @switch (t->k) {
        case .pointer(pt): p = pt.pointee; break;
        default: break;
    }
    if (p) { *is_ptr = true; t = p; }
    return type_named_name(t, out);
}

/* The gate a `@parallel wait (...)` caps its pool on. A `CCTurnstileRW` is
 * two stages around one core, and the pool is capped on that core. */
static int pl_pw_gate_form(Walker* w, CcExpr* g) {
    CCSlice nm = cc_slice_empty();
    bool ptr = false;
    if (!pl_gate_named(type_of_expr(w, g), &nm, &ptr)) return 0;
    if (cc_slice_eq_cstr(&nm, "CCTurnstile")) return ptr ? 2 : 1;
    if (cc_slice_eq_cstr(&nm, "CCTurnstileRW")) return ptr ? 4 : 3;
    return 0;
}

/* The gate a `@stage` orders its ticket on. Either the whole turnstile,
 * which names the phase inside it, or one of the stages a `CCTurnstileRW`
 * embeds -- `ts.read` is a stage of its own and takes only the ticket. */
static int pl_stage_gate_form(Walker* w, CcExpr* g) {
    CCSlice nm = cc_slice_empty();
    bool ptr = false;
    if (!pl_gate_named(type_of_expr(w, g), &nm, &ptr)) return 0;
    if (cc_slice_eq_cstr(&nm, "CCTurnstile")) return ptr ? 2 : 1;
    if (cc_slice_eq_cstr(&nm, "CCTurnstileStage")) return ptr ? 6 : 5;
    return 0;
}

/* A stage named through a face takes the ticket alone; one named through
 * the whole turnstile takes the phase beside it. */
static bool pl_stage_is_face(int gform) { return gform == 5 || gform == 6; }

/* ---- `cache (name, ...)` ------------------------------------------------- */

/* The declaration of `nm` in the function the site stands in: the type,
 * initializer and destroy hook the extras take. */
typedef struct PDeclQ { CCSlice name; CcVarDecl v; CcDecl* at; bool hit; } PDeclQ;

static bool pl_decl_visit(CcStmt* s, void* env) {
    PDeclQ* q = (PDeclQ*)env;
    CcDecl* d = NULL;
    CcVarDecl v;
    bool is_var = false;
    if (q->hit) return false;
    @switch (s->k) {
        case .decl(x): d = x.d; break;
        default: break;
    }
    if (!d) return true;
    @switch (d->k) {
        case .var(x): v = x; is_var = true; break;
        default: break;
    }
    if (is_var && slice_eq(v.name, q->name)) { q->v = v; q->at = d; q->hit = true; }
    return !q->hit;
}

static bool pl_find_var_decl_at(PStep* st, CCSlice nm, CcVarDecl* out, CcDecl** at) {
    PDeclQ q;
    CcVisitor v;
    CcFuncDecl f;
    bool is_fn = false;
    CcDecl* ad = st->at_decl;
    if (!ad) return false;
    @switch (ad->k) {
        case .func(x): f = x; is_fn = true; break;
        default: break;
    }
    if (!is_fn || !f.body) return false;
    memset(&q, 0, sizeof(q));
    q.name = nm;
    memset(&v, 0, sizeof(v));
    v.stmt = pl_decl_visit;
    v.env = &q;
    CcStmt_walk(f.body, v);
    if (q.hit) { *out = q.v; if (at) *at = q.at; }
    return q.hit;
}

static bool pl_find_var_decl(PStep* st, CCSlice nm, CcVarDecl* out) {
    return pl_find_var_decl_at(st, nm, out, NULL);
}

/* The names `cache (...)` adopts, as written. */
static CcNameList pl_pw_cache_names(CcLowerer* L, CcParallelFor pf) {
    CcNameList out = vec_new::[CCSlice](L->arena);
    CcExprList* cv = &pf.cache;
    size_t n = cv->len();
    size_t i;
    for (i = 0; i < n; i++) {
        CcExpr* ce = *cv->get_ptr(i);
        CCSlice nm = cc_slice_empty();
        if (!expr_ident(strip_parens_expr(ce), &nm) || !nm.len) continue;
        out.push(nm);
    }
    return out;
}

/* The extras of a cached name, as the site declares them. */
static CCSlice pl_pw_cx_name(CcLowerer* L, uint32_t id, CCSlice nm) {
    CCString s = @string(`__cc_pw_${id}_cx_${nm}`, L->arena);
    return lw_keep(L, &s);
}

/* Whether `nm` is read inside an `@stage` block of the body. A stage is
 * loop-carried identity; a cached name is an instance no ticket can name,
 * and the spec keeps the two apart. */
typedef struct PNameQ { CCSlice name; bool hit; } PNameQ;

static bool pl_name_expr(CcExpr* e, void* env) {
    PNameQ* q = (PNameQ*)env;
    CCSlice nm;
    @switch (e->k) {
        case .ident(x): nm = x; break;
        default: return true;
    }
    if (slice_eq(nm, q->name)) q->hit = true;
    return !q->hit;
}

static bool pl_pw_cache_in_stage(CcStmt* body, CCSlice nm) {
    CcStmtList* bs = lw_block_stmts(body);
    size_t n;
    size_t i;
    if (!bs) return false;
    n = bs->len();
    for (i = 0; i < n; i++) {
        CcStmt* q = *bs->get_ptr(i);
        CcExpr* g = NULL;
        CcExprList qa;
        CcStmtList qs;
        size_t k;
        size_t nk;
        if (!pl_stage_parts(q, &g, &qa, &qs)) continue;
        nk = qs.len();
        for (k = 0; k < nk; k++) {
            CcStmt* t = *qs.get_ptr(k);
            PNameQ nq;
            CcVisitor v;
            memset(&nq, 0, sizeof(nq));
            nq.name = nm;
            memset(&v, 0, sizeof(v));
            v.expr = pl_name_expr;
            v.env = &nq;
            CcStmt_walk(t, v);
            if (nq.hit) return true;
        }
    }
    return false;
}

/* ---- the drop of a cached name ------------------------------------------
 *
 * A declaration `T s = init @destroy { D }` runs D once for the declared
 * instance, at its scope exit, and the walk runs it once per extra at the
 * join. D is one body: it becomes one function, `static R drop(T* ref)`,
 * whose body IS D with `s` read through the parameter, and both sites call
 * it. R is `void` when D raises nothing; when D holds a bare `!>` or an
 * `@err`, R is `void !>(E)` for the E the handlers of the frame take, the
 * drop opens with a handler that hands the error back, a `return;` in D is
 * `return cc_ok();`, and both call sites unwrap -- into the handler in
 * scope at the declaration, which is where D forwarded to before. */

static CCSlice pl_pw_drop_name(CcLowerer* L, uint32_t id, CCSlice nm) {
    CCString s = @string(`__cc_pw_${id}_drop_${nm}`, L->arena);
    return lw_keep(L, &s);
}

/* `return;` in a D that hands back a Result: the exit is `return cc_ok();`. */
static bool pl_drop_ret_stmt(CcStmt* s, void* env) {
    CcLowerer* L = (CcLowerer*)env;
    bool is_ret = false;
    CcReturn r;
    @switch (s->k) {
        case .return_(x): r = x; is_ret = true; break;
        default: break;
    }
    if (!is_ret || r.value) return true;
    {
        CcStmt* nr = cc_stmt_return(lw_call0(L, cstr_slice("cc_ok"), s->span), s->span, L->arena);
        s->k = nr->k;
    }
    return true;
}

/* The drop function of `cn`, appended to the unit like a thunk, its
 * prototype beside the forward block; the declaration then destroys through
 * it. `*raises` says whether the call sites unwrap. */
static bool pl_pw_drop_make(PStep* st, uint32_t id, CCSlice cn, CcVarDecl* cv, CcDecl* dd,
                            bool* raises, CcSpan sp) {
    CcLowerer* L = st->L;
    CcStmt* body = cv->destroy_body;
    CCSlice drop = pl_pw_drop_name(L, id, cn);
    CCString rn = @string(`__cc_ref_${cn}`, L->arena);
    CCSlice ref = lw_keep(L, &rn);
    CCSlice ety = cc_slice_empty();
    CcStmt* fnbody = lw_block(L, sp);
    CcParamList params = vec_new::[CcParam](L->arena);
    CcType* fn_type = cc__type_blank(sp, L->arena);
    CcType* ret;
    CcFuncType ft;
    CcFuncDecl fd;
    CcDecl* d;
    CcDecl* proto;
    PScan sc;
    {
        /* D runs away from the frame, once per instance: a frame local it
         * reads besides the cached name would be a capture the drop has
         * no way to carry, and none of the instances is that local */
        CcVisitor v;
        memset(&sc, 0, sizeof(sc));
        sc.st = st;
        sc.w = st->w;
        sc.caps = vec_new::[PCapRef](L->arena);
        sc.seen = vec_new::[CCSlice](L->arena);
        sc.skip = cn;
        memset(&v, 0, sizeof(v));
        v.expr = pl_scan_expr;
        v.env = &sc;
        CcStmt_walk(body, v);
        {
            PCapList cl = sc.caps;
            if (cl.len()) {
                PCap* c = *cl.get_ptr(0);
                CCSlice other = c->name;
                CCString m = @string(`the destroy body of cached name '${cn}' reads '${other}' from the frame; the drop of a cached instance runs once per instance, away from the frame: reach '${other}' through a field of '${cn}', or take it out of the destroy body`, L->arena);
                lw_error(L, sp, m);
                return false;
            }
        }
    }
    *raises = pl_body_raises(body);
    if (*raises) {
        ety = pl_eh_type(st, sp);
        if (!ety.len) return false;
    }
    pl_rewrite(L, NULL, body, cn, ref);
    if (*raises) {
        CcVisitor v;
        memset(&v, 0, sizeof(v));
        v.stmt = pl_drop_ret_stmt;
        v.env = L;
        CcStmt_walk(body, v);
    }
    if (*raises) {
        /* the error D raises leaves the drop as its Result */
        CcStmt* hb = lw_block(L, sp);
        CcStmt* hs = cc__stmt_blank(sp, L->arena);
        CcErrhandler eh;
        CCSlice de = cstr_slice("__cc_de");
        lw_push(hb, cc_stmt_return(lw_call1(L, cstr_slice("cc_err"), lw_ident(L, de, sp), sp), sp, L->arena));
        memset(&eh, 0, sizeof(eh));
        eh.err_type = cc_type_named(ety, sp, L->arena);
        eh.binder = de;
        eh.body = hb;
        { CcStmtK sk = { .errhandler = eh }; hs->k = sk; }
        lw_push(fnbody, hs);
    }
    lw_push(fnbody, body);
    if (*raises) lw_push(fnbody, cc_stmt_return(lw_call0(L, cstr_slice("cc_ok"), sp), sp, L->arena));
    {
        CcParam p0;
        memset(&p0, 0, sizeof(p0));
        p0.span = sp;
        p0.type = cc_type_pointer(cv->type, sp, L->arena);
        p0.name = ref;
        p0.attrs = vec_new::[CcAttr](L->arena);
        params.push(p0);
    }
    ret = cc_type_named(cstr_slice("void"), sp, L->arena);
    if (*raises) ret = cc_type_result(ret, cc_type_named(ety, sp, L->arena), false, sp, L->arena);
    memset(&ft, 0, sizeof(ft));
    ft.ret = ret;
    ft.params = params;
    ft.has_prototype = true;
    { CcTypeK tk = { .func = ft }; fn_type->k = tk; }
    memset(&fd, 0, sizeof(fd));
    fd.name = drop;
    fd.type = fn_type;
    fd.body = fnbody;
    d = cc_arena_alloc(L->arena, sizeof(CcDecl), _Alignof(CcDecl));
    memset(d, 0, sizeof(*d));
    d->span = sp;
    d->specs = CC_SPEC_STATIC;
    d->attrs = vec_new::[CcAttr](L->arena);
    { CcDeclK dk = { .func = fd }; d->k = dk; }
    st->made.push(d);
    /* the results step types a call by the symbol the index holds, and the
     * index was read before this step ran: the drop is entered by hand */
    cc__sym_add(L->ix, drop, CC_SYM_FUNC, d, L->unit, fn_type, false, true);
    {
        CcFuncDecl pf;
        memset(&pf, 0, sizeof(pf));
        pf.name = drop;
        pf.type = fn_type;
        pf.body = NULL;
        proto = cc_arena_alloc(L->arena, sizeof(CcDecl), _Alignof(CcDecl));
        memset(proto, 0, sizeof(*proto));
        proto->span = sp;
        proto->specs = CC_SPEC_STATIC;
        proto->attrs = vec_new::[CcAttr](L->arena);
        { CcDeclK dk = { .func = pf }; proto->k = dk; }
        pl_host(st);
        st->protos.push(proto);
    }
    {
        /* the declaration destroys through the drop from now on */
        CcStmt* nb = lw_block(L, sp);
        CcExpr* call = lw_call1(L, drop, cc_expr_unary(CC_OP_ADDR, lw_ident(L, cn, sp), sp, L->arena), sp);
        if (*raises) lw_push(nb, pl_unwrap_stmt(L, call, sp));
        else lw_push(nb, lw_expr_stmt(L, call, sp));
        cv->destroy_body = nb;
        { CcDeclK dk = { .var = *cv }; dd->k = dk; }
    }
    return true;
}

/* ---- the cache extras: allocated per runner slot past the first, cold-
 * initialized, checked out exclusively by the runner, destroyed at the
 * join ------------------------------------------------------------------ */

static void pl_pw_cache_alloc(PStep* st, CcStmt* blk, uint32_t id, PCapList* caps, CcNameList* cache, CCSlice nur, CCSlice nw, CCString* more_out, CcSpan sp) {
    CcLowerer* L = st->L;
    size_t n = caps->len();
    size_t i;
    for (i = 0; i < n; i++) {
        /* the extras of a cached name: one per runner slot past the
         * first, in the storage of the pool, so they go when it goes.
         * An extra that did not come back closes the pool like any
         * other allocation that did not: the tickets run on the caller,
         * on the declared instance. */
        PCap* c = *caps->get_ptr(i);
        CCSlice cn = c->name;
        CCSlice cx;
        CCSlice tn;
        CCString dtext;
        CCString al;
        CCString more;
        if (!pl_pw_is_cache(cache, cn)) continue;
        cx = pl_pw_cx_name(L, id, cn);
        tn = L->ix->canon(c->type);
        dtext = @string(`${tn}* ${cx} = 0`, L->arena);
        al = @string(`if (${nur} && ${nw} > 1) ${cx} = cc_nursery_closure_env_alloc_host(${nur}, (size_t)(${nw} - 1) * sizeof(*${cx}), 16)`, L->arena);
        more = @string(` || (${nw} > 1 && !${cx})`, L->arena);
        pl_pw_text(L, blk, dtext, sp);
        pl_pw_text(L, blk, al, sp);
        {
            CCSlice ms = more.as_slice();
            more_out->push_slice(ms, L->arena);
        }
    }
}

static void pl_pw_cache_init(PStep* st, CcStmt* blk, uint32_t id, PCapList* caps, CcNameList* cache, CCSlice nw, CCSlice wv, CcSpan sp) {
    CcLowerer* L = st->L;
    size_t n = caps->len();
    size_t i;
    for (i = 0; i < n; i++) {
        /* the extras start cold: the initializer the declaration wrote runs
         * on each. A pool that closed leaves none, and the tickets then run
         * on the one declared instance. */
        PCap* c = *caps->get_ptr(i);
        CCSlice cn = c->name;
        CcVarDecl cv;
        CCSlice cx;
        CcStmt* lb;
        CcStmt* one;
        CCString ki;
        CCString kc;
        CCString ks;
        CCString put;
        if (!pl_pw_is_cache(cache, cn)) continue;
        if (!pl_find_var_decl(st, cn, &cv)) continue;
        cx = pl_pw_cx_name(L, id, cn);
        lb = lw_block(L, sp);
        if (cv.init) {
            one = cc__stmt_blank(sp, L->arena);
            {
                CcDeclStmt ds;
                ds.d = cc_decl_var(cv.type, cn, cv.init, sp, L->arena);
                { CcStmtK sk = { .decl = ds }; one->k = sk; }
            }
            lw_push(lb, one);
            put = @string(`${cx}[${wv}] = ${cn}`, L->arena);
        } else {
            /* a declaration with no initializer: the extras start zeroed,
             * which is the most an indeterminate declared instance promises */
            put = @string(`cc__bytes_zero(&${cx}[${wv}], sizeof(*${cx}))`, L->arena);
        }
        pl_pw_text(L, lb, put, sp);
        ki = @string(`${wv} = 0`, L->arena);
        kc = @string(`${wv} < ${nw} - 1`, L->arena);
        ks = @string(`${wv}++`, L->arena);
        {
            CcStmt* then = lw_block(L, sp);
            CCString cnd = @string(`${cx}`, L->arena);
            lw_push(then, pl_pw_for(L, ki, kc, ks, lb, sp));
            lw_push(blk, lw_if(L, lw_text(L, cnd, sp), then, NULL, sp));
        }
    }
}

static void pl_pw_cache_destroy(PStep* st, CcStmt* blk, uint32_t id, PCapList* caps, CcNameList* cache,
                                CcNameList* drops, CcNameList* draise, CCSlice nw, CCSlice wv, CcSpan sp) {
    CcLowerer* L = st->L;
    size_t n = caps->len();
    size_t i;
    for (i = 0; i < n; i++) {
        /* the extras are destroyed at the join, each by the destroy the
         * declaration wrote. A body is the drop function the declaration
         * itself calls now, once per extra here, unwrapped when the drop
         * hands back a Result; a hook-only destroy is a declaration in a
         * block of its own, whose exit is the hook. The declared instance
         * keeps its own, at its own scope exit. A declaration with no
         * destroy leaves nothing to run. */
        PCap* c = *caps->get_ptr(i);
        CCSlice cn = c->name;
        CcVarDecl cv;
        CCSlice cx;
        CcStmt* lb;
        CcStmt* inner;
        CcStmt* one;
        CCString ki;
        CCString kc;
        CCString ks;
        CCString take;
        if (!pl_pw_is_cache(cache, cn)) continue;
        if (!pl_find_var_decl(st, cn, &cv)) continue;
        if (!cv.destroy) continue;
        cx = pl_pw_cx_name(L, id, cn);
        lb = lw_block(L, sp);
        inner = lw_block(L, sp);
        one = cc__stmt_blank(sp, L->arena);
        take = @string(`${cx}[${wv}]`, L->arena);
        if (pl_pw_is_cache(drops, cn)) {
            CCSlice drop = pl_pw_drop_name(L, id, cn);
            CcExpr* call = lw_call1(L, drop, cc_expr_unary(CC_OP_ADDR, lw_text(L, take, sp), sp, L->arena), sp);
            if (pl_pw_is_cache(draise, cn)) one = pl_unwrap_stmt(L, call, sp);
            else one = lw_expr_stmt(L, call, sp);
        } else {
            CcDeclStmt ds;
            CcDecl* dd = cc_decl_var(cv.type, cn, NULL, sp, L->arena);
            CcVarDecl nv;
            bool is_var = false;
            CcInit* in = cc_arena_alloc(L->arena, sizeof(CcInit), _Alignof(CcInit));
            memset(in, 0, sizeof(*in));
            in->span = sp;
            in->designators = vec_new::[CcDesignator](L->arena);
            in->items = vec_new::[CcInitRef](L->arena);
            in->expr = lw_text(L, take, sp);
            @switch (dd->k) {
                case .var(x): nv = x; is_var = true; break;
                default: break;
            }
            if (is_var) {
                nv.init = in;
                nv.destroy = true;
                nv.destroy_body = cv.destroy_body;
                { CcDeclK dk = { .var = nv }; dd->k = dk; }
            }
            ds.d = dd;
            { CcStmtK sk = { .decl = ds }; one->k = sk; }
        }
        lw_push(inner, one);
        lw_push(lb, inner);
        ki = @string(`${wv} = 0`, L->arena);
        kc = @string(`${wv} < ${nw} - 1`, L->arena);
        ks = @string(`${wv}++`, L->arena);
        {
            CcStmt* then = lw_block(L, sp);
            CCString cnd = @string(`${cx}`, L->arena);
            lw_push(then, pl_pw_for(L, ki, kc, ks, lb, sp));
            lw_push(blk, lw_if(L, lw_text(L, cnd, sp), then, NULL, sp));
        }
    }
}

/* The site: open the pool, hand out the tickets under the gate, then read
 * what the pool left behind. */
static void pl_pw_lower(PStep* st, CcStmt* s, CcParallelFor pf, CcRange rg) {
    CcLowerer* L = st->L;
    Walker* w = st->w;
    CcSpan sp = s->span;
    uint32_t id = st->next_id++;
    PScan sc;
    PCapList caps;
    CcStmt* blk = lw_block(L, sp);
    CCSlice env = pl_pw_name(L, id, "_env_t");
    CCSlice sht = pl_pw_name(L, id, "_sh_t");
    CCSlice slt = pl_pw_name(L, id, "_slot_t");
    CCSlice agt = pl_pw_name(L, id, "_arg_t");
    CCSlice ext = pl_for_ex_type(L, id);
    CCSlice run = pl_pw_name(L, id, "_run");
    CCSlice worker = pl_pw_name(L, id, "_worker");
    CCSlice ev = pl_pw_name(L, id, "_e");
    CCSlice shv = pl_pw_name(L, id, "_sh");
    CCSlice cell = pl_pw_name(L, id, "_ex");
    CCSlice s0 = pl_pw_name(L, id, "_s0");
    CCSlice nur = pl_pw_name(L, id, "_n");
    CCSlice gv = pl_pw_name(L, id, "_ts");
    CCSlice work = pl_pw_name(L, id, "_work");
    CCSlice slots = pl_pw_name(L, id, "_slots");
    CCSlice args = pl_pw_name(L, id, "_args");
    CCSlice ferr = pl_pw_name(L, id, "_ferr");
    CCSlice fail = pl_pw_name(L, id, "_fail");
    CCSlice echo = pl_pw_name(L, id, "_echo");
    CCSlice best = pl_pw_name(L, id, "_best");
    CCSlice wv = pl_pw_name(L, id, "_w");
    CCSlice nw = pl_pw_name(L, id, "_nw");
    CCSlice nh = pl_pw_name(L, id, "_nh");
    CCSlice spawned = pl_pw_name(L, id, "_spawned");
    CCSlice iv = pl_pw_name(L, id, "_i");
    CCSlice eok = pl_pw_name(L, id, "_eok");
    CCSlice sf = pl_pw_name(L, id, "_sf");
    CCSlice ret_ty = cstr_slice("int");
    CCSlice dst = cc_slice_empty();
    CCSlice gspell = cc_slice_empty();
    CCSlice wspell = cc_slice_empty();
    CCSlice los = cc_slice_empty();
    CCSlice his = cc_slice_empty();
    int gform = pl_pw_gate_form(w, pf.wait);
    CcNameList cache = pl_pw_cache_names(L, pf);
    CcNameList drops = vec_new::[CCSlice](L->arena);    /* cached names whose destroy is a drop function */
    CcNameList draise = vec_new::[CCSlice](L->arena);   /* those whose drop hands back a Result */
    bool hdest = pl_pw_handle_bind(pf);      /* the site binds a live `CCParallel` */
    CCSlice hv = hdest ? pf.bind : cc_slice_empty();
    size_t n;
    size_t i;
    if (pf.loop.body) {
        /* the body leaves for the run function before the walk reaches the
         * statement: whatever `@parallel` it holds is lowered here, first,
         * with the ticket binder in scope */
        sc_push(w);
        sc_declare(w, pf.loop.bind, cc_type_named(cstr_slice("int"), sp, L->arena));
        tw_stmt(w, pf.loop.body);
        sc_pop(w);
    }
    {
        /* a cached name is an enclosing declaration the extras copy: it has
         * to be one this function declares, of a type an instance of which
         * is a value, and it stays out of the `@stage` blocks */
        size_t nc = cache.len();
        size_t ci;
        for (ci = 0; ci < nc; ci++) {
            CCSlice nm = *cache.get_ptr(ci);
            CcVarDecl cv;
            CcDecl* cd = NULL;
            if (!pl_find_var_decl_at(st, nm, &cv, &cd)) {
                CCString m = @string(`cache (name) '${nm}' has no declaration in the function the walk stands in; the extras take their initializer and '${"@"}destroy' from one: declare '${nm}' above the walk`, L->arena);
                lw_error(L, sp, m);
                return;
            }
            if (pl_for_decayed(cv.type)) {
                CCString m = @string(`cache (name) '${nm}' is an array; the extras are instances of a value type: wrap the array in a struct and cache that`, L->arena);
                lw_error(L, sp, m);
                return;
            }
            if (pl_pw_cache_in_stage(pf.loop.body, nm)) {
                CCString m = @string(`cache (name) '${nm}' is read inside an '${"@"}stage' block: a stage is loop-carried identity and a cached name is an instance no ticket can name; read '${nm}' outside the stage, or drop it from 'cache'`, L->arena);
                lw_error(L, sp, m);
                return;
            }
            if (cv.destroy && cv.destroy_body && cd) {
                /* one body for the declared instance and every extra */
                bool raises = false;
                if (!pl_pw_drop_make(st, id, nm, &cv, cd, &raises, sp)) return;
                drops.push(nm);
                if (raises) draise.push(nm);
            }
        }
    }
    memset(&sc, 0, sizeof(sc));
    sc.st = st;
    sc.w = w;
    sc.caps = vec_new::[PCapRef](L->arena);
    sc.seen = vec_new::[CCSlice](L->arena);
    sc.skip = pf.loop.bind;
    {
        CcVisitor v;
        memset(&v, 0, sizeof(v));
        v.expr = pl_scan_expr;
        v.env = &sc;
        if (pf.loop.body) CcStmt_walk(pf.loop.body, v);
    }
    caps = sc.caps;
    n = caps.len();
    for (i = 0; i < n; i++) {
        PCap* c = *caps.get_ptr(i);
        c->by_addr = true;
    }
    if (st->fn_ret) {
        /* the cell a `return` lands in is typed by the function it leaves;
         * a `void` one still needs a cell C can declare */
        CCSlice rn = L->ix->canon(st->fn_ret);
        CCSlice vd = cstr_slice("void");
        if (rn.len && !slice_eq(rn, vd)) ret_ty = rn;
    }
    if (pl_pw_result_dest(pf)) {
        if (pf.bind.len) {
            /* the answer outlives the block, so its declaration goes before
             * it, in the list the block sits in */
            PBind* b = cc_arena_alloc(L->arena, sizeof(PBind), _Alignof(PBind));
            memset(b, 0, sizeof(*b));
            b->at = s;
            b->name = pf.bind;
            b->type = pf.bind_type ? pf.bind_type : cc_type_named(cstr_slice("bool"), sp, L->arena);
            st->binds.push(b);
            dst = pf.bind;
        } else {
            CCString t = lw_spell_expr(L, pf.target);
            dst = lw_keep(L, &t);
        }
    } else if (hdest) {
        /* the handle outlives the block: declared above it, with the
         * destroy hook the tail wrote, the way a bound brace join is */
        PBind* b = cc_arena_alloc(L->arena, sizeof(PBind), _Alignof(PBind));
        memset(b, 0, sizeof(*b));
        b->at = s;
        b->name = pf.bind;
        b->type = pf.bind_type;
        b->destroy = pl_tail_destroys(pf.tail, &b->destroy_body);
        st->binds.push(b);
    }
    { CCString t = lw_spell_expr(L, pf.wait); wspell = lw_keep(L, &t); }
    if (pf.seq) { CCString t = lw_spell_expr(L, pf.seq); gspell = lw_keep(L, &t); }
    { CCString t = lw_spell_expr(L, rg.lo); los = lw_keep(L, &t); }
    { CCString t = lw_spell_expr(L, rg.hi); his = lw_keep(L, &t); }
    {
        CCString et = pl_pw_env_text(st, id, &caps, ret_ty, &cache);
        pl_host(st); st->fwd.push_slice(et.as_slice(), L->arena);
    }
    pl_pw_forward(st, id);
    st->made.push(pl_pw_run_decl(st, id, &caps, pf.loop, pf.worker, &cache, sp));
    st->made.push(pl_pw_worker_decl(st, id, sp));
    {
        CCString a1 = @string(`${env} ${ev}`, L->arena);
        CCString a2 = @string(`${sht} ${shv}`, L->arena);
        CCString a3 = @string(`${ext} ${cell}`, L->arena);
        CCString a4 = @string(`${slt} ${s0}`, L->arena);
        CCString a5 = @string(`CCNurseryHost* ${nur} = 0`, L->arena);
        CCString a6 = @string(`CCChan* ${work} = 0`, L->arena);
        CCString a7 = @string(`${slt}* ${slots} = 0`, L->arena);
        CCString a8 = @string(`${agt}* ${args} = 0`, L->arena);
        /* The pool is capped on a `CCTurnstile`. A gate held by value is
         * taken by address; one already a pointer is passed on; a
         * `CCTurnstileRW` is two stages around one core, and the core is
         * the turnstile the tickets enter. */
        CCString a9 = @string(`CCTurnstile* ${gv} = (${wspell})`, L->arena);
        if (gform == 1) a9 = @string(`CCTurnstile* ${gv} = &(${wspell})`, L->arena);
        else if (gform == 3) a9 = @string(`CCTurnstile* ${gv} = &(${wspell}).core`, L->arena);
        else if (gform == 4) a9 = @string(`CCTurnstile* ${gv} = &(${wspell})->core`, L->arena);
        pl_pw_text(L, blk, a1, sp);
        pl_pw_text(L, blk, a2, sp);
        pl_pw_text(L, blk, a3, sp);
        pl_pw_text(L, blk, a4, sp);
        pl_pw_text(L, blk, a5, sp);
        pl_pw_text(L, blk, a6, sp);
        pl_pw_text(L, blk, a7, sp);
        pl_pw_text(L, blk, a8, sp);
        pl_pw_text(L, blk, a9, sp);
    }
    if (hdest) {
        /* the dest is planted before the pool opens: live from here to the
         * join, and the handle the tickets pause, resume and cancel through */
        CCString t = @string(`${hv} = cc_parallel_dest()`, L->arena);
        pl_pw_text(L, blk, t, sp);
    }
    {
        CCString b1 = @string(`CCError ${ferr}`, L->arena);
        CCString b2 = @string(`int ${fail} = 0`, L->arena);
        CCString b3 = @string(`int ${echo} = 0`, L->arena);
        CCString b4 = @string(`int ${best} = 0`, L->arena);
        CCString b5 = @string(`int ${wv} = 0`, L->arena);
        CCString b6 = @string(`int ${nw} = 1`, L->arena);
        CCString b7 = @string(`int ${nh} = 1`, L->arena);
        CCString b8 = @string(`int ${spawned} = 0`, L->arena);
        CCString b9 = @string(`int ${iv} = 0`, L->arena);
        CCString b10 = @string(`int ${eok} = 0`, L->arena);
        CCString b11 = @string(`int ${sf} = 0`, L->arena);
        pl_pw_text(L, blk, b1, sp);
        pl_pw_text(L, blk, b2, sp);
        pl_pw_text(L, blk, b3, sp);
        pl_pw_text(L, blk, b4, sp);
        pl_pw_text(L, blk, b5, sp);
        pl_pw_text(L, blk, b6, sp);
        pl_pw_text(L, blk, b7, sp);
        pl_pw_text(L, blk, b8, sp);
        pl_pw_text(L, blk, b9, sp);
        pl_pw_text(L, blk, b10, sp);
        pl_pw_text(L, blk, b11, sp);
    }
    {
        CCString z1 = @string(`cc__bytes_zero(&${ferr}, sizeof(${ferr}))`, L->arena);
        CCString z2 = @string(`cc__bytes_zero(&${cell}, sizeof(${cell}))`, L->arena);
        CCString z3 = @string(`cc__bytes_zero(&${s0}, sizeof(${s0}))`, L->arena);
        CCString z4 = @string(`cc__bytes_zero(&${ev}, sizeof(${ev}))`, L->arena);
        CCString z5 = @string(`cc__bytes_zero(&${shv}, sizeof(${shv}))`, L->arena);
        CCString z6 = @string(`if (${gv} && ${gv}->cap > 1) ${nw} = ${gv}->cap`, L->arena);
        pl_pw_text(L, blk, z1, sp);
        pl_pw_text(L, blk, z2, sp);
        pl_pw_text(L, blk, z3, sp);
        pl_pw_text(L, blk, z4, sp);
        pl_pw_text(L, blk, z5, sp);
        pl_pw_text(L, blk, z6, sp);
    }
    /* the gate is read once, here: a site it denies opens no pool at all and
     * the tickets go through the same body on the caller */
    if (gspell.len) {
        CCString c1 = @string(`if ((${gspell})) { __typeof__(cc_nursery_create()) __cc_pw_nr = cc_nursery_create(); if (__cc_pw_nr.ok) ${nur} = __cc_pw_nr.u.value.p; }`, L->arena);
        pl_pw_text(L, blk, c1, sp);
    } else {
        CCString c1 = @string(`{ __typeof__(cc_nursery_create()) __cc_pw_nr = cc_nursery_create(); if (__cc_pw_nr.ok) ${nur} = __cc_pw_nr.u.value.p; }`, L->arena);
        pl_pw_text(L, blk, c1, sp);
    }
    {
        /* an allocation that did not come back closes the pool again rather
         * than running half of one: the caller takes the tickets instead */
        CCString c2 = @string(`if (${nur}) { ${work} = cc_chan_create((size_t)${nw}); if (${work}) ${slots} = cc_nursery_closure_env_alloc_host(${nur}, (size_t)${nw} * sizeof(*${slots}), 16); if (${slots}) ${args} = cc_nursery_closure_env_alloc_host(${nur}, (size_t)${nw} * sizeof(*${args}), 16); }`, L->arena);
        CCString more = cc_string_new();
        CCString c3;
        pl_pw_text(L, blk, c2, sp);
        pl_pw_cache_alloc(st, blk, id, &caps, &cache, nur, nw, &more, sp);
        c3 = @string(`if (${nur} && (!${work} || !${slots} || !${args}${more})) { if (${work}) cc_chan_free(${work}); ${work} = 0; ${slots} = 0; ${args} = 0; cc_nursery_free_host(${nur}); ${nur} = 0; }`, L->arena);
        pl_pw_text(L, blk, c3, sp);
    }
    pl_pw_cache_init(st, blk, id, &caps, &cache, nw, wv, sp);
    {
        /* the caller's own slot stands in for a runner's when there is no
         * pool, so the body is handed the same shape on either schedule */
        CCString f1 = @string(`${shv}.gate = ${gv}`, L->arena);
        CCString f2 = @string(`${shv}.nur = ${nur}`, L->arena);
        CCString f3 = @string(`${shv}.work = ${work}`, L->arena);
        /* the handle the tickets pause and resume through, and the nursery
         * its cancel stops: `h.n` is the pool, so `h.cancel()` marks the
         * dest and cancels the pool, and the enter loop below stops */
        CCString f4 = hdest ? @string(`${shv}.dest = &${hv}; ${hv}.n = ${nur}`, L->arena)
                            : @string(`${shv}.dest = 0`, L->arena);
        CCString f5 = @string(`${ev}.sh = &${shv}`, L->arena);
        CCString f6 = @string(`${ev}.slots = ${slots} ? ${slots} : &${s0}`, L->arena);
        CCString f7 = @string(`${ev}.__cc_pf_ex = &${cell}`, L->arena);
        CCString f8 = @string(`${nh} = ${slots} ? ${nw} : 1`, L->arena);
        pl_pw_text(L, blk, f1, sp);
        pl_pw_text(L, blk, f2, sp);
        pl_pw_text(L, blk, f3, sp);
        pl_pw_text(L, blk, f4, sp);
        pl_pw_text(L, blk, f5, sp);
        pl_pw_text(L, blk, f6, sp);
        pl_pw_text(L, blk, f7, sp);
        pl_pw_text(L, blk, f8, sp);
    }
    for (i = 0; i < n; i++) {
        PCap* c = *caps.get_ptr(i);
        CCSlice cn = c->name;
        CCString as = pl_for_decayed(c->type)
            ? @string(`${ev}.${cn} = (${cn})`, L->arena)
            : @string(`${ev}.${cn} = &(${cn})`, L->arena);
        pl_pw_text(L, blk, as, sp);
        if (pl_pw_is_cache(&cache, cn)) {
            /* the extras beside the declared instance: a runner past slot
             * 0 checks out its own */
            CCSlice cx = pl_pw_cx_name(L, id, cn);
            CCString cs = @string(`${ev}.__cc_pw_cx_${cn} = ${cx}`, L->arena);
            pl_pw_text(L, blk, cs, sp);
        }
    }
    {
        CCString g1 = @string(`if (${nur}) cc__bytes_zero(${slots}, (size_t)${nw} * sizeof(*${slots}))`, L->arena);
        CCString g2 = @string(`if (${nur}) for (${wv} = 0; ${wv} < ${nw}; ${wv}++) { ${args}[${wv}].work = ${work}; ${args}[${wv}].env = &${ev}; ${args}[${wv}].slot = ${wv}; if (cc_is_ok(cc_nursery_spawn_host(${nur}, ${worker}, &${args}[${wv}]))) ${spawned}++; }`, L->arena);
        pl_pw_text(L, blk, g1, sp);
        pl_pw_text(L, blk, g2, sp);
    }
    {
        /* the tickets, in order and under the gate. The ticket is held
         * before the body is reached on either schedule, and the body gives
         * it back; a ticket that was held but never reached gives it back
         * here. */
        CcStmt* lb = lw_block(L, sp);
        /* a bound handle is honored at enter -- a paused dest hands out no
         * ticket until it resumes -- and a cancelled one hands out none */
        CCString k1 = hdest ? @string(`cc_parallel_honor(&${hv}); if (cc_nursery_is_cancelled_host(${nur}) || cc_atomic_load(&${hv}.cancelled)) break`, L->arena)
                            : @string(`if (cc_nursery_is_cancelled_host(${nur})) break`, L->arena);
        CCString k2 = @string(`if (cc_atomic_load(&${cell}.xk)) break`, L->arena);
        CCString k3 = @string(`if (!${spawned} && ${ev}.slots[0].failed) break`, L->arena);
        CCString k4 = @string(`{ __typeof__(cc_turnstile_enter(${gv}, ${iv})) __cc_pw_r = cc_turnstile_enter(${gv}, ${iv}); ${eok} = __cc_pw_r.ok; if (!__cc_pw_r.ok) ${ferr} = __cc_pw_r.u.error.base; }`, L->arena);
        CCString k5 = @string(`if (!${eok}) { ${fail} = 1; ${best} = ${iv}; break; }`, L->arena);
        CCString k6 = @string(`${sf} = 0`, L->arena);
        CCString k7 = @string(`if (${spawned} && cc_chan_send(${work}, &${iv}, sizeof(${iv})) != 0) ${sf} = 1`, L->arena);
        CCString k8 = @string(`if (!${spawned}) ${run}(&${ev}, ${iv}, 0)`, L->arena);
        CCString k9 = @string(`if (${sf}) { (void)cc_turnstile_leave(${gv}); ${ferr} = CC_ERROR(CC_ERR_IO, "parallel wait send"); ${fail} = 1; ${best} = ${iv}; break; }`, L->arena);
        CCString ki = @string(`${iv} = (int)(${los})`, L->arena);
        CCString kc = @string(`${iv} < (int)(${his})`, L->arena);
        CCString ks = @string(`${iv}++`, L->arena);
        pl_pw_text(L, lb, k1, sp);
        pl_pw_text(L, lb, k2, sp);
        pl_pw_text(L, lb, k3, sp);
        pl_pw_text(L, lb, k4, sp);
        pl_pw_text(L, lb, k5, sp);
        pl_pw_text(L, lb, k6, sp);
        pl_pw_text(L, lb, k7, sp);
        pl_pw_text(L, lb, k8, sp);
        pl_pw_text(L, lb, k9, sp);
        lw_push(blk, pl_pw_for(L, ki, kc, ks, lb, sp));
    }
    {
        CCString h1 = @string(`if (${work}) cc_chan_close(${work})`, L->arena);
        CCString h2 = @string(`if (${nur}) (void)cc_nursery_wait_host(${nur})`, L->arena);
        pl_pw_text(L, blk, h1, sp);
        pl_pw_text(L, blk, h2, sp);
    }
    pl_pw_cache_destroy(st, blk, id, &caps, &cache, &drops, &draise, nw, wv, sp);
    if (hdest) {
        /* joined: every ticket ran or was drained, and the pool is about to
         * go, so the handle names no nursery any more */
        CCString t = @string(`${hv}.n = 0; cc_atomic_store(&${hv}.joined, 1)`, L->arena);
        pl_pw_text(L, blk, t, sp);
    }
    {
        /* which ticket error re-raises: the earliest one that is not just an
         * echo of the cancel the first error asked for */
        CcStmt* hb = lw_block(L, sp);
        CCString p1 = @string(`${slt}* __cc_pw_it = &${ev}.slots[${wv}]; int __cc_pw_ec = __cc_pw_it->failed && (__cc_pw_it->err.kind == CC_ERR_CANCELLED)`, L->arena);
        CCString p2 = @string(`if (__cc_pw_it->failed && (!${fail} || (!__cc_pw_ec && ${echo}) || (__cc_pw_ec == ${echo} && __cc_pw_it->i < ${best}))) { ${ferr} = __cc_pw_it->err; ${fail} = 1; ${best} = __cc_pw_it->i; ${echo} = __cc_pw_ec; }`, L->arena);
        CCString hi = @string(`${wv} = 0`, L->arena);
        CCString hc = @string(`${wv} < ${nh}`, L->arena);
        CCString hs = @string(`${wv}++`, L->arena);
        pl_pw_text(L, hb, p1, sp);
        pl_pw_text(L, hb, p2, sp);
        lw_push(blk, pl_pw_for(L, hi, hc, hs, hb, sp));
    }
    {
        CCString r1 = @string(`if (${work}) cc_chan_free(${work})`, L->arena);
        CCString r2 = @string(`if (${nur}) cc_nursery_free_host(${nur})`, L->arena);
        pl_pw_text(L, blk, r1, sp);
        pl_pw_text(L, blk, r2, sp);
    }
    {
        /* the `!>` the site was written with: the error the pool left is the
         * enclosing handler's, raised where the walk stood */
        CcStmt* then = lw_block(L, sp);
        CcStmt* fw = cc__stmt_blank(sp, L->arena);
        CcErrFwd fe;
        CCString cnd = @string(`${fail}`, L->arena);
        fe.err = lw_paren(L, lw_ident(L, ferr, sp), sp);
        fe.delegate = false;
        { CcStmtK sk = { .err_fwd = fe }; fw->k = sk; }
        lw_push(then, fw);
        lw_push(blk, lw_if(L, lw_text(L, cnd, sp), then, NULL, sp));
    }
    {
        /* a `return` inside the body is the caller's to make */
        CcStmt* then = lw_block(L, sp);
        CCString rv = @string(`${cell}.rv`, L->arena);
        CCString cnd = @string(`cc_atomic_load(&${cell}.xk) == 2`, L->arena);
        lw_push(then, cc_stmt_return(lw_text(L, rv, sp), sp, L->arena));
        lw_push(blk, lw_if(L, lw_text(L, cnd, sp), then, NULL, sp));
    }
    if (dst.len) {
        /* the walk's own answer, reached only by the site that neither
         * raised nor returned: every ticket ran unless one of them broke */
        CCString t = @string(`${dst} = (cc_atomic_load(&${cell}.xk) != 1)`, L->arena);
        pl_pw_text(L, blk, t, sp);
    }
    s->k = blk->k;
    st->any = true;
}

/* `} !>` after the body: the tail that says a ticket error leaves the site.
 * A join that keeps its Result says something else, and the site has nowhere
 * to put the error it collected. */
static bool pl_pw_tail_raises(CcExpr* tail) {
    bool raises = false;
    if (!tail) return false;
    @switch (tail->k) {
        case .unwrap: raises = true; break;
        /* the destroy tail on a bound handle unwraps the same way */
        case .unwrap_destroy: raises = true; break;
        default: break;
    }
    return raises;
}

/* A `break` that belongs to the walk itself, not to a loop the body opened.
 * It makes the site's join answer a question -- did every ticket run? -- so
 * the walk is the bound form (`bool fin = ${"@"}parallel ... !>.wait()!>`) and
 * a site with nowhere to put that answer is refused. */
static bool pl_pw_break_at(CcStmt* s, int depth) {
    CcStmtList* bs;
    size_t n;
    size_t i;
    int inner = depth;
    bool opens = false;
    bool is_break = false;
    CcStmt* a = NULL;
    CcStmt* b = NULL;
    if (!s) return false;
    @switch (s->k) {
        case .break_: is_break = true; break;
        case .for_(x): opens = true; a = x.body; break;
        case .while_(x): opens = true; a = x.body; break;
        case .do_(x): opens = true; a = x.body; break;
        case .switch_(x): opens = true; a = x.body; break;
        case .if_(x): a = x.then; b = x.els; break;
        case .label(x): a = x.inner; break;
        default: break;
    }
    if (is_break) return depth == 0;
    if (opens) inner = depth + 1;
    bs = lw_block_stmts(s);
    if (bs) {
        n = bs->len();
        for (i = 0; i < n; i++) {
            CcStmt* k = *bs->get_ptr(i);
            if (pl_pw_break_at(k, inner)) return true;
        }
        return false;
    }
    if (a && pl_pw_break_at(a, inner)) return true;
    if (b && pl_pw_break_at(b, inner)) return true;
    return false;
}

/* A `goto` in a walked body that leaves it. The body becomes a function of
 * its own, so a label the site can see is one the body cannot jump to; C
 * would say so at a line that reads as the walk's, which is not where the
 * jump is. A jump to a label the body carries itself stays inside and is
 * nobody's business but the body's, so the labels are collected first. */
typedef struct PGoto {
    CcLowerer* L;
    CcNameList labels;
    CCSlice out;                /* the first label jumped to from outside */
} PGoto;

static bool pl_pw_label_visit(CcStmt* s, void* env) {
    PGoto* g = (PGoto*)env;
    CCSlice name = cc_slice_empty();
    @switch (s->k) {
        case .label(lb): name = lb.name; break;
        default: break;
    }
    if (name.len) g->labels.push(name);
    return true;
}

static bool pl_pw_goto_visit(CcStmt* s, void* env) {
    PGoto* g = (PGoto*)env;
    CCSlice want = cc_slice_empty();
    CcGoto gt;
    bool is_goto = false;
    size_t n;
    size_t i;
    bool inside = false;
    /* `gt.label` inside the switch would read as a projection of the arm
     * named `label`, which is a different statement kind entirely. Read the
     * jump's own field once the switch is behind us. */
    @switch (s->k) {
        case .goto_(x): gt = x; is_goto = true; break;
        default: break;
    }
    if (!is_goto) return true;
    want = gt.label;
    if (!want.len || g->out.len) return true;
    n = g->labels.len();
    for (i = 0; i < n; i++) {
        CCSlice nm = *g->labels.get_ptr(i);
        if (slice_eq(nm, want)) inside = true;
    }
    if (!inside) g->out = want;
    return true;
}

static CCSlice pl_pw_goto_out(CcLowerer* L, CcStmt* body) {
    CcVisitor v;
    PGoto g;
    if (!body) return cc_slice_empty();
    g.L = L;
    g.labels = vec_new::[CCSlice](L->arena);
    g.out = cc_slice_empty();
    memset(&v, 0, sizeof(v));
    v.stmt = pl_pw_label_visit;
    v.env = &g;
    CcStmt_walk(body, v);
    memset(&v, 0, sizeof(v));
    v.stmt = pl_pw_goto_visit;
    v.env = &g;
    CcStmt_walk(body, v);
    return g.out;
}

/* One name, asked of a body: is it declared there, is it read there. */
typedef struct PCacheQ { CCSlice want; bool found; } PCacheQ;

static bool pl_cache_decl_visit(CcStmt* s, void* env) {
    PCacheQ* q = (PCacheQ*)env;
    CcDecl* d = NULL;
    CCSlice nm = cc_slice_empty();
    @switch (s->k) {
        case .decl(ds): d = ds.d; break;
        default: break;
    }
    if (!d) return true;
    @switch (d->k) {
        case .var(v): nm = v.name; break;
        default: break;
    }
    if (nm.len && slice_eq(nm, q->want)) q->found = true;
    return true;
}

static bool pl_cache_ident_visit(CcExpr* e, void* env) {
    PCacheQ* q = (PCacheQ*)env;
    CCSlice nm = cc_slice_empty();
    @switch (e->k) {
        case .ident(x): nm = x; break;
        default: break;
    }
    if (nm.len && slice_eq(nm, q->want)) q->found = true;
    return true;
}

/* Does the walk's body declare `nm` itself? */
static bool pl_cache_body_local(CcStmt* body, CCSlice nm) {
    PCacheQ q;
    CcVisitor v;
    if (!body) return false;
    q.want = nm;
    q.found = false;
    memset(&v, 0, sizeof(v));
    v.stmt = pl_cache_decl_visit;
    v.env = &q;
    CcStmt_walk(body, v);
    return q.found;
}

/* Does an `@stage` of this body name `nm`? */
static bool pl_cache_in_stage(CcStmt* body, CCSlice nm) {
    CcStmtList* bs = lw_block_stmts(body);
    size_t n;
    size_t i;
    if (!bs) return false;
    n = bs->len();
    for (i = 0; i < n; i++) {
        CcStmt* k = *bs->get_ptr(i);
        bool is_stage = false;
        @switch (k->k) {
            case .stage: is_stage = true; break;
            default: break;
        }
        if (!is_stage) continue;
        {
            PCacheQ q;
            CcVisitor v;
            q.want = nm;
            q.found = false;
            memset(&v, 0, sizeof(v));
            v.expr = pl_cache_ident_visit;
            v.env = &q;
            CcStmt_walk(k, v);
            if (q.found) return true;
        }
    }
    return false;
}

/* `cache (name)` adopts a declaration of the enclosing scope so every ticket
 * of the walk shares one object instead of each getting its own.
 *
 * What a name may be is fixed by the form, not by how much of the form this
 * lowerer emits yet: a body local is a different object per instance, a name
 * nothing declared is nothing to adopt, and a name an `@stage` reads is
 * loop-carried — the opposite contract. None of those becomes writable by
 * lowering the walk, so they are answered here rather than behind the refusal
 * below, which is about this emit and not about the program. */
static bool pl_pw_cache_ok(PStep* st, CcParallelFor pf, CcSpan sp) {
    CcLowerer* L = st->L;
    CcExprList* cv = &pf.cache;
    size_t n = cv->len();
    size_t i;
    bool ok = true;
    for (i = 0; i < n; i++) {
        CcExpr* ce = *cv->get_ptr(i);
        CCSlice nm = cc_slice_empty();
        bool is_bind;
        bool is_bind2;
        bool is_worker;
        bool dup = false;
        size_t j;
        if (!expr_ident(strip_parens_expr(ce), &nm)) continue;
        if (!nm.len) continue;
        is_bind = pf.loop.bind.len != 0 && slice_eq(nm, pf.loop.bind);
        is_bind2 = pf.loop.bind2.len != 0 && slice_eq(nm, pf.loop.bind2);
        is_worker = pf.worker.len != 0 && slice_eq(nm, pf.worker);
        if (is_bind || is_bind2 || is_worker) {
            CCString m = @string(`cache (name) cannot adopt the loop variable or worker binder '${nm}'`, L->arena);
            lw_error(L, sp, m);
            ok = false;
            continue;
        }
        if (pl_cache_body_local(pf.loop.body, nm)) {
            CCString m = @string(`cache (name) '${nm}' is a body local — adopt an enclosing declaration`, L->arena);
            lw_error(L, sp, m);
            ok = false;
            continue;
        }
        if (!sc_lookup(st->w, nm)) {
            CCString m = @string(`cache (name) '${nm}' is not a name in the enclosing scope`, L->arena);
            lw_error(L, sp, m);
            ok = false;
            continue;
        }
        for (j = 0; j < i; j++) {
            CcExpr* pe = *cv->get_ptr(j);
            CCSlice pn = cc_slice_empty();
            if (!expr_ident(strip_parens_expr(pe), &pn)) continue;
            if (pn.len && slice_eq(pn, nm)) dup = true;
        }
        if (dup) {
            CCString m = @string(`cache (name) adopts '${nm}' once`, L->arena);
            lw_error(L, sp, m);
            ok = false;
            continue;
        }
        if (pl_cache_in_stage(pf.loop.body, nm)) {
            CCString m = @string(`cache (name) '${nm}' cannot appear in an ${"@"}stage block — stage is loop-carried, cache is unobservable instance identity`, L->arena);
            lw_error(L, sp, m);
            ok = false;
            continue;
        }
    }
    return ok;
}

/* `@parallel [seq (c)] [wait (ts)] for (i in lo..hi) [worker (w)] [cache (…)]`.
 *
 * None of it is lowered yet, but the shape is checked here rather than left
 * to the host: a walk left standing keeps its `!>` tail, and the tail's
 * left operand is the identifier `@parallel`, which the Result step reads
 * as a plain name and reports as needing a Result -- twice, at a line that
 * says nothing about what is wrong. So every path out of this function
 * replaces the statement with an empty block, which takes the tail with it. */
static void pl_for(PStep* st, CcStmt* s, CcParallelFor pf) {
    CcLowerer* L = st->L;
    CcSpan sp = s->span;
    CCString m;
    CcStmt* gone = lw_block(L, sp);
    if (pf.spawn) {
        m = @string(`'${"@"}parallel spawn': do not combine with for or wait`, L->arena);
        lw_error(L, sp, m);
        s->k = gone->k;
        return;
    }
    if (pf.seq && !pf.wait) {
        m = cc_string_new();
        cc_string_push_cstr(&m, "@parallel seq (...) with 'for' requires 'wait (gate)'", L->arena);
        lw_error(L, sp, m);
        s->k = gone->k;
        return;
    }
    if (pf.cache.len() && !pf.wait) {
        m = @string(`cache (name) requires the wait (gate) form`, L->arena);
        lw_error(L, sp, m);
        s->k = gone->k;
        return;
    }
    /* the walk's own `@stage`s are its own: a stage anywhere else is stray,
     * and saying so is this step's job even before the walk itself lowers */
    if (pf.wait && pf.loop.body) {
        CcStmtList* bs = lw_block_stmts(pf.loop.body);
        if (bs) {
            size_t n = bs->len();
            size_t i;
            for (i = 0; i < n; i++) {
                CcStmt* k = *bs->get_ptr(i);
                bool is_stage = false;
                @switch (k->k) {
                    case .stage: is_stage = true; break;
                    default: break;
                }
                if (is_stage) st->stages.push(k);
            }
        }
    }
    /* the body goes with the statement below, so anything in it this step
     * would have reported has to be reported before it does */
    if (pf.loop.body) pl_stray_stages(st, pf.loop.body);
    if (!pf.wait) {
        CcRange rg;
        CcExprList* itv = &pf.loop.iterables;
        bool ranged = itv->len() == 1 && fi_is_range(*itv->get_ptr(0), &rg);
        if (!ranged || pf.loop.bind2.len || pf.loop.by_ref) {
            m = cc_string_new();
            cc_string_push_cstr(&m, "@parallel for walks a range: write 'for (name in lo..hi)'", L->arena);
            lw_error(L, sp, m);
            s->k = gone->k;
            return;
        }
        if (pl_par_off_at(st, sp.first)) pl_for_inert(st, s, pf, rg);
        else pl_for_lower(st, s, pf, rg);
        return;
    }
    if (pf.pred) {
        m = @string(`a gated '${"@"}parallel wait (...) for' spells its gate 'seq (...)': the predicate form is not lowered by the clean lowerer yet`, L->arena);
        lw_error(L, sp, m);
        s->k = gone->k;
        return;
    }
    if (pf.cache.len() && !pl_pw_cache_ok(st, pf, sp)) {
        s->k = gone->k;
        return;
    }
    if (!pl_pw_gate_form(st->w, pf.wait)) {
        m = @string(`'${"@"}parallel wait (...)' caps on a gate: it must be a CCTurnstile or a CCTurnstileRW`, L->arena);
        lw_error(L, sp, m);
        s->k = gone->k;
        return;
    }
    if (pf.loop.body && pl_pw_break_at(pf.loop.body, 0) && !pl_pw_result_dest(pf)) {
        /* Assembled rather than templated: the message carries an `@` and a
         * `!>`, and a template reads the first as a sigil. */
        m = cc_string_new();
        cc_string_push_cstr(&m, "a '@parallel wait for' that can 'break' is bool !>(CCError); bind the bool (the range did not finish)", L->arena);
        lw_error(L, sp, m);
        s->k = gone->k;
        return;
    }
    {
        /* not a gap: the body is a function of its own, so the label is one
         * it can never reach, whatever the lowering does */
        CCSlice away = pl_pw_goto_out(L, pf.loop.body);
        if (away.len) {
            m = @string(`goto '${away}' crosses a '${"@"}parallel' boundary`, L->arena);
            lw_error(L, sp, m);
            s->k = gone->k;
            return;
        }
    }
    if (!pl_pw_stages_ok(st, pf.loop.body)) {
        s->k = gone->k;
        return;
    }
    if (!pl_pw_tail_raises(pf.tail)) {
        /* Assembled rather than templated: the message carries an `@` and a
         * `!>`, and a template reads the first as a sigil. */
        m = cc_string_new();
        cc_string_push_cstr(&m, "@parallel wait (gate) for needs its '!>.wait()!>' tail: a ticket error has nowhere else to go", L->arena);
        lw_error(L, sp, m);
        s->k = gone->k;
        return;
    }
    {
        CcRange rg;
        CcExprList* itv = &pf.loop.iterables;
        bool ranged = itv->len() == 1 && fi_is_range(*itv->get_ptr(0), &rg);
        if (!ranged || pf.loop.bind2.len || pf.loop.by_ref) {
            m = cc_string_new();
            cc_string_push_cstr(&m, "@parallel wait (gate) for walks a range: write 'for (name in lo..hi)'", L->arena);
            lw_error(L, sp, m);
            s->k = gone->k;
            return;
        }
        if (pl_par_off_at(st, sp.first)) pl_for_inert(st, s, pf, rg);
        else pl_pw_lower(st, s, pf, rg);
    }
}

/* The walk records a `return` into a cell typed by the function it leaves. */
static void pl_on_decl(Walker* w, CcDecl* d) {
    PStep* st = (PStep*)w->env;
    CcFuncDecl f;
    bool is_fn = false;
    st->fn_ret = NULL;
    st->at_decl = d;
    st->eh_top = vec_new::[CcStmtRef](st->L->arena);
    st->eh_any = false;
    st->eh_in_scope = 0;
    st->eh_marks = vec_new::[size_t](st->L->arena);
    @switch (d->k) {
        case .func(x): f = x; is_fn = true; break;
        default: break;
    }
    if (!is_fn || !f.type) return;
    @switch (f.type->k) {
        case .func(ft): st->fn_ret = ft.ret; break;
        default: break;
    }
    if (f.body) {
        /* only the ones the function itself carries: a handler written in a
         * block below the site governs that block, not an arm elsewhere */
        CcStmtList body;
        bool is_block = false;
        @switch (f.body->k) {
            case .block(b): body = b.stmts; is_block = true; break;
            default: break;
        }
        if (is_block) {
            size_t i;
            size_t n = body.len();
            for (i = 0; i < n; i++) {
                CcStmt* t = *body.get_ptr(i);
                bool is_eh = false;
                @switch (t->k) {
                    case .errhandler: is_eh = true; break;
                    default: break;
                }
                if (!is_eh) continue;
                st->eh_top.push(t);
                st->eh_any = true;
            }
        }
    }
}

static void pl_on_stmt(Walker* w, CcStmt* s, bool enter) {
    PStep* st = (PStep*)w->env;
    CcParallel p;
    CcParallelDest pd;
    CcParallelFor pf;
    int shape = 0;              /* 1 arms, 2 dest, 3 for, 4 stage, 5 errhandler */
    @switch (s->k) {
        case .parallel(x): p = x; shape = 1; break;
        case .parallel_dest(x): pd = x; shape = 2; break;
        case .parallel_for(x): pf = x; shape = 3; break;
        case .stage: shape = 4; break;
        case .errhandler: shape = 5; break;
        default: break;
    }
    if (!enter) {
        /* leaving a statement drops the handlers declared inside it; a
         * handler itself stays in scope for the statements after it */
        Vec::[size_t]* marks = &st->eh_marks;
        size_t nm = marks->len();
        if (nm) {
            size_t m = *marks->get_ptr(nm - 1);
            marks->truncate(nm - 1);
            if (shape != 5) st->eh_in_scope = m;
        }
        return;
    }
    {
        Vec::[size_t]* marks = &st->eh_marks;
        marks->push(st->eh_in_scope);
    }
    if (shape == 5) st->eh_in_scope++;
    if (shape == 1) pl_lower(st, s, p);
    else if (shape == 2) pl_dest(st, s, pd);
    else if (shape == 3) pl_for(st, s, pf);
    else if (shape == 4 && !pl_stage_owned(st, s)) {
        CCString m = cc_string_new();
        cc_string_push_cstr(&m, "@stage must be a top-level statement of a '@parallel wait for' body", st->L->arena);
        lw_error(st->L, s->span, m);
    }
}

/* The handle a bound site fills is the caller's, so its declaration goes
 * before the block, in the list the block sits in. */
static PBind* pl_bind_at(PStep* st, CcStmt* s) {
    PBindList* v = &st->binds;
    size_t n = v->len();
    size_t i;
    for (i = 0; i < n; i++) {
        PBind* b = *v->get_ptr(i);
        if (b->at == s) return b;
    }
    return NULL;
}

static void pl_declare_binds(PStep* st, CcStmtList* list);

static void pl_declare_in(PStep* st, CcStmt* s) {
    StmtView v;
    if (!s) return;
    view_stmt(&v, s);
    if (v.is_block || (v.has_stmts && v.stmts.len())) {
        CcStmtList inner = v.stmts;
        pl_declare_binds(st, &inner);
        @switch (s->k) {
            case .block(b): b.stmts = inner; s->k = { .block = b }; break;
            default: break;
        }
    }
    pl_declare_in(st, v.body);
    pl_declare_in(st, v.else_body);
}

static void pl_declare_binds(PStep* st, CcStmtList* list) {
    CcLowerer* L = st->L;
    CcStmtList out = vec_new::[CcStmtRef](L->arena);
    size_t n = list->len();
    size_t i;
    for (i = 0; i < n; i++) {
        CcStmt* s = *list->get_ptr(i);
        PBind* b = pl_bind_at(st, s);
        if (b) {
            CcStmt* ds = lw_decl_stmt(L, b->type, b->name, NULL, s->span);
            if (b->destroy) {
                /* `!> @destroy` on the bind: the declaration carries the
                 * hook, and the cleanup step, seeing a bare declaration
                 * followed by the block that fills it, arms the hook after
                 * that block -- the same shape `T x = e !> @destroy` leaves */
                CcDecl* d = NULL;
                CcVarDecl v;
                bool is_var = false;
                @switch (ds->k) {
                    case .decl(x): d = x.d; break;
                    default: break;
                }
                if (d) {
                    @switch (d->k) {
                        case .var(x): v = x; is_var = true; break;
                        default: break;
                    }
                }
                if (is_var) {
                    v.destroy = true;
                    v.destroy_body = b->destroy_body;
                    { CcDeclK dk = { .var = v }; d->k = dk; }
                }
            }
            out.push(ds);
        }
        pl_declare_in(st, s);
        out.push(s);
    }
    *list = out;
}

static void CcLowerer_parallel(CcLowerer* L) {
    Walker w;
    PStep st;
    memset(&st, 0, sizeof(st));
    st.L = L;
    st.w = &w;
    st.made = vec_new::[CcDeclRef](L->arena);
    st.protos = vec_new::[CcDeclRef](L->arena);
    st.fwd = cc_string_new();
    st.binds = vec_new::[PBindRef](L->arena);
    st.stages = vec_new::[CcStmtRef](L->arena);
    st.off_from = vec_new::[uint32_t](L->arena);
    st.off_to = vec_new::[uint32_t](L->arena);
    pl_read_par_off(&st);
    memset(&w, 0, sizeof(w));
    w.arena = L->arena;
    w.ix = L->ix;
    w.unit = L->unit;
    w.on_decl = pl_on_decl;
    w.on_stmt = pl_on_stmt;
    w.env = &st;
    tw_unit(&w);
    if (!st.any) return;
    if (st.binds.len()) {
        CcDeclList* dv = &L->unit->decls;
        size_t nd0 = dv->len();
        size_t j;
        for (j = 0; j < nd0; j++) {
            CcDecl* d0 = *dv->get_ptr(j);
            CcFuncDecl f0;
            bool is_fn = false;
            @switch (d0->k) {
                case .func(x): f0 = x; is_fn = true; break;
                default: break;
            }
            st.at_decl = d0;
            if (is_fn && f0.body) pl_declare_in(&st, f0.body);
        }
    }
    {
        CcDeclList* decls = &L->unit->decls;
        CcDeclList with = vec_new::[CcDeclRef](L->arena);
        size_t nd = decls->len();
        size_t at = 0;
        size_t k;
        CcSpan sp;
        sp.first = 0;
        sp.last = 0;
        for (k = 0; k < nd; k++) {
            CcDecl* dd = *decls->get_ptr(k);
            bool is_pp = false;
            @switch (dd->k) {
                case .pp: is_pp = true; break;
                case .empty: is_pp = true; break;
                case .pragma_cc: is_pp = true; break;
                case .raw: is_pp = true; break;
                default: break;
            }
            if (!is_pp) break;
            at = k + 1;
        }
        for (k = at; st.first_host && k < nd; k++) {
            if (*decls->get_ptr(k) == st.first_host) { at = k; break; }
        }
        {
            CCString head = cc_string_new();
            head.push_cstr("/* --- CC parallel declarations --- */\n", L->arena);
            head.push_slice(cc_string_as_slice(&st.fwd), L->arena);
            head.push_cstr("/* --- end parallel declarations --- */", L->arena);
            CcDeclList* pv = &st.protos;
            size_t np = pv->len();
            size_t pk;
            for (k = 0; k < nd; k++) {
                CcDecl* dk = *decls->get_ptr(k);
                if (k == at) {
                    with.push(lw_raw_decl(L, head, sp));
                    for (pk = 0; pk < np; pk++) {
                        CcDecl* pd = *pv->get_ptr(pk);
                        with.push(pd);
                    }
                }
                with.push(dk);
            }
            if (at >= nd) {
                with.push(lw_raw_decl(L, head, sp));
                for (pk = 0; pk < np; pk++) {
                    CcDecl* pd = *pv->get_ptr(pk);
                    with.push(pd);
                }
            }
        }
        {
            CcDeclList* madev = &st.made;
            size_t nm2 = madev->len();
            with.push(lw_raw_decl(L, @string(`/* --- CC parallel arms --- */`, L->arena), sp));
            for (k = 0; k < nm2; k++) {
                CcDecl* md = *madev->get_ptr(k);
                with.push(md);
            }
        }
        *decls = with;
    }
}

#endif

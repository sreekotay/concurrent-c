#pragma(@per_tu)
/* Lowering: the pipeline and the node builders the steps share. Every
 * builder takes the span of the construct it stands in for. */
#ifndef CC_LOWER_LOWER_IMPL_CCH
#define CC_LOWER_LOWER_IMPL_CCH
#include "lower.cch"
#include "ast_impl.cch"
#include "parse_walk.cch"
#include "print_impl.cch"
#include "index_impl.cch"
#include <string.h>

static CcLowerer cc_lowerer_new(CcUnit* u, CcIndex* ix, CcLowerOpts opts, CcDiags* ds) {
    CcLowerer L;
    memset(&L, 0, sizeof(L));
    L.arena = u->arena;
    L.ds = ds;
    L.ix = ix;
    L.unit = u;
    L.opts = opts;
    L.next_temp = 0;
    L.headers = vec_new::[CCSlice](u->arena);
    return L;
}

static uint32_t CcLowerer_temp_id(CcLowerer* L) { return L->next_temp++; }

/* A TU-only construct so the extractor sees an implementation header
 * (without one, a header of plain C bodies is taken for an interface and
 * refuses the per-TU modules it includes). Never called. */
static CCString cc__lower_impl_marker(CcLowerer* L) {
    CCString s = @string(`lower`, L->arena);
    return s;
}

/* ---- diagnostics ------------------------------------------------------ */

static void lw_error(CcLowerer* L, CcSpan span, CCString msg) {
    CcUnit* u = L->unit;
    CcLoc loc = u->loc(span);
    CcDiag d = CcDiag_error(loc, cc_string_persist_slice(L->arena, &msg));
    CcDiags* ds = L->ds;
    ds->push(d);
}

/* ---- node builders ---------------------------------------------------- */

/* A persisted copy of a built string, as a slice the nodes can keep. */
static CCSlice lw_keep(CcLowerer* L, CCString* s) {
    return cc_string_persist_slice(L->arena, s);
}

static CcExpr* lw_ident(CcLowerer* L, CCSlice name, CcSpan sp) {
    return cc_expr_ident(name, sp, L->arena);
}

/* Any C text as an expression operand: printed verbatim. */
static CcExpr* lw_text(CcLowerer* L, CCString text, CcSpan sp) {
    return cc_expr_ident(lw_keep(L, &text), sp, L->arena);
}

/* The argument list of a call node, and the statement list of a block:
 * projections are lowered only inside a @switch on the node, so each
 * accessor is one. */
static CcExprList* lw_call_args(CcExpr* c) {
    CcExprList* args = NULL;
    @switch (c->k) {
        case .call: args = &c->k.call.args; break;
        default: break;
    }
    return args;
}

static CcStmtList* lw_block_stmts(CcStmt* b) {
    CcStmtList* list = NULL;
    @switch (b->k) {
        case .block: list = &b->k.block.stmts; break;
        default: break;
    }
    return list;
}

static CcExpr* lw_call0(CcLowerer* L, CCSlice fn, CcSpan sp) {
    return cc_expr_call(lw_ident(L, fn, sp), sp, L->arena);
}

static CcExpr* lw_call1(CcLowerer* L, CCSlice fn, CcExpr* a, CcSpan sp) {
    CcExpr* c = lw_call0(L, fn, sp);
    CcExprList* args = lw_call_args(c);
    args->push(a);
    return c;
}

static CcExpr* lw_call2(CcLowerer* L, CCSlice fn, CcExpr* a, CcExpr* b, CcSpan sp) {
    CcExpr* c = lw_call1(L, fn, a, sp);
    CcExprList* args = lw_call_args(c);
    args->push(b);
    return c;
}

static CcExpr* lw_member(CcLowerer* L, CcExpr* a, const char* name, CcSpan sp) {
    return cc_expr_member(a, cc_slice_from_buffer((char*)name, strlen(name)), false, sp, L->arena);
}

static CcExpr* lw_member_s(CcLowerer* L, CcExpr* a, CCSlice name, CcSpan sp) {
    return cc_expr_member(a, name, false, sp, L->arena);
}

static CcExpr* lw_not(CcLowerer* L, CcExpr* a, CcSpan sp) {
    return cc_expr_unary(CC_OP_NOT, a, sp, L->arena);
}

static CcExpr* lw_assign(CcLowerer* L, CcExpr* lhs, CcExpr* rhs, CcSpan sp) {
    CcExpr* e = cc__expr_blank(sp, L->arena);
    CcBinary b;
    b.op = CC_OP_ASSIGN;
    b.a = lhs;
    b.b = rhs;
    e->k = { .assign = b };
    return e;
}

static CcExpr* lw_paren(CcLowerer* L, CcExpr* a, CcSpan sp) {
    CcExpr* e = cc__expr_blank(sp, L->arena);
    CcUnary u;
    u.op = CC_OP_NONE;
    u.a = a;
    e->k = { .paren = u };
    return e;
}

static CcExpr* lw_ternary(CcLowerer* L, CcExpr* c, CcExpr* a, CcExpr* b, CcSpan sp) {
    CcExpr* e = cc__expr_blank(sp, L->arena);
    CcTernary t;
    t.c = c;
    t.a = a;
    t.b = b;
    e->k = { .ternary = t };
    return e;
}

static CcType* lw_named_type(CcLowerer* L, CCSlice name, CcSpan sp) {
    return cc_type_named(name, sp, L->arena);
}

static CcStmt* lw_expr_stmt(CcLowerer* L, CcExpr* e, CcSpan sp) {
    return cc_stmt_expr(e, sp, L->arena);
}

static CcStmt* lw_block(CcLowerer* L, CcSpan sp) {
    return cc_stmt_block(sp, L->arena);
}

static void lw_push(CcStmt* block, CcStmt* s) {
    CcStmtList* list = lw_block_stmts(block);
    list->push(s);
}

static CcStmt* lw_if(CcLowerer* L, CcExpr* cond, CcStmt* then, CcStmt* els, CcSpan sp) {
    return cc_stmt_if(cond, then, els, sp, L->arena);
}

static CcStmt* lw_goto(CcLowerer* L, CCSlice label, CcSpan sp) {
    return cc_stmt_goto(label, sp, L->arena);
}

static CcStmt* lw_label(CcLowerer* L, CCSlice name, CcStmt* inner, CcSpan sp) {
    return cc_stmt_label(name, inner, sp, L->arena);
}

/* `T name = init;` (init may be NULL) as a statement. */
static CcStmt* lw_decl_stmt(CcLowerer* L, CcType* type, CCSlice name, CcExpr* init, CcSpan sp) {
    CcInit* in = NULL;
    CcDecl* d;
    CcStmt* s;
    CcDeclStmt ds;
    if (init) {
        in = cc_arena_alloc(L->arena, sizeof(CcInit), _Alignof(CcInit));
        memset(in, 0, sizeof(*in));
        in->span = sp;
        in->designators = vec_new::[CcDesignator](L->arena);
        in->items = vec_new::[CcInitRef](L->arena);
        in->expr = init;
    }
    d = cc_decl_var(type, name, in, sp, L->arena);
    s = cc__stmt_blank(sp, L->arena);
    ds.d = d;
    s->k = { .decl = ds };
    return s;
}

/* Verbatim C at file scope. */
static CcDecl* lw_raw_decl(CcLowerer* L, CCString text, CcSpan sp) {
    CcDecl* d = cc_arena_alloc(L->arena, sizeof(CcDecl), _Alignof(CcDecl));
    CCSlice t = lw_keep(L, &text);
    memset(d, 0, sizeof(*d));
    d->span = sp;
    d->attrs = vec_new::[CcAttr](L->arena);
    d->k = { .raw = t };
    return d;
}

/* The C spelling of an expression, for `__typeof__(...)` and messages. */
static CCString lw_spell_expr(CcLowerer* L, const CcExpr* e) {
    return CcExpr_spell(e, &L->unit->tape, L->arena);
}

/* ---- name suggestions -------------------------------------------------- */

/* Levenshtein distance, for "did you mean". Names longer than the window
 * are compared by their first 63 bytes: a suggestion, not a proof. */
static int lw_edit_distance(CCSlice a, CCSlice b) {
    int prev[64];
    int cur[64];
    size_t i;
    size_t j;
    size_t na = a.len < 63 ? a.len : 63;
    size_t nb = b.len < 63 ? b.len : 63;
    for (j = 0; j <= nb; j++) prev[j] = (int)j;
    for (i = 1; i <= na; i++) {
        cur[0] = (int)i;
        for (j = 1; j <= nb; j++) {
            int cost = a.ptr[i - 1] == b.ptr[j - 1] ? 0 : 1;
            int d = prev[j - 1] + cost;
            if (prev[j] + 1 < d) d = prev[j] + 1;
            if (cur[j - 1] + 1 < d) d = cur[j - 1] + 1;
            cur[j] = d;
        }
        for (j = 0; j <= nb; j++) prev[j] = cur[j];
    }
    return prev[nb];
}

/* The nearest of `names` to `name`, or empty when none is near enough. */
static CCSlice lw_closest(CcNameList names, CCSlice name) {
    size_t n = names.len();
    size_t i;
    int best = 1 << 30;
    CCSlice pick = cc_slice_empty();
    for (i = 0; i < n; i++) {
        CCSlice cand = *names.get_ptr(i);
        int d = lw_edit_distance(cand, name);
        if (d < best) { best = d; pick = cand; }
    }
    if (best > 3) return cc_slice_empty();
    return pick;
}

/* ---- the pipeline ----------------------------------------------------- */

/* Declarations no longer part of the unit once the steps have read them:
 * the generics step lowers a spliced expansion through the same steps and
 * needs this one before it is defined. */
static void lw_drop_cc_only(CcLowerer* L);

#include "lower_generics.cch"
#include "lower_slices.cch"
#include "lower_strings.cch"
#include "lower_closures.cch"
#include "lower_create.cch"
#include "lower_forin.cch"
#include "lower_chan.cch"
#include "lower_async.cch"
#include "lower_variants.cch"
#include "lower_ufcs.cch"
#include "lower_results.cch"
#include "lower_cleanup.cch"

/* The banner every lowered TU starts with: the generator, and the two
 * headers whose names lowered code spells without asking. */
static void lw_banner(CcLowerer* L) {
    CcDeclList* decls = &L->unit->decls;
    CcDeclList with = vec_new::[CcDeclRef](L->arena);
    size_t n = decls->len();
    size_t i;
    CcSpan sp;
    CcDecl* raw;
    CCString text = @string(`/* generated by Concurrent-C (ccc / cclower) */
#include <stddef.h>
#include <stdint.h>
`, L->arena);
    sp.first = 0;
    sp.last = 0;
    if (n) {
        CcDecl* d0 = *decls->get_ptr(0);
        sp = d0->span;
    }
    raw = lw_raw_decl(L, text, sp);
    with.push(raw);
    for (i = 0; i < n; i++) {
        CcDecl* d = *decls->get_ptr(i);
        with.push(d);
    }
    *decls = with;
}

/* `@typeview(Name)` on a parameter's type names the face the callee may
 * reach through: the index enforces it, and C has nothing to say about
 * it, so it does not survive into the output. */
static void lw_strip_views(CcLowerer* L, CcAttrList* av) {
    size_t n = av->len();
    size_t i;
    bool any = false;
    for (i = 0; i < n; i++) {
        CcAttr* a = av->get_ptr(i);
        if (cc_slice_eq_cstr(&a->name, "typeview")) any = true;
    }
    if (!any) return;
    {
        CcAttrList keep = vec_new::[CcAttr](L->arena);
        for (i = 0; i < n; i++) {
            CcAttr a = *av->get_ptr(i);
            if (cc_slice_eq_cstr(&a.name, "typeview")) continue;
            keep.push(a);
        }
        *av = keep;
    }
}

static void lw_strip_view_params(CcLowerer* L, CcType* t) {
    CcParamList* ps = NULL;
    size_t n;
    size_t i;
    @switch (t->k) {
        case .func: ps = &t->k.func.params; break;
        default: break;
    }
    if (!ps) return;
    n = ps->len();
    for (i = 0; i < n; i++) {
        CcParam* pa = ps->get_ptr(i);
        lw_strip_views(L, &pa->attrs);
    }
}

static bool lw_strip_view_attrs(CcType* t, void* env) {
    CcLowerer* L = (CcLowerer*)env;
    lw_strip_views(L, &t->attrs);
    lw_strip_view_params(L, t);
    return true;
}

/* Declarations the index consumed and C never sees: `@typeview`. */
static void lw_drop_cc_only(CcLowerer* L) {
    CcDeclList* decls = &L->unit->decls;
    CcDeclList with = vec_new::[CcDeclRef](L->arena);
    size_t n = decls->len();
    size_t i;
    CcVisitor v;
    for (i = 0; i < n; i++) {
        CcDecl* d = *decls->get_ptr(i);
        bool drop = false;
        @switch (d->k) {
            case .typeview: drop = true; break;
            case .typehooks: drop = true; break;
            case .factory: drop = true; break;
            default: break;
        }
        if (!drop) with.push(d);
    }
    *decls = with;
    memset(&v, 0, sizeof(v));
    v.type = lw_strip_view_attrs;
    v.env = L;
    CcUnit_walk(L->unit, v);
}

/* `#include "x.cch"` names a local header: the C includes its lowered
 * `<rel/x.h>` (relative to the repository root, under the host's include
 * path), and the header is recorded so the tool lowers it too. Angle
 * includes are the driver's business. */
static void CcLowerer_includes(CcLowerer* L) {
    CcIndex* ix = L->ix;
    CcIncludeRefList refs;
    size_t n;
    size_t i;
    CcDeclList* decls = &L->unit->decls;
    size_t nd = decls->len();
    if (!L->opts.repo_root.len) return;
    refs = cc__scan_includes(ix, &L->unit->tape);
    n = refs.len();
    for (i = 0; i < n; i++) {
        CcIncludeRef* r = refs.get_ptr(i);
        CCString searched = cc_string_new();
        CCSlice found;
        CCSlice rel;
        size_t k;
        if (!r->quoted) continue;
        if (!(r->path.len > 4 && memcmp(r->path.ptr + r->path.len - 4, ".cch", 4) == 0)) continue;
        found = cc__resolve_include(ix, L->unit->tape.path, r, &searched);
        if (!found.len) continue;   /* the index reported it */
        found = cc__canonical_path(ix, found);
        if (found.len > L->opts.repo_root.len && memcmp(found.ptr, L->opts.repo_root.ptr, L->opts.repo_root.len) == 0 &&
            found.ptr[L->opts.repo_root.len] == '/')
            rel = cc_slice_from_buffer((char*)found.ptr + L->opts.repo_root.len + 1, found.len - L->opts.repo_root.len - 1);
        else {
            CcSpan at;
            CCString m = @string(`local header '${r->path}' resolves outside the repository root (${found}); the clean lowerer cannot place its lowered form`, L->arena);
            at.first = r->tok;
            at.last = r->tok;
            lw_error(L, at, m);
            continue;
        }
        for (k = 0; k < nd; k++) {
            CcDecl* d = *decls->get_ptr(k);
            bool hit = false;
            @switch (d->k) {
                case .pp(pd): hit = pd.tok == r->tok; break;
                default: break;
            }
            if (hit) {
                CCSlice stem = cc_slice_from_buffer((char*)rel.ptr, rel.len - 4);
                CCString line = @string(`#include <${stem}.h>
`, L->arena);
                CcDecl* raw = lw_raw_decl(L, line, d->span);
                *decls->get_ptr(k) = raw;
                break;
            }
        }
        {
            Vec::[CCSlice]* hs = &L->headers;
            hs->push(found);
        }
    }
}

static void CcLowerer_lower_unit(CcLowerer* L) {
    CcLowerer_includes(L);
    CcLowerer_async(L);     /* first: an async body is an ordinary body to every step after it */
    CcLowerer_chan(L);      /* first: an endpoint is the runtime handle before anything captures it */
    CcLowerer_closures(L);  /* then: the body becomes a function the later steps walk */
    CcLowerer_create(L);    /* before UFCS: the constructor becomes an ordinary call */
    CcLowerer_forin(L);     /* after create: the walk subject is an ordinary value */
    CcLowerer_slices(L);    /* before generics: it reads `T[:]` as written */
    CcLowerer_generics(L);  /* before UFCS: a local of `Vec::[T]` is typed by its instance name */
    CcLowerer_variants(L);  /* before UFCS and Results: projections are plain members after it */
    CcLowerer_ufcs(L);      /* before Results: an unwrap needs the plain call to type its Result */
    CcLowerer_slice_args(L);/* after UFCS: a method call is a plain call by now */
    CcLowerer_strings(L);   /* after them: a slot spells the C it will be */
    CcLowerer_results(L);
    CcLowerer_cleanup(L);
    lw_drop_cc_only(L);   /* after the steps: the index reads faces off the unit's declarations */
    lw_banner(L);
}

#endif

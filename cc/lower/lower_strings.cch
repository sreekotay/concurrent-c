#pragma(@per_tu)
/* Clean lowerer, step: string templates. `@string(`...`, arena)` builds a
 * CCString by pushing each piece in order, so it is a sequence of
 * statements and is written where statements go: the initializer of a
 * declaration. Anywhere else it is a diagnostic naming the fix, never a
 * partial build. `@string(`...`)` with no arena is the same pieces over a
 * buffer sized on the stack, which is one expression and goes anywhere.
 *
 * The step runs after UFCS and the slice arguments, so a slot expression
 * is already the C it will be: the stack form spells each slot into its
 * size expression, and spelling it earlier would freeze a call the later
 * steps had not rewritten yet.
 *
 * Lifetime: the lowerer arena for the nodes; the stack buffer lives in
 * the enclosing block, so the slice over it dies with that block. */
#ifndef CC_LOWER_STRINGS_CCH
#define CC_LOWER_STRINGS_CCH
#include "lower.cch"
#include "typing.cch"

typedef struct TStep {
    CcLowerer* L;
    Walker* w;
    int n_templates;
    CcExprList failed;          /* arena templates the step could not build; already reported */
    CcExprList emitted;         /* template literals that are an `@emit` argument, not an `@string` */
    bool scratch_used;          /* this function has a template on `@scratch` */
    int scratch_bytes;          /* the largest size any of them asked for */
} TStep;

/* The stack arena a `@scratch` template builds into: one per function,
 * declared at the top so every template in the body shares it. */
static CCSlice sr_scratch_name(void) { return cstr_slice("__cc_str_scratch"); }

/* `@scratch` / `@scratch(N)` as the arena operand. */
static bool sr_is_scratch(CcExpr* e, CcExpr** bytes) {
    if (!e) return false;
    @switch (e->k) {
        case .scratch(sc): *bytes = sc.bytes; return true;
        default: return false;
    }
}

/* The characters a literal run stands for: an escape is one. */
static size_t sr_decoded_len(CCSlice text, bool verbatim) {
    size_t n = 0;
    size_t i = 0;
    if (verbatim) return text.len;
    while (i < text.len) {
        if (text.ptr[i] == '\\' && i + 1 < text.len) {
            char c = text.ptr[i + 1];
            i += 2;
            if (c == 'x') {
                while (i < text.len) {
                    char h = text.ptr[i];
                    bool hex = (h >= '0' && h <= '9') || (h >= 'a' && h <= 'f') || (h >= 'A' && h <= 'F');
                    if (!hex) break;
                    i++;
                }
            }
            else if (c >= '0' && c <= '7') {
                int k = 0;
                while (i < text.len && k < 2 && text.ptr[i] >= '0' && text.ptr[i] <= '7') { i++; k++; }
            }
        } else {
            i++;
        }
        n++;
    }
    return n;
}

/* A slot's spans index the template's own tape, not the unit's: spelling
 * it against the unit would read whatever tokens sit at those offsets
 * there. The slot travels as the text it spells. */
static CcExpr* sr_slot_expr(CcLowerer* L, CcTplPart* part, CcSpan sp) {
    const CcTape* tape = part->tape ? part->tape : &L->unit->tape;
    CCString spelled = CcExpr_spell(part->slot, tape, L->arena);
    CCString wrapped = @string(`(${spelled})`, L->arena);
    return lw_text(L, wrapped, sp);
}

/* An escape C decodes for itself. A template also lets a backslash stand
 * before `$` or a backtick, where it means that byte alone; carrying the
 * backslash into the C literal would leave the host decoding an escape it
 * does not know. */
static bool sr_c_escape(char c) {
    static const char* const known = "abfnrtv\\'\"?xuU01234567";
    size_t i;
    for (i = 0; known[i]; i++)
        if (known[i] == c) return true;
    return false;
}

/* `"<text>"`: the run as a C string literal. A template body is written
 * between backticks, where a newline and a `"` are ordinary characters —
 * in a C literal they are not, so they are escaped here. An escape the
 * user wrote travels through untouched (C decodes it to the one character
 * `sr_decoded_len` already counted); in a verbatim run there are no
 * escapes to preserve, so a backslash is one more character to escape. */
static CcExpr* sr_literal(CcLowerer* L, CCSlice text, bool verbatim, CcSpan sp) {
    CCString q = cc_string_new();
    size_t i = 0;
    q.push_char('"', L->arena);
    while (i < text.len) {
        char c = text.ptr[i];
        if (!verbatim && c == '\\' && i + 1 < text.len) {
            char n = text.ptr[i + 1];
            if (sr_c_escape(n)) {
                q.push_char(c, L->arena);
                q.push_char(n, L->arena);
            } else if (n == '\n') {
                q.push_cstr("\\n", L->arena);
            } else if (n == '\r') {
                q.push_cstr("\\r", L->arena);
            } else {
                q.push_char(n, L->arena);
            }
            i += 2;
            continue;
        }
        if (c == '\n') q.push_cstr("\\n", L->arena);
        else if (c == '\r') q.push_cstr("\\r", L->arena);
        else if (c == '"') q.push_cstr("\\\"", L->arena);
        else if (c == '\\') q.push_cstr("\\\\", L->arena);
        else q.push_char(c, L->arena);
        i++;
    }
    q.push_char('"', L->arena);
    return lw_text(L, q, sp);
}

/* A tagged slot (`$~tag{e}`) names the formatting policy for that one
 * interpolation, and only the policy form carries a policy to name. With
 * none, formatting the value the plain way would read as though the policy
 * had run. */
static bool sr_tag_needs_policy(CcLowerer* L, CcTemplate tp, CcTplPart* part, CcSpan sp) {
    CCString m;
    if (!part->tag.len || tp.policy) return false;
    /* a template cannot spell `$~` -- it would open a tagged slot of its own */
    m = cc_string_new();
    cc_string_push_cstr(&m, "'$~", L->arena);
    cc_string_push_slice(&m, part->tag, L->arena);
    cc_string_push_cstr(&m, "{...}' names a formatting policy and this @string has none: "
                            "write @string(policy, template, arena)", L->arena);
    lw_error(L, sp, m);
    return true;
}

/* The tag a slot carries, as the `CCSlice` the policy is handed. An
 * untagged slot still goes through the policy -- with no tag. */
static CcExpr* sr_tag_expr(CcLowerer* L, CCSlice tag, CcSpan sp) {
    CCString t;
    if (!tag.len) return lw_call0(L, cstr_slice("cc_slice_empty"), sp);
    t = @string(`CC_SLICE_LIT("${tag}")`, L->arena);
    return lw_text(L, t, sp);
}

/* The slot's value as the text a policy formats: the header's bridge over
 * the value's type, which is where a type with no arm is named. */
static CcExpr* sr_slot_arg(CcLowerer* L, CcTplPart* part, CcExpr* arena, CcSpan sp) {
    return lw_call2(L, cstr_slice("cc__string_slot_arg"), sr_slot_expr(L, part, sp), arena, sp);
}

/* `@scratch` / `@scratch(N)` as the arena operand: the function's stack
 * arena, sized to the largest any template in this body asked for. The
 * template's arena operand becomes that name. */
static bool sr_bind_scratch(TStep* st, CcTemplate* tp, CcSpan sp) {
    CcLowerer* L = st->L;
    CcExpr* bytes = NULL;
    int want = 1024;
    if (!sr_is_scratch(tp->arena, &bytes)) return true;
    if (bytes) {
        CCString spelled = lw_spell_expr(L, bytes);
        CCSlice t = cc_string_as_slice(&spelled);
        int v = 0;
        size_t k;
        bool all_digits = t.len > 0;
        for (k = 0; k < t.len; k++) {
            if (t.ptr[k] < '0' || t.ptr[k] > '9') { all_digits = false; break; }
            v = v * 10 + (t.ptr[k] - '0');
        }
        if (!all_digits) {
            CCString m = @string(`'${"@"}scratch(n)' needs a plain byte count here; the clean lowerer sizes the stack arena at compile time`, L->arena);
            lw_error(L, sp, m);
            return false;
        }
        want = v;
    }
    st->scratch_used = true;
    if (want > st->scratch_bytes) st->scratch_bytes = want;
    tp->arena = lw_ident(L, sr_scratch_name(), sp);
    return true;
}

/* `@string(expr, arena)`: the header's `_Generic` bridge over the value's
 * type. There are no pieces to push -- the value is whole and its type
 * picks the conversion -- so it is one expression, and it stands exactly
 * where the template stood rather than becoming a run of statements. */
static CcExpr* sr_direct_expr(TStep* st, CcTemplate tp, CcSpan sp) {
    CcLowerer* L = st->L;
    if (!sr_bind_scratch(st, &tp, sp)) return NULL;
    return lw_call2(L, cstr_slice("cc_string_from"),
                    lw_paren(L, tp.direct, sp), lw_paren(L, tp.arena, sp), sp);
}

/* The arena form, as the statements that build it into `name`. */
static bool sr_arena_stmts(TStep* st, CCSlice name, CcTemplate tp, CcSpan sp, CcStmtList* out) {
    CcLowerer* L = st->L;
    CcTplPartList* parts = &tp.parts;
    size_t n = parts->len();
    size_t i;
    if (!sr_bind_scratch(st, &tp, sp)) return false;
    for (i = 0; i < n; i++) {
        CcTplPart* part = parts->get_ptr(i);
        CcExpr* recv = cc_expr_unary(CC_OP_ADDR, lw_ident(L, name, sp), sp, L->arena);
        if (sr_tag_needs_policy(L, tp, part, sp)) return false;
        if (!part->slot) {
            CCString cnt = @string(`${(int)sr_decoded_len(part->text, part->is_verbatim)}`, L->arena);
            CcExpr* call = lw_call2(L, cstr_slice("cc_string_push_buffer"), recv, sr_literal(L, part->text, part->is_verbatim, sp), sp);
            CcExprList* args = lw_call_args(call);
            args->push(lw_text(L, cnt, sp));
            args->push(tp.arena);
            out->push(lw_expr_stmt(L, call, sp));
        } else if (tp.policy) {
            /* Every slot of a policy template goes through the policy, which
             * decides how that value is spelled; a literal run does not --
             * those bytes are the author's own text, and a verbatim span is
             * a literal run. */
            CcExpr* call = lw_call2(L, cstr_slice("cc_string_push_policy"), recv, tp.policy, sp);
            CcExprList* args = lw_call_args(call);
            args->push(tp.arena);
            args->push(sr_tag_expr(L, part->tag, sp));
            args->push(sr_slot_arg(L, part, tp.arena, sp));
            out->push(lw_expr_stmt(L, call, sp));
        } else {
            CcExpr* call = lw_call2(L, cstr_slice("cc__string_slot_push"), recv, sr_slot_expr(L, part, sp), sp);
            CcExprList* args = lw_call_args(call);
            args->push(tp.arena);
            out->push(lw_expr_stmt(L, call, sp));
        }
    }
    return true;
}

static void sr_error_note(CcLowerer* L, CcSpan span, CCString msg, CCSlice note) {
    CcUnit* u = L->unit;
    CcLoc loc = u->loc(span);
    CcDiag d = CcDiag_error(loc, cc_string_persist_slice(L->arena, &msg));
    CcDiags* ds = L->ds;
    d = CcDiag_with_note(d, note);
    ds->push(d);
}

/* The widths the stack form can size a slot against: the scalar types the
 * header's bound table has an arm for, worst case. A slice, a `CCString`, a
 * pointer or a float has no width known here, and with no arena there is
 * nothing to grow into -- so it is refused at the slot, naming it, rather
 * than left for the host compiler to report as an unmatched association on
 * a generated `_Generic`. */
static bool sr_bounded_width(CCSlice n) {
    static const char* const known[26] = {
        "char", "bool", "_Bool", "signed char", "unsigned char",
        "short", "short int", "unsigned short",
        "int", "unsigned", "unsigned int",
        "long", "long int", "unsigned long",
        "long long", "long long int", "unsigned long long",
        "int8_t", "uint8_t", "int16_t", "uint16_t",
        "int32_t", "uint32_t", "int64_t", "uint64_t", "size_t"
    };
    size_t i;
    for (i = 0; i < 26; i++) {
        CCSlice k = cstr_slice(known[i]);
        if (slice_eq(n, k)) return true;
    }
    return slice_eq(n, cstr_slice("ptrdiff_t"));
}

/* One slot of a stack-form template: does its value have a width the buffer
 * can be sized from? A slot the index cannot type is left to the bound
 * table, which is where the host compiler names it. */
static bool sr_slot_bounded(TStep* st, CcTplPart* part, CcSpan sp) {
    CcLowerer* L = st->L;
    CcType* t = type_of_expr(st->w, part->slot);
    CCSlice canon;
    const CcTape* tape;
    CCString spelled;
    if (!t) return true;
    canon = L->ix->canon(t);
    if (!canon.len || sr_bounded_width(canon)) return true;
    tape = part->tape ? part->tape : &L->unit->tape;
    spelled = CcExpr_spell(part->slot, tape, L->arena);
    {
        /* the message names the slot as it is written, and a template
         * cannot spell `${` -- it would open a slot of its own */
        CCSlice who = lw_keep(L, &spelled);
        CCString m = cc_string_new();
        cc_string_push_cstr(&m, "interpolation '${", L->arena);
        cc_string_push_slice(&m, who, L->arena);
        cc_string_push_cstr(&m, "}' has no statically bounded width: a '", L->arena);
        cc_string_push_slice(&m, canon, L->arena);
        cc_string_push_cstr(&m, "' is formatted at a width this buffer cannot be sized against", L->arena);
        sr_error_note(L, sp, m, cstr_slice("pass an arena, or @scratch"));
    }
    return false;
}

/* The stack form, as one expression: a buffer sized from the literal runs
 * and a bound per slot, then each piece pushed into it. */
static CcExpr* sr_stack_expr(TStep* st, CcTemplate tp, CcSpan sp) {
    CcLowerer* L = st->L;
    CcTplPartList* parts = &tp.parts;
    size_t n = parts->len();
    size_t i;
    CCString size = cc_string_new();
    CcExpr* built;
    if (tp.direct) {
        CCString m = @string(`'${"@"}string(expr)' needs an arena: write '${"@"}string(expr, arena)'`, L->arena);
        lw_error(L, sp, m);
        return NULL;
    }
    if (tp.policy) {
        /* the policy answers with text it allocated, and the bounded form
         * has nothing to allocate from */
        CCString m = @string(`'${"@"}string(policy, ...)' needs an arena: a policy answers with text it allocated`, L->arena);
        lw_error(L, sp, m);
        return NULL;
    }
    size.push_cstr("0u", L->arena);
    for (i = 0; i < n; i++) {
        CcTplPart* part = parts->get_ptr(i);
        if (sr_tag_needs_policy(L, tp, part, sp)) return NULL;
        if (!part->slot) {
            CCString cnt = @string(` + ${(int)sr_decoded_len(part->text, part->is_verbatim)}u`, L->arena);
            size.push_slice(cc_string_as_slice(&cnt), L->arena);
        } else {
            const CcTape* tape = part->tape ? part->tape : &L->unit->tape;
            CCString spelled = CcExpr_spell(part->slot, tape, L->arena);
            if (!sr_slot_bounded(st, part, part->span)) return NULL;
            size.push_cstr(" + cc__string_stack_bound((", L->arena);
            size.push_slice(cc_string_as_slice(&spelled), L->arena);
            size.push_cstr("))", L->arena);
        }
    }
    {
        CCSlice sz = lw_keep(L, &size);
        CCString buf = @string(`(char[${sz}]){0}`, L->arena);
        CCString cap = @string(`${sz}`, L->arena);
        built = lw_call2(L, cstr_slice("cc__string_stack_new"), lw_text(L, buf, sp), lw_text(L, cap, sp), sp);
    }
    for (i = 0; i < n; i++) {
        CcTplPart* part = parts->get_ptr(i);
        if (!part->slot) {
            CCString cnt = @string(`${(int)sr_decoded_len(part->text, part->is_verbatim)}`, L->arena);
            CcExpr* call = lw_call2(L, cstr_slice("cc__string_stack_lit"), built, sr_literal(L, part->text, part->is_verbatim, sp), sp);
            CcExprList* args = lw_call_args(call);
            args->push(lw_text(L, cnt, sp));
            built = call;
        } else {
            built = lw_call2(L, cstr_slice("cc__string_stack_push"), built, sr_slot_expr(L, part, sp), sp);
        }
    }
    return lw_call1(L, cstr_slice("cc__string_stack_slice"), built, sp);
}

/* An `@emit` keeps its argument list as written, so the template literal
 * inside it is still a template node with no arena of its own -- the arena
 * is the emit's next argument. It is the comptime step's text, not a
 * string this step builds, so it is noted where it is seen (an `@emit` is
 * visited before its arguments) and left alone. */
static bool sr_is_emit(CcExpr* e, CcEmit* out) {
    @switch (e->k) {
        case .emit(em): *out = em; return true;
        default: return false;
    }
}

static bool sr_noted_emit(TStep* st, CcExpr* e) {
    CcExprList* v = &st->emitted;
    size_t n = v->len();
    size_t i;
    for (i = 0; i < n; i++) if (*v->get_ptr(i) == e) return true;
    return false;
}

static bool sr_is_template(CcExpr* e, CcTemplate* out) {
    CcExpr* s = e;
    if (!s) return false;
    @switch (s->k) {
        case .template(tp): *out = tp; return true;
        default: return false;
    }
}

/* Every stack-form template in an expression, rewritten in place. */
static bool sr_stack_visit(CcExpr* e, void* env) {
    TStep* st = (TStep*)env;
    CcTemplate tp;
    CcEmit em;
    if (sr_is_emit(e, &em)) {
        CcExprList* av = &em.args;
        size_t n = av->len();
        size_t i;
        for (i = 0; i < n; i++) {
            CcExpr* a = *av->get_ptr(i);
            CcTemplate lit;
            if (a && sr_is_template(a, &lit) && !sr_noted_emit(st, a)) st->emitted.push(a);
        }
        return true;
    }
    if (!sr_is_template(e, &tp)) return true;
    if (sr_noted_emit(st, e)) return true;
    if (tp.arena) return true;                 /* the arena form is a statement sequence */
    {
        CcExpr* built = sr_stack_expr(st, tp, e->span);
        if (!built) return true;
        st->n_templates++;
        e->k = built->k;
    }
    return true;
}

static void sr_stmts(TStep* st, CcStmtList* list);

static void sr_stmt(TStep* st, CcStmt* s) {
    StmtView v;
    if (!s) return;
    view_stmt(&v, s);
    if (v.is_block || (v.has_stmts && v.stmts.len())) {
        CcStmtList inner = v.stmts;
        sr_stmts(st, &inner);
        @switch (s->k) {
            case .block(b): b.stmts = inner; s->k = { .block = b }; break;
            default: break;
        }
    }
    sr_stmt(st, v.body);
    sr_stmt(st, v.else_body);
}

/* `CCString s = @string(`...`, a);` becomes the empty string and the
 * pushes that fill it. */
static void sr_stmts(TStep* st, CcStmtList* list) {
    CcLowerer* L = st->L;
    CcStmtList out = vec_new::[CcStmtRef](L->arena);
    size_t n = list->len();
    size_t i;
    for (i = 0; i < n; i++) {
        CcStmt* s = *list->get_ptr(i);
        CcDecl* d = NULL;
        CcVarDecl v;
        CcTemplate tp;
        bool is_var = false;
        bool done = false;
        if (stmt_is_decl(s, &d) && d) {
            @switch (d->k) {
                case .var(x): v = x; is_var = true; break;
                default: break;
            }
        }
        if (is_var && v.init && v.init->expr && v.name.len && sr_is_template(v.init->expr, &tp) && tp.arena && !tp.direct) {
            CcStmtList pushes = vec_new::[CcStmtRef](L->arena);
            if (sr_arena_stmts(st, v.name, tp, s->span, &pushes)) {
                size_t k;
                CcStmtList* pv = &pushes;
                size_t np = pv->len();
                v.init->expr = lw_call0(L, cstr_slice("cc_string_new"), s->span);
                d->k = { .var = v };
                out.push(s);
                for (k = 0; k < np; k++) {
                    CcStmt* ps = *pv->get_ptr(k);
                    out.push(ps);
                }
                st->n_templates++;
                done = true;
            }
        }
        if (!done) {
            sr_stmt(st, s);
            out.push(s);
        }
    }
    *list = out;
}

/* An arena template anywhere but a declaration initializer: a run of
 * statements where an expression is wanted. It becomes those statements
 * and the string they built, as one expression, so it evaluates where it
 * stands — inside a condition, an argument, a loop body — and not once,
 * earlier, where the code did not ask for it. */
static CcExpr* sr_arena_expr(TStep* st, CcTemplate tp, CcSpan sp) {
    CcLowerer* L = st->L;
    uint32_t id = L->temp_id();
    CCString nm = @string(`__cc_str_${id}`, L->arena);
    CCSlice name = lw_keep(L, &nm);
    CcStmtList pushes = vec_new::[CcStmtRef](L->arena);
    CcStmtList* pv = &pushes;
    CcStmt* blk;
    CcExpr* out;
    CcStmtExpr se;
    size_t i;
    size_t n;
    if (!sr_arena_stmts(st, name, tp, sp, &pushes)) return NULL;
    blk = lw_block(L, sp);
    lw_push(blk, lw_decl_stmt(L, cc_type_named(cstr_slice("CCString"), sp, L->arena), name,
                              lw_call0(L, cstr_slice("cc_string_new"), sp), sp));
    n = pv->len();
    for (i = 0; i < n; i++) lw_push(blk, *pv->get_ptr(i));
    lw_push(blk, lw_expr_stmt(L, lw_ident(L, name, sp), sp));
    out = cc__expr_blank(sp, L->arena);
    se.block = blk;
    out->k = { .stmt_expr = se };
    return out;
}

static void sr_note_failed(TStep* st, CcExpr* e) {
    CcExprList* v = &st->failed;
    v->push(e);
}

static bool sr_was_failed(TStep* st, CcExpr* e) {
    CcExprList* v = &st->failed;
    size_t n = v->len();
    size_t i;
    for (i = 0; i < n; i++)
        if (*v->get_ptr(i) == e) return true;
    return false;
}

static bool sr_arena_expr_visit(CcExpr* e, void* env) {
    TStep* st = (TStep*)env;
    CcTemplate tp;
    CcExpr* built;
    if (!sr_is_template(e, &tp)) return true;
    if (!tp.arena) return true;
    built = tp.direct ? sr_direct_expr(st, tp, e->span) : sr_arena_expr(st, tp, e->span);
    if (!built) { sr_note_failed(st, e); return true; }   /* it said why */
    st->n_templates++;
    e->k = built->k;
    return true;
}

/* An arena template the step never reached: inside a `${"@"}comptime`
 * block or a factory body, which the comptime seam evaluates. Saying so
 * beats printing the template into the C for the host to choke on. */
static bool sr_leftover_visit(CcExpr* e, void* env) {
    TStep* st = (TStep*)env;
    CcLowerer* L = st->L;
    CcTemplate tp;
    if (!sr_is_template(e, &tp)) return true;
    if (!tp.arena) return true;
    if (sr_was_failed(st, e)) return true;
    {
        CCString m = @string(`'${"@"}string(...)' with an arena is not lowered where it stands here`, L->arena);
        lw_error(L, e->span, m);
    }
    return true;
}

/* One function body: its templates, then the stack arena at the top when
 * any of them asked for `@scratch`. */
static void sr_function(TStep* st, CcDecl* d, CcFuncDecl f) {
    CcLowerer* L = st->L;
    CcStmtList* body = f.body ? lw_block_stmts(f.body) : NULL;
    CcStmtList with;
    CCSlice nm = sr_scratch_name();
    int bytes;
    size_t k;
    size_t nb;
    if (!body) return;
    st->scratch_used = false;
    st->scratch_bytes = 0;
    sr_stmts(st, body);
    {
        /* the rest, where a declaration could not hold them */
        CcVisitor ev;
        memset(&ev, 0, sizeof(ev));
        ev.expr = sr_arena_expr_visit;
        ev.env = st;
        CcStmt_walk(f.body, ev);
    }
    if (!st->scratch_used) return;
    with = vec_new::[CcStmtRef](L->arena);
    bytes = st->scratch_bytes;
    {
        /* the name is a slot so the preprocessor does not expand the macro
         * here, in the lowerer's own translation unit */
        CCString decl = @string(`${"cc_arena_stack"}(${nm}, ${bytes})`, L->arena);
        with.push(lw_expr_stmt(L, lw_text(L, decl, d->span), d->span));
    }
    nb = body->len();
    for (k = 0; k < nb; k++) {
        CcStmt* bs = *body->get_ptr(k);
        with.push(bs);
    }
    *body = with;
}

/* The leftover check, over one function body. */
static void sr_leftover_fn(TStep* st, CcFuncDecl f) {
    CcVisitor v;
    if (!f.body) return;
    memset(&v, 0, sizeof(v));
    v.expr = sr_leftover_visit;
    v.env = st;
    CcStmt_walk(f.body, v);
}

static void sr_stack_stmt(Walker* w, CcStmt* s, bool enter) {
    TStep* st = (TStep*)w->env;
    CcVisitor v;
    if (enter) return;
    memset(&v, 0, sizeof(v));
    v.expr = sr_stack_visit;
    v.env = st;
    CcStmt_walk(s, v);
}

static void CcLowerer_strings(CcLowerer* L) {
    Walker w;
    TStep st;
    CcVisitor v;
    CcDeclList* declv;
    size_t n;
    size_t i;
    memset(&st, 0, sizeof(st));
    st.L = L;
    st.w = &w;
    st.failed = vec_new::[CcExprRef](L->arena);
    st.emitted = vec_new::[CcExprRef](L->arena);
    memset(&w, 0, sizeof(w));
    w.arena = L->arena;
    w.ix = L->ix;
    w.unit = L->unit;
    w.env = &st;
    declv = &L->unit->decls;
    n = declv->len();
    for (i = 0; i < n; i++) {
        CcDecl* d = *declv->get_ptr(i);
        @switch (d->k) {
            case .func(f): sr_function(&st, d, f); break;
            default: break;
        }
    }
    /* The stack form is an expression, so it can be anywhere; but sizing a
     * slot asks the index what the slot's value is, and that answer needs
     * the scope the slot stands in. So the sweep is driven by the typing
     * walk, on the way OUT of each statement: an inner statement finishes
     * first, so its templates are built under their own scope, and the
     * outer pass over them is a no-op because each is already the call it
     * lowered to. The plain sweep after it catches what no statement holds
     * -- a file-scope initializer. */
    w.on_stmt = sr_stack_stmt;
    tw_unit(&w);
    memset(&v, 0, sizeof(v));
    v.expr = sr_stack_visit;
    v.env = &st;
    CcUnit_walk(L->unit, v);
    for (i = 0; i < n; i++) {
        CcDecl* d = *declv->get_ptr(i);
        @switch (d->k) {
            case .func(f): sr_leftover_fn(&st, f); break;
            default: break;
        }
    }
}

#endif

/* cclower: drives the printer over real files, in Concurrent-C.
 *
 *   cclower --identity [--known-types F] FILE...
 *       Lex, parse and print in identity mode; compare with the input.
 *       Prints `ok FILE` or `MISMATCH FILE at byte N (line L)` plus the
 *       diagnostics; exits non-zero on any mismatch, uncovered token or
 *       parse error.
 *   cclower --print [--known-types F] [--no-line] [--header] [-o OUT] FILE
 *       Lowered-mode print with `#line` to OUT (or stdout) and the source
 *       map beside it as OUT.map (`emit_line path line col_delta` per
 *       line). The printed text is checked against the map: every emitted
 *       line has an entry, and the host compiler's attribution (from the
 *       `#line` directives) agrees with it.
 *   cclower --is-plain-c [--known-types F] FILE
 *       Exit 0 when the tree has no Concurrent-C node kinds.
 *
 * The parse mode follows the extension: .cch is header mode, .shcc script
 * mode, everything else source mode. Output is byte-identical to
 * out/cc/bin/cclower (the C11 reference). */
#include "lex_impl.cch"
#include "diag_impl.cch"
#include "ast_impl.cch"
#include "parse_state.cch"
#include "parse_fwd.cch"
#include "parse_exprs.cch"
#include "parse_stmts.cch"
#include "parse_types.cch"
#include "parse_decls.cch"
#include "parse_walk.cch"
#include "print_impl.cch"
#include "lower_impl.cch"
#include <errno.h>
#include <sys/stat.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

typedef Vec::[CCSlice] CcNameList;

/* ---- files ------------------------------------------------------------ */

static CCSlice read_whole_file(const char* path, CCArena a, bool* ok) {
    FILE* fp = fopen(path, "rb");
    long n;
    char* buf;
    *ok = false;
    if (!fp) return CC_SLICE_LIT("");
    fseek(fp, 0, SEEK_END);
    n = ftell(fp);
    fseek(fp, 0, SEEK_SET);
    if (n < 0) n = 0;
    buf = cc_arena_alloc(a, (size_t)n + 1, 1);
    if (n > 0 && fread(buf, 1, (size_t)n, fp) != (size_t)n) { fclose(fp); return CC_SLICE_LIT(""); }
    buf[n] = 0;
    fclose(fp);
    *ok = true;
    return cc_slice_from_buffer(buf, (size_t)n);
}

static CCSlice source_of(CCSlice path, void* ctx) {
    (void)path;
    return *(CCSlice*)ctx;
}

/* Known type names: whitespace-separated, `#`-prefixed words ignored. */
static void read_known_types(const char* path, CcNameList* known, CCArena a) {
    bool ok;
    CCSlice text = read_whole_file(path, a, &ok);
    size_t i = 0;
    if (!ok) { fprintf(stderr, "cclower: cannot read %s: %s\n", path, strerror(errno)); exit(2); }
    while (i < text.len) {
        size_t j;
        while (i < text.len && (text.ptr[i] == ' ' || text.ptr[i] == '\t' || text.ptr[i] == '\r' || text.ptr[i] == '\n')) i++;
        if (i >= text.len) break;
        j = i;
        while (j < text.len && !(text.ptr[j] == ' ' || text.ptr[j] == '\t' || text.ptr[j] == '\r' || text.ptr[j] == '\n')) j++;
        if (text.ptr[i] != '#') known->push(cc_slice_from_buffer((char*)text.ptr + i, j - i));
        i = j;
    }
}

static CcUnitMode mode_for(const char* path) {
    size_t n = strlen(path);
    if (n >= 4 && strcmp(path + n - 4, ".cch") == 0) return CC_UNIT_HEADER;
    if (n >= 5 && strcmp(path + n - 5, ".shcc") == 0) return CC_UNIT_SCRIPT;
    return CC_UNIT_SOURCE;
}

typedef struct Loaded {
    CCArena arena;
    CcDiags ds;
    CcUnit* unit;
    CCSlice src;
    const char* path;
    CcLowerer lw;               /* --lower: the lowerer, for the headers it recorded */
    bool lowered;
} Loaded;

/* --root DIR: the repository root quoted `.cch` includes are made relative to;
 * --h-root DIR: where their lowered `.h` files go (`DIR/<rel>.h`). */
static CCSlice g_root;
static const char* g_h_root;

/* mkdir -p for the directory part of `path`. */
static bool mkdir_parents(const char* path) {
    char buf[4096];
    size_t n = strlen(path);
    size_t i;
    if (n >= sizeof(buf)) return false;
    memcpy(buf, path, n + 1);
    for (i = 1; i < n; i++) {
        if (buf[i] != '/') continue;
        buf[i] = 0;
        if (mkdir(buf, 0777) != 0 && errno != EEXIST) return false;
        buf[i] = '/';
    }
    return true;
}

static bool load(Loaded* L, const char* path, CcNameList known, CCArena a) {
    CcParseOpts opts;
    bool ok;
    L->arena = a;
    L->ds = CcDiags_new(a);
    L->path = path;
    L->src = read_whole_file(path, a, &ok);
    if (!ok) {
        fprintf(stderr, "cclower: cannot read %s: %s\n", path, strerror(errno));
        return false;
    }
    opts.mode = mode_for(path);
    opts.known_types = known;
    L->unit = cc_parse_unit(cc_slice_from_buffer((char*)path, strlen(path)), L->src, opts, &L->ds, a);
    return true;
}

static void print_diags(Loaded* L) {
    CcDiags* ds = &L->ds;
    Vec::[CcDiag]* items = &ds->items;
    if (items->len()) ds->print(stderr, source_of, &L->src);
}

/* Byte offset of physical (line, col) in `src`. */
static size_t byte_of(CCSlice src, uint32_t line, uint32_t col) {
    size_t i = 0;
    uint32_t ln = 1;
    while (ln < line && i < src.len) {
        if (src.ptr[i] == '\n') ln++;
        i++;
    }
    if (col) i += col - 1;
    if (i > src.len) i = src.len;
    return i;
}

/* ---- --identity ---------------------------------------------------------- */

static int run_identity(const char* path, CcNameList known) {
    CCArena a = cc_arena_heap(megabytes(256)) @destroy;
    Loaded L;
    CcPrintOpts po;
    int rc = 0;
    uint32_t n_parse_errors;
    if (!load(&L, path, known, a)) return 1;
    n_parse_errors = L.ds.n_errors;
    po.identity = true;
    po.line_directives = false;
    po.path = cc_slice_empty();
    po.header_mode = false;
    CcProduct prod = cc_print_unit(L.unit, NULL, po, &L.ds, a) !>(e) {
        uint32_t pline = e.phys_line ? e.phys_line : e.at.line;
        size_t at = byte_of(L.src, pline, e.at.col);
        printf("MISMATCH %s at byte %zu (line %u)\n", path, at, (unsigned)pline);
        print_diags(&L);
        return 1;
    };
    (void)prod;
    if (L.ds.n_errors) {
        printf("%s %s (%u parse error(s), %u printer error(s))\n",
               n_parse_errors ? "PARSE-ERROR" : "UNCOVERED", path, (unsigned)n_parse_errors,
               (unsigned)(L.ds.n_errors - n_parse_errors));
        rc = 1;
    } else {
        printf("ok %s\n", path);
    }
    print_diags(&L);
    return rc;
}

/* ---- --is-plain-c -------------------------------------------------------- */

typedef struct Plain {
    CCSlice first_what;
    uint32_t first_tok;
} Plain;

static void plain_note(Plain* pl, CCSlice what, uint32_t tok) {
    if (pl->first_what.len) return;
    pl->first_what = what;
    pl->first_tok = tok;
}

/* A statement at file scope (.shcc) is a Concurrent-C form here, though
 * the printer prints it as C. */
static bool decl_is_top_stmt(const CcDecl* d) {
    return d->k.kind == CcDeclK_stmt;
}

static bool plain_decl(CcDecl* d, void* env) {
    if (decl_is_cc(d) || decl_is_top_stmt(d)) plain_note((Plain*)env, CcDecl_kind_name(d), d->span.first);
    return true;
}
static bool plain_stmt(CcStmt* s, void* env) {
    if (stmt_is_cc(s)) plain_note((Plain*)env, CcStmt_kind_name(s), s->span.first);
    return true;
}
static bool plain_expr(CcExpr* e, void* env) {
    if (expr_is_cc(e)) plain_note((Plain*)env, CcExpr_kind_name(e), e->span.first);
    return true;
}

/* A function type's parameters (a view of the list header), else empty. */
static CcParamList type_func_params(CcType* t) {
    CcParamList empty;
    memset(&empty, 0, sizeof(empty));
    @switch (t->k) {
        case .func(fn): return fn.params;
        default: return empty;
    }
}

static bool plain_type(CcType* t, void* env) {
    Plain* pl = (Plain*)env;
    CcParamList params;
    size_t n;
    size_t i;
    if (type_is_cc(t)) plain_note(pl, CcType_kind_name(t), t->span.first);
    params = type_func_params(t);
    n = params.len();
    for (i = 0; i < n; i++) {
        const CcParam* pa = params.get_ptr(i);
        if (pa->default_value) plain_note(pl, CC_SLICE_LIT("parameter default"), pa->span.first);
    }
    return true;
}

static int run_is_plain_c(const char* path, CcNameList known) {
    CCArena a = cc_arena_heap(megabytes(256)) @destroy;
    Loaded L;
    Plain pl;
    CcVisitor v;
    int rc;
    if (!load(&L, path, known, a)) return 2;
    pl.first_what = cc_slice_empty();
    pl.first_tok = 0;
    v.type = plain_type;
    v.expr = plain_expr;
    v.stmt = plain_stmt;
    v.decl = plain_decl;
    v.env = &pl;
    CcUnit_walk(L.unit, v);
    if (L.unit->has_shebang) plain_note(&pl, CC_SLICE_LIT("#!ccc"), 0);
    if (L.ds.n_errors) {
        printf("parse-error %s\n", path);
        print_diags(&L);
        rc = 2;
    } else if (pl.first_what.len) {
        const CcTape* tape = &L.unit->tape;
        CcLoc loc = tape->loc(pl.first_tok);
        printf("cc %s (%.*s at line %u)\n", path, (int)pl.first_what.len, pl.first_what.ptr, (unsigned)loc.line);
        rc = 1;
    } else {
        printf("plain %s\n", path);
        rc = 0;
    }
    return rc;
}

/* ---- --print --------------------------------------------------------------- */

/* Parse `#line N "path"` / `# N "path"` at the start of a line. Returns
 * true and fills line/path (path is an arena copy, or empty when absent). */
static bool parse_line_directive(const char* s, size_t n, unsigned* line, CCSlice* path, bool* has_path, CCArena a) {
    size_t i = 0, j;
    unsigned v = 0;
    while (i < n && (s[i] == ' ' || s[i] == '\t')) i++;
    if (i >= n || s[i] != '#') return false;
    i++;
    while (i < n && (s[i] == ' ' || s[i] == '\t')) i++;
    if (i + 4 <= n && memcmp(s + i, "line", 4) == 0) {
        i += 4;
        if (i >= n || !(s[i] == ' ' || s[i] == '\t')) return false;
        while (i < n && (s[i] == ' ' || s[i] == '\t')) i++;
    }
    if (i >= n || s[i] < '0' || s[i] > '9') return false;
    while (i < n && s[i] >= '0' && s[i] <= '9') { v = v * 10 + (unsigned)(s[i] - '0'); i++; }
    while (i < n && (s[i] == ' ' || s[i] == '\t')) i++;
    *line = v;
    *has_path = false;
    if (i < n && s[i] == '"') {
        char* buf = cc_arena_alloc(a, n + 1, 1);
        size_t k = 0;
        for (j = i + 1; j < n && s[j] != '"'; j++) {
            if (s[j] == '\\' && j + 1 < n) j++;
            buf[k++] = s[j];
        }
        buf[k] = 0;
        *path = cc_slice_from_buffer(buf, k);
        *has_path = true;
    }
    return true;
}

/* Check the printed text against its map: one entry per line and, when
 * directives are on, the host's attribution equals the map's. Returns the
 * number of problems. */
static int verify_map(CCSlice text, CcSrcMap* map, bool directives, FILE* err, CCArena a) {
    Vec::[CcSrcMapEntry]* ents = &map->entries;
    size_t n_ents = ents->len();
    size_t i = 0, lineno = 1, n_lines = 0;
    int problems = 0;
    CCSlice host_path = cc_slice_empty();
    bool host_has_path = false;
    unsigned host_line = 0;
    const char* s = text.ptr;
    size_t len = text.len;
    while (i < len) {
        size_t j = i;
        const CcSrcMapEntry* e;
        unsigned dl;
        CCSlice dp;
        bool has_dp;
        while (j < len && s[j] != '\n') j++;
        n_lines++;
        if (lineno > n_ents || ents->get_ptr(lineno - 1)->emit_line != lineno) {
            fprintf(err, "map: emitted line %zu has no source map entry\n", lineno);
            problems++;
            e = NULL;
        } else {
            e = ents->get_ptr(lineno - 1);
        }
        if (parse_line_directive(s + i, j - i, &dl, &dp, &has_dp, a)) {
            host_line = dl;
            if (has_dp) { host_path = dp; host_has_path = true; }
        } else {
            if (directives && host_line && e) {
                CCSlice ep = e->path;
                if (host_line != e->line || !host_has_path || !cc_slice_eq(&host_path, ep)) {
                    fprintf(err, "map: emitted line %zu is attributed to %.*s:%u by the host but to %.*s:%u by the map\n",
                            lineno, host_has_path ? (int)host_path.len : 1, host_has_path ? host_path.ptr : "?",
                            host_line, ep.len ? (int)ep.len : 1, ep.len ? ep.ptr : "?", (unsigned)e->line);
                    problems++;
                }
            }
            if (host_line) host_line++;
        }
        lineno++;
        i = j < len ? j + 1 : j;
    }
    if (n_ents != n_lines) {
        fprintf(err, "map: %u entries for %zu emitted lines\n", (unsigned)n_ents, n_lines);
        problems++;
    }
    return problems;
}

static bool write_product(const char* out_path, CCSlice text, CcSrcMap* map, CCArena a) {
    FILE* fp = fopen(out_path, "wb");
    Vec::[CcSrcMapEntry]* ents = &map->entries;
    size_t n = ents->len();
    size_t k;
    bool ok = true;
    const char* map_path;
    if (!fp) {
        fprintf(stderr, "cclower: cannot write %s: %s\n", out_path, strerror(errno));
        ok = false;
    } else {
        fwrite(text.ptr, 1, text.len, fp);
        fclose(fp);
    }
    {
        CCString mp = @string(`${out_path}.map`, a);
        map_path = mp.cstr(a);
    }
    fp = fopen(map_path, "wb");
    if (!fp) {
        fprintf(stderr, "cclower: cannot write %s: %s\n", map_path, strerror(errno));
        return false;
    }
    for (k = 0; k < n; k++) {
        const CcSrcMapEntry* e = ents->get_ptr(k);
        fprintf(fp, "%u ", (unsigned)e->emit_line);
        if (e->path.len) fwrite(e->path.ptr, 1, e->path.len, fp);
        else fputs("?", fp);
        fprintf(fp, " %u %d\n", (unsigned)e->line, (int)e->col_delta);
    }
    fclose(fp);
    return ok;
}

/* --lower: parse with the index's typedef names, lower, print. */
/* `-I DIR` search path for the index (default: cc/include); lifetime: the tool arena */
static CcNameList g_include_dirs;

static bool load_lowered(Loaded* L, const char* path, CcNameList known, CCArena a) {
    CcParseOpts opts;
    bool ok;
    CcIndex* ix;
    CcLowerOpts lo;
    CcLowerer lw;
    CCSlice pathsl = cc_slice_from_buffer((char*)path, strlen(path));
    L->arena = a;
    L->ds = CcDiags_new(a);
    L->path = path;
    L->src = read_whole_file(path, a, &ok);
    if (!ok) {
        fprintf(stderr, "cclower: cannot read %s: %s\n", path, strerror(errno));
        return false;
    }
    {
        /* quoted includes resolve against the unit's own directory */
        size_t slash = pathsl.len;
        CCSlice qdir = cc_slice_empty();
        while (slash > 0 && pathsl.ptr[slash - 1] != '/') slash--;
        if (slash) qdir = cc_slice_from_buffer((char*)pathsl.ptr, slash - 1);
        ix = cc_index_new(g_include_dirs, qdir, &L->ds, a);
    }
    opts.mode = mode_for(path);
    opts.known_types = known;
    {
        CcDiags scratch = CcDiags_new(a);
        CcTape tape = cc_lex(pathsl, L->src, &scratch, a);
        ix->preload_includes(&tape, opts);
    }
    {
        CcNameList all = vec_new::[CCSlice](a);
        CcNameList from_ix = ix->known_types();
        size_t i;
        size_t n = known.len();
        size_t m = from_ix.len();
        for (i = 0; i < n; i++) {
            CCSlice nm = *known.get_ptr(i);
            all.push(nm);
        }
        for (i = 0; i < m; i++) {
            CCSlice nm = *from_ix.get_ptr(i);
            all.push(nm);
        }
        opts.known_types = all;
    }
    L->unit = cc_parse_unit(pathsl, L->src, opts, &L->ds, a);
    ix->add_unit(L->unit, opts.mode == CC_UNIT_HEADER);
    if (L->ds.has_errors()) return true;   /* parse errors: print nothing but the diagnostics */
    lo.line_directives = true;
    lo.parallel_off = false;
    lo.per_tu = false;
    {
        const char* strict = getenv("CC_STRICT_RESULT_UNWRAP");
        lo.strict_unhandled = !(strict && strcmp(strict, "0") == 0);
    }
    lo.repo_root = g_root;
    lw = cc_lowerer_new(L->unit, ix, lo, &L->ds);
    lw.lower_unit();
    L->lw = lw;
    L->lowered = true;
    return true;
}

/* Copies of the headers the lowering recorded, in the caller's arena. */
static void note_headers(Loaded* L, CcNameList* more, CCArena keep) {
    Vec::[CCSlice]* hs = &L->lw.headers;
    size_t n = hs->len();
    size_t i;
    if (!L->lowered || !more) return;
    for (i = 0; i < n; i++) {
        CCSlice h = *hs->get_ptr(i);
        char* copy = cc_arena_alloc(keep, h.len + 1, 1);
        CCSlice kept;
        memcpy(copy, h.ptr, h.len);
        copy[h.len] = 0;
        kept = cc_slice_from_buffer(copy, h.len);
        more->push(kept);
    }
}

static int run_print(const char* path, CcNameList known, const char* out_path, bool line_directives,
                     bool header_mode, bool lower, CcNameList* more_headers, CCArena keep) {
    CCArena a = cc_arena_heap(megabytes(256)) @destroy;
    Loaded L;
    CcPrintOpts po;
    int rc = 0;
    int problems;
    uint32_t n_parse_errors;
    CCSlice text;
    memset(&L, 0, sizeof(L));
    if (lower) { if (!load_lowered(&L, path, known, a)) return 2; }
    else if (!load(&L, path, known, a)) return 2;
    if (lower && L.ds.has_errors()) { print_diags(&L); return 1; }
    note_headers(&L, more_headers, keep);
    n_parse_errors = L.ds.n_errors;
    po.identity = false;
    po.line_directives = line_directives;
    po.header_mode = header_mode;
    po.path = cc_slice_from_buffer((char*)path, strlen(path));
    CcProduct prod = cc_print_unit(L.unit, NULL, po, &L.ds, a) !>(e) {
        fprintf(stderr, "cclower: %s: %.*s\n", path, (int)e.msg.len, e.msg.ptr);
        return 2;
    };
    text = cc_string_as_slice(&prod.text);
    if (out_path) {
        if (!write_product(out_path, text, &prod.map, a)) rc = 2;
    } else {
        fwrite(text.ptr, 1, text.len, stdout);
    }
    problems = verify_map(text, &prod.map, line_directives, stderr, a);
    print_diags(&L);
    if (L.ds.n_errors) {
        fprintf(stderr, "cclower: %s: %u parse error(s), %u printer error(s)\n", path,
                (unsigned)n_parse_errors, (unsigned)(L.ds.n_errors - n_parse_errors));
        rc = 1;
    }
    if (problems) {
        fprintf(stderr, "cclower: %s: %d source map problem(s)\n", path, problems);
        rc = 1;
    }
    return rc;
}

/* ---- main ---------------------------------------------------------------------- */

static void usage(void) {
    fprintf(stderr,
            "usage: cclower --identity [--known-types F] FILE...\n"
            "       cclower --print [--known-types F] [--no-line] [--header] [-o OUT] FILE\n"
            "       cclower --lower [--known-types F] [-I DIR]... [--root DIR --h-root DIR] [-o OUT] FILE\n"
            "       cclower --is-plain-c [--known-types F] FILE\n");
    exit(2);
}

enum { M_NONE, M_IDENTITY, M_PRINT, M_PLAIN };

int main(int argc, char** argv) {
    CCArena tool = cc_arena_heap(megabytes(8)) @destroy;
    CcNameList known = vec_new::[CCSlice](tool);
    int mode = M_NONE;
    const char* known_path = NULL;
    const char* out_path = NULL;
    bool line_directives = true;
    bool header_mode = false;
    bool lower = false;
    int i;
    int rc = 0;
    int n_files = 0;
    CcNameList todo = vec_new::[CCSlice](tool);
    bool custom_dirs = false;
    g_include_dirs = vec_new::[CCSlice](tool);
    g_include_dirs.push(CC_SLICE_LIT("cc/include"));
    for (i = 1; i < argc; i++) {
        if (strcmp(argv[i], "-I") == 0 && i + 1 < argc) {
            CCSlice dir = cc_slice_from_buffer(argv[i + 1], strlen(argv[i + 1]));
            if (!custom_dirs) { g_include_dirs.clear(); custom_dirs = true; }
            g_include_dirs.push(dir);
            i++;
            continue;
        }
        if (strcmp(argv[i], "--root") == 0 && i + 1 < argc) { g_root = cc_slice_from_buffer(argv[i + 1], strlen(argv[i + 1])); i++; continue; }
        if (strcmp(argv[i], "--h-root") == 0 && i + 1 < argc) { g_h_root = argv[i + 1]; i++; continue; }
        if (strcmp(argv[i], "--identity") == 0) mode = M_IDENTITY;
        else if (strcmp(argv[i], "--print") == 0) mode = M_PRINT;
        else if (strcmp(argv[i], "--lower") == 0) { mode = M_PRINT; lower = true; }
        else if (strcmp(argv[i], "--is-plain-c") == 0) mode = M_PLAIN;
        else if (strcmp(argv[i], "--known-types") == 0 && i + 1 < argc) known_path = argv[++i];
        else if (strcmp(argv[i], "-o") == 0 && i + 1 < argc) out_path = argv[++i];
        else if (strcmp(argv[i], "--no-line") == 0) line_directives = false;
        else if (strcmp(argv[i], "--header") == 0) header_mode = true;
        else if (argv[i][0] == '-' && argv[i][1]) usage();
    }
    if (mode == M_NONE) usage();
    if (known_path) read_known_types(known_path, &known, tool);
    for (i = 1; i < argc; i++) {
        if (strcmp(argv[i], "--known-types") == 0 || strcmp(argv[i], "-o") == 0 || strcmp(argv[i], "-I") == 0 ||
            strcmp(argv[i], "--root") == 0 || strcmp(argv[i], "--h-root") == 0) { i++; continue; }
        if (argv[i][0] == '-' && argv[i][1]) continue;
        n_files++;
        switch (mode) {
        case M_IDENTITY: rc |= run_identity(argv[i], known); break;
        case M_PRINT: rc |= run_print(argv[i], known, out_path, line_directives, header_mode, lower, &todo, tool); break;
        case M_PLAIN: rc |= run_is_plain_c(argv[i], known); break;
        default: break;
        }
        fflush(stdout);
    }
    if (!n_files) usage();
    /* the local headers the lowered units include, each lowered once in
     * header mode to <h-root>/<rel>.h; headers they include join the list */
    if (lower && g_h_root && g_root.len) {
        CcNameList seen = vec_new::[CCSlice](tool);
        for (;;) {
            size_t nt = todo.len();
            CCSlice h;
            size_t k;
            size_t ns = seen.len();
            bool dup = false;
            CCSlice rel;
            CCString out;
            if (!nt) break;
            h = *todo.get_ptr(nt - 1);
            todo.truncate(nt - 1);
            for (k = 0; k < ns; k++) {
                CCSlice sk = *seen.get_ptr(k);
                if (cc_slice_eq(&sk, h)) dup = true;
            }
            if (dup) continue;
            seen.push(h);
            if (!(h.len > g_root.len && memcmp(h.ptr, g_root.ptr, g_root.len) == 0 && h.ptr[g_root.len] == '/')) continue;
            rel = cc_slice_from_buffer((char*)h.ptr + g_root.len + 1, h.len - g_root.len - 1 - 4);
            out = @string(`${g_h_root}/${rel}.h`, tool);
            {
                const char* out_c = cc_string_cstr(&out, tool);
                const char* h_c = (const char*)h.ptr;   /* NUL-terminated by note_headers */
                if (!mkdir_parents(out_c)) { fprintf(stderr, "cclower: cannot create the directory of %s\n", out_c); rc |= 2; continue; }
                rc |= run_print(h_c, known, out_c, line_directives, true, true, &todo, tool);
            }
        }
    }
    return rc;
}

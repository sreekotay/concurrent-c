#pragma(@per_tu)
/* Parser state shared by every section of the parser: the token cursor,
 * keywords, the typedef-name scope stack, diagnostics, recovery,
 * preprocessor lines and attributes. Sections 2 to 5 (types,
 * expressions, statements, declarations) are static functions in their
 * own files, included after this one into the parser unit.
 *
 * Lifetimes: everything a parser allocates lives in the unit's arena
 * (`P.arena`); the parser struct itself is a local of cc_parse_unit. A
 * template-slot sub-parser shares the scope stack of its parent. */
#ifndef CC_LOWER_PARSE_STATE_CCH
#define CC_LOWER_PARSE_STATE_CCH
#include "parse.cch"
#include "ast_impl.cch"
#include <ccc/std/map.cch>
#include <string.h>

/* ---- keywords ---------------------------------------------------------- */

typedef enum Kw {
    KW_NONE = 0,
    KW_AUTO, KW_BREAK, KW_CASE, KW_CHAR, KW_CONST, KW_CONTINUE, KW_DEFAULT, KW_DO, KW_DOUBLE,
    KW_ELSE, KW_ENUM, KW_EXTERN, KW_FLOAT, KW_FOR, KW_GOTO, KW_IF, KW_INLINE, KW_INT, KW_LONG,
    KW_REGISTER, KW_RESTRICT, KW_RETURN, KW_SHORT, KW_SIGNED, KW_SIZEOF, KW_STATIC, KW_STRUCT,
    KW_SWITCH, KW_TYPEDEF, KW_UNION, KW_UNSIGNED, KW_VOID, KW_VOLATILE, KW_WHILE,
    KW_ALIGNAS, KW_ALIGNOF, KW_ATOMIC, KW_BOOL, KW_COMPLEX, KW_GENERIC, KW_NORETURN,
    KW_STATIC_ASSERT, KW_THREAD_LOCAL,
    /* GNU / MSVC spellings */
    KW_ATTRIBUTE, KW_ATTRIBUTE2, KW_EXTENSION, KW_INLINE2, KW_INLINE3, KW_RESTRICT2, KW_RESTRICT3,
    KW_CONST2, KW_CONST3, KW_VOLATILE2, KW_VOLATILE3, KW_SIGNED2, KW_SIGNED3, KW_TYPEOF, KW_TYPEOF2,
    KW_TYPEOF3, KW_ALIGNOF2, KW_ALIGNOF3, KW_ASM, KW_ASM2, KW_ASM3, KW_THREAD, KW_INT128,
    KW_DECLSPEC, KW_BUILTIN_VA_LIST, KW_FORCEINLINE, KW_FLOAT128, KW_NULLPTR_T, KW_ALIGNAS2, KW_ALIGNOF4,
    /* Concurrent-C bare words (contextual: ordinary names elsewhere) */
    KW_IN, KW_UNSAFE, KW_SPAWN, KW_SEQ, KW_WAIT, KW_CACHE, KW_WORKER, KW_ON, KW_AS, KW_ASYNC,
    KW_CLOSING, KW_TYPE, KW_CC_GENERIC_FACTORY, KW_CC_GENERIC_FACTORY_EXTEND,
    KW_COUNT
} Kw;

static const char* const cc__kw_text[KW_COUNT] = {
    "",
    "auto", "break", "case", "char", "const", "continue", "default", "do", "double",
    "else", "enum", "extern", "float", "for", "goto", "if", "inline", "int", "long",
    "register", "restrict", "return", "short", "signed", "sizeof", "static", "struct",
    "switch", "typedef", "union", "unsigned", "void", "volatile", "while",
    "_Alignas", "_Alignof", "_Atomic", "_Bool", "_Complex", "_Generic", "_Noreturn",
    "_Static_assert", "_Thread_local",
    "__attribute__", "__attribute", "__extension__", "__inline", "__inline__", "__restrict", "__restrict__",
    "__const", "__const__", "__volatile", "__volatile__", "__signed", "__signed__", "__typeof__", "__typeof",
    "typeof", "__alignof__", "__alignof", "__asm__", "__asm", "asm", "__thread", "__int128",
    "__declspec", "__builtin_va_list", "__forceinline", "__float128", "nullptr_t", "alignas", "alignof",
    "in", "unsafe", "spawn", "seq", "wait", "cache", "worker", "on", "as", "async",
    "closing", "type", "CC_GENERIC_FACTORY", "CC_GENERIC_FACTORY_EXTEND",
};

/* ---- scope stack -------------------------------------------------------- */

/* One binding: a name is a type or a variable at some depth; `shadowed`
 * is the binding it hides. */
typedef struct PSym PSym;
typedef PSym* PSymRef;
struct PSym {
    CCSlice name;
    bool is_type;
    int depth;
    PSym* shadowed;
};

typedef struct PFrame PFrame;
typedef PFrame* PFrameRef;
struct PFrame {
    PFrame* outer;
    Vec::[PSymRef] syms;
    int depth;
};

/* Shared between a parser and the sub-parsers it spawns for template slots. */
typedef struct PSyms {
    CCArena arena;
    Map::[CCSlice, PSymRef] top;    /* name -> innermost binding */
    PFrame* frame;
    int depth;
} PSyms;

/* `#if` nesting seen through preprocessor lines, for skipping regions that
 * are statically inactive (`__cplusplus`, `#if 0`). */
typedef struct PpCond {
    bool else_dead;     /* the branch after #else / #elif is inactive */
    bool taken;         /* some branch was already active */
} PpCond;

typedef struct P {
    CCArena arena;
    CcDiags* ds;
    CcUnit* u;
    CcTape* tape;
    CcToken* t;             /* the tape's tokens */
    uint32_t n;             /* token count, the last is EOF */
    uint32_t i;             /* cursor */
    CcParseOpts opts;
    PSyms* syms;
    Map::[CCSlice, int] kw;     /* keyword text -> Kw, KW_IN and after excluded */
    /* index of a `;` or `}` that already terminated the statement being
     * parsed (an unwrap body or closure block consumed it); expect_semi
     * accepts it in place of a `;` */
    uint32_t consumed_terminator;
    bool tpl_ok;            /* a bare template literal is allowed as an operand (inside @emit args) */
    Vec::[PpCond] pp;       /* the #if stack */
    CcStmt* bind_stmt;      /* statement-position parse of @parallel as a declaration initializer */
    bool in_slot;           /* parsing a template slot */
} P;

/* ---- names --------------------------------------------------------------- */

static CCSlice tok_name(P* p, uint32_t i) {
    return p->t[i < p->n ? i : p->n - 1].text;
}

static Kw kw_of(P* p, uint32_t i) {
    CCSlice nm;
    int* k;
    if (p->t[i].kind != CC_TK_IDENT) return KW_NONE;
    nm = p->t[i].text;
    k = p->kw->get_ptr(nm);
    return k ? (Kw)*k : KW_NONE;
}

static bool is_kw(P* p, uint32_t i, Kw k) {
    CCSlice nm;
    if (p->t[i].kind != CC_TK_IDENT) return false;
    nm = p->t[i].text;
    return cc_slice_eq_cstr(&nm, cc__kw_text[k]);
}

static bool name_is_all_caps(CCSlice nm) {
    size_t q;
    bool letters = false;
    for (q = 0; q < nm.len; q++) {
        char c = nm.ptr[q];
        if (c >= 'a' && c <= 'z') return false;
        if (c >= 'A' && c <= 'Z') letters = true;
    }
    return letters;
}

/* ---- scope stack -------------------------------------------------------- */

static PSyms* syms_new(CCArena a) {
    PSyms* s = cc_arena_alloc(a, sizeof(PSyms), _Alignof(PSyms));
    PFrame* fr = cc_arena_alloc(a, sizeof(PFrame), _Alignof(PFrame));
    s->arena = a;
    s->top = map_new::[CCSlice, PSymRef](a);
    fr->outer = NULL;
    fr->syms = vec_new::[PSymRef](a);
    fr->depth = 0;
    s->frame = fr;
    s->depth = 0;
    return s;
}

static PSym* sym_lookup(PSyms* s, CCSlice k) {
    PSymRef* slot = s->top->get_ptr(k);
    return slot ? *slot : NULL;
}

static void sym_declare(PSyms* s, CCSlice k, bool is_type) {
    PSym* cur = sym_lookup(s, k);
    PSym* sy;
    PFrame* fr = s->frame;
    /* redeclaring in the same scope with the same kind: nothing to do */
    if (cur && cur->depth == fr->depth && cur->is_type == is_type) return;
    sy = cc_arena_alloc(s->arena, sizeof(PSym), _Alignof(PSym));
    sy->name = k;
    sy->is_type = is_type;
    sy->depth = fr->depth;
    sy->shadowed = cur;
    s->top->insert(k, sy);
    fr->syms.push(sy);
}

/* Declare at file scope from an inner scope (forward-referenced type names). */
static void sym_declare_global(PSyms* s, CCSlice k) {
    PSym* sy = cc_arena_alloc(s->arena, sizeof(PSym), _Alignof(PSym));
    PFrame* fr = s->frame;
    PSym* cur = sym_lookup(s, k);
    while (fr->outer) fr = fr->outer;
    sy->name = k;
    sy->is_type = true;
    sy->depth = 0;
    /* insert below every binding of an inner scope */
    if (!cur || cur->depth == 0) {
        sy->shadowed = cur;
        s->top->insert(k, sy);
    } else {
        PSym* above = cur;
        while (above->shadowed && above->shadowed->depth > 0) above = above->shadowed;
        sy->shadowed = above->shadowed;
        above->shadowed = sy;
    }
    fr->syms.push(sy);
}

static void scope_push(PSyms* s) {
    PFrame* fr = cc_arena_alloc(s->arena, sizeof(PFrame), _Alignof(PFrame));
    fr->outer = s->frame;
    fr->syms = vec_new::[PSymRef](s->arena);
    fr->depth = s->frame->depth + 1;
    s->frame = fr;
    s->depth = fr->depth;
}

static void scope_pop(PSyms* s) {
    PFrame* fr = s->frame;
    size_t i;
    size_t n;
    if (!fr->outer) return;
    n = fr->syms.len();
    for (i = n; i > 0; i--) {
        PSym* sy = *fr->syms.get_ptr(i - 1);
        PSym* cur = sym_lookup(s, sy->name);
        /* unlink this binding wherever it sits in the chain */
        if (cur == sy) {
            if (sy->shadowed) s->top->insert(sy->name, sy->shadowed);
            else s->top->remove(sy->name);
        } else {
            PSym* above = cur;
            while (above && above->shadowed != sy) above = above->shadowed;
            if (above) above->shadowed = sy->shadowed;
        }
    }
    s->frame = fr->outer;
    s->depth = s->frame->depth;
}

static bool name_is_type(P* p, CCSlice nm) {
    PSym* sy = sym_lookup(p->syms, nm);
    return sy && sy->is_type;
}

static bool name_is_var(P* p, CCSlice nm) {
    PSym* sy = sym_lookup(p->syms, nm);
    return sy && !sy->is_type;
}

static void declare_type(P* p, CCSlice nm) {
    sym_declare(p->syms, nm, true);
    if (p->syms->depth == 0) {
        Vec::[CCSlice]* names = &p->u->typedef_names;
        names->push(nm);
    }
}

static void declare_var(P* p, CCSlice nm) { sym_declare(p->syms, nm, false); }

static void assume_type(P* p, CCSlice nm) {
    Vec::[CCSlice]* assumed;
    if (name_is_type(p, nm)) return;
    sym_declare_global(p->syms, nm);
    assumed = &p->u->assumed_types;
    assumed->push(nm);
}

/* ---- token helpers -------------------------------------------------------- */

static uint32_t idx(P* p, uint32_t k) {
    uint32_t j = p->i + k;
    return j < p->n ? j : p->n - 1;
}
static const CcToken* tk(P* p, uint32_t k) { return &p->t[idx(p, k)]; }
static bool at_eof(P* p) { return p->t[p->i].kind == CC_TK_EOF; }
static bool tok_is_p(const CcToken* t, CcPunct pc) { return t->kind == CC_TK_PUNCT && t->punct == pc; }
static bool at_p(P* p, CcPunct pc) { return tok_is_p(&p->t[p->i], pc); }
static bool at_p2(P* p, CcPunct a, CcPunct b) { return at_p(p, a) && tok_is_p(tk(p, 1), b); }
static bool at_kw(P* p, Kw k) { return is_kw(p, p->i, k); }
static bool tok_is_word(P* p, uint32_t i, const char* w) {
    const CcToken* t = &p->t[i < p->n ? i : p->n - 1];
    return CcToken_is_at(t, w);
}
static bool at_word(P* p, const char* w) { return tok_is_word(p, p->i, w); }
static bool at_ident(P* p) { return p->t[p->i].kind == CC_TK_IDENT; }
static void adv(P* p) { if (p->i + 1 < p->n) p->i++; }
static uint32_t last_tok(P* p) { return p->i ? p->i - 1 : 0; }
static CcSpan span_from(P* p, uint32_t first) {
    CcSpan s;
    s.first = first;
    s.last = last_tok(p);
    if (s.last < s.first) s.last = s.first;
    return s;
}
static CcSpan span2(uint32_t a, uint32_t b) {
    CcSpan s;
    s.first = a;
    s.last = b < a ? a : b;
    return s;
}
static bool accept_p(P* p, CcPunct pc) { if (at_p(p, pc)) { adv(p); return true; } return false; }
static bool accept_kw(P* p, Kw k) { if (at_kw(p, k)) { adv(p); return true; } return false; }
/* Adjacent tokens (no trivia between). */
static bool adjacent(P* p, uint32_t i) { return i + 1 < p->n && p->t[i + 1].lead.len == 0; }

/* ---- diagnostics ----------------------------------------------------------- */

/* The message is built by the caller with @string into p->arena. */
static void err_at(P* p, uint32_t tok, CCString msg) {
    CcTape* tp = p->tape;
    uint32_t i = tok < p->n ? tok : p->n - 1;
    CcLoc loc = tp->loc(i);
    CcDiag d = CcDiag_error(loc, cc_string_persist_slice(p->arena, &msg));
    CcDiags* ds = p->ds;
    d.len = (uint32_t)p->t[i].text.len;
    d.phys_line = p->t[i].line;
    ds->push(d);
}

static void err_here(P* p, CCString msg) { err_at(p, p->i, msg); }

/* The user's spelling of a token for messages. */
static CCSlice tok_desc(P* p, uint32_t i) {
    const CcToken* t = &p->t[i < p->n ? i : p->n - 1];
    CCSlice text = t->text;
    if (t->kind == CC_TK_EOF) return p->in_slot ? CC_SLICE_LIT("the end of the ${...} slot") : CC_SLICE_LIT("end of file");
    if (t->kind == CC_TK_PP) return CC_SLICE_LIT("a preprocessor line");
    if (t->kind == CC_TK_TEMPLATE) return CC_SLICE_LIT("a template literal");
    if (t->kind == CC_TK_STRING) return CC_SLICE_LIT("a string literal");
    if (text.len > 40) text = cc_slice_from_buffer((char*)text.ptr, 40);
    {
        /* a small CCString stores its bytes inline: persist before returning a view */
        CCString q = @string(`'${text}'`, p->arena);
        return cc_string_persist_slice(p->arena, &q);
    }
}

static uint32_t tok_line(P* p, uint32_t i) {
    CcTape* tp = p->tape;
    return tp->loc(i < p->n ? i : p->n - 1).line;
}

static CCSlice punct_text(CcPunct pc) {
    CCSlice s = cc_slice_from_buffer((char*)cc__punct_text(pc), strlen(cc__punct_text(pc)));
    return s;
}

/* Expect a punctuator; `what` names the construct being closed, `open` the
 * token that opened it (or the same token when not applicable). */
static bool expect_close(P* p, CcPunct pc, const char* what, uint32_t open) {
    CCSlice want;
    CCSlice found;
    if (accept_p(p, pc)) return true;
    want = punct_text(pc);
    found = tok_desc(p, p->i);
    if (open != p->i && open < p->n) {
        uint32_t line = tok_line(p, open);
        CCString m = @string(`expected '${want}' to close the ${what} on line ${line}, found ${found}`, p->arena);
        err_here(p, m);
    } else {
        CCString m = @string(`expected '${want}' after the ${what}, found ${found}`, p->arena);
        err_here(p, m);
    }
    return false;
}

static bool expect_p(P* p, CcPunct pc, const char* what) {
    CCSlice want;
    CCSlice found;
    if (accept_p(p, pc)) return true;
    want = punct_text(pc);
    found = tok_desc(p, p->i);
    {
        CCString m = @string(`expected '${want}' in ${what}, found ${found}`, p->arena);
        err_here(p, m);
    }
    return false;
}

/* A statement terminator: `;`, or a `;`/`}` an inner construct already
 * consumed on behalf of this statement. */
static bool expect_semi(P* p, const char* what) {
    CCSlice found;
    if (accept_p(p, CC_P_SEMI)) return true;
    if (p->i > 0 && p->consumed_terminator == p->i - 1) return true;
    found = tok_desc(p, p->i);
    {
        CCString m = @string(`expected ';' after ${what}, found ${found}`, p->arena);
        err_here(p, m);
    }
    return false;
}

/* ---- recovery ---------------------------------------------------------------- */

/* Skip a balanced bracket group starting at the current opener. */
static void skip_balanced(P* p) {
    int depth = 0;
    for (;;) {
        const CcToken* t = &p->t[p->i];
        if (t->kind == CC_TK_EOF) return;
        if (t->kind == CC_TK_PUNCT) {
            if (t->punct == CC_P_LPAREN || t->punct == CC_P_LBRACKET || t->punct == CC_P_LBRACE) depth++;
            else if (t->punct == CC_P_RPAREN || t->punct == CC_P_RBRACKET || t->punct == CC_P_RBRACE) {
                depth--;
                if (depth <= 0) { adv(p); return; }
            }
        }
        adv(p);
    }
}

/* Recover at the next `;` (consumed) or `}` (left in place) at the current
 * nesting depth; a `{` met on the way is skipped whole and ends the sync. */
static void sync(P* p, uint32_t start) {
    if (p->i == start && !at_eof(p) && !at_p(p, CC_P_SEMI) && !at_p(p, CC_P_RBRACE)) adv(p);
    for (;;) {
        const CcToken* t = &p->t[p->i];
        if (t->kind == CC_TK_EOF) return;
        if (t->kind == CC_TK_PUNCT) {
            if (t->punct == CC_P_SEMI) { adv(p); return; }
            if (t->punct == CC_P_RBRACE) return;
            if (t->punct == CC_P_LBRACE) { skip_balanced(p); return; }
            if (t->punct == CC_P_LPAREN || t->punct == CC_P_LBRACKET) { skip_balanced(p); continue; }
        }
        adv(p);
    }
}

/* Index of the token matching the opener at `i` (same kind), or n-1. */
static uint32_t match_close(P* p, uint32_t i) {
    int depth = 0;
    for (; i < p->n; i++) {
        const CcToken* t = &p->t[i];
        if (t->kind == CC_TK_EOF) return p->n - 1;
        if (t->kind != CC_TK_PUNCT) continue;
        if (t->punct == CC_P_LPAREN || t->punct == CC_P_LBRACKET || t->punct == CC_P_LBRACE) depth++;
        else if (t->punct == CC_P_RPAREN || t->punct == CC_P_RBRACKET || t->punct == CC_P_RBRACE) {
            depth--;
            if (depth == 0) return i;
        }
    }
    return p->n - 1;
}

/* ---- preprocessor lines ---------------------------------------------------------- */

static CCSlice slice_skip(CCSlice s, size_t n) {
    if (n > s.len) n = s.len;
    return cc_slice_from_buffer((char*)s.ptr + n, s.len - n);
}

static CCSlice slice_skip_blanks(CCSlice s) {
    size_t n = 0;
    while (n < s.len && (s.ptr[n] == ' ' || s.ptr[n] == '\t')) n++;
    return slice_skip(s, n);
}

/* Text of a PP token after `#` and blanks, with line splices removed. */
static CCSlice pp_body(P* p, uint32_t i) {
    const CcToken* t = &p->t[i];
    CCSlice s = t->text;
    CCString b = cc_string_new();
    size_t j;
    for (j = 1; j < s.len; j++) {
        if (s.ptr[j] == '\\' && j + 1 < s.len && s.ptr[j + 1] == '\n') { j++; continue; }
        if (s.ptr[j] == '\\' && j + 2 < s.len && s.ptr[j + 1] == '\r' && s.ptr[j + 2] == '\n') { j += 2; continue; }
        b.push_char(s.ptr[j], p->arena);
    }
    return slice_skip_blanks(cc_string_persist_slice(p->arena, &b));
}

static bool starts_word(CCSlice s, const char* w) {
    size_t wl = strlen(w);
    char c;
    if (s.len < wl || memcmp(s.ptr, w, wl) != 0) return false;
    if (s.len == wl) return true;
    c = s.ptr[wl];
    return !((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_');
}

typedef enum PpKind { PP_OTHER, PP_IF, PP_ELIF, PP_ELSE, PP_ENDIF } PpKind;

/* Classify a directive; for #if/#ifdef/#ifndef also decide statically when
 * possible: *val = 0 false, 1 true, -1 unknown. */
static PpKind pp_classify(CCSlice s, int* val) {
    CCSlice q;
    *val = -1;
    if (starts_word(s, "endif")) return PP_ENDIF;
    if (starts_word(s, "else")) return PP_ELSE;
    if (starts_word(s, "elif")) return PP_ELIF;
    if (starts_word(s, "ifdef") || starts_word(s, "ifndef")) {
        bool neg = s.ptr[2] == 'n';
        q = slice_skip_blanks(slice_skip(s, neg ? 6 : 5));
        if (starts_word(q, "__cplusplus")) *val = neg ? 1 : 0;
        return PP_IF;
    }
    if (starts_word(s, "if")) {
        bool neg = false;
        q = slice_skip_blanks(slice_skip(s, 2));
        if (q.len && q.ptr[0] == '!') { neg = true; q = slice_skip_blanks(slice_skip(q, 1)); }
        if (starts_word(q, "defined")) {
            q = slice_skip(q, 7);
            while (q.len && (q.ptr[0] == ' ' || q.ptr[0] == '\t' || q.ptr[0] == '(')) q = slice_skip(q, 1);
            if (starts_word(q, "__cplusplus")) {
                /* `defined(__cplusplus) && ...` is false; `!defined(...) || x` unknown */
                q = slice_skip(q, 11);
                while (q.len && (q.ptr[0] == ' ' || q.ptr[0] == '\t' || q.ptr[0] == ')')) q = slice_skip(q, 1);
                if (!neg && (q.len == 0 || (q.len >= 2 && q.ptr[0] == '&' && q.ptr[1] == '&'))) *val = 0;
                else if (neg && q.len == 0) *val = 1;
            }
        } else if (starts_word(q, "__cplusplus")) {
            *val = 0;
        } else if (!neg && q.len == 1 && (q.ptr[0] == '0' || q.ptr[0] == '1')) {
            *val = q.ptr[0] - '0';
        } else if (neg && q.len == 1 && (q.ptr[0] == '0' || q.ptr[0] == '1')) {
            *val = q.ptr[0] == '0';
        }
        return PP_IF;
    }
    return PP_OTHER;
}

/* Skip tokens after an inactive directive up to (not including) the
 * #else / #elif / #endif that ends the region. Returns the index of the
 * last skipped token, or `i` when nothing was skipped. */
static uint32_t pp_skip_region(P* p, uint32_t i) {
    int depth = 0;
    uint32_t j = i + 1, last = i;
    for (; j < p->n; j++) {
        const CcToken* t = &p->t[j];
        if (t->kind == CC_TK_EOF) break;
        if (t->kind == CC_TK_PP) {
            int v;
            PpKind k = pp_classify(pp_body(p, j), &v);
            if (k == PP_IF) depth++;
            else if (k == PP_ENDIF) { if (depth == 0) break; depth--; }
            else if ((k == PP_ELSE || k == PP_ELIF) && depth == 0) break;
        }
        last = j;
    }
    p->i = last + 1;
    return last;
}

/* Called for every PP token in a list position: maintains the #if stack
 * and skips inactive regions. `*last` receives the last token covered. */
static void pp_note(P* p, uint32_t i, uint32_t* last, bool* skipped) {
    int v;
    PpKind k = pp_classify(pp_body(p, i), &v);
    Vec::[PpCond]* stack = &p->pp;
    *last = i;
    *skipped = false;
    if (p->i == i) adv(p);
    if (k == PP_IF) {
        PpCond c;
        c.else_dead = v == 1;
        c.taken = v == 1;
        stack->push(c);
        if (v == 0) { *last = pp_skip_region(p, i); *skipped = *last != i; }
    } else if (k == PP_ELIF || k == PP_ELSE) {
        size_t n = stack->len();
        PpCond* c = n ? stack->get_ptr(n - 1) : NULL;
        if (c && c->else_dead) { *last = pp_skip_region(p, i); *skipped = *last != i; }
        else if (c) {
            if (k == PP_ELIF) {
                /* the #if branch was inactive: this branch is active when
                 * its condition is not statically false */
                if (v == 0) { *last = pp_skip_region(p, i); *skipped = *last != i; }
                else c->else_dead = true;
            } else c->else_dead = true;
        }
    } else if (k == PP_ENDIF) {
        size_t n = stack->len();
        if (n) stack->truncate(n - 1);
    }
}

/* ---- attributes ------------------------------------------------------------------ */

static CcAttr attr_make(P* p, uint32_t first, CCSlice name, CCSlice value) {
    CcAttr a;
    a.span = span_from(p, first);
    a.name = name;
    a.value = value;
    a.args = span2(first, first);
    a.args.last = first;   /* empty: last < first is not representable; callers test name */
    return a;
}

static bool at_attr_start(P* p) {
    Kw k = kw_of(p, p->i);
    return k == KW_ATTRIBUTE || k == KW_ATTRIBUTE2 || k == KW_ALIGNAS || k == KW_DECLSPEC || k == KW_ALIGNAS2;
}

/* `__attribute__((...))`, `_Alignas(...)`, `__declspec(...)`: the whole
 * balanced group. The value is the single identifier inside when the
 * argument is exactly one identifier (`unused`, `packed`). */
static CcAttr parse_attr(P* p) {
    uint32_t first = p->i;
    Kw k = kw_of(p, p->i);
    CCSlice name = tok_name(p, p->i);
    CCSlice value = CC_SLICE_LIT("");
    adv(p);
    if (!at_p(p, CC_P_LPAREN)) {
        CCString m = @string(`expected '(' after ${name}`, p->arena);
        err_here(p, m);
        return attr_make(p, first, name, value);
    }
    {
        uint32_t close = match_close(p, p->i);
        uint32_t inner = p->i + 1;
        CcAttr a;
        if (k == KW_ATTRIBUTE || k == KW_ATTRIBUTE2) {
            if (tok_is_p(&p->t[inner], CC_P_LPAREN)) inner++;
        }
        if (p->t[inner].kind == CC_TK_IDENT &&
            (tok_is_p(&p->t[inner + 1], CC_P_RPAREN) || tok_is_p(&p->t[inner + 1], CC_P_LPAREN) ||
             tok_is_p(&p->t[inner + 1], CC_P_COMMA)))
            value = tok_name(p, inner);
        p->i = close;
        if (p->t[p->i].kind == CC_TK_EOF) {
            CCString m = @string(`unterminated ${name}`, p->arena);
            err_at(p, first, m);
        } else adv(p);
        a = attr_make(p, first, name, value);
        a.args = span2(first + 1, close);
        return a;
    }
}

/* Zero or more attributes; appended to `out`. Also accepts a GCC asm label
 * `asm("sym")`. */
static void parse_attrs(P* p, Vec::[CcAttr]* out) {
    for (;;) {
        if (at_attr_start(p)) { out->push(parse_attr(p)); continue; }
        {
            Kw k = kw_of(p, p->i);
            if ((k == KW_ASM || k == KW_ASM2 || k == KW_ASM3) && tok_is_p(tk(p, 1), CC_P_LPAREN)) {
                uint32_t first = p->i;
                adv(p);
                skip_balanced(p);
                out->push(attr_make(p, first, CC_SLICE_LIT("asm"), CC_SLICE_LIT("")));
                continue;
            }
        }
        break;
    }
}

/* `@tag:NAME` in a comment right before a declaration, and `@task` CCDoc
 * comments, become attributes of the declaration. */
static void collect_trivia_attrs(P* p, uint32_t tok, Vec::[CcAttr]* out) {
    const CcToken* t = &p->t[tok];
    const char* s = t->lead.ptr;
    const char* e = s + t->lead.len;
    const char* q = s;
    while (q < e) {
        if (q + 1 < e && q[0] == '/' && (q[1] == '*' || q[1] == '/')) {
            bool block = q[1] == '*';
            const char* c = q + 2;
            const char* cend = c;
            if (block) {
                while (cend + 1 < e && !(cend[0] == '*' && cend[1] == '/')) cend++;
            } else {
                while (cend < e && *cend != '\n') cend++;
            }
            {
                const char* r = c;
                while (r < cend) {
                    if (*r == '@' && cend - r > 5 && memcmp(r, "@tag:", 5) == 0) {
                        const char* nm = r + 5;
                        const char* ne = nm;
                        while (ne < cend && ((*ne >= 'a' && *ne <= 'z') || (*ne >= 'A' && *ne <= 'Z') ||
                                              (*ne >= '0' && *ne <= '9') || *ne == '_')) ne++;
                        if (ne > nm) {
                            CcAttr a;
                            a.span = span2(tok, tok);
                            a.name = CC_SLICE_LIT("tag");
                            a.value = cc_slice_from_buffer((char*)nm, (size_t)(ne - nm));
                            a.args = span2(tok, tok);
                            out->push(a);
                        }
                        r = ne;
                        continue;
                    }
                    if (*r == '@' && cend - r >= 5 && memcmp(r, "@task", 5) == 0 &&
                        (cend - r == 5 || r[5] == ' ' || r[5] == '\t' || r[5] == '\n' || r[5] == '\r')) {
                        CcAttr a;
                        a.span = span2(tok, tok);
                        a.name = CC_SLICE_LIT("task");
                        a.value = CC_SLICE_LIT("");
                        a.args = span2(tok, tok);
                        out->push(a);
                        r += 5;
                        continue;
                    }
                    r++;
                }
            }
            q = block ? cend + 2 : cend;
            continue;
        }
        q++;
    }
}

/* ---- construction ------------------------------------------------------------------- */

static P parser_new(CcUnit* u, CcParseOpts opts, CcDiags* ds, CCArena a) {
    P p;
    int k;
    memset(&p, 0, sizeof(p));
    p.arena = a;
    p.ds = ds;
    p.u = u;
    p.tape = &u->tape;
    {
        Vec::[CcToken]* toks = &u->tape.toks;
        p.t = toks->data();
        p.n = (uint32_t)toks->len();
    }
    p.i = 0;
    p.opts = opts;
    p.syms = syms_new(a);
    p.kw = map_new::[CCSlice, int](a);
    for (k = 1; k < KW_IN; k++) {
        CCSlice key = cc_slice_from_buffer((char*)cc__kw_text[k], strlen(cc__kw_text[k]));
        p.kw->insert(key, k);
    }
    p.consumed_terminator = 0xFFFFFFFFu;
    p.tpl_ok = false;
    p.pp = vec_new::[PpCond](a);
    p.bind_stmt = NULL;
    p.in_slot = false;
    {
        Vec::[CCSlice]* known = &opts.known_types;
        size_t i;
        size_t n = known->len();
        for (i = 0; i < n; i++) sym_declare(p.syms, *known->get_ptr(i), true);
    }
    return p;
}

#endif

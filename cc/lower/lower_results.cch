#pragma(@per_tu)
/* Results: `T!>(E)` types, cc_ok / cc_err, the `!>` and `?>` forms,
 * @errhandler and @err. The shapes are in LOWERING.md.
 *
 * Order inside a unit: functions first (they need the Result the function
 * returns as written), then every `T!>(E)` type becomes its spec name, then
 * the spec blocks are emitted after the includes. */
#ifndef CC_LOWER_LOWER_RESULTS_CCH
#define CC_LOWER_LOWER_RESULTS_CCH

/* An @errhandler in scope. A handler whose body diverges is hoisted to the
 * function tail behind a label with an error cell at the function top; one
 * that falls through is emitted inline at each site. */
typedef struct RHandler {
    uint32_t id;
    CCSlice err_canon;
    CcType* err_type;
    CCSlice binder;
    CcStmt* body;
    bool hoisted;
    size_t depth;
    CcSpan span;                /* the `@errhandler` statement */
} RHandler;
typedef RHandler* RHandlerRef;              /* a Vec of the struct itself would hoist the struct above the prelude */
typedef Vec::[RHandlerRef] RHandlerList;
typedef Vec::[CcTypeInfoRef] RSpecList;

typedef struct RFn {
    CcLowerer* L;
    CcDecl* fn;
    CcTypeInfo* ret;            /* the Result the function returns, or NULL */
    RHandlerList handlers;      /* in scope, innermost last */
    RHandlerList hoisted;
    size_t depth;
    bool nested_unwrap;         /* a `!>` in expression position was seen */
    RHandler* defining;         /* the handler whose body is being lowered, or NULL */
    CcNameList binders;         /* error binders in scope (`!> (e) {`, `@errhandler(E e)`), innermost last */
} RFn;

static CCSlice rl_lit(const char* s) { return cc_slice_from_buffer((char*)s, strlen(s)); }

/* The current engine types a UFCS receiver from its first path segment, so
 * `L->ix->m()` must be `ix->m()` on a bound local (stress/break shape 3). */
static CcIndex* rl_ix(CcLowerer* L) { return L->ix; }
static CcTypeInfo* rl_ix_result(CcLowerer* L, CcType* v, CcType* e, bool opt) { CcIndex* ix = L->ix; return ix->result(v, e, opt); }
static CcSym* rl_ix_sym(CcLowerer* L, CCSlice name) { CcIndex* ix = L->ix; CcSym* s = ix->sym(name) ?> NULL; return s; }
static CCSlice rl_ix_canon(CcLowerer* L, const CcType* t) { CcIndex* ix = L->ix; return ix->canon(t); }
static CcLoc rl_loc(CcLowerer* L, CcSpan sp) { CcUnit* u = L->unit; return u->loc(sp); }

static bool rl_is_ident(const CcExpr* e, const char* name) {
    if (!e) return false;
    @switch (e->k) {
        case .ident(nm): return cc_slice_eq_cstr(&nm, name);
        default: return false;
    }
}

static CCSlice rl_ident_name(const CcExpr* e) {
    @switch (e->k) {
        case .ident(nm): return nm;
        default: return cc_slice_empty();
    }
}

/* ---- what the function returns ------------------------------------------ */

static CcTypeInfo* rl_ret_result(CcLowerer* L, CcType* fn_type) {
    CcType* ret = NULL;
    if (!fn_type) return NULL;
    @switch (fn_type->k) {
        case .func(ft): ret = ft.ret; break;
        default: return NULL;
    }
    if (!ret) return NULL;
    @switch (ret->k) {
        case .result(r): return rl_ix_result(L, r.value, r.err, r.optional);
        case .named(nm): {
            /* `CCResult_int_CCError f(void)`: the spec name written out */
            CcIndex* ix = L->ix;
            CcTypeInfo* ti = ix->type_get(nm.name);
            return (ti && ti->is_result) ? ti : NULL;
        }
        default: return NULL;
    }
}

/* The Result type a call expression yields, from the callee's declaration;
 * NULL when unknown (a UFCS call, an expression, an undeclared name). */
static CcTypeInfo* rl_result_of_call(CcLowerer* L, const CcExpr* e) {
    CcExpr* callee = NULL;
    CCSlice name;
    CcSym* sym;
    if (!e) return NULL;
    @switch (e->k) {
        case .call(c): callee = c.callee; break;
        default: return NULL;
    }
    if (!callee) return NULL;
    name = rl_ident_name(callee);
    if (!name.len) return NULL;
    sym = rl_ix_sym(L, name);
    if (!sym || sym->kind != CC_SYM_FUNC) return NULL;
    return rl_ret_result(L, sym->type);
}

/* ---- cc_ok / cc_err ------------------------------------------------------ */

static bool rl_is_type_arg(const CcExpr* e) {
    @switch (e->k) {
        case .type_arg: return true;
        default: return false;
    }
}

static CcType* rl_type_arg(const CcExpr* e) {
    @switch (e->k) {
        case .type_arg(ta): return ta.type;
        default: return NULL;
    }
}

static bool rl_is_string(const CcExpr* e) {
    @switch (e->k) {
        case .string: return true;
        default: return false;
    }
}

/* Rewrite one `cc_ok(...)` / `cc_err(...)` call in place. */
static void rl_ctor(RFn* fn, CcExpr* e, bool is_ok, CcExprList args) {
    CcLowerer* L = fn->L;
    CcTypeInfo* spec = fn->ret;
    size_t n = args.len();
    CcExpr* payload = NULL;
    CCString fname;
    CcExpr* call;
    /* explicit forms: cc_ok(T, v), cc_ok(T, E, v), cc_err(T, e), cc_err(T, E, e) */
    if (n >= 2 && rl_is_type_arg(*args.get_ptr(0))) {
        CcType* t = rl_type_arg(*args.get_ptr(0));
        CcType* et = NULL;
        if (n == 3 && rl_is_type_arg(*args.get_ptr(1))) et = rl_type_arg(*args.get_ptr(1));
        if (!et && spec) et = spec->result_err;
        if (!et) {
            CCString m = @string(`the error type of this Result is not known here: write cc_ok(T, E, v)`, L->arena);
            lw_error(L, e->span, m);
            return;
        }
        spec = rl_ix_result(L, t, et, false);
        payload = *args.get_ptr(n - 1);
    } else if (n == 1 && rl_is_type_arg(*args.get_ptr(0)) && is_ok) {
        payload = NULL;   /* cc_ok(void) */
    } else if (n == 1) {
        payload = *args.get_ptr(0);
    } else if (n == 2 && !is_ok && rl_is_string(*args.get_ptr(1))) {
        /* cc_err(CC_ERR_X, "msg") → cc_err_SPEC(CC_ERROR(CC_ERR_X, "msg")) */
        payload = lw_call2(L, rl_lit("CC_ERROR"), *args.get_ptr(0), *args.get_ptr(1), e->span);
    } else if (n == 0 && is_ok) {
        payload = NULL;
    } else {
        CCString m = @string(`this ${is_ok ? "cc_ok" : "cc_err"} form is not one the lowering knows`, L->arena);
        lw_error(L, e->span, m);
        return;
    }
    if (!spec) {
        CCString m = @string(`${is_ok ? "cc_ok" : "cc_err"} outside a function that returns a Result: write the spec explicitly, cc_ok(T, E, v)`, L->arena);
        lw_error(L, e->span, m);
        return;
    }
    fname = @string(`${is_ok ? "cc_ok_" : "cc_err_"}${spec->name}`, L->arena);
    if (payload) call = lw_call1(L, lw_keep(L, &fname), payload, e->span);
    else call = lw_call0(L, lw_keep(L, &fname), e->span);
    e->k = call->k;
}

static bool rl_ctor_visit(CcExpr* e, void* env) {
    RFn* fn = (RFn*)env;
    CcExpr* callee = NULL;
    CcExprList args;
    bool have = false;
    @switch (e->k) {
        case .call(c): callee = c.callee; args = c.args; have = true; break;
        default: break;
    }
    if (!have || !callee) return true;
    if (rl_is_ident(callee, "cc_ok")) { rl_ctor(fn, e, true, args); return false; }
    if (rl_is_ident(callee, "cc_err")) { rl_ctor(fn, e, false, args); return false; }
    return true;
}

/* ---- handlers ------------------------------------------------------------ */

static bool rl_call_diverges(CcLowerer* L, const CcExpr* e) {
    CcExpr* callee = NULL;
    CCSlice name;
    CcSym* sym;
    @switch (e->k) {
        case .call(c): callee = c.callee; break;
        default: return false;
    }
    if (!callee) return false;
    name = rl_ident_name(callee);
    if (!name.len) return false;
    if (cc_slice_eq_cstr(&name, "exit") || cc_slice_eq_cstr(&name, "_exit") || cc_slice_eq_cstr(&name, "abort") ||
        cc_slice_eq_cstr(&name, "longjmp") || cc_slice_eq_cstr(&name, "cc_error_exit") || cc_slice_eq_cstr(&name, "cc_abort"))
        return true;
    sym = rl_ix_sym(L, name);
    return sym && CcSym_noreturn(sym);
}

static bool rl_diverges(CcLowerer* L, const CcStmt* s);

static bool rl_diverges_b(CcLowerer* L, const CcStmt* s) {
    @switch (s->k) {
        case .block(b): {
            size_t n = b.stmts.len();
            if (!n) return false;
            return rl_diverges(L, *b.stmts.get_ptr(n - 1));
        }
        case .if_(i): return i.els && rl_diverges(L, i.then) && rl_diverges(L, i.els);
        case .expr(es): return es.e && rl_call_diverges(L, es.e);
        default: return false;
    }
}

static bool rl_diverges(CcLowerer* L, const CcStmt* s) {
    if (!s) return false;
    @switch (s->k) {
        case .return_: return true;
        case .goto_: return true;
        case .break_: return true;
        case .continue_: return true;
        case .err_fwd: return true;    /* `@err(e);` jumps to the handler */
        default: return rl_diverges_b(L, s);
    }
}

static CcStmt* rl_body(RFn* fn, CcStmt* s);
static void rl_hoist_nested(RFn* fn, CcStmt* s);

static void rl_register_handler(RFn* fn, const CcErrhandler* eh, CcSpan sp) {
    CcLowerer* L = fn->L;
    RHandler* h = cc_arena_alloc(L->arena, sizeof(RHandler), _Alignof(RHandler));
    RHandlerList* hs = &fn->handlers;
    h->id = CcLowerer_temp_id(L);
    h->err_type = eh->err_type;
    h->err_canon = eh->err_type ? rl_ix_canon(L, eh->err_type) : cc_slice_empty();
    h->binder = eh->binder;
    h->hoisted = rl_diverges(L, eh->body);
    h->depth = fn->depth;
    h->span = sp;
    /* the body's own unwraps and `@err`s see the handlers above this one */
    {
        RHandler* outer = fn->defining;
        CcNameList* bs = &fn->binders;
        size_t nb = bs->len();
        fn->defining = h;
        if (h->binder.len) bs->push(h->binder);
        h->body = rl_body(fn, eh->body);
        bs->truncate(nb);
        fn->defining = outer;
    }
    hs->push(h);
    if (h->hoisted) {
        RHandlerList* ho = &fn->hoisted;
        ho->push(h);
    }
}

/* ---- handler lookup ------------------------------------------------------- */

static CCSlice rl_call_name(const CcExpr* e);
static CCString rl_spec_arg(CcLowerer* L, CcType* t);
static CcExpr* rl_r(CcLowerer* L, CcSpan sp);
static CcExpr* rl_r_ok(CcLowerer* L, CcSpan sp);
static CcExpr* rl_r_value(CcLowerer* L, CcSpan sp);
static CcExpr* rl_r_error(CcLowerer* L, CcSpan sp);
static CcType* rl_typeof_error(CcLowerer* L, CcSpan sp);
static CCString lw_spell_expr(CcLowerer* L, const CcExpr* e);

/* "@" a "@" b: messages that name `@err` / `@errhandler` are assembled, so
 * no `@word` sits in a literal for the current engine to trip on. */
static CCString rl_at2(CcLowerer* L, const char* a, const char* b) {
    CCString m = cc_string_new();
    cc_string_push_cstr(&m, "@", L->arena);
    cc_string_push_cstr(&m, a, L->arena);
    if (b) {
        cc_string_push_cstr(&m, "@", L->arena);
        cc_string_push_cstr(&m, b, L->arena);
    }
    return m;
}

/* The `as:` walk from error type `from` to `to`: the face fields to read,
 * innermost face first. A face whose type is `to` ends the walk; another
 * struct type continues it. `seen` guards cycles (a type met twice on the
 * walk sets `*cycle`); `*n_found` counts every complete path so a second
 * one is reported as ambiguous. Lifetime: everything in the lowerer arena. */
static bool rl_as_search(CcLowerer* L, CCSlice from, CCSlice to, CcNameList* path, CcNameList* seen,
                         int* n_found, bool* cycle) {
    CcIndex* ix = rl_ix(L);
    CcNameList faces = cc__view_faces(ix, from);
    size_t n = faces.len();
    size_t i;
    size_t ns = seen->len();
    CcRecordType st;
    CcFieldList* fieldv;
    size_t nf;
    bool set = false;
    if (!n) return false;
    for (i = 0; i < ns; i++) {
        CCSlice sn = *seen->get_ptr(i);
        if (cc_slice_eq(&sn, from)) { *cycle = true; return false; }
    }
    if (!cc__struct_of(ix, from, 0, &st)) return false;
    seen->push(from);
    fieldv = &st.fields;
    nf = fieldv->len();
    for (i = 0; i < n; i++) {
        CCSlice face = *faces.get_ptr(i);
        size_t k;
        for (k = 0; k < nf; k++) {
            CcField* f = fieldv->get_ptr(k);
            CCSlice fty;
            if (!f->name.len || !cc_slice_eq(&f->name, face)) continue;
            if (!f->type) continue;
            if (f->type->k.kind == CcTypeK_pointer) continue;   /* a value embed, never a pointer */
            fty = rl_ix_canon(L, f->type);
            if (cc_slice_eq(&fty, to)) {
                (*n_found)++;
                if (!set) { path->push(face); set = true; }
            } else {
                CcNameList sub = vec_new::[CCSlice](L->arena);
                if (rl_as_search(L, fty, to, &sub, seen, n_found, cycle) && !set) {
                    size_t j;
                    size_t nsub = sub.len();
                    path->push(face);
                    for (j = 0; j < nsub; j++) {
                        CCSlice step = *sub.get_ptr(j);
                        path->push(step);
                    }
                    set = true;
                }
            }
        }
    }
    seen->truncate(ns);
    return set;
}

/* The handler for an error of type `err_canon` (empty: unknown). An exact
 * match wins, innermost first. Otherwise every handler in scope is tried
 * through the error type's `as:` faces: exactly one handler type may be
 * reachable, and `*path` receives the faces to read. NULL after the
 * diagnostic (`bare` when no handler is in scope at all). */
static RHandler* rl_pick_handler(RFn* fn, CCSlice err_canon, CcSpan sp, CCSlice bare, CcNameList* path,
                                 const CcExpr* inner, CcTypeInfo* rt) {
    CcLowerer* L = fn->L;
    RHandlerList* hs = &fn->handlers;
    size_t n = hs->len();
    size_t i;
    RHandler* best = NULL;
    CcNameList best_path = vec_new::[CCSlice](L->arena);
    bool ambiguous = false;
    bool saw_cycle = false;
    *path = vec_new::[CCSlice](L->arena);
    if (fn->defining && (!err_canon.len || cc_slice_eq(&fn->defining->err_canon, err_canon))) {
        bool shadowed = false;
        /* a nearer handler of that type inside the body takes it instead */
        for (i = n; i > 0; i--) {
            RHandler* h = *hs->get_ptr(i - 1);
            if (h->depth > fn->defining->depth && (!err_canon.len || cc_slice_eq(&h->err_canon, err_canon))) shadowed = true;
        }
        if (!shadowed) {
            CCString m = @string(`bare '!>;' inside matching '@errhandler' would re-enter it; handle the Result here with '!> (e) { ... }' or '?>'`, L->arena);
            lw_error(L, sp, m);
            return NULL;
        }
    }
    if (!n) {
        CCString m = @string(`${bare}`, L->arena);
        lw_error(L, sp, m);
        return NULL;
    }
    for (i = n; i > 0; i--) {
        RHandler* h = *hs->get_ptr(i - 1);
        if (!err_canon.len || !h->err_canon.len || cc_slice_eq(&h->err_canon, err_canon)) return h;
    }
    /* innermost scope with a reachable handler wins; two distinct handler
     * types reachable at that scope are ambiguous (hop count is no rank) */
    for (i = n; i > 0; i--) {
        RHandler* h = *hs->get_ptr(i - 1);
        CcNameList p = vec_new::[CCSlice](L->arena);
        CcNameList seen = vec_new::[CCSlice](L->arena);
        int n_found = 0;
        bool cycle = false;
        if (best && h->depth < best->depth) break;
        if (rl_as_search(L, err_canon, h->err_canon, &p, &seen, &n_found, &cycle)) {
            if (n_found > 1) ambiguous = true;
            if (!best) { best = h; best_path = p; }
            else if (!cc_slice_eq(&best->err_canon, h->err_canon)) ambiguous = true;
        } else if (cycle) {
            saw_cycle = true;
        }
    }
    if (ambiguous) {
        CCString m = @string(`ambiguous '@errhandler' for error type '${err_canon}': multiple as: faces match in-scope handlers`, L->arena);
        lw_error(L, sp, m);
        return NULL;
    }
    if (best) { *path = best_path; return best; }
    if (saw_cycle) {
        CCString m = @string(`cyclic as: path while matching '@errhandler' for error type '${err_canon}'`, L->arena);
        lw_error(L, sp, m);
        return NULL;
    }
    {
        /* `'f' is 'int !>(CCError)'; in-scope '@errhandler' is 'OtherErr'` */
        CCString m = @string(`no matching '@errhandler' for error type '${err_canon}'`, L->arena);
        CCString scope = cc_string_new();
        for (i = 0; i < n; i++) {
            RHandler* h = *hs->get_ptr(i);
            if (i) cc_string_push_cstr(&scope, ", ", L->arena);
            cc_string_push_slice(&scope, h->err_canon, L->arena);
        }
        if (inner && rt && rt->result_value) {
            CCSlice callee = rl_call_name(inner);
            CCString ret = rl_spec_arg(L, rt->result_value);
            CCString detail = @string(`: '${callee}' is '${ret} !>(${err_canon})'; in-scope '@errhandler' is '${scope}'`, L->arena);
            cc_string_push_slice(&m, detail.as_slice(), L->arena);
        } else {
            CCString detail = @string(`; in-scope '@errhandler' is '${scope}'`, L->arena);
            cc_string_push_slice(&m, detail.as_slice(), L->arena);
        }
        lw_error(L, sp, m);
    }
    return NULL;
}

/* The name a call spells, for messages: `f` in `f(x)`; empty otherwise. */
static CCSlice rl_call_name(const CcExpr* e) {
    if (!e) return cc_slice_empty();
    @switch (e->k) {
        case .call(c): return c.callee ? rl_ident_name(c.callee) : cc_slice_empty();
        default: return cc_slice_empty();
    }
}

static bool rl_sym_returns_pointer(const CcSym* sym) {
    if (!sym || !sym->type) return false;
    @switch (sym->type->k) {
        case .func(ft): return ft.ret && ft.ret->k.kind == CcTypeK_pointer;
        default: return false;
    }
}

/* What `!>` unwraps: 1 a Result (or a call the host types), 2 a pointer
 * (NULL is the error: the null unwrap), 0 nothing, said at the operator
 * rather than left for the host compiler. */
static int rl_unwrap_mode(CcLowerer* L, const CcExpr* inner, CcTypeInfo* rt, CcSpan sp) {
    CCSlice callee;
    if (rt) return 1;
    callee = rl_call_name(inner);
    if (callee.len) {
        CcSym* sym = rl_ix_sym(L, callee);
        if (!sym) {
            CCString m = @string(`type: '!>' on '${callee}': no visible declaration`, L->arena);
            lw_error(L, sp, m);
            return 0;
        }
        if (sym->kind == CC_SYM_FUNC) {
            if (rl_sym_returns_pointer(sym)) return 2;
            {
                CCString m = @string(`'!>' on '${callee}': it does not return a Result or a pointer ('!>' needs a 'T !>(E)' call, or a pointer call whose NULL is the error, on its left)`, L->arena);
                lw_error(L, sp, m);
            }
            return 0;
        }
        return 1;   /* a macro or a variable: the host decides */
    }
    {
        bool is_name = false;
        @switch (inner->k) {
            case .ident: is_name = true; break;
            case .number: is_name = true; break;
            case .string: is_name = true; break;
            case .chr: is_name = true; break;
            default: break;
        }
        if (is_name) {
            /* a plain variable or literal: nothing to unwrap */
            CCString m = @string(`'!>' needs a Result on its left: a call to a 'T !>(E)' function`, L->arena);
            lw_error(L, sp, m);
            return 0;
        }
    }
    return 1;   /* a method call, a conditional, a parenthesized call: the host types `__typeof__` */
}

/* The null unwrap's error: `CC_ERROR(CC_ERR_NULL, "NULL returned from <call> at <file>:<line>")`. */
static CcExpr* rl_null_error(CcLowerer* L, const CcExpr* inner, CcSpan sp) {
    CCString spelled = lw_spell_expr(L, inner);
    CCSlice sp_s = spelled.as_slice();
    CcLoc loc = rl_loc(L, sp);
    CCString t = cc_string_new();
    size_t i;
    cc_string_push_cstr(&t, "CC_ERROR(CC_ERR_NULL, \"NULL returned from ", L->arena);
    for (i = 0; i < sp_s.len; i++) {
        char c = sp_s.ptr[i];
        if (c == '\\' || c == '"') cc_string_push_char(&t, '\\', L->arena);
        if (c == '\n') { cc_string_push_cstr(&t, "\\n", L->arena); continue; }
        cc_string_push_char(&t, c, L->arena);
    }
    cc_string_push_cstr(&t, " at ", L->arena);
    cc_string_push_slice(&t, loc.path, L->arena);
    cc_string_push_char(&t, ':', L->arena);
    cc_string_push_uint(&t, (uint64_t)loc.line, L->arena);
    cc_string_push_cstr(&t, "\")", L->arena);
    return lw_text(L, t, sp);
}

/* The scaffold's reads of `__r`, by mode: a Result has `.ok` / `.u.value` /
 * `.u.error`; a pointer is its own ok test and value, and its error is made. */
static CcExpr* rl_r_ok2(CcLowerer* L, CcSpan sp, bool ptr) { return ptr ? rl_r(L, sp) : rl_r_ok(L, sp); }
static CcExpr* rl_r_value2(CcLowerer* L, CcSpan sp, bool ptr) { return ptr ? rl_r(L, sp) : rl_r_value(L, sp); }
static CcExpr* rl_r_error2(CcLowerer* L, CcSpan sp, bool ptr, const CcExpr* inner) { return ptr ? rl_null_error(L, inner, sp) : rl_r_error(L, sp); }
static CcType* rl_typeof_error2(CcLowerer* L, CcSpan sp, bool ptr) { return ptr ? lw_named_type(L, rl_lit("CCError"), sp) : rl_typeof_error(L, sp); }

/* `<err>` read through the faces of an `as:` path. */
static CcExpr* rl_project(CcLowerer* L, CcExpr* err, CcNameList* path, CcSpan sp) {
    size_t n = path->len();
    size_t i;
    for (i = 0; i < n; i++) {
        CCSlice face = *path->get_ptr(i);
        err = lw_member_s(L, err, face, sp);
    }
    return err;
}

static CCSlice rl_cell_name(CcLowerer* L, uint32_t id) {
    CCString s = @string(`__cc_eh_e_${id}`, L->arena);
    return lw_keep(L, &s);
}

static CCSlice rl_label_name(CcLowerer* L, uint32_t id) {
    CCString s = @string(`__cc_eh_${id}`, L->arena);
    return lw_keep(L, &s);
}

/* `__cc_eh_e_N = <err>; goto __cc_eh_N;` */
static void rl_push_jump(RFn* fn, CcStmt* into, RHandler* h, CcExpr* err, CcSpan sp) {
    CcLowerer* L = fn->L;
    lw_push(into, lw_expr_stmt(L, lw_assign(L, lw_ident(L, rl_cell_name(L, h->id), sp), err, sp), sp));
    lw_push(into, lw_goto(L, rl_label_name(L, h->id), sp));
}

/* `{ E binder = <err>; <body> }` */
static CcStmt* rl_inline_handler(RFn* fn, RHandler* h, CcExpr* err, CcSpan sp) {
    CcLowerer* L = fn->L;
    CcStmt* blk = lw_block(L, sp);
    if (h->binder.len) lw_push(blk, lw_decl_stmt(L, h->err_type, h->binder, err, sp));
    if (h->body) lw_push(blk, h->body);
    return blk;
}

/* ---- the unwrap scaffold ------------------------------------------------- */

static CcExpr* rl_r(CcLowerer* L, CcSpan sp) { return lw_ident(L, rl_lit("__r"), sp); }
static CcExpr* rl_r_ok(CcLowerer* L, CcSpan sp) { return lw_member(L, rl_r(L, sp), "ok", sp); }
static CcExpr* rl_r_value(CcLowerer* L, CcSpan sp) { return lw_member(L, lw_member(L, rl_r(L, sp), "u", sp), "value", sp); }
static CcExpr* rl_r_error(CcLowerer* L, CcSpan sp) { return lw_member(L, lw_member(L, rl_r(L, sp), "u", sp), "error", sp); }

/* `__typeof__(<inner>)`: the node itself, so later passes lower it once. */
static CcType* rl_typeof(CcLowerer* L, CcExpr* inner, CcSpan sp) {
    CcType* t = cc__type_blank(sp, L->arena);
    CcTypeofType tf;
    tf.expr = inner;
    tf.type = NULL;
    t->k = { .typeof_ = tf };
    return t;
}

/* `__typeof__(__r.u.error)` */
static CcType* rl_typeof_error(CcLowerer* L, CcSpan sp) {
    return rl_typeof(L, rl_r_error(L, sp), sp);
}

static CcStmt* rl_record_site(CcLowerer* L, CcSpan sp) {
    CcLoc loc = rl_loc(L, sp);
    CCString text = cc_string_new();
    CCString line = @string(`${loc.line}`, L->arena);
    cc_string_push_cstr(&text, "cc_rt_diag_record_unwrap_site(\"", L->arena);
    cc_string_push_slice(&text, loc.path, L->arena);
    cc_string_push_cstr(&text, "\", \"", L->arena);
    cc_string_push_slice(&text, line.as_slice(), L->arena);
    cc_string_push_cstr(&text, "\")", L->arena);
    return lw_expr_stmt(L, lw_text(L, text, sp), sp);
}

/* One unwrap statement:
 *   `<target> = <inner> !>;`             handler form
 *   `<target> = <inner> !> body;`        body form (binder optional)
 *   `<target> = <inner> ?> fallback;`    or form (binder optional)
 * `target` may be NULL (`<inner> !>;`). Returns the block replacing it, or
 * NULL when the form could not be lowered (a diagnostic was emitted). */
static CcStmt* rl_scaffold(RFn* fn, CcExpr* uw, CcExpr* target, CcSpan sp) {
    CcLowerer* L = fn->L;
    CcExpr* inner = NULL;
    CCSlice binder = cc_slice_empty();
    CcStmt* body = NULL;
    CcExpr* fallback = NULL;
    int form = 0;   /* 1 handler, 2 body, 3 or */
    CcStmt* blk;
    CcTypeInfo* rt;
    bool value_is_void = false;
    bool ptr = false;   /* the null unwrap: a pointer call, NULL is the error */
    @switch (uw->k) {
        case .unwrap(u): inner = u.a; form = 1; break;
        case .unwrap_body(ub): inner = ub.a; binder = ub.binder; body = ub.body; form = 2; break;
        case .unwrap_or(uo): inner = uo.a; binder = uo.binder; fallback = uo.fallback; form = 3; break;
        case .unwrap_destroy: {
            CCString m = @string(`'!> @destroy' is not lowered by the clean lowerer yet`, L->arena);
            lw_error(L, sp, m);
            return NULL;
        }
        default: return NULL;
    }
    if (!inner) return NULL;
    rt = rl_result_of_call(L, inner);
    {
        int mode = rl_unwrap_mode(L, inner, rt, sp);
        if (!mode) return NULL;
        ptr = mode == 2;
    }
    if (rt && rt->result_value) value_is_void = CcType_is_void(rt->result_value);
    L->unwraps_used = true;
    blk = lw_block(L, sp);
    /* __typeof__(inner) __r = inner; */
    lw_push(blk, lw_decl_stmt(L, rl_typeof(L, inner, sp), rl_lit("__r"), inner, sp));
    if (form == 1) {
        CcNameList path;
        CCString bare_value = @string(`'!>;' at expression position requires an enclosing '${"@"}errhandler' in scope`, L->arena);
        CCString bare_stmt = rl_at2(L, "err with no local handler requires ", "errhandler: a bare unwrap statement forwards the error to one");
        CCSlice bare = target ? bare_value.as_slice() : bare_stmt.as_slice();
        RHandler* h = rl_pick_handler(fn, rt ? rl_ix_canon(L, rt->result_err) : (ptr ? rl_lit("CCError") : cc_slice_empty()), sp, bare, &path, inner, rt);
        CcStmt* on_err = lw_block(L, sp);
        CcExpr* err;
        if (!h) return NULL;
        if (target && !value_is_void && !h->hoisted) {
            CCString m = rl_at2(L, "errhandler body must visibly diverge when used as an expression-position '!>;' delegate", NULL);
            lw_error(L, h->span, m);
            return NULL;
        }
        err = rl_project(L, rl_r_error2(L, sp, ptr, inner), &path, sp);
        lw_push(on_err, rl_record_site(L, sp));
        if (h->hoisted) rl_push_jump(fn, on_err, h, err, sp);
        else lw_push(on_err, rl_inline_handler(fn, h, err, sp));
        lw_push(blk, lw_if(L, lw_not(L, rl_r_ok2(L, sp, ptr), sp), on_err, NULL, sp));
        if (target && !value_is_void) lw_push(blk, lw_expr_stmt(L, lw_assign(L, target, rl_r_value2(L, sp, ptr), sp), sp));
        return blk;
    }
    if (form == 2) {
        CcStmt* on_err = lw_block(L, sp);
        if (target && !value_is_void && (!body || !rl_diverges(L, body))) {
            /* the target would be left unassigned past the body */
            CCString m = @string(`expression-position '!>' body must diverge (return, goto, ${"@"}err, or a call that does not return)`, L->arena);
            lw_error(L, sp, m);
            return NULL;
        }
        if (binder.len) lw_push(on_err, lw_decl_stmt(L, rl_typeof_error2(L, sp, ptr), binder, rl_r_error2(L, sp, ptr, inner), sp));
        if (body) {
            CcNameList* bs = &fn->binders;
            size_t nb = bs->len();
            CcStmt* lowered;
            if (binder.len) bs->push(binder);
            lowered = rl_body(fn, body);
            bs->truncate(nb);
            lw_push(on_err, lowered);
        }
        lw_push(blk, lw_if(L, lw_not(L, rl_r_ok2(L, sp, ptr), sp), on_err, NULL, sp));
        if (target && !value_is_void) lw_push(blk, lw_expr_stmt(L, lw_assign(L, target, rl_r_value2(L, sp, ptr), sp), sp));
        return blk;
    }
    /* form 3: ?> fallback */
    if (!fallback) return NULL;
    if (!target || value_is_void) {
        CcStmt* on_err = lw_block(L, sp);
        if (binder.len) lw_push(on_err, lw_decl_stmt(L, rl_typeof_error2(L, sp, ptr), binder, rl_r_error2(L, sp, ptr, inner), sp));
        lw_push(on_err, lw_expr_stmt(L, lw_paren(L, fallback, sp), sp));
        lw_push(blk, lw_if(L, lw_not(L, rl_r_ok2(L, sp, ptr), sp), on_err, NULL, sp));
        return blk;
    }
    if (binder.len) {
        CcStmt* on_ok = lw_block(L, sp);
        CcStmt* on_err = lw_block(L, sp);
        lw_push(on_ok, lw_expr_stmt(L, lw_assign(L, target, rl_r_value2(L, sp, ptr), sp), sp));
        lw_push(on_err, lw_decl_stmt(L, rl_typeof_error2(L, sp, ptr), binder, rl_r_error2(L, sp, ptr, inner), sp));
        lw_push(on_err, lw_expr_stmt(L, lw_assign(L, target, lw_paren(L, fallback, sp), sp), sp));
        lw_push(blk, lw_if(L, rl_r_ok2(L, sp, ptr), on_ok, on_err, sp));
        return blk;
    }
    lw_push(blk, lw_expr_stmt(L, lw_assign(L, target,
                lw_ternary(L, rl_r_ok2(L, sp, ptr), rl_r_value2(L, sp, ptr), lw_paren(L, fallback, sp), sp), sp), sp));
    return blk;
}

/* The call an unwrap form wraps. */
static CcExpr* rl_unwrap_operand(const CcExpr* e) {
    @switch (e->k) {
        case .unwrap(u): return u.a;
        case .unwrap_body(ub): return ub.a;
        case .unwrap_or(uo): return uo.a;
        case .unwrap_destroy(ud): return ud.a;
        default: return NULL;
    }
}

static bool rl_is_unwrap(const CcExpr* e) {
    if (!e) return false;
    @switch (e->k) {
        case .unwrap: return true;
        case .unwrap_body: return true;
        case .unwrap_or: return true;
        case .unwrap_destroy: return true;
        default: return false;
    }
}

/* ---- statements ---------------------------------------------------------- */

static void rl_block(RFn* fn, CcStmt* block);
static CcStmt* rl_stmt(RFn* fn, CcStmt* s);

/* `T name = <unwrap>;` → `T name;` + scaffold. Returns false when the
 * declaration is not that shape. */
static bool rl_decl_unwrap(RFn* fn, CcStmt* s, CcDecl* d, CcStmtList* out) {
    CcLowerer* L = fn->L;
    CcVarDecl v;
    bool is_var = false;
    CcExpr* init_expr = NULL;
    CcStmt* blk;
    @switch (d->k) {
        case .var(vv): v = vv; is_var = true; break;
        default: break;
    }
    if (!is_var || !v.init) return false;
    init_expr = v.init->expr;
    if (!rl_is_unwrap(init_expr)) return false;
    {
        /* `T x = e !> @destroy [{ D }];`: the unwrap of `e`, and x is marked
         * for the cleanup step; a failed `e` never reaches the mark */
        CcExpr* plain = NULL;
        @switch (init_expr->k) {
            case .unwrap_destroy(ud): {
                CcUnwrap u;
                u.a = ud.a;
                plain = cc_arena_alloc(L->arena, sizeof(CcExpr), _Alignof(CcExpr));
                *plain = *init_expr;
                plain->k = { .unwrap = u };
                v.destroy = true;
                v.destroy_body = ud.destroy_body;
                break;
            }
            default: break;
        }
        if (plain) init_expr = plain;
    }
    blk = rl_scaffold(fn, init_expr, lw_ident(L, v.name, s->span), s->span);
    if (!blk) return true;
    v.init = NULL;
    d->k = { .var = v };
    out->push(s);
    out->push(blk);
    return true;
}

/* `<lhs> = <unwrap>;` and `<unwrap>;` as expression statements. */
static bool rl_expr_stmt_unwrap(RFn* fn, CcStmt* s, CcExpr* e, CcStmtList* out) {
    CcLowerer* L = fn->L;
    CcExpr* target = NULL;
    CcExpr* uw = NULL;
    CcStmt* blk;
    if (!e) return false;
    {
        /* `e !> @destroy { D };` with nothing to hold the value: a temporary does */
        bool is_destroy = false;
        @switch (e->k) {
            case .unwrap_destroy: is_destroy = true; break;
            default: break;
        }
        if (is_destroy) {
            CCString nm = @string(`__cc_d${CcLowerer_temp_id(L)}`, L->arena);
            CCSlice name = lw_keep(L, &nm);
            CcStmt* ds = lw_decl_stmt(L, rl_typeof(L, rl_unwrap_operand(e), s->span), name, e, s->span);
            CcDecl* dd = NULL;
            @switch (ds->k) {
                case .decl(x): dd = x.d; break;
                default: break;
            }
            return dd ? rl_decl_unwrap(fn, ds, dd, out) : false;
        }
    }
    if (rl_is_unwrap(e)) uw = e;
    else {
        @switch (e->k) {
            case .assign(a):
                if (a.op == CC_OP_ASSIGN && rl_is_unwrap(a.b)) { target = a.a; uw = a.b; }
                break;
            default: break;
        }
    }
    if (!uw) return false;
    blk = rl_scaffold(fn, uw, target, s->span);
    if (blk) out->push(blk);
    return true;
}

static void rl_stmts(RFn* fn, CcStmtList* list) {
    bool after_err_fwd = false;
    CcLowerer* L = fn->L;
    CcStmtList out = vec_new::[CcStmtRef](L->arena);
    size_t n = list->len();
    size_t i;
    size_t handlers_at_entry;
    {
        RHandlerList* hs = &fn->handlers;
        handlers_at_entry = hs->len();
    }
    fn->depth++;
    for (i = 0; i < n; i++) {
        CcStmt* s = *list->get_ptr(i);
        bool handled = false;
        CcStmt* pushed = NULL;
        size_t before = out.len();
        if (after_err_fwd) {
            CCString m = @string(`unreachable code after '${"@"}err(e);'`, L->arena);
            lw_error(L, s->span, m);
            after_err_fwd = false;
        }
        @switch (s->k) {
            case .errhandler(eh): rl_register_handler(fn, &eh, s->span); handled = true; break;
            case .decl(ds): handled = rl_decl_unwrap(fn, s, ds.d, &out); break;
            case .expr(es):
                handled = rl_expr_stmt_unwrap(fn, s, es.e, &out);
                if (!handled && L->opts.strict_unhandled && es.e && rl_result_of_call(L, es.e)) {
                    CCSlice callee = rl_call_name(es.e);
                    CCString m = @string(`unhandled-result: call to '${callee}' returns a result-typed value; consume with '?>', '!>', '${"@"}err', assign to a result-typed destination, 'return', or cast to '(void)' to explicitly discard`, L->arena);
                    lw_error(L, s->span, m);
                }
                break;
            case .unwrap(us): {
                pushed = rl_scaffold(fn, us.e, NULL, s->span);
                handled = true;
                break;
            }
            case .err_fwd(ef): {
                CcNameList path;
                RHandler* h = NULL;
                CcStmt* blk = lw_block(L, s->span);
                CCSlice nm = ef.err ? rl_ident_name(ef.err) : cc_slice_empty();
                bool bound = !nm.len;
                if (nm.len) {
                    CcNameList* bs = &fn->binders;
                    size_t nb = bs->len();
                    size_t bi;
                    for (bi = 0; bi < nb; bi++) {
                        CCSlice b = *bs->get_ptr(bi);
                        if (cc_slice_eq(&b, nm)) bound = true;
                    }
                    if (!bound) {
                        CcNameList* bsl = &fn->binders;
                        size_t nbl = bsl->len();
                        CCSlice want = nbl ? *bsl->get_ptr(nbl - 1) : rl_lit("none in scope");
                        CCString m = @string(`${"@"}err(${nm}) forward references unknown binder '${nm}' (expected '${want}')`, L->arena);
                        lw_error(L, s->span, m);
                    }
                }
                if (bound) {
                    CCString bare_fwd = rl_at2(L, "err with no local handler requires ", "errhandler");
                    CCSlice bare = bare_fwd.as_slice();
                    h = rl_pick_handler(fn, cc_slice_empty(), s->span, bare, &path, NULL, NULL);
                }
                if (!h) {
                    /* diagnosed above or by the lookup */
                } else if (!h->hoisted) {
                    CCString m = rl_at2(L, "errhandler body must visibly diverge (end with return/break/continue/goto, ", "err(e);, or a call to exit/abort/longjmp/etc.)");
                    lw_error(L, h->span, m);
                } else {
                    rl_push_jump(fn, blk, h, lw_paren(L, ef.err, s->span), s->span);
                    pushed = blk;
                }
                handled = true;
                after_err_fwd = true;
                break;
            }
            default: break;
        }
        if (pushed) out.push(pushed);
        if (!handled) {
            CcStmt* rs = rl_stmt(fn, s);
            out.push(rs);
        }
        {
            size_t after = out.len();
            size_t k;
            for (k = before; k < after; k++) {
                CcStmt* os = *out.get_ptr(k);
                rl_hoist_nested(fn, os);
            }
        }
    }
    fn->depth--;
    {
        RHandlerList* hs = &fn->handlers;
        hs->truncate(handlers_at_entry);
    }
    *list = out;
}

static void rl_block(RFn* fn, CcStmt* block) {
    CcStmtList* list = lw_block_stmts(block);
    if (list) rl_stmts(fn, list);
}

/* A single statement in body position (`if (c) x = f() !>;`) lowered as a
 * one-element list; the scaffold may replace it with several statements,
 * which then need a block. */
static CcStmt* rl_stmt_single(RFn* fn, CcStmt* s) {
    CcLowerer* L = fn->L;
    CcStmtList one = vec_new::[CcStmtRef](L->arena);
    size_t n;
    one.push(s);
    rl_stmts(fn, &one);
    n = one.len();
    if (n == 1) return *one.get_ptr(0);
    if (n == 0) return lw_block(L, s->span);
    {
        CcStmt* blk = lw_block(L, s->span);
        size_t i;
        for (i = 0; i < n; i++) lw_push(blk, *one.get_ptr(i));
        return blk;
    }
}

/* Lower the statements nested in `s`. Called from `rl_stmts` for statements
 * it did not handle itself, so a simple statement (decl / expr / unwrap) is
 * returned as-is: its own unwraps were already the list's business. */
static CcStmt* rl_body(RFn* fn, CcStmt* s);
static CcStmt* rl_stmt(RFn* fn, CcStmt* s) {
    if (!s) return s;
    @switch (s->k) {
        case .block: rl_block(fn, s); break;
        case .if_: s->k.if_.then = rl_body(fn, s->k.if_.then); s->k.if_.els = rl_body(fn, s->k.if_.els); break;
        case .while_: s->k.while_.body = rl_body(fn, s->k.while_.body); break;
        case .do_: s->k.do_.body = rl_body(fn, s->k.do_.body); break;
        case .for_: s->k.for_.body = rl_body(fn, s->k.for_.body); break;
        case .switch_: s->k.switch_.body = rl_body(fn, s->k.switch_.body); break;
        case .case_: s->k.case_.inner = rl_body(fn, s->k.case_.inner); break;
        case .label: s->k.label.inner = rl_body(fn, s->k.label.inner); break;
        default: break;
    }
    return s;
}

/* A statement in body position (`if (c) x = f() !>;`): a simple statement
 * there may carry an unwrap, so it goes through the list machinery as a
 * one-element list; anything else only has nested statements to lower. */
static CcStmt* rl_body(RFn* fn, CcStmt* s) {
    bool single = false;
    if (!s) return s;
    @switch (s->k) {
        case .decl: single = true; break;
        case .expr: single = true; break;
        case .unwrap: single = true; break;
        case .err_fwd: single = true; break;
        default: break;
    }
    if (single) return rl_stmt_single(fn, s);
    return rl_stmt(fn, s);
}

/* ---- unwraps in expression position ---------------------------------------- */

/* `f() !>`, `f() !> (e) { diverge }` and `f() ?> v` inside an expression
 * become a statement expression, `({ __typeof__(f()) __r = f(); ...;
 * __r.u.value; })`, so the call is evaluated where it stands (arguments,
 * conditions, loop tests). The node is rewritten in place; the original
 * unwrap lives on in a copy the scaffold reads. */
static bool rl_scaffold_expr(RFn* fn, CcExpr* e) {
    CcLowerer* L = fn->L;
    CcSpan sp = e->span;
    CcExpr* uw = cc_arena_alloc(L->arena, sizeof(CcExpr), _Alignof(CcExpr));
    CcExpr* inner = NULL;
    CCSlice binder = cc_slice_empty();
    CcStmt* body = NULL;
    CcExpr* fallback = NULL;
    int form = 0;
    CcStmt* blk;
    CcTypeInfo* rt;
    bool value_is_void = false;
    bool ptr = false;   /* the null unwrap: a pointer call, NULL is the error */
    CcStmtExpr se;
    *uw = *e;
    @switch (uw->k) {
        case .unwrap(u): inner = u.a; form = 1; break;
        case .unwrap_body(ub): inner = ub.a; binder = ub.binder; body = ub.body; form = 2; break;
        case .unwrap_or(uo): inner = uo.a; binder = uo.binder; fallback = uo.fallback; form = 3; break;
        case .unwrap_destroy: {
            CCString m = @string(`'!> @destroy' is not lowered by the clean lowerer yet`, L->arena);
            lw_error(L, sp, m);
            return false;
        }
        default: return false;
    }
    if (!inner) return false;
    rt = rl_result_of_call(L, inner);
    {
        int mode = rl_unwrap_mode(L, inner, rt, sp);
        if (!mode) return false;
        ptr = mode == 2;
    }
    if (rt && rt->result_value) value_is_void = CcType_is_void(rt->result_value);
    L->unwraps_used = true;
    blk = lw_block(L, sp);
    lw_push(blk, lw_decl_stmt(L, rl_typeof(L, inner, sp), rl_lit("__r"), inner, sp));
    if (form == 1) {
        CcNameList path;
        CCString bare_value = @string(`'!>;' at expression position requires an enclosing '${"@"}errhandler' in scope`, L->arena);
        CCSlice bare = bare_value.as_slice();
        RHandler* h = rl_pick_handler(fn, rt ? rl_ix_canon(L, rt->result_err) : (ptr ? rl_lit("CCError") : cc_slice_empty()), sp, bare, &path, inner, rt);
        CcStmt* on_err = lw_block(L, sp);
        CcExpr* err;
        if (!h) return false;
        if (!value_is_void && !h->hoisted) {
            CCString m = rl_at2(L, "errhandler body must visibly diverge when used as an expression-position '!>;' delegate", NULL);
            lw_error(L, h->span, m);
            return false;
        }
        err = rl_project(L, rl_r_error2(L, sp, ptr, inner), &path, sp);
        lw_push(on_err, rl_record_site(L, sp));
        if (h->hoisted) rl_push_jump(fn, on_err, h, err, sp);
        else lw_push(on_err, rl_inline_handler(fn, h, err, sp));
        lw_push(blk, lw_if(L, lw_not(L, rl_r_ok2(L, sp, ptr), sp), on_err, NULL, sp));
    } else if (form == 2) {
        CcStmt* on_err = lw_block(L, sp);
        if (!body || !rl_diverges(L, body)) {
            CCString m = @string(`expression-position '!>' body must diverge (return, goto, ${"@"}err, or a call that does not return)`, L->arena);
            lw_error(L, sp, m);
            return false;
        }
        if (binder.len) lw_push(on_err, lw_decl_stmt(L, rl_typeof_error2(L, sp, ptr), binder, rl_r_error2(L, sp, ptr, inner), sp));
        {
            CcNameList* bs = &fn->binders;
            size_t nb = bs->len();
            CcStmt* lowered;
            if (binder.len) bs->push(binder);
            lowered = rl_body(fn, body);
            bs->truncate(nb);
            lw_push(on_err, lowered);
        }
        lw_push(blk, lw_if(L, lw_not(L, rl_r_ok2(L, sp, ptr), sp), on_err, NULL, sp));
    } else {
        if (!fallback) return false;
        if (value_is_void) {
            CcStmt* on_err = lw_block(L, sp);
            if (binder.len) lw_push(on_err, lw_decl_stmt(L, rl_typeof_error2(L, sp, ptr), binder, rl_r_error2(L, sp, ptr, inner), sp));
            lw_push(on_err, lw_expr_stmt(L, lw_paren(L, fallback, sp), sp));
            lw_push(blk, lw_if(L, lw_not(L, rl_r_ok2(L, sp, ptr), sp), on_err, NULL, sp));
        } else if (binder.len) {
            /* __typeof__(__r.u.value) __v; if (__r.ok) __v = __r.u.value; else { E e = __r.u.error; __v = (fallback); } __v; */
            CcStmt* on_ok = lw_block(L, sp);
            CcStmt* on_err = lw_block(L, sp);
            lw_push(blk, lw_decl_stmt(L, rl_typeof(L, rl_r_value2(L, sp, ptr), sp), rl_lit("__v"), NULL, sp));
            lw_push(on_ok, lw_expr_stmt(L, lw_assign(L, lw_ident(L, rl_lit("__v"), sp), rl_r_value2(L, sp, ptr), sp), sp));
            lw_push(on_err, lw_decl_stmt(L, rl_typeof_error2(L, sp, ptr), binder, rl_r_error2(L, sp, ptr, inner), sp));
            lw_push(on_err, lw_expr_stmt(L, lw_assign(L, lw_ident(L, rl_lit("__v"), sp), lw_paren(L, fallback, sp), sp), sp));
            lw_push(blk, lw_if(L, rl_r_ok2(L, sp, ptr), on_ok, on_err, sp));
            lw_push(blk, lw_expr_stmt(L, lw_ident(L, rl_lit("__v"), sp), sp));
            se.block = blk;
            e->k = { .stmt_expr = se };
            return true;
        } else {
            lw_push(blk, lw_expr_stmt(L, lw_ternary(L, rl_r_ok2(L, sp, ptr), rl_r_value2(L, sp, ptr), lw_paren(L, fallback, sp), sp), sp));
            se.block = blk;
            e->k = { .stmt_expr = se };
            return true;
        }
    }
    if (!value_is_void) lw_push(blk, lw_expr_stmt(L, rl_r_value2(L, sp, ptr), sp));
    se.block = blk;
    e->k = { .stmt_expr = se };
    return true;
}

static bool rl_nested_visit(CcExpr* e, void* env) {
    RFn* fn = (RFn*)env;
    if (!rl_is_unwrap(e)) return true;
    if (!rl_scaffold_expr(fn, e)) return false;
    return true;   /* into the scaffold: unwraps nested in the call itself */
}

/* Every unwrap left in the expressions of `s` (its own and, harmlessly
 * again, those of statements nested in it, which their own list lowered
 * already) becomes a statement expression under the handlers in scope. */
static void rl_hoist_nested(RFn* fn, CcStmt* s) {
    CcVisitor v;
    memset(&v, 0, sizeof(v));
    v.expr = rl_nested_visit;
    v.env = fn;
    CcStmt_walk(s, v);
}

/* Any unwrap left inside an expression is a diagnostic. */
static bool rl_leftover_visit(CcExpr* e, void* env) {
    RFn* fn = (RFn*)env;
    if (rl_is_unwrap(e)) {
        CCString m = @string(`'!>' inside an expression is not lowered by the clean lowerer yet; bind it to a local first`, fn->L->arena);
        lw_error(fn->L, e->span, m);
        fn->nested_unwrap = true;
        return false;
    }
    return true;
}

static void rl_function(CcLowerer* L, CcDecl* d, CcFuncDecl* f) {
    RFn fn;
    CcVisitor v;
    CcStmtList* body_stmts;
    if (!f->body) return;
    memset(&fn, 0, sizeof(fn));
    fn.L = L;
    fn.fn = d;
    fn.ret = rl_ret_result(L, f->type);
    fn.handlers = vec_new::[RHandlerRef](L->arena);
    fn.hoisted = vec_new::[RHandlerRef](L->arena);
    fn.binders = vec_new::[CCSlice](L->arena);
    /* 1. cc_ok / cc_err */
    memset(&v, 0, sizeof(v));
    v.expr = rl_ctor_visit;
    v.env = &fn;
    CcStmt_walk(f->body, v);
    /* 2. the unwrap forms and handlers */
    rl_block(&fn, f->body);
    /* 3. hoisted handlers: cells at the top, labels at the tail */
    body_stmts = lw_block_stmts(f->body);
    if (!body_stmts) return;
    {
        RHandlerList* ho = &fn.hoisted;
        size_t n = ho->len();
        size_t i;
        if (n) {
            CcStmtList with_cells = vec_new::[CcStmtRef](L->arena);
            size_t k;
            size_t m = body_stmts->len();
            for (i = 0; i < n; i++) {
                RHandler* h = *ho->get_ptr(i);
                with_cells.push(lw_decl_stmt(L, h->err_type, rl_cell_name(L, h->id), NULL, d->span));
            }
            for (k = 0; k < m; k++) {
                CcStmt* bs = *body_stmts->get_ptr(k);
                with_cells.push(bs);
            }
            {
                /* a void function falling off its end must not run the handlers */
                CcStmt* last = m ? *body_stmts->get_ptr(m - 1) : NULL;
                bool is_void = fn.ret == NULL;
                if (is_void) {
                    CcType* rt = NULL;
                    @switch (f->type->k) {
                        case .func(ft): rt = ft.ret; break;
                        default: break;
                    }
                    is_void = rt && CcType_is_void(rt);
                }
                if (is_void && (!last || !rl_diverges(L, last)))
                    with_cells.push(cc_stmt_return(NULL, d->span, L->arena));
            }
            for (i = 0; i < n; i++) {
                RHandler* h = *ho->get_ptr(i);
                CcSpan hs = h->body ? h->body->span : d->span;
                with_cells.push(lw_label(L, rl_label_name(L, h->id), NULL, hs));
                with_cells.push(rl_inline_handler(&fn, h, lw_ident(L, rl_cell_name(L, h->id), hs), hs));
            }
            *body_stmts = with_cells;
        }
    }
    /* 4. nothing left in expression position */
    memset(&v, 0, sizeof(v));
    v.expr = rl_leftover_visit;
    v.env = &fn;
    CcStmt_walk(f->body, v);
}

/* ---- types --------------------------------------------------------------- */

typedef struct RTypeEnv { CcLowerer* L; CcVisitor* self; } RTypeEnv;

static bool rl_type_visit(CcType* t, void* env) {
    RTypeEnv* te = (RTypeEnv*)env;
    CcType* value = NULL;
    CcType* err = NULL;
    bool optional = false;
    bool is_result = false;
    @switch (t->k) {
        case .result(r): value = r.value; err = r.err; optional = r.optional; is_result = true; break;
        default: break;
    }
    if (!is_result) return true;
    /* a Result of a Result: the inner one first */
    walk_type(te->self, value);
    walk_type(te->self, err);
    {
        CcTypeInfo* ti = rl_ix_result(te->L, value, err, optional);
        CcNamedType nm;
        nm.name = ti->name;
        nm.struct_kw = false;
        nm.union_kw = false;
        nm.enum_kw = false;
        t->k = { .named = nm };
    }
    return false;
}

/* The C spelling of a spec argument: a C type as written, a Concurrent-C
 * type by its canonical name (`CCSlice` for `char[:]`). */
static CCString rl_spec_arg(CcLowerer* L, CcType* t) {
    bool plain = false;
    @switch (t->k) {
        case .named: plain = true; break;
        case .pointer: plain = true; break;
        case .func: plain = true; break;
        case .array: plain = true; break;
        default: break;
    }
    if (plain) return CcType_spell(t, cc_slice_empty(), &L->unit->tape, L->arena);
    {
        CCSlice c = rl_ix_canon(L, t);
        CCString s = cc_string_new();
        cc_string_push_slice(&s, c, L->arena);
        return s;
    }
}

/* The text of token `tok` (past the end: the EOF token). */
static CCSlice tp_text_of(CcLowerer* L, uint32_t tok) {
    CcTape* tp = &L->unit->tape;
    const CcToken* tk = tp->at(tok);
    return tk->text;
}

static bool cc_slice_find_cstr(CCSlice hay, const char* needle) {
    size_t n = strlen(needle);
    size_t i;
    if (hay.len < n) return false;
    for (i = 0; i + n <= hay.len; i++)
        if (memcmp(hay.ptr + i, needle, n) == 0) return true;
    return false;
}

/* The innermost named type of `t` (through pointers, arrays, `_Atomic`);
 * empty for anything else. */
static CCSlice rl_type_base_name(const CcType* t) {
    while (t) {
        const CcType* next = NULL;
        @switch (t->k) {
            case .named(n): return n.name;
            case .pointer(pt): next = pt.pointee; break;
            case .array(ar): next = ar.elem; break;
            case .atomic(at): next = at.pointee; break;
            default: return cc_slice_empty();
        }
        t = next;
    }
    return cc_slice_empty();
}

/* The index in this unit's declarations of the one defining type `name`;
 * SIZE_MAX when it is not defined at file scope here (a header, a builtin,
 * a local type, or unknown). */
static size_t rl_defining_decl(CcLowerer* L, CCSlice name) {
    CcSym* s = rl_ix_sym(L, name);
    CcDeclList* decls = &L->unit->decls;
    size_t n = decls->len();
    size_t k;
    while (s && s->kind != CC_SYM_TYPE) s = s->same_name;
    if (!s || s->unit != L->unit || !s->decl) return SIZE_MAX;
    for (k = 0; k < n; k++) {
        CcDecl* d = *decls->get_ptr(k);
        if (d == s->decl) return k;
    }
    return SIZE_MAX;
}

/* Where a spec goes: before the declaration at the returned index. After
 * the leading includes (`inc_at`), or after the latest file-scope definition
 * of a type it spells. */
static size_t rl_spec_anchor(CcLowerer* L, CcTypeInfo* ti, size_t inc_at) {
    size_t at = inc_at;
    CCSlice vn = rl_type_base_name(ti->result_value);
    CCSlice en = rl_type_base_name(ti->result_err);
    size_t dv = vn.len ? rl_defining_decl(L, vn) : SIZE_MAX;
    size_t de = en.len ? rl_defining_decl(L, en) : SIZE_MAX;
    if (dv != SIZE_MAX && dv + 1 > at) at = dv + 1;
    if (de != SIZE_MAX && de + 1 > at) at = de + 1;
    return at;
}

/* One spec's guarded declaration lines. */
static void rl_spec_text(CcLowerer* L, CcTypeInfo* ti, CCString* text) {
    bool void_value = CcType_is_void(ti->result_value);
    CCString value = rl_spec_arg(L, ti->result_value);
    CCString err = rl_spec_arg(L, ti->result_err);
    {
        CCString block = @string(`#ifndef ${ti->name}_DEFINED
#define ${ti->name}_DEFINED 1
#ifdef CC_DECL_RESULT_SPEC
`, L->arena);
        cc_string_push_slice(text, block.as_slice(), L->arena);
    }
    if (void_value) {
        CCString line = @string(`CC_DECL_RESULT_SPEC_VOID${"("}${ti->name}, ${err}${")"}
`, L->arena);
        cc_string_push_slice(text, line.as_slice(), L->arena);
    } else {
        CCString line = @string(`CC_DECL_RESULT_SPEC${"("}${ti->name}, ${value}, ${err}${")"}
`, L->arena);
        cc_string_push_slice(text, line.as_slice(), L->arena);
    }
    cc_string_push_cstr(text, "#else\n#error \"Result types need <ccc/cc_result.cch> (or the prelude)\"\n#endif\n#endif\n", L->arena);
}

/* Every Result type this unit uses that no header declared gets its spec:
 * after the leading includes, or after the file-scope definition of a type
 * it spells; `<ccc/cc_result.h>` is included once when the unit did not. */
static void rl_emit_specs(CcLowerer* L) {
    CcIndex* ix = rl_ix(L);
    RSpecList* specs = &ix->result_specs;
    size_t n = specs->len();
    size_t i;
    CcDeclList* decls = &L->unit->decls;
    size_t nd = decls->len();
    size_t inc_at = 0;
    bool has_result_hdr = false;
    size_t* anchor;
    size_t n_own = 0;
    for (i = 0; i < n; i++) {
        CcTypeInfo* ti = *specs->get_ptr(i);
        if (ti->is_result && !ti->result_from_header && ti->result_value && ti->result_err) n_own++;
    }
    if (!n_own && !L->unwraps_used) return;
    /* the leading includes */
    {
        size_t k;
        for (k = 0; k < nd; k++) {
            CcDecl* dd = *decls->get_ptr(k);
            bool is_pp = false;
            bool is_include = false;
            uint32_t tok = 0;
            CCSlice raw_text = cc_slice_empty();
            @switch (dd->k) {
                case .pp(pd): is_pp = true; tok = pd.tok; break;
                case .empty: is_pp = true; break;
                case .pragma_cc: is_pp = true; break;
                case .raw(rt): is_pp = true; raw_text = rt; break;   /* a rewritten `#include <rel.h>` */
                default: break;
            }
            if (!is_pp) break;
            {
                CCSlice tt = raw_text.len ? raw_text : tp_text_of(L, tok);
                if (tt.len > 8 && memcmp(tt.ptr, "#include", 8) == 0) is_include = true;
                if (is_include) {
                    inc_at = k + 1;
                    if (cc_slice_find_cstr(tt, "cc_result") || cc_slice_find_cstr(tt, "cc_runtime") || cc_slice_find_cstr(tt, "prelude"))
                        has_result_hdr = true;
                }
            }
        }
    }
    anchor = cc_arena_alloc(L->arena, (n ? n : 1) * sizeof(size_t), _Alignof(size_t));
    for (i = 0; i < n; i++) {
        CcTypeInfo* ti = *specs->get_ptr(i);
        anchor[i] = SIZE_MAX;
        if (!ti->is_result || ti->result_from_header) continue;
        if (!ti->result_value || !ti->result_err) continue;
        anchor[i] = rl_spec_anchor(L, ti, inc_at);
    }
    {
        CcDeclList with = vec_new::[CcDeclRef](L->arena);
        size_t k;
        for (k = 0; k <= nd; k++) {
            CCString text = cc_string_new();
            bool any = false;
            CcSpan sp;
            sp.first = 0;
            sp.last = 0;
            if (k < nd) {
                CcDecl* dk = *decls->get_ptr(k);
                sp = dk->span;
            } else if (nd) {
                CcDecl* dl = *decls->get_ptr(nd - 1);
                sp = dl->span;
            }
            if (k == inc_at && !has_result_hdr)
                cc_string_push_cstr(&text, "#include <ccc/cc_result.h>\n\n", L->arena);
            for (i = 0; i < n; i++) {
                CcTypeInfo* ti;
                if (anchor[i] != k) continue;
                ti = *specs->get_ptr(i);
                if (!any) cc_string_push_cstr(&text, "#line 1 \"<cc:result-specs>\"\n", L->arena);
                any = true;
                rl_spec_text(L, ti, &text);
            }
            if (cc_string_len(&text)) {
                CcDecl* raw = lw_raw_decl(L, text, sp);
                with.push(raw);
            }
            if (k < nd) {
                CcDecl* dk = *decls->get_ptr(k);
                with.push(dk);
            }
        }
        *decls = with;
    }
}

/* ---- the step ------------------------------------------------------------ */

static void CcLowerer_results(CcLowerer* L) {
    CcDeclList* decls = &L->unit->decls;
    size_t n = decls->len();
    size_t i;
    for (i = 0; i < n; i++) {
        CcDecl* d = *decls->get_ptr(i);
        @switch (d->k) {
            case .func(f): rl_function(L, d, &f); break;
            default: break;
        }
    }
    {
        CcVisitor v;
        RTypeEnv te;
        memset(&v, 0, sizeof(v));
        te.L = L;
        te.self = &v;
        v.type = rl_type_visit;
        v.env = &te;
        CcUnit_walk(L->unit, v);
    }
    rl_emit_specs(L);
}

#endif

#pragma(@per_tu)
/* Clean lowerer, step: UFCS. `x.m(args)` and `p->m(args)` become the call
 * the index resolves for the receiver's type, `callee(<recv>, args)`, with
 * the receiver passed to fit the callee's first parameter: by address when
 * the callee takes a pointer and the receiver is a value, itself when both
 * agree, dereferenced when the callee takes a value and the receiver is a
 * pointer. `Type.fn(args)` is the declared `Type_fn(args)`. What the
 * index cannot type or resolve is a diagnostic at the site carrying its
 * resolution ladder; nothing is guessed. Lifetime: the lowerer arena. */
#ifndef CC_LOWER_UFCS_CCH
#define CC_LOWER_UFCS_CCH
#include "lower.cch"
#include "comptime.cch"
#include "typing.cch"
#include <ccc/cc_ufcs_families.h>

static int cl_destroy_chain(CcLowerer* L, CCSlice canon, CcExpr* subject, CcStmt* into, CcSpan sp, int depth);

typedef struct UStep {
    CcLowerer* L;
    int n_sites;
    CcExprList formal_at;       /* a `.method` site a declaration types */
    CcTypeList formal_ty;       /* what that declaration declared, by the same index */
} UStep;

/* Is the receiver itself a pointer? Its own shape decides, so aliases are
 * followed but nothing is peeled: peeling a pointer away first would make
 * every receiver a value. */
static bool uf_type_is_pointer(Walker* w, CcType* rt) {
    UStep* st = (UStep*)w->env;
    CcLowerer* L = st->L;
    CcIndex* ix = w->ix;
    CcType* t = rt;
    int depth = 0;
    while (t && depth++ < 8) {
        CcType* a;
        CCSlice cn;
        CcSym* sym;
        if (t->k.kind == CcTypeK_pointer || t->k.kind == CcTypeK_array) return true;
        a = unalias_local(w, t);
        if (a && a != t) { t = a; continue; }
        cn = ix->canon(t);
        if (!cn.len) return false;
        if (cn.ptr[cn.len - 1] == '*') return true;
        /* a generic instance whose factory hands back a pointer is spelled as
         * one, in this unit and in every header that names it */
        if (gn_instance_is_pointer(L, cn)) return true;
        sym = sym_any(ix, cn);
        if (!sym || sym->kind != CC_SYM_TYPE || !sym->type || sym->type == t) return false;
        t = sym->type;
    }
    return false;
}

/* A receiver that is not a simple name is parenthesized before `&` / `*`. */
static CcExpr* uf_wrap(CcLowerer* L, CcExpr* recv, CcSpan sp) {
    bool simple = false;
    @switch (recv->k) {
        case .ident: simple = true; break;
        case .member: simple = true; break;
        case .index: simple = true; break;
        case .call: simple = true; break;
        case .paren: simple = true; break;
        default: break;
    }
    return simple ? recv : lw_paren(L, recv, sp);
}

/* An expression with an address: a name, a member, an element, a
 * dereference, or one of those in parentheses. */
static bool uf_is_lvalue(const CcExpr* e) {
    if (!e) return false;
    @switch (e->k) {
        case .ident: return true;
        case .member: return true;
        case .index: return true;
        case .paren(pa): return uf_is_lvalue(pa.a);
        case .unary(un): return un.op == CC_OP_DEREF;
        default: return false;
    }
}

/* The canonical spelling of a receiver's type, through local aliases. */
static CCSlice ix_canon_of(Walker* w, CcType* rt) {
    CcType* t = peel(unalias_local(w, peel(rt)));
    CcIndex* ix = w->ix;
    return ix->canon(t ? t : rt);
}

/* `(T[1]){ e }`: an rvalue given an address.
 *
 * Not `&(T){ e }` — a brace-enclosed initializer for a struct initializes
 * its FIRST MEMBER from `e`, so a `T` value there is a type error and a
 * `T` whose first member happens to accept it is silently the wrong
 * object. An array of one is initialized element-wise, so `e` initializes
 * the whole `T`, and the literal decays to the `T*` the callee wants. */
static CcExpr* uf_compound(CcLowerer* L, CcType* t, CcExpr* e, CcSpan sp) {
    CcExpr* r = cc__expr_blank(sp, L->arena);
    CcCompound cl;
    CcInit* in = cc_arena_alloc(L->arena, sizeof(CcInit), _Alignof(CcInit));
    CcInit* item = cc_arena_alloc(L->arena, sizeof(CcInit), _Alignof(CcInit));
    memset(in, 0, sizeof(*in));
    memset(item, 0, sizeof(*item));
    item->span = sp;
    item->designators = vec_new::[CcDesignator](L->arena);
    item->items = vec_new::[CcInitRef](L->arena);
    item->expr = e;
    in->span = sp;
    in->designators = vec_new::[CcDesignator](L->arena);
    in->items = vec_new::[CcInitRef](L->arena);
    in->items.push(item);
    in->is_list = true;
    {
        CcType* arr = cc__type_blank(sp, L->arena);
        CcArrayType at;
        at.elem = t;
        at.size = lw_text(L, @string(`1`, L->arena), sp);
        at.is_static = false;
        at.is_star = false;
        arr->k = { .array = at };
        cl.type = arr;
    }
    cl.init = in;
    r->k = { .compound = cl };
    return r;
}

/* A char pointer is the one receiver a `.` reaches through: `"s".len()`,
 * `buf.copy(...)` on a `char*`, where the pointer is the value. */
static bool uf_char_pointer(Walker* w, CcType* rt) {
    CcType* t = peel(unalias_local(w, peel(rt)));
    CCSlice nm;
    if (!t || !type_named_name(t, &nm)) return false;
    return slice_eq(nm, cstr_slice("char")) || slice_eq(nm, cstr_slice("unsigned char")) ||
           slice_eq(nm, cstr_slice("signed char")) || slice_eq(nm, cstr_slice("void"));
}

/* A pointer to a type the program never defines is a handle: there are no
 * fields to reach through it, so `.` and `->` name the same thing and `.`
 * is the one that reads. `CCChan*` is the runtime's channel, not a struct
 * the user opens. A pointer to a struct with fields is not: there `.` and
 * `->` differ, and writing the wrong one means the wrong thing. */
static bool uf_opaque_pointer(Walker* w, CcLowerer* L, CcType* rt) {
    CcType* t = peel(unalias_local(w, peel(rt)));
    CcIndex* ix = L->ix;
    CcTypeInfo* info;
    CCSlice nm;
    CcSym* sym;
    if (!t) return false;
    nm = cc__strip_tag(ix->canon(t));
    if (!nm.len || nm.ptr[nm.len - 1] == '*') return false;
    info = ix->type_get(nm);
    if (info && info->sym) return !info->sym->is_definition;
    sym = sym_any(ix, nm);
    while (sym && sym->kind != CC_SYM_TYPE) sym = sym->same_name;
    return sym != NULL && !sym->is_definition;
}

/* The operator follows the receiver: a pointer takes `->`, a value takes `.`.
 * Writing the other one is a diagnostic, not a silent coercion. */
static bool uf_operator_matches(Walker* w, CcLowerer* L, CcExpr* e, CcUfcs uf, CcType* rt, CCSlice tn) {
    bool is_ptr = uf_type_is_pointer(w, rt);
    CcSpan sp = e->span;
    if (is_ptr == uf.arrow) return true;
    if (uf_char_pointer(w, rt)) return true;
    if (is_ptr && !uf.arrow && uf_opaque_pointer(w, L, rt)) return true;
    if (is_ptr) {
        CCString msg = @string(`type: UFCS on pointer type '${tn}' uses '->', not '.'`, L->arena);
        lw_error(L, sp, msg);
    } else {
        CCString msg = @string(`type: UFCS on value type '${tn}' uses '.', not '->'`, L->arena);
        lw_error(L, sp, msg);
    }
    return false;
}

/* The receiver the callee actually takes: the written receiver projected
 * through the `as:` faces the resolution walked (`w` -> `w.file`). */
static CcExpr* uf_project_faces(CcLowerer* L, CcExpr* recv, CCSlice path, bool arrow, CcSpan sp) {
    size_t i = 0;
    bool first = true;
    if (!path.len) return recv;
    while (i < path.len) {
        size_t start = i;
        CCSlice step;
        while (i < path.len && path.ptr[i] != '.') i++;
        step = cc_slice_from_buffer((char*)path.ptr + start, i - start);
        if (i < path.len) i++;
        if (!step.len) continue;
        recv = cc_expr_member(first ? uf_wrap(L, recv, sp) : recv, step, first && arrow, sp, L->arena);
        first = false;
    }
    return recv;
}

/* How many parameters a declared function takes, or -1 when the index
 * cannot read the declaration. */
/* The declared type of parameter `at` of `callee`, or NULL when the callee
 * declares none this call can read -- a function-like macro has no parameter
 * types, and an unprototyped declaration has no parameters at all. */
static CcType* uf_param_type(CcIndex* ix, CCSlice callee, size_t at) {
    CcSym* sym = sym_any(ix, callee);
    while (sym && sym->kind != CC_SYM_FUNC) sym = sym->same_name;
    if (!sym || !sym->type) return NULL;
    @switch (sym->type->k) {
        case .func(ft): {
            CcParamList ps = ft.params;
            if (!ft.has_prototype || at >= ps.len()) return NULL;
            return ps.get_ptr(at)->type;
        }
        default: return NULL;
    }
}

/* An argument of type `T` at a parameter of type `T*`: the call passes its
 * address, the way a value receiver reaches a pointer-style callee. The
 * pointee is exactly the argument's type -- `const` is the only qualifier
 * this adds, a `void*` parameter is never reached this way, and an argument
 * that is already a pointer is passed as written. */
static CcExpr* uf_arg_addr(Walker* w, CcLowerer* L, CCSlice callee, size_t at, CcExpr* a) {
    CcIndex* ix = w->ix;
    CcType* want = uf_param_type(ix, callee, at);
    CcType* have;
    CcType* pointee = NULL;
    if (!want || !a) return NULL;
    if (want->k.kind != CcTypeK_pointer) return NULL;
    @switch (want->k) {
        case .pointer(pt): pointee = pt.pointee; break;
        default: break;
    }
    if (!pointee || CcType_is_void(pointee)) return NULL;
    if (!uf_is_lvalue(a)) return NULL;
    have = type_of_expr(w, a);
    if (!have || have->k.kind == CcTypeK_pointer) return NULL;
    if (!slice_eq(ix->canon(have), ix->canon(pointee))) return NULL;
    return cc_expr_unary(CC_OP_ADDR, lw_paren(L, a, a->span), a->span, L->arena);
}

static CCSlice uf_ident_name_or_empty(CcExpr* e) {
    CCSlice nm;
    if (e && expr_ident(strip_parens_expr(e), &nm)) return nm;
    return cc_slice_empty();
}

static int uf_param_count(CcIndex* ix, CCSlice callee) {
    CcSym* sym = sym_any(ix, callee);
    while (sym && sym->kind != CC_SYM_FUNC) sym = sym->same_name;
    if (!sym || !sym->type) return -1;
    @switch (sym->type->k) {
        case .func(ft): {
            CcParamList ps = ft.params;
            return (int)ps.len();
        }
        default: return -1;
    }
}

/* A candidate whose parameters cannot take this call is not the method.
 * The declared set may hold one named for the argument it does take:
 * the resolved name, then the argument's type in the same snake spelling
 * the index composes method names with, without its `cc_` prefix. So a
 * `CCClosure0` argument reaches `..._closure0`. */
static CCSlice uf_overload_for_args(Walker* w, CcLowerer* L, CcUfcs uf, CcMethod* m) {
    CcIndex* ix = w->ix;
    int want = 1 + (int)uf.args.len();
    int have = uf_param_count(ix, m->callee);
    CcExprList* av = &uf.args;
    size_t n = av->len();
    size_t i;
    if (have < 0 || have == want) return m->callee;
    for (i = 0; i < n; i++) {
        CcExpr* a = *av->get_ptr(i);
        CcType* at = type_of_expr(w, a);
        CCSlice snake;
        CCSlice bare;
        if (!at) continue;
        snake = ix->snake(ix->canon(at));
        bare = snake;
        if (bare.len > 3 && memcmp(bare.ptr, "cc_", 3) == 0)
            bare = cc_slice_from_buffer((char*)bare.ptr + 3, bare.len - 3);
        if (!bare.len) continue;
        {
            CCSlice base = m->callee;
            CCString cand = @string(`${base}_${bare}`, L->arena);
            CCSlice name = lw_keep(L, &cand);
            if (uf_param_count(ix, name) == want) return name;
        }
    }
    return m->callee;
}

/* Whether the receiver goes in as `&recv`.
 *
 * A declared function says so in its first parameter, and the index reads
 * it. A function-like macro has no parameters to read, and where a macro
 * and a function share a name the macro is what the host compiler sees.
 * What the macro does with its first argument answers it: one that hands
 * it straight to the call it expands to wants what that call wants — an
 * address; one that converts it first (`CC__ARENA_HOST(a)`) wants the
 * value, and `CC__ARENA_HOST(&a)` is a pointer no association in it
 * matches. */
static CcMacroDef* uf_macro_of(CcIndex* ix, CCSlice name) {
    CcSym* sym = sym_any(ix, name);
    while (sym) {
        if (sym->kind == CC_SYM_MACRO && sym->macro) return sym->macro;
        sym = sym->same_name;
    }
    return NULL;
}

/* The `)` that closes the `(` at i, or the length when it is unbalanced. */
static size_t uf_close_paren(CCSlice s, size_t i) {
    int depth = 0;
    for (; i < s.len; i++) {
        if (s.ptr[i] == '(') depth++;
        else if (s.ptr[i] == ')') { depth--; if (!depth) return i; }
    }
    return s.len;
}

static bool uf_macro_passes_recv(CcMacroDef* md, size_t recv_at) {
    CCSlice body = md->body;
    CcNameList* ps = &md->params;
    CCSlice p0;
    size_t open = 0;
    size_t i;
    size_t start;
    size_t end;
    int depth = 0;
    bool have = false;
    if (!md->function_like || ps->len() <= recv_at) return true;
    p0 = *ps->get_ptr(recv_at);
    /* the argument list of the call the body expands to: the last group
     * that opens at the body's own depth */
    for (i = 0; i < body.len; i++) {
        char c = body.ptr[i];
        if (c == '(') { if (depth == 0) { open = i; have = true; } depth++; }
        else if (c == ')') { if (depth) depth--; }
    }
    if (!have) return true;
    start = open + 1;
    end = body.len;
    depth = 0;
    for (i = start; i < body.len; i++) {
        char c = body.ptr[i];
        if (c == '(' || c == '[') depth++;
        else if (c == ')' || c == ']') { if (!depth) { end = i; break; } depth--; }
        else if (c == ',' && !depth) { end = i; break; }
    }
    for (;;) {
        if (start >= end) return false;
        if (body.ptr[start] == ' ' || body.ptr[start] == '\t') { start++; continue; }
        if (body.ptr[end - 1] == ' ' || body.ptr[end - 1] == '\t') { end--; continue; }
        if (body.ptr[start] == '(' &&
            uf_close_paren(cc_slice_from_buffer((char*)body.ptr, end), start) == end - 1) {
            start++;
            end--;
            continue;
        }
        break;
    }
    return slice_eq(cc_slice_from_buffer((char*)body.ptr + start, end - start), p0);
}

/* `ntargs` is how many type arguments the site wrote: a method that takes a
 * type takes it as the macro's leading parameter, so the receiver is that
 * many parameters along. */
static bool uf_recv_by_ptr(CcLowerer* L, CcMethod* m, size_t ntargs) {
    CcMacroDef* md;
    if (!m->recv_by_ptr) return false;
    md = uf_macro_of(L->ix, m->callee);
    if (md) return uf_macro_passes_recv(md, ntargs);
    return true;
}

/* ---- a `.ufcs` handler that decides from the call site ------------------ */

/* The handler's own translation unit: the prelude it is written against,
 * the type declarations of the file that declared it, and the handler.
 *
 * Not the whole file. A handler is compiled to be called, so its unit has
 * to hold what the handler names and nothing else — handing over the file
 * it came from declares that file's types twice, once from the prelude
 * extraction and once from the file, and the compile fails on the second.
 * This is the unit the shadow path builds (`shadow_ufcs_slim_src`). */
static CCString uf_hook_tu(CcLowerer* L, CcHookReg* hook, CCSlice body) {
    CCArena a = L->arena;
    CcUnit* hu = hook->unit;
    CCSlice src = hu->tape.src;
    CCString tu = cc_string_new();
    char* types;
    cc_string_push_cstr(&tu, "#define CC_UFCS_SLIM\n"
                             "#include <ccc/std/prelude.cch>\n"
                             "#include <ccc/cc_ufcs.cch>\n", a);
    types = cc_ct_extract_type_decls_prelude(src.ptr, src.len);
    if (types) {
        if (types[0]) cc_string_push_cstr(&tu, types, a);
        free(types);
    }
    cc_string_push_slice(&tu, body, a);
    cc_string_push_char(&tu, '\n', a);
    return tu;
}

/* The handler this type's hook names, as a declaration of this unit. */
static CcDecl* uf_hook_decl(CcIndex* ix, CcHookReg* hook, CcUnit** out_unit) {
    CcSym* s = cc__sym_find_kind(ix, hook->ufcs_fn, CC_SYM_FUNC);
    if (!s || !s->decl || !s->unit || !s->is_definition) return NULL;
    *out_unit = s->unit;
    return s->decl;
}

/* The handler, compiled. Once: one that does not compile is not tried
 * again, and the site falls back to what the index could read. */
static CcUfcsHookFn uf_hook_fn(Walker* w, CcLowerer* L, CcHookReg* hook) {
    CcIndex* ix = w->ix;
    CCArena a = L->arena;
    const void* fn = NULL;
    void* owner = NULL;
    CcUnit* du = NULL;
    CcDecl* d;
    CCString tu;
    CCString path_s = cc_string_new();
    CCString name_s = cc_string_new();
    const char* path;
    const char* name;
    const char* tu_c;
    if (hook->ufcs_compile_tried) return (CcUfcsHookFn)hook->ufcs_callable;
    hook->ufcs_compile_tried = true;
    if (!hook->unit || !hook->ufcs_fn.len || hook->ufcs_fn.ptr[0] == '<') return NULL;
    d = uf_hook_decl(ix, hook, &du);
    if (!d || !du) return NULL;
    tu = uf_hook_tu(L, hook, cc__span_text(ix, du, d->span.first, d->span.last));
    cc_string_push_slice(&path_s, hook->unit->tape.path, a);
    path = cc_string_cstr(&path_s, a);
    cc_string_push_slice(&name_s, hook->ufcs_fn, a);
    name = cc_string_cstr(&name_s, a);
    tu_c = cc_string_cstr(&tu, a);
    if (!path || !name || !tu_c) return NULL;
    if (cc_comptime_compile_type_hook_callable(path, path, tu_c, strlen(tu_c),
                                               name, strlen(name),
                                               CC_COMPTIME_TYPE_HOOK_UFCS,
                                               &owner, &fn) != 0 || !fn)
        return NULL;
    hook->ufcs_callable = (void*)fn;
    return (CcUfcsHookFn)fn;
}

/* The method a computed handler names for this site, or NULL.
 *
 * Only for a handler the index could not read as rules: one it could read
 * has already answered, and running it again would say the same thing more
 * slowly. What comes back is a callee, `__cc_ufcs_pass__` (not mine), or
 * the empty slice (mine, and refused) — the last two leave the site to the
 * diagnostic that was going to be raised anyway. */
static CcMethod* uf_hook_site(Walker* w, CcLowerer* L, CCSlice tn, CcUfcs uf, CcSpan sp) {
    CcIndex* ix = w->ix;
    CcHookReg* hook = cc__hook_match(ix, tn, true);
    CcUfcsHookFn fn;
    CcExprList* av = &uf.args;
    size_t n = av->len();
    size_t i;
    CCSlice* argv_items;
    CCSlice* type_items;
    CCSliceArray argv;
    CCSliceArray arg_types;
    CCSlice out;
    CCSlice callee;
    bool by_value = false;
    CcSym* cs;
    if (!hook || !hook->ufcs_opaque) return NULL;
    /* Not `@typehooks on *`. A wildcard handler is the fallback every
     * unresolved method reaches, so compiling one that cannot be compiled
     * — a stdlib handler over runtime symbols the hook dylib does not link
     * — would report that failure at every such site, about a handler that
     * was not going to be the answer. A handler that names its type is
     * being asked about that type. */
    if (hook->any) return NULL;
    fn = uf_hook_fn(w, L, hook);
    if (!fn) return NULL;
    argv_items = cc_arena_alloc(L->arena, (n ? n : 1) * sizeof(CCSlice), _Alignof(CCSlice));
    type_items = cc_arena_alloc(L->arena, (n ? n : 1) * sizeof(CCSlice), _Alignof(CCSlice));
    for (i = 0; i < n; i++) {
        CcExpr* arg = *av->get_ptr(i);
        CcType* at = arg ? type_of_expr(w, arg) : NULL;
        bool is_str = false;
        @switch (arg->k) {
            case .string: is_str = true; break;
            default: break;
        }
        argv_items[i] = cc__span_text(ix, L->unit, arg->span.first, arg->span.last);
        /* A string literal is spelled to the handler as `const char*`. That
         * is the shape the argument has where the handler picks an overload
         * by it, and it is the spelling every handler already written was
         * written against; typing it `char *` here would answer a question
         * about the site with a fact about the type system, and the
         * handler's `const char*` arm would never be taken. */
        if (is_str) type_items[i] = cstr_slice("const char*");
        else type_items[i] = at ? ix->canon(at) : cc_slice_empty();
    }
    if (!n) { argv_items = NULL; type_items = NULL; }
    argv = (CCSliceArray){ argv_items, n };
    arg_types = (CCSliceArray){ type_items, n };
    /* `mode` is the name of a `@typeview Mode on T` the receiver was
     * written through, and this step does not carry one yet: every handler
     * in the stdlib discards it, so passing empty is what they see either
     * way. A handler that branches on it would need the view here. */
    out = fn(tn, uf.method, cc_slice_empty(), argv, arg_types, L->arena);
    if (!out.ptr || !out.len) return NULL;
    if (cc_slice_eq_cstr(&out, CC_UFCS_PASS_TAG)) return NULL;
    callee = out;
    {
        size_t vt = sizeof(CC_UFCS_VALUE_TAG) - 1;
        if (callee.len > vt && memcmp(callee.ptr, CC_UFCS_VALUE_TAG, vt) == 0) {
            callee = cc_slice_from_buffer((char*)callee.ptr + vt, callee.len - vt);
            by_value = true;
        }
    }
    cs = cc__callee_sym(ix, callee);
    if (!cs) {
        CCSlice hn = hook->ufcs_fn;
        CCString msg = @string(`type: the '${"."}ufcs' handler '${hn}' names '${callee}' for '${"."}${uf.method}' on '${tn}', and nothing declares it`, L->arena);
        lw_error(L, sp, msg);
        return NULL;
    }
    return cc__method_plain(ix, uf.method, callee, "typehooks",
                            cc__cat3(ix, "@" "typehooks .ufcs -> ", cc__sym_origin(ix, cs), " (run)"),
                            cs, by_value);
}

/* An ambient namespace: `cc_std_out.write(x)` -> `cc_std_out_write_auto(x)`.
 *
 * The receiver names no value — it is the namespace the callee lives in —
 * so there is nothing for the receiver typing to find and no receiver
 * argument to pass. The pairs are the table `cc_ufcs_families.h` holds for
 * every lowerer, so neither invents a name the other does not know. The
 * callee it names is a `_Generic` that picks the overload from the one
 * argument's type, which is why the argument is passed as written. */
static bool uf_ambient(Walker* w, CcLowerer* L, CcExpr* e, CcUfcs uf, CcSpan sp) {
    CcExprList* av = &uf.args;
    CCSlice recv;
    CcExpr* a0;
    size_t i;
    if (uf.arrow || !uf.recv) return false;
    if (!expr_ident(strip_parens_expr(uf.recv), &recv) || !recv.len) return false;
    if (av->len() != 1) return false;
    if (sc_lookup(w, recv)) return false;   /* a local of that name is a value, not a namespace */
    a0 = *av->get_ptr(0);
    for (i = 0; cc_ufcs_ambient_rows[i].recv; i++) {
        const CcUfcsAmbientRow* row = &cc_ufcs_ambient_rows[i];
        CCSlice rn = cstr_slice(row->recv);
        CCSlice mn = cstr_slice(row->meth);
        CcCall call;
        if (!slice_eq(recv, rn) || !slice_eq(uf.method, mn)) continue;
        call.callee = lw_ident(L, cstr_slice(row->callee), sp);
        call.args = vec_new::[CcExprRef](L->arena);
        call.args.push(a0);
        e->k = { .call = call };
        return true;
    }
    return false;
}

/* `x.m::[T](args)`: the type arguments the site wrote, as the leading
 * arguments of the call.
 *
 * A method that takes a type takes it as a macro parameter -- the header
 * spells `cc_py_obj_as_list(T, obj, arena)`, and the C it expands to pastes
 * `T` into a name -- so the type travels as the spelling the site wrote and
 * not as a canonical one. The macro's own arity says the call has this
 * shape: one parameter per type argument, then the receiver, then the
 * written arguments. A callee that is not such a macro has nowhere to put
 * them, and that is a diagnostic at the site rather than a call carrying an
 * argument the callee never declared. */
static bool uf_targs_lead(Walker* w, CcLowerer* L, CcUfcs uf, CcMethod* m,
                          CcSpan sp, CcExprList* out) {
    CcTypeList* tv = &uf.targs;
    size_t nt = tv->len();
    CcMacroDef* md;
    size_t i;
    if (!nt) return true;
    md = uf_macro_of(w->ix, m->callee);
    if (md) {
        CcNameList* ps = &md->params;
        if (!md->function_like || ps->len() != nt + 1 + uf.args.len()) md = NULL;
    }
    if (!md) {
        CCSlice mn = uf.method;
        CCSlice cn = m->callee;
        CCString msg = @string(`type: '.${mn}' resolves to '${cn}', which declares no type formal for it`, L->arena);
        lw_error(L, sp, msg);
        return false;
    }
    for (i = 0; i < nt; i++) {
        CcType* ta = *tv->get_ptr(i);
        CCString spelled = CcType_spell(ta, cc_slice_empty(), &L->unit->tape, L->arena);
        out->push(lw_text(L, spelled, sp));
    }
    return true;
}

/* ---- members that carry a type formal ----------------------------------
 *
 * `arena.allocT(n)` and `task.block_on()` name a type the call site does
 * not spell in an argument: the lowered callee takes it as a leading macro
 * argument. `::[T]` after the member binds it; otherwise the declared
 * destination does — for `allocT` the destination is a pointer and the
 * element is its pointee, for `block_on` it is the destination itself.
 *
 * The set is closed. A member outside it that wears `::[...]` has no formal
 * to bind, and the ordinary resolution says so. */

/* The receiver's name without a trailing `*`: the same type answers whether
 * it was written as a value or a pointer. */
static CCSlice uf_base_name(CCSlice tn) {
    size_t n = tn.len;
    while (n && (tn.ptr[n - 1] == '*' || tn.ptr[n - 1] == ' ')) n--;
    return cc_slice_from_buffer((char*)tn.ptr, n);
}

static bool uf_is_formal_member(CCSlice tn, CCSlice method, bool* is_alloc) {
    CCSlice base = uf_base_name(tn);
    if (slice_eq(method, cstr_slice("allocT")) && slice_eq(base, cstr_slice("CCArena"))) {
        *is_alloc = true;
        return true;
    }
    if (slice_eq(method, cstr_slice("block_on")) &&
        (slice_eq(base, cstr_slice("CCAsyncVoidRet")) ||
         (base.len >= 6 && memcmp(base.ptr, "CCTask", 6) == 0))) {
        *is_alloc = false;
        return true;
    }
    return false;
}

/* Through the unwrap tails to the UFCS call a destination is filled from. */
static CcExpr* uf_ufcs_under(CcExpr* e) {
    CcExpr* inner = NULL;
    if (!e) return NULL;
    @switch (e->k) {
        case .ufcs: return e;
        case .paren(u): inner = u.a; break;
        case .unwrap(u): inner = u.a; break;
        case .unwrap_body(u): inner = u.a; break;
        case .unwrap_or(u): inner = u.a; break;
        case .unwrap_destroy(u): inner = u.a; break;
        default: return NULL;
    }
    return uf_ufcs_under(inner);
}

/* The pointee of a pointer destination, aliases followed: `double* xs` says
 * the element is `double`. NULL when the destination is not a pointer. */
static CcType* uf_pointee(Walker* w, CcType* t) {
    CcType* u = unalias_local(w, t);
    if (!u) u = t;
    if (!u) return NULL;
    @switch (u->k) {
        case .pointer(pt): return pt.pointee;
        default: break;
    }
    return NULL;
}

/* The declared type of an assignment's target, so `p = a.allocT(8)` types
 * its formal the same way `char* p = a.allocT(8)` does. */
static void uf_formal_assign(Walker* w, UStep* st, CcStmt* s) {
    CcExpr* e = NULL;
    CcBinary a;
    bool is_assign = false;
    CcExpr* u;
    @switch (s->k) {
        case .expr(es): e = es.e; break;
        default: return;
    }
    if (!e) return;
    @switch (e->k) {
        case .assign(x): a = x; is_assign = true; break;
        default: break;
    }
    if (!is_assign || a.op != CC_OP_ASSIGN || !a.a || !a.b) return;
    u = uf_ufcs_under(a.b);
    if (!u) return;
    {
        CcType* t = type_of_expr(w, a.a);
        if (!t) return;
        st->formal_at.push(u);
        st->formal_ty.push(t);
    }
}

static void uf_formal_stmt(Walker* w, CcStmt* s, bool enter) {
    UStep* st = (UStep*)w->env;
    CcDecl* d = NULL;
    CcVarDecl v;
    bool is_var = false;
    CcExpr* u;
    if (!enter) return;
    if (!stmt_is_decl(s, &d) || !d) { uf_formal_assign(w, st, s); return; }
    @switch (d->k) {
        case .var(x): v = x; is_var = true; break;
        default: break;
    }
    if (!is_var || !v.type || !v.init || v.init->is_list || !v.init->expr) return;
    u = uf_ufcs_under(v.init->expr);
    if (!u) return;
    st->formal_at.push(u);
    st->formal_ty.push(v.type);
}

/* Declarations, before the rewrite: a type formal reads the destination as
 * written, and the rewrite replaces the node it is recorded against. */
static void uf_formal_pass(CcLowerer* L, UStep* st) {
    Walker w;
    memset(&w, 0, sizeof(w));
    w.arena = L->arena;
    w.ix = L->ix;
    w.unit = L->unit;
    w.on_stmt = uf_formal_stmt;
    w.env = st;
    tw_unit(&w);
}

static CcType* uf_formal_dest(UStep* st, CcExpr* e) {
    CcExprList* av = &st->formal_at;
    CcTypeList* tv = &st->formal_ty;
    size_t n = av->len();
    size_t i;
    for (i = 0; i < n; i++) if (*av->get_ptr(i) == e) return *tv->get_ptr(i);
    return NULL;
}

/* True when the site was a type-formal member and is now the call it lowers
 * to — or when it was one and could not be lowered, which is reported here
 * rather than left to the ordinary resolution, whose candidates are the
 * unspecialized name and say nothing about the missing type. */
static bool uf_formal_rewrite(Walker* w, UStep* st, CcExpr* e, CcUfcs uf,
                              CcType* rt, CCSlice tn, CcSpan sp) {
    CcLowerer* L = st->L;
    bool is_alloc = false;
    CcType* ty = NULL;
    CcTypeList* tv = &uf.targs;
    CcExprList* av = &uf.args;
    size_t nt = tv->len();
    size_t na = av->len();
    CcCall call;
    CCSlice callee;
    bool recv_ptr;
    if (!uf_is_formal_member(tn, uf.method, &is_alloc)) return false;
    if (nt > 1) {
        CCSlice mn = uf.method;
        CCString msg = @string(`type: '.${mn}' binds one type formal, and this site spells ${nt}`, L->arena);
        lw_error(L, sp, msg);
        return true;
    }
    if (nt == 1) ty = *tv->get_ptr(0);
    else {
        CcType* dest = uf_formal_dest(st, e);
        ty = (dest && is_alloc) ? uf_pointee(w, dest) : dest;
    }
    if (!ty) {
        CCString msg = is_alloc
            ? @string(`type: 'arena.allocT' needs its element type: declare a typed pointer destination (T* p = arena.allocT(n)) or spell it (arena.allocT::[T](n))`, L->arena)
            : @string(`type: 'task.block_on' needs its result type: declare a typed destination (T v = task.block_on()) or spell it (task.block_on::[T]())`, L->arena);
        lw_error(L, sp, msg);
        return true;
    }
    if (is_alloc && na > 1) {
        CCString msg = @string(`type: 'arena.allocT' takes one count at most, and this site passes ${na}`, L->arena);
        lw_error(L, sp, msg);
        return true;
    }
    if (!is_alloc && na) {
        CCString msg = @string(`type: 'task.block_on' takes no arguments, and this site passes ${na}`, L->arena);
        lw_error(L, sp, msg);
        return true;
    }
    recv_ptr = uf.arrow || uf_type_is_pointer(w, rt);
    callee = is_alloc ? (na ? cstr_slice("cc_arena_alloc_T_count") : cstr_slice("cc_arena_alloc_T"))
                      : cstr_slice("cc_block_on");
    call.callee = lw_ident(L, callee, sp);
    call.args = vec_new::[CcExprRef](L->arena);
    {
        CCString spelled = CcType_spell(ty, cc_slice_empty(), &L->unit->tape, L->arena);
        call.args.push(lw_text(L, spelled, sp));
    }
    if (is_alloc) {
        /* `cc_arena_alloc` takes a `CCArena` by value and peels a handle
         * itself, so the arena goes as written */
        CcExpr* r = uf_wrap(L, uf.recv, sp);
        call.args.push(r);
        if (na) { CcExpr* cnt = *av->get_ptr(0); call.args.push(cnt); }
    } else {
        /* `cc_block_on` waits on the handle itself, so a pointer receiver is
         * read through */
        CcExpr* r = uf_wrap(L, uf.recv, sp);
        call.args.push(recv_ptr ? cc_expr_unary(CC_OP_DEREF, r, sp, L->arena) : r);
    }
    e->k = { .call = call };
    return true;
}

static void uf_rewrite(Walker* w, CcExpr* e, CcUfcs uf, CcType* rt, CcMethod* m, CCSlice tn, CCSlice reason) {
    UStep* st = (UStep*)w->env;
    CcLowerer* L = st->L;
    CcSpan sp = e->span;
    CcExpr* recv_arg;
    CcCall call;
    bool recv_ptr;
    st->n_sites++;
    if (!rt && uf_ambient(w, L, e, uf, sp)) return;
    if (!rt) {
        CCSlice kind = uf.recv ? CcExpr_kind_name(uf.recv) : cc_slice_empty();
        CCSlice who = cc_slice_empty();
        CCString msg;
        /* name the receiver when it has one: 'nosuchvar' says more than 'a ident' */
        if (uf.recv && expr_ident(strip_parens_expr(uf.recv), &who) && who.len)
            msg = @string(`type: cannot type the receiver '${who}' of '.${uf.method}'; declare it with a type the index can see`, L->arena);
        else
            msg = @string(`type: cannot type the receiver of '.${uf.method}' (a ${kind}); declare it with a type the index can see`, L->arena);
        lw_error(L, sp, msg);
        return;
    }
    if (uf_formal_rewrite(w, st, e, uf, rt, tn, sp)) return;
    if (!m) m = uf_hook_site(w, L, tn, uf, sp);
    if (!m) {
        CCString msg = @string(`type: ${reason}`, L->arena);
        lw_error(L, sp, msg);
        return;
    }
    if (!uf_operator_matches(w, L, e, uf, rt, tn)) return;
    recv_ptr = uf.arrow || uf_type_is_pointer(w, rt);
    if (m->recv_path.len) {
        /* the face field is a value member: after the projection the
         * receiver is that value, whatever the written receiver was */
        uf.recv = uf_project_faces(L, uf.recv, m->recv_path, recv_ptr, sp);
        recv_ptr = false;
    }
    if (m->recv_by_ptr && !recv_ptr && !uf_is_lvalue(uf.recv)) {
        /* a value with no address (`xs.sub(1, 3).len()`): the call's result
         * lives in a compound literal of its own type for the callee to point at */
        CCSlice tn2 = ix_canon_of(w, rt);
        CcType* lit_t = cc_type_named(tn2, sp, L->arena);
        CcExpr* lit = uf_compound(L, lit_t, uf.recv, sp);
        CcCall call2;
        call2.callee = lw_ident(L, m->callee, sp);
        call2.args = vec_new::[CcExprRef](L->arena);
        if (!uf_targs_lead(w, L, uf, m, sp, &call2.args)) return;
        call2.args.push(lit);   /* the array literal is the pointer */
        {
            CcExprList* args = &uf.args;
            size_t n = args->len();
            size_t i;
            for (i = 0; i < n; i++) {
                CcExpr* a = *args->get_ptr(i);
                call2.args.push(a);
            }
        }
        e->k = { .call = call2 };
        return;
    }
    if (cc_slice_eq_cstr(&uf.method, "destroy") && cc_slice_eq_cstr(&m->source, "typehooks") && !uf.args.len()) {
        /* `x.destroy()` is the whole chain: the hook, then the value members' */
        CcStmt* blk = lw_block(L, sp);
        CcExpr* subject = recv_ptr ? cc_expr_unary(CC_OP_DEREF, uf_wrap(L, uf.recv, sp), sp, L->arena) : uf.recv;
        CcStmtExpr se;
        cl_destroy_chain(L, tn, subject, blk, sp, 0);
        se.block = blk;
        e->k = { .stmt_expr = se };
        return;
    }
    if (uf_recv_by_ptr(L, m, uf.targs.len())) recv_arg = recv_ptr ? uf.recv : cc_expr_unary(CC_OP_ADDR, uf_wrap(L, uf.recv, sp), sp, L->arena);
    else recv_arg = recv_ptr ? cc_expr_unary(CC_OP_DEREF, uf_wrap(L, uf.recv, sp), sp, L->arena) : uf.recv;
    call.callee = lw_ident(L, uf_overload_for_args(w, L, uf, m), sp);
    call.args = vec_new::[CcExprRef](L->arena);
    if (cc_slice_eq_cstr(&m->source, "ufcs_sink")) {
        /* A dynamic family resolves nothing at compile time: the method is
         * a string the callee looks up, and the arguments are a run of
         * values it reads by count. So the call carries what the name no
         * longer says -- the method, then how many arguments follow, then
         * each one through the macro the registration named. */
        CcExprList* av = &uf.args;
        size_t na = av->len();
        size_t ai;
        CCString mq = cc_string_new();
        CCString cnt = @string(`${(int)na}`, L->arena);
        cc_string_push_char(&mq, '"', L->arena);
        cc_string_push_slice(&mq, uf.method, L->arena);
        cc_string_push_char(&mq, '"', L->arena);
        call.args.push(recv_arg);
        call.args.push(lw_text(L, mq, sp));
        call.args.push(lw_text(L, cnt, sp));
        for (ai = 0; ai < na; ai++) {
            CcExpr* a = *av->get_ptr(ai);
            if (m->sink_arg.len) a = lw_call1(L, m->sink_arg, a, sp);
            call.args.push(a);
        }
        e->k = { .call = call };
        {
            CcNameList* sv = &L->sinks;
            size_t sn = sv->len();
            size_t si;
            bool seen = false;
            for (si = 0; si < sn; si++) if (slice_eq(*sv->get_ptr(si), m->callee)) { seen = true; break; }
            if (!seen) sv->push(m->callee);
        }
        return;
    }
    if (!uf_targs_lead(w, L, uf, m, sp, &call.args)) return;
    call.args.push(recv_arg);
    {
        CcExprList* args = &uf.args;
        size_t n = args->len();
        size_t i;
        size_t base = call.args.len();
        CCSlice cn = uf_ident_name_or_empty(call.callee);
        for (i = 0; i < n; i++) {
            CcExpr* a = *args->get_ptr(i);
            CcExpr* ad = cn.len ? uf_arg_addr(w, L, cn, base + i, a) : NULL;
            if (ad) a = ad;
            call.args.push(a);
        }
    }
    e->k = { .call = call };
    (void)tn;
}

/* `Type.fn(args)` -> `Type_fn(args)`, when that function is declared. */
static bool uf_type_scoped_visit(CcExpr* e, void* env) {
    UStep* st = (UStep*)env;
    CcLowerer* L = st->L;
    CcTypeScoped ts;
    bool hit = false;
    @switch (e->k) {
        case .type_scoped(x): ts = x; hit = true; break;
        default: break;
    }
    if (!hit) return true;
    {
        CcIndex* ix = L->ix;
        CCSlice tn = ts.type ? ix->canon(ts.type) : cc_slice_empty();
        CCString nm = @string(`${tn}_${ts.fn}`, L->arena);
        CCSlice fname = lw_keep(L, &nm);
        CcSym* sym = ix->sym(fname) ?> NULL;
        CcCall call;
        if (!tn.len || !sym) {
            CCString msg = @string(`type: no function '${fname}' for '${tn}.${ts.fn}(...)'`, L->arena);
            lw_error(L, e->span, msg);
            return true;
        }
        call.callee = lw_ident(L, fname, e->span);
        call.args = ts.args;
        e->k = { .call = call };
    }
    return true;
}

/* ---- the `as:` face graph ------------------------------------------------ */

/* The type of an `as:` field of `owner`, and whether it is written as a
 * pointer. Empty when the owner has no such member. */
static CCSlice uf_face_field(CcLowerer* L, CCSlice owner, CCSlice face, bool* is_ptr) {
    CcIndex* ix = L->ix;
    CcRecordType st;
    CcFieldList* fieldv;
    size_t k;
    size_t nf;
    *is_ptr = false;
    if (!cc__struct_of(ix, owner, 0, &st)) return cc_slice_empty();
    fieldv = &st.fields;
    nf = fieldv->len();
    for (k = 0; k < nf; k++) {
        CcField* f = fieldv->get_ptr(k);
        if (!f->name.len || !f->type || !slice_eq(f->name, face)) continue;
        *is_ptr = f->type->k.kind == CcTypeK_pointer;
        return ix->canon(f->type);
    }
    return cc_slice_empty();
}

/* Every type reachable from `from` through `as:` faces, itself included.
 * A type met twice on one path is a cycle. */
static void uf_face_reach(CcLowerer* L, CCSlice from, CcNameList* out, CcNameList* seen, bool* cycle, int depth) {
    CcIndex* ix = L->ix;
    CcNameList faces;
    size_t n;
    size_t i;
    if (!from.len || depth > 8) return;
    {
        size_t ns = seen->len();
        for (i = 0; i < ns; i++)
            if (slice_eq(*seen->get_ptr(i), from)) { *cycle = true; return; }
    }
    out->push(from);
    seen->push(from);
    faces = cc__view_faces(ix, from);
    n = faces.len();
    for (i = 0; i < n; i++) {
        CCSlice face = *faces.get_ptr(i);
        bool is_ptr = false;
        CCSlice fty = uf_face_field(L, from, face, &is_ptr);
        if (!fty.len || is_ptr) continue;
        uf_face_reach(L, fty, out, seen, cycle, depth + 1);
    }
    {
        CCSlice dropped = cc_slice_empty();
        seen->pop(&dropped);
    }
}

/* Every name a restrict list may mention: the type's fields and its
 * methods. */
static CcNameList uf_surface_of(CcLowerer* L, CCSlice tn) {
    CcIndex* ix = L->ix;
    CcNameList out = vec_new::[CCSlice](L->arena);
    CcRecordType st;
    CcTypeInfo* info = ix->type_get(tn);
    if (cc__struct_of(ix, tn, 0, &st)) {
        CcFieldList* fieldv = &st.fields;
        size_t n = fieldv->len();
        size_t i;
        for (i = 0; i < n; i++) {
            CcField* f = fieldv->get_ptr(i);
            if (f->name.len) out.push(f->name);
        }
    }
    if (info) {
        CcMethodList ms = ix->methods_of(info);
        size_t n = ms.len();
        size_t i;
        for (i = 0; i < n; i++) {
            CcMethod* m = *ms.get_ptr(i);
            if (m->method.len) out.push(m->method);
        }
    }
    return out;
}

/* `out_*`, `*_len` and `*` stand for a set; anything else names one member. */
static bool uf_item_is_glob(CCSlice name) {
    size_t i;
    for (i = 0; i < name.len; i++)
        if (name.ptr[i] == '*') return true;
    return false;
}

/* One `*` in a restrict item matches any run of characters. */
static bool uf_glob_match(CCSlice pat, CCSlice name) {
    size_t star = pat.len;
    size_t i;
    size_t head;
    size_t tail;
    for (i = 0; i < pat.len; i++)
        if (pat.ptr[i] == '*') { star = i; break; }
    if (star == pat.len) return slice_eq(pat, name);
    head = star;
    tail = pat.len - star - 1;
    if (name.len < head + tail) return false;
    if (head && memcmp(name.ptr, pat.ptr, head) != 0) return false;
    if (tail && memcmp(name.ptr + name.len - tail, pat.ptr + star + 1, tail) != 0) return false;
    return true;
}

/* A member the type does not have may live in an `as:` embed. The search
 * walks the faces one hop at a time and counts every way it reaches the
 * field: exactly one is the answer, two is ambiguous. */
static bool uf_field_path(CcLowerer* L, CCSlice owner, CCSlice field, CcNameList* path, int* found, int depth) {
    CcIndex* ix = L->ix;
    CcNameList faces;
    CcRecordType st;
    size_t n;
    size_t i;
    bool set = false;
    if (!owner.len || depth > 6) return false;
    faces = cc__view_faces(ix, owner);
    n = faces.len();
    if (!n) return false;
    {
        CcNameList* fv = &faces;
        (void)fv;
    }
    if (!cc__struct_of(ix, owner, 0, &st)) return false;
    for (i = 0; i < n; i++) {
        CcNameList* facev = &faces;
        CCSlice face = *facev->get_ptr(i);
        bool is_ptr = false;
        CCSlice fty = uf_face_field(L, owner, face, &is_ptr);
        CcRecordType fst;
        if (!fty.len || is_ptr) continue;
        if (cc__struct_of(ix, fty, 0, &fst) && field_of_record(fst, field)) {
            (*found)++;
            if (!set) { path->push(face); set = true; }
            continue;
        }
        {
            CcNameList sub = vec_new::[CCSlice](L->arena);
            CcNameList* subv = &sub;
            if (uf_field_path(L, fty, field, &sub, found, depth + 1) && !set) {
                size_t j;
                size_t ns = subv->len();
                path->push(face);
                for (j = 0; j < ns; j++) {
                    CCSlice step = *subv->get_ptr(j);
                    path->push(step);
                }
                set = true;
            }
        }
    }
    return set;
}

/* `x.f` where `f` is not a member of x's type: the face chain that reaches
 * it, spliced in. */
static void uf_member(Walker* w, CcExpr* e, CcMember mb, CcType* rt) {
    UStep* st = (UStep*)w->env;
    CcLowerer* L = st->L;
    CCSlice owner;
    CcNameList path;
    int found = 0;
    if (!rt || !mb.name.len) return;
    if (field_type(w, rt, mb.name)) return;              /* the type has it */
    owner = cc__strip_tag(ix_canon_of(w, rt));
    if (!owner.len) return;
    path = vec_new::[CCSlice](L->arena);
    if (!uf_field_path(L, owner, mb.name, &path, &found, 0)) return;
    if (found > 1) {
        CCSlice f = mb.name;
        CCString m = @string(`type: ambiguous field '${f}' on '${owner}': two ${"@"}typeview as: embeds reach it`, L->arena);
        lw_error(L, vt_dot_span(e), m);
        return;
    }
    {
        CcExpr* recv = mb.a;
        CcNameList* pathv = &path;
        size_t n = pathv->len();
        size_t i;
        bool first = true;
        for (i = 0; i < n; i++) {
            recv = cc_expr_member(first ? uf_wrap(L, recv, e->span) : recv, *pathv->get_ptr(i), first && mb.arrow, e->span, L->arena);
            first = false;
        }
        {
            CcMember out;
            out.a = recv;
            out.name = mb.name;
            out.arrow = false;
            e->k = { .member = out };
        }
    }
}

/* One `@typeview T { r: a, ^b; }`: every name in the list matches a field
 * or a method, and `^*` denies nothing at all. */
static void uf_check_restrict(CcLowerer* L, CcDecl* d, CcTypeview tv, CCSlice tn, CcHookEntry* e) {
    CcViewItemList* itemv = &e->items;
    size_t n = itemv->len();
    size_t i;
    CcNameList surface = uf_surface_of(L, tn);
    CCSlice view = tv.view.len ? tv.view : cstr_slice("(default)");
    for (i = 0; i < n; i++) {
        CcViewItem* it = itemv->get_ptr(i);
        CCSlice nm = it->name;
        CCSlice near;
        size_t k;
        size_t ns = surface.len();
        bool found = false;
        if (!nm.len) continue;
        if (it->deny && nm.len == 1 && nm.ptr[0] == '*') {
            CCString m = @string(`${"@"}typeview ${view} on ${tn}: '^*' is ill-formed`, L->arena);
            lw_error(L, d->span, m);
            continue;
        }
        if (nm.len == 1 && nm.ptr[0] == '*') continue;      /* the whole surface */
        if (uf_item_is_glob(nm)) {
            for (k = 0; k < ns && !found; k++)
                if (uf_glob_match(nm, *surface.get_ptr(k))) found = true;
            if (found) continue;
        }
        for (k = 0; k < ns && !found; k++)
            if (slice_eq(*surface.get_ptr(k), nm)) found = true;
        if (found) continue;
        near = lw_closest(surface, nm);
        {
            const char* kind = it->deny ? "deny-list '^" : "allow-list '";
            CCString m = @string(`${"@"}typeview ${view} on ${tn}: ${kind}${nm}' matches no field or method on ${tn}`, L->arena);
            if (near.len) {
                CCString note = @string(`did you mean '${near}'?`, L->arena);
                vt_error_note(L, d->span, m, lw_keep(L, &note));
            } else {
                lw_error(L, d->span, m);
            }
        }
    }
}

/* One `@typeview T { as: f, g; }`: each face names a value member, the
 * graph is acyclic, and no type is reachable through two faces. */
static void uf_check_view(CcLowerer* L, CcDecl* d, CcTypeview tv) {
    CcIndex* ix = L->ix;
    CCSlice tn;
    CcHookEntryList* entryv = &tv.entries;
    size_t ne = entryv->len();
    size_t i;
    CcNameList seen_types = vec_new::[CCSlice](L->arena);
    CcNameList reached = vec_new::[CCSlice](L->arena);
    if (!tv.target) return;
    tn = cc__strip_tag(ix->canon(tv.target));
    if (!tn.len || tn.ptr[tn.len - 1] == '*') return;    /* a family glob has no one struct */
    for (i = 0; i < ne; i++) {
        CcHookEntry* e = entryv->get_ptr(i);
        CcViewItemList* itemv = &e->items;
        size_t nj = itemv->len();
        size_t j;
        if (!cc_slice_eq_cstr(&e->key, "as")) {
            if (cc_slice_eq_cstr(&e->key, "r") || cc_slice_eq_cstr(&e->key, "w") ||
                cc_slice_eq_cstr(&e->key, "rw")) uf_check_restrict(L, d, tv, tn, e);
            continue;
        }
        for (j = 0; j < nj; j++) {
            CcViewItem* it = itemv->get_ptr(j);
            bool is_ptr = false;
            CCSlice fty;
            CcNameList mine = vec_new::[CCSlice](L->arena);
            CcNameList path = vec_new::[CCSlice](L->arena);
            bool cycle = false;
            size_t k;
            size_t nm;
            if (!it->name.len) continue;
            fty = uf_face_field(L, tn, it->name, &is_ptr);
            if (is_ptr) {
                CCSlice fname = it->name;
                CCString m = @string(`type: as: field '${fname}' on '${tn}' must be a value embed, not a pointer`, L->arena);
                lw_error(L, d->span, m);
                continue;
            }
            if (!fty.len) continue;
            uf_face_reach(L, fty, &mine, &path, &cycle, 0);
            if (cycle || slice_eq(fty, tn)) {
                CCString m = @string(`cyclic as: on '${tn}'`, L->arena);
                lw_error(L, d->span, m);
                continue;
            }
            nm = mine.len();
            for (k = 0; k < nm; k++) {
                CCSlice got = *mine.get_ptr(k);
                size_t q;
                size_t nr = reached.len();
                bool dup = false;
                for (q = 0; q < nr && !dup; q++)
                    if (slice_eq(*reached.get_ptr(q), got)) dup = true;
                if (dup) {
                    CCString m = @string(`type: ambiguous as: embed of '${got}' on '${tn}'`, L->arena);
                    lw_error(L, d->span, m);
                } else {
                    reached.push(got);
                }
            }
        }
    }
    (void)seen_types;
}

/* The view a binding is restricted to, or empty. `@typeview(V) T*` puts
 * the annotation on the `T` the declarator built the pointer from, so the
 * pointers are peeled looking for it. */
static CCSlice uf_view_attr(CcType* t) {
    while (t) {
        CcAttrList* av = &t->attrs;
        size_t n = av->len();
        size_t i;
        CcType* inner = NULL;
        for (i = 0; i < n; i++) {
            CcAttr* a = av->get_ptr(i);
            if (cc_slice_eq_cstr(&a->name, "typeview")) return a->value;
        }
        @switch (t->k) {
            case .pointer(pt): inner = pt.pointee; break;
            default: break;
        }
        t = inner;
    }
    return cc_slice_empty();
}

/* A restricted binding does not widen. `@typeview(V) T*` names what the
 * view lets through; a parameter declared as the whole `T*` would hand
 * the callee everything the view withheld, and there is no cast that
 * makes that safe. */
static void uf_check_widen(Walker* w, CcExpr* e, CcCall cl) {
    UStep* st = (UStep*)w->env;
    CcLowerer* L = st->L;
    CcIndex* ix = L->ix;
    CcExprList* av = &cl.args;
    CcParamList* ps = NULL;
    CCSlice fn;
    CcSym* sym;
    size_t n = av->len();
    size_t np;
    size_t i;
    if (!expr_ident(strip_parens_expr(cl.callee), &fn)) return;
    sym = sym_any(ix, fn);
    while (sym && sym->kind != CC_SYM_FUNC) sym = sym->same_name;
    if (!sym || !sym->type) return;
    @switch (sym->type->k) {
        case .func: ps = &sym->type->k.func.params; break;
        default: break;
    }
    if (!ps) return;
    np = ps->len();
    for (i = 0; i < n && i < np; i++) {
        CcExpr* a = *av->get_ptr(i);
        CcType* at = type_of_expr(w, a);
        CCSlice have = uf_view_attr(at);
        CcParam* pa = ps->get_ptr(i);
        CCSlice want;
        if (!have.len) continue;
        want = uf_view_attr(pa->type);
        if (want.len && slice_eq(want, have)) continue;
        {
            CCSlice on = cc__strip_tag(ix->canon(peel(at)));
            CCSlice to = pa->type ? ix->canon(pa->type) : cc_slice_empty();
            CCString m = @string(`restricted mode '${have}' on '${on}': cannot widen to '${to}' (const-shaped; no cast)`, L->arena);
            lw_error(L, e->span, m);
        }
    }
}

static void uf_widen_pass(CcLowerer* L, UStep* st) {
    Walker w;
    memset(&w, 0, sizeof(w));
    w.arena = L->arena;
    w.ix = L->ix;
    w.unit = L->unit;
    w.on_call = uf_check_widen;
    w.env = st;
    tw_unit(&w);
}

static void uf_check_views(CcLowerer* L) {
    CcUnit* u = L->unit;
    CcDeclList* declv = &u->decls;
    size_t n = declv->len();
    size_t i;
    for (i = 0; i < n; i++) {
        CcDecl* d = *declv->get_ptr(i);
        @switch (d->k) {
            case .typeview(tv): uf_check_view(L, d, tv); break;
            default: break;
        }
    }
}

/* `println(x)` / `eprintln(x)`: free sugar for `cc_println` / `cc_eprintln`.
 *
 * Both are language spellings, not declared functions — `cc_println` is a
 * `_Generic` macro the prelude defines — so nothing in the index resolves
 * the bare name, and leaving it as written hands C an undeclared call. The
 * name is the whole difference; the arguments and the Result the macro
 * yields are untouched. */
static bool uf_print_sugar(CcExpr* e, void* env) {
    CcLowerer* L = (CcLowerer*)env;
    @switch (e->k) {
        case .call(cl): {
            CCSlice fn;
            CcExpr* callee = strip_parens_expr(cl.callee);
            if (!expr_ident(callee, &fn)) break;
            if (cc_slice_eq_cstr(&fn, "println")) callee->k = { .ident = cstr_slice("cc_println") };
            else if (cc_slice_eq_cstr(&fn, "eprintln")) callee->k = { .ident = cstr_slice("cc_eprintln") };
            break;
        }
        default: break;
    }
    return true;
}

/* `double d = py.eval(src) !>;`
 *
 * A dynamic family's plain callee answers with the family's own value --
 * a `CCPyObj`, a `CCQjsVal` -- and the site wants what it declared. Such a
 * family declares one callee per destination type, so the destination
 * picks it: `cc_py_callm_double` where the cell is a `double`. Only a
 * variant the headers actually declare is taken, so a family that has none
 * keeps the callee it had and the host compiler still says the value does
 * not fit. */
static CCSlice uf_dest_mangle(CcLowerer* L, CCSlice canon) {
    CCString m = cc_string_new();
    size_t i;
    if (!canon.len) return cc_slice_empty();
    for (i = 0; i < canon.len; i++) {
        char c = canon.ptr[i];
        if (c == '*') return cc_slice_empty();   /* a pointer destination names no variant */
        cc_string_push_char(&m, c == ' ' ? '_' : c, L->arena);
    }
    return lw_keep(L, &m);
}

/* Through the unwrap tails to the call a destination is filled from. */
static CcExpr* uf_call_under(CcExpr* e) {
    CcExpr* inner = NULL;
    if (!e) return NULL;
    @switch (e->k) {
        case .call: return e;
        case .paren(u): inner = u.a; break;
        case .unwrap(u): inner = u.a; break;
        case .unwrap_body(u): inner = u.a; break;
        case .unwrap_or(u): inner = u.a; break;
        case .unwrap_destroy(u): inner = u.a; break;
        default: return NULL;
    }
    return uf_call_under(inner);
}

static void uf_dest_call(CcLowerer* L, CcType* want, CcExpr* init) {
    CcIndex* ix = L->ix;
    CcExpr* call = uf_call_under(init);
    CCSlice callee = cc_slice_empty();
    CCSlice mang;
    CcNameList* sv = &L->sinks;
    size_t sn = sv->len();
    size_t si;
    bool is_sink = false;
    if (!want || !call) return;
    {
        CcCall c;
        bool ok = false;
        @switch (call->k) {
            case .call(x): c = x; ok = true; break;
            default: break;
        }
        if (!ok || !c.callee) return;
        if (!expr_ident(strip_parens_expr(c.callee), &callee)) return;
    }
    if (!callee.len) return;
    for (si = 0; si < sn; si++) if (slice_eq(*sv->get_ptr(si), callee)) { is_sink = true; break; }
    if (!is_sink) return;
    mang = uf_dest_mangle(L, ix->canon(want));
    if (!mang.len) return;
    {
        CCString cand = @string(`${callee}_${mang}`, L->arena);
        CCSlice name = lw_keep(L, &cand);
        CcSym* sym = sym_any(ix, name);
        while (sym && sym->kind != CC_SYM_FUNC) sym = sym->same_name;
        if (!sym) return;
        {
            CcCall c2;
            @switch (call->k) {
                case .call(x): c2 = x; break;
                default: return;
            }
            c2.callee = lw_ident(L, name, call->span);
            call->k = { .call = c2 };
        }
    }
}

static void uf_dest_stmt(Walker* w, CcStmt* s, bool enter) {
    CcLowerer* L = (CcLowerer*)w->env;
    CcDecl* d = NULL;
    if (!enter) return;
    if (stmt_is_decl(s, &d) && d) {
        CcVarDecl v;
        bool is_var = false;
        @switch (d->k) {
            case .var(x): v = x; is_var = true; break;
            default: break;
        }
        if (is_var && v.init && !v.init->is_list && v.init->expr)
            uf_dest_call(L, v.type, v.init->expr);
    }
}

static void uf_dest_pass(CcLowerer* L) {
    Walker w;
    if (!L->sinks.len()) return;
    memset(&w, 0, sizeof(w));
    w.arena = L->arena;
    w.ix = L->ix;
    w.unit = L->unit;
    w.on_stmt = uf_dest_stmt;
    w.env = L;
    tw_unit(&w);
}

static void CcLowerer_ufcs(CcLowerer* L) {
    Walker w;
    UStep st;
    CcVisitor v;
    memset(&st, 0, sizeof(st));
    st.L = L;
    memset(&w, 0, sizeof(w));
    w.arena = L->arena;
    w.ix = L->ix;
    w.unit = L->unit;
    st.formal_at = vec_new::[CcExprRef](L->arena);
    st.formal_ty = vec_new::[CcTypeRef](L->arena);
    uf_widen_pass(L, &st);      /* before the rewrite: the arguments are as written */
    uf_formal_pass(L, &st);
    w.on_ufcs = uf_rewrite;
    w.on_field = uf_member;
    w.env = &st;
    tw_unit(&w);
    memset(&v, 0, sizeof(v));
    v.expr = uf_type_scoped_visit;
    v.env = &st;
    CcUnit_walk(L->unit, v);
    memset(&v, 0, sizeof(v));
    v.expr = uf_print_sugar;
    v.env = L;
    CcUnit_walk(L->unit, v);
    uf_dest_pass(L);   /* last: the calls are built, so a destination can pick one */
    uf_check_views(L);
}

#endif

/* Declaration index: what the lowerer knows about names, from declarations.
 *
 * Built from the unit itself and every `.cch` it includes (each parsed in
 * header mode with the same parser, once per path). It answers the
 * questions the lowerings ask, so no lowering carries a table of names:
 *   - is `f` a function, what does it return, is that a Result, of what?
 *   - is `T` a type, a typedef of what, a struct with which fields?
 *   - which method does `x.m()` resolve to for a receiver of type `T`
 *     (type hooks, header registrations, `Type_m`, `cc_<snake>_m`, faces)?
 *   - what is `T`'s destroy hook?
 *   - which argument of `f` is its arena?
 *   - may a call to `f` be discarded (`T?>(E)`)?
 *   - which Result specs must this unit emit, and which come from headers?
 * Missing knowledge is a diagnostic at the use site, never a guess.
 *
 * Lifetimes: the index and the header units it parses live in the arena
 * `cc_index_new` is given, which outlives the unit being lowered. */
#ifndef CC_LOWER_INDEX_CCH
#define CC_LOWER_INDEX_CCH
#include "parse.cch"
#include <ccc/std/map.cch>

typedef enum CcSymKind { CC_SYM_FUNC = 1, CC_SYM_VAR, CC_SYM_TYPE, CC_SYM_ENUMERATOR, CC_SYM_MACRO } CcSymKind;

typedef struct CcSym {
    CCSlice name;
    CcSymKind kind;
    CcDecl* decl;               /* the declaring node, in this unit or a header unit */
    CcUnit* unit;
    CcType* type;               /* function type / variable type / aliased type */
} CcSym;
typedef CcSym* CcSymRef;

/* One entry of a type's method set. `callee` is the C function; `recv_by_ptr`
 * says whether the receiver is passed as `&recv`. `source` says where the
 * mapping came from, for diagnostics. */
typedef struct CcMethod {
    CCSlice method;
    CCSlice callee;
    bool recv_by_ptr;
    CCSlice source;             /* "@typehooks on T", "CC_MAP_DECL_UFCS", "Type_method", "cc_snake_method", "as: field" */
    CcSym* sym;
} CcMethod;

typedef struct CcTypeInfo {
    CCSlice name;               /* canonical: "CCString", "Map_int_int", "CCResult_int_CCError" */
    CcSym* sym;
    Vec::[CcMethod] methods;
    CCSlice destroy_fn;         /* @typehooks .destroy; empty when none */
    CCSlice create_fn;
    CCSlice pre_destroy_fn;
    Vec::[CCSlice] faces;       /* `as:` fields, in declaration order */
    bool is_result;
    CcType* result_value;
    CcType* result_err;
    bool result_optional;
    bool result_from_header;    /* spec declared by a header: do not re-emit */
} CcTypeInfo;
typedef CcTypeInfo* CcTypeInfoRef;

typedef struct CcIndex {
    CCArena arena;
    CcDiags* ds;
    Vec::[CcUnit*] units;       /* the unit plus each header unit, include order */
    Map::[CCSlice, CcSymRef] syms;
    Map::[CCSlice, CcTypeInfoRef] types;
    Vec::[CcTypeInfoRef] result_specs;      /* first-use order */
    Vec::[CCSlice] include_dirs;
    CCSlice quote_dir;
} CcIndex;

CcIndex* cc_index_new(Vec::[CCSlice] include_dirs, CCSlice quote_dir, CcDiags* ds, CCArena a);

/* ix.add_unit(u, is_header): declarations only for headers. */
void CcIndex_add_unit(CcIndex* ix, CcUnit* u, bool is_header);
/* ix.load_includes(u, opts): resolve the `#include` lines naming `.cch`
 * files, parse each once, add them. System headers are not read: C names
 * the lowerer does not reason about stay C. A `.cch` that cannot be found
 * or read is an error at the include line. */
void CcIndex_load_includes(CcIndex* ix, CcUnit* u, CcParseOpts opts);

/* Lookups. A miss is a Result error carrying the position-less reason;
 * the caller attaches the use site. */
CcSym*      !>(CcDiag) CcIndex_sym(CcIndex* ix, CCSlice name);
CcTypeInfo* !>(CcDiag) CcIndex_type(CcIndex* ix, CCSlice canonical);
/* ix.canon(t): canonical spelling of a type node, into `a`:
 * "int", "unsigned long", "struct Foo", "CCString", "CCResult_int_CCError",
 * "Map_int_int", "CCSlice" for char[:]. */
CCSlice CcIndex_canon(CcIndex* ix, const CcType* t, CCArena a);
/* ix.method(recv, name): the method, or an error whose note lists the near
 * misses, ready for the use site. */
CcMethod* !>(CcDiag) CcIndex_method(CcIndex* ix, CcTypeInfo* recv, CCSlice method, CCArena a);
/* ix.result(value, err, optional): register the spec and return its info;
 * the printer emits every entry not declared by a header, once. */
CcTypeInfo* CcIndex_result(CcIndex* ix, CcType* value, CcType* err, bool optional);
/* ix.arena_param(f): which parameter of `f` is its arena (attribute on the
 * declaration, or the trailing CCArena parameter); -1 when none. */
int CcIndex_arena_param(CcIndex* ix, CcSym* f);

@typeview Read on CcIndex { r: *; };

#endif

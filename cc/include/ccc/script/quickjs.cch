    cc_qjs_val_release(&r.u.value);
    if (!v.ok) return cc_err(v.u.error);
    if (v.u.value < (int64_t)INT_MIN || v.u.value > (int64_t)INT_MAX) {
        snprintf(cc__qjs_errbuf, sizeof(cc__qjs_errbuf),
                 "qjs: %s: result out of range for int destination",
                 method ? method : "call");
        return cc_err(cc__qjs_err(js, method));
    }
    return cc_ok((int)v.u.value);
}

/* ---- own::[T]: JS binds a CC object; bytes live in the handle arena ---- */

#define CC__QJS_OWN_KIND(ty)                                                   \
    (!(ty) || !(ty)[0]                                                         \
         ? -1                                                                  \
         : strcmp((ty), "void") == 0                                           \
               ? 0                                                             \
               : (strcmp((ty), "double") == 0 || strcmp((ty), "float") == 0)   \
                     ? 1                                                       \
                     : (strcmp((ty), "_Bool") == 0 || strcmp((ty), "bool") == 0) \
                           ? 2                                                 \
                           : (strcmp((ty), "int") == 0 ||                      \
                              strcmp((ty), "long") == 0 ||                     \
                              strcmp((ty), "long long") == 0 ||                \
                              strcmp((ty), "int64_t") == 0 ||                  \
                              strcmp((ty), "int32_t") == 0)                    \
                                 ? 3                                           \
                                 : -1)

CC_GENERIC_FACTORY(own, 1) {
    CCString s = cc_string_new();
    char T[192];
    int n, kept = 0, tn =
        (int)(arg(0).len < sizeof(T) - 1 ? arg(0).len : sizeof(T) - 1);
    memcpy(T, arg(0).ptr, (size_t)tn);
    T[tn] = '\0';
    n = cc_reflect_method_count(T);
    if (n < 0) {
        cc_emit_error("own::[T] needs a type with at least one method: a "
                      "function whose first parameter is T or T*");
        return cc_slice_empty();
    }
    cc_string_push_slice(&s, @emit(`
        static uint32_t cc__qjs_own_id_${arg(0)};
        static void *cc__qjs_own_rt_${arg(0)};
`, arena), arena);
    for (int i = 0; i < n; i++) {
        char nm[128], mb[128], pr[256], rt[128], er[128];
        int pn, k, j, ok;
        cc_reflect_method_name(T, i, nm, sizeof(nm));
        cc_reflect_method_member(T, i, mb, sizeof(mb));
        if (mb[0] == '_') continue;
        cc_reflect_method_params(T, i, pr, sizeof(pr));
        cc_reflect_method_ret(T, i, rt, sizeof(rt));
        cc_reflect_method_err(T, i, er, sizeof(er));
        if (er[0]) continue;
        pn = cc_reflect_param_count(pr);
        k = CC__QJS_OWN_KIND(rt);
        if (pn < 1 || k < 0) continue;
        ok = 1;
        for (j = 1; j < pn; j++) {
            char pty[192];
            cc_reflect_param_type(pr, j, pty, sizeof(pty));
            if (CC__QJS_OWN_KIND(pty) < 1) ok = 0;
        }
        if (!ok) continue;
        cc_string_push_slice(&s, @emit(`
        static CCQjsRaw cc__qjs_ownx_${nm}(void *ctx, CCQjsRaw this_v,
                int argc, CCQjsRaw *argv) {
            ${arg(0)} *self = (${arg(0)} *)cc__qjs.get_opaque(this_v,
                    cc__qjs_own_id_${arg(0)});
            if (!self)
                return cc__qjs.throw_type(ctx, "qjs: ${arg(0)} already released");
`, arena), arena);
        for (j = 1; j < pn; j++) {
            char pty[192], def[128];
            const char *init;
            int pk;
            cc_reflect_param_type(pr, j, pty, sizeof(pty));
            def[0] = 0;
            cc_reflect_param_default(pr, j, def, sizeof(def));
            init = def[0] ? def : "0";
            pk = CC__QJS_OWN_KIND(pty);
            if (pk == 1)
                cc_string_push_slice(&s, @emit(`
            double a${j} = ${init};
            if (argc >= ${j}) {
                if (cc__qjs.to_f64(ctx, argv[${j} - 1], &a${j}) != 0)
                    return cc__qjs.throw_type(ctx, "qjs: ${mb}: bad number");
            }
`, arena), arena);
            else if (pk == 2)
                cc_string_push_slice(&s, @emit(`
            int a${j} = ${init};
            if (argc >= ${j}) a${j} = cc__qjs.to_bool(ctx, argv[${j} - 1]);
`, arena), arena);
            else
                cc_string_push_slice(&s, @emit(`
            int64_t a${j} = ${init};
            if (argc >= ${j}) {
                if (cc__qjs.to_i64(ctx, argv[${j} - 1], &a${j}) != 0)
                    return cc__qjs.throw_type(ctx, "qjs: ${mb}: bad integer");
            }
`, arena), arena);
        }
        if (k == 0)
            cc_string_push_slice(&s, @emit(`
            ${nm}(self`, arena), arena);
        else if (k == 1)
            cc_string_push_slice(&s, @emit(`
            { double ret = ${nm}(self`, arena), arena);
        else if (k == 2)
            cc_string_push_slice(&s, @emit(`
            { int ret = ${nm}(self`, arena), arena);
        else
            cc_string_push_slice(&s, @emit(`
            { int64_t ret = ${nm}(self`, arena), arena);
        for (j = 1; j < pn; j++) {
            char pty[192];
            cc_reflect_param_type(pr, j, pty, sizeof(pty));
            cc_string_push_slice(&s, @emit(`, (${pty})a${j}`, arena), arena);
        }
        if (k == 0)
            cc_string_push_slice(&s, @emit(`);
            return cc__qjs.undefined();
        }
`, arena), arena);
        else if (k == 1)
            cc_string_push_slice(&s, @emit(`);
                return cc__qjs.new_f64(ctx, ret); }
        }
`, arena), arena);
        else if (k == 2)
            cc_string_push_slice(&s, @emit(`);
                return cc__qjs.new_bool(ctx, ret); }
        }
`, arena), arena);
        else
            cc_string_push_slice(&s, @emit(`);
                return cc__qjs.new_i64(ctx, ret); }
        }
`, arena), arena);
        kept++;
    }
    if (kept < 1) {
        cc_emit_error("own::[T] needs a scalar method (int/long/double/_Bool "
                      "args and return; fallible methods are skipped)");
        return cc_slice_empty();
    }
    cc_string_push_slice(&s, @emit(`
        static CCQjsVal !>(CCQjsError) ${mangled}(CCQjs *js, ${arg(0)} src) {
            ${arg(0)} *slot;
            CCQjsRaw o, fn;
            if (!js || !js->ready) {
                snprintf(cc__qjs_errbuf, sizeof(cc__qjs_errbuf),
                         "qjs: own: handle not ready");
                return cc_err(cc__qjs_err(js, "own"));
            }
            cc__qjs_bind_err_js(js);
            slot = (${arg(0)} *)cc_arena_alloc(js->arena, sizeof(${arg(0)}),
                                               _Alignof(${arg(0)}));
            if (!slot) {
                snprintf(cc__qjs_errbuf, sizeof(cc__qjs_errbuf),
                         "qjs: own: arena exhausted");
                return cc_err(cc__qjs_err(js, "own"));
            }
            *slot = src;
            if (!cc__qjs_own_id_${arg(0)})
                cc__qjs.new_class_id(js->rt, &cc__qjs_own_id_${arg(0)});
            if (cc__qjs_own_rt_${arg(0)} != js->rt) {
                (void)cc__qjs.new_class(js->rt, cc__qjs_own_id_${arg(0)},
                                        "${arg(0)}");
                cc__qjs_own_rt_${arg(0)} = js->rt;
            }
            o = cc__qjs.new_object_class(js->ctx, cc__qjs_own_id_${arg(0)});
            if (cc__qjs.is_exception(o)) {
                CCQjsError e;
                if (cc__qjs_take_exc(js, o, "own", &e)) return cc_err(e);
            }
            cc__qjs.set_opaque(o, slot);
`, arena), arena);
    for (int i = 0; i < n; i++) {
        char nm[128], mb[128], pr[256], rt[128], er[128];
        int pn;
        cc_reflect_method_name(T, i, nm, sizeof(nm));
        cc_reflect_method_member(T, i, mb, sizeof(mb));
        if (mb[0] == '_') continue;
        cc_reflect_method_params(T, i, pr, sizeof(pr));
        cc_reflect_method_ret(T, i, rt, sizeof(rt));
        cc_reflect_method_err(T, i, er, sizeof(er));
        if (er[0]) continue;
        if (CC__QJS_OWN_KIND(rt) < 0) continue;
        pn = cc_reflect_param_count(pr);
        {
            int ok = 1, k;
            for (k = 1; k < pn; k++) {
                char pty[192];
                cc_reflect_param_type(pr, k, pty, sizeof(pty));
                if (CC__QJS_OWN_KIND(pty) < 1) ok = 0;
            }
            if (!ok) continue;
        }
        cc_string_push_slice(&s, @emit(`
            fn = cc__qjs.new_cfunc(js->ctx, cc__qjs_ownx_${nm}, "${mb}",
                                   ${pn} - 1);
            if (cc__qjs.is_exception(fn)) {
                CCQjsError e;
                cc__qjs.free_value(js->ctx, o);
                if (cc__qjs_take_exc(js, fn, "own", &e)) return cc_err(e);
            }
            if (cc__qjs.set_prop(js->ctx, o, "${mb}", fn) < 0) {
                cc__qjs.free_value(js->ctx, o);
                snprintf(cc__qjs_errbuf, sizeof(cc__qjs_errbuf),
                         "qjs: own: cannot attach ${mb}");
                return cc_err(cc__qjs_err(js, "own"));
            }
`, arena), arena);
    }
    cc_string_push_slice(&s, @emit(`
            return cc_ok(cc__qjs_val(js, o));
        }
`, arena), arena);
    return cc_string_as_slice(&s);
}

@typehooks on CCQjs {
    .destroy = cc_type_destroy_call("cc_qjs_close"),
    .ufcs_sink = cc_type_dynamic_call("cc_qjs_callm", "CC_QJS_ARG"),
};
@typehooks on CCQjsVal {
    .destroy = cc_type_destroy_call("cc_qjs_val_release"),
    .ufcs_sink = cc_type_dynamic_call("cc_qjs_val_callm", "CC_QJS_ARG"),
};

#define cc_qjs_new(a) (cc_qjs_new)(CC__ARENA_HANDLE(a))
#define cc_qjs_val_as_slice_into(o, a) \
    (cc_qjs_val_as_slice_into)((o), CC__ARENA_HANDLE(a))

#endif /* CC_SCRIPT_QUICKJS_H */
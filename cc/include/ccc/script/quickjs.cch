    va_list ap;
    if (argc < 0) argc = 0;
    if (argc > CC__QJS_MAX_CALL_ARGS) argc = CC__QJS_MAX_CALL_ARGS;
    va_start(ap, argc);
    for (i = 0; i < argc; i++) tmp[i] = va_arg(ap, CCQjsArg);
    va_end(ap);
    return cc__qjs_host_callm_n(js, method, argc, tmp);
}


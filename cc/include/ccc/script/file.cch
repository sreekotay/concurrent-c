/*
 * Script file helpers: read/copy/print by path.
 * Path arguments are CCSlice (NUL-terminated borrows).
 */
#ifndef CC_SCRIPT_FILE_H
#define CC_SCRIPT_FILE_H

#include <errno.h>
#include <stdio.h>
#include <string.h>

#include <ccc/cc_arena.cch>
#include <ccc/cc_io_error.cch>
#include <ccc/cc_result.cch>
#include <ccc/cc_slice.cch>
#include <ccc/std/io.cch>

/* Read entire file at path into arena. Arena is last. */
static inline CCSlice !>(CCError) cc_file_read_path(CCSlice path, CCArena arena) {
    CCFile file;
    CCSlice !>(CCIoError) r;
    if (!path.ptr || !cc_arena_is_live(arena)) {
        return cc_err(CC_ERR_INVALID_ARG, "cc_file_read_path: bad args");
    }
    if (cc_file_open(&file, path, "rb") != 0) {
        return cc_err(
            CC_ERROR(CC_ERR_IO, cc_io_error_str(cc_io_from_errno(errno))));
    }
    r = cc_file_read_all(&file, arena);
    cc_file_close(&file);
    if (cc_is_err(r)) {
        return cc_err(
            CC_ERROR(CC_ERR_IO, cc_io_error_str(cc_error(r))));
    }
    return cc_ok(cc_value(r));
}

static inline size_t !>(CCError) cc_file_write_path(CCSlice path, CCSlice data) {
    CCFile file;
    size_t !>(CCIoError) r;
    if (!path.ptr) {
        return cc_err(CC_ERR_INVALID_ARG, "cc_file_write_path: bad path");
    }
    if (cc_file_open(&file, path, "wb") != 0) {
        return cc_err(
            CC_ERROR(CC_ERR_IO, cc_io_error_str(cc_io_from_errno(errno))));
    }
    r = cc_file_write(&file, data);
    cc_file_close(&file);
    if (cc_is_err(r)) {
        return cc_err(
            CC_ERROR(CC_ERR_IO, cc_io_error_str(cc_error(r))));
    }
    return cc_ok(cc_value(r));
}

static inline bool !>(CCError) cc_file_copy(CCSlice src, CCSlice dst, CCArena arena) {
    CCSlice !>(CCError) rr;
    size_t !>(CCError) wr;
    if (!cc_arena_is_live(arena) || !src.ptr || !dst.ptr) {
        return cc_err(CC_ERR_INVALID_ARG, "cc_file_copy: bad args");
    }
    rr = cc_file_read_path(src, arena);
    if (cc_is_err(rr)) {
        return cc_err(cc_error(rr));
    }
    wr = cc_file_write_path(dst, cc_value(rr));
    if (cc_is_err(wr)) {
        return cc_err(cc_error(wr));
    }
    return cc_ok(true);
}

static inline size_t !>(CCError) cc_script_print_file(CCSlice path, CCArena arena) {
    CCSlice !>(CCError) rr;
    size_t !>(CCIoError) wr;
    if (!cc_arena_is_live(arena) || !path.ptr) {
        return cc_err(CC_ERR_INVALID_ARG, "cc_script_print_file: bad args");
    }
    rr = cc_file_read_path(path, arena);
    if (cc_is_err(rr)) return cc_err(cc_error(rr));
    wr = cc_std_out_write(cc_value(rr));
    if (cc_is_err(wr)) {
        return cc_err(
            CC_ERROR(CC_ERR_IO, cc_io_error_str(cc_error(wr))));
    }
    return cc_ok(cc_value(wr));
}

#define cc_file_read_path(path, a) \
    (cc_file_read_path)((path), CC__ARENA_HANDLE(a))
#define cc_file_copy(src, dst, a) \
    (cc_file_copy)((src), (dst), CC__ARENA_HANDLE(a))
#define cc_script_print_file(path, a) \
    (cc_script_print_file)((path), CC__ARENA_HANDLE(a))

#endif /* CC_SCRIPT_FILE_H */

        CCJsVal *fobj, CCArena *arena, int esz, int isf, int argc,
        const CCJsArg *argv) {
    CCResult_CCSlice_CCJsError r =
        cc__js_val_map_raw(fobj, arena, esz, isf, argc, argv);

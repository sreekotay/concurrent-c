static inline CCSlice_long_long !>(CCJsError) cc__js_val_map_CCSlice_long_long(
        CCJsVal *fobj, CCArena *arena, int esz, int isf, int argc,
        const CCJsArg *argv) {
    CCSlice !>(CCJsError) r =

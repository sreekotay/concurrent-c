static inline CCSlice_int !>(CCJsError) cc__js_val_map_CCSlice_int(
        CCJsVal *fobj, CCArena *arena, int esz, int isf, int argc,
        const CCJsArg *argv) {
    CCSlice !>(CCJsError) r =
        cc__js_val_map_raw(fobj, arena, esz, isf, argc, argv);
    CCSlice_int out;
    if (!r.ok)
        return cc_err(r.u.error);

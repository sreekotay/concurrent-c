static inline CCResult_int_CCPyError cc_py_callm_int(
        CCPy *py, const char *method, int argc, ...) {
    CCPyArg tmp[CC__PY_MAX_CALL_ARGS];
    int i;
    CCResult_CCPyObj_CCPyError r;
    CCPyObj o;
    CCResult_int64_t_CCPyError v;
    va_list ap;
    if (argc < 0) argc = 0;
    if (argc > CC__PY_MAX_CALL_ARGS) argc = CC__PY_MAX_CALL_ARGS;
    va_start(ap, argc);
    for (i = 0; i < argc; i++) tmp[i] = va_arg(ap, CCPyArg);
    va_end(ap);
    r = cc__py_host_callm_n(py, method, argc, tmp);
    if (!r.ok) return cc_err_CCResult_int_CCPyError(r.u.error);
    o = r.u.value;
    v = cc__py_obj_take_i64(&o, method);
    cc_py_obj_release(&o);
    if (!v.ok) return cc_err_CCResult_int_CCPyError(v.u.error);
    if (v.u.value < (int64_t)INT_MIN || v.u.value > (int64_t)INT_MAX) {
        snprintf(cc__py_errbuf, sizeof(cc__py_errbuf),
                 "python: %s: result out of range for int destination",
                 method);
        return cc_err_CCResult_int_CCPyError(cc__py_err(method));
    }
    return cc_ok_CCResult_int_CCPyError((int)v.u.value);
}

/* str(obj) copied into `arena`; NUL-terminated (char[:0] compatible).
 * Slice provenance matches the arena epoch. */
static inline CCResult_CCSlice_CCPyError cc_py_obj_as_slice_into(CCPyObj *obj,
                                                                 CCArena *arena) {
    void *s;
    const char *msg;
    intptr_t n = 0;
    CCSlice out;
    cc__py_bind_err_obj(obj);
    if (!obj || !obj->o || !arena)
        return cc_err_CCResult_CCSlice_CCPyError(cc__py_err("as_slice"));
    s = cc__py.Str(obj->o);
    if (!s) return cc_err_CCResult_CCSlice_CCPyError(cc__py_err("as_slice"));
    msg = cc__py.AsUTF8AndSize(s, &n);
    if (!msg) {
        cc__py.DecRef(s);
        return cc_err_CCResult_CCSlice_CCPyError(cc__py_err("as_slice"));
    }
    /* +1 for trailing NUL; logical len stays `n` (NUL is capacity only). */
    out = cc_arena_alloc_slice_bytes(arena, (size_t)n + 1);
    if (!out.ptr) {
        cc__py.DecRef(s);
        snprintf(cc__py_errbuf, sizeof(cc__py_errbuf),
                 "python: as_slice: arena exhausted");
        return cc_err_CCResult_CCSlice_CCPyError(cc__py_err("as_slice"));
    }
    memcpy(out.ptr, msg, (size_t)n);
    ((char *)out.ptr)[n] = '\0';
    cc__py.DecRef(s);
    out.len = (size_t)n;
    return cc_ok_CCResult_CCSlice_CCPyError(out);
}

/* Default extract: copy into the home handle's scratch arena. */
static inline CCResult_CCSlice_CCPyError cc_py_obj_as_slice(CCPyObj *obj) {
    CCArena *arena = (obj && obj->home) ? obj->home->arena : NULL;
    return cc_py_obj_as_slice_into(obj, arena);
}


/* ============================================================
 * `py_expose::[T]` — a CC type becomes a Python module.
 *
 * The module IS the type: its methods are the module's functions and the
 * receiver is the module's per-interpreter state, which is the same reading of
 * "first parameter" the language already dispatches on.  Nothing new declares
 * what a member is.
 *
 *     py.expose::[Counter]("counter", &seed) !>;        // installs cc.counter
 *     py_expose::[Counter](&py, "counter", &seed) !>;   // the same call
 *
 * The registrar's own first parameter is the interpreter, so it reads under
 * the same rule it applies to the methods it exposes.  Both spellings name one
 * factory and lower to one monomorph.
 *
 * It returns the interpreter, so a registration is a link rather than a dead
 * end — including into another `expose`:
 *
 *     py.expose::[A]("a", &a)!>.expose::[B]("b", &b)!>.exec(src)!>;
 *
 * A member-generic hop resolves once the hop before it is hoisted into a
 * typed temp; the factory still reflects on the pre-lowering snapshot of the
 * TU, so a late instantiation generates what an early one would.
 *
 * The Python name is the method's UFCS member name — what a caller writes
 * after the dot in CC — so the export list and the callable list are one list,
 * while the long searchable symbol stays at file scope.
 *
 * A fragment is spliced ahead of the file's own definitions and is host C, so
 * each method is forward-declared and a fallible one is consumed through the
 * Result accessors rather than the sigil.
 * ============================================================ */
CC_GENERIC_FACTORY(py_expose, 1) {
    CCString s = cc_string_new();
    char T[192];
    int n, tn = (int)(arg(0).len < sizeof(T) - 1 ? arg(0).len : sizeof(T) - 1);
    /* `arg(i)` is a slice into the use site, not a C string. */
    memcpy(T, arg(0).ptr, (size_t)tn);
    T[tn] = '\0';
    n = cc_reflect_method_count(T);
    if (n < 0) {
        cc_emit_error("py_expose::[T] needs a type with at least one method: a "
                      "function whose first parameter is T or T*, declared "
                      "where the use site can see it");
        return cc_slice_empty();
    }
    for (int i = 0; i < n; i++) {
        char nm[128], mb[128], pr[256], ar[256], rt[128], er[128], box[256];
        char argc[16];
        int pn;
        cc_reflect_method_name(T, i, nm, sizeof(nm));
        cc_reflect_method_member(T, i, mb, sizeof(mb));
        /* An underscore member is internal: `T__helper` reflects as
         * `_helper` and is not exported — Python's own privacy signal,
         * applied at the boundary.  Wrap-and-export is the rename story:
         * the public method is one line, the implementation stays home. */
        if (mb[0] == '_') continue;
        cc_reflect_method_params(T, i, pr, sizeof(pr));
        cc_reflect_method_args(T, i, ar, sizeof(ar));
        cc_reflect_method_ret(T, i, rt, sizeof(rt));
        cc_reflect_method_err(T, i, er, sizeof(er));
        box[0] = '\0';
        if (er[0] && cc_result_box_name(rt, er, box, sizeof(box)) < 0) {
            cc_emit_error("py_expose::[T]: cannot name the Result box of a "
                          "fallible method");
            return cc_slice_empty();
        }
        pn = cc_reflect_param_count(pr);
        if (pn < 1) {
            cc_emit_error("py_expose::[T]: a method parameter is unnamed or "
                          "spelled in a form reflection cannot model");
            return cc_slice_empty();
        }
        {
            char pr_abi[256];
            if (cc_reflect_params_c_abi(pr, pr_abi, sizeof(pr_abi)) < 0) {
                cc_emit_error("py_expose::[T]: cannot strip parameter defaults "
                              "for a C forward declaration");
                return cc_slice_empty();
            }
            snprintf(argc, sizeof(argc), "%d", pn - 1);
            /* Index 0 is the receiver, so it binds the module state — under the
             * parameter's OWN name, because the call forwards by the reflected
             * argument list and that list spells the receiver the way the method
             * declared it. */
            /* A fallible method's box may be minted after this fragment splices,
             * so declare it here under its own guard: whichever declaration lands
             * first wins and the other is skipped. */
            if (er[0]) {
                cc_string_push_slice(&s, @emit(`
#ifndef ${box}_DEFINED
#define ${box}_DEFINED 1
CC_DECL_RESULT_SPEC(${box}, ${rt}, ${er})
#endif
`, arena), arena);
            }
            {
                char p0t[192], p0n[128];
                int p0ptr;
                cc_reflect_param_type(pr, 0, p0t, sizeof(p0t));
                cc_reflect_param_name(pr, 0, p0n, sizeof(p0n));
                p0ptr = p0t[0] && p0t[strlen(p0t) - 1] == '*';
                cc_string_push_slice(&s, @emit(`
            static ${er[0] ? box : rt} ${nm}${pr_abi};
            static void *cc__py_x_${nm}(void *mod__, void *const *args__,
                                        intptr_t nargs__, void *kwnames__) {
                ${arg(0)} *cc__st__ = (${arg(0)} *)cc__py.ModuleGetState(mod__);
                if (!cc__st__) return cc__py_raise("cc: module state unavailable");
                ${p0t} ${p0n} = ${p0ptr ? "cc__st__" : "*cc__st__"};`, arena), arena);
            }
            if (pn == 1) {
                cc_string_push_slice(&s, @emit(`
                if (cc__py_bind_fast(args__, nargs__, kwnames__, 0, NULL, NULL, NULL,
                                     "${mb}") != 0) return NULL;`, arena), arena);
            } else {
                char names_lit[1024];
                char opt_lit[512];
                size_t noff = 0, ooff = 0;
                int seen_default = 0;
                names_lit[0] = 0;
                opt_lit[0] = 0;
                for (int k = 1; k < pn; k++) {
                    char pnm[128], def[128];
                    int dlen;
                    cc_reflect_param_name(pr, k, pnm, sizeof(pnm));
                    dlen = cc_reflect_param_default(pr, k, def, sizeof(def));
                    if (dlen < 0) {
                        cc_emit_error("py_expose::[T]: malformed parameter default");
                        return cc_slice_empty();
                    }
                    if (dlen > 0) seen_default = 1;
                    else if (seen_default) {
                        cc_emit_error("py_expose::[T]: a required parameter follows "
                                      "one with a default — spell defaults on every "
                                      "trailing parameter");
                        return cc_slice_empty();
                    }
                    if (k > 1) {
                        if (noff + 2 >= sizeof(names_lit)) break;
                        names_lit[noff++] = ',';
                        names_lit[noff++] = ' ';
                        names_lit[noff] = 0;
                        if (ooff + 2 >= sizeof(opt_lit)) break;
                        opt_lit[ooff++] = ',';
                        opt_lit[ooff++] = ' ';
                        opt_lit[ooff] = 0;
                    }
                    {
                        int wr = snprintf(names_lit + noff, sizeof(names_lit) - noff,
                                          "\"%s\"", pnm);
                        if (wr < 0 || (size_t)wr >= sizeof(names_lit) - noff) break;
                        noff += (size_t)wr;
                        wr = snprintf(opt_lit + ooff, sizeof(opt_lit) - ooff,
                                      "%u", dlen > 0 ? 1u : 0u);
                        if (wr < 0 || (size_t)wr >= sizeof(opt_lit) - ooff) break;
                        ooff += (size_t)wr;
                    }
                }
                cc_string_push_slice(&s, @emit(`
                static const char *const names__[] = { ${names_lit} };
                static const unsigned char optional__[] = { ${opt_lit} };
                void *bound__[${argc}];
                if (cc__py_bind_fast(args__, nargs__, kwnames__, ${argc}, names__,
                                     optional__, bound__, "${mb}") != 0) return NULL;`, arena), arena);
                {
                    char pty[192], pnm[128], idx[16], def[128];
                    for (int k = 1; k < pn; k++) {
                        int dlen;
                        cc_reflect_param_type(pr, k, pty, sizeof(pty));
                        cc_reflect_param_name(pr, k, pnm, sizeof(pnm));
                        dlen = cc_reflect_param_default(pr, k, def, sizeof(def));
                        snprintf(idx, sizeof(idx), "%d", k - 1);
                        if (dlen > 0) {
                            cc_string_push_slice(&s, @emit(`
                ${pty} ${pnm};
                if (!bound__[${idx}]) ${pnm} = ${def};
                else if (CC_PY_IN(${pnm}, bound__[${idx}]) != 0) return NULL;`, arena), arena);
                        } else {
                            cc_string_push_slice(&s, @emit(`
                ${pty} ${pnm};
                if (CC_PY_IN(${pnm}, bound__[${idx}]) != 0) return NULL;`, arena), arena);
                        }
                    }
                }
            }
        }
        /* A CC error becomes a Python exception at the boundary: a Result is
         * not something a Python caller can act on. */
        if (er[0]) {
            cc_string_push_slice(&s, @emit(`
                { ${box} r__ = ${nm}${ar};
                  if (!cc_is_ok(r__))
                      return cc__py_raise_cc_error((int)cc_error(r__).kind,
                                                   cc_error(r__).message);`, arena), arena);
            if (rt[0] == 'v' && rt[1] == 'o')
                cc_string_push_slice(&s, @emit(`
                  return cc__py_none(); } }`, arena), arena);
            else
                cc_string_push_slice(&s, @emit(`
                  { ${rt} v__ = cc_value(r__); return CC_PY_OUT(v__); } } }`, arena), arena);
        } else if (rt[0] == 'v' && rt[1] == 'o') {
            cc_string_push_slice(&s, @emit(`
                ${nm}${ar};
                return cc__py_none(); }`, arena), arena);
        } else {
            cc_string_push_slice(&s, @emit(`
                { ${rt} v__ = ${nm}${ar}; return CC_PY_OUT(v__); } }`, arena), arena);
        }
    }
    cc_string_push_slice(&s, @emit(`
        static CC__PyMethodDef cc__py_tbl_${mangled}[] = {`, arena), arena);
    for (int i = 0; i < n; i++) {
        char nm[128], mb[128];
        cc_reflect_method_name(T, i, nm, sizeof(nm));
        cc_reflect_method_member(T, i, mb, sizeof(mb));
        if (mb[0] == '_') continue;
        cc_string_push_slice(&s, @emit(`
            { "${mb}", (void *)cc__py_x_${nm}, CC__PY_METH_FASTCALL_KEYWORDS, "${mb}" },`, arena), arena);
    }
    cc_string_push_slice(&s, @emit(`
            { 0, 0, 0, 0 }
        };
        /* Returns the interpreter, so exposing several types is one chain:
         *     py.expose::[A]("a", &a) !> .expose::[B]("b", &b) !>;
         * A registrar that returned void would end the chain at the first
         * link and force a statement per module. */
        static CCResult_CCPyptr_CCError ${mangled}(CCPy *py, const char *name,
                                                   const ${arg(0)} *seed) {
            /* Registration fails host-side — no interpreter, no module — so it
             * reports a plain CCError rather than a Python exception nobody
             * raised. */
            if (!py || !py->ready)
                return cc_err_CCResult_CCPyptr_CCError(
                    CC_ERROR(CC_ERR_INVALID_ARG, "py_expose: interpreter not ready"));
            cc__py_bind_err_py(py);
            if (cc__py_register_module(name, cc__py_tbl_${mangled},
                                       (intptr_t)sizeof(${arg(0)}), seed) != 0)
                return cc_err_CCResult_CCPyptr_CCError(
                    CC_ERROR(CC_ERR_INTERNAL, "py_expose: module registration failed"));
            return cc_ok_CCResult_CCPyptr_CCError(py);
        }`, arena), arena);
    return cc_string_as_slice(&s);
}

/* ============================================================
 * `py_module::[T]` — the same exposure, pointed the other way: Python
 * imports US.  Where `py_expose` installs a module into an interpreter
 * the CC program owns, `py_module` CREATES the module and returns it,
 * which is exactly what a CPython extension entry point must do:
 *
 *     void *PyInit_counter(void) {
 *         return py_module::[Counter]("counter", NULL);
 *     }
 *
 * `ccc build` sees the exported `PyInit_<name>` (and no `main`) and
 * links a shared object — the source declares what it is; there is no
 * flag.  The seed may be NULL for zeroed module state.
 *
 * The CALLER is CPython's import machinery: `import counter` matches
 * counter.abi3.so on sys.path, dlopens it, and derives the symbol from
 * the module name — "PyInit_" + name — which is why the symbol, the
 * factory's name string, and the artifact filename are one name spelled
 * three ways, and the build's naming rule keeps them from drifting.
 * Called once per interpreter: under multi-phase init the return is the
 * module DEFINITION and each (sub)interpreter builds its own module
 * from it, seeding fresh state — the twin of Node calling the napi
 * entry once per worker environment.  Failure follows Python's
 * convention — NULL, with the exception set when an interpreter exists
 * to hold one — not a CC Result.  The method trampolines are the same
 * shape `py_expose` emits (same reflection, same marshal macros), under
 * a distinct symbol prefix so both factories can instantiate for one
 * type in one TU. */
CC_GENERIC_FACTORY(py_module, 1) {
    CCString s = cc_string_new();
    char T[192];
    int n, tn = (int)(arg(0).len < sizeof(T) - 1 ? arg(0).len : sizeof(T) - 1);
    memcpy(T, arg(0).ptr, (size_t)tn);
    T[tn] = '\0';
    n = cc_reflect_method_count(T);
    if (n < 0) {
        cc_emit_error("py_module::[T] needs a type with at least one method: a "
                      "function whose first parameter is T or T*, declared "
                      "where the use site can see it");
        return cc_slice_empty();
    }
    for (int i = 0; i < n; i++) {
        char nm[128], mb[128], pr[256], ar[256], rt[128], er[128], box[256];
        char argc[16];
        int pn;
        cc_reflect_method_name(T, i, nm, sizeof(nm));
        cc_reflect_method_member(T, i, mb, sizeof(mb));
        /* An underscore member is internal: `T__helper` reflects as
         * `_helper` and is not exported — Python's own privacy signal,
         * applied at the boundary.  Wrap-and-export is the rename story:
         * the public method is one line, the implementation stays home. */
        if (mb[0] == '_') continue;
        cc_reflect_method_params(T, i, pr, sizeof(pr));
        cc_reflect_method_args(T, i, ar, sizeof(ar));
        cc_reflect_method_ret(T, i, rt, sizeof(rt));
        cc_reflect_method_err(T, i, er, sizeof(er));
        box[0] = '\0';
        if (er[0] && cc_result_box_name(rt, er, box, sizeof(box)) < 0) {
            cc_emit_error("py_module::[T]: cannot name the Result box of a "
                          "fallible method");
            return cc_slice_empty();
        }
        pn = cc_reflect_param_count(pr);
        if (pn < 1) {
            cc_emit_error("py_module::[T]: a method parameter is unnamed or "
                          "spelled in a form reflection cannot model");
            return cc_slice_empty();
        }
        {
            char pr_abi[256];
            if (cc_reflect_params_c_abi(pr, pr_abi, sizeof(pr_abi)) < 0) {
                cc_emit_error("py_module::[T]: cannot strip parameter defaults "
                              "for a C forward declaration");
                return cc_slice_empty();
            }
            snprintf(argc, sizeof(argc), "%d", pn - 1);
            if (er[0]) {
                cc_string_push_slice(&s, @emit(`
#ifndef ${box}_DEFINED
#define ${box}_DEFINED 1
CC_DECL_RESULT_SPEC(${box}, ${rt}, ${er})
#endif
`, arena), arena);
            }
            {
                char p0t[192], p0n[128];
                int p0ptr;
                cc_reflect_param_type(pr, 0, p0t, sizeof(p0t));
                cc_reflect_param_name(pr, 0, p0n, sizeof(p0n));
                p0ptr = p0t[0] && p0t[strlen(p0t) - 1] == '*';
                cc_string_push_slice(&s, @emit(`
            static ${er[0] ? box : rt} ${nm}${pr_abi};
            static void *cc__py_m_${nm}(void *mod__, void *const *args__,
                                        intptr_t nargs__, void *kwnames__) {
                ${arg(0)} *cc__st__ = (${arg(0)} *)cc__py.ModuleGetState(mod__);
                if (!cc__st__) return cc__py_raise("cc: module state unavailable");
                ${p0t} ${p0n} = ${p0ptr ? "cc__st__" : "*cc__st__"};`, arena), arena);
            }
            if (pn == 1) {
                cc_string_push_slice(&s, @emit(`
                if (cc__py_bind_fast(args__, nargs__, kwnames__, 0, NULL, NULL, NULL,
                                     "${mb}") != 0) return NULL;`, arena), arena);
            } else {
                char names_lit[1024];
                char opt_lit[512];
                size_t noff = 0, ooff = 0;
                int seen_default = 0;
                names_lit[0] = 0;
                opt_lit[0] = 0;
                for (int k = 1; k < pn; k++) {
                    char pnm[128], def[128];
                    int dlen;
                    cc_reflect_param_name(pr, k, pnm, sizeof(pnm));
                    dlen = cc_reflect_param_default(pr, k, def, sizeof(def));
                    if (dlen < 0) {
                        cc_emit_error("py_module::[T]: malformed parameter default");
                        return cc_slice_empty();
                    }
                    if (dlen > 0) seen_default = 1;
                    else if (seen_default) {
                        cc_emit_error("py_module::[T]: a required parameter follows "
                                      "one with a default — spell defaults on every "
                                      "trailing parameter");
                        return cc_slice_empty();
                    }
                    if (k > 1) {
                        if (noff + 2 >= sizeof(names_lit)) break;
                        names_lit[noff++] = ',';
                        names_lit[noff++] = ' ';
                        names_lit[noff] = 0;
                        if (ooff + 2 >= sizeof(opt_lit)) break;
                        opt_lit[ooff++] = ',';
                        opt_lit[ooff++] = ' ';
                        opt_lit[ooff] = 0;
                    }
                    {
                        int wr = snprintf(names_lit + noff, sizeof(names_lit) - noff,
                                          "\"%s\"", pnm);
                        if (wr < 0 || (size_t)wr >= sizeof(names_lit) - noff) break;
                        noff += (size_t)wr;
                        wr = snprintf(opt_lit + ooff, sizeof(opt_lit) - ooff,
                                      "%u", dlen > 0 ? 1u : 0u);
                        if (wr < 0 || (size_t)wr >= sizeof(opt_lit) - ooff) break;
                        ooff += (size_t)wr;
                    }
                }
                cc_string_push_slice(&s, @emit(`
                static const char *const names__[] = { ${names_lit} };
                static const unsigned char optional__[] = { ${opt_lit} };
                void *bound__[${argc}];
                if (cc__py_bind_fast(args__, nargs__, kwnames__, ${argc}, names__,
                                     optional__, bound__, "${mb}") != 0) return NULL;`, arena), arena);
                {
                    char pty[192], pnm[128], idx[16], def[128];
                    for (int k = 1; k < pn; k++) {
                        int dlen;
                        cc_reflect_param_type(pr, k, pty, sizeof(pty));
                        cc_reflect_param_name(pr, k, pnm, sizeof(pnm));
                        dlen = cc_reflect_param_default(pr, k, def, sizeof(def));
                        snprintf(idx, sizeof(idx), "%d", k - 1);
                        if (dlen > 0) {
                            cc_string_push_slice(&s, @emit(`
                ${pty} ${pnm};
                if (!bound__[${idx}]) ${pnm} = ${def};
                else if (CC_PY_IN(${pnm}, bound__[${idx}]) != 0) return NULL;`, arena), arena);
                        } else {
                            cc_string_push_slice(&s, @emit(`
                ${pty} ${pnm};
                if (CC_PY_IN(${pnm}, bound__[${idx}]) != 0) return NULL;`, arena), arena);
                        }
                    }
                }
            }
        }
        if (er[0]) {
            cc_string_push_slice(&s, @emit(`
                { ${box} r__ = ${nm}${ar};
                  if (!cc_is_ok(r__))
                      return cc__py_raise_cc_error((int)cc_error(r__).kind,
                                                   cc_error(r__).message);`, arena), arena);
            if (rt[0] == 'v' && rt[1] == 'o')
                cc_string_push_slice(&s, @emit(`
                  return cc__py_none(); } }`, arena), arena);
            else
                cc_string_push_slice(&s, @emit(`
                  { ${rt} v__ = cc_value(r__); return CC_PY_OUT(v__); } } }`, arena), arena);
        } else if (rt[0] == 'v' && rt[1] == 'o') {
            cc_string_push_slice(&s, @emit(`
                ${nm}${ar};
                return cc__py_none(); }`, arena), arena);
        } else {
            cc_string_push_slice(&s, @emit(`
                { ${rt} v__ = ${nm}${ar}; return CC_PY_OUT(v__); } }`, arena), arena);
        }
    }
    char destroy_sym[128];
    destroy_sym[0] = 0;
    for (int i = 0; i < n; i++) {
        char nm[128], mb[128];
        cc_reflect_method_name(T, i, nm, sizeof(nm));
        cc_reflect_method_member(T, i, mb, sizeof(mb));
        if (strcmp(mb, "destroy") == 0) {
            snprintf(destroy_sym, sizeof(destroy_sym), "%s", nm);
            break;
        }
    }
    cc_string_push_slice(&s, @emit(`
        static CC__PyMethodDef cc__py_tbl_${mangled}[] = {`, arena), arena);
    for (int i = 0; i < n; i++) {
        char nm[128], mb[128];
        cc_reflect_method_name(T, i, nm, sizeof(nm));
        cc_reflect_method_member(T, i, mb, sizeof(mb));
        if (mb[0] == '_') continue;
        cc_string_push_slice(&s, @emit(`
            { "${mb}", (void *)cc__py_m_${nm}, CC__PY_METH_FASTCALL_KEYWORDS, "${mb}" },`, arena), arena);
    }
    cc_string_push_slice(&s, @emit(`
            { 0, 0, 0, 0 }
        };
        static const ${arg(0)} *cc__py_seed_${mangled};
        static int cc__py_exec_${mangled}(void *m__) {
            ${arg(0)} *st = (${arg(0)} *)cc__py.ModuleGetState(m__);
            if (!st) return -1;
            if (cc__py_seed_${mangled}) memcpy(st, cc__py_seed_${mangled}, sizeof(*st));
            else memset(st, 0, sizeof(*st));
            return 0;
        }`, arena), arena);
    if (destroy_sym[0]) {
        /* The type's own `destroy` method is the module state's teardown:
         * m_free runs it when the module object deallocates, the same
         * lifecycle rule `@destroy` applies everywhere else. */
        cc_string_push_slice(&s, @emit(`
        static void cc__py_mfree_${mangled}(void *m__) {
            ${arg(0)} *st = (${arg(0)} *)cc__py.ModuleGetState(m__);
            if (st) ${destroy_sym}(st);
        }`, arena), arena);
    }
    cc_string_push_slice(&s, @emit(`
        static void *${mangled}(const char *name, const ${arg(0)} *seed) {
            static CC__PyModuleDef def;
            static CC__PyModuleDef_Slot slots[2];
            char *nm;
            size_t ln;
            /* The import machinery calls PyInit_ with the interpreter live
             * and the GIL held; the loader self-probe finds its symbols in
             * this very process.  Never initialize here — we are a guest. */
            if (cc__py_load() != 0 || !cc__py.IsInitialized())
                return NULL;
            if (!name || !name[0])
                return cc__py_raise("cc: py_module needs a module name");
            cc__py_seed_${mangled} = seed;
            ln = strlen(name);
            nm = (char *)malloc(ln + 1);
            if (!nm) return cc__py_raise("cc: out of memory");
            memcpy(nm, name, ln + 1);
            if (cc__py.ModuleDefInit) {
                /* Multi-phase init: PyInit returns the DEF, and the import
                 * machinery creates the module and runs the exec slot — per
                 * import, so importlib.reload re-seeds the state and a
                 * legacy sub-interpreter gets its own instance.  The def
                 * carries no multiple-interpreters slot: isolated
                 * (per-interpreter GIL) interpreters stay refused until the
                 * binding's process-global error scratch is honest there. */
                if (!def.m_name) {
                    def.ob_head[0] = (void *)(intptr_t)1;
                    def.m_name = nm;
                    def.m_doc = "CC extension module";
                    def.m_size = (intptr_t)sizeof(${arg(0)});
                    def.m_methods = cc__py_tbl_${mangled};
                    slots[0].slot = CC__PY_MOD_EXEC;
                    slots[0].value = (void *)cc__py_exec_${mangled};
                    def.m_slots = slots;`, arena), arena);
    if (destroy_sym[0]) {
        cc_string_push_slice(&s, @emit(`
                    def.m_free = (void *)cc__py_mfree_${mangled};`, arena), arena);
    }
    cc_string_push_slice(&s, @emit(`
                } else {
                    free(nm); /* def already built (re-import): name kept from the first */
                }
                return cc__py.ModuleDefInit(&def);
            }
            /* Single-phase fallback for runtimes without PyModuleDef_Init:
             * create-and-seed here; reload keeps state, sub-interpreters
             * refuse the module. */
            {
                CC__PyModuleDef *hdef = cc__py_def_new(nm, "CC extension module",
                                                       (intptr_t)sizeof(${arg(0)}),
                                                       cc__py_tbl_${mangled});
                void *m;
                if (!hdef) { free(nm); return cc__py_raise("cc: module def allocation failed"); }
                m = cc__py.ModuleCreate2(hdef, CC__PY_API_VERSION);
                if (!m) return NULL; /* exception already set */
                if (cc__py_exec_${mangled}(m) != 0) return cc__py_raise("cc: module state unavailable");
                return m;
            }
        }`, arena), arena);
    return cc_string_as_slice(&s);
}

#ifdef CC_COMPTIME_SCAN
@comptime {
    (void)cc_type_register("CCPy", (CCTypeHooks){
        .destroy = cc_type_destroy_call("cc_py_close"),
        .ufcs_dynamic2 = cc_type_dynamic_call("cc_py_callm", "CC_PY_ARG"),
    });
    (void)cc_type_register("CCPyObj", (CCTypeHooks){
        .destroy = cc_type_destroy_call("cc_py_obj_release"),
        .ufcs_dynamic2 = cc_type_dynamic_call("cc_py_obj_callm", "CC_PY_ARG"),
    });
}
#endif

#endif /* CC_SCRIPT_PY_H */

    va_end(ap);
    r = cc__py_host_callm_n(py, method, argc, tmp);
    if (!r.ok) return cc_err_CCResult_int64_t_CCPyError(r.u.error);
    o = r.u.value;
    out = cc__py_obj_take_i64(&o, method);
    cc_py_obj_release(&o);

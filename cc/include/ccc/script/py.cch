}

static inline CCResult_long_long_CCPyError cc_py_callm_long_long(
        CCPy *py, const char *method, int argc, ...) {
    CCPyArg tmp[CC__PY_MAX_CALL_ARGS];
    int i;
    CCResult_CCPyObj_CCPyError r;
    CCPyObj o;
    CCResult_int64_t_CCPyError v;
    va_list ap;
    if (argc < 0) argc = 0;

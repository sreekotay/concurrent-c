/*
 * IdTable::[V] — recycled int ids, stable slots, optional pack.
 *
 *   id = t->put(row)     // >0, or 0
 *   t->get(id)           // V*, or null
 *   t->gen(id)           // occupancy stamp (0 if absent); for udata ABA
 *   t->drop(id)          // hole; other V* stay put. 0 ok, -1 miss
 *   t->compact()         // pack live rows to the front; only this moves V*
 *   t->len()             // live
 *   t->span()            // walk bound; == len() after compact()
 *   t->at(i, &id)        // V* or null (hole)
 *   t->destroy()
 *
 * Not a hash map and not a TTL store. cc_id_pack / cc_id_unpack_* tag udata.
 */
#ifndef CC_STD_ID_TABLE_H
#define CC_STD_ID_TABLE_H

#include "vec.cch"

#ifdef __CC_ID_TABLE
#undef __CC_ID_TABLE
#endif
#ifdef __CC_ID_TABLE_INIT
#undef __CC_ID_TABLE_INIT
#endif
#define __CC_ID_TABLE(V) IdTable_##V
#define __CC_ID_TABLE_INIT(V, arena) \
    IdTable_##V##_init(CC__ARENA_HANDLE(arena))

static inline uint64_t cc_id_pack(int id, uint32_t gen) {
    return ((uint64_t)gen << 32) | (uint32_t)id;
}
static inline int cc_id_unpack_id(uint64_t pack) {
    return (int)(uint32_t)pack;
}
static inline uint32_t cc_id_unpack_gen(uint64_t pack) {
    return (uint32_t)(pack >> 32);
}

#if defined(CC_COMPTIME) || defined(__TINYC__)
#include <stdio.h>
#include <string.h>
#endif
CC_GENERIC_FACTORY(IdTable, 1) {
    char v[80], compact[80];
    char newfn[96];
    size_t vn = arg(0).len < sizeof(v) - 1 ? arg(0).len : sizeof(v) - 1;
    memcpy(v, arg(0).ptr, vn);
    v[vn] = 0;
    compact[0] = 0;
    if (mangled.len > 8 && memcmp(mangled.ptr, "IdTable_", 8) == 0) {
        size_t cl = mangled.len - 8;
        if (cl >= sizeof(compact)) cl = sizeof(compact) - 1;
        memcpy(compact, mangled.ptr + 8, cl);
        compact[cl] = 0;
    }
    snprintf(newfn, sizeof(newfn), "id_table_new_%s", compact);
    return @emit(`
#ifdef CC_FRAGMENT_VALIDATE
typedef struct ${mangled}_chk { char _; } ${mangled}_chk;
static inline ${mangled}_chk* ${mangled}_chk_p(void *a) {
    (void)a; return (${mangled}_chk*)0;
}
#else
typedef struct ${mangled}Slot {
    int id;             /* 0 = hole */
    uint32_t gen;
    ${v} val;
} ${mangled}Slot;

CC_VEC_DECL_ARENA(${mangled}Slot, ${mangled}SlotVec)
CC_VEC_DECL_ARENA(int, ${mangled}IxVec)
CC_VEC_DECL_ARENA(uint32_t, ${mangled}DiVec)

typedef struct ${mangled} {
    ${mangled}SlotVec slots;     /* span; holes have id == 0 */
    ${mangled}IxVec free_slots;  /* hole indices */
    ${mangled}IxVec free_ids;    /* recycled ids, LIFO */
    ${mangled}DiVec id_slot;     /* id → slot+1; 0 absent. [0] unused */
    int id_next;
    uint32_t stamp;
    size_t nlive;
} ${mangled};

static inline int ${mangled}_id_slot_ensure(${mangled}* t, int id) {
    if (!t || id < 0) return -1;
    while (t->id_slot.len <= (size_t)id) {
        if (${mangled}DiVec_push(&t->id_slot, 0) != 0) return -1;
    }
    return 0;
}
static inline void ${mangled}_id_slot_set(${mangled}* t, int id, uint32_t di1) {
    if (${mangled}_id_slot_ensure(t, id) != 0) return;
    if ((size_t)id < t->id_slot.len) t->id_slot.data[id] = di1;
}
static inline uint32_t ${mangled}_id_slot_get(${mangled}* t, int id) {
    if (!t || id <= 0 || (size_t)id >= t->id_slot.len) return 0;
    return t->id_slot.data[id];
}

static inline ${mangled}* ${mangled}_init(CCArena arena) {
    ${mangled}* t;
    if (!cc_arena_is_live(arena)) return NULL;
    t = (${mangled}*)cc_arena_alloc(arena, sizeof(${mangled}), _Alignof(${mangled}));
    if (!t) return NULL;
    *t = (${mangled}){
        .slots = ${mangled}SlotVec_init(arena, 0),
        .free_slots = ${mangled}IxVec_init(arena, 0),
        .free_ids = ${mangled}IxVec_init(arena, 0),
        .id_slot = ${mangled}DiVec_init(arena, 0),
        .id_next = 1,
        .stamp = 0,
        .nlive = 0,
    };
    if (${mangled}DiVec_push(&t->id_slot, 0) != 0) return NULL;
    return t;
}
static inline ${mangled}* cc__${newfn}(CCArena __a) {
    return ${mangled}_init(__a);
}
#define ${newfn}(ar) cc__${newfn}(CC__ARENA_HANDLE(ar))
static inline ${mangled}* cc__${mangled}_new(CCArena __a) {
    return ${mangled}_init(__a);
}
#define ${mangled}_new(ar) cc__${mangled}_new(CC__ARENA_HANDLE(ar))

static inline void ${mangled}_destroy(${mangled}* t) {
    if (!t) return;
    ${mangled}SlotVec_destroy(&t->slots);
    ${mangled}IxVec_destroy(&t->free_slots);
    ${mangled}IxVec_destroy(&t->free_ids);
    ${mangled}DiVec_destroy(&t->id_slot);
}

static inline size_t ${mangled}_len(const ${mangled}* t) {
    return t ? t->nlive : 0;
}
static inline size_t ${mangled}_span(const ${mangled}* t) {
    return t ? t->slots.len : 0;
}

static inline ${v}* ${mangled}_at(${mangled}* t, size_t i, int* out_id) {
    ${mangled}Slot* s;
    if (!t || i >= t->slots.len) return NULL;
    s = &t->slots.data[i];
    if (s->id == 0) return NULL;
    if (out_id) *out_id = s->id;
    return &s->val;
}

static inline ${v}* ${mangled}_get(${mangled}* t, int id) {
    uint32_t di1;
    ${mangled}Slot* s;
    if (!t || id <= 0) return NULL;
    di1 = ${mangled}_id_slot_get(t, id);
    if (!di1 || (size_t)(di1 - 1u) >= t->slots.len) return NULL;
    s = &t->slots.data[di1 - 1u];
    if (s->id != id) return NULL;
    return &s->val;
}

static inline uint32_t ${mangled}_gen(${mangled}* t, int id) {
    uint32_t di1;
    ${mangled}Slot* s;
    if (!t || id <= 0) return 0;
    di1 = ${mangled}_id_slot_get(t, id);
    if (!di1 || (size_t)(di1 - 1u) >= t->slots.len) return 0;
    s = &t->slots.data[di1 - 1u];
    return s->id == id ? s->gen : 0;
}

static inline int ${mangled}_alloc_id(${mangled}* t) {
    int id;
    if (!t) return 0;
    if (t->free_ids.len > 0) {
        id = t->free_ids.data[t->free_ids.len - 1];
        ${mangled}IxVec_truncate(&t->free_ids, t->free_ids.len - 1);
        return id;
    }
    if (t->id_next <= 0) t->id_next = 1;
    id = t->id_next++;
    if (id <= 0) return 0;
    return id;
}

static inline int ${mangled}_put(${mangled}* t, ${v} row) {
    ${mangled}Slot slot;
    int id;
    size_t si;
    if (!t) return 0;
    id = ${mangled}_alloc_id(t);
    if (id <= 0) return 0;
    t->stamp++;
    if (t->stamp == 0) t->stamp = 1;
    slot.id = id;
    slot.gen = t->stamp;
    slot.val = row;
    if (t->free_slots.len > 0) {
        si = (size_t)t->free_slots.data[t->free_slots.len - 1];
        ${mangled}IxVec_truncate(&t->free_slots, t->free_slots.len - 1);
        if (si >= t->slots.len) {
            ${mangled}IxVec_push(&t->free_ids, id);
            return 0;
        }
        t->slots.data[si] = slot;
    } else {
        si = t->slots.len;
        if (${mangled}SlotVec_push(&t->slots, slot) != 0) {
            ${mangled}IxVec_push(&t->free_ids, id);
            return 0;
        }
    }
    ${mangled}_id_slot_set(t, id, (uint32_t)si + 1u);
    t->nlive++;
    return id;
}

static inline int ${mangled}_drop(${mangled}* t, int id) {
    uint32_t di1;
    size_t si;
    ${mangled}Slot* s;
    if (!t || id <= 0) return -1;
    di1 = ${mangled}_id_slot_get(t, id);
    if (!di1) return -1;
    si = (size_t)(di1 - 1u);
    if (si >= t->slots.len) return -1;
    s = &t->slots.data[si];
    if (s->id != id) return -1;
    s->id = 0;
    s->gen = 0;
    t->id_slot.data[id] = 0;
    if (${mangled}IxVec_push(&t->free_slots, (int)si) != 0) return -1;
    if (${mangled}IxVec_push(&t->free_ids, id) != 0) return -1;
    if (t->nlive) t->nlive--;
    return 0;
}

/* Pack live slots to [0, len). Invalidates V* from before the call. */
static inline void ${mangled}_compact(${mangled}* t) {
    size_t i, w, n;
    if (!t) return;
    n = t->slots.len;
    w = 0;
    for (i = 0; i < n; i++) {
        ${mangled}Slot* s = &t->slots.data[i];
        int id;
        if (s->id == 0) continue;
        id = s->id;
        if (w != i) {
            t->slots.data[w] = *s;
            s->id = 0;
        }
        t->id_slot.data[id] = (uint32_t)w + 1u;
        w++;
    }
    ${mangled}SlotVec_truncate(&t->slots, w);
    ${mangled}IxVec_truncate(&t->free_slots, 0);
}
#endif
`, arena);
}

@typehooks on IdTable_* {
    .create = cc_type_create_call("_new"),
    .destroy = cc_type_destroy_call("_destroy"),
};

#endif /* CC_STD_ID_TABLE_H */

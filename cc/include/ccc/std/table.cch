/*
 * Arena-backed row table: one generation of dense (key, value) rows plus a
 * maintained Find index (pow2 u32 probe). Map-shaped face for the 1-gen case.
 *
 * Prefer Table::[K,V] for new code. ArrayMap is the frozen predecessor with
 * the same core (cc_array_map_core_*); do not extend it.
 *
 * Sugar: Table::[K,V] / table_new::[K,V] / table_new_count::[K,V].
 * Concrete type is Table_<K>_<V>* (arena header — arrow UFCS).
 */
#ifndef CC_STD_TABLE_H
#define CC_STD_TABLE_H

#include "array_map.cch"

#ifdef __CC_TABLE
#undef __CC_TABLE
#endif
#ifdef __CC_TABLE_INIT
#undef __CC_TABLE_INIT
#endif
#ifdef __CC_TABLE_INIT_COUNT
#undef __CC_TABLE_INIT_COUNT
#endif
#define __CC_TABLE(K, V) Table_##K##_##V
#define __CC_TABLE_INIT(K, V, arena) \
    Table_##K##_##V##_init(CC__ARENA_HANDLE(arena))
#define __CC_TABLE_INIT_COUNT(K, V, arena, count) \
    Table_##K##_##V##_init_count(CC__ARENA_HANDLE(arena), (count))

/* Same layout and core as ArrayMap; Name is Table_<K>_<V>. */
#define CC_TABLE_DECL(K, V, Name, HASH_FN, EQ_FN) \
    CC_ARRAY_MAP_DECL(K, V, Name, HASH_FN, EQ_FN)

#define Table(K, V, Name, HASH_FN, EQ_FN) \
    CC_TABLE_DECL(K, V, Name, HASH_FN, EQ_FN)

#define CC_TABLE_FOREACH(h, k_var, v_var) CC_ARRAY_MAP_FOREACH(h, k_var, v_var)

#define CC_TABLE_DECL_UFCS(Name) typedef char __cc_table_decl_ufcs__##Name

#if defined(CC_COMPTIME) || defined(__TINYC__)
#include <stdio.h>
#include <string.h>
#endif
CC_GENERIC_FACTORY(Table, 2) {
    char k[80], v[80], hash[96], eq[96], fwd[256];
    char newfn[96], newcfn[96], compact[80];
    size_t kn = arg(0).len < sizeof(k) - 1 ? arg(0).len : sizeof(k) - 1;
    size_t vn = arg(1).len < sizeof(v) - 1 ? arg(1).len : sizeof(v) - 1;
    int user_key = 0;
    memcpy(k, arg(0).ptr, kn);
    k[kn] = 0;
    memcpy(v, arg(1).ptr, vn);
    v[vn] = 0;
    fwd[0] = 0;
    compact[0] = 0;
    if (mangled.len > 6 && memcmp(mangled.ptr, "Table_", 6) == 0) {
        size_t cl = mangled.len - 6;
        if (cl >= sizeof(compact)) cl = sizeof(compact) - 1;
        memcpy(compact, mangled.ptr + 6, cl);
        compact[cl] = 0;
    }
    snprintf(newfn, sizeof(newfn), "table_new_%s", compact);
    snprintf(newcfn, sizeof(newcfn), "table_new_count_%s", compact);
    if (strcmp(k, "int") == 0) {
        snprintf(hash, sizeof(hash), "cc_map_hash_i32");
        snprintf(eq, sizeof(eq), "cc_map_eq_i32");
    } else if (strcmp(k, "CCSliceHdr") == 0) {
        snprintf(hash, sizeof(hash), "cc_map_hash_slice_hdr");
        snprintf(eq, sizeof(eq), "cc_map_eq_slice_hdr");
    } else if (strcmp(k, "CCSlicePacked") == 0) {
        snprintf(hash, sizeof(hash), "cc_map_hash_slice_packed");
        snprintf(eq, sizeof(eq), "cc_map_eq_slice_packed");
    } else if (strcmp(k, "CCSlice") == 0 || strcmp(k, "charslice") == 0) {
        snprintf(hash, sizeof(hash), "cc_map_hash_slice");
        snprintf(eq, sizeof(eq), "cc_map_eq_slice");
    } else if (strstr(k, "slice") != NULL || strstr(k, "Slice") != NULL) {
        snprintf(hash, sizeof(hash), "cc_map_hash_slice");
        snprintf(eq, sizeof(eq), "cc_map_eq_slice");
    } else if (strstr(k, "64") != NULL) {
        snprintf(hash, sizeof(hash), "cc_map_hash_u64");
        snprintf(eq, sizeof(eq), "cc_map_eq_u64");
    } else if (strcmp(k, "size_t") == 0 || strcmp(k, "ptrdiff_t") == 0 ||
               strcmp(k, "long") == 0 || strcmp(k, "long_long") == 0 ||
               strcmp(k, "unsigned_long") == 0 ||
               strcmp(k, "unsigned_long_long") == 0) {
        snprintf(hash, sizeof(hash), "cc_map_hash_u64");
        snprintf(eq, sizeof(eq), "cc_map_eq_u64");
    } else {
        snprintf(hash, sizeof(hash), "cc_map_key_hash_%s", k);
        snprintf(eq, sizeof(eq), "cc_map_key_eq_%s", k);
        user_key = 1;
    }
    if (user_key)
        snprintf(fwd, sizeof(fwd),
                 "static size_t %s(%s);\nstatic int %s(%s, %s);\n",
                 hash, k, eq, k, k);
    return @emit(`
#ifdef CC_FRAGMENT_VALIDATE
typedef struct ${mangled}_chk { char _; } ${mangled}_chk;
static inline ${mangled}_chk* ${mangled}_chk_p(void *a) {
    (void)a; return (${mangled}_chk*)0;
}
#else
${fwd}
CC_TABLE_DECL(${k}, ${v}, ${mangled}, ${hash}, ${eq})
static inline ${mangled}* cc__${newfn}(CCArena __a) {
    return ${mangled}_init(__a);
}
#define ${newfn}(ar) cc__${newfn}(CC__ARENA_HANDLE(ar))
static inline ${mangled}* cc__${mangled}_new(CCArena __a) {
    return ${mangled}_init(__a);
}
#define ${mangled}_new(ar) cc__${mangled}_new(CC__ARENA_HANDLE(ar))
static inline ${mangled}* cc__${newcfn}(CCArena __a, size_t __n) {
    return ${mangled}_init_count(__a, __n);
}
#define ${newcfn}(ar, n) cc__${newcfn}(CC__ARENA_HANDLE(ar), (n))
#endif
`, arena);
}

@typehooks on Table_* {
    .create = cc_type_create_call("_new"),
    .destroy = cc_type_destroy_call("_destroy"),
};

#endif /* CC_STD_TABLE_H */

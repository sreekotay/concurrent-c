; JSON recognition factory (RFC 8259 JSON-text). No keep / collect.
; Specialize with `include JsonRfc` or `include <ccc/std/json.rules>`
; plus rule overrides. Nested includes resolve next to this file.
top:     value
ws:      any charset [#' ' #'\t' #'\r' #'\n']
digit:   charset [#'0' - #'9']
onenine: charset [#'1' - #'9']
hexd:    charset [#'0' - #'9' #'a' - #'f' #'A' - #'F']
; Unescaped U+0000–U+001F fail. Escapes go through `esc`. SWAR stop is
; T=0x20 plus quote and backslash.
strchar: complement charset [#'"' #'\\' #'\0' - #'\x1F']
esc:     [#'\\' [[#'u' hexd hexd hexd hexd]
                | charset [#'"' #'\\' #'/' #'b' #'f' #'n' #'r' #'t']]]
string:  [#'"' any [some strchar | esc] #'"']
int:     [opt #'-' [#'0' | [onenine any digit]]]
number:  [int opt [#'.' some digit]
              opt [charset [#'e' #'E'] opt charset [#'+' #'-'] some digit]]
value:   [ws [string | number | object | array | "true" | "false" | "null"] ws]
member:  [ws string ws #':' value]
array:   [#'[' ws opt [value any [#',' value]] #']']
object:  [#'{' ws opt [member any [#',' member]] #'}']

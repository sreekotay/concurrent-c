#ifndef CC_STD_STATIC_MAP_CCH
#define CC_STD_STATIC_MAP_CCH

#include <stddef.h>
#include <stdint.h>
#include <stdio.h>
#include <string.h>
#include <ccc/cc_instantiate.cch>
#include <ccc/cc_slice.cch>

#ifndef CC_STATIC_MAP_TYPES_DEFINED
#define CC_STATIC_MAP_TYPES_DEFINED
enum {
    CC_STATIC_MAP_CASE_SENSITIVE = 0,
    CC_STATIC_MAP_ASCII_CI = 1,
};
#endif

/* Emit a frozen CCSlice -> value_type map at the comptime call site.
 *
 * The user-facing call is:
 *
 *   @comptime {
 *       RedisCommandEntry commands[] = {
 *           { "GET", { REDIS_CMD_GET, 1, 1, 0 } },
 *           { "SET", { REDIS_CMD_SET, 2, 2, 0 } },
 *       };
 *       static_map("redis_commands", commands, CC_STATIC_MAP_ASCII_CI);
 *   }
 *
 * `entries` is an array of a user struct with a `const char *key` field and a
 * real typed `value` field.  There is no stringified initializer: values are
 * ordinary typed compound literals the C front end checks.  The compiler
 * rewrites the three-argument call, inferring the value type from the array
 * element type and supplying the element/value layout via `sizeof` and address
 * arithmetic, into the internal form below.  The comptime function reads the
 * typed `.value` fields straight from the live comptime-evaluated array and
 * serializes each POD integer/enum field into a real typed initializer.
 *
 * Generated surface (unchanged in spirit):
 *
 *   static const value_type *<name>_get(CCSlice key);
 *
 * Lookup is a minimal perfect hash: hash(key) -> slot -> verify -> &value.
 * `flags` selects exact or ASCII case-insensitive matching.  Value fields must
 * be POD integers or enums, or structs of those (a `@variant` with void arms
 * is one: its tag); a field of any other kind (pointer, float) is a keyed
 * comptime error, as is a value layout the model cannot reproduce, a
 * duplicate key, a key needing C-string escaping, or a failure to construct
 * a perfect hash.
 *
 * In a `.cch` header: lower_header blanks the `@comptime { }` block so the
 * `.h` stays host-C. Forward-declare `<name>_get` for in-header callers; the
 * including TU harvests and re-runs the block
 * (`cc_harvest_local_header_comptime_blocks`) so the definition is spliced
 * into the merged `.c`. Proof: `tests/comptime_static_map_in_header_smoke`. */
/* One scalar of a value struct, flattened: where it is, how wide, whether
 * signed, and the braces around it when it opens or closes a nested
 * struct in the initializer. */
typedef struct CCStaticMapLeaf {
    int off;
    int size;
    int sign;
    int open;
    int close;
} CCStaticMapLeaf;

/* The leaves of `type`, appended at `base_off`; the struct's size and
 * alignment out. 0 with `emsg` filled when a field is not modeled. */
@comptime int cc_static_map_model(const char* type, size_t base_off,
                                  CCStaticMapLeaf* leaves, int* n, int max,
                                  size_t* out_size, int* out_align,
                                  char* emsg, size_t emsg_cap) {
    int nf = cc_reflect_field_count(type);
    size_t off = 0;
    int max_align = 1;
    int i;
    if (nf <= 0) {
        snprintf(emsg, emsg_cap, "static_map: value type '%s' is not a reflectable POD struct", type);
        return 0;
    }
    for (i = 0; i < nf; i++) {
        char fname[64];
        char fty[128];
        const char* t;
        int sz = 0, al = 0, uns = 0, ok = 0;
        cc_reflect_field_name(type, i, fname, (int)sizeof(fname));
        cc_reflect_field_type(type, i, fty, (int)sizeof(fty));
        t = fty;
        for (;;) {
            while (*t == ' ' || *t == '\t') t++;
            if (strncmp(t, "const", 5) == 0 && (t[5] == ' ' || t[5] == '\t')) { t += 5; continue; }
            if (strncmp(t, "volatile", 8) == 0 && (t[8] == ' ' || t[8] == '\t')) { t += 8; continue; }
            break;
        }
        if      (!strcmp(t, "char") || !strcmp(t, "signed char"))      { sz = 1; al = 1; uns = 0; ok = 1; }
        else if (!strcmp(t, "unsigned char"))                          { sz = 1; al = 1; uns = 1; ok = 1; }
        else if (!strcmp(t, "_Bool") || !strcmp(t, "bool"))            { sz = 1; al = 1; uns = 1; ok = 1; }
        else if (!strcmp(t, "int8_t"))                                 { sz = 1; al = 1; uns = 0; ok = 1; }
        else if (!strcmp(t, "uint8_t"))                                { sz = 1; al = 1; uns = 1; ok = 1; }
        else if (!strcmp(t, "short") || !strcmp(t, "short int") ||
                 !strcmp(t, "signed short"))                          { sz = 2; al = 2; uns = 0; ok = 1; }
        else if (!strcmp(t, "unsigned short"))                         { sz = 2; al = 2; uns = 1; ok = 1; }
        else if (!strcmp(t, "int16_t"))                                { sz = 2; al = 2; uns = 0; ok = 1; }
        else if (!strcmp(t, "uint16_t"))                               { sz = 2; al = 2; uns = 1; ok = 1; }
        else if (!strcmp(t, "int") || !strcmp(t, "signed") ||
                 !strcmp(t, "signed int"))                            { sz = 4; al = 4; uns = 0; ok = 1; }
        else if (!strcmp(t, "unsigned") || !strcmp(t, "unsigned int")) { sz = 4; al = 4; uns = 1; ok = 1; }
        else if (!strcmp(t, "int32_t"))                                { sz = 4; al = 4; uns = 0; ok = 1; }
        else if (!strcmp(t, "uint32_t"))                               { sz = 4; al = 4; uns = 1; ok = 1; }
        else if (!strcmp(t, "long") || !strcmp(t, "long int") ||
                 !strcmp(t, "signed long"))                           { sz = 8; al = 8; uns = 0; ok = 1; }
        else if (!strcmp(t, "unsigned long"))                          { sz = 8; al = 8; uns = 1; ok = 1; }
        else if (!strcmp(t, "long long") || !strcmp(t, "signed long long")) { sz = 8; al = 8; uns = 0; ok = 1; }
        else if (!strcmp(t, "unsigned long long"))                     { sz = 8; al = 8; uns = 1; ok = 1; }
        else if (!strcmp(t, "int64_t"))                                { sz = 8; al = 8; uns = 0; ok = 1; }
        else if (!strcmp(t, "uint64_t") || !strcmp(t, "size_t"))       { sz = 8; al = 8; uns = 1; ok = 1; }
        else if (cc_reflect_kind(t) == CC_REFLECT_KIND_ENUM)           { sz = 4; al = 4; uns = 0; ok = 1; }
        else if (cc_reflect_kind(t) == CC_REFLECT_KIND_STRUCT) {
            /* a nested POD struct: its leaves, braced as one initializer */
            size_t sub_size = 0;
            int sub_align = 1;
            int first = *n;
            if (!cc_static_map_model(t, 0, leaves, n, max, &sub_size, &sub_align, emsg, emsg_cap))
                return 0;
            if (*n == first) {
                snprintf(emsg, emsg_cap, "static_map: value field '%s' of type '%s' has no fields", fname, fty);
                return 0;
            }
            off = (off + (size_t)sub_align - 1) & ~((size_t)sub_align - 1);
            {
                int k;
                for (k = first; k < *n; k++) leaves[k].off += (int)(base_off + off);
            }
            leaves[first].open += 1;
            leaves[*n - 1].close += 1;
            off += sub_size;
            if (sub_align > max_align) max_align = sub_align;
            continue;
        }
        if (!ok) {
            snprintf(emsg, emsg_cap, "static_map: value field '%s' of type '%s' is not a POD integer/enum",
                     fname, fty);
            return 0;
        }
        if (*n >= max) {
            snprintf(emsg, emsg_cap, "static_map: value type '%s' has too many fields", type);
            return 0;
        }
        off = (off + (size_t)al - 1) & ~((size_t)al - 1);
        leaves[*n].off = (int)(base_off + off);
        leaves[*n].size = sz;
        leaves[*n].sign = !uns;
        leaves[*n].open = 0;
        leaves[*n].close = 0;
        (*n)++;
        off += (size_t)sz;
        if (al > max_align) max_align = al;
    }
    off = (off + (size_t)max_align - 1) & ~((size_t)max_align - 1);
    *out_size = off;
    *out_align = max_align;
    return 1;
}

@comptime void static_map(const char* name,
                          const char* value_type,
                          const void* entries,
                          size_t count,
                          size_t stride,
                          size_t key_off,
                          size_t value_off,
                          size_t value_size,
                          int flags) {
    int ascii_ci = (flags & CC_STATIC_MAP_ASCII_CI) != 0;
    const char* base = (const char*)entries;
    size_t i, j;
    size_t table_size = 0;
    uint32_t seed = 0;
    int found = 0;
    int16_t slots[512];
    size_t key_lens[256];
    const char* keys[256];
    char emsg[320];

    /* POD value layout modeled from reflection: ints, enums, and structs
     * of those, flattened to leaves. */
    CCStaticMapLeaf leaves[64];
    int nfields = 0;

    if (!name || !name[0] || !value_type || !value_type[0] ||
        !entries || count == 0 || count > 256 || stride == 0 || value_size == 0) {
        cc_emit_error("static_map: invalid arguments");
        return;
    }

    /* Model the value struct's layout, then check the modeled size against
     * the real sizeof passed by the call-site rewrite.  A mismatch means the
     * type is not a flat POD of the kinds this serializer reproduces — reject
     * it rather than emit wrong bytes. */
    {
        size_t modeled = 0;
        int al = 1;
        emsg[0] = '\0';
        if (!cc_static_map_model(value_type, 0, leaves, &nfields, 64, &modeled, &al,
                                 emsg, sizeof(emsg))) {
            cc_emit_error(emsg[0] ? emsg : "static_map: value type not modeled");
            return;
        }
        if (modeled != value_size) {
            snprintf(emsg, sizeof(emsg),
                     "static_map: value type '%s' layout not modeled (computed %zu != sizeof %zu)",
                     value_type, modeled, value_size);
            cc_emit_error(emsg);
            return;
        }
    }

    /* Read the typed keys from the live comptime array and validate them. */
    for (i = 0; i < count; i++) {
        const char* k = NULL;
        memcpy(&k, base + i * stride + key_off, sizeof(const char*));
        if (!k || strchr(k, '"') || strchr(k, '\\')) {
            cc_emit_error("static_map: keys must be simple string literals");
            return;
        }
        keys[i] = k;
        key_lens[i] = strlen(k);
        for (j = 0; j < i; j++) {
            if (key_lens[i] != key_lens[j]) continue;
            int same = 1;
            for (size_t m = 0; m < key_lens[i]; m++) {
                unsigned char a = (unsigned char)keys[i][m];
                unsigned char b = (unsigned char)keys[j][m];
                if (ascii_ci) {
                    if (a >= 'a' && a <= 'z') a = (unsigned char)(a - 'a' + 'A');
                    if (b >= 'a' && b <= 'z') b = (unsigned char)(b - 'a' + 'A');
                }
                if (a != b) { same = 0; break; }
            }
            if (same) {
                cc_emit_error("static_map: duplicate key");
                return;
            }
        }
    }

    /* Search for a collision-free FNV-1a seed into a power-of-two table. */
    for (table_size = 1; table_size < count; table_size <<= 1) {}
    if (table_size < 4) table_size = 4;
    while (table_size <= 512 && !found) {
        for (seed = 1; seed < 100000u; seed++) {
            for (i = 0; i < table_size; i++) slots[i] = -1;
            int ok = 1;
            for (i = 0; i < count; i++) {
                uint32_t h = seed;
                for (j = 0; j < key_lens[i]; j++) {
                    unsigned char c = (unsigned char)keys[i][j];
                    if (ascii_ci && c >= 'a' && c <= 'z')
                        c = (unsigned char)(c - 'a' + 'A');
                    h ^= c;
                    h *= 16777619u;
                }
                size_t slot = (size_t)(h & (uint32_t)(table_size - 1));
                if (slots[slot] >= 0) { ok = 0; break; }
                slots[slot] = (int16_t)i;
            }
            if (ok) { found = 1; break; }
        }
        if (!found) table_size <<= 1;
    }
    if (!found) {
        cc_emit_error("static_map: failed to build perfect hash");
        return;
    }

    cc_emit_format(CC_EMIT_AT_COMPTIME_SITE,
        "static const char* const %s__keys[%zu] = {\n", name, count);
    for (i = 0; i < count; i++) {
        cc_emit_format(CC_EMIT_AT_COMPTIME_SITE,
            "    \"%s\",\n", keys[i]);
    }
    cc_emit_format(CC_EMIT_AT_COMPTIME_SITE,
        "};\n"
        "static const size_t %s__key_lens[%zu] = {\n", name, count);
    for (i = 0; i < count; i++) {
        cc_emit_format(CC_EMIT_AT_COMPTIME_SITE,
            "    %zu,\n", key_lens[i]);
    }
    cc_emit_format(CC_EMIT_AT_COMPTIME_SITE,
        "};\n"
        "static const %s %s__values[%zu] = {\n",
        value_type, name, count);
    for (i = 0; i < count; i++) {
        int f;
        int need_comma = 0;
        cc_emit_format(CC_EMIT_AT_COMPTIME_SITE, "    /* %s */ {", keys[i]);
        for (f = 0; f < nfields; f++) {
            const unsigned char* vp =
                (const unsigned char*)(base + i * stride + value_off + (size_t)leaves[f].off);
            unsigned long long u = 0;
            int k;
            memcpy(&u, vp, (size_t)leaves[f].size);
            if (need_comma) cc_emit_format(CC_EMIT_AT_COMPTIME_SITE, ",");
            for (k = 0; k < leaves[f].open; k++) cc_emit_format(CC_EMIT_AT_COMPTIME_SITE, " {");
            if (leaves[f].sign) {
                int bits = leaves[f].size * 8;
                long long s;
                if (bits < 64 && ((u >> (bits - 1)) & 1ull))
                    u |= ~((1ull << bits) - 1ull);
                s = (long long)u;
                cc_emit_format(CC_EMIT_AT_COMPTIME_SITE, " %lld", s);
            } else {
                cc_emit_format(CC_EMIT_AT_COMPTIME_SITE, " %lluu", u);
            }
            for (k = 0; k < leaves[f].close; k++) cc_emit_format(CC_EMIT_AT_COMPTIME_SITE, " }");
            need_comma = 1;
        }
        cc_emit_format(CC_EMIT_AT_COMPTIME_SITE, " },\n");
    }
    cc_emit_format(CC_EMIT_AT_COMPTIME_SITE,
        "};\n"
        "static const int16_t %s__slots[%zu] = {\n",
        name, table_size);
    for (i = 0; i < table_size; i++) {
        cc_emit_format(CC_EMIT_AT_COMPTIME_SITE,
            "    %d,\n", (int)slots[i]);
    }
    cc_emit_format(CC_EMIT_AT_COMPTIME_SITE,
        "};\n"
        "static uint32_t %s__hash(CCSlice key) {\n"
        "    uint32_t h = %uu;\n"
        "    size_t i;\n"
        "    const unsigned char* p = (const unsigned char*)key.ptr;\n"
        "    for (i = 0; i < key.len; i++) {\n"
        "        unsigned char c = p[i];\n",
        name, seed);
    if (ascii_ci) {
        cc_emit_format(CC_EMIT_AT_COMPTIME_SITE,
            "        if (c >= 'a' && c <= 'z') c = (unsigned char)(c - 'a' + 'A');\n");
    }
    cc_emit_format(CC_EMIT_AT_COMPTIME_SITE,
        "        h ^= c;\n"
        "        h *= 16777619u;\n"
        "    }\n"
        "    return h;\n"
        "}\n"
        "static int %s__key_eq(CCSlice key, size_t idx) {\n"
        "    size_t i;\n"
        "    const unsigned char* a;\n"
        "    const unsigned char* b;\n"
        "    if (key.len != %s__key_lens[idx]) return 0;\n"
        "    a = (const unsigned char*)key.ptr;\n"
        "    b = (const unsigned char*)%s__keys[idx];\n"
        "    for (i = 0; i < key.len; i++) {\n",
        name, name, name);
    if (ascii_ci) {
        cc_emit_format(CC_EMIT_AT_COMPTIME_SITE,
            "        unsigned char x = a[i], y = b[i];\n"
            "        if (x >= 'a' && x <= 'z') x = (unsigned char)(x - 'a' + 'A');\n"
            "        if (y >= 'a' && y <= 'z') y = (unsigned char)(y - 'a' + 'A');\n"
            "        if (x != y) return 0;\n");
    } else {
        cc_emit_format(CC_EMIT_AT_COMPTIME_SITE,
            "        if (a[i] != b[i]) return 0;\n");
    }
    cc_emit_format(CC_EMIT_AT_COMPTIME_SITE,
        "    }\n"
        "    return 1;\n"
        "}\n"
        "static const %s* %s_get(CCSlice key) {\n"
        "    size_t slot = (size_t)(%s__hash(key) & %zuu);\n"
        "    int16_t idx = %s__slots[slot];\n"
        "    if (idx < 0) return NULL;\n"
        "    if (!%s__key_eq(key, (size_t)idx)) return NULL;\n"
        "    return &%s__values[idx];\n"
        "}\n",
        value_type, name, name, (size_t)(table_size - 1),
        name, name, name);
}

#endif

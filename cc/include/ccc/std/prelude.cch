/*
 * Concurrent-C stdlib prelude.
 *
 * Includes all stdlib headers. All types use the CC prefix (CCFile, CCArena, etc.)
 * to avoid namespace collisions - this is idiomatic C style.
 */
#ifndef CC_STD_PRELUDE_H
#define CC_STD_PRELUDE_H

#include <stddef.h>
#include <stdint.h>
#include <stdlib.h>

#include <ccc/cc_arena.cch>
#include <ccc/cc_arc.cch>
#include <ccc/cc_grammar.cch>
#include <ccc/cc_shape.cch>
#include <ccc/cc_type.cch>
#include <ccc/cc_slice.cch>
#include <ccc/cc_result.cch>
#include <ccc/cc_arena_result.cch>
#include <ccc/cc_exclusive.cch>
#include <ccc/cc_exclusive_result.cch>
#include "slice.cch"
#include <ccc/cc_channel.cch>
#include <ccc/cc_nursery.cch>
#include <ccc/cc_exec.cch>
#include "string.cch"
#include "slice_packed.cch"
#include "io.cch"
#include "vec.cch"
#include "map_forward.cch"
#include "array_map.cch"
#include "shard_map.cch"
#include "dir.cch"
#include "process.cch"
#include "exec.cch"
#include "async_io.cch"
#include "future.cch"

/* `kilobytes`/`megabytes` moved into `ccc/cc_arena.cch` so any
 * code that allocates an arena gets them without pulling in the
 * full std prelude.  Re-included here transitively via the
 * arena import above, so existing `#include
 * <ccc/std/prelude.cch>` users see no change. */

#endif // CC_STD_PRELUDE_H


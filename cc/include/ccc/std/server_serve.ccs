#!ccc ccs
#pragma(@module) "server"
/*
 * Member of module CCServer (spec 1.7): server.cch includes this unit
 * and the module lowers once; a page includes the face and links its
 * object.
 *
 * `srv.serve(stop, (io) => [cfg] { … })` plants dests, waits, accepts,
 * fills, borrow-invokes the step with `CCIoSess*` (many fibers, one env),
 * drains what the step queued, then drops the closure at join. The page
 * row (`srv.row_size`) sits in the session slot behind `io->app`; the
 * dest never reads it and runs `srv.row_drop` on it at the end.
 *
 * Waiter bodies: server_poll.ccs (kqueue / epoll / poll via host #ifdef).
 */
#include <ccc/std/prelude.cch>
#include <ccc/cc_atomic.cch>
#include <ccc/std/net.cch>
#include <ccc/std/tls.cch>
#include <ccc/std/signal.cch>
#include <string.h>
#include <stdlib.h>
#include <stdio.h>
#include <fcntl.h>
#include <errno.h>
#include <unistd.h>
#include <stdint.h>
#include <time.h>
#include <sys/socket.h>
#include "server.cch"
#include "server_poll.cch"
#include <pthread.h>

#ifndef K_IO_READ_BUF
#define K_IO_READ_BUF (16 * 1024)
#endif

#ifndef WORKER_GROW_EVERY
#define WORKER_GROW_EVERY 64
#endif

int !>(CCIoError) cc_io_sess_fill(CCIoSess* io) {
    size_t n = 0;
    size_t room;
    bool got;
    if (!io->read_ptr || io->rcap == 0) return cc_ok(1);
    if (io->rlen >= io->rcap) return cc_ok(1);
    room = io->rcap - io->rlen;
    if (io->tls_on) {
        CCNetError ne = CC_NET_OK;
        CCSlice got_sl;
        cc_arena_stack(tmp, K_IO_READ_BUF);
        got_sl = cc_tls_read(&io->tls, tmp, room, &ne);
        if (ne == CC_NET_OK && got_sl.len == 0) return cc_ok(0);
        if (ne != CC_NET_OK)
            return cc_err(cc_net_to_io_error(ne));
        if (got_sl.len > room)
            return cc_err(cc_io_error(CC_ERROR(CC_ERR_IO, "tls overread")));
        memcpy(io->read_ptr + io->rlen, got_sl.ptr, got_sl.len);
        io->rlen += got_sl.len;
        return cc_ok(1);
    }
    got = io->sock.try_read_into(io->read_ptr + io->rlen, room, &n) !>(e) {
        if (e.base.kind == CC_IO_BUSY) return cc_ok(0);
        return cc_err(e);
    };
    if (!got)
        return cc_err(cc_io_error(CC_ERROR(CC_ERR_CLOSED, "eof")));
    io->rlen += n;
    return cc_ok(1);
}

size_t !>(CCIoError) cc_io_sess_try_write(CCIoSess* io, char[:] data) {
    if (!data.len)
        return cc_ok(0);
    if (io->tls_on) {
        CCNetError ne = CC_NET_OK;
        size_t n = cc_tls_try_write(&io->tls, data.ptr, data.len, &ne);
        if (ne != CC_NET_OK)
            return cc_err(cc_net_to_io_error(ne));
        if (n == 0)
            return cc_err(cc_io_error(CC_IO_BUSY));
        return cc_ok(n);
    }
    {
#ifdef MSG_NOSIGNAL
        ssize_t n = send(io->sock.fd, data.ptr, data.len, MSG_NOSIGNAL);
#else
        ssize_t n = send(io->sock.fd, data.ptr, data.len, 0);
#endif
        if (n > 0)
            return cc_ok((size_t)n);
        if (n == 0)
            return cc_err(cc_io_error(CC_ERROR(CC_ERR_CLOSED, "peer closed")));
        if (errno == EAGAIN || errno == EWOULDBLOCK || errno == ENOBUFS ||
            errno == EINTR)
            return cc_err(cc_io_error(CC_IO_BUSY));
        return cc_err(cc_io_from_errno(errno));
    }
}

void cc_io_sess_init(CCIoSess* io, CCSocket sock, char* buf, size_t cap) {
    *io = (CCIoSess){
        .sock = sock,
        .read_ptr = buf,
        .rcap = cap,
        .want_in = 1,
    };
    (void)io->sock.set_nodelay(1);
}

/* Begin TLS; handshake completes via cc_io_ready steps. */
int cc_io_sess_wrap_tls(CCIoSess* io) {
    void* iobuf;
    CCTlsServerConfig tcfg = {0};
    CCNetError ne = CC_NET_OK;
    CCTlsConn tls;
    CCTlsHs hs;
    if (!io) return -1;
    iobuf = malloc(CC_TLS_IOBUF_SIZE);
    if (!iobuf) return -1;
    tls = cc_tls_server_start(io->sock, tcfg, iobuf, CC_TLS_IOBUF_SIZE, &ne);
    if (ne != CC_NET_OK || !tls.ctx) {
        free(iobuf);
        return -1;
    }
    io->tls = tls;
    io->tls_iobuf = iobuf;
    io->tls_on = 1;
    io->tls_hs = 1;
    io->sock = tls.underlying;
    hs = cc_tls_handshake_step(&io->tls, &ne);
    if (hs == CC_TLS_HS_DONE) {
        io->tls_hs = 0;
        io->want_in = 1;
        io->want_out = 0;
        return 0;
    }
    if (hs == CC_TLS_HS_FAIL) {
        cc_tls_close(&io->tls);
        free(iobuf);
        io->tls_iobuf = NULL;
        io->tls_on = 0;
        io->tls_hs = 0;
        return -1;
    }
    io->want_in = (hs == CC_TLS_HS_WANT_READ) ? 1 : 0;
    io->want_out = (hs == CC_TLS_HS_WANT_WRITE) ? 1 : 0;
    if (!io->want_in && !io->want_out) io->want_in = 1;
    return 0;
}

static int cc_io_sess_queue_pending(CCIoSess* io) {
    return io && io->out_off < io->out.as_slice().len;
}

int cc_io_sess_pending_out(CCIoSess* io) {
    if (!io) return 0;
    if (cc_io_sess_queue_pending(io)) return 1;
    return io->tls_on && !io->tls_hs && cc_tls_pending_out(&io->tls);
}

enum { K_IO_OUT_ARENA = 8 * 1024 };

void !>(CCIoError) cc_io_sess_write(CCIoSess* io, char[:] data) {
    if (!io || !data.len) return cc_ok();
    if (!cc_arena_is_live(io->out_a)) {
        io->out_a = cc_arena_heap(K_IO_OUT_ARENA);
        if (!cc_arena_is_live(io->out_a))
            return cc_err(cc_io_error(CC_ERROR(CC_ERR_OUT_OF_MEMORY, "session output queue")));
        io->out = cc_string_new();
        io->out_off = 0;
    }
    if (!io->out.append(data, io->out_a) || io->out.failed())
        return cc_err(cc_io_error(CC_ERROR(CC_ERR_OUT_OF_MEMORY, "session output queue")));
    return cc_ok();
}

/* Drain the queue with try_write: 1 = empty (and reset), 0 = busy, -1 = gone. */
int cc_io_sess_flush(CCIoSess* io) {
    char[:] data;
    if (!io) return -1;
    data = io->out.as_slice();
    while (io->out_off < data.len) {
        char[:] rest = data.sub(io->out_off, data.len);
        size_t n = io->try_write(rest) !>(e) {
            if (e.base.kind == CC_IO_BUSY) return 0;
            return -1;
        };
        io->out_off += n;
    }
    if (data.len) {
        io->out.release(io->out_a);
        io->out_a.reset();
        io->out_off = 0;
    }
    return 1;
}

/* Record the answer; the engine resolves interest after the step, once
 * it knows what is left in the queue. */
void cc_io_sess_apply(CCIoSess* io, CCIoAct a) {
    io->answered = 1;
    @switch (a) {
    case .close:
        io->act = 2;
        break;
    case .wait:
        io->act = 0;
        break;
    case .wait_out:
        io->act = 1;
        break;
    }
}

void cc_io_sess_wait(CCIoSess* io) {
    io->answered = 1;
    io->act = 0;
}

void cc_io_sess_wait_out(CCIoSess* io) {
    io->answered = 1;
    io->act = 1;
}

void cc_io_sess_close(CCIoSess* io) {
    io->answered = 1;
    io->act = 2;
}

void cc_io_sess_drop(CCIoSess* io) {
    if (!io) return;
    if (io->tls_on) {
        cc_tls_close(&io->tls);
        free(io->tls_iobuf);
        io->tls_iobuf = NULL;
        io->tls_on = 0;
        io->tls_hs = 0;
        io->sock.fd = -1;
    } else if (io->sock.fd >= 0) {
        io->sock.close();
    }
    io->read_ptr = NULL;
    io->rlen = 0;
    io->rcap = 0;
    io->dead = 0;
    io->want_in = 1;
    io->want_out = 0;
    io->deadline = 0;
    io->app = NULL;
    if (cc_arena_is_live(io->out_a)) {
        io->out.release(io->out_a);
        io->out_a.destroy();
    }
    io->out_off = 0;
    io->answered = 0;
    io->act = 0;
    io->closing = 0;
}

int cc_server_stopped(CCServer* srv) {
    return cc_atomic_load_acquire(&srv->stop);
}

void cc_server_note_open(CCServer* srv) {
    if (srv) cc_atomic_fetch_add(&srv->live, 1);
}

void cc_server_note_close(CCServer* srv) {
    if (srv) cc_atomic_fetch_sub(&srv->live, 1);
}

int cc_server_bind_conn(CCServer* srv, CCIoSess* io, int fd,
                               char* buf, size_t cap) {
    int first = srv ? srv->sec_first_byte : 0;   /* 0 = no deadline */
    int tls_hs = (srv && srv->sec_tls_hs > 0) ? srv->sec_tls_hs : 10;
    cc_io_sess_init(io, (CCSocket){ .fd = fd }, buf, cap);
    io->sec_after_hs = first;
    if (srv && srv->tls) {
        if (io->wrap_tls() != 0) {
            cc_atomic_fetch_add(&srv->tls_fail, 1);
            io->drop();
            return 0;
        }
        if (io->tls_hs)
            cc_io_sess_touch(io, time(NULL), tls_hs);
        else
            cc_io_sess_touch(io, time(NULL), first);
    } else {
        cc_io_sess_touch(io, time(NULL), first);
    }
    return 1;
}

/* Dest-owned accept: spare recovery can only happen here. */
CCAccept cc_tape_accept(CCTape* w) {
    CCServer* srv;
    int fd;
    if (!w || !w->srv || !w->listening) return (CCAccept){ .busy = {} };
    if (!w->listen_ready()) return (CCAccept){ .busy = {} };
    srv = w->srv;
    fd = accept(srv->ln.fd, NULL, NULL);
    if (fd < 0) {
        if (errno == EAGAIN || errno == EWOULDBLOCK || errno == EINTR)
            return (CCAccept){ .busy = {} };
        if (cc_accept_resource_err(errno)) {
            /* Classic EMFILE drain: free spare → accept+drop → restore spare.
             * open before close(accepted) loses the slot and leaves spare=-1. */
            if (w->spare_fd >= 0) {
                close(w->spare_fd);
                w->spare_fd = -1;
                fd = accept(srv->ln.fd, NULL, NULL);
                if (fd >= 0)
                    close(fd);
                w->spare_fd = open("/dev/null", O_RDONLY | O_CLOEXEC);
            }
            cc_atomic_fetch_add(&srv->accept_soft, 1);
            cc_server_publish_accept_backoff(srv);
            return (CCAccept){ .busy = {} };
        }
        return (CCAccept){ .dead = {} };
    }
    (void)fcntl(fd, F_SETFD, FD_CLOEXEC);
    (void)cc_fd_nonblock(fd);
    return (CCAccept){ .ready = fd };
}

static void cc_server_note_workers(CCServer* srv, int n) {
    int peak = cc_atomic_load_acquire(&srv->workers_peak);
    while (n > peak && !cc_atomic_cas(&srv->workers_peak, &peak, n)) {}
}

int cc_server_try_grow(CCServer* srv, int every) {
    int n = cc_atomic_load_acquire(&srv->nworkers);
    int live = cc_atomic_load_acquire(&srv->live);
    int next;
    if (n < 1 || n >= srv->workers_max) return 0;
    if (every < 1 || live < (n + 1) * every) return 0;
    next = n + 1;
    if (!cc_atomic_cas(&srv->nworkers, &n, next)) return 0;
    cc_server_note_workers(srv, next);
    return 1;
}

/* Claim a replacement slot when a worker exited below the start floor. */
static int cc_server_try_respawn_slot(CCServer* srv) {
    int n = cc_atomic_load_acquire(&srv->nworkers);
    int floor = cc_server_start_n(srv);
    int next;
    if (srv->stopped()) return 0;
    if (n >= floor || n >= srv->workers_max) return 0;
    next = n + 1;
    return cc_atomic_cas(&srv->nworkers, &n, next) ? 1 : 0;
}

void cc_server_kick(CCServer* srv) {
    srv->app = @parallel spawn { @serial { (void)0; } } !>;
}

void cc_server_start(CCServer* srv, CCSignal* stop) {
    CCServer* srvp = srv;
    CCSignal* stopp = stop;
    cc_atomic_store_release(&srv->nworkers, cc_server_start_n(srv));
    cc_server_note_workers(srv, cc_server_start_n(srv));
    cc_server_kick(srv);
    if (!stopp) return;
    @parallel(srv->app) {
        int sig = 0;
        sig = stopp->wait() ?> 0;
        if (sig) srvp->shutdown();
    }
}

void !>(CCError) cc_server_join(CCServer* srv) {
    @errhandler(CCError e) { return cc_err(e); }
    srv->app.wait() !>;
    return cc_ok();
}

typedef struct CCIoRow {
    CCIoSess io;
    CCServer* srv;
    char read_buf[K_IO_READ_BUF];
} CCIoRow;

/* The page row follows the engine row in the same slot, 16-aligned. */
#define CC_IO_ROW_PAGE_OFF ((sizeof(CCIoRow) + 15u) & ~(size_t)15u)

static size_t cc_io_row_bytes(CCServer* srv) {
    size_t n = CC_IO_ROW_PAGE_OFF;
    if (srv && srv->row_size) n += (srv->row_size + 15u) & ~(size_t)15u;
    return n;
}

typedef CCIoSess* CCIoSessP;

#ifndef CC_STEP_LANES_MAX
#define CC_STEP_LANES_MAX 64
#endif
#ifndef CC_STEP_Q_CAP
#define CC_STEP_Q_CAP 256
#endif

typedef struct CCStepHub CCStepHub;

typedef struct ServeCtx {
    CCServer* srv;
    CCClosure1 on_app;
    CCStepHub* hub; /* ready-app steal hub; NULL = serial steps only */
    CCSignal* stop; /* the watcher's signal; the last worker out releases it */
} ServeCtx;

/* The last worker to leave a stopped server releases a watcher still
 * parked on `stop` (the server was shut down from the page, not by the
 * signal). A worker leaving a live server is respawned, not the end. */
static void cc_server_worker_left(ServeCtx* ctx) {
    if (!ctx || !ctx->srv) return;
    if (cc_atomic_fetch_sub(&ctx->srv->nworkers, 1) == 1 && ctx->stop &&
        ctx->srv->stopped())
        ctx->stop->close();
}

/* Per-dest stealable ready-app deque. Owner pushes/pops tail; thieves pop
 * head. Arm stays on the home tape (stealer may arm while home is in wait).
 * Steal: one-at-a-time until victim.qlen < max(2, 2× mine) (fair), capped. */
typedef struct CCStepLane {
    _Atomic int live;
    _Atomic int qlen;
    _Atomic int inflight; /* run_queued in flight (owner or thief) */
    _Atomic int idle;     /* 1 in wait, 2 poked, 0 working */
    _Atomic uint64_t progress; /* mono ns: last wake or completed step */
    int slow;             /* the last batch had a step over CC_SERVER_STALL_NS */
    pthread_mutex_t mx;
    int q[CC_STEP_Q_CAP];
    CCIoSess* qio[CC_STEP_Q_CAP]; /* the session behind q[i]: a thief steps it without the table */
    int head;
    int tail;
    int n;
    /* Ids a thief stepped; the owner re-arms them and clears busy. */
    int rearm[CC_STEP_Q_CAP];
    int rn;
    CCTape* tape;
    ServeCtx* ctx;
} CCStepLane;

struct CCStepHub {
    CCStepLane* lanes[CC_STEP_LANES_MAX];
    pthread_mutex_t mx;
};

static void cc_server_worker(ServeCtx* ctx);
static void cc_serve_invoke(ServeCtx* ctx, CCIoSess* io);

/* CC_SERVER_STEP_STEAL:
 *   unset / 1 — ready-app deque + steal off a stalled peer (the default)
 *   0 — serial serve (no deque)
 *   2 — deque only (no steal); isolates the queue path
 *
 * Steps move only off a stalled peer: one whose current step has run past
 * CC_SERVER_STALL_NS with steps queued behind it. That is independently
 * runnable work the owner cannot reach. Steal is not a substitute for a
 * parking exclusive around shared state and does not fix exclusive
 * occupancy; a lane of quick steps never pokes and is never stolen from.
 */
static int cc_step_mode(void) {
    static int cached = -1;
    const char* e;
    if (cached >= 0) return cached;
    e = getenv("CC_SERVER_STEP_STEAL");
    if (!e || !e[0]) cached = 1;          /* queue + steal, with peer wake */
    else if (e[0] == '0') cached = 0;
    else if (e[0] == '2') cached = 2;
    else cached = 1;
    return cached;
}

/* CC_SERVER_TRACE=1: accept, grow and worker exit on stderr, per worker. */
static int cc_server_trace(void) {
    static int cached = -1;
    if (cached < 0) {
        const char* e = getenv("CC_SERVER_TRACE");
        cached = (e && e[0] && e[0] != '0') ? 1 : 0;
    }
    return cached;
}

/* A tape heavier than a peer leaves the rest of a burst to the peer; the
 * same rule cc_tape_wait applies to listen interest. */
static int cc_tape_above_share(CCTape* tape) {
    size_t n;
    if (!tape || !tape->srv) return 0;
    n = tape->nconns();
    if (tape->slot >= 0)
        cc_atomic_store_release(&tape->srv->tape_conns[tape->slot], (int)n);
    return !cc_server_tape_may_accept(tape->srv, tape->slot, n);
}

static int cc_step_lane_wanted(void) {
    return cc_step_mode() >= 1;
}

static int cc_step_steal_wanted(void) {
    return cc_step_mode() == 1;
}

static void cc_step_hub_init(CCStepHub* hub) {
    int i;
    *hub = (CCStepHub){0};
    pthread_mutex_init(&hub->mx, NULL);
    for (i = 0; i < CC_STEP_LANES_MAX; i++)
        hub->lanes[i] = NULL;
}

static void cc_step_hub_destroy(CCStepHub* hub) {
    if (!hub) return;
    (void)pthread_mutex_destroy(&hub->mx);
}

static int cc_step_hub_attach(CCStepHub* hub, CCStepLane* lane) {
    int i;
    if (!hub || !lane) return -1;
    pthread_mutex_lock(&hub->mx);
    for (i = 0; i < CC_STEP_LANES_MAX; i++) {
        if (!hub->lanes[i]) {
            hub->lanes[i] = lane;
            pthread_mutex_unlock(&hub->mx);
            return i;
        }
    }
    pthread_mutex_unlock(&hub->mx);
    return -1;
}

static void cc_step_hub_detach(CCStepHub* hub, CCStepLane* lane) {
    int i;
    if (!hub || !lane) return;
    pthread_mutex_lock(&hub->mx);
    for (i = 0; i < CC_STEP_LANES_MAX; i++) {
        if (hub->lanes[i] == lane) {
            hub->lanes[i] = NULL;
            break;
        }
    }
    pthread_mutex_unlock(&hub->mx);
}

static int cc_step_lane_push(CCStepLane* L, int id, CCIoSess* io) {
    if (!L || id <= 0) return 0;
    pthread_mutex_lock(&L->mx);
    if (L->n >= CC_STEP_Q_CAP) {
        pthread_mutex_unlock(&L->mx);
        return 0;
    }
    L->q[L->tail] = id;
    L->qio[L->tail] = io;
    L->tail = (L->tail + 1) % CC_STEP_Q_CAP;
    L->n++;
    cc_atomic_store_release(&L->qlen, L->n);
    pthread_mutex_unlock(&L->mx);
    return 1;
}

static int cc_step_lane_pop_owner(CCStepLane* L) {
    int id;
    if (!L) return 0;
    pthread_mutex_lock(&L->mx);
    if (L->n == 0) {
        pthread_mutex_unlock(&L->mx);
        return 0;
    }
    L->tail = (L->tail + CC_STEP_Q_CAP - 1) % CC_STEP_Q_CAP;
    id = L->q[L->tail];
    L->n--;
    cc_atomic_store_release(&L->qlen, L->n);
    pthread_mutex_unlock(&L->mx);
    return id;
}

static int cc_step_lane_pop_thief(CCStepLane* L, CCIoSess** io_out) {
    int id;
    if (!L) return 0;
    pthread_mutex_lock(&L->mx);
    if (L->n == 0) {
        pthread_mutex_unlock(&L->mx);
        return 0;
    }
    id = L->q[L->head];
    if (io_out) *io_out = L->qio[L->head];
    L->head = (L->head + 1) % CC_STEP_Q_CAP;
    L->n--;
    cc_atomic_store_release(&L->qlen, L->n);
    pthread_mutex_unlock(&L->mx);
    return id;
}

/* A thief hands a stepped id back; the owner arms it on its next wake. */
static void cc_step_lane_rearm_push(CCStepLane* L, int id) {
    pthread_mutex_lock(&L->mx);
    if (L->rn < CC_STEP_Q_CAP) L->rearm[L->rn++] = id;
    pthread_mutex_unlock(&L->mx);
    if (cc_atomic_load_acquire(&L->idle) != 0 && L->tape) cc_tape_wake(L->tape);
}

static int cc_step_lane_rearm_take(CCStepLane* L, int* ids, int cap) {
    int n;
    pthread_mutex_lock(&L->mx);
    n = L->rn < cap ? L->rn : cap;
    if (n > 0) memcpy(ids, L->rearm, (size_t)n * sizeof(int));
    if (n < L->rn) memmove(L->rearm, L->rearm + n, (size_t)(L->rn - n) * sizeof(int));
    L->rn -= n;
    pthread_mutex_unlock(&L->mx);
    return n;
}

/* A stolen step: the page runs on the thief's thread with the session
 * alone; the row, its table and its arm belong to the owner, who gets
 * the id back through the rearm list. Reap skips busy rows, so the
 * session outlives the step. */
static void cc_serve_run_stolen(CCStepLane* V, int id, CCIoSess* io) {
    if (!V || id <= 0) return;
    cc_atomic_fetch_add(&V->inflight, 1);
    if (io && !io->dead) cc_serve_invoke(V->ctx, io);
    cc_step_lane_rearm_push(V, id);
    cc_atomic_fetch_sub(&V->inflight, 1);
}

static int cc_step_unfair(int mine, int victim) {
    int need = 2 * mine;
    if (need < 2) need = 2;
    return victim >= need;
}

static CCStepLane* cc_step_pick_victim(CCStepHub* hub, CCStepLane* self,
                                       int mine) {
    CCStepLane* best = NULL;
    int best_n = 0;
    int i;
    if (!hub) return NULL;
    for (i = 0; i < CC_STEP_LANES_MAX; i++) {
        CCStepLane* L = hub->lanes[i];
        int n;
        if (!L || L == self) continue;
        if (!cc_atomic_load_acquire(&L->live)) continue;
        n = cc_atomic_load_acquire(&L->qlen);
        if (n > best_n) {
            best_n = n;
            best = L;
        }
    }
    if (!best || !cc_step_unfair(mine, best_n)) return NULL;
    return best;
}

/* One step: the page answers with apply; the engine then drains what it
 * queued. A step that did not answer is a fault: closed and counted. */
static void cc_serve_invoke(ServeCtx* ctx, CCIoSess* io) {
    if (!ctx || !ctx->on_app.fn) return;
    io->answered = 0;
    (void)(ctx->on_app.fn)(ctx->on_app.env, (intptr_t)io);
    if (!io->answered && !io->dead) {
        static int said;
        int n = cc_atomic_fetch_add(&ctx->srv->step_faults, 1);
        if (!said && n == 0) {
            said = 1;
            fprintf(stderr, "cc_server: a step returned without apply; the session is closed (counted in step_faults)\n");
        }
        io->dead = 1;
        return;
    }
    if (io->dead) return;
    if (cc_io_sess_queue_pending(io)) {
        int fl = cc_io_sess_flush(io);
        if (fl < 0) { io->dead = 1; return; }
    }
    {
        int pend = cc_io_sess_pending_out(io);
        if (io->act == 2) {
            if (pend) {
                io->closing = 1;
                io->want_out = 1;
            } else {
                io->closing = 0;
                io->dead = 1;
                io->want_out = 0;
            }
        } else {
            io->closing = 0;
            io->want_out = (io->act == 1 || pend) ? 1 : 0;
        }
    }
}

static void cc_io_row_drop(ServeCtx* ctx, CCIoSess* io, CCArenaPool* slots) {
    CCIoRow* row;
    (void)ctx;
    if (!io) return;
    io->dead = 1;
    row = (CCIoRow*)io;
    if (io->app && row->srv && row->srv->row_drop)
        row->srv->row_drop(io->app);
    io->drop();
    if (slots) slots->free(row);
}

static CCIoSess* cc_io_row_new(CCServer* srv, int fd, CCArenaPool* pool) {
    CCIoRow* row = (CCIoRow*)pool->alloc();
    if (!row) {
        close(fd);
        return NULL;
    }
    *row = (CCIoRow){0};
    row->srv = srv;
    if (srv->bind_conn(&row->io, fd, row->read_buf, sizeof(row->read_buf)) != 1) {
        pool->free(row);
        return NULL;
    }
    if (srv->row_size) {
        char* page = (char*)row + CC_IO_ROW_PAGE_OFF;
        memset(page, 0, srv->row_size);
        row->io.app = page;
    }
    return &row->io;
}

/* Fill while responding. Peer SHUT_WR → clear want_in (helper so !> return
 * stays local). Hard I/O errors propagate. */
static int !>(CCIoError) cc_io_fill_while_out(CCIoSess* io) {
    int got = io->fill() !>(e) {
        if (e.base.kind == CC_ERR_CLOSED) {
            io->want_in = 0;
            return cc_ok(0);
        }
        return cc_err(e);
    };
    return cc_ok(got);
}

/* -1 = close, 0 = wait (armed), 1 = window ready for on_app.
 * arm_mx: optional lock around tape.arm only (NULL = uncontended serial). */
static int !>(CCError) cc_io_arm(CCIoSess* io, CCTape* tape, int id,
                                 pthread_mutex_t* arm_mx) {
    if (arm_mx) pthread_mutex_lock(arm_mx);
    tape->arm(id, io) !>(e) {
        if (arm_mx) pthread_mutex_unlock(arm_mx);
        @switch (e) {
        case .conn:
            io->dead = 1;
            return cc_ok(-1);
        case .desync:
            return cc_err(CC_ERR_INVALID_ARG, "tape arm desync");
        }
    };
    if (arm_mx) pthread_mutex_unlock(arm_mx);
    return cc_ok(0);
}

static int !>(CCError) cc_io_ready(CCIoSess* io, CCTape* tape, int id,
                                   CCReady r, pthread_mutex_t* arm_mx) {
    @errhandler(CCError e) { return cc_err(e); }
    @errhandler(CCIoError e) { return cc_err(e.base); }
    if (cc_ready_bad(r)) {
        io->dead = 1;
        return cc_ok(-1);
    }
    /* Waiter-stepped TLS handshake before application I/O. */
    if (io->tls_hs) {
        CCNetError ne = CC_NET_OK;
        CCTlsHs hs;
        int readable = cc_ready_in(r);
        int writable = cc_ready_out(r);
        if (!readable && !writable && (io->want_in || io->want_out)) {
            int ar = cc_io_arm(io, tape, id, arm_mx) !>;
            if (ar < 0) return cc_ok(-1);
            return cc_ok(0);
        }
        hs = cc_tls_handshake_step(&io->tls, &ne);
        if (hs == CC_TLS_HS_FAIL) {
            io->dead = 1;
            return cc_ok(-1);
        }
        if (hs == CC_TLS_HS_DONE) {
            io->tls_hs = 0;
            io->want_in = 1;
            io->want_out = 0;
            cc_io_sess_touch(io, time(NULL),
                          io->sec_after_hs);
            {
                int ar = cc_io_arm(io, tape, id, arm_mx) !>;
                if (ar < 0) return cc_ok(-1);
            }
            /* Fall through to normal read path if data already queued. */
        } else {
            io->want_in = (hs == CC_TLS_HS_WANT_READ) ? 1 : 0;
            io->want_out = (hs == CC_TLS_HS_WANT_WRITE) ? 1 : 0;
            if (!io->want_in && !io->want_out) io->want_in = 1;
            {
                int ar = cc_io_arm(io, tape, id, arm_mx) !>;
                if (ar < 0) return cc_ok(-1);
            }
            return cc_ok(0);
        }
    }
    /* The engine's queue drains before the page runs again. */
    if (cc_io_sess_queue_pending(io) && cc_ready_out(r)) {
        int fl = cc_io_sess_flush(io);
        if (fl < 0) {
            io->dead = 1;
            return cc_ok(-1);
        }
    }
    if (cc_io_sess_queue_pending(io)) {
        int ar;
        if (cc_ready_in(r)) {
            int got = cc_io_fill_while_out(io) !>(e) {
                (void)e;
                io->dead = 1;
                return cc_ok(-1);
            };
            (void)got;
        }
        io->want_out = 1;
        ar = cc_io_arm(io, tape, id, arm_mx) !>;
        if (ar < 0) return cc_ok(-1);
        return cc_ok(0);
    }
    if (io->closing && !cc_io_sess_pending_out(io)) {
        io->closing = 0;
        io->dead = 1;
        io->want_out = 0;
        return cc_ok(-1);
    }
    /* Record-layer drain is independent of the app send cursor. */
    if (io->tls_on && !io->tls_hs) {
        if (cc_io_sess_pending_out(io) && cc_ready_out(r)) {
            CCNetError ne = CC_NET_OK;
            int p = cc_tls_flush_step(&io->tls, &ne);
            if (p < 0) {
                io->dead = 1;
                return cc_ok(-1);
            }
        }
        if (cc_io_sess_pending_out(io))
            io->want_out = 1;
        if (io->closing) {
            if (cc_io_sess_pending_out(io)) {
                int ar = cc_io_arm(io, tape, id, arm_mx) !>;
                if (ar < 0) return cc_ok(-1);
                return cc_ok(0);
            }
            io->closing = 0;
            io->dead = 1;
            io->want_out = 0;
            return cc_ok(-1);
        }
    }
    if (io->want_out) {
        if (cc_ready_in(r)) {
            int got = cc_io_fill_while_out(io) !>(e) {
                (void)e;
                io->dead = 1;
                return cc_ok(-1);
            };
            (void)got;
        }
        if (cc_ready_out(r))
            return cc_ok(1);
        {
            int ar = cc_io_arm(io, tape, id, arm_mx) !>;
            if (ar < 0) return cc_ok(-1);
        }
        return cc_ok(0);
    }
    if (!cc_ready_in(r))
        return cc_ok(0);
    {
        int got = io->fill() !>;
        if (got < 0) {
            io->dead = 1;
            return cc_ok(-1);
        }
        if (got == 0) return cc_ok(0);
    }
    return cc_ok(1);
}

/* 0 = continue; 1 = died; -1 = home-tape desync (owner only). */
static int cc_serve_app_arm(CCIoSess* io, ServeCtx* ctx, CCTape* tape, int id,
                            pthread_mutex_t* arm_mx, int is_owner) {
    CCConnRow* row = tape->row(id);
    cc_serve_invoke(ctx, io);
    if (io->dead) {
        if (row) row->step_busy = 0;
        return 1;
    }
    {
        int ar = cc_io_arm(io, tape, id, arm_mx) !>(e) {
            (void)e;
            if (row) row->step_busy = 0;
            if (is_owner) return -1;
            io->dead = 1;
            return 1;
        };
        (void)ar;
    }
    if (row) row->step_busy = 0;
    return 0;
}

static int cc_serve_run_queued(CCStepLane* L, int id, int is_owner) {
    CCConnRow* row;
    CCIoSess* io;
    int rc;
    if (!L || !L->tape || id <= 0) return 0;
    cc_atomic_fetch_add(&L->inflight, 1);
    row = L->tape->row(id);
    if (!row || !row->io) {
        cc_atomic_fetch_sub(&L->inflight, 1);
        return 0;
    }
    io = row->io;
    if (io->dead) {
        row->step_busy = 0;
        cc_atomic_fetch_sub(&L->inflight, 1);
        return 1;
    }
    rc = cc_serve_app_arm(io, L->ctx, L->tape, id, NULL, is_owner);
    cc_atomic_fetch_sub(&L->inflight, 1);
    return rc;
}

/* 0 = continue; -1 reserved for WaitId desync from drop/reap / arm. */
static int cc_serve_step(CCIoSess* io, ServeCtx* ctx, CCTape* tape, int id,
                         CCReady r, pthread_mutex_t* arm_mx) {
    int st = cc_io_ready(io, tape, id, r, arm_mx) !>(e) {
        (void)e;
        io->dead = 1;
        return 0;
    };
    if (st <= 0) return 0;   /* dead (row_drop follows) or nothing to step */
    {
        int rc = cc_serve_app_arm(io, ctx, tape, id, arm_mx, 1);
        return rc < 0 ? -1 : 0;
    }
}

/* -1 = died (invoked); 0 = wait/armed; 1 = window ready for on_app. */
static int cc_serve_ready_for_queue(CCIoSess* io, ServeCtx* ctx, CCTape* tape,
                                    int id, CCReady r) {
    (void)ctx;
    int st = cc_io_ready(io, tape, id, r, NULL) !>(e) {
        (void)e;
        io->dead = 1;
        return -1;
    };
    return st;
}

static int cc_step_try_steal_one(CCStepHub* hub, CCStepLane* self) {
    int mine;
    CCStepLane* V;
    int id;
    if (!hub || !self || !cc_step_steal_wanted()) return 0;
    mine = cc_atomic_load_acquire(&self->qlen);
    V = cc_step_pick_victim(hub, self, mine);
    if (!V) return 0;
    if (!cc_atomic_load_acquire(&V->live)) return 0;
    {
        CCIoSess* io = NULL;
        id = cc_step_lane_pop_thief(V, &io);
        if (id <= 0) return 0;
        if (self->ctx && self->ctx->srv)
            cc_atomic_fetch_add(&self->ctx->srv->step_steal, 1);
        cc_serve_run_stolen(V, id, io);
    }
    return 1;
}

/* Steal one-at-a-time while victim.qlen >= max(2, 2× mine). Cap so a
 * pathological victim cannot pin this dest for a full wake. */
#ifndef CC_STEP_STEAL_FAIR_MAX
#define CC_STEP_STEAL_FAIR_MAX 64
#endif
static int cc_step_steal_until_fair(CCStepHub* hub, CCStepLane* self) {
    (void)hub; (void)self;
    return 0;   /* steps move only off a stalled peer: cc_step_steal_stalled */
}

/* The engine's own water level. A worker whose waits keep returning with
 * work is busy under load, not necessarily saturated: grow on saturation
 * only when the previous batch was slow (a step over CC_SERVER_STALL_NS)
 * and no peer is idle. A worker that has not moved for a while with steps
 * queued is stalled; a poked idle peer takes those steps, and when no
 * peer is idle a worker is added, up to the cap, rate-limited so steal
 * feedback cannot climb the cap. */
#ifndef CC_SERVER_BUSY_WAKES
#define CC_SERVER_BUSY_WAKES 32
#endif
#ifndef CC_SERVER_STALL_NS
#define CC_SERVER_STALL_NS (200 * 1000)
#endif
/* Min spacing between saturation/stall grows (mono ns). */
#ifndef CC_SERVER_GROW_COOLDOWN_NS
#define CC_SERVER_GROW_COOLDOWN_NS (10ull * 1000 * 1000)
#endif

static uint64_t cc_now_ns(void) {
    struct timespec ts;
    clock_gettime(CLOCK_MONOTONIC, &ts);
    return (uint64_t)ts.tv_sec * 1000000000ull + (uint64_t)ts.tv_nsec;
}

static int cc_step_hub_any_idle(CCStepHub* hub, CCStepLane* self) {
    int i;
    if (!hub) return 0;
    for (i = 0; i < CC_STEP_LANES_MAX; i++) {
        CCStepLane* L = hub->lanes[i];
        if (!L || L == self || !cc_atomic_load_acquire(&L->live)) continue;
        if (cc_atomic_load_acquire(&L->idle) != 0) return 1;
    }
    return 0;
}

/* Wake one idle peer so it steals while this worker works its batch. */
static int cc_step_hub_poke_idle(CCStepHub* hub, CCStepLane* self) {
    int i;
    if (!hub) return 0;
    for (i = 0; i < CC_STEP_LANES_MAX; i++) {
        CCStepLane* L = hub->lanes[i];
        int one = 1;
        if (!L || L == self || !cc_atomic_load_acquire(&L->live)) continue;
        if (cc_atomic_cas(&L->idle, &one, 2)) {
            if (L->tape) cc_tape_wake(L->tape);
            return 1;
        }
    }
    return 0;
}

/* Steps queued on a peer that has not moved for CC_SERVER_STALL_NS: take
 * them regardless of fairness, the peer cannot run them. 1 if a stalled
 * peer was seen. */
static int cc_step_steal_stalled(CCStepHub* hub, CCStepLane* self) {
    int i, seen = 0;
    uint64_t now;
    if (!hub || !self || !cc_step_steal_wanted()) return 0;
    now = cc_now_ns();
    for (i = 0; i < CC_STEP_LANES_MAX; i++) {
        CCStepLane* V = hub->lanes[i];
        uint64_t last;
        int id, n;
        if (!V || V == self || !cc_atomic_load_acquire(&V->live)) continue;
        if (cc_atomic_load_acquire(&V->idle) != 0) continue;
        if (cc_atomic_load_acquire(&V->qlen) <= 0) continue;
        last = cc_atomic_load_acquire(&V->progress);
        if (now - last < (uint64_t)CC_SERVER_STALL_NS) continue;
        seen = 1;
        for (n = 0; n < CC_STEP_STEAL_FAIR_MAX; n++) {
            CCIoSess* io = NULL;
            id = cc_step_lane_pop_thief(V, &io);
            if (id <= 0) break;
            if (self->ctx && self->ctx->srv)
                cc_atomic_fetch_add(&self->ctx->srv->step_steal, 1);
            cc_serve_run_stolen(V, id, io);
        }
    }
    return seen;
}

/* Accept until EAGAIN / batch cap. Returns accepted count, or -1 on
 * tape desync while discarding a failed arm. */
static int cc_tape_try_accept(CCTape* tape, CCArenaPool* slots) {
    int n = 0;
    while (n < CC_SERVER_ACCEPT_BATCH) {
        CCServer* srv;
        CCAccept a = tape->accept();
        @switch (a) {
        case .busy: return n;
        case .dead:
            srv = tape->srv;
            if (srv) {
                cc_server_shutdown(srv);
            }
            return n;
        case .ready(fd): {
            CCIoSess* io;
            int id;
            srv = tape->srv;
            io = cc_io_row_new(srv, fd, slots);
            if (!io) return n;
            id = tape->watch(io);
            if (!id) {
                cc_io_row_drop(NULL, io, slots);
                return n;
            }
            tape->arm(id, io) !>(e) {
                @switch (e) {
                case .conn:
                    if (tape->drop_id(id) != 0) {
                        cc_io_row_drop(NULL, io, slots);
                        return -1;
                    }
                    cc_io_row_drop(NULL, io, slots);
                    continue;
                case .desync:
                    cc_io_row_drop(NULL, io, slots);
                    return -1;
                }
            };
            srv->note_open();
            n++;
            if (cc_server_trace())
                fprintf(stderr, "cc_server: tape %p accepted fd %d, %zu sessions, %d live\n",
                        (void*)tape, fd, tape->nconns(),
                        cc_atomic_load_acquire(&srv->live));
            if (cc_tape_above_share(tape)) return n;
            break;
        }
        }
    }
    return n;
}

/* Drop WaitId: unwatch/delete first (tidy), then session pool. -1 desync. */
static int conn_drop_id(CCTape* tape, CCArenaPool* slots, ServeCtx* ctx,
                        int id) {
    CCServer* srv = tape->srv;
    CCConnRow* row = tape->row(id);
    CCIoSess* io = row ? row->io : NULL;
    if (tape->drop_id(id) != 0) return -1;
    if (io) {
        cc_io_row_drop(ctx, io, slots);
        if (srv) srv->note_close();
    }
    return 0;
}

static int cc_tape_reap(CCTape* tape, CCArenaPool* slots, ServeCtx* ctx) {
    size_t di = 0;
    while (di < tape->span()) {
        int id = 0;
        CCConnRow* row = tape->dense_at(di, &id);
        CCIoSess* io;
        if (!row) {
            di++;
            continue;
        }
        if (id <= 0) return -1;
        if (row->step_busy) {
            di++;
            continue;
        }
        io = row->io;
        if (io && !io->dead) {
            di++;
            continue;
        }
        if (conn_drop_id(tape, slots, ctx, id) < 0) return -1;
        di++;
    }
    return 0;
}

/* Drop every live row, then close. Sole legal worker-exit for an open tape. */
static void worker_tape_exit(CCTape* tape, CCArenaPool* slots, ServeCtx* ctx) {
    size_t di = 0;
    if (!tape) return;
    while (di < tape->span()) {
        int id = 0;
        CCConnRow* row = tape->dense_at(di, &id);
        if (!row) {
            di++;
            continue;
        }
        if (id <= 0) break;
        if (conn_drop_id(tape, slots, ctx, id) < 0) break;
        di++;
    }
    tape->close();
}

static void cc_server_maybe_respawn(ServeCtx* ctx);
static void cc_server_worker(ServeCtx* ctx);

static void cc_server_worker_bail(ServeCtx* ctx) {
    if (!ctx || !ctx->srv) return;
    cc_server_worker_left(ctx);
    cc_server_maybe_respawn(ctx);
}

/* Add a worker now, up to the cap: the signal was saturation or a stall.
 * Same live floor as try_grow: another worker needs sessions to share, else
 * a fast small session set (redis P=16) climbs to the CPU cap via stall
 * steals. Cooldown stops a steal/stall loop from adding every wake. */
static int cc_server_try_grow_now(CCServer* srv) {
    static _Atomic uint64_t last_grow_ns;
    int n = cc_atomic_load_acquire(&srv->nworkers);
    int live = cc_atomic_load_acquire(&srv->live);
    uint64_t now, last;
    if (n < 1 || n >= srv->workers_max) return 0;
    if (live < (n + 1) * WORKER_GROW_EVERY) return 0;
    now = cc_now_ns();
    last = cc_atomic_load_acquire(&last_grow_ns);
    if (last && now - last < (uint64_t)CC_SERVER_GROW_COOLDOWN_NS) return 0;
    if (!cc_atomic_cas(&srv->nworkers, &n, n + 1)) return 0;
    cc_atomic_store_release(&last_grow_ns, now);
    cc_server_note_workers(srv, n + 1);
    return 1;
}

static void cc_server_grow_on(ServeCtx* ctx, const char* why) {
    ServeCtx* ctxp = ctx;
    CCServer* srv = ctx->srv;
    if (!cc_server_try_grow_now(srv)) return;
    if (cc_server_trace())
        fprintf(stderr, "cc_server: grow to %d workers on %s (%d live)\n",
                cc_atomic_load_acquire(&srv->nworkers), why,
                cc_atomic_load_acquire(&srv->live));
    @parallel(srv->app) {
        cc_server_worker(ctxp);
    }
}

static void cc_server_maybe_grow(ServeCtx* ctx) {
    ServeCtx* ctxp = ctx;
    CCServer* srv;
    if (!ctx || !ctx->srv->try_grow(WORKER_GROW_EVERY)) return;
    srv = ctx->srv;
    if (cc_server_trace())
        fprintf(stderr, "cc_server: grow to %d workers (%d live)\n",
                cc_atomic_load_acquire(&srv->nworkers),
                cc_atomic_load_acquire(&srv->live));
    @parallel(srv->app) {
        cc_server_worker(ctxp);
    }
}

static void cc_server_maybe_respawn(ServeCtx* ctx) {
    ServeCtx* ctxp = ctx;
    CCServer* srv;
    if (!ctx || !cc_server_try_respawn_slot(ctx->srv)) return;
    srv = ctx->srv;
    @parallel(srv->app) {
        cc_server_worker(ctxp);
    }
}

/* Rows a thief stepped: the owner arms them on its own tape and clears
 * busy. Runs before every wait and after it, so a stolen row waits for
 * at most one batch, never for a timeout. 1 if any row died. */
static int cc_serve_rearm_stolen(CCStepLane* lane, CCTape* tape) {
    int ids[CC_STEP_Q_CAP];
    int nr = cc_step_lane_rearm_take(lane, ids, CC_STEP_Q_CAP);
    int k, died = 0;
    for (k = 0; k < nr; k++) {
        CCConnRow* row = tape->row(ids[k]);
        CCIoSess* io = row ? row->io : NULL;
        if (!row) continue;
        row->step_busy = 0;
        if (!io) continue;
        if (io->dead) { died = 1; continue; }
        {
            int ar = cc_io_arm(io, tape, ids[k], NULL) !>(e) {
                (void)e;
                io->dead = 1;
                died = 1;
                continue;
            };
            (void)ar;
        }
    }
    return died;
}

static void cc_server_worker(ServeCtx* ctx) {
    CCServer* srv = ctx->srv;
    cc_arena_stack(wa, kilobytes(8));
    CCArenaPool* slots;
    CCTape tape;
    time_t deadline_sec = 0;
    CCStepLane lane;
    int lane_on = 0;
    int busy_streak = 0;
    if (!cc_arena_is_live(wa)) {
        cc_server_worker_bail(ctx);
        return;
    }
    slots = wa.create_pool(cc_io_row_bytes(srv)) !>(e) {
        (void)e;
        cc_server_worker_bail(ctx);
        return;
    };
    /* Conn table owns WaitId → {io, interest}; no parallel live[]. */
    if (!tape.open(srv, wa)) {
        cc_server_worker_bail(ctx);
        return;
    }
    lane = (CCStepLane){0};
    if (ctx->hub && cc_step_lane_wanted() && srv->workers_max > 1) {
        pthread_mutex_init(&lane.mx, NULL);
        lane.tape = &tape;
        lane.ctx = ctx;
        cc_atomic_store_release(&lane.live, 1);
        if (cc_step_hub_attach(ctx->hub, &lane) >= 0)
            lane_on = 1;
        else {
            cc_atomic_store_release(&lane.live, 0);
            (void)pthread_mutex_destroy(&lane.mx);
        }
    }
    @defer {
        if (lane_on) {
            int id;
            cc_atomic_store_release(&lane.live, 0);
            while ((id = cc_step_lane_pop_owner(&lane)) > 0)
                (void)cc_serve_run_queued(&lane, id, 1);
            while (cc_atomic_load_acquire(&lane.inflight) > 0)
                cc_yield();
            cc_step_hub_detach(ctx->hub, &lane);
            (void)pthread_mutex_destroy(&lane.mx);
        }
        worker_tape_exit(&tape, slots, ctx);
        cc_server_worker_left(ctx);
        if (!srv->stopped())
            cc_server_maybe_respawn(ctx);
    };

    while (!srv->stopped() || tape.nconns() > 0) {
        CCWaitEpoch ep;
        int died = 0;
        int deadline_reap = 0;
        time_t now;
        if (lane_on) {
            /* idle first, then drain: a thief that pushes after the flag
             * wakes the wait; one that pushed before is drained here. */
            cc_atomic_store_release(&lane.idle, 1);
            if (cc_serve_rearm_stolen(&lane, &tape) && tape.reap(slots, ctx) < 0) return;
        }
        ep = tape.wait();
        if (lane_on) {
            cc_atomic_store_release(&lane.idle, 0);
            cc_atomic_store_release(&lane.progress, cc_now_ns());
        }
        if (ep.failed()) return;
        now = time(NULL);
        if (lane_on && cc_serve_rearm_stolen(&lane, &tape)) died = 1;
        if (lane_on && ep.idle()) busy_streak = 0;

        /* Deadlines: full walk ≤1/s, and on idle wake. On a busy wake,
         * mark dead but reap after step so ready WaitIds stay valid
         * while this batch drains. */
        if (ep.idle() || now != deadline_sec) {
            size_t n = tape.span();
            size_t di;
            deadline_sec = now;
            for (di = 0; di < n; di++) {
                CCConnRow* row = tape.dense_at(di, NULL);
                CCIoSess* io = row ? row->io : NULL;
                if (io && io->deadline && now >= io->deadline) {
                    io->dead = 1;
                    deadline_reap = 1;
                }
            }
            if (ep.idle()) {
                if (lane_on)
                    (void)cc_step_steal_stalled(ctx->hub, &lane);
                if (deadline_reap && tape.reap(slots, ctx) < 0) return;
                cc_yield();
                continue;
            }
        }

        /* Step only hits that fired this wake. With a steal lane: ready on
         * home, queue window-ready app work, drain local, steal one. */
        if (!lane_on) {
            @for (hit in ep.hits) {
                int id = hit.id;
                CCReady r = hit.ready;
                CCConnRow* row = tape.row(id);
                CCIoSess* io;
                if (!row || !row->io) continue;
                io = row->io;
                if (io->dead) continue;
                if (io->deadline && now >= io->deadline) {
                    io->dead = 1;
                    died = 1;
                    continue;
                }
                if (cc_serve_step(io, ctx, &tape, id, r, NULL) < 0) return;
                if (io->dead) died = 1;
            }
        } else {
            int queued = 0;
            @for (hit in ep.hits) {
                int id = hit.id;
                CCReady r = hit.ready;
                CCConnRow* row = tape.row(id);
                CCIoSess* io;
                int st;
                if (!row || !row->io) continue;
                io = row->io;
                if (io->dead || row->step_busy) continue;
                if (io->deadline && now >= io->deadline) {
                    io->dead = 1;
                    died = 1;
                    continue;
                }
                st = cc_serve_ready_for_queue(io, ctx, &tape, id, r);
                if (st < 0) {
                    died = 1;
                    continue;
                }
                if (st == 0) continue;
                row->step_busy = 1;
                queued++;
                if (!cc_step_lane_push(&lane, id, io)) {
                    int rc = cc_serve_run_queued(&lane, id, 1);
                    if (rc < 0) return;
                    if (rc > 0) died = 1;
                }
            }
            /* Saturation: busy wakes alone are the load. Grow only when the
             * previous batch was slow and no idle peer can take the backlog. */
            if (queued > 0) {
                if (++busy_streak >= CC_SERVER_BUSY_WAKES) {
                    busy_streak = 0;
                    if (lane.slow && !cc_step_hub_any_idle(ctx->hub, &lane))
                        cc_server_grow_on(ctx, "saturation");
                }
            } else {
                busy_streak = 0;
            }
            /* A lane whose steps have been slow invites an idle peer to
             * watch this batch; a lane of quick steps is left alone. */
            if (lane.slow && cc_atomic_load_acquire(&lane.qlen) >= 2 && cc_step_steal_wanted())
                (void)cc_step_hub_poke_idle(ctx->hub, &lane);
            {
                int id;
                int slow_steps = 0;
                while ((id = cc_step_lane_pop_owner(&lane)) > 0) {
                    uint64_t t0 = cc_now_ns();
                    uint64_t t1;
                    int rc = cc_serve_run_queued(&lane, id, 1);
                    t1 = cc_now_ns();
                    cc_atomic_store_release(&lane.progress, t1);
                    if (t1 - t0 >= (uint64_t)CC_SERVER_STALL_NS) slow_steps++;
                    if (rc < 0) return;
                    if (rc > 0) died = 1;
                }
                if (queued > 0) lane.slow = slow_steps > 0;
            }
            {
                /* Poked: the peer that asked is mid-batch; look a few times. */
                int stalled = cc_step_steal_stalled(ctx->hub, &lane);
                int k;
                for (k = 0; ep.poked && !stalled && k < 4; k++) {
                    usleep(50);
                    stalled = cc_step_steal_stalled(ctx->hub, &lane);
                }
                if (stalled && !cc_step_hub_any_idle(ctx->hub, &lane))
                    cc_server_grow_on(ctx, "stall");
            }
        }

        {
            int acc = tape.try_accept(slots);
            if (acc < 0) return;
            if (acc > 0)
                cc_server_maybe_grow(ctx);
        }

        /* Fault inject (one-shot): bail once with live rows so defer must
         * drop before tape.close(). Stress: CC_SERVER_FAULT_BAIL_LIVE=1.
         * Cache getenv — it is not free on the wake path. */
        {
            static int fault_env = -1; /* -1 unknown, 0 off, 1 on */
            static int fault_live_done;
            if (fault_env < 0) {
                const char* fault = getenv("CC_SERVER_FAULT_BAIL_LIVE");
                fault_env = (fault && fault[0] == '1') ? 1 : 0;
            }
            if (fault_env == 1 && !fault_live_done && tape.nconns() > 0) {
                fault_live_done = 1;
                return;
            }
        }

        if ((died || deadline_reap) && tape.reap(slots, ctx) < 0)
            return;
    }
}

void !>(CCError) cc_server_serve(CCServer* srv, CCSignal* stop,
                                 CCClosure1 on_app) {
    @errhandler(CCError e) { return cc_err(e); }
    CCStepHub hub;
    int hub_on = 0;
    ServeCtx ctx = { .srv = srv, .on_app = on_app, .hub = NULL, .stop = stop };
    ServeCtx* ctxp = &ctx;
    int w, n;
    @defer cc_closure1_drop(on_app);
    if (cc_step_lane_wanted() && srv->workers_max > 1) {
        cc_step_hub_init(&hub);
        ctx.hub = &hub;
        hub_on = 1;
    }
    @defer {
        if (hub_on) cc_step_hub_destroy(&hub);
    };
    srv->start(stop);
    n = srv->start_n();
    for (w = 0; w < n; w++) {
        @parallel(srv->app) {
            cc_server_worker(ctxp);
        }
    }
    srv->join() !>;
    return cc_ok();
}


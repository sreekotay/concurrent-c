; Schema-ready JSON: RFC recognition plus keep/decode string and keep
; number. Requires `jstr` in the translation unit (`<ccc/std/json.cch>`).
; Override `string` for /encode. Containers stay match-only (no collect).
include "json.rules"
string:  [#'"' keep/decode(jstr) any [some strchar | esc] #'"']
number:  keep [int opt [#'.' some digit]
                   opt [charset [#'e' #'E'] opt charset [#'+' #'-'] some digit]]

/*
 * Test header for Result return sugar in .cch files.
 * Prefer T !>(E) + cc_ok/cc_err; CCRes(T, E) remains a macro alias.
 */
#ifndef CC_IO_TEST_H
#define CC_IO_TEST_H

#include <ccc/cc_io_error.cch>
#include <ccc/cc_result.cch>

static inline bool !>(CCIoError) cc_io_test_func(void) {
    return cc_ok(true);
}

static inline int !>(CCError) cc_io_test_int(int x) {
    if (x < 0) {
        return cc_err(CC_ERR_INVALID_ARG, "negative");
    }
    return cc_ok(x * 2);
}

#endif /* CC_IO_TEST_H */

/*
 * CCTurnstile — depth cap + ordered stages.
 *
 * One core (depth channel + stages[]). The named 2-stage bind is field
 * aliases over that array — not a second implementation:
 *
 *   CCTurnstile t@(n, cap, n_stages, &arena) @destroy;
 *   t.enter(i) !>;
 *   t.stage(k)->wait(i);  …  t.stage(k)->pass(i);
 *   t.wait(k, i);         …  t.pass(k, i);
 *   t.leave() !>;
 *
 *   CCTurnstileRW ts@(n, cap, &arena) @destroy;
 *   ts.enter(i) !>;
 *   ts.read.wait(i);  …  ts.read.pass(i);
 *   ts.write.wait(i); …  ts.write.pass(i);
 *   ts.leave() !>;
 *   ts.stage(0);   // == &ts.read
 *
 * Declare the turnstile before the nursery so @destroy joins, then frees the
 * depth channel. enter(i) takes a depth token and arms every stage's i+1.
 *
 * This header lowers to host C: internals use concrete callees, not UFCS.
 */
#ifndef CCC_CC_TURNSTILE_CCH
#define CCC_CC_TURNSTILE_CCH

#include <ccc/cc_exclusive.cch>
#include <ccc/cc_channel.cch>
#include <ccc/std/vec.cch>
#include <errno.h>
#include <stddef.h>
#include <stdlib.h>
#include <string.h>

#ifndef CC_VEC_CCEXCLUSIVEGUARD_DEFINED
#define CC_VEC_CCEXCLUSIVEGUARD_DEFINED 1
CC_VEC_DECL_ARENA(CCExclusiveGuard, CCVec_CCExclusiveGuard)
#endif

typedef struct CCTurnstileStage {
    CCExclusive* excl;
    uint64_t name_base;
    int n;
    /* Ticket i+1 lives at armed[i+1]. Grown once at init; enter/pass only
     * index. A growing Map/Vec under concurrent get moves the value. */
    CCVec_CCExclusiveGuard armed;
} CCTurnstileStage;

typedef struct CCTurnstile {
    CCExclusive* excl;
    CCChan* depth_ch;
    CCTurnstileStage* stages;
    int n;
    int cap;
    int n_stages;
} CCTurnstile;

static inline void cc_turnstile_destroy(CCTurnstile* t);
static inline void cc_turnstile_stage_destroy(CCTurnstileStage* s);

static inline uint64_t cc_turnstile_stage_base(int k) {
    return (uint64_t)(k + 1) << 32;
}

static inline uint64_t cc_turnstile_stage_name(const CCTurnstileStage* s, int i) {
    return s->name_base + (uint64_t)i;
}

static inline int cc_turnstile_ready(const CCTurnstile* t) {
    return t && t->excl && t->depth_ch && t->stages && t->n_stages > 0;
}

static inline CCTurnstileStage* cc_turnstile_stage(CCTurnstile* t, int k) {
    if (!t || !t->stages || k < 0 || k >= t->n_stages)
        return NULL;
    return &t->stages[k];
}

static inline void cc_turnstile_stage_destroy(CCTurnstileStage* s) {
    CCExclusiveGuard* g;
    int i;
    if (!s)
        return;
    for (i = 1; i < s->n; i++) {
        g = CCVec_CCExclusiveGuard_get(&s->armed, (size_t)i);
        if (g)
            cc_exclusive_guard_release(g);
    }
    CCVec_CCExclusiveGuard_destroy(&s->armed);
    s->excl = NULL;
    s->n = 0;
}

static inline int cc_turnstile_stage_init(CCTurnstileStage* s, CCExclusive* excl,
                                         CCArena* arena, uint64_t name_base,
                                         int n) {
    if (!s)
        return -1;
    memset(s, 0, sizeof(*s));
    s->excl = excl;
    s->name_base = name_base;
    s->n = n;
    s->armed = CCVec_CCExclusiveGuard_init(arena, n > 0 ? (size_t)n : 0);
    if (n > 0) {
        if (CCVec_CCExclusiveGuard_reserve(&s->armed, (size_t)n) != 0 ||
            !CCVec_CCExclusiveGuard_at_grow(&s->armed, (size_t)n - 1))
            return -1;
        memset(s->armed.data, 0, (size_t)n * sizeof(CCExclusiveGuard));
    }
    return 0;
}

/* Prehold ticket i+1 so wait(i+1) cannot run ahead of pass(i).
 * enter(i) calls this on every stage — in-order spawn makes it happen-before
 * both worker(i).pass and worker(i+1).wait. */
static inline void cc_turnstile_stage_arm(CCTurnstileStage* s, int i) {
    CCExclusiveGuard* g;
    int k;
    if (!s || i + 1 >= s->n)
        return;
    k = i + 1;
    g = CCVec_CCExclusiveGuard_get(&s->armed, (size_t)k);
    if (!g)
        return;
    *g = cc_exclusive_acquire(s->excl, cc_turnstile_stage_name(s, k));
}

static inline void cc_turnstile_stage_wait(CCTurnstileStage* s, int i) {
    CCExclusiveGuard g;
    CCExclusiveMutex m;
    uint64_t name;
    if (!s || i <= 0)
        return;
    name = cc_turnstile_stage_name(s, i);
    g = cc_exclusive_acquire(s->excl, name);
    cc_exclusive_guard_release(&g);
    /* Name is idle after pass + this wait; drop it so Exclusive stays ~O(cap). */
    m = cc_exclusive_mutex(s->excl, name);
    cc_exclusive_mutex_free(&m);
}

static inline void cc_turnstile_stage_pass(CCTurnstileStage* s, int i) {
    CCExclusiveGuard* g;
    int k;
    if (!s || i + 1 >= s->n)
        return;
    k = i + 1;
    g = CCVec_CCExclusiveGuard_get(&s->armed, (size_t)k);
    if (g)
        cc_exclusive_guard_release(g);
}

static inline void cc_turnstile_wait(CCTurnstile* t, int k, int i) {
    cc_turnstile_stage_wait(cc_turnstile_stage(t, k), i);
}

static inline void cc_turnstile_pass(CCTurnstile* t, int k, int i) {
    cc_turnstile_stage_pass(cc_turnstile_stage(t, k), i);
}

static inline void cc_turnstile_destroy(CCTurnstile* t) {
    int k;
    if (!t)
        return;
    if (t->stages) {
        for (k = 0; k < t->n_stages; k++)
            cc_turnstile_stage_destroy(&t->stages[k]);
        t->stages = NULL;
    }
    if (t->depth_ch) {
        cc_channel_raw_free(t->depth_ch);
        t->depth_ch = NULL;
    }
    if (t->excl) {
        cc_exclusive_destroy(t->excl);
        t->excl = NULL;
    }
    t->n = 0;
    t->cap = 0;
    t->n_stages = 0;
}

/* slots[0..n_stages) must be contiguous CCTurnstileStage storage. */
static inline int cc_turnstile_init(CCTurnstile* t, int n, int cap, int n_stages,
                                   CCArena* arena, CCTurnstileStage* slots) {
    int k;
    int tok = 1;

    if (!t || !arena || !slots || n < 0 || cap < 1 || n_stages < 1)
        return -1;
    memset(t, 0, sizeof(*t));
    t->n = n;
    t->cap = cap;
    t->n_stages = n_stages;
    t->stages = slots;

    /* Live names stay ~n_stages*cap (one prehold per in-flight stage). */
    t->excl = cc_exclusive_create(arena, (size_t)cap * 4 + 8);
    if (!t->excl)
        return -1;

    for (k = 0; k < n_stages; k++) {
        if (cc_turnstile_stage_init(&slots[k], t->excl, arena,
                                    cc_turnstile_stage_base(k), n) != 0)
            return -1;
    }

    t->depth_ch = cc_chan_create((size_t)cap);
    if (!t->depth_ch || cc_chan_init_elem(t->depth_ch, sizeof(int)) != 0)
        return -1;
    for (k = 0; k < cap; k++) {
        if (cc_channel_raw_send(t->depth_ch, &tok, sizeof(tok)) != 0)
            return -1;
    }
    return 0;
}

static inline CCTurnstile cc_turnstile_create(int n, int cap, int n_stages,
                                             CCArena* arena) {
    CCTurnstile t;
    CCTurnstileStage* slots;

    memset(&t, 0, sizeof(t));
    if (!arena || n < 0 || cap < 1 || n_stages < 1)
        return t;
    slots = cc_arena_alloc_T_count(CCTurnstileStage, arena, (size_t)n_stages);
    if (!slots)
        return t;
    if (cc_turnstile_init(&t, n, cap, n_stages, arena, slots) != 0) {
        cc_turnstile_destroy(&t);
        memset(&t, 0, sizeof(t));
    }
    return t;
}

static inline bool !>(CCIoError) cc_turnstile_enter(CCTurnstile* t, int i) {
    int tok = 0;
    int rc;
    int k;
    if (!cc_turnstile_ready(t))
        return cc_err(cc_io_error(CC_IO_INVALID_ARGUMENT));
    rc = cc_channel_raw_recv(t->depth_ch, &tok, sizeof(tok));
    if (rc != 0) {
        /* EPIPE is Ok(false) on a byte stream. Here it means the depth
         * channel closed; `!>` would treat that as success and spawn unbounded. */
        if (rc == EPIPE)
            return cc_err(cc_io_error(CC_IO_CONNECTION_CLOSED));
        return cc_chan_result_with(t->depth_ch, rc, /*is_recv=*/true);
    }
    for (k = 0; k < t->n_stages; k++)
        cc_turnstile_stage_arm(&t->stages[k], i);
    return cc_ok(true);
}

static inline bool !>(CCIoError) cc_turnstile_leave(CCTurnstile* t) {
    int tok = 1;
    int rc;
    if (!t || !t->depth_ch)
        return cc_err(cc_io_error(CC_IO_INVALID_ARGUMENT));
    rc = cc_channel_raw_send(t->depth_ch, &tok, sizeof(tok));
    if (rc == EPIPE)
        return cc_err(cc_io_error(CC_IO_CONNECTION_CLOSED));
    return cc_chan_result_with(t->depth_ch, rc, /*is_recv=*/false);
}

/* Two-stage face: read/write are the core's stages[0]/stages[1]. */
typedef struct CCTurnstileRW {
    CCTurnstile core;
    CCTurnstileStage read;
    CCTurnstileStage write;
} CCTurnstileRW;

_Static_assert(offsetof(CCTurnstileRW, write) ==
                   offsetof(CCTurnstileRW, read) + sizeof(CCTurnstileStage),
               "CCTurnstileRW read/write must be contiguous stages");

static inline CCTurnstileRW cc_turnstile_rw_create(int n, int cap, CCArena* arena) {
    CCTurnstileRW w;
    memset(&w, 0, sizeof(w));
    if (cc_turnstile_init(&w.core, n, cap, 2, arena, &w.read) != 0) {
        cc_turnstile_destroy(&w.core);
        memset(&w, 0, sizeof(w));
    }
    return w;
}

static inline void cc_turnstile_rw_destroy(CCTurnstileRW* w) {
    if (!w)
        return;
    cc_turnstile_destroy(&w->core);
}

@typehooks on CCTurnstile {
    .create = cc_type_create_call("cc_turnstile_create"),
    .destroy = cc_type_destroy_call("cc_turnstile_destroy"),
};
@typehooks on CCTurnstileRW {
    .create = cc_type_create_call("cc_turnstile_rw_create"),
    .destroy = cc_type_destroy_call("cc_turnstile_rw_destroy"),
};
@typeview on CCTurnstileRW {
    as: core;
};

#endif /* CCC_CC_TURNSTILE_CCH */

static inline void *cc__arena_realloc_local_impl(CCArenaHost *a, void *p,
                                                size_t os, size_t ns,
                                                size_t al) {
    return cc_arena_realloc_local(a, p, os, ns, al);
}
static inline void *cc__arena_realloc_local_grow_impl(CCArenaHost *a, void *p,
                                                     size_t os, size_t ns,

/*
 * Channel throughput benchmark.
 * Measures: operations per second for buffered and unbuffered channels.
 */
#include <ccc/std/prelude.cch>
#include <ccc/stdio.cch>
#include <time.h>

#define ITERATIONS 100000

static double time_now_ms(void) {
    struct timespec ts;
    clock_gettime(CLOCK_MONOTONIC, &ts);
    return ts.tv_sec * 1000.0 + ts.tv_nsec / 1000000.0;
}

/* Buffered channel: producer/consumer in separate tasks */
static void bench_buffered(void) {
    @errhandler(CCError e) cc_error_exit(e);
    int[~1000 >] tx;
    int[~1000 <] rx;
    cc_channel_pair(&tx, &rx);
    
    double start = time_now_ms();

    {
        CCNursery __cc_nursery167 = @create() !> @destroy;
        (void)__cc_nursery167.close_on(tx);

        /* Producer */
        __cc_nursery167.spawn(() => {
            for (int i = 0; i < ITERATIONS; i++) {
                tx.send(i);
            }
        }) !>;
        
        /* Consumer */
        __cc_nursery167.spawn(() => {
            int v;
            for (int i = 0; i < ITERATIONS; i++) {
                rx.recv(&v);
            }
        }) !>;
    
    }
    double elapsed = time_now_ms() - start;
    double ops_per_sec = (ITERATIONS * 2.0) / (elapsed / 1000.0);  /* send + recv */
    
    println(@string(` buffered (cap=1000): ${ops_per_sec} ops/sec (${elapsed} ms for ${ITERATIONS} pairs)`, @scratch)) !>;
}

/* Unbuffered channel: rendezvous */
static void bench_unbuffered(void) {
    @errhandler(CCError e) cc_error_exit(e);
    int[~ >] tx;
    int[~ <] rx;
    cc_channel_pair(&tx, &rx);  /* unbuffered */
    
    int iterations = ITERATIONS / 10;  /* Unbuffered is slower */
    double start = time_now_ms();
    
    {
        CCNursery __cc_nursery168 = @create() !> @destroy;
        (void)__cc_nursery168.close_on(tx);

        __cc_nursery168.spawn(() => [iterations] {
            for (int i = 0; i < iterations; i++) {
                tx.send(i);
            }
        }) !>;
        
        __cc_nursery168.spawn(() => [iterations] {
            int v;
            for (int i = 0; i < iterations; i++) {
                rx.recv(&v);
            }
        }) !>;
    
    }
    
    double elapsed = time_now_ms() - start;
    double ops_per_sec = (iterations * 2.0) / (elapsed / 1000.0);
    
    println(@string(` unbuffered (rendezvous): ${ops_per_sec} ops/sec (${elapsed} ms for ${iterations} pairs)`, @scratch)) !>;
}

/* Single-threaded throughput (no contention) */
static void bench_single_thread(void) {
    @errhandler(CCError e) cc_error_exit(e);
    int[~1000 >] tx;
    int[~1000 <] rx;
    cc_channel_pair(&tx, &rx);
    
    double start = time_now_ms();
    
    /* Alternate send/recv to avoid filling buffer */
    for (int i = 0; i < ITERATIONS; i++) {
        tx.send(i);
        int v;
        rx.recv(&v);
    }
    
    double elapsed = time_now_ms() - start;
    double ops_per_sec = (ITERATIONS * 2.0) / (elapsed / 1000.0);
    
    println(@string(` single-thread (no contention): ${ops_per_sec} ops/sec (${elapsed} ms)`, @scratch)) !>;
    
    tx.close();
}

int main(void) {
    @errhandler(CCError e) { cc_error_log(e); return 1; }
    println("perf_channel_throughput: measuring channel performance") !>;
    
    bench_single_thread();
    bench_buffered();
    bench_unbuffered();
    
    println("perf_channel_throughput: DONE") !>;
    return 0;
}

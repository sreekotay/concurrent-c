/*
 * SPSC unbuffered rendezvous — the 1P1C row from channel_throughput,
 * long enough to sample. Nursery pair, then `@parallel spawn` with a
 * null kick so both ends are worker fibers. Caller send/recv on arm 0
 * was ~15× slower (same N); empty `@serial { }` is rejected.
 *
 *   CC_UNBUF_ITERS  default 2000000
 *   CC_UNBUF_SKIP_NURSERY=1  meeting only (profile)
 */
#include <ccc/std/prelude.cch>
#include <ccc/stdio.cch>
#include <stdlib.h>
#include <time.h>

#define DEFAULT_ITERS 2000000

static double time_now_ms(void) {
    struct timespec ts;
    clock_gettime(CLOCK_MONOTONIC, &ts);
    return ts.tv_sec * 1000.0 + ts.tv_nsec / 1000000.0;
}

int main(void) {
    @errhandler(CCError e) { cc_error_log(e); return 1; }
    int iters = DEFAULT_ITERS;
    const char* s = getenv("CC_UNBUF_ITERS");
    if (s && s[0]) {
        int v = atoi(s);
        if (v > 0) iters = v;
    }

    int skip_nursery = 0;
    {
        const char* skip = getenv("CC_UNBUF_SKIP_NURSERY");
        if (skip && skip[0] == '1') skip_nursery = 1;
    }

    double start;
    double elapsed;
    double pairs_per_sec;
    double ns;

    if (!skip_nursery) {
        int[~ >] tx;
        int[~ <] rx;
        cc_channel_pair(&tx, &rx);
        start = time_now_ms();
        {
            CCNursery n = @create() !> @destroy;
            (void)n.close(tx);
            n.spawn(() => [tx, iters] {
                int i;
                for (i = 0; i < iters; i++)
                    tx.send(i);
            }) !>;
            n.spawn(() => [rx, iters] {
                int v;
                int i;
                for (i = 0; i < iters; i++)
                    rx.recv(&v);
            }) !>;
        }
        elapsed = time_now_ms() - start;
        pairs_per_sec = iters / (elapsed / 1000.0);
        ns = elapsed * 1.0e6 / iters;
        println(@string(` unbuffered spsc: ${pairs_per_sec} pairs/sec (${elapsed} ms, ${ns} ns/pair, n=${iters})`,
                        @scratch));
    }

    {
        int[~ >] ptx;
        int[~ <] prx;
        cc_channel_pair(&ptx, &prx);
        start = time_now_ms();
        @parallel spawn {
            @serial { int noop = 0; (void)noop; }
            @serial {
                int i;
                for (i = 0; i < iters; i++)
                    ptx.send(i);
            }
            @serial {
                int v;
                int i;
                for (i = 0; i < iters; i++)
                    prx.recv(&v);
            }
        } !>.wait()!>;
        elapsed = time_now_ms() - start;
        pairs_per_sec = iters / (elapsed / 1000.0);
        ns = elapsed * 1.0e6 / iters;
        println(@string(` unbuffered spsc par: ${pairs_per_sec} pairs/sec (${elapsed} ms, ${ns} ns/pair, n=${iters})`,
                        @scratch));
    }
    return 0;
}

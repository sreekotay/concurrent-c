/*
 * Python → CC via `py_fn`, priced against a native Python call of the
 * same shape (one add), in-process and process-isolated.
 *
 *   ./cc/bin/ccc run perf/py_fn_baseline.ccs -- [iters] [samples]
 *
 * iters     callback invocations per timed sample  (default 200000)
 * samples   timed samples per mode                 (default 7; median)
 *
 * Modes (ns/call):
 *
 *   c_native       CC calling CC                         the C floor
 *   py_call        Python `f(i)` where f is Python       native call
 *   py_fn_inproc   same loop, f = py_fn(add_k, 7)        in-process mint
 *   py_fn_iso      CC→`operator.call`(py_fn, i) on the wire
 *                  (isolated `exec` is refused; no Python-side control)
 *
 * The callable is built once outside the timed region so the sample
 * prices the per-call crossing, not mint / attr lookup.
 *
 * Cross-check: every mode's sum must match the closed form.
 * Snapshot:
 *
 *   ./cc/bin/ccc run perf/py_fn_baseline.ccs \
 *     > perf/baselines/py_fn_baseline_$(date +%Y%m%d).txt
 */
#include <ccc/std/prelude.cch>
#include <ccc/script/py.cch>
#include <ccc/stdio.cch>
#include <stdlib.h>
#include <string.h>
#include <time.h>

extern int cc_eprintf(const char *fmt, ...);

static CCPyObj !>(CCPyError) add_k(long long k, const CCPyObj *args, int argc) {
    @errhandler(CCPyError e) { return cc_err(e); }
    if (argc < 1) return cc_err(cc_py_host_error("add_k: need one arg"));
    long long x = cc_py_obj_as_i64((CCPyObj *)&args[0]) !>;
    return cc_ok(cc_py_i64(args[0].home, x + k));
}

static long long add_k_c(long long k, long long n) {
    long long r = 0, i;
    for (i = 0; i < n; i++) r += i + k;
    return r;
}

static double now_ms(void) {
    struct timespec ts;
    clock_gettime(CLOCK_MONOTONIC, &ts);
    return ts.tv_sec * 1000.0 + ts.tv_nsec / 1000000.0;
}

static int cmp_double(const void *p, const void *q) {
    double a = *(const double *)p, b = *(const double *)q;
    return (a > b) - (a < b);
}

static double median(double *v, int n) {
    qsort(v, (size_t)n, sizeof(*v), cmp_double);
    return (n & 1) ? v[n / 2] : 0.5 * (v[n / 2 - 1] + v[n / 2]);
}

static double g_ms[64];
static int g_samples = 7;

static double report_ns(const char *mode, long long per) {
    @errhandler(CCError e) cc_error_exit(e);
    double m = median(g_ms, g_samples);
    double ns = m * 1e6 / (double)per;
    println(@string(` ${mode} ${m} ms ${ns} ns/call`, @scratch));
    println(@string(`RESULT scalar ${mode} ns_per_call ${ns}`, @scratch));
    return ns;
}

static long long want_sum(long long k, long long n) {
    /* sum_{i=0}^{n-1} (i + k) = n*(n-1)/2 + n*k */
    return n * (n - 1) / 2 + n * k;
}

static int bench_domain(CCPy *py, const char *py_mode, const char *fn_mode,
                        long long iters) {
    @errhandler(CCError e) cc_error_exit(e);
    @errhandler(CCPyError e) { (void)cc_eprintf("py: %s\n", e.base.message ? e.base.message : "?"); return 1; }
    long long want = want_sum(7, iters);
    long long got = 0;
    int s;
    double ns_py, ns_fn;
    CCPyFn f_cc = py_fn(add_k, 7);

    py->exec(@slice(
        "def apply_n(f, n):\n"
        "    r = 0\n"
        "    for i in range(n):\n"
        "        r += f(i)\n"
        "    return r\n"
        "def add7_py(i):\n"
        "    return i + 7\n")) !>;
    CCPyObj main_mod = py->import("__main__") !> @destroy;
    CCPyObj f_py = main_mod.get("add7_py") !> @destroy;

    /* Warm specialize. */
    {
        CCPyObj d_v = main_mod.apply_n(f_py, 20000LL) !> @destroy;
        int64_t d = d_v.as_i64() !>;
        (void)d;
        CCPyObj d_v2 = main_mod.apply_n(f_cc, 20000LL) !> @destroy;
        d = d_v2.as_i64() !>;
        (void)d;
    }

    for (s = 0; s < g_samples; s++) {
        double t0 = now_ms();
        CCPyObj r_v = main_mod.apply_n(f_py, iters) !> @destroy;
        int64_t r = r_v.as_i64() !>;
        g_ms[s] = now_ms() - t0;
        got = (long long)r;
    }
    if (got != want) {
        eprintln(@string(`MISMATCH ${py_mode}: want=${want} got=${got}`, @scratch));
        return 1;
    }
    ns_py = report_ns(py_mode, iters);

    for (s = 0; s < g_samples; s++) {
        double t0 = now_ms();
        CCPyObj r_v = main_mod.apply_n(f_cc, iters) !> @destroy;
        int64_t r = r_v.as_i64() !>;
        g_ms[s] = now_ms() - t0;
        got = (long long)r;
    }
    if (got != want) {
        eprintln(@string(`MISMATCH ${fn_mode}: want=${want} got=${got}`, @scratch));
        return 1;
    }
    ns_fn = report_ns(fn_mode, iters);

    println(@string(` ${fn_mode} ratio ${fn_mode}/${py_mode} ${ns_py > 0 ? ns_fn / ns_py : 0.0}x`, @scratch));
    println(@string(`RESULT ratio ${fn_mode}_over_${py_mode} ${ns_py > 0 ? ns_fn / ns_py : 0.0}`, @scratch));
    return 0;
}

/* Isolated wire refuses exec/eval, so drive callbacks from CC via
 * operator.call(f, i) instead of a Python apply_n loop. */
static int bench_iso(CCPy *py, long long iters) {
    @errhandler(CCError e) cc_error_exit(e);
    @errhandler(CCPyError e) { (void)cc_eprintf("py: %s\n", e.base.message ? e.base.message : "?"); return 1; }
    long long want = want_sum(7, iters);
    long long got = 0;
    int s;
    CCPyObj op = py->import("operator") !> @destroy;
    CCPyFn f_cc = py_fn(add_k, 7);

    /* Warm. */
    for (s = 0; s < 200; s++) {
        CCPyObj v_obj = op.call(f_cc, (long long)s) !> @destroy;
        long long v = v_obj.as_i64() !>;
        (void)v;
    }

    for (s = 0; s < g_samples; s++) {
        long long i = 0;
        long long t = 0;
        double t0 = now_ms();
        for (i = 0; i < iters; i++) {
            CCPyObj v_obj = op.call(f_cc, i) !> @destroy;
            long long v = v_obj.as_i64() !>;
            t += v;
        }
        g_ms[s] = now_ms() - t0;
        got = t;
    }
    if (got != want) {
        eprintln(@string(`MISMATCH py_fn_iso: want=${want} got=${got}`, @scratch));
        return 1;
    }
    report_ns("py_fn_iso", iters);
    return 0;
}

int main(int argc, char **argv) {
    @errhandler(CCError e) { cc_error_log(e); return 1; }
    CCArena a = cc_arena_heap(megabytes(8)) @destroy;
    long long iters = argc > 1 ? atoll(argv[1]) : 200000LL;
    long long want = 0;
    int s = 0;
    int rc = 0;

    g_samples = (argc > 2) ? atoi(argv[2]) : 7;
    if (g_samples < 1) g_samples = 1;
    if (g_samples > 64) g_samples = 64;
    if (iters < 1) iters = 1;

    if (!cc_py_available()) {
        puts("SKIP (no libpython)");
        return 0;
    }

    println(@string(`py_fn_baseline iters=${iters} samples=${g_samples}`, @scratch));
    println("scalar (ns/call)");

    want = want_sum(7, iters);
    for (s = 0; s < g_samples; s++) {
        double t0 = now_ms();
        long long r = add_k_c(7, iters);
        g_ms[s] = now_ms() - t0;
        if (r != want) {
            eprintln(@string(`MISMATCH c_native: want=${want} got=${r}`, @scratch));
            return 1;
        }
    }
    report_ns("c_native", iters);

    {
        CCPy py = cc_py_new(false, a) !> @destroy;
        rc |= bench_domain(&py, "py_call", "py_fn_inproc", iters);
    }

    if (cc_py_proc_available()) {
        /* Isolated pays ~100µs/hop; keep the sample short enough to finish. */
        long long on = iters / 100 > 500 ? iters / 100 : 500;
        CCPy py = cc_py_new(true, a) !> @destroy;
        println(@string(`\nisolated CC→operator.call→py_fn (iters=${on})`, @scratch));
        rc |= bench_iso(&py, on);
    } else {
        println("isolated SKIP (no python3 child)");
    }

    return rc;
}

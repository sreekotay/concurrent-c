/*
 * Capture-shaped line scan: slurp vs sync pull vs channel alloc-and-send.
 *
 * Same work as scripts/capture_baseline.sh static metrics on a visitor TU:
 *   - count lines
 *   - count cc__reparse_source_to_ast_ctx( / _ex(
 *
 *   ./cc/bin/ccc run perf/bench_line_scan.ccs -- [path] [samples] [passes] [mode] [chan_cap]
 *   ./perf/bench_line_scan_vs_bash.sh   # wall + RSS vs bash (the real compare)
 *
 * path      default: cc/src/visitor/pass_result_unwrap.c
 * samples   timed runs per mode (default 7; warm-up discarded)
 * passes    re-read the file this many times per sample (default 8)
 * mode      all | slurp | sync | chan  (default all)
 * chan_cap  buffered channel depth for chan mode (default 64)
 *
 * "Real-ish": each pass re-opens the file (I/O + scan), verifies counts,
 * reports median ms. For bash wall/RSS, use the vs_bash driver.
 *
 * --timed  skip cold verify + discarded warm-up (for vs_bash wall timing)
 * samples=0  verify only, then exit (also for vs_bash)
 */
#include <ccc/std/prelude.cch>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>

static const char* k_path_default = "cc/src/visitor/pass_result_unwrap.c";
static CCSlice k_ctx;
static CCSlice k_ex;
static size_t g_chan_cap = 64;

typedef struct ScanStats {
    int64_t lines;
    int64_t ctx;
    int64_t ex;
    int64_t bytes; /* sum of line lengths (incl. newlines when present) */
} ScanStats;

static double now_ms(void) {
    struct timespec ts;
    clock_gettime(CLOCK_MONOTONIC, &ts);
    return ts.tv_sec * 1000.0 + ts.tv_nsec / 1000000.0;
}

static void sort_doubles(double* arr, int n) {
    for (int i = 0; i < n - 1; i++) {
        for (int j = i + 1; j < n; j++) {
            if (arr[j] < arr[i]) {
                double t = arr[i];
                arr[i] = arr[j];
                arr[j] = t;
            }
        }
    }
}

static void tally_line(CCSlice line, ScanStats* s) {
    s->lines++;
    s->bytes += (int64_t)line.len;
    s->ctx += (int64_t)cc_slice_count(line, k_ctx);
    s->ex += (int64_t)cc_slice_count(line, k_ex);
}

static void tally_blob(CCSlice blob, ScanStats* s) {
    s->ctx = (int64_t)cc_slice_count(blob, k_ctx);
    s->ex = (int64_t)cc_slice_count(blob, k_ex);
    s->bytes = (int64_t)blob.len;
    s->lines = 0;
    for (size_t i = 0; i < blob.len; i++) {
        if (((const char*)blob.ptr)[i] == '\n') s->lines++;
    }
    if (blob.len > 0 && ((const char*)blob.ptr)[blob.len - 1] != '\n')
        s->lines++;
}

static int stats_eq(ScanStats a, ScanStats b) {
    return a.lines == b.lines && a.ctx == b.ctx && a.ex == b.ex;
}

/* --- slurp: read_all then scan in memory --- */
static ScanStats scan_slurp(const char* path) {
    ScanStats s = {0};
    CCArena a = cc_arena_heap(megabytes(4));
    @defer cc_arena_free(&a);
    CCFile f;
    if (cc_file_open(&f, cc_slice_cstr((char*)path), "rb") != 0) {
        fprintf(stderr, "bench_line_scan: open failed: %s\n", path);
        abort();
    }
    @defer cc_file_close(&f);

    CCSlice !>(CCIoError) rr = cc_file_read_all(&f, &a);
    if (cc_is_err(rr)) {
        fprintf(stderr, "bench_line_scan: read_all failed\n");
        abort();
    }
    tally_blob(cc_value(rr), &s);
    return s;
}

/* --- sync pull: read_line, tally, reset scratch (no full-file retain) --- */
static ScanStats scan_sync(const char* path) {
    ScanStats s = {0};
    CCArena scratch = cc_arena_heap(megabytes(1));
    @defer cc_arena_free(&scratch);
    CCFile f;
    if (cc_file_open(&f, cc_slice_cstr((char*)path), "rb") != 0) {
        fprintf(stderr, "bench_line_scan: open failed: %s\n", path);
        abort();
    }
    @defer cc_file_close(&f);

    for (;;) {
        CCSlice line = cc_slice_empty();
        bool !>(CCIoError) got = cc_file_read_line_into(&f, &scratch, &line);
        if (cc_is_err(got)) {
            fprintf(stderr, "bench_line_scan: read_line failed\n");
            abort();
        }
        if (!cc_value(got)) break;
        tally_line(line, &s);
        cc_arena_reset(&scratch);
    }
    return s;
}

/* Owned line on the wire: arena rides with the slice (channel-stable). */
typedef struct LineMsg {
    CCArena arena;
    CCSlice data;
} LineMsg;

/* --- channel: producer alloc-and-send LineMsg; single consumer owns totals --- */
static ScanStats scan_chan(const char* path) {
    CCChanTx tx = {0};
    CCChanRx rx = {0};
    size_t cap = g_chan_cap ? g_chan_cap : 1;
    CCChan* ch = cc_channel_pair_create(cap, CC_CHAN_MODE_BLOCK, false,
                                        sizeof(LineMsg),
                                        /*is_sync=*/false, CC_CHAN_TOPO_DEFAULT,
                                        /*is_ordered=*/false, &tx, &rx);
    if (!ch) {
        fprintf(stderr, "bench_line_scan: channel_pair failed (cap=%zu)\n", cap);
        abort();
    }
    @defer ch.free();

    /* Heap totals: one consumer, no shared stack ref — checker stays honest. */
    ScanStats* total = (ScanStats*)malloc(sizeof(ScanStats));
    if (!total) abort();
    *total = (ScanStats){0};

    {
        CCNursery* n = @create(NULL) @destroy;
        if (!n) abort();
        (void)n->close_on(tx);

        n->spawn(() => [tx, path] {
            CCFile f;
            if (cc_file_open(&f, cc_slice_cstr((char*)path), "rb") != 0) {
                fprintf(stderr, "bench_line_scan: open failed: %s\n", path);
                abort();
            }
            @defer cc_file_close(&f);
            for (;;) {
                /* Read into the arena that rides on the channel — no scratch copy. */
                CCArena line_a = cc_arena_heap(256);
                CCSlice line = cc_slice_empty();
                bool !>(CCIoError) got =
                    cc_file_read_line_into(&f, &line_a, &line);
                if (cc_is_err(got)) {
                    cc_arena_free(&line_a);
                    abort();
                }
                if (!cc_value(got)) {
                    cc_arena_free(&line_a);
                    break;
                }

                LineMsg msg = {0};
                msg.data = line;
                msg.arena = line_a.detach();

                bool !>(CCIoError) sent = tx.send(msg);
                if (!cc_io_avail(sent)) {
                    msg.arena.free();
                    break;
                }
            }
            tx.close();
        });

        n->spawn(() => [rx, total] {
            LineMsg msg = {0};
            while (cc_io_avail(rx.recv(&msg))) {
                tally_line(msg.data, total);
                msg.arena.free();
                msg = (LineMsg){0};
            }
        });
    }

    ScanStats out = *total;
    free(total);
    return out;
}

static double time_mode(ScanStats (*fn)(const char*), const char* path, int passes,
                        ScanStats* out_last) {
    double t0 = now_ms();
    ScanStats last = {0};
    for (int p = 0; p < passes; p++) last = fn(path);
    double dt = now_ms() - t0;
    if (out_last) *out_last = last;
    return dt;
}

static void report_mode(const char* name, double* samples, int n, double slurp_med,
                        ScanStats st, int64_t file_bytes, int passes) {
    sort_doubles(samples, n);
    double med = samples[n / 2];
    double mb = (file_bytes * (double)passes) / (1024.0 * 1024.0);
    double mb_s = med > 0 ? mb / (med / 1000.0) : 0;
    double rel = slurp_med > 0 ? med / slurp_med : 0;
    printf("%-10s  median %7.2f ms  %6.1f MB/s  %5.2fx slurp  "
           "(lines=%lld ctx=%lld ex=%lld)\n",
           name, med, mb_s, rel,
           (long long)st.lines, (long long)st.ctx, (long long)st.ex);
}

int main(int argc, char** argv) {
    const char* path = k_path_default;
    int samples = 7;
    int passes = 8;
    const char* mode = "all";
    int timed_only = 0;
    int pos = 0;

    for (int i = 1; i < argc; i++) {
        if (!strcmp(argv[i], "--timed")) {
            timed_only = 1;
            continue;
        }
        if (!argv[i][0]) continue;
        if (pos == 0) path = argv[i];
        else if (pos == 1) samples = atoi(argv[i]);
        else if (pos == 2) passes = atoi(argv[i]);
        else if (pos == 3) mode = argv[i];
        else if (pos == 4) {
            long c = strtol(argv[i], NULL, 10);
            if (c >= 1) g_chan_cap = (size_t)c;
        }
        pos++;
    }
    if (samples < 0) samples = 1;
    if (passes < 1) passes = 1;

    int want_slurp = !strcmp(mode, "all") || !strcmp(mode, "slurp");
    int want_sync = !strcmp(mode, "all") || !strcmp(mode, "sync");
    int want_chan = !strcmp(mode, "all") || !strcmp(mode, "chan");
    if (!want_slurp && !want_sync && !want_chan) {
        fprintf(stderr, "bench_line_scan: mode must be all|slurp|sync|chan\n");
        return 2;
    }

    k_ctx = CC_SLICE_LIT("cc__reparse_source_to_ast_ctx(");
    k_ex = CC_SLICE_LIT("cc__reparse_source_to_ast_ex(");

    FILE* hf = fopen(path, "rb");
    if (!hf) {
        fprintf(stderr, "bench_line_scan: cannot open %s\n", path);
        return 1;
    }
    fseek(hf, 0, SEEK_END);
    int64_t file_bytes = (int64_t)ftell(hf);
    fclose(hf);

    if (!timed_only) {
        printf("bench_line_scan: path=%s bytes=%lld samples=%d passes=%d mode=%s chan_cap=%zu\n",
               path, (long long)file_bytes, samples, passes, mode, g_chan_cap);
        if (want_chan)
            printf("chan: buffered depth=%zu LineMsg slots\n", g_chan_cap);
        printf("work: line count + count(\"%s\") + count(\"%s\")\n",
               (const char*)k_ctx.ptr, (const char*)k_ex.ptr);
    }

    /*
     * Count check: only run the modes requested. Never slurp before a
     * sync/chan-only run — /usr/bin/time -l reports max RSS (high-water),
     * so an up-front read_all permanently poisons the number.
     * Skipped under --timed (vs_bash verifies once outside the wall clock).
     */
    ScanStats ref = {0};
    int have_ref = 0;
    if (!timed_only) {
        if (want_slurp) {
            ref = scan_slurp(path);
            have_ref = 1;
        }
        if (want_sync) {
            ScanStats a = scan_sync(path);
            if (!have_ref) { ref = a; have_ref = 1; }
            else if (!stats_eq(ref, a)) {
                fprintf(stderr, "bench_line_scan: FAIL sync mismatch\n");
                return 1;
            }
        }
        if (want_chan) {
            ScanStats b = scan_chan(path);
            if (!have_ref) { ref = b; have_ref = 1; }
            else if (!stats_eq(ref, b)) {
                fprintf(stderr, "bench_line_scan: FAIL chan mismatch\n");
                return 1;
            }
        }
        printf("check: lines=%lld ctx=%lld ex=%lld  reparse_sites=%lld\n",
               (long long)ref.lines, (long long)ref.ctx, (long long)ref.ex,
               (long long)(ref.ctx + ref.ex - 1));
    }

    /* samples=0: verify only (for vs_bash cold check). */
    if (samples == 0) {
        printf("bench_line_scan: DONE\n");
        return 0;
    }

    if (!timed_only) {
        if (want_slurp) (void)time_mode(scan_slurp, path, passes, NULL);
        if (want_sync) (void)time_mode(scan_sync, path, passes, NULL);
        if (want_chan) (void)time_mode(scan_chan, path, passes, NULL);
    }

    double slurp_s[64];
    double sync_s[64];
    double chan_s[64];
    if (samples > 64) samples = 64;

    ScanStats last = {0};
    for (int i = 0; i < samples; i++) {
        if (want_slurp) slurp_s[i] = time_mode(scan_slurp, path, passes, &last);
        if (want_sync) sync_s[i] = time_mode(scan_sync, path, passes, &last);
        if (want_chan) chan_s[i] = time_mode(scan_chan, path, passes, &last);
        if (!timed_only) {
            printf("  sample %d:", i + 1);
            if (want_slurp) printf(" slurp=%.2f", slurp_s[i]);
            if (want_sync) printf(" sync=%.2f", sync_s[i]);
            if (want_chan) printf(" chan=%.2f", chan_s[i]);
            printf(" ms\n");
        }
    }

    if (timed_only) return 0;

    double slurp_med = 1.0;
    if (want_slurp) {
        sort_doubles(slurp_s, samples);
        slurp_med = slurp_s[samples / 2];
    }
    printf("---\n");
    if (want_slurp)
        report_mode("slurp", slurp_s, samples, slurp_med, ref, file_bytes, passes);
    if (want_sync)
        report_mode("sync", sync_s, samples, slurp_med, ref, file_bytes, passes);
    if (want_chan)
        report_mode("chan", chan_s, samples, slurp_med, ref, file_bytes, passes);
    printf("bench_line_scan: DONE\n");
    return 0;
}

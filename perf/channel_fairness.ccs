/*
 * channel_fairness.ccs - Demonstrates fiber scheduler fairness issue
 *
 * Issue: When chan_send() wakes a waiting receiver, the sender continues
 * running instead of yielding. With buffered channels, the producer can
 * fill the entire buffer before any consumer wakes up, causing one
 * consumer to drain everything.
 *
 * Expected: With N workers and M items, each worker should get ~M/N items
 * Actual: Worker 0 gets almost all items
 */

#include <ccc/std/prelude.cch>
#include <ccc/cc_atomic.cch>
#include <ccc/stdio.cch>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>

#define NUM_ITEMS 100
#define NUM_WORKERS 4

typedef struct {
    int value;
} Item;

/* Track how many items each worker processed */
cc_atomic_int g_worker_counts[NUM_WORKERS];

void print_distribution(const char* label) {
    @errhandler(CCError e) cc_error_exit(e);
    println(@string(`\n=== ${label} ===`, @scratch));
    println("Distribution:");
    int total = 0;
    for (int i = 0; i < NUM_WORKERS; i++) {
        int count = cc_atomic_load(&g_worker_counts[i]);
        total += count;
        float pct = 100.0f * count / NUM_ITEMS;
        println(@string(` Worker ${i}: ${count} items (${pct}%)`, @scratch));
        println(" |");
        int bar_len = (count * 40) / NUM_ITEMS;
        for (int j = 0; j < bar_len; j++) println("#");
        for (int j = bar_len; j < 40; j++) println(" ");
        println("|");
    }
    println(@string(` Total: ${total} (expected ${NUM_ITEMS})`, @scratch));
    
    int expected_per_worker = NUM_ITEMS / NUM_WORKERS;
    int max_count = 0, min_count = NUM_ITEMS;
    for (int i = 0; i < NUM_WORKERS; i++) {
        int count = cc_atomic_load(&g_worker_counts[i]);
        if (count > max_count) max_count = count;
        if (count < min_count) min_count = count;
    }
    float imbalance = (float)(max_count - min_count) / expected_per_worker * 100;
    println(@string(` Imbalance: ${imbalance}% (max=${max_count}, min=${min_count}, expected~${expected_per_worker})`, @scratch));
}

/* Test 1: Large buffer - demonstrates unfairness */
void run_test_large_buffer(void) {
    @errhandler(CCError e) cc_error_exit(e);
    for (int i = 0; i < NUM_WORKERS; i++) {
        cc_atomic_store(&g_worker_counts[i], 0);
    }
    
    Item[~16 >] tx;
    Item[~16 <] rx;
    CCChan* ch = cc_channel_pair(&tx, &rx);
    
    {
        CCNursery __cc_nursery157 = @create() !> @destroy;

        /* Producer sends all items then closes */
        __cc_nursery157.spawn(() => {
            for (int i = 0; i < NUM_ITEMS; i++) {
                Item item = {i};
                chan_send(tx, item);
            }
            chan_close(tx);
        }) !>;
        
        /* Workers receive until channel closed */
        for (int w = 0; w < NUM_WORKERS; w++) {
            int wid = w;
            __cc_nursery157.spawn(() => {
                Item item;
                while (cc_io_avail(chan_recv(rx, &item))) {
                    cc_atomic_fetch_add(&g_worker_counts[wid], 1);
                    /* Small work simulation */
                    volatile int x = 0;
                    for (int i = 0; i < 1000; i++) x += i;
                }
            }) !>;
        }
    
    }
    
    cc_chan_free(ch);
    print_distribution("Large Buffer (size=16)");
}

/* Test 2: Small buffer - forces better distribution */
void run_test_small_buffer(void) {
    @errhandler(CCError e) cc_error_exit(e);
    for (int i = 0; i < NUM_WORKERS; i++) {
        cc_atomic_store(&g_worker_counts[i], 0);
    }
    
    Item[~1 >] tx;
    Item[~1 <] rx;
    CCChan* ch = cc_channel_pair(&tx, &rx);
    
    {
        CCNursery __cc_nursery158 = @create() !> @destroy;

        __cc_nursery158.spawn(() => {
            for (int i = 0; i < NUM_ITEMS; i++) {
                Item item = {i};
                chan_send(tx, item);
            }
            chan_close(tx);
        }) !>;
        
        for (int w = 0; w < NUM_WORKERS; w++) {
            int wid = w;
            __cc_nursery158.spawn(() => {
                Item item;
                while (cc_io_avail(chan_recv(rx, &item))) {
                    cc_atomic_fetch_add(&g_worker_counts[wid], 1);
                    volatile int x = 0;
                    for (int i = 0; i < 1000; i++) x += i;
                }
            }) !>;
        }
    
    }
    
    cc_chan_free(ch);
    print_distribution("Small Buffer (size=1)");
}

int main(void) {
    @errhandler(CCError e) { cc_error_log(e); return 1; }
    println("Channel Fairness Benchmark");
    println("==========================");
    println("Demonstrates fiber scheduler fairness issue.");
    println(@string(`\n${NUM_WORKERS} workers competing for ${NUM_ITEMS} items.`, @scratch));
    println(@string(`Fair distribution: ~${NUM_ITEMS / NUM_WORKERS} items/worker.`, @scratch));
    
    run_test_large_buffer();
    run_test_small_buffer();
    
    println("");
    println("Root Cause:");
    println("-----------");
    println("When chan_send wakes a waiting receiver, the sender");
    println("continues running without yielding. With large buffers,");
    println("the producer fills the buffer before workers wake,");
    println("then one worker drains everything.");
    println("");
    println("Fix Options:");
    println("1. chan_send yields to woken waiter (immediate fairness)");
    println("2. FIFO wake + preemptive scheduling (OS-level fairness)");
    println("3. Work-stealing with fair queue (runtime change)");
    
    return 0;
}

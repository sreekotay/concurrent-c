#!/usr/bin/env -S ./cc/bin/ccc --as=shcc --release
/*
 * Bend's pow2 — 2^d by a 2-way join of two identical recursive calls.
 *
 *   pow2(0)     = 1
 *   pow2(1n+p)  = pow2(p) + pow2(p)
 *
 * Same fork family as parallel_hello.ccs: seq / `@parallel { }` /
 * `@parallel noblock` / `@parallel (d > depth - cut)`. `d` counts down
 * from the root; the predicate spawns the first `CC_PAR_CUT` levels
 * (hello's `d < cut` with `d` counting up). The leaf is `1`; the tree
 * is the join.
 *
 *   CC_PAR_DEPTH    default 20  (pow2(20n) in the sketch)
 *   CC_PAR_SAMPLES  default 5
 *   CC_PAR_CUT      default 8   — spawn that many levels from the root
 *   CC_PAR_BARE     default 1; 0 skips the ungated `par` row
 *   CC_PAR_ONLY=par|noblock  skip other rows; loop that row
 */
#include <stdint.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>

#define SAMPLE_CAP 64

static uint32_t g_depth = 20;
static uint32_t g_cut = 8;
static int g_samples = 5;

/* Volatile leaf so seq cannot CSE `pow2(p)+pow2(p)` into `2*pow2(p)`. */
static volatile uint32_t g_one = 1;

static double now_ms(void) {
    struct timespec ts;
    clock_gettime(CLOCK_MONOTONIC, &ts);
    return (double)ts.tv_sec * 1000.0 + (double)ts.tv_nsec / 1000000.0;
}

static void sort_doubles(double* arr, int n) {
    int i;
    int j;
    for (i = 0; i < n - 1; i++) {
        for (j = i + 1; j < n; j++) {
            if (arr[j] < arr[i]) {
                double t = arr[i];
                arr[i] = arr[j];
                arr[j] = t;
            }
        }
    }
}

static uint32_t env_u32(const char* key, uint32_t fallback) {
    const char* s = getenv(key);
    if (!s || !s[0])
        return fallback;
    return (uint32_t)atoi(s);
}

static uint32_t pow2_seq(uint32_t d) {
    uint32_t a;
    uint32_t b;
    if (d == 0)
        return g_one;
    a = pow2_seq(d - 1);
    b = pow2_seq(d - 1);
    return a + b;
}

static uint32_t pow2_par(uint32_t d) {
    @errhandler(CCError e) cc_error_exit(e);
    uint32_t a = 0;
    uint32_t b = 0;
    if (d == 0)
        return 1;
    @parallel {
        a = pow2_par(d - 1);
        b = pow2_par(d - 1);
    } !>.wait()!>;
    return a + b;
}

static uint32_t pow2_noblock(uint32_t d) {
    @errhandler(CCError e) cc_error_exit(e);
    uint32_t a = 0;
    uint32_t b = 0;
    if (d == 0)
        return 1;
    @parallel noblock {
        a = pow2_noblock(d - 1);
        b = pow2_noblock(d - 1);
    } !>.wait()!>;
    return a + b;
}

static uint32_t pow2_cut(uint32_t d) {
    @errhandler(CCError e) cc_error_exit(e);
    uint32_t a = 0;
    uint32_t b = 0;
    if (d == 0)
        return 1;
    @parallel (d > g_depth - g_cut) {
        a = pow2_cut(d - 1);
        b = pow2_cut(d - 1);
    } !>.wait()!>;
    return a + b;
}

typedef uint32_t (*pow2_fn)(uint32_t);

typedef struct {
    pow2_fn fn;
    uint32_t d;
    uint32_t result;
} RootEnv;

static void* root_thunk(void* arg) {
    RootEnv* e = (RootEnv*)arg;
    e->result = e->fn(e->d);
    return NULL;
}

static uint32_t run_on_fiber(pow2_fn fn, uint32_t d) {
    RootEnv e;
    e.fn = fn;
    e.d = d;
    e.result = 0;
    CCTask t = cc_fiber_spawn_task(root_thunk, &e);
    if (t.kind == CC_TASK_KIND_INVALID)
        abort();
    (void)cc_block_on_intptr(t);
    return e.result;
}

static double time_once(pow2_fn fn, uint32_t expect, int on_fiber) {
    double t0 = now_ms();
    uint32_t r = on_fiber ? run_on_fiber(fn, g_depth) : fn(g_depth);
    double t1 = now_ms();
    if (r != expect) {
        @string(`mismatch: got=${r} expect=${expect}`, @scratch).eprintln();
        abort();
    }
    return t1 - t0;
}

static double median_of(pow2_fn fn, uint32_t expect, int on_fiber) {
    double xs[SAMPLE_CAP];
    int i;
    int n = g_samples;
    (void)time_once(fn, expect, on_fiber);
    (void)time_once(fn, expect, on_fiber);
    for (i = 0; i < n; i++)
        xs[i] = time_once(fn, expect, on_fiber);
    sort_doubles(xs, n);
    return xs[n / 2];
}

g_depth = env_u32("CC_PAR_DEPTH", 20);
g_cut = env_u32("CC_PAR_CUT", 8);
g_samples = (int)env_u32("CC_PAR_SAMPLES", 5);
if (g_samples < 1)
    g_samples = 1;
if (g_depth > 31)
    g_depth = 31;
if (g_cut > g_depth)
    g_cut = g_depth;

int bare = (int)env_u32("CC_PAR_BARE", 1);
uint32_t expect = 1u << g_depth;
const char* only = getenv("CC_PAR_ONLY");
if (only && (strcmp(only, "par") == 0 || strcmp(only, "noblock") == 0)) {
    pow2_fn fn = strcmp(only, "noblock") == 0 ? pow2_noblock : pow2_par;
    int i;
    int n = g_samples;
    (void)time_once(fn, expect, 1);
    for (i = 0; i < n; i++)
        (void)time_once(fn, expect, 1);
    @string(`parallel_pow2 ${only}-only: depth=${g_depth} n=${n} expect=${expect}`, @scratch).println();
    return 0;
}
if (g_samples > SAMPLE_CAP)
    g_samples = SAMPLE_CAP;

double seq_ms = median_of(pow2_seq, expect, 0);
double par_ms = 0.0;
double noblock_ms = median_of(pow2_noblock, expect, 1);
double cut_ms = median_of(pow2_cut, expect, 1);
double vs_par = 0.0;
double vs_noblock = noblock_ms > 0.0 ? seq_ms / noblock_ms : 0.0;
double vs_cut = cut_ms > 0.0 ? seq_ms / cut_ms : 0.0;

if (bare) {
    par_ms = median_of(pow2_par, expect, 1);
    vs_par = par_ms > 0.0 ? seq_ms / par_ms : 0.0;
}

@string(`parallel_pow2 (@parallel): depth=${g_depth} cut=${g_cut} samples=${g_samples} expect=${expect}`, @scratch).println();
@string(` seq ${expect} ${seq_ms} ms`, @scratch).println();
if (bare)
    @string(` par ${expect} ${par_ms} ms vs_seq ${vs_par}x (@parallel { })`, @scratch).println();
else
    "  par  skipped  (CC_PAR_BARE=0)".println();
@string(` noblock ${expect} ${noblock_ms} ms vs_seq ${vs_noblock}x (@parallel noblock)`, @scratch).println();
@string(` cut ${expect} ${cut_ms} ms vs_seq ${vs_cut}x (@parallel (d>depth-${g_cut}))`, @scratch).println();
return 0;

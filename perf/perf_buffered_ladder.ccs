/*
 * Buffered overhead ladder.
 *
 * Goal: quantify the remaining gap to "zero overhead" by comparing:
 *  1) local loop only (no fibers, no channel)
 *  2) two-fiber loop only (scheduler cost, no channel)
 *  3) channel single-thread alternating send/recv (no contention)
 *  4) channel buffered producer+consumer fibers (target workload)
 */
#include <ccc/std/prelude.cch>
#include <ccc/stdio.cch>
#include <time.h>
#include <stdint.h>
#include <stdlib.h>

#define DEFAULT_ITERATIONS 2000000
#define DEFAULT_SAMPLES 7
#define CHANNEL_CAPACITY 1000

static int g_iterations = DEFAULT_ITERATIONS;
static int g_samples = DEFAULT_SAMPLES;

static int env_int_or(const char* name, int fallback) {
    const char* v = getenv(name);
    if (!v || !*v) return fallback;
    char* end = NULL;
    long n = strtol(v, &end, 10);
    if (!end || end == v || *end != 0 || n <= 0) return fallback;
    return (int)n;
}

static double time_now_ms(void) {
    struct timespec ts;
    clock_gettime(CLOCK_MONOTONIC, &ts);
    return ts.tv_sec * 1000.0 + ts.tv_nsec / 1000000.0;
}

static void sort_doubles(double* arr, int n) {
    for (int i = 0; i < n - 1; i++) {
        for (int j = i + 1; j < n; j++) {
            if (arr[j] < arr[i]) {
                double t = arr[i];
                arr[i] = arr[j];
                arr[j] = t;
            }
        }
    }
}

static double bench_loop_local_once(void) {
    @errhandler(CCError e) cc_error_exit(e);
    volatile int64_t checksum_a = 0;
    volatile int64_t checksum_b = 0;
    double start = time_now_ms();
    for (int i = 0; i < g_iterations; i++) {
        checksum_a += i;
        checksum_b += i;
    }
    double elapsed = time_now_ms() - start;
    if (checksum_a < 0 || checksum_b < 0) {
        eprintln(@string(`impossible checksums=${(long long)checksum_a},${(long long)checksum_b}`, @scratch)) !>;
    }
    return (g_iterations * 2.0) / (elapsed / 1000.0);
}

static double bench_loop_two_fiber_once(void) {
    @errhandler(CCError e) cc_error_exit(e);
    double start = time_now_ms();
    {
        CCNursery __cc_nursery165 = @create() !> @destroy;

        __cc_nursery165.spawn(() => {
            volatile int64_t local = 0;
            for (int i = 0; i < g_iterations; i++) {
                local += i;
            }
            if (local < 0) {
                eprintln(@string(`impossible local=${(long long)local}`, @scratch)) !>;
            }
        }) !>;
        __cc_nursery165.spawn(() => {
            volatile int64_t local = 0;
            for (int i = 0; i < g_iterations; i++) {
                local += i;
            }
            if (local < 0) {
                eprintln(@string(`impossible local=${(long long)local}`, @scratch)) !>;
            }
        }) !>;
    
    }
    double elapsed = time_now_ms() - start;
    return (g_iterations * 2.0) / (elapsed / 1000.0);
}

static double bench_chan_single_once(void) {
    @errhandler(CCError e) cc_error_exit(e);
    int[~1000 >] tx_h;
    int[~1000 <] rx_h;
    cc_channel_pair(&tx_h, &rx_h);

    double start = time_now_ms();
    int64_t checksum = 0;
    int v = 0;
    for (int i = 0; i < g_iterations; i++) {
        tx_h.send(i);
        rx_h.recv(&v);
        checksum += v;
    }
    double elapsed = time_now_ms() - start;
    if (checksum < 0) {
        eprintln(@string(`impossible checksum=${(long long)checksum}`, @scratch)) !>;
    }
    tx_h.close();
    return (g_iterations * 2.0) / (elapsed / 1000.0);
}

static double bench_chan_two_fiber_once(void) {
    @errhandler(CCError e) cc_error_exit(e);
    int[~1000 >] tx_h;
    int[~1000 <] rx_h;
    cc_channel_pair(&tx_h, &rx_h);

    double start = time_now_ms();
    {
        CCNursery __cc_nursery166 = @create() !> @destroy;
        (void)__cc_nursery166.close_on(tx_h);

        __cc_nursery166.spawn(() => {
            for (int i = 0; i < g_iterations; i++) {
                tx_h.send(i);
            }
        }) !>;

        __cc_nursery166.spawn(() => {
            int v = 0;
            int64_t checksum = 0;
            for (int i = 0; i < g_iterations; i++) {
                rx_h.recv(&v);
                checksum += v;
            }
            if (checksum < 0) {
                eprintln(@string(`impossible checksum=${(long long)checksum}`, @scratch)) !>;
            }
        }) !>;
    
    }
    double elapsed = time_now_ms() - start;
    return (g_iterations * 2.0) / (elapsed / 1000.0);
}

static double median_ops(double (*fn)(void)) {
    double ops[g_samples];
    for (int i = 0; i < g_samples; i++) {
        ops[i] = fn();
    }
    sort_doubles(ops, g_samples);
    return ops[g_samples / 2];
}

int main(void) {
    @errhandler(CCError e) { cc_error_log(e); return 1; }
    g_iterations = env_int_or("CC_BUF_ITERS", DEFAULT_ITERATIONS);
    g_samples = env_int_or("CC_BUF_SAMPLES", DEFAULT_SAMPLES);
    println(@string(`perf_buffered_ladder: cap=${CHANNEL_CAPACITY} iters=${g_iterations} samples=${g_samples}`, @scratch)) !>;
    (void)bench_chan_two_fiber_once(); /* warmup */

    double loop_local = median_ops(bench_loop_local_once);
    double loop_two_fiber = median_ops(bench_loop_two_fiber_once);
    double chan_single = median_ops(bench_chan_single_once);
    double chan_two_fiber = median_ops(bench_chan_two_fiber_once);

    println(@string(` local loop only: ${loop_local} ops/sec`, @scratch)) !>;
    println(@string(` two-fiber loop only: ${loop_two_fiber} ops/sec`, @scratch)) !>;
    println(@string(` channel single-thread pair: ${chan_single} ops/sec`, @scratch)) !>;
    println(@string(` channel buffered 2-fiber: ${chan_two_fiber} ops/sec`, @scratch)) !>;

    println(" overhead vs local loop:") !>;
    println(@string(` two-fiber loop: ${(loop_two_fiber / loop_local) * 100.0}%`, @scratch)) !>;
    println(@string(` chan single: ${(chan_single / loop_local) * 100.0}%`, @scratch)) !>;
    println(@string(` chan 2-fiber: ${(chan_two_fiber / loop_local) * 100.0}%`, @scratch)) !>;
    println(" overhead vs two-fiber loop:") !>;
    println(@string(` chan single: ${(chan_single / loop_two_fiber) * 100.0}%`, @scratch)) !>;
    println(@string(` chan 2-fiber: ${(chan_two_fiber / loop_two_fiber) * 100.0}%`, @scratch)) !>;
    println(@string(` buffered vs single-thread channel: ${(chan_two_fiber / chan_single) * 100.0}%`, @scratch)) !>;

    println("perf_buffered_ladder: DONE") !>;
    return 0;
}

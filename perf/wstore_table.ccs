/*
 * wstore_table.ccs — Table index + CCTemporalIndex wheel vs wstore5 / Go.
 *
 *   - Find: Table::[CCSliceHdr, Row*] — hdr points at Row.key (no key arena)
 *   - TTL rows: per-wheel-slot gen arenas; freelist reuse; empty → destroy;
 *     live+holes → compact when free_frac ≥ 0.5 (copy live, drop holes)
 *   - Never rows: growable never page + freelist; destroy if page empties
 *   - Explicit delete: map+wheel drop immediately; body → freelist right away
 *   - Sweep: sweeper fiber, wave-bounded retire/scan (+ empty-slot reclaim)
 *   - Phase: optional collect — pass trailing `phase` (or WSTORE_PHASE=1).
 *     Prints `# phase:` map/ttl/alloc/hold/keyfmt ns/op (1/32 sample).
 *     Costs a few % vs plain stand (timer on the hot path); leave off for M/s.
 *
 *   ./wstore_table <sec> <sweep 0|1> [theta] [wave] [shards] [clients] [write|get|drain] [phase]
 *   Compare: ./perf/compare_table_wstore.sh stand
 *   Collect: ./perf/compare_table_wstore.sh phase
 */
#include <ccc/std/prelude.cch>
#include <ccc/std/temporal_index.cch>
#include <ccc/stdio.cch>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdint.h>
#include <math.h>
#include <time.h>
#ifdef __APPLE__
#include <mach/mach.h>
#endif

#define NEVER_MS   INT64_MAX
#define MAX_SHARDS 64
#define MAX_CLIENTS 64
#define KEY_CAP    32
#define VAL_CAP    128
#define TRIM_KEYS  1000000
#define NEVER_POOL 20000
#define NEVER_CAP  256
#define RECENT     8192
#define WAVE_HOLD_US 100.0
#define WAVE_HOLD_SAMPLE 16
#define HITCH_US 1000.0
#define PHASE_EVERY 32u
#define COMPACT_FREE_FRAC 0.50
#define COMPACT_MIN_FREE 64

/* Phase collect: argv trailing "phase", or WSTORE_PHASE=1. Off for stand M/s. */

enum {
    PH_MAP = 0,
    PH_TTL,
    PH_ALLOC,
    PH_HOLD,
    PH_N
};

typedef struct Row {
    CCTemporalNode ttl; /* dies_at lives here when on the wheel */
    char key[KEY_CAP];
    uint8_t key_len;
    char val[VAL_CAP];
    uint8_t val_len;
    int8_t recs_level; /* -1 = never page */
    uint8_t recs_slot; /* wheel slot or never page index */
} Row;

typedef Row* RowPtr;
typedef Table::[CCSliceHdr, RowPtr] ShardTable;

typedef struct NeverPage {
    CCArena recs;
    Row* free_head;
    size_t live_n;
    size_t free_n;
} NeverPage;

typedef struct Store Store;

typedef struct Shard {
    int idx;
    Store* store;
    CCArena owner;
    NeverPage never_pg[NEVER_CAP];
    int never_n;
    uint8_t never_i;
    CCArena recs[CC_TEMPORAL_LEVELS][CC_TEMPORAL_MAX_SLOTS];
    ShardTable map;
    CCTemporalShard* ttl;
    Row* free_heads[CC_TEMPORAL_LEVELS][CC_TEMPORAL_MAX_SLOTS];
    size_t free_counts[CC_TEMPORAL_LEVELS][CC_TEMPORAL_MAX_SLOTS];
    size_t free_n;
    CCExclusiveMutex sweep_mu;
    cc_atomic_int stop;
    cc_atomic_int sweep_due;
    int sweep_on;
    size_t wave_recs;
    size_t ops, gets, get_hits;
    size_t drains, drained_recs, dropped, reinserted, rehashes, waves, compacts, pops;
    double wave_sum_us, wave_max_us;
    double hold_t0;
    int hold_steps;
    double phase_us[PH_N];
    size_t phase_n[PH_N];
} Shard;

struct Store {
    int nshards;
    Shard* shards;
    CCExclusive excl;
    CCShardDomain locks;
    CCTemporalIndex ix;
};

static double now_us(void) {
    struct timespec t;
    clock_gettime(CLOCK_MONOTONIC, &t);
    return t.tv_sec * 1e6 + t.tv_nsec / 1e3;
}
static int64_t now_ms(void) { return (int64_t)(now_us() / 1000.0); }

static uint64_t shard_of(Store* st, CCSlice key, size_t* out_h) {
    size_t h = cc_map_hash_slice(key);
    if (out_h) *out_h = h;
    return (uint64_t)(h % (size_t)st->nshards);
}

static size_t gen_l1(void) { return 64u * sizeof(Row) + 4096u; }
static size_t never_l1(void) { return 512u * sizeof(Row) + 8192u; }

static int g_phase = 0;

static void phase_add(Shard* s, int ph, double us) {
    if (!g_phase || ph < 0 || ph >= PH_N) return;
    s->phase_us[ph] += us;
    s->phase_n[ph]++;
}

static int phase_sample(Shard* s) {
    return g_phase && ((s->ops & (PHASE_EVERY - 1u)) == 0);
}

static CCSliceHdr row_key_hdr(const Row* r) {
    return cc_slice_hdr_from_buffer((char*)r->key, r->key_len);
}

static CCSliceHdr key_hdr(CCSlice key) {
    return cc_slice_hdr_from_buffer((char*)key.ptr, key.len);
}

static void ttl_node_init(Row* r) {
    memset(&r->ttl, 0, sizeof(r->ttl));
    r->ttl.dead = 1;
    r->ttl.level = -1;
    r->ttl.user = r;
}

static NeverPage* never_cur(Shard* s) {
    if (s->never_n < 1) {
        s->never_n = 1;
        s->never_i = 0;
    }
    return &s->never_pg[s->never_i];
}

static void never_reclaim_page(Shard* s, int i) {
    NeverPage* p;
    if (i < 0 || i >= s->never_n) return;
    p = &s->never_pg[i];
    if (p->live_n) return;
    if (s->free_n >= p->free_n) s->free_n -= p->free_n;
    else s->free_n = 0;
    p->free_head = NULL;
    p->free_n = 0;
    if (p->recs.valid()) {
        p->recs.destroy();
        memset(&p->recs, 0, sizeof(p->recs));
        s->compacts++;
    }
}

static void never_reclaim_empty(Shard* s) {
    int i;
    for (i = 0; i < s->never_n; i++)
        if (!s->never_pg[i].live_n) never_reclaim_page(s, i);
}

static int never_page_has_room(const NeverPage* p) {
    /* Prefer freelist; otherwise allow bump-grow on this page (do not seal
     * on a full L1 — that burns NEVER_CAP and aborts the mix). */
    if (p->free_head) return 1;
    if (!p->recs.valid()) return 1;
    return 1;
}

static int never_open_page(Shard* s) {
    int i;
    never_reclaim_empty(s);
    for (i = 0; i < s->never_n; i++) {
        if (s->never_pg[i].live_n) continue;
        never_reclaim_page(s, i);
        s->never_i = (uint8_t)i;
        return 1;
    }
    if (s->never_n >= NEVER_CAP) return 0;
    i = s->never_n++;
    s->never_i = (uint8_t)i;
    return 1;
}

static bool !>(CCError) never_prepare(Shard* s) {
    @errhandler(CCError e) { return cc_err(e); }
    NeverPage* p = never_cur(s);
    if (never_page_has_room(p)) {
        if (!p->recs.valid())
            p->recs = s->owner.create_heap_arena(never_l1()) !>;
        return cc_ok(true);
    }
    if (!never_open_page(s))
        return cc_err(CC_ERR_OUT_OF_MEMORY, "never pages");
    p = never_cur(s);
    if (!p->recs.valid())
        p->recs = s->owner.create_heap_arena(never_l1()) !>;
    return cc_ok(true);
}

static bool dest_slot(Shard* s, int64_t now, int64_t dies_at,
                      int8_t* level, uint8_t* slot) {
    if (dies_at == NEVER_MS) {
        *level = -1;
        *slot = s->never_n ? s->never_i : 0;
        return true;
    }
    if (!s->ttl || dies_at <= now) return false;
    return cc_temporal_slot_for(s->ttl, now, dies_at, level, slot);
}

static int same_gen(const Row* r, int8_t level, uint8_t slot) {
    if (level < 0) return r->recs_level < 0;
    return r->recs_level == level && r->recs_slot == slot;
}

static bool !>(CCError) recs_ensure(Shard* s, int8_t level, uint8_t slot) {
    @errhandler(CCError e) { return cc_err(e); }
    if (level < 0) return never_prepare(s);
    {
        CCArena* a = &s->recs[level][slot];
        if (a->valid()) return cc_ok(true);
        *a = s->owner.create_heap_arena(gen_l1()) !>;
        return cc_ok(true);
    }
}

static void recs_reclaim(void* env, int level, int slot) {
    Shard* s = (Shard*)env;
    CCArena* a;
    size_t n;
    if (!s || level < 0 || level >= CC_TEMPORAL_LEVELS) return;
    if (slot < 0 || slot >= cc_temporal_slots[level]) return;
    a = &s->recs[level][slot];
    if (!a->valid()) return;
    n = s->free_counts[level][slot];
    if (s->free_n >= n) s->free_n -= n;
    else s->free_n = 0;
    s->free_counts[level][slot] = 0;
    s->free_heads[level][slot] = NULL;
    a->destroy();
    memset(a, 0, sizeof(*a));
    s->compacts++;
}

/* Live-gen compact: copy wheel-live rows into a fresh arena, drop freelist holes.
 * Thresholded so freelist reuse stays the fast path. */
static int gen_compact(Shard* s, int level, int slot) {
    CCTemporalBucket* b;
    CCArena neu;
    CCTemporalNode* e;
    CCTemporalNode* head = NULL;
    CCTemporalNode* tail = NULL;
    CCArena* olda;
    size_t live, dead, n = 0;
    if (!s || !s->ttl || level < 0 || level >= CC_TEMPORAL_LEVELS) return 0;
    if (slot < 0 || slot >= cc_temporal_slots[level]) return 0;
    b = &s->ttl->wheel[level][slot];
    if (b->scanning) return 0;
    live = b->live_n;
    dead = s->free_counts[level][slot];
    if (!live) {
        recs_reclaim(s, level, slot);
        return 1;
    }
    if (dead < COMPACT_MIN_FREE) return 0;
    if ((double)dead / (double)(live + dead) < COMPACT_FREE_FRAC) return 0;
    {
        size_t want = live * sizeof(Row) + 4096u;
        size_t l1 = gen_l1();
        @errhandler(CCError e) { (void)e; return 0; }
        neu = s->owner.create_heap_arena(want > l1 ? want : l1) !>;
    }
    if (!neu.valid()) return 0;
    e = b->live_head;
    while (e) {
        Row* oldr = (Row*)e->user;
        CCTemporalNode* nxt = e->live_next;
        Row* nr = (Row*)neu.alloc_local_grow(sizeof(Row), _Alignof(Row));
        CCSliceHdr kh;
        size_t h;
        RowPtr* mp;
        if (!nr) {
            neu.destroy();
            return 0;
        }
        memcpy(nr, oldr, sizeof(*nr));
        nr->ttl.user = nr;
        nr->ttl.live_next = NULL;
        nr->ttl.live_prev = NULL;
        nr->ttl.dead = 0;
        nr->ttl.level = (int8_t)level;
        nr->ttl.slot = (uint8_t)slot;
        nr->recs_level = (int8_t)level;
        nr->recs_slot = (uint8_t)slot;
        kh = row_key_hdr(nr);
        h = cc_map_hash_slice_hdr(kh);
        mp = s->map->get_ptr_h(kh, h);
        if (mp && *mp == oldr) *mp = nr;
        if (!head) head = &nr->ttl;
        else {
            tail->live_next = &nr->ttl;
            nr->ttl.live_prev = tail;
        }
        tail = &nr->ttl;
        n++;
        e = nxt;
    }
    b->live_head = head;
    b->live_tail = tail;
    b->scan_e = NULL;
    b->live_n = n;
    if (s->free_n >= dead) s->free_n -= dead;
    else s->free_n = 0;
    s->free_counts[level][slot] = 0;
    s->free_heads[level][slot] = NULL;
    olda = &s->recs[level][slot];
    if (olda->valid()) olda->destroy();
    *olda = neu;
    s->compacts++;
    return 1;
}

static void row_push_free(Shard* s, Row* r) {
    int8_t level;
    uint8_t slot;
    if (!r) return;
    level = r->recs_level;
    slot = r->recs_slot;
    ttl_node_init(r);
    if (level < 0) {
        NeverPage* p;
        if (slot >= (uint8_t)s->never_n) slot = 0;
        p = &s->never_pg[slot];
        if (p->live_n) p->live_n--;
        r->ttl.live_next = (CCTemporalNode*)p->free_head;
        p->free_head = r;
        p->free_n++;
        s->free_n++;
        if (!p->live_n) never_reclaim_page(s, (int)slot);
        return;
    }
    if (level >= CC_TEMPORAL_LEVELS || slot >= (uint8_t)cc_temporal_slots[level])
        return;
    r->ttl.live_next = (CCTemporalNode*)s->free_heads[level][slot];
    s->free_heads[level][slot] = r;
    s->free_counts[level][slot]++;
    s->free_n++;
    if (s->ttl) {
        CCTemporalBucket* b = &s->ttl->wheel[level][slot];
        if (!b->live_n && !b->scanning)
            recs_reclaim(s, level, slot);
        else
            (void)gen_compact(s, level, slot);
    }
}

static Row* row_alloc(Shard* s, int8_t level, uint8_t slot) {
    Row* r = NULL;
    CCArena* a;
    if (level < 0) {
        NeverPage* p = never_cur(s);
        slot = s->never_i;
        if (p->free_head) {
            r = p->free_head;
            p->free_head = (Row*)r->ttl.live_next;
            if (p->free_n) p->free_n--;
            if (s->free_n) s->free_n--;
            s->pops++;
        } else {
            a = &p->recs;
            r = (Row*)a->alloc_local_grow(sizeof(Row), _Alignof(Row));
            if (!r) return NULL;
        }
        memset(r, 0, sizeof(*r));
        ttl_node_init(r);
        r->recs_level = -1;
        r->recs_slot = slot;
        p->live_n++;
        return r;
    }
    if (level < CC_TEMPORAL_LEVELS && slot < (uint8_t)cc_temporal_slots[level]
        && s->free_heads[level][slot]) {
        r = s->free_heads[level][slot];
        s->free_heads[level][slot] = (Row*)r->ttl.live_next;
        if (s->free_counts[level][slot]) s->free_counts[level][slot]--;
        if (s->free_n) s->free_n--;
        s->pops++;
    }
    if (!r) {
        a = &s->recs[level][slot];
        r = (Row*)a->alloc_local_grow(sizeof(Row), _Alignof(Row));
        if (!r) return NULL;
    }
    memset(r, 0, sizeof(*r));
    ttl_node_init(r);
    r->recs_level = level;
    r->recs_slot = slot;
    return r;
}

static void ttl_drop(Shard* s, Row* r) {
    if (!s->ttl || !r) return;
    s->ttl->drop(&r->ttl);
}

static bool ttl_bind(Shard* s, int64_t now, Row* r, int64_t dies_at) {
    if (!s->ttl || !r) return false;
    r->ttl.user = r;
    if (dies_at == NEVER_MS) {
        s->ttl->drop(&r->ttl);
        return true;
    }
    return s->ttl->set(now, &r->ttl, dies_at);
}

static bool row_del_map(Shard* s, Row* r) {
    CCSliceHdr kh;
    size_t h, bucket = 0, di;
    if (!r || !s->map) return false;
    kh = row_key_hdr(r);
    h = cc_map_hash_slice_hdr(kh);
    di = s->map->find_dense_h(kh, h, &bucket);
    if (di == SIZE_MAX) return false;
    {
        RowPtr* slot = s->map->at_ptr(di);
        if (slot && *slot == r) {
            s->map->del_at(di, bucket);
            return true;
        }
    }
    return false;
}

/* Drop from map+wheel. Body returns to that gen's freelist immediately
 * (reuse); TTL arena also resets when the wheel slot rotates empty. */
static void row_retire(Shard* s, Row* r) {
    if (!r) return;
    ttl_drop(s, r);
    row_del_map(s, r);
    row_push_free(s, r);
}

static void expire_gone(void* env, CCTemporalNode* node) {
    Shard* s = (Shard*)env;
    Row* r = node ? (Row*)node->user : NULL;
    if (!r) return;
    row_del_map(s, r);
    if (s->ttl) s->ttl->drop(&r->ttl);
    row_push_free(s, r);
    s->dropped++;
}

static bool !>(CCError) shard_init(Shard* s, int idx, int sweep, size_t wave,
                                   CCExclusive excl) {
    @errhandler(CCError e) { return cc_err(e); }
    *s = (Shard){0};
    s->idx = idx;
    s->sweep_on = sweep;
    s->wave_recs = wave ? wave : 512;
    s->owner = cc_arena_heap(megabytes(4));
    if (!s->owner.valid()) return cc_err(CC_ERR_OUT_OF_MEMORY, "owner");
    s->map = table_new_count::[CCSliceHdr, RowPtr](s->owner, 1024);
    if (!s->map) return cc_err(CC_ERR_OUT_OF_MEMORY, "table");
    s->sweep_mu = excl.mutex((uint64_t)(MAX_SHARDS + idx));
    return cc_ok(true);
}

static void shard_free(Shard* s) {
    int l, i;
    if (s->map) s->map->destroy();
    s->map = NULL;
    for (l = 0; l < CC_TEMPORAL_LEVELS; l++)
        for (i = 0; i < cc_temporal_slots[l]; i++)
            if (s->recs[l][i].valid()) s->recs[l][i].destroy();
    for (i = 0; i < s->never_n; i++)
        if (s->never_pg[i].recs.valid()) s->never_pg[i].recs.destroy();
    if (s->owner.valid()) s->owner.destroy();
}

static size_t shard_keys(Shard* s) { return s->map ? s->map->len() : 0; }

static Row* map_find_h(Shard* s, CCSlice key, size_t h) {
    CCSliceHdr kh = key_hdr(key);
    RowPtr* p = s->map->get_ptr_h(kh, h);
    return p ? *p : NULL;
}

static bool !>(CCError) shard_put_h(Shard* s, CCSlice key, CCSlice val, int64_t dies,
                                    size_t h) {
    @errhandler(CCError e) { return cc_err(e); }
    int64_t now = now_ms();
    int8_t level;
    uint8_t slot;
    Row* old;
    CCSliceHdr kh;
    RowPtr* mslot;
    int sample = phase_sample(s);
    double t0 = 0, t1 = 0;
    if (key.len > KEY_CAP || val.len > VAL_CAP)
        return cc_err(CC_ERR_INVALID_ARG, "cap");
    if (dies != NEVER_MS && dies <= now) {
        if (sample) t0 = now_us();
        old = map_find_h(s, key, h);
        if (sample) { t1 = now_us(); phase_add(s, PH_MAP, t1 - t0); }
        if (old) {
            row_retire(s, old);
            s->dropped++;
        }
        return cc_ok(true);
    }
    if (!dest_slot(s, now, dies, &level, &slot))
        return cc_err(CC_ERR_INVALID_ARG, "ttl slot");
    if (sample) t0 = now_us();
    kh = key_hdr(key);
    mslot = s->map->get_ptr_h(kh, h);
    old = mslot ? *mslot : NULL;
    if (sample) { t1 = now_us(); phase_add(s, PH_MAP, t1 - t0); }
    if (old && same_gen(old, level, slot)) {
        old->val_len = (uint8_t)val.len;
        if (old->val_len) memcpy(old->val, val.ptr, old->val_len);
        if (sample) t0 = now_us();
        if (!ttl_bind(s, now, old, dies))
            return cc_err(CC_ERR_OUT_OF_MEMORY, "ttl set");
        if (sample) { t1 = now_us(); phase_add(s, PH_TTL, t1 - t0); }
        s->reinserted++;
        return cc_ok(true);
    }
    if (sample) t0 = now_us();
    recs_ensure(s, level, slot) !>;
    {
        Row* r = row_alloc(s, level, slot);
        if (sample) { t1 = now_us(); phase_add(s, PH_ALLOC, t1 - t0); }
        if (!r) return cc_err(CC_ERR_OUT_OF_MEMORY, "row");
        r->key_len = (uint8_t)key.len;
        if (r->key_len) memcpy(r->key, key.ptr, r->key_len);
        r->val_len = (uint8_t)val.len;
        if (r->val_len) memcpy(r->val, val.ptr, r->val_len);
        if (old) {
            if (sample) t0 = now_us();
            ttl_drop(s, old);
            if (sample) { t1 = now_us(); phase_add(s, PH_TTL, t1 - t0); }
            *mslot = r;
            row_push_free(s, old);
            s->reinserted++;
        } else {
            CCSliceHdr durable = row_key_hdr(r);
            if (s->map->insert(durable, r) != 0) {
                row_push_free(s, r);
                return cc_err(CC_ERR_OUT_OF_MEMORY, "insert");
            }
        }
        if (sample) t0 = now_us();
        if (!ttl_bind(s, now, r, dies)) {
            row_retire(s, r);
            return cc_err(CC_ERR_OUT_OF_MEMORY, "ttl set");
        }
        if (sample) { t1 = now_us(); phase_add(s, PH_TTL, t1 - t0); }
    }
    return cc_ok(true);
}

static bool shard_delete_h(Shard* s, CCSlice key, size_t h) {
    int sample = phase_sample(s);
    double t0 = 0, t1 = 0;
    Row* r;
    if (sample) t0 = now_us();
    r = map_find_h(s, key, h);
    if (sample) { t1 = now_us(); phase_add(s, PH_MAP, t1 - t0); }
    if (!r) return false;
    row_retire(s, r);
    return true;
}

static int shard_get_h(Shard* s, CCSlice key, size_t h) {
    int sample = phase_sample(s);
    double t0 = 0, t1 = 0;
    Row* r;
    s->gets++;
    if (sample) t0 = now_us();
    r = map_find_h(s, key, h);
    if (sample) { t1 = now_us(); phase_add(s, PH_MAP, t1 - t0); }
    if (!r) return 0;
    s->get_hits++;
    return 1;
}

static void sweep_arm(Shard* s) { cc_atomic_store(&s->sweep_due, 1); }

static void sweep_kick(Shard* s) {
    sweep_arm(s);
    CCExclusiveGuard g = s->sweep_mu.acquire();
    g.signal();
    g.release();
}

static int sweep_due_pred(void* env) {
    Shard* s = (Shard*)env;
    return cc_atomic_load(&s->sweep_due) || cc_atomic_load(&s->stop);
}

static int64_t shard_next_due(Shard* s) {
    return s->ttl ? s->ttl->next_due() : INT64_MAX;
}

static void note_hold(Shard* s, const char* verb, double us, size_t n) {
    @errhandler(CCError e) { (void)e; }
    s->waves++;
    s->wave_sum_us += us;
    if (us > s->wave_max_us) s->wave_max_us = us;
    if (us >= HITCH_US)
        println(@string(`# hitch shard=${s->idx} verb=${verb} us=${us} n=${n}`, @scratch));
}

static size_t sweep_held(Shard* s, int64_t now) {
    size_t n = 0;
    if (!s->ttl) return 0;
    s->ttl->retire(now);
    while (n < s->wave_recs) {
        size_t chunk = WAVE_HOLD_SAMPLE;
        size_t got;
        if (chunk > s->wave_recs - n) chunk = s->wave_recs - n;
        got = s->ttl->scan(now, chunk, expire_gone, s);
        n += got;
        s->hold_steps += (int)got;
        if (got < chunk) break;
        if ((now_us() - s->hold_t0) >= WAVE_HOLD_US) break;
    }
    s->ttl->refresh();
    return n;
}

static void !>(CCError) sweep_wave(Shard* s) {
    double us;
    size_t n;
    int64_t now;
    CCExclHold hold = s->store->locks.hold_one((uint64_t)s->idx) @destroy;
    if (!hold.held()) return cc_err(CC_ERR_INVALID_ARG, "shard hold");
    s->hold_t0 = now_us();
    s->hold_steps = 0;
    now = now_ms();
    cc_atomic_store(&s->sweep_due, 0);
    n = sweep_held(s, now);
    s->drained_recs += n;
    if (n) s->drains++;
    us = now_us() - s->hold_t0;
    if (n) note_hold(s, "expire", us, n);
    if (n == s->wave_recs || now_ms() >= shard_next_due(s)) sweep_arm(s);
    return cc_ok();
}

static void sweeper(Shard* s) {
    @errhandler(CCError e) { (void)e; return; }
    while (!cc_atomic_load(&s->stop)) {
        int64_t wait = shard_next_due(s) - now_ms();
        CCDeadline dl;
        CCDeadline* prev;
        CCExclusiveGuard !>(CCError) r;
        if (wait < 1) wait = 1;
        dl = cc_deadline_after_ms((uint64_t)wait);
        prev = cc_deadline_push(&dl);
        r = s->sweep_mu.acquire_when(sweep_due_pred, s);
        cc_deadline_pop(prev);
        if (cc_is_err(r)) {
            if (r.u.error.kind != CC_ERR_TIMEOUT) return;
        } else {
            CCExclusiveGuard hold = r.u.value;
            hold.release();
        }
        if (cc_atomic_load(&s->stop)) return;
        sweep_wave(s) !>;
        if (cc_atomic_load(&s->stop)) return;
    }
}

static size_t shard_trim(Shard* s, size_t want) {
    size_t have = shard_keys(s);
    size_t need, did = 0;
    if (have <= want) return 0;
    need = have - want;
    while (did < need && s->map->len() > 0) {
        size_t di = s->map->len() - 1;
        RowPtr* slot = s->map->at_ptr(di);
        Row* r = slot ? *slot : NULL;
        if (!r) break;
        row_retire(s, r);
        did++;
    }
    return did;
}

static void store_trim(Store* st, size_t target) {
    size_t total = 0;
    int i;
    for (i = 0; i < st->nshards; i++) total += shard_keys(&st->shards[i]);
    if (total <= target) return;
    {
        size_t need = total - target;
        for (i = 0; i < st->nshards && need; i++) {
            size_t have = shard_keys(&st->shards[i]);
            size_t fair = have * need / (total ? total : 1);
            if (fair > have) fair = have;
            need -= shard_trim(&st->shards[i], have > fair ? have - fair : 0);
        }
    }
}

static void store_counts(Store* st, size_t* live, size_t* mapn) {
    size_t L = 0, M = 0;
    int i;
    for (i = 0; i < st->nshards; i++) {
        size_t n = shard_keys(&st->shards[i]);
        L += n;
        M += n;
    }
    if (live) *live = L;
    if (mapn) *mapn = M;
}

static size_t rss_kib(void) {
#ifdef __APPLE__
    task_vm_info_data_t info;
    mach_msg_type_number_t count = TASK_VM_INFO_COUNT;
    if (task_info(mach_task_self(), TASK_VM_INFO, (task_info_t)&info, &count) != KERN_SUCCESS)
        return SIZE_MAX;
    return (size_t)(info.phys_footprint / 1024);
#else
    return SIZE_MAX;
#endif
}

static size_t shard_commit(Shard* s) {
    size_t n = cc_arena_committed_gross_bytes(s->owner);
    int l, i;
    for (int ni = 0; ni < s->never_n; ni++)
        if (s->never_pg[ni].recs.valid())
            n += cc_arena_committed_gross_bytes(s->never_pg[ni].recs);
    for (l = 0; l < CC_TEMPORAL_LEVELS; l++)
        for (i = 0; i < cc_temporal_slots[l]; i++)
            if (s->recs[l][i].valid())
                n += cc_arena_committed_gross_bytes(s->recs[l][i]);
    if (s->map) n += s->map->live_bytes();
    return n;
}

static void print_mem(Store* st, const char* when) {
    size_t commit = 0, live = 0, mapn = 0, rss;
    int i;
    for (i = 0; i < st->nshards; i++) {
        CCExclHold hold = st->locks.hold_one((uint64_t)i) @destroy;
        commit += shard_commit(&st->shards[i]);
        live += shard_keys(&st->shards[i]);
        mapn += shard_keys(&st->shards[i]);
    }
    rss = rss_kib();
    if (rss == SIZE_MAX)
        println(@string(`# mem: ${when} commit_KiB=${commit / 1024} rss_KiB=? epochs=0 live_n=${live} map_n=${mapn}`, @scratch));
    else
        println(@string(`# mem: ${when} commit_KiB=${commit / 1024} rss_KiB=${rss} epochs=0 live_n=${live} map_n=${mapn}`, @scratch));
    fflush(stdout);
}

typedef struct Client {
    Store* st;
    int id, nclients, mix_get, mix_drain;
    uint64_t rng;
    double t_start, t_end;
    long ops;
    char recent[RECENT][32];
    size_t recent_n;
    double key_us, hold_us;
    size_t key_n, hold_n;
} Client;

static uint64_t rnd(Client* c) {
    c->rng ^= c->rng << 13;
    c->rng ^= c->rng >> 7;
    c->rng ^= c->rng << 17;
    return c->rng;
}
static double rndf(Client* c) { return (double)(rnd(c) >> 11) / 9007199254740992.0; }

static size_t put_key(char* dst, char kind, int id, long seq) {
    size_t n = 0;
    dst[n++] = kind;
    dst[n++] = ':';
    if (id >= 0) {
        char tmp[16];
        int i = 0, v = id;
        if (v == 0) tmp[i++] = '0';
        else {
            char rev[16];
            int r = 0;
            while (v) { rev[r++] = (char)('0' + (v % 10)); v /= 10; }
            while (r) tmp[i++] = rev[--r];
        }
        memcpy(dst + n, tmp, (size_t)i);
        n += (size_t)i;
        dst[n++] = ':';
    }
    {
        char tmp[24];
        int i = 0;
        long v = seq;
        if (v < 0) v = -v;
        if (v == 0) tmp[i++] = '0';
        else {
            char rev[24];
            int r = 0;
            while (v) { rev[r++] = (char)('0' + (v % 10)); v /= 10; }
            while (r) tmp[i++] = rev[--r];
        }
        memcpy(dst + n, tmp, (size_t)i);
        n += (size_t)i;
    }
    return n;
}

static CCSlice recent_at(Client* c) {
    const char* k = c->recent[rnd(c) % (c->recent_n < RECENT ? c->recent_n : RECENT)];
    size_t n = 0;
    while (k[n]) n++;
    return cc_slice_from_buffer((char*)k, n);
}

static void remember_key(Client* c, CCSlice kb) {
    char* dst = c->recent[c->recent_n % RECENT];
    size_t n = kb.len < 31 ? kb.len : 31;
    if (n) memcpy(dst, kb.ptr, n);
    dst[n] = 0;
    c->recent_n++;
}

static void client(Client* c) {
    @errhandler(CCError e) { (void)e; return; }
    Store* st = c->st;
    char val[128];
    char keybuf[KEY_CAP];
    long seq = 0;
    double p_ttl = c->mix_get ? 0.20 : 0.55;
    double p_never = c->mix_get ? 0.25 : 0.70;
    double p_del = c->mix_get ? 0.30 : 0.85;
    memset(val, 'v', sizeof val);
    for (;;) {
        double t = now_us();
        int64_t now;
        double r;
        CCSlice kb;
        uint64_t si;
        Shard* s;
        size_t kn, kh = 0;
        int sample;
        double t0, t1, th0, th1;
        if (t >= c->t_end) break;
        if (c->mix_drain && t >= c->t_start + (c->t_end - c->t_start) * 0.10)
            return;
        now = (int64_t)(t / 1000.0);
        r = rndf(c);
        sample = g_phase && (((size_t)c->ops & (PHASE_EVERY - 1u)) == 0);
        if (sample) t0 = now_us();
        if (c->mix_drain) {
            if (c->nclients == 1) kn = put_key(keybuf, 'e', -1, seq);
            else kn = put_key(keybuf, 'e', c->id, seq);
            seq++;
            kb = cc_slice_from_buffer(keybuf, kn);
            if (sample) { t1 = now_us(); c->key_us += t1 - t0; c->key_n++; }
            si = shard_of(st, kb, &kh);
            s = &st->shards[si];
            if (sample) th0 = now_us();
            {
                CCExclHold hold = st->locks.hold_one(si) @destroy;
                if (sample) { th1 = now_us(); c->hold_us += th1 - th0; c->hold_n++; phase_add(s, PH_HOLD, th1 - th0); }
                if (!hold.held()) return;
                s->ops++;
                shard_put_h(s, kb, cc_slice_from_buffer(val, 96), now + 200, kh) !>;
                if (s->sweep_on) sweep_arm(s);
                c->ops++;
            }
            continue;
        } else if (r < p_ttl) {
            if (c->nclients == 1) kn = put_key(keybuf, 'e', -1, seq);
            else kn = put_key(keybuf, 'e', c->id, seq);
            seq++;
            kb = cc_slice_from_buffer(keybuf, kn);
        } else if (r < p_never) {
            long id = (long)(NEVER_POOL * pow(rndf(c), 3.0));
            kn = put_key(keybuf, 'n', -1, id);
            kb = cc_slice_from_buffer(keybuf, kn);
        } else if (r < p_del) {
            if ((rnd(c) & 1) && c->recent_n) kb = recent_at(c);
            else {
                long id = (long)(NEVER_POOL * pow(rndf(c), 3.0));
                kn = put_key(keybuf, 'n', -1, id);
                kb = cc_slice_from_buffer(keybuf, kn);
            }
        } else {
            if (c->mix_get && c->recent_n && (rnd(c) & 3) == 0)
                kb = recent_at(c);
            else {
                long id = (long)(NEVER_POOL * rndf(c));
                kn = put_key(keybuf, 'n', -1, id);
                kb = cc_slice_from_buffer(keybuf, kn);
            }
        }
        if (sample) { t1 = now_us(); c->key_us += t1 - t0; c->key_n++; }
        si = shard_of(st, kb, &kh);
        s = &st->shards[si];
        if (sample) th0 = now_us();
        {
            CCExclHold hold = st->locks.hold_one(si) @destroy;
            if (sample) { th1 = now_us(); c->hold_us += th1 - th0; c->hold_n++; phase_add(s, PH_HOLD, th1 - th0); }
            if (!hold.held()) return;
            s->ops++;
            if (r >= p_del) {
                (void)shard_get_h(s, kb, kh);
            } else if (r < p_ttl) {
                int64_t dies = now + (int64_t)(50.0 * pow(400.0, rndf(c)));
                shard_put_h(s, kb, cc_slice_from_buffer(val, 96), dies, kh) !>;
                remember_key(c, kb);
                if (s->sweep_on) sweep_arm(s);
            } else if (r < p_never) {
                shard_put_h(s, kb, cc_slice_from_buffer(val, 96), NEVER_MS, kh) !>;
            } else {
                shard_delete_h(s, kb, kh);
            }
            c->ops++;
        }
    }
}

static bool !>(CCError) preload_never(Store* st) {
    @errhandler(CCError e) { return cc_err(e); }
    char val[128];
    char keybuf[KEY_CAP];
    memset(val, 'v', sizeof val);
    for (long id = 0; id < NEVER_POOL; id++) {
        size_t kn = put_key(keybuf, 'n', -1, id);
        CCSlice k = cc_slice_from_buffer(keybuf, kn);
        size_t kh = 0;
        uint64_t si = shard_of(st, k, &kh);
        Shard* s = &st->shards[si];
        CCExclHold hold = st->locks.hold_one(si) @destroy;
        if (!hold.held()) return cc_err(CC_ERR_INVALID_ARG, "shard hold");
        shard_put_h(s, k, cc_slice_from_buffer(val, 96), NEVER_MS, kh) !>;
    }
    return cc_ok(true);
}

typedef struct Reporter {
    Store* st;
    double t_start, t_end;
    size_t* nworkers;
} Reporter;

static void reporter(Reporter* rp) {
    @errhandler(CCError e) { (void)e; return; }
    println("#      t_s      keys logical_KiB commit_KiB rss_KiB drains dropped reinsert  waves rehash      ops");
    for (;;) {
        size_t keys = 0, committed = 0, drains = 0, dropped = 0, reins = 0, waves = 0, ops = 0;
        int i;
        cc_sleep_ms(1000);
        if (now_us() >= rp->t_end) {
            if (rp->nworkers) *rp->nworkers = cc_sched_get_num_workers();
            return;
        }
        for (i = 0; i < rp->st->nshards; i++) {
            Shard* s = &rp->st->shards[i];
            CCExclHold hold = rp->st->locks.hold_one((uint64_t)i) @destroy;
            if (!hold.held()) continue;
            keys += shard_keys(s);
            committed += shard_commit(s);
            drains += s->drains;
            dropped += s->dropped;
            reins += s->reinserted;
            waves += s->waves;
            ops += s->ops;
        }
        {
            size_t rss = rss_kib();
            CCString rss_str = rss == SIZE_MAX ? @string(`?`, @scratch)
                : @string(`${rss}`, @scratch);
            println(@string(`  ${(now_us() - rp->t_start) / 1e6} ${keys} 0 ${committed / 1024} ${rss_str} ${drains} ${dropped} ${reins} ${waves} 0 ${ops}`, @scratch));
            fflush(stdout);
        }
    }
}

int main(int argc, char** argv) {
    @errhandler(CCError e) { cc_error_log(e); return 1; }
    double seconds = argc > 1 ? atof(argv[1]) : 20;
    int sweep = argc > 2 ? atoi(argv[2]) : 1;
    double theta = argc > 3 ? atof(argv[3]) : 0.35;
    size_t wave = argc > 4 ? (size_t)atol(argv[4]) : 512;
    int nshards = argc > 5 ? atoi(argv[5]) : 1;
    int nclients = argc > 6 ? atoi(argv[6]) : 1;
    int mix_get = 0, mix_drain = 0;
    size_t nworkers = 0;
    static Shard shards[MAX_SHARDS];
    static Client clients[MAX_CLIENTS];
    static Store st;
    static Reporter rp;
    (void)theta;
    if (nshards < 1) nshards = 1;
    if (nshards > MAX_SHARDS) nshards = MAX_SHARDS;
    if (nclients < 1) nclients = 1;
    if (nclients > MAX_CLIENTS) nclients = MAX_CLIENTS;
    if (argc > 7) {
        if (strcmp(argv[7], "get") == 0) mix_get = 1;
        else if (strcmp(argv[7], "drain") == 0) mix_drain = 1;
        else if (strcmp(argv[7], "write") != 0) {
            eprintln("mix must be write, get, or drain");
            return 1;
        }
    }
    if (argc > 8 && strcmp(argv[8], "phase") == 0) g_phase = 1;
    if (getenv("WSTORE_PHASE") && getenv("WSTORE_PHASE")[0] == '1') g_phase = 1;
    if (getenv("WSTORE_PHASE") && getenv("WSTORE_PHASE")[0] == '0') g_phase = 0;
    st.nshards = nshards;
    st.shards = shards;
    CCArena excl_arena = cc_arena_heap(kilobytes(64));
    @defer excl_arena.destroy();
    CCExclusive excl = cc_exclusive_create(excl_arena, (size_t)MAX_SHARDS * 2u) !> @destroy;
    st.excl = excl;
    st.locks = cc_shard_domain(excl, cc_shard_mask_ceil((size_t)nshards, MAX_SHARDS));
    if (!cc_temporal_index_init(&st.ix, (size_t)nshards, now_ms())) return 1;
    @defer cc_temporal_index_destroy(&st.ix);
    for (int i = 0; i < nshards; i++) {
        shard_init(&shards[i], i, sweep, wave, excl) !>;
        shards[i].store = &st;
        shards[i].ttl = cc_temporal_index_shard(&st.ix, (size_t)i);
        shards[i].ttl->on_empty = recs_reclaim;
        shards[i].ttl->on_empty_env = &shards[i];
    }
    @defer { for (int i = 0; i < nshards; i++) shard_free(&shards[i]); }

    println(@string(`# wstore_table TableStore seconds=${seconds} sweep=${sweep} mix=${mix_drain ? "drain" : (mix_get ? "get" : "write")} theta=${theta} wave_recs=${wave} shards=${nshards} clients=${nclients} always_new=0 temporal_index=1 gen_arena=1 key_hdr=1 wheel=100ms x64, 1s x64, 60s x60`, @scratch));
    print_mem(&st, "idle");
    if (mix_get) preload_never(&st) !>;

    {
        double t0 = now_us();
        rp.st = &st;
        rp.t_start = t0;
        rp.t_end = t0 + seconds * 1e6;
        rp.nworkers = &nworkers;
        for (int i = 0; i < nclients; i++) {
            clients[i] = (Client){0};
            clients[i].st = &st;
            clients[i].id = i;
            clients[i].nclients = nclients;
            clients[i].rng = 0x9E3779B97F4A7C15ull;
            if (i != 0)
                clients[i].rng ^= (uint64_t)(i + 1) * 0xD1B54A32D192ED03ull;
            clients[i].t_start = t0;
            clients[i].t_end = rp.t_end;
            clients[i].mix_get = mix_get;
            clients[i].mix_drain = mix_drain;
        }
        {
            CCNursery n = cc_nursery_create() !> @destroy;
            if (sweep)
                for (int i = 0; i < nshards; i++) {
                    Shard* sp = &shards[i];
                    n.spawn(() => [sp] { sweeper(sp); }) !>;
                }
            for (int i = 0; i < nclients; i++) {
                Client* cp = &clients[i];
                n.spawn(() => [cp] { client(cp); }) !>;
            }
            Reporter* rpp = &rp;
            Store* stp = &st;
            n.spawn(() => [rpp, stp] {
                reporter(rpp);
                for (int i = 0; i < stp->nshards; i++) {
                    cc_atomic_store(&stp->shards[i].stop, 1);
                    sweep_kick(&stp->shards[i]);
                }
            }) !>;
        }
    }

    {
        long ops = 0;
        size_t drains = 0, drec = 0, dropped = 0, reins = 0, gets = 0, hits = 0;
        size_t waves = 0, compacts = 0, pops = 0, total_free = 0, total_recs = 0;
        size_t total_live = 0, total_map = 0;
        double wsum = 0, wmax = 0;
        double ph_us[PH_N] = {0};
        size_t ph_n[PH_N] = {0};
        double key_us = 0, hold_us = 0;
        size_t key_n = 0, hold_n = 0;
        double ph_sum = 0;
        int i, p;
        for (i = 0; i < nclients; i++) {
            ops += clients[i].ops;
            key_us += clients[i].key_us;
            key_n += clients[i].key_n;
            hold_us += clients[i].hold_us;
            hold_n += clients[i].hold_n;
        }
        for (i = 0; i < nshards; i++) {
            Shard* s = &shards[i];
            int l, si;
            drains += s->drains;
            drec += s->drained_recs;
            dropped += s->dropped;
            reins += s->reinserted;
            gets += s->gets;
            hits += s->get_hits;
            waves += s->waves;
            compacts += s->compacts;
            pops += s->pops;
            total_free += s->free_n;
            wsum += s->wave_sum_us;
            if (s->wave_max_us > wmax) wmax = s->wave_max_us;
            total_live += shard_keys(s);
            total_map += shard_keys(s);
            for (int ni = 0; ni < s->never_n; ni++)
                if (s->never_pg[ni].recs.valid())
                    total_recs += cc_arena_committed_gross_bytes(s->never_pg[ni].recs);
            for (l = 0; l < CC_TEMPORAL_LEVELS; l++)
                for (si = 0; si < cc_temporal_slots[l]; si++)
                    if (s->recs[l][si].valid())
                        total_recs += cc_arena_committed_gross_bytes(s->recs[l][si]);
            for (p = 0; p < PH_N; p++) {
                ph_us[p] += s->phase_us[p];
                ph_n[p] += s->phase_n[p];
            }
        }
        for (p = 0; p < PH_N; p++) ph_sum += ph_us[p];
        ph_sum += key_us;
        print_mem(&st, "end");
        println(@string(`# keys: live_n=${total_live} map_n=${total_map}`, @scratch));
        store_trim(&st, TRIM_KEYS);
        {
            size_t trim_live = 0, trim_map = 0;
            store_counts(&st, &trim_live, &trim_map);
            print_mem(&st, "trim");
            println(@string(`# keys: trim live_n=${trim_live} map_n=${trim_map} target=${TRIM_KEYS}`, @scratch));
        }
        println(@string(`# ops=${ops} (${seconds > 0 ? ops / seconds / 1e6 : 0}M/s)  get_hits=${hits}/${gets} workers=${nworkers}`, @scratch));
        println(@string(`# expire: dropped=${dropped} drained_recs=${drec} drains=${drains} reinserted=${reins}`, @scratch));
        println(@string(`# index: rehashes=0  (map grow, not expire)`, @scratch));
        println(@string(`# compact: compacts=${compacts} pops=${pops} free_frac=${total_live ? (double)total_free / (double)(total_live + total_free) : 0} slack=1 live_n=${total_live} free_n=${total_free} recs_commit_KiB=${total_recs / 1024}`, @scratch));
        println(@string(`# waves=${waves} mean=${waves ? wsum / waves : 0} us max=${wmax} us (hold ${WAVE_HOLD_US} us / sample ${WAVE_HOLD_SAMPLE}, budget ${wave} recs)`, @scratch));
        {
            double map_ns = ph_n[PH_MAP] ? ph_us[PH_MAP] * 1000.0 / (double)ph_n[PH_MAP] : 0;
            double ttl_ns = ph_n[PH_TTL] ? ph_us[PH_TTL] * 1000.0 / (double)ph_n[PH_TTL] : 0;
            double alloc_ns = ph_n[PH_ALLOC] ? ph_us[PH_ALLOC] * 1000.0 / (double)ph_n[PH_ALLOC] : 0;
            double hold_ns = ph_n[PH_HOLD] ? ph_us[PH_HOLD] * 1000.0 / (double)ph_n[PH_HOLD] : 0;
            double key_ns = key_n ? key_us * 1000.0 / (double)key_n : 0;
            double pct_map = ph_sum > 0 ? 100.0 * ph_us[PH_MAP] / ph_sum : 0;
            double pct_ttl = ph_sum > 0 ? 100.0 * ph_us[PH_TTL] / ph_sum : 0;
            double pct_alloc = ph_sum > 0 ? 100.0 * ph_us[PH_ALLOC] / ph_sum : 0;
            double pct_hold = ph_sum > 0 ? 100.0 * ph_us[PH_HOLD] / ph_sum : 0;
            double pct_key = ph_sum > 0 ? 100.0 * key_us / ph_sum : 0;
            if (g_phase)
                println(@string(`# phase: sample=1/${PHASE_EVERY} map=${map_ns}ns (${pct_map}%) ttl=${ttl_ns}ns (${pct_ttl}%) alloc=${alloc_ns}ns (${pct_alloc}%) hold=${hold_ns}ns (${pct_hold}%) keyfmt=${key_ns}ns (${pct_key}%)`, @scratch));
        }
        for (i = 0; i < nshards; i++) {
            Shard* s = &shards[i];
            size_t ttl_n = s->ttl ? s->ttl->len() : 0;
            println(@string(`#   shard ${i}: ops=${s->ops} keys=${shard_keys(s)} waves=${s->waves} drains=${s->drains} compacts=${s->compacts} ttl_live=${ttl_n} free_n=${s->free_n}`, @scratch));
        }
    }
    return 0;
}

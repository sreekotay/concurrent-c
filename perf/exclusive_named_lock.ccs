/*
 * exclusive_named_lock.ccs — named exclusive sections (Concurrent-C)
 *
 * Fair cross-language protocol (see also go/, rust/, zig/). Same env knobs,
 * same Zipf + CS work, same checks. No start-gun / ready barrier: wall time
 * is spawn → work → join. Overlap is earned by the workload.
 *
 * Zipf path (product-shaped mix of hot/cold names, lock BY NAME):
 *   for I: k = zipf_pick(); g = excl->acquire(k); row[k]++; g.release();
 *   Expect sum(row[0..KEYS)) == W*I.
 *   The name→lock directory lookup is part of every iteration — that is the
 *   product being measured. No pre-resolved handles in this path.
 *
 * Serial fast path (one resolved mutex, no spawn/scheduler):
 *   one caller performs W*I acquire/release pairs with cs_spins=0.
 *   This isolates uncontended lock-pair cost from directory + scheduling.
 *
 * Idioms (each language's reasonable concurrent-read directory):
 *   CC:   CCExclusive domain; excl->acquire(name) (lock-free probe + CAS)
 *   Go:   sync.Mutex per name via sync.Map (lock-free read path)
 *   Rust: std::sync::Mutex per name via RwLock<HashMap> (read lock + Arc)
 *   Zig:  std.Io.Mutex per name via pthread rwlock + HashMap
 *
 * Env (shared across languages):
 *   CC_EXCL_WORKERS  default 8
 *   CC_EXCL_ITERS    default 200000   // lock pairs per worker
 *   CC_EXCL_TRIALS   default 7        // timed trials after 1 warmup
 *   CC_EXCL_WORK     default 32       // Zipf CS spins only
 *   CC_EXCL_KEYS     default 64       // Zipf name space
 *   CC_EXCL_ZIPF_S   default 1.0      // Zipf exponent (weight ~ 1/(k+1)^s)
 */

#include <ccc/std/prelude.cch>
#include <ccc/cc_exclusive.cch>
#include <stdio.h>
#include <stdlib.h>
#include <stdint.h>
#include <string.h>
#include <math.h>
#include <time.h>

#define DEFAULT_WORKERS 8
#define DEFAULT_ITERS   200000
#define DEFAULT_TRIALS  7
#define DEFAULT_WORK    32
#define DEFAULT_KEYS    64
#define DEFAULT_ZIPF_S  1.0
#define MAX_WORKERS     256
#define MAX_KEYS        4096
#define CACHE_LINE      64

typedef struct {
    int64_t value;
    char _pad[CACHE_LINE - sizeof(int64_t)];
} Row;

typedef struct {
    uint64_t state;
} Rng;

static Row g_rows[MAX_KEYS];
static CCExclusive* g_excl;
static double g_zipf_cum[MAX_KEYS];
static double g_zipf_s;

static double time_now_ms(void) {
    struct timespec ts;
    clock_gettime(CLOCK_MONOTONIC, &ts);
    return ts.tv_sec * 1000.0 + ts.tv_nsec / 1000000.0;
}

static int env_int(const char* name, int fallback, int min_v) {
    const char* v = getenv(name);
    if (!v || !v[0]) return fallback;
    int n = atoi(v);
    return n < min_v ? min_v : n;
}

static double env_double(const char* name, double fallback) {
    const char* v = getenv(name);
    if (!v || !v[0]) return fallback;
    char* end = NULL;
    double n = strtod(v, &end);
    if (end == v || n <= 0.0) return fallback;
    return n;
}

static void cs_work(int spins) {
    volatile int x = 0;
    for (int i = 0; i < spins; i++) x += i;
    (void)x;
}

static void row_bump(Row* row, int spins) {
    int64_t v = row->value;
    cs_work(spins);
    row->value = v + 1;
}

static uint64_t rng_next(Rng* r) {
    uint64_t x = r->state;
    x ^= x << 13;
    x ^= x >> 7;
    x ^= x << 17;
    r->state = x;
    return x;
}

static double rng_unit(Rng* r) {
    /* top 53 bits → [0, 1) */
    return (double)(rng_next(r) >> 11) * (1.0 / 9007199254740992.0);
}

static void zipf_init(double* cum, int keys, double s) {
    double total = 0.0;
    for (int k = 0; k < keys; k++) {
        double w = 1.0 / pow((double)(k + 1), s);
        total += w;
        cum[k] = total;
    }
    for (int k = 0; k < keys; k++) cum[k] /= total;
}

static int zipf_pick(const double* cum, int keys, Rng* r) {
    double u = rng_unit(r);
    int lo = 0;
    int hi = keys - 1;
    while (lo < hi) {
        int mid = (lo + hi) / 2;
        if (cum[mid] < u) lo = mid + 1;
        else hi = mid;
    }
    return lo;
}

static Rng rng_for_worker(int worker_id) {
    Rng r;
    r.state = 0x9E3779B97F4A7C15ULL ^ ((uint64_t)worker_id * 0xD1B54A32D192ED03ULL);
    if (r.state == 0) r.state = 1;
    return r;
}

static void worker_zipf(int worker_id, int iters, int spins, int keys) {
    Rng rng = rng_for_worker(worker_id);
    for (int i = 0; i < iters; i++) {
        int k = zipf_pick(g_zipf_cum, keys, &rng);
        CCExclusiveGuard g = g_excl->acquire((uint64_t)k);
        row_bump(&g_rows[k], spins);
        g.release();
    }
}

static double run_zipf(int workers, int iters, int spins, int keys) {
    memset(g_rows, 0, sizeof(g_rows));

    double t0 = time_now_ms();
    {
        CCNursery* n = cc_nursery_create(NULL)
            !>(e) { fprintf(stderr, "nursery: %s\n", e.message); abort(); }
            @destroy;
        for (int w = 0; w < workers; w++) {
            int id = w;
            n->spawn(() => [id, iters, spins, keys] {
                worker_zipf(id, iters, spins, keys);
            });
        }
    }
    double t1 = time_now_ms();

    int64_t sum = 0;
    for (int k = 0; k < keys; k++) sum += g_rows[k].value;
    int64_t expect = (int64_t)workers * (int64_t)iters;
    if (sum != expect) {
        fprintf(stderr, "ZIPF CHECK FAIL: got=%lld expect=%lld\n",
                (long long)sum, (long long)expect);
        abort();
    }
    return t1 - t0;
}

static double run_serial_fastpath(int64_t iters) {
    g_rows[0].value = 0;
    CCExclusiveMutex m = g_excl->mutex(1000);
    double t0 = time_now_ms();
    for (int64_t i = 0; i < iters; i++) {
        CCExclusiveGuard g = m.acquire();
        row_bump(&g_rows[0], 0);
        g.release();
    }
    double t1 = time_now_ms();

    if (g_rows[0].value != iters) {
        fprintf(stderr, "FASTPATH CHECK FAIL: got=%lld expect=%lld\n",
                (long long)g_rows[0].value, (long long)iters);
        abort();
    }
    return t1 - t0;
}

static double median_ms(double* samples, int n) {
    for (int i = 1; i < n; i++) {
        double key = samples[i];
        int j = i - 1;
        while (j >= 0 && samples[j] > key) {
            samples[j + 1] = samples[j];
            j--;
        }
        samples[j + 1] = key;
    }
    return samples[n / 2];
}

int main(void) {
    int workers = env_int("CC_EXCL_WORKERS", DEFAULT_WORKERS, 1);
    int iters = env_int("CC_EXCL_ITERS", DEFAULT_ITERS, 1);
    int trials = env_int("CC_EXCL_TRIALS", DEFAULT_TRIALS, 1);
    int spins = env_int("CC_EXCL_WORK", DEFAULT_WORK, 0);
    int keys = env_int("CC_EXCL_KEYS", DEFAULT_KEYS, 1);
    g_zipf_s = env_double("CC_EXCL_ZIPF_S", DEFAULT_ZIPF_S);
    if (workers > MAX_WORKERS) workers = MAX_WORKERS;
    if (keys > MAX_KEYS) keys = MAX_KEYS;
    if (trials > 64) trials = 64;
    zipf_init(g_zipf_cum, keys, g_zipf_s);

    CCArena excl_arena = @create(kilobytes(128)) @destroy;
    g_excl = cc_exclusive_create(&excl_arena);
    if (!g_excl) {
        fprintf(stderr, "cc_exclusive_create failed\n");
        return 1;
    }
    @defer cc_exclusive_destroy(g_excl);

    printf("exclusive_named_lock lang=cc\n");
    printf("  workers=%d iters/worker=%d timed_trials=%d warmup=1 "
           "cs_spins=%d keys=%d zipf_s=%.3f\n",
           workers, iters, trials, spins, keys, g_zipf_s);
    printf("  total_lock_ops/trial=%lld\n",
           (long long)workers * (long long)iters);
    printf("  note=zipf locks BY NAME each iter (directory+lock+scheduler "
           "product, spawn+join, no start-gun); serial_fastpath is one "
           "resolved mutex, one caller, spins=0, no scheduler\n");

    int warm = iters > 1000 ? 1000 : iters;
    (void)run_zipf(workers, warm, spins, keys);
    (void)run_serial_fastpath((int64_t)workers * (int64_t)warm);

    double z_samples[64];
    double f_samples[64];
    int64_t total_ops = (int64_t)workers * (int64_t)iters;
    for (int t = 0; t < trials; t++) {
        z_samples[t] = run_zipf(workers, iters, spins, keys);
        f_samples[t] = run_serial_fastpath(total_ops);
        printf("  trial %d: zipf_ms=%.3f serial_fastpath_ms=%.3f\n",
               t + 1, z_samples[t], f_samples[t]);
    }

    double z_med = median_ms(z_samples, trials);
    double f_med = median_ms(f_samples, trials);
    double ops = (double)total_ops;
    double z_ops = (z_med > 0) ? (ops / (z_med / 1000.0)) : 0;
    double f_ops = (f_med > 0) ? (ops / (f_med / 1000.0)) : 0;

    printf("RESULT lang=cc zipf_median_ms=%.3f zipf_ops_s=%.0f "
           "serial_fastpath_median_ms=%.3f serial_fastpath_ops_s=%.0f\n",
           z_med, z_ops, f_med, f_ops);

    g_excl->destroy();
    g_excl = NULL;
    return 0;
}

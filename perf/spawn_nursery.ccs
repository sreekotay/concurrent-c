/*
 * Spawn nursery throughput benchmark.
 * Measures: nursery-based spawn creation and completion throughput.
 */
#include <ccc/std/prelude.cch>
#include <ccc/stdio.cch>
#include <time.h>

#define ITERATIONS 100000

static double time_now_ms(void) {
    struct timespec ts;
    clock_gettime(CLOCK_MONOTONIC, &ts);
    return ts.tv_sec * 1000.0 + ts.tv_nsec / 1000000.0;
}

int main(void) {
    @errhandler(CCError e) cc_error_exit(e);
    println("spawn_nursery: measuring nursery spawn throughput");

    double start = time_now_ms();

    cc_atomic_int counter = 0;
    cc_atomic_int* counter_ptr = &counter;

    for (int batch = 0; batch < ITERATIONS / 1000; batch++) {
        {
            CCNursery __cc_nursery173 = @create() !> @destroy;

            for (int i = 0; i < 1000; i++) {
                __cc_nursery173.spawn(() => [counter_ptr] {
                    cc_atomic_fetch_add(counter_ptr, 1);
                }) !>;
            }
        
        }
    }

    double elapsed = time_now_ms() - start;
    int total_spawns = cc_atomic_load(counter_ptr);
    double spawns_per_sec = total_spawns / (elapsed / 1000.0);

    println(@string(` nursery spawns: ${spawns_per_sec} spawns/sec (${elapsed} ms, total=${total_spawns})`, @scratch));

    {
        cc_atomic_int par_counter = 0;
        cc_atomic_int* par_ptr = &par_counter;
        int i;
        start = time_now_ms();
        @parallel for (i in 0..ITERATIONS) {
            cc_atomic_fetch_add(par_ptr, 1);
        } !>.wait()!>;
        elapsed = time_now_ms() - start;
        int par_total = cc_atomic_load(par_ptr);
        double par_per_sec = par_total / (elapsed / 1000.0);
        if (par_total != ITERATIONS) {
            eprintln(@string(` par for: expected ${ITERATIONS} got ${par_total}`, @scratch));
            return 1;
        }
        println(@string(` par for: ${par_per_sec} spawns/sec (${elapsed} ms, total=${par_total})`, @scratch));
    }

    println("spawn_nursery: DONE");
    return 0;
}
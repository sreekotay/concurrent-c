/*
 * cc_chan_match_select (multi-channel select) performance benchmark.
 * (`@match` was removed from the language; this spells the runtime
 * select call directly, exactly what the old construct lowered to.)
 * Measures: select latency with different channel counts.
 * 
 * This test validates our signal-based implementation doesn't regress.
 */
#include <ccc/std/prelude.cch>
#include <ccc/stdio.cch>
#include <time.h>

#define ITERATIONS 1000

static double time_now_ms(void) {
    struct timespec ts;
    clock_gettime(CLOCK_MONOTONIC, &ts);
    return ts.tv_sec * 1000.0 + ts.tv_nsec / 1000000.0;
}

/* Single channel recv (baseline) */
static void bench_single_channel(void) {
    @errhandler(CCError e) cc_error_exit(e);
    int[~100 >] tx;
    int[~100 <] rx;
    cc_channel_pair(&tx, &rx);
    
    /* Pre-fill some values */
    for (int i = 0; i < 50; i++) {
        tx.send(i);
    }
    
    double start = time_now_ms();
    
    int sum = 0;
    for (int i = 0; i < ITERATIONS; i++) {
        tx.send(i);  /* Keep channel fed */
        int v;
        rx.recv(&v);
        sum += v;
    }
    
    double elapsed = time_now_ms() - start;
    double ops_per_sec = ITERATIONS / (elapsed / 1000.0);
    
    println(@string(` single channel recv: ${ops_per_sec} ops/sec (${elapsed} ms)`, @scratch));
    
    tx.close();
}

/* Two-channel select - one always ready */
static void bench_two_channel_one_ready(void) {
    @errhandler(CCError e) cc_error_exit(e);
    int[~100 >] tx1, tx2;
    int[~100 <] rx1, rx2;
    cc_channel_pair(&tx1, &rx1);
    cc_channel_pair(&tx2, &rx2);
    
    double start = time_now_ms();
    
    int sum = 0;
    int v1 = 0, v2 = 0;
    for (int i = 0; i < ITERATIONS; i++) {
        tx1.send(i);  /* Only ch1 has data */
        
        do { /* select: recv/recv */
            size_t __cc_match_idx = (size_t)-1;
            int __cc_match_rc = 0;
            CCChanMatchCase __cc_match_cases[2];
            __cc_match_cases[0] = (CCChanMatchCase){ .ch = (rx1).raw, .send_buf = NULL, .recv_buf = (void*)(&v1), .elem_size = sizeof(*(&v1)), .is_send = false };
            __cc_match_cases[1] = (CCChanMatchCase){ .ch = (rx2).raw, .send_buf = NULL, .recv_buf = (void*)(&v2), .elem_size = sizeof(*(&v2)), .is_send = false };
            __cc_match_rc = cc_chan_match_select(__cc_match_cases, 2, &__cc_match_idx, cc_current_deadline());
            switch (__cc_match_idx) {
                case 0: { sum += v1; }
                    break;
                case 1: { sum += v2; }
                    break;
                default: break;
            }
            (void)__cc_match_rc;
        } while(0);
    }
    
    double elapsed = time_now_ms() - start;
    double ops_per_sec = ITERATIONS / (elapsed / 1000.0);
    
    println(@string(` 2-channel select (1 ready): ${ops_per_sec} ops/sec (${elapsed} ms)`, @scratch));
    
    tx1.close();
    tx2.close();
}

/* Two-channel select - alternating */
static void bench_two_channel_alternating(void) {
    @errhandler(CCError e) cc_error_exit(e);
    int[~100 >] tx1, tx2;
    int[~100 <] rx1, rx2;
    cc_channel_pair(&tx1, &rx1);
    cc_channel_pair(&tx2, &rx2);
    
    double start = time_now_ms();
    
    int sum = 0;
    int v1 = 0, v2 = 0;
    for (int i = 0; i < ITERATIONS; i++) {
        if (i % 2 == 0) {
            tx1.send(i);
        } else {
            tx2.send(i);
        }
        
        do { /* select: recv/recv */
            size_t __cc_match_idx = (size_t)-1;
            int __cc_match_rc = 0;
            CCChanMatchCase __cc_match_cases[2];
            __cc_match_cases[0] = (CCChanMatchCase){ .ch = (rx1).raw, .send_buf = NULL, .recv_buf = (void*)(&v1), .elem_size = sizeof(*(&v1)), .is_send = false };
            __cc_match_cases[1] = (CCChanMatchCase){ .ch = (rx2).raw, .send_buf = NULL, .recv_buf = (void*)(&v2), .elem_size = sizeof(*(&v2)), .is_send = false };
            __cc_match_rc = cc_chan_match_select(__cc_match_cases, 2, &__cc_match_idx, cc_current_deadline());
            switch (__cc_match_idx) {
                case 0: { sum += v1; }
                    break;
                case 1: { sum += v2; }
                    break;
                default: break;
            }
            (void)__cc_match_rc;
        } while(0);
    }
    
    double elapsed = time_now_ms() - start;
    double ops_per_sec = ITERATIONS / (elapsed / 1000.0);
    
    println(@string(` 2-channel select (alternating): ${ops_per_sec} ops/sec (${elapsed} ms)`, @scratch));
    
    tx1.close();
    tx2.close();
}

/* Four-channel select */
static void bench_four_channel(void) {
    @errhandler(CCError e) cc_error_exit(e);
    int[~100 >] tx1, tx2, tx3, tx4;
    int[~100 <] rx1, rx2, rx3, rx4;
    cc_channel_pair(&tx1, &rx1);
    cc_channel_pair(&tx2, &rx2);
    cc_channel_pair(&tx3, &rx3);
    cc_channel_pair(&tx4, &rx4);
    
    double start = time_now_ms();
    
    int sum = 0;
    int v1 = 0, v2 = 0, v3 = 0, v4 = 0;
    for (int i = 0; i < ITERATIONS; i++) {
        /* Round-robin which channel gets data */
        switch (i % 4) {
            case 0: tx1.send(i); break;
            case 1: tx2.send(i); break;
            case 2: tx3.send(i); break;
            case 3: tx4.send(i); break;
        }
        
        do { /* select: 4x recv */
            size_t __cc_match_idx = (size_t)-1;
            int __cc_match_rc = 0;
            CCChanMatchCase __cc_match_cases[4];
            __cc_match_cases[0] = (CCChanMatchCase){ .ch = (rx1).raw, .send_buf = NULL, .recv_buf = (void*)(&v1), .elem_size = sizeof(*(&v1)), .is_send = false };
            __cc_match_cases[1] = (CCChanMatchCase){ .ch = (rx2).raw, .send_buf = NULL, .recv_buf = (void*)(&v2), .elem_size = sizeof(*(&v2)), .is_send = false };
            __cc_match_cases[2] = (CCChanMatchCase){ .ch = (rx3).raw, .send_buf = NULL, .recv_buf = (void*)(&v3), .elem_size = sizeof(*(&v3)), .is_send = false };
            __cc_match_cases[3] = (CCChanMatchCase){ .ch = (rx4).raw, .send_buf = NULL, .recv_buf = (void*)(&v4), .elem_size = sizeof(*(&v4)), .is_send = false };
            __cc_match_rc = cc_chan_match_select(__cc_match_cases, 4, &__cc_match_idx, cc_current_deadline());
            switch (__cc_match_idx) {
                case 0: sum += v1;
                    break;
                case 1: sum += v2;
                    break;
                case 2: sum += v3;
                    break;
                case 3: sum += v4;
                    break;
                default: break;
            }
            (void)__cc_match_rc;
        } while(0);
    }
    
    double elapsed = time_now_ms() - start;
    double ops_per_sec = ITERATIONS / (elapsed / 1000.0);
    
    println(@string(` 4-channel select (round-robin): ${ops_per_sec} ops/sec (${elapsed} ms)`, @scratch));
    
    tx1.close();
    tx2.close();
    tx3.close();
    tx4.close();
}

/* Note: Concurrent select test omitted - capture syntax for channel handles
   in closures is complex. The sequential tests above cover select performance. */

int main(void) {
    @errhandler(CCError e) { cc_error_log(e); return 1; }
    println("perf_match_select: measuring cc_chan_match_select performance");
    
    bench_single_channel();
    bench_two_channel_one_ready();
    bench_two_channel_alternating();
    bench_four_channel();
    
    println("perf_match_select: DONE");
    return 0;
}

/*
 * work_stealing_efficiency.ccs - Load Balancing Torture Test
 */

#include <ccc/cc_runtime.cch>
#include <ccc/cc_atomic.cch>
#include <ccc/stdio.cch>
#include <stdlib.h>
#include <time.h>

#define NUM_TASKS 100000
#define WORK_LOAD 1000

static double time_now_ms(void) {
    struct timespec ts;
    clock_gettime(CLOCK_MONOTONIC, &ts);
    return ts.tv_sec * 1000.0 + ts.tv_nsec / 1000000.0;
}

cc_atomic_int g_completed = 0;

void do_work() {
    volatile int x = 0;
    for (int i = 0; i < WORK_LOAD; i++) x++;
    cc_atomic_fetch_add(&g_completed, 1);
}

void imbalanced_producer() {
    @errhandler(CCError e) cc_error_exit(e);
    // This function runs in a fiber on ONE worker.
    // We use a nursery here to spawn all sub-tasks.
    {
        CCNursery __cc_nursery179 = @create() !> @destroy;

        for (int i = 0; i < NUM_TASKS; i++) {
            __cc_nursery179.spawn(() => { do_work(); }) !>;
        }
    
    }
}

int main(void) {
    @errhandler(CCError e) cc_error_exit(e);
    setvbuf(stdout, NULL, _IONBF, 0);
    
    println("=================================================================");
    println(@string(`WORK STEALING EFFICIENCY: ${NUM_TASKS} tasks`, @scratch));
    println("=================================================================");

    // 1. Balanced Spawn: Distribute from main
    cc_atomic_store(&g_completed, 0);
    double start = time_now_ms();
    {
        CCNursery __cc_nursery180 = @create() !> @destroy;

        for (int i = 0; i < NUM_TASKS; i++) {
            __cc_nursery180.spawn(() => { do_work(); }) !>;
        }
    
    }
    double balanced_ms = time_now_ms() - start;
    println(@string(`Balanced Spawn (from main): ${balanced_ms} ms`, @scratch));

    // 2. Imbalanced Spawn: All tasks spawned from inside ONE fiber
    cc_atomic_store(&g_completed, 0);
    start = time_now_ms();
    {
        CCNursery __cc_nursery181 = @create() !> @destroy;

        __cc_nursery181.spawn(() => { imbalanced_producer(); }) !>;
    
    }
    double imbalanced_ms = time_now_ms() - start;
    println(@string(`Imbalanced Spawn (from fiber): ${imbalanced_ms} ms`, @scratch));

    double overhead = (imbalanced_ms - balanced_ms) / balanced_ms * 100.0;
    println(@string(`\nWork Stealing Overhead: ${overhead}%`, @scratch));
    
    if (overhead < 50.0) {
        println("RESULT: SUCCESS - Your work stealer is a beast!");
    } else {
        println("RESULT: FAIL - Significant overhead when work is localized.");
    }
    println("=================================================================");

    return 0;
}

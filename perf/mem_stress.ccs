#include <ccc/std/prelude.cch>
#include <ccc/stdio.cch>
#include <sys/resource.h>
#include <stdatomic.h>

static _Atomic int g_completed = 0;

int main() {
    @errhandler(CCError e) cc_error_exit(e);
    const int count = 5000;
    println(@string(`START. Spawning ${count} fibers...`, @scratch)) !>;
    fflush(stdout);
    
    {
        CCNursery __cc_nursery161 = @create() !> @destroy;

        for (int i = 0; i < count; i++) {
            __cc_nursery161.spawn(() => {
                cc_sleep_ms(1000);
                atomic_fetch_add(&g_completed, 1);
            }) !>;
            if ((i + 1) % 1000 == 0) {
                println(@string(` ${i + 1} / ${count} spawned...`, @scratch)) !>;
                fflush(stdout);
            }
        }
        
        println(@string(`All ${count} fibers spawned. Waiting for completion...`, @scratch)) !>;
        fflush(stdout);
    
    }
    
    struct rusage ru;
    getrusage(RUSAGE_SELF, &ru);
    println(@string(`Done: ${atomic_load(&g_completed)}/${count} completed. Peak RSS: ${ru.ru_maxrss / 1024} KB (${ru.ru_maxrss / 1024.0 / 1024.0} MB)`, @scratch)) !>;
    return 0;
}

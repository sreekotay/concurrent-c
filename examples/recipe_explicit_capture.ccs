/*
 * Recipe: Capture
 *
 * `@parallel` names are the frame. A pointer copies; every other name
 * is the same object. There is no capture list.
 *
 * Closure lists are for `n.spawn` / `send_task` (the bag, or work on
 * a channel). Write a list when implicit is the wrong mode:
 *
 *   [&x]     — share the frame object
 *   [x]      — copy at admit; write it when the name will be rebound
 *              (C for-loop index, accept sock)
 *   [x, &y]  — mix
 *
 * `@parallel for` gives each iteration its own index — no list
 * (this file's exclusive twin is recipe_exclusive_named.ccs).
 * Named lists on the remaining bag recipe:
 * recipe_channel_pipeline.ccs `[&sum, rx]`.
 * send_task copy-at-submit: recipe_ordered_parallel.ccs `[id]`.
 */
#include <ccc/cc_runtime.cch>
#include <ccc/std/prelude.cch>
#include <ccc/stdio.cch>

int main(void) {
    @errhandler(CCError e) { cc_error_log(e); return 1; }

    int snapshot = 42;
    println("=== names on the page ===");
    println(@string(`before: snapshot = ${snapshot}`, @scratch));
    @parallel spawn {
        @serial {
            @errhandler(CCError e) cc_error_exit(e);
            int seen = snapshot;
            println(@string(`  task A sees snapshot = ${seen}`, @scratch));
        }
        @serial {
            @errhandler(CCError e) cc_error_exit(e);
            int seen = snapshot;
            println(@string(`  task B sees snapshot = ${seen}`, @scratch));
        }
    } !>.wait()!>;
    println(@string(`after:  snapshot = ${snapshot} (unchanged)`, @scratch));
    println("");

    int counter = 100;
    println("=== same object ===");
    println(@string(`before: counter = ${counter}`, @scratch));
    @parallel spawn {
        @serial {
            @errhandler(CCError e) cc_error_exit(e);
            println(@string(`  task C reads counter = ${counter}`, @scratch));
        }
        @serial {
            @errhandler(CCError e) cc_error_exit(e);
            println(@string(`  task D reads counter = ${counter}`, @scratch));
        }
    } !>.wait()!>;
    println(@string(`after:  counter = ${counter}`, @scratch));
    println("");

    /* --- when you need mutation ---
     *   CCAtomic::[int] counter        — lock-free atomic ops
     *   CCMutex::[int]  counter        — lock-based guard
     *   () => @unsafe [&counter] ...   — opt-out; the race is on you
     *   channels                       — pass values, don't share state
     *
     * See recipe_parallel.ccs and recipe_channel_pipeline.ccs.
     */
    return 0;
}

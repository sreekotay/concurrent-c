/*
 * Recipe: walk and buffers
 *
 * The bound is the live extent. Walk it. Point access is `at` / `set`
 * (Result). Bytes go through dest-bulk (`dst.copy` / `dst.copy_overlap` /
 * `dst.fill`) and arena clone. A text slice interpolates in `${…}`.
 * `.ptr` is legal C; it is not required to print or walk.
 *
 * Default includes do not declare `memcpy` / `malloc`. Include
 * `<string.h>` / `<stdlib.h>` to use them (tests/mem_memcpy_fail,
 * tests/mem_malloc_fail).
 *
 *    1. Arena buffer
 *    2. Point access — at / set
 *    3. fill / copy / copy_overlap
 *    4. clone_into — keep on another arena
 *    5. walk / enumerate / zip / range
 *    6. mut walk
 *    7. view (`sub`) — hoisted header; mut writes the receiver
 *    8. vec: live walk vs dest-init view
 *    9. peel — `.ptr` when a T* must leave
 */
#include <ccc/std/prelude.cch>
#include <ccc/stdio.cch>

int main(void) {
    @errhandler(CCError e) { cc_error_log(e); return 1; }

    CCArena a = cc_arena_heap(kilobytes(4)) @destroy;
    CCArena keep = cc_arena_heap(kilobytes(1)) @destroy;

    /* 1. Arena names the lifetime. Dest-bulk needs a window.
     *    malloc(8);  — undeclared unless <stdlib.h> */
    char[:] buf = a.alloc_slice_bytes(8);
    if (buf.len != 8) return 2;

    /* 2. Point access — at/set are Result (index may be out of range). */
    buf.set(0, 'A') !>;
    char c0 = buf.at(0) !>;
    println(@string(`point=${c0}`, @scratch)) !>;

    /* 3. fill / copy / copy_overlap — dest too short is Result.
     *    memcpy(buf.ptr, hi.ptr, 2);  — undeclared unless <string.h>
     *    dst.copy_overlap is overlap-safe copy (source stays live).
     *    Ownership transfer is cc_move / return / send_take. */
    buf.fill('x') !>;
    char[:] hi = {'H', 'i'};
    buf.copy(hi) !>;
    char[:] mid = buf.sub(2, 4);
    mid.copy_overlap(hi) !>;

    /* Same print: peel vs interpolating a view. */
    println(@string(`bulk C  = ${buf.ptr[0]}${buf.ptr[1]}${buf.ptr[2]}${buf.ptr[3]}`, @scratch)) !>;
    println(@string(`bulk CC = ${buf.sub(0, 4)}`, @scratch)) !>;

    /* 4. clone_into — arena last; the copy lives on `keep`. */
    char[:] owned = hi.clone_into(keep) !>;
    println(@string(`kept=${owned}`, @scratch)) !>;

    /* 5. Copy walk / enumerate / zip / range. Zip is fallible (`!>`). */
    int n = 0;
    int sum = 0;
    int[:] xs = { 1, 2, 3 };
    int[:] ys = { 10, 20, 30 };
    for (c in hi)
        n++;
    for (i, v in xs)
        sum += (int)i + v;
    for (p, q in xs, ys) {
        sum += p * q;
    } !>;
    for (i in 0..3)
        sum += (int)i;
    println(@string(`walk n=${n} sum=${sum}`, @scratch)) !>;

    /* 6. Mut walk — binder is not an object; `ch =` is set into this !>. */
    char[:] word = {'c', 'c'};
    for (&ch in word) {
        if (ch >= 'a' && ch <= 'z')
            ch -= 32;
    } !>;
    println(@string(`mut=${word}`, @scratch)) !>;

    /* 7. View — compiler hoists `sub`; store is into the receiver. */
    for (&ch in word.sub(1, word.len)) {
        ch = 'c';
    } !>;
    println(@string(`view=${word}`, @scratch)) !>;

    /* 8. Vec is an extent. Dest-init T[:] is a snapshot header. */
    CCVec::[int] v = cc_vec_new::[int](a);
    if (v.push(4) != 0 || v.push(5) != 0) return 3;
    int[:] snap = v;
    int live = 0;
    for (x in v)
        live += x;
    println(@string(`vec live=${live} snap=${snap.len}`, @scratch)) !>;

    /* 9. Peel when a T* must leave. */
    const char *raw = word.ptr;
    (void)raw;

    println("done") !>;
    return 0;
}
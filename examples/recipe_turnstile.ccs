#!ccc ccs
/*
 * Recipe: Turnstile stages
 *
 * Two named tickets on one gate: read, then write, in `i` order.
 * Cap limits how many tickets compute at once. `@parallel wait`
 * owns enter/leave — no nursery.
 *
 *   @parallel wait (ts) for (i in 0..n) {
 *       @stage (ts.read, i)  { … }
 *       @stage (ts.write, i) { … }
 *   } !>.wait()!>;
 *
 * One shared write is `@stage (ts, 0, i)` — recipe_parallel.ccs.
 * Index form: CCTurnstile t@(cap, n_stages, arena); `@stage (t, k, i)`.
 */
#include <ccc/std/prelude.cch>
#include <ccc/stdio.cch>

#define N   8
#define CAP 2

int main(void) {
    @errhandler(CCError e) { cc_error_log(e); return 1; }

    CCArena arena = cc_arena_heap(kilobytes(64)) @destroy;
    CCTurnstileRW ts@(CAP, arena) !> @destroy;

    int read_next = 0;
    int write_next = 0;
    int fail = 0;
    int i;
    @parallel wait (ts) for (i in 0..N) {
        @stage (ts.read, i) {
            if (read_next != i)
                fail = 1;
            read_next = i + 1;
        }
        @stage (ts.write, i) {
            if (write_next != i)
                fail = 1;
            write_next = i + 1;
        }
    } !>.wait()!>;

    if (fail || read_next != N || write_next != N) {
        eprintln(@string(`FAIL read=${read_next} write=${write_next} fail=${fail}`, @scratch)) !>;
        return 1;
    }
    println("turnstile: 8 tickets, cap 2, read then write in order") !>;
    return 0;
}

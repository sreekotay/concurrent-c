#!ccc ccs
/*
 * Recipe: Pipeline turnstile
 *
 * Depth cap plus ordered stages. enter(i) takes a depth token; stage
 * wait/pass create a gate cell on first touch. Declare the turnstile
 * before the nursery so join finishes before the depth channel is freed.
 *
 *   CCTurnstileRW ts@(cap, arena) !> @destroy;
 *   ts.enter(i) !>;
 *   ts.read.wait(i) !>;  …  ts.read.pass(i) !>;
 *   ts.write.wait(i) !>; …  ts.write.pass(i) !>;
 *   ts.leave() !>;
 *
 * Index form: CCTurnstile t@(cap, n_stages, arena) !> @destroy; t.stage(k).wait(i).
 */
#include <ccc/std/prelude.cch>
#include <ccc/script/stdio.cch>
#include <stdio.h>

#define N   8
#define CAP 2

static int g_read_next;
static int g_write_next;
static int g_fail;

static void worker(CCTurnstileRW* ts, int i) {
    @errhandler(CCError e) cc_error_exit(e);
    ts->read.wait(i) !>;
    if (g_read_next != i)
        g_fail = 1;
    g_read_next = i + 1;
    ts->read.pass(i) !>;

    ts->write.wait(i) !>;
    if (g_write_next != i)
        g_fail = 1;
    g_write_next = i + 1;
    ts->write.pass(i) !>;

    ts->leave() !>;
}

int main(void) {
    @errhandler(CCError e) { cc_error_log(e); return 1; }

    CCArena arena = cc_arena_heap(kilobytes(64)) @destroy;
    CCTurnstileRW ts@(CAP, arena) !> @destroy;

    CCTurnstileRW* tsp = &ts;
    int i;
    {
        CCNursery nur = cc_nursery_create() !> @destroy;
        for (i = 0; i < N; i++) {
            ts.enter(i) !>;
            nur.spawn(() => [i, tsp] {
                @errhandler(CCError e) cc_error_exit(e);
                worker(tsp, i);
            }) !>;
        }
    }

    if (g_fail || g_read_next != N || g_write_next != N) {
        fprintf(stderr, "FAIL read=%d write=%d fail=%d\n",
                g_read_next, g_write_next, g_fail);
        return 1;
    }
    println("turnstile: 8 tickets, cap 2, read then write in order") !>;
    return 0;
}

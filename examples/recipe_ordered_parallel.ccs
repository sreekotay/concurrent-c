/*
 * Recipe: Ordered Parallel Processing
 *
 * Work completes out of order; output must come out in order.
 *
 *   producer: for each item → results_tx.send_task(() => work)
 *   consumer: recv on an ordered channel → each recv awaits the next
 *             submitted task → FIFO output without a reorder buffer
 *
 * Idiom: send_task + ordered recv (same shape as pigz_idiomatic).
 * send_task spawns immediately and queues a handle; ordered recv
 * delivers those handles in submission order and awaits each one.
 */
#include <ccc/std/prelude.cch>
#include <unistd.h>

#define NUM_ITEMS 8
#define CHAN_CAP  4

/* Simulate variable-time work: odd ids take longer. */
static int process_item(int id) {
    int delay_us = (id % 2 == 1) ? 50000 : 10000;
    usleep(delay_us);
    int result = id * id;
    printf("  [worker] completed item %d (delay=%dms)\n", id, delay_us / 1000);
    return result;
}

int main(void) {
    @errhandler(CCError e) { fprintf(stderr, "fatal: %s\n", e.message); return 1; }

    int[~CHAN_CAP >] results_tx;
    int[~CHAN_CAP ordered <] results_rx;
    CCChan* results_ch = cc_channel_pair(&results_tx, &results_rx) !> @destroy;

    printf("=== Ordered Parallel Processing ===\n");
    printf("Processing %d items with variable delays...\n\n", NUM_ITEMS);

    {
        CCNursery* consumer = cc_nursery_create(NULL) !> @destroy;

        consumer->spawn(() => [results_rx] {
            printf("\n[consumer] receiving results in order:\n");
            int result = 0;
            int expect = 1;
            while (cc_io_avail(results_rx.recv(&result))) {
                int want = expect * expect;
                printf("[consumer] item %d: %d^2 = %d\n", expect, expect, result);
                if (result != want) {
                    fprintf(stderr, "ORDER/VALUE: expected %d got %d\n", want, result);
                    break;
                }
                expect++;
            }
            if (expect != NUM_ITEMS + 1) {
                fprintf(stderr, "missing results: got %d of %d\n",
                        expect - 1, NUM_ITEMS);
            }
        });

        /* Producer in an inner nursery: @destroy closes results_tx once the
         * producer returns, so the consumer sees EOF after draining. */
        {
            CCNursery* producer = cc_nursery_create(consumer) !> @destroy;
            (void)producer->close_on(results_tx);

            producer->spawn(() => [results_tx] {
                for (int i = 1; i <= NUM_ITEMS; i++) {
                    int id = i;
                    results_tx.send_task(() => [id] {
                        return process_item(id);
                    });
                    printf("[producer] submitted task for item %d\n", i);
                }
            });
        }
    }

    printf("\nDone! Results printed in order despite out-of-order completion.\n");
    return 0;
}

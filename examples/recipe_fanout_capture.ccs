/*
 * Recipe: Independent fan-out
 *
 * Independent iterations are `@parallel @for`. The index is the
 * per-iteration value; writes go to disjoint slots. `n.spawn` in a C
 * for-loop still needs a per-task copy of the loop variable — see
 * recipe_explicit_capture.ccs.
 */

#include <ccc/std/prelude.cch>
#include <ccc/stdio.cch>

#define NUM_TASKS 5

static int results[NUM_TASKS];

static int compute(int x) {
    return x * x;
}

int main(void) {
    @errhandler(CCError e) { cc_error_log(e); return 1; }

    println(@string(`=== Fan-out: ${NUM_TASKS} independent iterations ===`, @scratch)) !>;

    int k;
    @parallel @for (k in 0..NUM_TASKS) {
        results[k] = compute(k);
    } !>.wait()!>;

    println("\n=== Results ===") !>;
    int sum = 0;
    int i;
    for (i = 0; i < NUM_TASKS; i++) {
        println(@string(`  results[${i}] = ${results[i]}`, @scratch)) !>;
        sum += results[i];
    }
    println(@string(`sum = ${sum} (expected 30)`, @scratch)) !>;

    return (sum == 30) ? 0 : 1;
}

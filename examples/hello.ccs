/*
 * Hello, Concurrent-C!
 *
 * Three tasks run concurrently. Bind a terminate policy with
 * @errhandler, then use bare !>; at each fallible call — re-bind
 * inside each task (task bodies cannot share main's frame).
 *
 * Task C shows compose-then-default: !>(e) { local; @err(e); }.
 * Report via cc_error_exit / cc_error_log, not eprintln !>; inside
 * the same-E handler.
 *
 * Next: recipe_result_error_handling.ccs.
 */
#include <ccc/cc_runtime.cch>
#include <ccc/script/stdio.cch>
#include <unistd.h>

int main(void) {
    @errhandler(CCError e) cc_error_exit(e);

    CCNursery* n = cc_nursery_create(NULL) !> @destroy {
        println("All tasks completed.") !>;
    };

    n->spawn(() => {
        @errhandler(CCError e) cc_error_exit(e);
        usleep(100000);
        println("Hello from task A! (last)") !>;
    });
    n->spawn(() => {
        @errhandler(CCError e) cc_error_exit(e);
        println("Hello from task B!") !>;
    });
    n->spawn(() => {
        @errhandler(CCError e) cc_error_exit(e);
        println("Hello from task C!") !>(e) {
            println("Task C failed!") !>;
            @err(e); //forward to installed error handler
        }; //local handling first, then default
    });

    return 0;   // ← nursery teardown happens here
}

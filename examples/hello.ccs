#!ccc ccs
/*
 * Hello, Concurrent-C!
 *
 * Three named siblings. Bind a terminate policy with @errhandler,
 * then use bare !>; at each fallible call — re-bind inside each arm
 * (spawned arms cannot share main's frame).
 *
 * Prefer io.println when a CCStdio handle is in scope. Diagnostic print is
 * optional (`T?>(CCPrintError)`): bare println is fine. Task C shows
 * compose-then-default: !>(e) { local; @err(e); }. Use !> on load-bearing
 * I/O; report handler failures via cc_error_exit / cc_error_log.
 *
 * Next: recipe_result_error_handling.ccs.
 */
#include <ccc/cc_runtime.cch>
#include <ccc/std/prelude.cch>
#include <ccc/stdio.cch>
#include <unistd.h>

int main(void) {
    @errhandler(CCError e) cc_error_exit(e);

    cc_arena_stack(a, kilobytes(4));
    CCStdio io = cc_stdio_create(a);

    @parallel spawn {
        @serial {
            @errhandler(CCError e) cc_error_exit(e);
            usleep(100000);
            io.println("Hello from task A! (last)");
        }
        @serial {
            @errhandler(CCError e) cc_error_exit(e);
            io.println("Hello from task B!");
        }
        @serial {
            @errhandler(CCError e) cc_error_exit(e);
            io.println("Hello from task C!") !>(e) {
                io.println("Task C failed!");
                @err(e); //forward to installed error handler
            }; //local handling first, then default
        }
    } !>.wait()!>;

    io.println("All tasks completed.");
    return 0;
}

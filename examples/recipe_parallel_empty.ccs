/*
 * Recipe: EMPTY-close pipeline (dest)
 *
 * Default stream (close on the produce arm, same dest) is
 * recipe_parallel_stream.ccs. This file is dest-live / leave: the
 * consumer is already in recv; close runs when the *producer dest*
 * hits EMPTY, not on a line next to send.
 *
 *   prod { send }                   close(tx) — arms EMPTY to close tx
 *   cons { recv }                   already parked; sees close → drains
 *
 * EMPTY closes this dest's join set. A sibling consumer on the same dest
 * does not see that close — that is the produce arm (`tx.close()`) or
 * this inner dest. Waiting a dest that still owns the parked consumer
 * does not fire the close. Nursery twin: recipe_channel_pipeline.ccs.
 */
#include <ccc/std/prelude.cch>
#include <ccc/stdio.cch>

int main(void) {
    @errhandler(CCError e) { cc_error_log(e); return 1; }

    int[~4 >] tx;
    int[~4 <] rx;
    CCChan* ch = cc_channel_pair(&tx, &rx) !> @destroy;

    cc_atomic_int sum = 0;

    CCParallel cons = @parallel spawn {
        @serial {
            int v;
            while (cc_io_avail(rx.recv(&v))) {
                println(@string(`recv: ${v}`, @scratch));
                sum.fetch_add(v);
            }
        }
    } !>;

    {
        CCParallel prod = @parallel spawn {
            @serial {
                int i;
                for (i = 1; i <= 3; i++) {
                    tx.send(i) !>;
                    println(@string(`send: ${i}`, @scratch));
                }
            }
        } !> @destroy;
        prod.close(tx) !>;
    }
    /* prod @destroy: wait producer → EMPTY closes tx */

    cons.wait() !>;

    int total = sum.load();
    println(@string(`sum = ${total} (expected 6)`, @scratch));
    return (total == 6) ? 0 : 1;
}

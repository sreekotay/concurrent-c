/*
 * Recipe: EMPTY-close pipeline (nursery bag)
 *
 * Default stream (close on the produce arm, no bag) is
 * recipe_parallel_stream.ccs. Dest twin: recipe_parallel_empty.ccs.
 * This file is dest-live / leave: the consumer is already in recv;
 * close runs when the *inner* bag hits EMPTY, not on a line next to
 * send.
 *
 *   inner { producer }              close(tx) — arms EMPTY to close tx
 *   outer { consumer, inner }       consumer sees close → drains → exits
 *
 * Nested nurseries encode the close protocol without `tx.close()` in
 * the produce body: inner.close(tx) registers the close; inner's
 * @destroy waits for the producer, then EMPTY closes tx; outer's
 * @destroy waits for the consumer after it drains.
 *
 * The consumer captures &sum by reference and uses an atomic — only one
 * fiber writes so a plain int would suffice here, but atomic is the
 * right default for anything a second fiber might ever touch.
 */
#include <ccc/std/prelude.cch>
#include <ccc/stdio.cch>

int main(void) {
    @errhandler(CCError e) { cc_error_log(e); return 1; }

    int[~4 >] tx;
    int[~4 <] rx;
    CCChan* ch = cc_channel_pair(&tx, &rx) !> @destroy;

    cc_atomic_int sum = 0;

    {
        CCNursery outer = cc_nursery_create() !> @destroy;

        outer.spawn(() => [&sum, rx] {
            @errhandler(CCError e) cc_error_exit(e);
            int v;
            while (cc_io_avail(rx.recv(&v))) {
                println(@string(`recv: ${v}`, @scratch));
                sum.fetch_add(v);
            }
        }) !>;

        { // inner nursery - parented by outer nursery
            CCNursery inner = outer.create_child() !> @destroy;
            inner.close(tx) !>;

            inner.spawn(() => [tx] {
                @errhandler(CCError e) cc_error_exit(e);
                for (int i = 1; i <= 3; i++) {
                    tx.send(i) !>;
                    println(@string(`send: ${i}`, @scratch));
                }
            }) !>;
        }
        /* inner @destroy: wait producer → close tx */
    }
    /* outer @destroy: wait consumer (saw close, drained, exited) */

    int total = sum.load();
    println(@string(`sum = ${total} (expected 6)`, @scratch));
    return (total == 6) ? 0 : 1;
}

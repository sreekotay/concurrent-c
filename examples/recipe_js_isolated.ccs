/*
 * Recipe: isolated JS domains — N nodes from one CC program
 *
 *     ccc run examples/recipe_js_isolated.ccs      # needs node on PATH
 *
 * The third JS tier, behind an explicit boundary because the crossing
 * profile is different: hosted libnode (recipe_js_host.ccs) is
 * in-process and once-per-process; an ISOLATED domain is a spawned
 * `node` child on a line-JSON wire — wire latency per hop, but as many
 * domains as you like, each with its own heap, its own event loop, and
 * crash isolation.  Same broker, same rules as the Python package
 * `concurrent-c-node`.
 *
 * Which node runs is ambient-first: cc_js_new_exe(true, exe, a) > CC_NODE_BIN
 * > `node` on PATH; which packages it sees is the working directory's
 * node_modules — `npm install` next to your program is the whole setup.
 */
#include <ccc/std/prelude.cch>
#include <ccc/script/js.cch>
#include <ccc/stdio.cch>
#include <time.h>

static double now_ms(void) {
    struct timespec ts;
    clock_gettime(CLOCK_MONOTONIC, &ts);
    return (double)ts.tv_sec * 1e3 + (double)ts.tv_nsec / 1e6;
}

int main(void) {
    @errhandler(CCError e) {
        cc_error_log(e);
        return 1;
    }

    CCArena a = cc_arena_heap(megabytes(1)) @destroy;

    if (!cc_js_dom_available(true)) {
        puts("SKIP (no node on PATH)");
        return 0;
    }

    /* Two domains are two nodes: separate heaps, separate state. */
    CCJsDom A = cc_js_new(true, a) !> @destroy;
    CCJsDom B = cc_js_new(true, a) !> @destroy;
    A.exec("globalThis.who = 'A'") !>;
    B.exec("globalThis.who = 'B'") !>;
    char[:] wa = A.eval("who")!>.as_slice(a) !>;
    char[:] wb = B.eval("who")!>.as_slice(a) !>;
    println(@string(`domain A says ${wa}, domain B says ${wb}`, @scratch));

    /* Real modules through the sink: get+call over the wire. */
    CCJsDomVal os = A.require("os") !> @destroy;
    char[:] plat = os.platform()!>.as_slice(a) !>;
    long long cpus = os.availableParallelism() !>;
    println(@string(`os.platform() = ${plat}, ${cpus} cpus`, @scratch));

    /* The crossing profile, measured — this is why the tier is a
     * separate, explicit door. */
    {
        enum { N = 2000 };
        double t0 = now_ms();
        for (int i = 0; i < N; i++) (void)A.eval_i64("1");
        double per = (now_ms() - t0) * 1000.0 / N;
        println(@string(`wire round-trip: ${per} us/hop (in-process hosted tier: sub-us)`, @scratch));
    }

    return 0;
}

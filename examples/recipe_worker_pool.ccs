/*
 * Recipe: Worker Pool (dest)
 *
 *   jobs_ch: feeder → N workers (bounded queue)
 *   done_ch: workers → main (completion ledger, no shared counter)
 *
 * N is on the page. Dest-attach the workers, then feed/close on the same
 * arm (pass the end into `feed`; dest-bound `jobs_tx.send` is UFCS
 * on a copy). `.wait()` joins. Meeting: `@parallel spawn`.
 *
 * Host grow / retract / AGAIN / leave: thrdqueue.ccs (still a bag).
 * Nursery EMPTY-close twin: recipe_channel_pipeline.ccs.
 */
#include <ccc/std/prelude.cch>
#include <ccc/stdio.cch>

#define NUM_WORKERS 3
#define NUM_JOBS    9

static void worker(int[~ <] jobs_rx, int[~ >] done_tx) {
    @errhandler(CCError e) cc_error_exit(e);
    int job;
    while (cc_io_avail(jobs_rx.recv(&job))) {
        println(@string(`worker: processed job ${job}`, @scratch));
        done_tx.send(job) !>;
    }
}

static void feed(int[~4 >] tx, int n) {
    @errhandler(CCError e) cc_error_exit(e);
    int j;
    @for (j in 1..(n + 1)) {
        int v = (int)j;
        tx.send(v) !>;
    }
    tx.close();
    println(@string(`feeder: sent ${n} jobs`, @scratch));
}

int main(void) {
    @errhandler(CCError err) { cc_error_log(err); return 1; }

    int[~4 >]        jobs_tx;
    int[~4 <]        jobs_rx;
    int[~NUM_JOBS >] done_tx;   /* capacity >= NUM_JOBS to avoid deadlock */
    int[~NUM_JOBS <] done_rx;

    CCChan* jobs_ch = cc_channel_pair(&jobs_tx, &jobs_rx) !> @destroy;
    CCChan* done_ch = cc_channel_pair(&done_tx, &done_rx) !> @destroy;

    CCParallel h = @parallel spawn {
        @serial {
            int w;
            @for (w in 0..NUM_WORKERS) {
                @parallel(h) {
                    worker(jobs_rx, done_tx);
                }
            }
            feed(jobs_tx, NUM_JOBS);
        }
    } !>;
    h.wait() !>;

    done_tx.close();

    int jobs_done = 0;
    int v;
    while (cc_io_avail(done_rx.recv(&v)))
        jobs_done++;

    println(@string(`done, jobs_done = ${jobs_done}`, @scratch));
    return (jobs_done == NUM_JOBS) ? 0 : 1;
}

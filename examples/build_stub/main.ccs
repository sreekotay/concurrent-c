/*
 * Build constants example.
 *
 * This example shows how to declare compile-time constants in build.cc.
 * Use --dump-consts to see the merged const bindings:
 *
 *   ./cc/bin/ccc build --build-file examples/build_stub/build.cc --dump-consts
 *
 * The build.cc declares:
 *   CC_CONST DEBUG 1
 *   CC_CONST USE_TLS 1
 *   CC_CONST NUM_WORKERS 4
 *
 * These can be overridden with CLI -D flags.
 */
#include <ccc/script/stdio.cch>
#include <stdlib.h>

int main(void) {
    @errhandler(CCError e) cc_error_exit(e);
    println("build_stub example") !>;
    println("See build.cc for CC_CONST declarations") !>;
    return 0;
}

/* A Node-API addon, in one command:
 *
 *     ccc build examples/recipe_js_module.ccs
 *     node -e "const c = require('./bin/recipe_js_module.node'); console.log(c.bump(4))"
 *
 * No flag says "module": the TU exports `napi_register_module_v1` and
 * defines no `main`, so the build links a shared object named
 * recipe_js_module.node — Node-API addons are file-named, so the source
 * stem names the artifact.  One built artifact loads in any Node-API host:
 * Node, Electron, Bun, Deno.  JS imports CC the same way CC imports
 * Python — one boundary, two doors.
 *
 * The module IS the type: every function whose first parameter is Counter
 * or Counter* becomes a module function, and the module's state is one
 * Counter — stateful module, not a class.  A call may pass a trailing
 * plain object binding arguments by parameter name — `c.bump({by: 2})` —
 * JavaScript's own keyword convention.  A fallible method's error crosses
 * as the JS error class its KIND maps to (CC_ERR_INVALID_ARG below
 * becomes TypeError), the `code` property carrying the kind's name,
 * message intact.  An underscore member — `Counter__clamp` reflects as
 * `_clamp` — stays internal: wrap-and-export is the rename story, and the
 * wrapper is one line. */
#include <ccc/script/js.cch>

typedef struct Counter { long long n; } Counter;

static long long Counter_bump(Counter *self, long long by = 1) {
    self->n += by;
    return self->n;
}
static long long Counter_total(Counter *self) {
    return self->n;
}
static long long Counter__clamp(Counter *self, long long v) {
    (void)self;
    return v > 1000 ? 1000 : v;
}
static long long !>(CCError) Counter_bump_checked(Counter *self, long long by) {
    if (by <= 0) return cc_err(CC_ERR_INVALID_ARG, "bump must be positive");
    self->n = Counter__clamp(self, self->n + by);
    return cc_ok(self->n);
}

/* The seed is the module's initial state, copied in at registration (NULL
 * would mean zeroed).  This counter starts at 100. */
static const Counter seed = { .n = 100 };

void *napi_register_module_v1(void *env, void *exports) {
    return js_module::[Counter](env, exports, &seed);
}

#include <ccc/std/prelude.cch>

int add_ints(int a, int b);

int main(void) {
    int v = add_ints(2, 3);
    CCArena arena@(kilobytes(4)) @destroy;
    if (!cc_arena_is_live(arena)) return 1;
    {
        CCString s = cc_string_new();
        s.append("multi ok: ", arena);
        s.push_int(v, arena);
        s.append("\n", arena);
        cc_std_out.write(s);
    }
    return 0;
}



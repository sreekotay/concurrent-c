/*
 * Recipe: every form of !> / ?> / @errhandler / @destroy
 *
 * One file, one pipeline — the whole shape of !> / ?> / @errhandler /
 * @destroy. Expected stdout lives in the matching .stdout (see tests/
 * version); CI also uses this as a regression sentinel.
 *
 * The combinations below are NOT eleven things to learn: they are two
 * operators — ?> (E → T) and !> (E → control flow) — composed with
 * orthogonal modifiers: (e) exposes E, bare !> routes E to the
 * enclosing @errhandler, and @destroy attaches cleanup to successful
 * declaration construction. This file enumerates the products; the
 * grammar is 2 + 3.
 *
 * Sections:
 *    1. @errhandler default (top of scope)
 *    2. Inline single-line `!> { ... }`
 *    3. Multi-line `!>(e) { ... }` then `@err(e)` (compose → default)
 *    4. `!>(e) { ... } @destroy { ... }` all on one line
 *    5. `!>(e) { ... } @destroy { ... }` split across lines
 *    6. `!> @destroy { ... }` (no handler, defaults to @errhandler)
 *    7. `?>` with a fallback expression
 *    8. `?>` + `@destroy` on one line
 *    9. Bodyless `@destroy;` on a builtin-owned type (CCNursery*, CCChan*)
 *   10. `!> { ... } @destroy { ... }` on a builtin-owned type (one line)
 *   11. Same as 10 but split across lines
 */
#include <ccc/cc_runtime.cch>
#include <stdlib.h>
#include <ccc/script/stdio.cch>

/* Test fixture: maybe_null(0) succeeds (pointer to "hello"), 
   maybe_null(1) returns NULL to trip the error path. */
static char* maybe_null(int want_null) {
    static char buf[] = "hello";
    return want_null ? NULL : buf;
}

int main(void) {
    /* 1. Top-level @errhandler: bare `!>;` reuses this. Soft return so
     *    @destroy bodies still run on the success path demos below. */
    @errhandler(CCError e) { cc_error_log(e); return 1; }

    /* 2. Inline single-line `!> { ... }` — early return on NULL, no binder. */
    char* ok_short = maybe_null(0) !> { cc_error_log(CC_ERROR(CC_ERR_NULL, "unexpected null")); return 1; };
    println(@string(`ok_short=${ok_short}`, @scratch)) !>;

    /* 3. Compose then default: local work, then `@err(e)` → @errhandler. */
    char* ok_multi = maybe_null(0)
        !>(e) {
            /* (error path only — success skips the body) */
            println(@string(`multi: ${e.message}`, @scratch)) !>;
            @err(e);
        };
    println(@string(`ok_multi=${ok_multi}`, @scratch)) !>;

    /* 4. !>(e) {...} @destroy {...} on one line. */
    char* one_line = maybe_null(0) !>(e) { cc_error_log(e); return 3; } @destroy { println("destroy oneline") !>; };
    println(@string(`one_line=${one_line}`, @scratch)) !>;

    /* 5. Multi-line with both handler and destroy spanning lines. */
    char* multi_dest = maybe_null(0)
        !>(e) {
            cc_error_log(e);
            return 4;
        }
        @destroy {
            println("destroy multidest") !>;
        };
    println(@string(`multi_dest=${multi_dest}`, @scratch)) !>;

    /* 6. `!> @destroy` — no handler body, defaults to @errhandler. */
    char* default_eh = maybe_null(0) !> @destroy { println("destroy default_eh") !>; };
    println(@string(`default_eh=${default_eh}`, @scratch)) !>;

    /* 7. ?> with a default expression. */
    char* with_default = maybe_null(1) ?> "fallback";
    println(@string(`with_default=${with_default}`, @scratch)) !>;

    /* 8. ?> with @destroy after, single-line. */
    char* qmark_dest = maybe_null(0) ?> "fallback" @destroy { println("destroy qmark_dest") !>; };
    println(@string(`qmark_dest=${qmark_dest}`, @scratch)) !>;

    /* 9. Bodyless `@destroy;` on builtin-owned types (no user cleanup body). */
    CCNursery* n = cc_nursery_create(NULL) !> @destroy;
    (void)n;

    int[~1 >] tx;
    int[~1 <] rx;
    CCChan* ch = cc_channel_pair(&tx, &rx)
        !>(e) { cc_error_log(e); return 5; }
        @destroy;
    (void)ch;

    /* 10. Same line: `!>(e) STMT @destroy { body }` with a builtin-
     *     owned type — the auto-free runs AFTER the user body. */
    CCNursery* n2 = cc_nursery_create(NULL) !>(e) { cc_error_exit(e); } @destroy { println("destroy n2 (user)") !>; };
    (void)n2;

    /* 11. Split `@destroy` across lines on a builtin-owned type — both the
     *     user body and the auto-free should run. */
    CCNursery* n3 = cc_nursery_create(NULL)
        !>(e) {
            cc_error_log(e);
            return 8;
        }
        @destroy {
            println("destroy n3 (user)") !>;
        };
    (void)n3;

    println("done") !>;
    return 0;
}

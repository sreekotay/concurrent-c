/*
 * Recipe: Async/Await
 *
 * Prefer n.spawn when work is a sibling task under a nursery.
 * Prefer @async when one call stack must suspend and resume — channel
 * ops, nested async calls — without inventing a nursery just to join.
 *
 *   @async functions can suspend with @await.
 *   @await drives an async function even from synchronous main.
 *   Channel send/recv are suspension points inside @async.
 *   Async functions compose: pipeline awaits echo, then bump — one
 *   stack, two suspend regions, no spawn.
 *
 * @await tx.send / rx.recv share the sync surface: bool !>(CCIoError).
 * @async T!>(E) returns pack through the task ABI; @await yields T!>(E).
 */

#include <ccc/cc_runtime.cch>
#include <stdlib.h>
#include <ccc/script/stdio.cch>

/* Suspends twice on the channel, then returns the echoed value. */
@async int !>(CCError) echo_through_channel(CCChanTx tx, CCChanRx rx, int value) {
    @errhandler(CCError e) { return cc_err(e); }
    @await tx.send(value) !>;
    int received = 0;
    @await rx.recv(&received) !>;
    return cc_ok(received);
}

/* Ordinary async step — no channel, still awaitable. */
@async int bump(int value) {
    return value + 1;
}

/* Composition: await echo (Result), then await bump. */
@async int !>(CCError) pipeline(CCChanTx tx, CCChanRx rx, int value) {
    @errhandler(CCError e) { return cc_err(e); }
    int echoed = @await echo_through_channel(tx, rx, value) !>;
    return cc_ok(@await bump(echoed));
}

int main(void) {
    @errhandler(CCError e) { cc_error_log(e); return 1; }

    int[~1 >] tx;
    int[~1 <] rx;
    /* CCChan* is a builtin-owned type: @destroy auto-calls cc_channel_free(ch). */
    CCChan* ch = cc_channel_pair(&tx, &rx) !> @destroy;

    /* Sync main drives the whole async stack with one @await. */
    int result = @await pipeline(tx, rx, 41) !>;

    println(@string(`pipeline result: ${result} (expected 42)`, @scratch)) !>;
    return (result == 42) ? 0 : 1;
}

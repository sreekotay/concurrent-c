/*
 * Recipe: TCP Echo Server
 *
 * Same machine as pigz_idiomatic: units born at the read until stop.
 * Accept is the read. handle is the gap (the conn's C while (recv)).
 * The sock is the sink — no write stage, no n.
 *
 *   CCParallel h = @parallel spawn {
 *       @serial {
 *           do {
 *               sock = accept();
 *               @parallel(h) { handle(sock); }   // overlap; value-copy sock
 *           } while (!test);
 *       }
 *       @serial { if (test) run_test_client(); }
 *   } !>;
 *   h.wait() !>;
 *
 * Stop is listener closed / accept error / --test after one conn.
 * Not a nursery: the set is on the page. Dest `.wait()` joins.
 *
 * Manual run:
 *   ./ccc run examples/recipe_tcp_echo.ccs
 *   (in another shell:)  echo "hello" | nc 127.0.0.1 9000
 *
 * Temp prints use @string(`...`, @scratch). IO windows (peer addr, read
 * buffer, CLI parse) use cc_arena_stack — frame scratch, overflow to heap.
 */
#include <ccc/cc_runtime.cch>
#include <ccc/std/prelude.cch>
#include <ccc/std/net.cch>
#include <ccc/std/cli.cch>
#include <ccc/stdio.cch>

#define PORT "127.0.0.1:9000"

/* Echo every received chunk until the peer closes. */
static void handle_client(CCSocket sock) {
    @errhandler(CCError e) cc_error_exit(e);
    cc_arena_stack(a, kilobytes(4));

    CCNetError peer_err = CC_NET_OK;
    char[:] peer = sock.peer_addr(a, &peer_err);
    if (peer_err == CC_NET_OK) {
        println(@string(`client connected: ${peer}`, @scratch)) !>;
    }

    for (;;) {
        a.reset();
        char[:] data;
        if (!cc_io_avail(sock.read(a, 1024, &data))) {
            println("client disconnected") !>;
            break;
        }
        println(@string(`echo ${data.len} bytes`, @scratch)) !>;
        size_t written = sock.write(data.ptr, data.len) !>(e) {
            (void)e;
            break;
        };
        (void)written;
    }
    sock.close();
}

/* In-process client: connect, send, read echo, close. */
static void run_test_client(void) {
    @errhandler(CCError e) cc_error_exit(e);
    CCSocket sock = cc_tcp_connect(PORT, sizeof(PORT) - 1) !>(e) {
        eprintln(@string(`dial error: ${e}`, @scratch)) !>;
        return;
    };

    const char msg[] = "hello from test\n";
    size_t nw = sock.write(msg, sizeof(msg) - 1) !>(e) {
        eprintln(@string(`write error: ${cc_io_error_str(e)}`, @scratch)) !>;
        sock.close();
        return;
    };
    (void)nw;

    char buf[64] = {0};
    size_t got = 0;
    bool ok = sock.read_into(buf, sizeof(buf) - 1, &got) !>(e) {
        eprintln(@string(`read error: ${cc_io_error_str(e)}`, @scratch)) !>;
        sock.close();
        return;
    };
    if (!ok) got = 0;
    char[:] got_slice = cc_slice_from_buffer(buf, got);
    println(@string(`test client got ${got} bytes: ${got_slice}`, @scratch)) !>;
    sock.close();
}

@grammar(cli) TcpEchoOpts {~~~~
    test: flag --test desc "Self-test: one client sibling, one accept, exit."
~~~~}

static bool parse_test_flag(int argc, char** argv) {
    cc_arena_stack(a, kilobytes(4));
    TcpEchoOpts opts = {0};
    /* Pure parse — no usage ritual; unknown flags are just "not test mode". */
    if (!cc_parse_args(TcpEchoOpts, argc, argv, a, &opts)) return false;
    return opts.test;
}

int main(int argc, char** argv) {
    @errhandler(CCError e) { cc_error_log(e); return 1; }

    bool test_mode = parse_test_flag(argc, argv);

    CCListener ln = cc_tcp_listen(CC_SLICE_LIT(PORT)) !>(e) {
        println(@string(`listen error: ${e}`, @scratch)) !>;
        return 1;
    };
    const char* mode = test_mode ? "test" : "demo";
    println(@string(`listening on ${PORT} (${mode} mode)`, @scratch)) !>;

    CCParallel h = @parallel spawn {
        @serial {
            do {
                CCSocket sock = ln.accept() !>(e) {
                    println(@string(`accept stopped: ${e}`, @scratch)) !>;
                    break;
                };
                @parallel(h) {
                    handle_client(sock);
                }
            } while (!test_mode);
        }
        @serial {
            if (test_mode)
                run_test_client();
        }
    } !>;
    h.wait() !>;

    ln.close();
    println("server done") !>;
    return 0;
}

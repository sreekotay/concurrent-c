#include <ccc/std/prelude.cch>

int main(void) {
    CCArena arena_storage@(kilobytes(4)) @destroy;
    if (!cc_arena_is_live(arena_storage)) return 1;
    CCArena* arena = &arena_storage;
    {
        CCString s = cc_string_new();
        s.append("build_graph hello\n", arena);
        cc_std_out.write(s);
    }
    return 0;
}



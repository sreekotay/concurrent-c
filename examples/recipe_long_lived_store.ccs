/*
 * Recipe: Long-Lived Store Provenance
 *
 * Slices are views; arenas own bytes.  When request-lifetime data needs
 * to live in a longer-lived map, make the provenance movement explicit:
 * anchor a copy in the store arena, then store a view into that arena.
 *
 * Deleting a key below is a logical delete.  The key bytes stay in the
 * store arena until the whole store is freed.
 */
#include <ccc/std/prelude.cch>
#include <stdio.h>
#include <string.h>

CC_MAP_DECL_ARENA(CCSliceHdr, int, StoreMap, cc_map_hash_slice_hdr, cc_map_eq_slice_hdr);

/* Local candidate stdlib helpers.  UFCS lets the recipe use the final
 * surface (`slice.clone_into(&arena)`, `slice.hdr().clone_into(&arena)`)
 * before deciding whether these belong in the real slice library. */
static CCSlice !>(CCError) cc_slice_clone_into(CCSlice* src, CCArena* arena) {
    if (!src || !arena) return cc_err(CC_ERR_INVALID_ARG, "clone_into without arena");
    if (src->len == 0) return cc_ok(cc_slice_from_parts(NULL, 0, CC_SLICE_ID_UNTRACKED, 0));

    void* stable = cc_arena_alloc(arena, src->len, _Alignof(char));
    if (!stable) return cc_err(CC_ERR_OUT_OF_MEMORY, "clone slice");

    memcpy(stable, src->ptr, src->len);
    return cc_ok(cc_slice_from_parts(stable, src->len, CC_SLICE_ID_UNTRACKED, src->len));
}

static CCSliceHdr !>(CCError) cc_slice_hdr_clone_into(CCSliceHdr* src, CCArena* arena) {
    if (!src || !arena) return cc_err(CC_ERR_INVALID_ARG, "clone_into without arena");
    if (src->len == 0) {
        CCSliceHdr empty = {0};
        return cc_ok(empty);
    }

    void* stable = cc_arena_alloc(arena, src->len, _Alignof(char));
    if (!stable) return cc_err(CC_ERR_OUT_OF_MEMORY, "clone slice hdr");

    memcpy(stable, src->ptr, src->len);
    CCSliceHdr out = { .ptr = stable, .len = src->len };
    return cc_ok(out);
}

typedef struct LongLivedStore {
    CCArena map_arena;
    CCArena key_arena;
    StoreMap* entries;
    size_t key_insert_bytes;
    size_t key_delete_bytes;
} LongLivedStore;

static size_t store_key_logical_live_bytes(LongLivedStore* store) {
    return store->key_insert_bytes - store->key_delete_bytes;
}

static void store_free(LongLivedStore* store) {
    if (!store) return;
    if (store->map_arena.base) {
        store->map_arena.free();
        store->map_arena = (CCArena){0};
    }
    if (store->key_arena.base) {
        store->key_arena.free();
        store->key_arena = (CCArena){0};
    }
    store->entries = NULL;
}

static bool !>(CCError) store_init(LongLivedStore* store) {
    if (!store) return cc_err(CC_ERR_INVALID_ARG, "store_init without store");
    *store = (LongLivedStore){0};

    store->map_arena = cc_arena_heap(kilobytes(4));
    if (!store->map_arena.base) return cc_err(CC_ERR_OUT_OF_MEMORY, "map arena");

    store->key_arena = cc_arena_heap(kilobytes(4));
    if (!store->key_arena.base) {
        store_free(store);
        return cc_err(CC_ERR_OUT_OF_MEMORY, "key arena");
    }

    store->entries = StoreMap_init(&store->map_arena);
    if (!store->entries) {
        store_free(store);
        return cc_err(CC_ERR_OUT_OF_MEMORY, "store map");
    }

    return cc_ok(true);
}

static bool !>(CCError) store_anchor_key(LongLivedStore* store, char[:] key, CCSliceHdr* out) {
    if (!store || !out) return cc_err(CC_ERR_INVALID_ARG, "anchor without output");
    CCSliceHdr stable = key.hdr().clone_into(&store->key_arena) !>(e) { return cc_err(e); };
    *out = stable;
    store->key_insert_bytes += key.len;
    return cc_ok(true);
}

static bool !>(CCError) store_put(LongLivedStore* store, char[:] key, int value) {
    if (!store || !store->entries) return cc_err(CC_ERR_INVALID_ARG, "put without store");

    CCSliceHdr query = key.hdr();
    int* existing = StoreMap_get_ptr(store->entries, query);
    if (existing) {
        *existing = value;
        return cc_ok(true);
    }

    CCSliceHdr stable_key = {0};
    bool !>(CCError) anchor_res = store_anchor_key(store, key, &stable_key);
    if (anchor_res.is_err()) return cc_err(anchor_res.error());
    if (StoreMap_insert(store->entries, stable_key, value) != 0) {
        return cc_err(CC_ERR_OUT_OF_MEMORY, "insert");
    }
    return cc_ok(true);
}

static int* store_get(LongLivedStore* store, char[:] key) {
    if (!store || !store->entries) return NULL;
    return StoreMap_get_ptr(store->entries, key.hdr());
}

static bool store_delete(LongLivedStore* store, char[:] key) {
    if (!store || !store->entries) return false;
    if (!StoreMap_remove(store->entries, key.hdr())) return false;
    store->key_delete_bytes += key.len;
    return true;
}

int main(void) {
    @errhandler(CCError e) {
        fprintf(stderr, "fatal: %s\n", e.message);
        return 1;
    }

    LongLivedStore store;
    store_init(&store) !>;
    @defer store_free(&store);

    /* Request arenas model short-lived input.  The store keeps only the
     * anchored copies; these scratch arenas can disappear immediately. */
    for (int request_id = 0; request_id < 3; request_id++) {
        CCArena request_arena = cc_arena_heap(kilobytes(1)) @destroy;
        if (!request_arena.base) return 1;

        CCString key = @string(`user:${request_id}`, &request_arena);
        store_put(&store, key.as_slice(), request_id * 10) !>;
    }

    int* user1 = store_get(&store, cc_slice_from_cstr("user:1"));
    if (!user1 || *user1 != 10) return 2;

    if (!store_delete(&store, cc_slice_from_cstr("user:1"))) return 3;

    printf("entries=%zu logical_key_bytes=%zu inserted=%zu deleted=%zu\n",
           StoreMap_len(store.entries),
           store_key_logical_live_bytes(&store),
           store.key_insert_bytes,
           store.key_delete_bytes);
    return 0;
}

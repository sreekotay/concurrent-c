/*
 * Recipe: Long-Lived Store Provenance
 *
 * Slices are views; arenas own bytes.  When request-lifetime data needs
 * to live in a longer-lived map, make the provenance movement explicit:
 * anchor a copy in the store arena, then store a view into that arena.
 *
 * Deleting a key below is a logical delete.  The key bytes stay in the
 * store arena until the whole store is freed.
 */
#include <ccc/std/prelude.cch>
#include <stdlib.h>
#include <ccc/script/stdio.cch>

typedef struct Store {
    CCArena map_arena;
    CCArena key_arena;
    Map::[CCSliceHdr, int] entries;
    size_t key_insert_bytes;
    size_t key_delete_bytes;
} Store;

static size_t store_key_logical_live_bytes(Store* store) {
    return store->key_insert_bytes - store->key_delete_bytes;
}

static void store_free(Store* store) {
    if (!store) return;
    store->map_arena.destroy();
    store->key_arena.destroy();
    store->entries = NULL;
}

static bool !>(CCError) store_init(Store* store) {
    if (!store) return cc_err(CC_ERR_INVALID_ARG, "store_init without store");
    *store = (Store){0};

    store->map_arena = cc_arena_heap(kilobytes(4));
    if (!store->map_arena.valid()) return cc_err(CC_ERR_OUT_OF_MEMORY, "map arena");

    store->key_arena = cc_arena_heap(kilobytes(4));
    if (!store->key_arena.valid()) {
        store->free();
        return cc_err(CC_ERR_OUT_OF_MEMORY, "key arena");
    }

    store->entries = map_new::[CCSliceHdr, int](&store->map_arena);
    if (!store->entries) {
        store->free();
        return cc_err(CC_ERR_OUT_OF_MEMORY, "store map");
    }

    return cc_ok(true);
}

static CCSliceHdr !>(CCError) store_anchor_key(Store* store, char[:] key) {
    if (!store) return cc_err(CC_ERR_INVALID_ARG, "anchor without store");
    CCSliceHdr view = key.hdr();
    CCSliceHdr stable = view.clone_into(&store->key_arena) !>(e) { return cc_err(e); };
    store->key_insert_bytes += key.len;
    return cc_ok(stable);
}

static void !>(CCError) store_insert_entry(Store* store, CCSliceHdr key, int value) {
    Map::[CCSliceHdr, int] entries = store ? store->entries : NULL;
    if (!entries) return cc_err(CC_ERR_INVALID_ARG, "insert without entries");
    int rc = entries->insert(key, value);
    if (rc != 0) return cc_err(CC_ERR_OUT_OF_MEMORY, "insert");
    return cc_ok();
}

static bool !>(CCError) store_put(Store* store, char[:] key, int value) {
    Map::[CCSliceHdr, int] entries = store ? store->entries : NULL;
    if (!entries) return cc_err(CC_ERR_INVALID_ARG, "put without store");

    CCSliceHdr query = key.hdr();
    int* existing = entries->get_ptr(query);
    if (existing) {
        *existing = value;
        return cc_ok(true);
    }

    CCSliceHdr stable_key = store_anchor_key(store, key) !>(e) { return cc_err(e); };
    store->insert_entry(stable_key, value) !>(e) { return cc_err(e); };
    return cc_ok(true);
}

static int* store_get(Store* store, char[:] key) {
    if (!store || !store->entries) return NULL;
    return store->entries->get_ptr(key.hdr());
}

static bool store_delete(Store* store, char[:] key) {
    if (!store || !store->entries) return false;
    if (!store->entries->remove(key.hdr())) return false;
    store->key_delete_bytes += key.len;
    return true;
}

int main(void) {
    @errhandler(CCError e) { cc_error_log(e); return 1; }

    Store store;
    store.init() !>;
    @defer store.free();

    /* Request checkpoints model short-lived input.  The store keeps only the
     * anchored copies; each checkpoint restore drops request scratch bytes. */
    CCArena request_arena = cc_arena_heap(kilobytes(1)) @destroy;
    if (!request_arena.valid()) return 1;

    for (int request_id = 0; request_id < 3; request_id++) {
        CCArenaCheckpoint request_scope = request_arena.checkpoint() @destroy;

        CCString key = @string(`user:${request_id}`, &request_arena);
        store.put(key.as_slice(), request_id * 10) !>;
    }

    int* user1 = store.get(CC_SLICE_LIT("user:1"));
    if (!user1 || *user1 != 10) return 2;

    if (!store.delete(CC_SLICE_LIT("user:1"))) return 3;

    Map::[CCSliceHdr, int] entries = store.entries;
    size_t n = entries->len();
    size_t live = store.key_logical_live_bytes();
    println(@string(`entries=${n} logical_key_bytes=${live} inserted=${store.key_insert_bytes} deleted=${store.key_delete_bytes}`, @scratch)) !>;
    return 0;
}

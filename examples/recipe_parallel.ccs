/*
 * Recipe: @parallel
 *
 * Forms, selected by the token after @parallel:
 *
 *   @parallel { a = f(); b = g(); } !>.wait()!>;
 *       Value join. Arms are independent assignments, an
 *       expression with no dest (it just runs), or @serial { … }
 *       that writes one outer name. The first arm runs on
 *       the caller; each remaining arm is spawned. `.wait()`
 *       joins. Binding without `.wait()` leaves siblings in flight.
 *
 *   @parallel (d < k) { a = f(); b = g(); }
 *       Same arms. Spawn if the predicate is true; otherwise run
 *       the assignments in order on the caller. The body always
 *       runs — the predicate is scheduling, not presence.
 *
 *   @parallel for (i in lo..hi) { work(i); }
 *       Independent iterations over a half-open integer range.
 *       The lowerer bisects the span; a span of length 0 or 1
 *       is an ordinary for.
 *
 * A dest `CCParallel h = @parallel { … } !>;` is live before the
 * arms: cancel/adopt/pause on `h` compose there. `h.wait()` in an
 * arm of `h` is an error. One assignment arm with a dest is an error:
 * this dest is never live on the caller. One expression arm is the
 * worker (spawned); dest is live. Mark the caller `@serial`, or join
 * with `!>.wait()!>`. Pointer names copy the pointer so a
 * dest-live return does not leave a dangling slot; other captured
 * names are the frame object and must outlive `.wait()`.
 *
 * Neither form is a nursery. n.spawn still names a task lifetime.
 * A for statement as a direct child of @parallel { } is a compile
 * error; for inside @serial is ordinary C. Bare { } is not an arm.
 *
 * Tree bench vs Go: perf/compare_parallel_hello.sh
 */
#include <ccc/std/prelude.cch>
#include <stdint.h>
#include <ccc/script/stdio.cch>

#define U24_MASK 0xFFFFFFu
#define DEPTH 8
#define CUT 4
#define N 32

static uint32_t u24(uint32_t x) {
    return x & U24_MASK;
}

static uint32_t sum_seq(uint32_t d, uint32_t i) {
    if (d >= DEPTH)
        return i;
    return u24(sum_seq(d + 1, u24(i * 2)) + sum_seq(d + 1, u24(i * 2 + 1)));
}

static uint32_t sum_par(uint32_t d, uint32_t i) {
    if (d >= DEPTH)
        return i;
    uint32_t left = 0;
    uint32_t right = 0;
    @parallel (d < CUT) {
        left  = sum_par(d + 1, u24(i * 2));
        right = sum_par(d + 1, u24(i * 2 + 1));
    } !>.wait()!>;
    return u24(left + right);
}

int main(void) {
    @errhandler(CCError err) { cc_error_log(err); return 1; }
    uint32_t want = sum_seq(0, 0);
    uint32_t got = sum_par(0, 0);
    println(@string(`tree: want=${want} got=${got}`, @scratch)) !>;
    if (got != want)
        return 1;

    int seq[N];
    int par[N];
    int k;
    for (k = 0; k < N; k++)
        seq[k] = k * k;
    @parallel for (k in 0..N) {
        par[k] = k * k;
    } !>.wait()!>;
    for (k = 0; k < N; k++) {
        if (par[k] != seq[k])
            return 1;
    }
    println("range: ok") !>;

    int left = 0;
    int right = 0;
    @parallel {
        @serial {
            int t = 3;
            left = t * t;
        }
        right = 16;
    } !>.wait()!>;
    if (left + right != 25)
        return 1;
    println("serial: ok") !>;

    {
        int p = 0;
        int q = 0;
        int r = 0;
        int s = 0;
        CCParallel h1 = @parallel {
            p = 1;
            q = 2;
        } !>;
        CCParallel h2 = @parallel {
            r = 3;
            s = 4;
        } !>;
        h1.adopt(h2) !>;
        @parallel {
            h1.wait() !>;
            h2.wait() !>;
        } !>.wait()!>;
        if (p + q + r + s != 10)
            return 1;
        println("handles: ok") !>;
    }

    {
        int p = 0;
        int q = 0;
        CCParallel h = @parallel {
            @serial {
                int r = 0;
                int s = 0;
                CCParallel c = @parallel {
                    r = 3;
                    s = 4;
                } !>;
                h.adopt(c) !>;
                c.wait() !>;
                p = r + s;
            }
            q = 2;
        } !>;
        h.wait() !>;
        if (p + q != 9)
            return 1;
        println("live dest: ok") !>;
    }
    return 0;
}

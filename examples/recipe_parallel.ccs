/*
 * Recipe: @parallel
 *
 * Lexical fork-join — not a nursery. The token after @parallel
 * picks the form:
 *
 *   @parallel { a = f(); b = g(); } !>.wait()!>;
 *       Independent arms. Assignment, a bare expression, or
 *       @serial { … } that writes one outer name. First arm on
 *       the caller; the rest may spawn. `.wait()` joins.
 *
 *   @parallel (d < k) { … }
 *       Same arms. Spawn if the predicate; otherwise run in
 *       order. The body always runs.
 *
 *   @parallel for (i in lo..hi) { slot[i] = work(i); }
 *       Independent iterations. Disjoint writes. Bisects; span
 *       0 or 1 is a plain for. No shared dest.
 *
 *   @parallel wait (ts) for (i in lo..hi) { … @stage … }
 *       Ordered tickets on a turnstile. Cap limits how many
 *       compute at once. Work outside @stage overlaps; the
 *       stage is the shared write ticket (loop-carried cursor,
 *       file, checksum). Same body under seq (0).
 *
 * Dest `CCParallel h = @parallel { … } !>;` is live before the
 * arms. Binding does not join. One assignment arm with a dest
 * is an error. One expression arm is the worker. `h.wait()` in
 * an arm of `h` is an error.
 *
 * Not this file:
 *   send_task + ordered recv → recipe_ordered_parallel.ccs
 *   two named stages (read then write) → recipe_turnstile.ccs
 *
 * Tree bench vs Go: perf/compare_parallel_hello.sh
 */
#include <ccc/std/prelude.cch>
#include <stdint.h>
#include <ccc/stdio.cch>

#define U24_MASK 0xFFFFFFu
#define DEPTH 8
#define CUT 4
#define N 32

static uint32_t u24(uint32_t x) {
    return x & U24_MASK;
}

static uint32_t sum_seq(uint32_t d, uint32_t i) {
    if (d >= DEPTH)
        return i;
    return u24(sum_seq(d + 1, u24(i * 2)) + sum_seq(d + 1, u24(i * 2 + 1)));
}

static uint32_t sum_par(uint32_t d, uint32_t i) {
    if (d >= DEPTH)
        return i;
    uint32_t left = 0;
    uint32_t right = 0;
    @parallel (d < CUT) {
        left  = sum_par(d + 1, u24(i * 2));
        right = sum_par(d + 1, u24(i * 2 + 1));
    } !>.wait()!>;
    return u24(left + right);
}

int main(void) {
    @errhandler(CCError err) { cc_error_log(err); return 1; }
    uint32_t want = sum_seq(0, 0);
    uint32_t got = sum_par(0, 0);
    println(@string(`tree: want=${want} got=${got}`, @scratch)) !>;
    if (got != want)
        return 1;

    int seq[N];
    int par[N];
    int k;
    for (k = 0; k < N; k++)
        seq[k] = k * k;
    @parallel for (k in 0..N) {
        par[k] = k * k;
    } !>.wait()!>;
    for (k = 0; k < N; k++) {
        if (par[k] != seq[k])
            return 1;
    }
    println("range: ok") !>; /* disjoint slots — not a shared dest */

    {
        CCArena arena = cc_arena_heap(kilobytes(64)) @destroy;
        CCTurnstile ts@(3, 1, arena) !> @destroy;
        int packed[N];
        int pos = 0;
        int i;
        @parallel wait (ts) for (i in 0..N) {
            int v = i * i;
            @stage (ts, 0, i) {
                packed[pos] = v;
                pos = pos + 1;
            }
        } !>.wait()!>;
        if (pos != N)
            return 1;
        for (i = 0; i < N; i++) {
            if (packed[i] != i * i)
                return 1;
        }
        println("wait-for: ok") !>;
    }

    int left = 0;
    int right = 0;
    @parallel {
        @serial {
            int t = 3;
            left = t * t;
        }
        right = 16;
    } !>.wait()!>;
    if (left + right != 25)
        return 1;
    println("serial: ok") !>;

    {
        int p = 0;
        int q = 0;
        int r = 0;
        int s = 0;
        CCParallel h1 = @parallel {
            p = 1;
            q = 2;
        } !>;
        CCParallel h2 = @parallel {
            r = 3;
            s = 4;
        } !>;
        h1.adopt(h2) !>;
        @parallel {
            h1.wait() !>;
            h2.wait() !>;
        } !>.wait()!>;
        if (p + q + r + s != 10)
            return 1;
        println("handles: ok") !>;
    }

    {
        int p = 0;
        int q = 0;
        CCParallel h = @parallel {
            @serial {
                int r = 0;
                int s = 0;
                CCParallel c = @parallel {
                    r = 3;
                    s = 4;
                } !>;
                h.adopt(c) !>;
                c.wait() !>;
                p = r + s;
            }
            q = 2;
        } !>;
        h.wait() !>;
        if (p + q != 9)
            return 1;
        println("live dest: ok") !>;
    }
    return 0;
}

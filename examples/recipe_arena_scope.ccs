/*
 * Recipe: Scoped Memory (Arena)
 *
 * An arena names a lifetime. Its allocation strategy (bump slabs, growth,
 * overflow) is an implementation policy for storage belonging to that
 * lifetime. @destroy ends the lifetime at scope exit; if declared in a
 * loop body, that's once per iteration. Checkpoints instead peel back
 * scratch without ending the whole lifetime.
 *
 * @scratch is throwaway. To keep a product past the call that creates it,
 * pass the arena it should live on — last parameter, so UFCS binds the data:
 * n.label(keep).
 */
#include <ccc/std/prelude.cch>
#include <ccc/stdio.cch>

/* Arena last: the CCString lives on `a`, not in this call. */
static CCString label(int n, CCArena a) {   // Caller chooses the product lifetime - arena as last parameter.
    return @string(`req-${n}`, a);          // Produced storage lives on that arena.
}

int main(void) {
    CCArena arena = cc_arena_heap(kilobytes(4)) @destroy;
    CCArena keep = cc_arena_heap(kilobytes(1)) @destroy;
    @errhandler(CCError e) { cc_error_log(e); return 1; }
    for (int i = 1; i <= 3; i++) {
        println(@string(`Processing request ${i} bytes: ${arena.remaining()}`, @scratch)) !>;

        /* scratch allocation, reclaimed at cp.restore(); the element
         * type comes from the destination */
        CCArenaCheckpoint cp = arena.checkpoint() @destroy;
        char* scratch = arena.allocT(1024);
        if (scratch) scratch[0] = '\0';
        cp.try_restore() !>;
    }

    int n = 3;
    CCString kept = n.label(keep);
    println(@string(`kept ${kept}`, @scratch)) !>;
    return 0;
}

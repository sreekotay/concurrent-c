/*
 * Recipe: Scoped Memory (Arena)
 *
 * An arena names a lifetime. Its allocation strategy (bump slabs, growth,
 * overflow) is an implementation policy for storage belonging to that
 * lifetime. @destroy ends the lifetime at scope exit — in a loop body,
 * that's once per iteration, so each "request" gets a clean epoch.
 * Checkpoints peel back scratch without ending the whole lifetime.
 */
#include <ccc/std/prelude.cch>
#include <stdlib.h>
#include <ccc/script/stdio.cch>

int main(void) {
    CCArena arena = cc_arena_heap(kilobytes(4)) @destroy;
    @errhandler(CCError e) { cc_error_log(e); return 1; }
    for (int i = 1; i <= 3; i++) {
        println(@string(`Processing request ${i} bytes: ${arena.remaining()}`, @scratch)) !>;

        /* scratch allocation, reclaimed at cp.restore(); the element
         * type comes from the destination */
        CCArenaCheckpoint cp = arena.try_checkpoint() !> @destroy;
        char* scratch = arena.allocT(1024);
        if (scratch) scratch[0] = '\0';
        cp.try_restore() !>;
    }
    return 0;
}

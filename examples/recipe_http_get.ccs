/*
 * Recipe: Async HTTP Requests
 *
 * Independent fetches are `@parallel for`. Soft-fail per URL so offline
 * CI can SKIP. Arena-local response body. `@link("curl")` for the lib.
 *
 * Build:
 *   ./cc/bin/ccc build run examples/recipe_http_get.ccs -DCC_ENABLE_HTTP=1
 */
@link("curl")

#include <ccc/cc_runtime.cch>
#include <ccc/cc_parallel.cch>
#include <ccc/std/http.cch>
#include <ccc/script/stdio.cch>
#include <string.h>

const char* g_urls[] = {
    "https://httpbin.org/get",
    "https://httpbin.org/headers",
    "https://httpbin.org/ip",
};
#define NUM_URLS 3

static void fetch_one(int idx, int* status_p, size_t* body_len_p) {
    @errhandler(CCError e) cc_error_exit(e);
    char buf[32 * 1024];
    {
        CCArena scratch = cc_arena_create_buffer(buf, sizeof(buf), CC_ARENA_GROWABLE) @destroy;
        const char* url = g_urls[idx];
        CCHttpResponse resp = cc_http_get(scratch, url, strlen(url)) !>(e) {
            status_p[idx] = -1;
            int code = (int)e.code;
            println(@string(`[${idx}] ${url} -> ERROR ${code}`, @scratch)) !> { return; };
            return;
        };
        status_p[idx] = resp.status;
        body_len_p[idx] = resp.body.len;
        println(@string(`[${idx}] ${url} -> ${resp.status} (${resp.body.len} bytes)`, @scratch)) !> { return; };
    }
}

int main(void) {
    @errhandler(CCError e) { cc_error_log(e); return 1; }

    println(@string(`Fetching ${NUM_URLS} URLs in parallel...`, @scratch)) !>;
    println("") !>;

    int status[NUM_URLS] = {0};
    size_t body_len[NUM_URLS] = {0};
    int i;
    @parallel for (i in 0..NUM_URLS) {
        fetch_one(i, status, body_len);
    } !>.wait()!>;

    println("\n=== Summary ===") !>;
    int success = 0;
    int network_errors = 0;
    for (i = 0; i < NUM_URLS; i++) {
        if (status[i] == 200) success++;
        else if (status[i] == -1) network_errors++;
        const char* url = g_urls[i];
        println(@string(`${url}: ${status[i]} (${body_len[i]} bytes)`, @scratch)) !>;
    }
    println(@string(`Success: ${success}/${NUM_URLS}`, @scratch)) !>;

    if (success == 0) {
        println("\nSKIP: No network access or all requests failed.") !>;
        return 0;
    }
    (void)network_errors;

    return (success == NUM_URLS) ? 0 : 1;
}

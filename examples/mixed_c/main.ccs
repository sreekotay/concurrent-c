#include <ccc/std/prelude.cch>

#include "helper.h"

int main(void) {
    CCArena arena_storage@(kilobytes(4)) @destroy;
    if (!cc_arena_is_live(arena_storage)) return 1;
    CCArena* arena = &arena_storage;
    {
        CCString s = cc_string_new();
        int v = helper_add(2, 5);
        s.append("mixed_c helper_add(2,5)=", arena);
        s.push_int(v, arena);
        s.append("\n", arena);
        cc_std_out.write(s);
    }
    return 0;
}



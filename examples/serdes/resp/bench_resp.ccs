// RESP request-pipeline bench: generated @grammar(schema) parser vs a
// hand-rolled reference. Corpus: K SET commands, redis-benchmark shaped.
#include <ccc/std/prelude.cch>
#include <stdlib.h>
#include <string.h>
#include <ccc/stdio.cch>
#include <time.h>

/* Bulk lengths are non-negative: `keep [some digit]` (no opt '-') so the
 * fused int run has no sign branch — same as the hand RESP path. */
@grammar(schema) RespArg {~~~~
    rules [
        digit:  charset [#'0' - #'9']
        number: keep [some digit]
    ]
    #'$' len: int number "\r\n"
    data: bytes len
    "\r\n"
~~~~}

@grammar(schema) RespCmd {~~~~
    rules [
        digit:  charset [#'0' - #'9']
        number: keep [some digit]
    ]
    #'*' argc: int number "\r\n"
    args: items RespArg argc cap 16
~~~~}

static double now_s(void){struct timespec t;clock_gettime(CLOCK_MONOTONIC,&t);return t.tv_sec+t.tv_nsec/1e9;}

/* Force prior stores to [p, p+n) to complete — encode benches write a buffer
 * that is otherwise never read, and -O2 DSE turns that into a no-op. */
static void sink_buf(const void* p, size_t n) {
#if defined(__GNUC__) || defined(__clang__)
    __asm__ __volatile__("" : : "r"(p), "r"(n) : "memory");
#else
    volatile unsigned char x = 0;
    const unsigned char* b = (const unsigned char*)p;
    if (n) { x ^= b[0]; x ^= b[n - 1]; }
    (void)x;
#endif
}

static size_t put_u(char* d, unsigned long long u) {
    char nb[21]; int nl = 0;
    do { nb[nl++] = (char)('0' + (u % 10)); u /= 10; } while (u);
    size_t o = 0;
    while (nl) d[o++] = nb[--nl];
    return o;
}

/* hand-rolled reference: same job, same zero-copy contract */
typedef struct { const char* p; size_t len; } HArg;
static long hand_parse(const char* s, size_t n, HArg* args, int max_args, unsigned long long* bytes) {
    size_t p = 0; long cmds = 0;
    while (p < n) {
        if (s[p++] != '*') return -1;
        long argc = 0;
        while (p < n && s[p] >= '0' && s[p] <= '9') argc = argc * 10 + (s[p++] - '0');
        if (p + 2 > n || s[p] != '\r' || s[p+1] != '\n') return -1;
        p += 2;
        if (argc > max_args) return -1;
        for (long i = 0; i < argc; i++) {
            if (p >= n || s[p++] != '$') return -1;
            long len = 0;
            while (p < n && s[p] >= '0' && s[p] <= '9') len = len * 10 + (s[p++] - '0');
            if (p + 2 > n || s[p] != '\r' || s[p+1] != '\n') return -1;
            p += 2;
            if (p + (size_t)len + 2 > n) return -1;
            args[i].p = s + p; args[i].len = (size_t)len;
            *bytes += (unsigned long long)len;
            p += (size_t)len;
            if (s[p] != '\r' || s[p+1] != '\n') return -1;
            p += 2;
        }
        cmds++;
    }
    return cmds;
}

int main(int argc, char** argv) {
    CCArena pa = cc_arena_create(kilobytes(4));
    @errhandler(CCError e) { cc_error_log(e); return 1; }

    int NCMD = argc > 1 ? atoi(argv[1]) : 100000;
    int K = argc > 2 ? atoi(argv[2]) : 30, T = argc > 3 ? atoi(argv[3]) : 3;

    /* synthesize the pipeline */
    size_t cap = (size_t)NCMD * 64;
    char* buf = (char*)malloc(cap);
    size_t n = 0;
    for (int i = 0; i < NCMD; i++) {
        char key[32], val[32];
        size_t kl = 0;
        key[kl++] = 'k'; key[kl++] = 'e'; key[kl++] = 'y'; key[kl++] = ':';
        kl += put_u(key + kl, (unsigned long long)i);
        size_t vl = 0;
        val[vl++] = 'v'; val[vl++] = 'a'; val[vl++] = 'l'; val[vl++] = 'u';
        val[vl++] = 'e'; val[vl++] = '-';
        vl += put_u(val + vl, (unsigned long long)i);
        memcpy(val + vl, "-xxxxxxxx", 9);
        vl += 9;
        char* d = buf + n;
        size_t o = 0;
        d[o++] = '*'; o += put_u(d + o, 3); d[o++] = '\r'; d[o++] = '\n';
        const char* parts[3] = { "SET", key, val };
        size_t plens[3] = { 3, kl, vl };
        for (int a2 = 0; a2 < 3; a2++) {
            d[o++] = '$'; o += put_u(d + o, (unsigned long long)plens[a2]);
            d[o++] = '\r'; d[o++] = '\n';
            memcpy(d + o, parts[a2], plens[a2]);
            o += plens[a2];
            d[o++] = '\r'; d[o++] = '\n';
        }
        n += o;
    }

    CCArena ar = cc_arena_create(64 << 20);
    double best;

    best = 1e18;
    long gc = 0; unsigned long long gb = 0;
    for (int t = 0; t < T; t++) { double t0 = now_s();
        for (int i = 0; i < K; i++) {
            ar.reset();
            size_t pos = 0; gc = 0; gb = 0;
            while (pos < n) {
                RespCmd c;
                if (!RespCmd_read(buf, n, &pos, ar, &c)) { eprintln("gen FAIL") !>; return 1; }
                gc++;
                for (size_t j = 0; j < c.args_n; j++) gb += c.args[j].data.len;
            }
        }
        double dt = now_s() - t0; if (dt < best) best = dt; }
    println(@string(`resp gen      ${n*(double)K/best/1e6} MB/s  ${gc*(double)K/best/1e6} Mcmd/s  (cmds=${gc} argbytes=${gb})`, pa)) !>;

    best = 1e18;
    long hc = 0; unsigned long long hb = 0;
    HArg ha[16];
    for (int t = 0; t < T; t++) { double t0 = now_s();
        for (int i = 0; i < K; i++) { hb = 0; hc = hand_parse(buf, n, ha, 16, &hb); if (hc < 0) { eprintln("hand FAIL") !>; return 1; } }
        double dt = now_s() - t0; if (dt < best) best = dt; }
    println(@string(`resp hand     ${n*(double)K/best/1e6} MB/s  ${hc*(double)K/best/1e6} Mcmd/s  (cmds=${hc} argbytes=${hb})`, pa)) !>;

    if (gc != hc || gb != hb) {
        eprintln(@string(`MISMATCH gen ${gc}/${gb} hand ${hc}/${hb}`, pa)) !>;
        return 1;
    }
    /* ENCODE: generated writer vs hand — Redis-client hot path.
     * Each cmd varies key/value with j (same shape as the parse corpus).
     * sink_buf keeps writes live under -O2 DSE. */
    {
        RespCmd cmd = { .argc = 0, .args_n = 3 };
        cmd.args[0].data = cc_slice_hdr_from_buffer((void*)"SET", 3);
        char* eb = (char*)malloc((size_t)NCMD * 64);
        char key[32], val[48];
        size_t en = 0, en_hand = 0;
        size_t cap = (size_t)NCMD * 64;

        best = 1e18;
        for (int t = 0; t < T; t++) { double t0 = now_s();
            for (int i = 0; i < K; i++) {
                en = 0;
                for (int j = 0; j < NCMD; j++) {
                    size_t kl = 0; key[kl++] = 'k'; key[kl++] = 'e'; key[kl++] = 'y'; key[kl++] = ':';
                    kl += put_u(key + kl, (unsigned long long)j);
                    size_t vl = 0; val[vl++] = 'v'; val[vl++] = 'a'; val[vl++] = 'l'; val[vl++] = 'u';
                    val[vl++] = 'e'; val[vl++] = '-';
                    vl += put_u(val + vl, (unsigned long long)j);
                    memcpy(val + vl, "-xxxxxxxx", 9); vl += 9;
                    cmd.args[1].data = cc_slice_hdr_from_buffer(key, kl);
                    cmd.args[2].data = cc_slice_hdr_from_buffer(val, vl);
                    /* reserved buffer — unchecked face matches hand peer */
                    size_t w = cmd.write_unchecked(eb + en);
                    if (!w) { eprintln("encode FAIL") !>; return 1; }
                    en += w;
                }
                sink_buf(eb, en);
            }
            double dt = now_s() - t0; if (dt < best) best = dt; }
        println(@string(`resp enc gen  ${en*(double)K/best/1e6} MB/s  ${NCMD*(double)K/best/1e6} Mcmd/s`, pa)) !>;

        best = 1e18;
        for (int t = 0; t < T; t++) { double t0 = now_s();
            for (int i = 0; i < K; i++) {
                en_hand = 0;
                for (int j = 0; j < NCMD; j++) {
                    size_t kl = 0; key[kl++] = 'k'; key[kl++] = 'e'; key[kl++] = 'y'; key[kl++] = ':';
                    kl += put_u(key + kl, (unsigned long long)j);
                    size_t vl = 0; val[vl++] = 'v'; val[vl++] = 'a'; val[vl++] = 'l'; val[vl++] = 'u';
                    val[vl++] = 'e'; val[vl++] = '-';
                    vl += put_u(val + vl, (unsigned long long)j);
                    memcpy(val + vl, "-xxxxxxxx", 9); vl += 9;
                    /* fair peer: dynamic ints + memcpy from parts, no checks */
                    char* d = eb + en_hand; size_t o = 0;
                    d[o++] = '*'; o += put_u(d + o, 3); d[o++] = '\r'; d[o++] = '\n';
                    const char* parts[3] = { "SET", key, val };
                    size_t plens[3] = { 3, kl, vl };
                    for (int a2 = 0; a2 < 3; a2++) {
                        d[o++] = '$'; o += put_u(d + o, (unsigned long long)plens[a2]);
                        d[o++] = '\r'; d[o++] = '\n';
                        memcpy(d + o, parts[a2], plens[a2]); o += plens[a2];
                        d[o++] = '\r'; d[o++] = '\n';
                    }
                    en_hand += o;
                }
                sink_buf(eb, en_hand);
            }
            double dt = now_s() - t0; if (dt < best) best = dt; }
        if (en_hand != en) {
            eprintln(@string(`ENCODE LEN MISMATCH gen ${en} hand ${en_hand}`, pa)) !>;
            return 1;
        }
        println(@string(`resp enc hand ${en_hand*(double)K/best/1e6} MB/s  ${NCMD*(double)K/best/1e6} Mcmd/s  (dynamic, unchecked)`, pa)) !>;
        free(eb);
    }

    return 0;
}

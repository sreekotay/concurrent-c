// JSON WRITE bench: the narrowed Feed/Tweet schemas formatted back to
// canonical JSON through the codec's /encode inverse, vs a hand-rolled
// UNCHECKED single-pass encoder producing byte-identical output.
//
//   ./bench_write <corpus.json> [K]
//
// The generated Name_write is the single-pass CHECKED writer (__wchk);
// parity here means bounds checking is free at this grain. The escape
// encoder is table-driven (memcpy clean runs) — the same technique yyjson
// uses; with it the generated writer matches yyjson_mut_write on the
// identical byte output (see docs). Corpora that don't parse as a Feed
// are skipped.
#include <ccc/std/prelude.cch>
#include <time.h>
#include "json_codec.cch"

@grammar(rules) Json {~~~~
    include "json_dom.rules"
    string:  [#'"' keep/decode(jstr)/encode(jstr_enc) any [some strchar | esc] #'"']
    value:   [ws [string | number | object | array
                 | keep ["true" | "false" | "null"]] ws]
~~~~}

@grammar(schema) Tweet {~~~~
    use Json
    Json.object [
        "id"   id:   int Json.number
        "text" text: Json.string
        "user" Json.object [ "screen_name" user_name: Json.string ]
    ]
~~~~}

@grammar(schema) Feed {~~~~
    use Json
    Json.ws
    Json.object [ "statuses" statuses: Json.array of Tweet ]
    Json.ws
~~~~}

static double now_s(void){struct timespec t;clock_gettime(CLOCK_MONOTONIC,&t);return t.tv_sec+t.tv_nsec/1e9;}

/* hand-rolled peer: same output, same derived-length semantics, dynamic data */
static size_t hand_write(const Feed* f, char* dst) {
    size_t o = 0;
    memcpy(dst + o, "{\"statuses\":[", 13); o += 13;
    for (size_t i = 0; i < f->statuses_n; i++) {
        const Tweet* t = &f->statuses[i];
        if (i) dst[o++] = ',';
        memcpy(dst + o, "{\"id\":", 6); o += 6;
        {
            long long x = t->id;
            char nb[21]; int nl = 0;
            unsigned long long u = x < 0 ? (unsigned long long)-x : (unsigned long long)x;
            if (x < 0) dst[o++] = '-';
            do { nb[nl++] = (char)('0' + (u % 10)); u /= 10; } while (u);
            while (nl) dst[o++] = nb[--nl];
        }
        memcpy(dst + o, ",\"text\":\"", 9); o += 9;
        o += jstr_enc((const char*)t->text.ptr, t->text.len, dst + o, (size_t)-1);
        memcpy(dst + o, "\",\"user\":{\"screen_name\":\"", 25); o += 25;
        o += jstr_enc((const char*)t->user_name.ptr, t->user_name.len, dst + o, (size_t)-1);
        memcpy(dst + o, "\"}}", 3); o += 3;
    }
    dst[o++] = ']'; dst[o++] = '}';
    return o;
}

int main(int argc, char** argv) {
    const char* path = argc > 1 ? argv[1] : "examples/serdes/json/twitter.json";
    FILE* f = fopen(path, "rb");
    if (!f) { printf("no corpus at %s\n", path); return 1; }
    fseek(f, 0, SEEK_END); long fn = ftell(f); fseek(f, 0, SEEK_SET);
    char* buf = (char*)malloc((size_t)fn + 1);
    size_t rd = fread(buf, 1, (size_t)fn, f);
    fclose(f);

    CCArena arena = cc_arena_create(64 << 20);
    Feed feed;
    if (!Feed_parse(buf, rd, &arena, &feed)) {
        printf("write: corpus is not a Feed — skipped\n");
        return 0;
    }

    char* out = (char*)malloc(rd * 2 + 4096);
    size_t w = Feed_write(&feed, out, rd * 2 + 4096);
    if (!w) { printf("write FAIL\n"); return 1; }
    /* sanity: reparse round-trip */
    {
        Feed rt;
        if (!Feed_parse(out, w, &arena, &rt) || rt.statuses_n != feed.statuses_n) {
            printf("roundtrip FAIL\n"); return 1;
        }
    }
    char* hout = (char*)malloc(rd * 2 + 4096);
    size_t hw = hand_write(&feed, hout);
    if (hw != w || memcmp(hout, out, w) != 0) { printf("MISMATCH gen=%zu hand=%zu\n", w, hw); return 1; }

    const int K = argc > 2 ? atoi(argv[2]) : 2000;
    double best;
    best = 1e30;
    for (int r = 0; r < 5; r++) {
        double t0 = now_s();
        for (int i = 0; i < K; i++) {
            size_t x = Feed_write(&feed, out, rd * 2 + 4096);
            if (x != w) { printf("bench FAIL\n"); return 1; }
        }
        double dt = now_s() - t0;
        if (dt < best) best = dt;
    }
    printf("json write gen  %6.0f MB/s  (%zu bytes/iter, statuses=%zu)\n",
           (double)w * K / best / 1e6, w, feed.statuses_n);
    best = 1e30;
    for (int r = 0; r < 5; r++) {
        double t0 = now_s();
        for (int i = 0; i < K; i++) {
            size_t x = hand_write(&feed, hout);
            if (x != w) { printf("bench FAIL\n"); return 1; }
        }
        double dt = now_s() - t0;
        if (dt < best) best = dt;
    }
    printf("json write hand %6.0f MB/s  (unchecked single-pass)\n",
           (double)w * K / best / 1e6);
    free(buf); free(out); free(hout);
    arena.destroy();
    return 0;
}

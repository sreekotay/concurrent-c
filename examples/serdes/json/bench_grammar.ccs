// Engine-generated JSON parser benchmark — every tier the @grammar engines
// project from ONE grammar: match (recognition), collect (closure fold),
// DOM (tape), and schema (direct-to-struct via composed narrowing).
// Run alongside the golden json.h and yyjson via ./bench.sh -g -y.
// Requires a built compiler: make -C ../../../cc
#include <ccc/cc_arena.cch>
#include <ccc/cc_grammar.cch>
#include <ccc/stdio.cch>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>
#include <ccc/std/json.cch>

@grammar(rules) Json {~~~~
    include JsonDom
~~~~}


@grammar(schema) Tweet {~~~~
    use Json
    Json.object [
        "id"   id:   int Json.number
        "text" text: Json.string
        "user" Json.object [ "screen_name" user_name: Json.string ]
    ]
~~~~}

@grammar(schema) Feed {~~~~
    use Json
    Json.ws
    Json.object [ "statuses" statuses: Json.array of Tweet ]
    Json.ws
~~~~}

static double now_s(void){struct timespec t;clock_gettime(CLOCK_MONOTONIC,&t);return t.tv_sec+t.tv_nsec/1e9;}
static long g_bytes; static long g_keeps;
static int cb(void* env, int id, CCSlice v){ (void)env;(void)id; g_keeps++; g_bytes += (long)v.len; return 0; }

int main(int argc, char** argv) {
    CCArena pa = cc_arena_create(kilobytes(4));
    @errhandler(CCError e) { cc_error_log(e); return 1; }

    const char* fn = argc > 1 ? argv[1] : "twitter.json";
    int K = argc > 2 ? atoi(argv[2]) : 100, T = argc > 3 ? atoi(argv[3]) : 3;
    FILE* f = fopen(fn, "rb");
    if (!f) { eprintln(@string(`cannot open ${fn}`, pa)) !>; return 1; }
    fseek(f, 0, SEEK_END); long n = ftell(f); fseek(f, 0, SEEK_SET);
    char* b = (char*)malloc((size_t)n + 1);
    size_t rd = fread(b, 1, (size_t)n, f); b[rd] = 0; fclose(f);
    CCArena ar = cc_arena_create((size_t)n * 4 + (16 << 20));

    double best = 1e18;
    for (int t = 0; t < T; t++) { double t0 = now_s();
        for (int i = 0; i < K; i++) if (!Json_match(b, rd)) { eprintln("match FAIL") !>; return 1; }
        double dt = now_s() - t0; if (dt < best) best = dt; }
    println(@string(`${fn} gen match    ${n*(double)K/best/1e6} MB/s  ${best/K*1e6} us/parse`, pa)) !>;

    best = 1e18;
    for (int t = 0; t < T; t++) { double t0 = now_s();
        for (int i = 0; i < K; i++) { g_keeps = 0; g_bytes = 0; ar.reset();
            if (!Json_collect(b, rd, ar, cb, 0)) { eprintln("collect FAIL") !>; return 1; } }
        double dt = now_s() - t0; if (dt < best) best = dt; }
    println(@string(`${fn} gen collect  ${n*(double)K/best/1e6} MB/s  ${best/K*1e6} us/parse  (keeps=${g_keeps} bytes=${g_bytes})`, pa)) !>;
    best = 1e18;
    for (int t = 0; t < T; t++) { double t0 = now_s();
        for (int i = 0; i < K; i++) { ar.reset();
            if (!Json_parse(b, rd, ar)) { eprintln("dom FAIL") !>; return 1; } }
        double dt = now_s() - t0; if (dt < best) best = dt; }
    println(@string(`${fn} gen DOM      ${n*(double)K/best/1e6} MB/s  ${best/K*1e6} us/parse`, pa)) !>;

    /* the schema tier is twitter-shaped ({"statuses":[...]}); skip corpora
     * it doesn't model rather than failing the whole run */
    { Feed probe; ar.reset();
      if (!Feed_parse(b, rd, ar, &probe)) {
          println(@string(`${fn} gen schema     (skipped: corpus is not Feed-shaped)`, pa)) !>;
          return 0;
      } }
    best = 1e18;
    { size_t sn = 0; unsigned long long tl = 0;
    for (int t = 0; t < T; t++) { double t0 = now_s();
        for (int i = 0; i < K; i++) { ar.reset();
            Feed fd;
            if (!Feed_parse(b, rd, ar, &fd)) { eprintln("schema FAIL") !>; return 1; }
            sn = fd.statuses_n; tl = 0;
            for (size_t j = 0; j < fd.statuses_n; j++) tl += fd.statuses[j].text.len; }
        double dt = now_s() - t0; if (dt < best) best = dt; }
    println(@string(`${fn} gen schema   ${n*(double)K/best/1e6} MB/s  ${best/K*1e6} us/parse  (statuses=${sn} textbytes=${tl})`, pa)) !>; }

    return 0;
}

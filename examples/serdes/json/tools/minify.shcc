#!/usr/bin/env -S ./cc/bin/ccc
#include <stdio.h>
/*
 * Twin of minify.py: strip structural JSON whitespace, preserve string bytes.
 *
 * Usage:  ./minify.shcc < twitter.json > twitter_min.json
 *         (or: ccc minify.shcc < ...)
 * Side-by-side with: examples/serdes/json/tools/minify.py
 * Suite: tests/script_minify_smoke.shcc (symlink) + .stdin/.stdout
 */
char[:] in = stdin.read_all(arena) !>;
@auto(in) out(arena) @destroy;
bool instr = false, esc = false;
@for (ch in in) {
    if (instr) {
        out.push(ch);
        if (esc) esc = false;
        else if (ch == '\\') esc = true;
        else if (ch == '"') instr = false;
    } else {
        if (ch == ' ' || ch == '\t' || ch == '\n' || ch == '\r')
            continue;
        out.push(ch);
        if (ch == '"') instr = true;
    }
}
println(out.as_slice()) !>;
/* prelude + synthetic-main predecls (arena/stdin); default @errhandler */

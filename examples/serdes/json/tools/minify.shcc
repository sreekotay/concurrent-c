#!/usr/bin/env -S ./cc/bin/ccc
/*
 * Twin of minify.py: strip structural JSON whitespace, preserve string bytes.
 *
 * Usage:  ./minify.shcc < twitter.json > twitter_min.json
 *         (or: ccc minify.shcc < ...)
 * Side-by-side with: examples/serdes/json/tools/minify.py
 */

/* prelude auto-included; default @errhandler */

/* Initial capacity only — arena grows on overflow by default. */
CCArena a = @create(megabytes(1)) @destroy;
CCStdio io = @create(&a) @destroy;

char[:] in = io.read_all() !>;

CCVec::[char] out = cc_vec_new::[char](&a);
bool instr = false;
bool esc = false;

for (size_t i = 0; i < in.len; i++) {
    char ch = in.ptr[i];
    if (instr) {
        out.push(ch);
        if (esc) esc = false;
        else if (ch == '\\') esc = true;
        else if (ch == '"') instr = false;
    } else {
        if (ch == ' ' || ch == '\t' || ch == '\n' || ch == '\r')
            continue;
        out.push(ch);
        if (ch == '"') instr = true;
    }
}

io.write_all(out.as_slice()) !>;

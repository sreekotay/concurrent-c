#!/usr/bin/env -S ./cc/bin/ccc
/*
 * Twin of minify.py: strip structural JSON whitespace, preserve string bytes.
 *
 * Usage:  ./minify.shcc < twitter.json > twitter_min.json
 *         (or: ccc minify.shcc < ...)
 * Side-by-side with: examples/serdes/json/tools/minify.py
 * Suite: tests/script_minify_smoke.shcc (symlink) + .stdin/.stdout
 */

/* prelude + synthetic-main predecls (a/io/in); default @errhandler */

Vec::[char] out@(&a) @destroy;
bool instr = false;
bool esc = false;

for (size_t i = 0; i < in.len; i++) {
    char ch = in.ptr[i];
    if (instr) {
        out.push(ch);
        if (esc) esc = false;
        else if (ch == '\\') esc = true;
        else if (ch == '"') instr = false;
    } else {
        if (ch == ' ' || ch == '\t' || ch == '\n' || ch == '\r')
            continue;
        out.push(ch);
        if (ch == '"') instr = true;
    }
}

io.write_all(out.as_slice()) !>;

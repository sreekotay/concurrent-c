/* Umbrella: 2-stage SERDES front + shadow lower/emit (C and H products).
 *
 *   pp_tape.cch   — stage 1: FileTape cache + file:line diags
 *   pp_stage2.cch — stage 2: splice / macros / guards / angle passthrough
 *   pp_lower.cch  — parse (pp_ast) + emit (pp_emit)
 *
 * Requires @grammar(rules) PpTok in the including TU.
 * Local-header `@comptime { static_map(...) }` is harvested into the TU by
 * the compiler (cc_harvest_local_header_comptime_blocks). See README.md. */
#pragma once
#include <ccc/std/static_map.cch>
#include "pp_tape.cch"
#include "pp_stage2.cch"
#include "pp_lower.cch"

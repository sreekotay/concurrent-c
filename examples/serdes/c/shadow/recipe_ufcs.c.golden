#include <stddef.h>
/*
 * Recipe: every form of UFCS
 *
 * The sections below are NOT ten things to learn. UFCS is ONE rule:
 *
 *     recv.method(args) calls the function the receiver's TYPE names,
 *     and DECLARING that function IS installing the method.
 *
 * Everything else is spelling. Generic instances name members
 * <Instance>_<method>; runtime families name them cc_<type>_<method>;
 * a bare declared function whose first parameter takes the receiver
 * needs no naming convention at all — declare the natural name and
 * prefix is plain C while postfix is the method. Handles you import
 * carry whole families (io.println). And when a hop can fail, `!>` /
 * `?>` is the link: unwrap (or substitute), then the next method
 * dispatches on the value.
 *
 * There is no registration step anywhere in this file. Same pedagogy as
 * recipe_unwrap_destroy_forms.ccs: frame the grammar, then show products.
 *
 *    1. Family members       v.push(x)
 *    2. Instance extension   v.median()          declare CCVec_double_median
 *    3. Scalar family        d.halve()           declare cc_double_halve
 *    4. Print names, handles println(x)         prefer naked at line start
 *    5. Bare-name tier       u.mean(6.0)         any fn whose 1st param fits
 *    6. System headers       d.fabs()            math.h, nothing local
 *    7. Chains               d.halve().twice()
 *    8. Typed slices         ps.at(1).y
 *    9. Fallible chains      get(21)!>.twice()    unwrap / ?> then dispatch
 *
 * Unknown methods fail with the receiver type and its installed set
 * (tests/ufcs_vec_member_miss_fail) — not shown here because they do not compile.
 */

#include <ccc/cc_runtime.h>

/* Whitelist AST + parser for the SERDES shadow front.
 * Requires pp_tape.cch + pp_stage2.cch + <ccc/std/static_map.cch>.
 * Nested stmt lists use AstNode.body[] so they do not interleave with a
 * parent's kids_storage (see AST_NURSERY_DESTROY / AST_SPAWN_CLOSURE). */
#pragma once

/* ---- closed parse keywords (comptime perfect hash) ---------------------- */

typedef enum {
    SHADOW_KW_NONE = 0,
    SHADOW_KW_INT,
    SHADOW_KW_VOID,
    SHADOW_KW_RETURN,
    SHADOW_KW_TYPEDEF,
    SHADOW_KW_STRUCT,
    SHADOW_KW_PRINTLN,
    SHADOW_KW_ERRHANDLER,
    SHADOW_KW_DESTROY,
    SHADOW_KW_SPAWN,
    SHADOW_KW_ERR,
    SHADOW_KW_IF,
    SHADOW_KW_STRING,
    SHADOW_KW_DEFER,
        SHADOW_KW_STATIC,
    SHADOW_KW_CHAR,
    SHADOW_KW_FOR
} ShadowKwKind;

typedef struct {
    ShadowKwKind kind;
} ShadowKwSpec;

typedef struct {
    const char* key;
    ShadowKwSpec value;
} ShadowKwEntry;

@comptime {
    ShadowKwEntry shadow_kw_entries[] = {
        { "int", { SHADOW_KW_INT } },
        { "void", { SHADOW_KW_VOID } },
        { "return", { SHADOW_KW_RETURN } },
        { "typedef", { SHADOW_KW_TYPEDEF } },
        { "struct", { SHADOW_KW_STRUCT } },
        { "println", { SHADOW_KW_PRINTLN } },
        { "errhandler", { SHADOW_KW_ERRHANDLER } },
        { "destroy", { SHADOW_KW_DESTROY } },
        { "spawn", { SHADOW_KW_SPAWN } },
        { "err", { SHADOW_KW_ERR } },
        { "if", { SHADOW_KW_IF } },
        { "string", { SHADOW_KW_STRING } },
        { "defer", { SHADOW_KW_DEFER } },
        { "static", { SHADOW_KW_STATIC } },
        { "char", { SHADOW_KW_CHAR } },
        { "for", { SHADOW_KW_FOR } },
    };
    static_map("shadow_kw", shadow_kw_entries, CC_STATIC_MAP_CASE_SENSITIVE);
}

/* Forward decl for in-header callers; body is TU-spliced from the map above. */
static const ShadowKwSpec* shadow_kw_get(CCSlice key);

static ShadowKwKind shadow_kw(Token t) {
    if (t.kind != TK_IDENT) return SHADOW_KW_NONE;
    const ShadowKwSpec* s = shadow_kw_get(t.spell);
    return s ? s->kind : SHADOW_KW_NONE;
}

/* ---- typedef scopes + tiny AST ------------------------------------------ */

enum { SCOPE_CAP = 32, NAME_CAP = 64, AST_CAP = 256 };

typedef struct {
    char names[NAME_CAP][128];
    int n;
} Scope;

typedef enum {
    AST_TYPEDEF_INT,   /* typedef int Name; */
    AST_VAR_INT,       /* int Name; */
    AST_PTR_DECL,      /* TypeName * Name; */
    AST_MUL_EXPR,      /* Ident * Ident;  (expression statement) */
    AST_STRUCT,        /* struct Name { ...fields... } */
    AST_FIELD_INT,     /* int Name; inside struct */
    /* Concurrent-C surface (post-expand; stage 1 kept digraphs intact) */
    AST_SLICE_VAR,     /* int[:] Name; */
    /* CHAN_VAR: a=name b=capacity c=">"|"<" (direction) */
    AST_CHAN_VAR,
    /* RESULT_FN: a=fname, b=err, c=ok, d=param text or "" for void; kids=body */
    AST_RESULT_FN,
    AST_CLOSURE_LIT,   /* () => { }   (expression-level; counted as external) */
    AST_AT_STMT,       /* @ident ... ;  (a = attr name, e.g. defer/async) */
    AST_FN,            /* int Name(void) { stmts } — a=name, kids=stmts */
    AST_RETURN_INT,    /* return N; — a=literal */
    /* return cc_ok|cc_err(...); — a="ok"|"err", b=args text (inside parens) */
    AST_RETURN_CC,
    /* return <expr>; — a=expr text (ternary / NULL / ident) */
    AST_RETURN_EXPR,
    AST_ERRHANDLER,    /* @errhandler(Type bind) …; a=type b=bind c=handler or ""+body */
    AST_PRINTLN_BANG,  /* println("...") !>; — a=string spell including quotes */
    /* println("...") !>(bind) { stmts }; — a=string b=bind, body=handler stmts */
    AST_PRINTLN_BANG_BIND,
    /* println(@string(`tpl`, @scratch)) !>; — a=tpl body without ticks */
    AST_PRINTLN_TPL,
    AST_ERR_FWD,       /* @err(bind); — a=bind name; emits handler(bind) */
    /* Type * name = callee(NULL) !> @destroy { stmts }; — a=type b=name c=callee */
    AST_NURSERY_DESTROY,
    /* recv->spawn(() => { stmts }); — a=recv b=method("spawn") d=closure id */
    AST_SPAWN_CLOSURE,
    /* Ident ( NUM ) ; — e.g. usleep(100000); a=callee b=literal */
    AST_CALL_NUM,
    /* Ident ( args ) ; — a=callee b=args text */
    AST_CALL_ARGS,
    /* if (cond) stmt — a=cond text, body[0]=stmt */
    AST_IF,
    /* { stmts } — body=stmts */
    AST_BLOCK,
    /* int name = call(...) !>|?> …; a=name b=call c=mode d=bind e=default */
    AST_VAR_UNWRAP,
    /* Type * name = call(...); — a=type b=name c=call */
    AST_PTR_INIT,
    /* call(...) !>; — a=call text */
    AST_STMT_UNWRAP,
    /* Ok!>(Err) name = call(...); — a=name b=err c=ok d=call */
    AST_RESULT_LOCAL,
    /* @defer[(ok|err)] stmt — c=""|"ok"|"err", body=stmts */
    AST_DEFER,
    /* Type* name = call !>|?> … [@destroy]; a=type b=name c=call d=mode e=bind/default
     * mode: bang_nobind|bang_block|bang_eh|qmark[+_D|_Dbare]
     * body=handler; dbody=destroy body (if _D) — not kids_storage (fn mid-append) */
    AST_PTR_UNWRAP,
    /* (void)ident; — a=ident */
    AST_VOID_CAST,
    /* static Type* name(params) { stmts } — a=ret type b=name c=params; kids=stmts */
    AST_STATIC_FN,
    /* static char name[] = "lit"; — a=name b=string lit incl quotes */
    AST_STATIC_ARR,
    /* Type name = expr @destroy; — a=type b=name c=init (bare destroy) */
    AST_VAL_DESTROY,
    /* for (hdr) { stmts } — a=hdr text, body=stmts */
    AST_FOR,
    /* Type[*] name = expr; — a=type b=name c=expr d="*"|"", UFCS rewritten on emit */
    AST_TYPED_INIT,
    /* recv.method(args); — a=recv b=method c=args */
    AST_UFCS_STMT,
    /* lhs = rhs; — a=lhs b=rhs */
    AST_ASSIGN
} AstKind;

typedef struct AstNode AstNode;
struct AstNode {
    AstKind kind;
    char a[256];
    char b[256];
    char c[256];
    char d[256];
    char e[256];
    AstNode** kids;
    int nkids;
    /* Nested stmt lists that must not interleave with a parent's kids_storage
     * (e.g. @destroy body while still appending to a function's stmt list). */
    AstNode* body[8];
    int nbody;
    AstNode* dbody[8];
    int ndbody;
};

typedef struct {
    Token* toks;
    int n;
    int i;
    TapeCache* cache; /* for file:line diagnostics */
    Scope scopes[SCOPE_CAP];
    int ns;
    AstNode nodes[AST_CAP];
    int nn;
    AstNode* kids_storage[AST_CAP * 4];
    int nkstore;
    AstNode* tu_items[AST_CAP];
    int ntu;
    int err;
    char err_msg[128];
} Parser;

static void parser_fail(Parser* p, Token at, const char* msg) {
    p->err = 1;
    snprintf(p->err_msg, sizeof(p->err_msg), "%s", msg);
    diag_at(p->cache, at, msg);
}

static void scope_push(Parser* p) {
    if (p->ns >= SCOPE_CAP) { p->err = 1; return; }
    p->scopes[p->ns++] = (Scope){0};
}

static void scope_pop(Parser* p) {
    if (p->ns > 0) p->ns--;
}

static int scope_is_typedef(Parser* p, CCSlice name) {
    for (int s = p->ns - 1; s >= 0; s--) {
        Scope* sc = &p->scopes[s];
        for (int i = 0; i < sc->n; i++) {
            if (spell_eq(name, sc->names[i])) return 1;
        }
    }
    return 0;
}

static int scope_add_typedef(Parser* p, CCSlice name) {
    if (p->ns == 0) scope_push(p);
    Scope* sc = &p->scopes[p->ns - 1];
    if (sc->n >= NAME_CAP || name.len >= 128) return 0;
    memcpy(sc->names[sc->n], name.ptr, name.len);
    sc->names[sc->n][name.len] = 0;
    sc->n++;
    return 1;
}

static void slice_to(char* dst, size_t cap, CCSlice s) {
    size_t n = s.len < cap - 1 ? s.len : cap - 1;
    memcpy(dst, s.ptr, n);
    dst[n] = 0;
}

/* Exact source span covering toks[i0 .. i1_excl). */
static int span_text(Parser* p, int i0, int i1_excl, char* dst, size_t cap) {
    if (!dst || cap == 0) return 0;
    dst[0] = 0;
    if (i0 < 0 || i1_excl > p->n || i0 >= i1_excl) return 1;
    Token a = p->toks[i0];
    Token b = p->toks[i1_excl - 1];
    size_t start = a.offset;
    size_t end = b.offset + b.spell.len;
    FileTape* ft = tape_by_id(p->cache, a.file_id);
    if (ft && ft->bytes && end <= ft->len && end >= start) {
        size_t n = end - start;
        if (n >= cap) n = cap - 1;
        memcpy(dst, ft->bytes + start, n);
        dst[n] = 0;
        return 1;
    }
    size_t o = 0;
    for (int i = i0; i < i1_excl && o + 1 < (int)cap; i++) {
        if (i > i0 && o + 1 < cap) dst[o++] = ' ';
        size_t ln = p->toks[i].spell.len;
        if (o + ln >= cap) ln = cap - 1 - o;
        memcpy(dst + o, p->toks[i].spell.ptr, ln);
        o += ln;
    }
    dst[o] = 0;
    return 1;
}

static Token p_peek(Parser* p) {
    if (p->i >= p->n) return (Token){ .kind = TK_EOF };
    return p->toks[p->i];
}

static Token p_next(Parser* p) {
    if (p->i >= p->n) return (Token){ .kind = TK_EOF };
    return p->toks[p->i++];
}

static int p_accept(Parser* p, TokKind k, const char* lit) {
    Token t = p_peek(p);
    if (!tok_eq(t, k, lit)) return 0;
    p_next(p);
    return 1;
}

/* Skip a `(...)` starting at p->i on `(`. Returns 1 and leaves i past `)`. */
static int skip_parens(Parser* p) {
    if (!tok_eq(p_peek(p), TK_PUNCT, "(")) return 0;
    int depth = 0;
    while (p->i < p->n) {
        Token t = p_next(p);
        if (tok_eq(t, TK_PUNCT, "(")) depth++;
        else if (tok_eq(t, TK_PUNCT, ")")) {
            depth--;
            if (depth == 0) return 1;
        }
    }
    return 0;
}

static AstNode* ast_new(Parser* p, AstKind k) {
    if (p->nn >= AST_CAP) { p->err = 1; return NULL; }
    AstNode* n = &p->nodes[p->nn++];
    memset(n, 0, sizeof(*n));
    n->kind = k;
    return n;
}

static int parse_struct_fields(Parser* p, AstNode* st);
static AstNode* parse_external(Parser* p);
static AstNode* parse_stmt(Parser* p);
static AstNode* parse_at_stmt(Parser* p);

/* Peek type prefix "int" then optional CC shape before a name. */
static int peek_int_base(Parser* p) { return shadow_kw(p_peek(p)) == SHADOW_KW_INT; }

static int peek_result_shape(Parser* p) {
    return p->i + 1 < p->n &&
           p->toks[p->i].kind == TK_IDENT &&
           tok_eq(p->toks[p->i + 1], TK_PUNCT, "!>");
}

/* int[:] Name ; */
static AstNode* parse_slice_var(Parser* p) {
    if (!peek_int_base(p)) return NULL;
    if (p->i + 5 >= p->n) return NULL;
    if (!tok_eq(p->toks[p->i + 1], TK_PUNCT, "[") ||
        !tok_eq(p->toks[p->i + 2], TK_PUNCT, ":") ||
        !tok_eq(p->toks[p->i + 3], TK_PUNCT, "]"))
        return NULL;
    p_next(p); p_next(p); p_next(p); p_next(p);
    Token name = p_next(p);
    if (name.kind != TK_IDENT) { p->err = 1; return NULL; }
    if (!p_accept(p, TK_PUNCT, ";")) { p->err = 1; return NULL; }
    AstNode* n = ast_new(p, AST_SLICE_VAR);
    if (!n) return NULL;
    slice_to(n->a, sizeof(n->a), name.spell);
    return n;
}

/* int[~N >] Name ;  or  int[~N <] Name ; */
static AstNode* parse_chan_var(Parser* p) {
    if (!peek_int_base(p)) return NULL;
    if (p->i + 7 >= p->n) return NULL;
    if (!tok_eq(p->toks[p->i + 1], TK_PUNCT, "[") ||
        !tok_eq(p->toks[p->i + 2], TK_PUNCT, "~") ||
        p->toks[p->i + 3].kind != TK_NUM)
        return NULL;
    Token dir = p->toks[p->i + 4];
    if (!tok_eq(dir, TK_PUNCT, ">") && !tok_eq(dir, TK_PUNCT, "<")) return NULL;
    if (!tok_eq(p->toks[p->i + 5], TK_PUNCT, "]")) return NULL;
    p_next(p); p_next(p); p_next(p);
    Token cap = p_next(p);
    Token dtok = p_next(p); /* > or < */
    p_next(p); /* ] */
    Token name = p_next(p);
    if (name.kind != TK_IDENT) { p->err = 1; return NULL; }
    if (!p_accept(p, TK_PUNCT, ";")) { p->err = 1; return NULL; }
    AstNode* n = ast_new(p, AST_CHAN_VAR);
    if (!n) return NULL;
    slice_to(n->a, sizeof(n->a), name.spell);
    slice_to(n->b, sizeof(n->b), cap.spell);
    slice_to(n->c, sizeof(n->c), dtok.spell);
    return n;
}

/* Ok!>Err or Ok!>(Err) Name ( params ) ;|{ body } */
static AstNode* parse_result_fn(Parser* p) {
    if (!peek_result_shape(p)) return NULL;
    if (p->i + 6 >= p->n) return NULL;
    Token ok = p_next(p);
    p_next(p); /* !> */
    Token err;
    if (tok_eq(p_peek(p), TK_PUNCT, "(")) {
        p_next(p);
        err = p_next(p);
        if (err.kind != TK_IDENT) {
            parser_fail(p, err, "expected error type inside !>(...)");
            return NULL;
        }
        if (!p_accept(p, TK_PUNCT, ")")) {
            parser_fail(p, p_peek(p), "expected ')' after error type");
            return NULL;
        }
    } else {
        err = p_next(p);
        if (err.kind != TK_IDENT) {
            parser_fail(p, err, "expected error type after !>");
            return NULL;
        }
    }
    Token name = p_next(p);
    if (name.kind != TK_IDENT) {
        parser_fail(p, name, "expected function name after result type");
        return NULL;
    }
    if (!p_accept(p, TK_PUNCT, "(")) { parser_fail(p, p_peek(p), "expected '('"); return NULL; }
    char param_ty[256] = {0};
    if (shadow_kw(p_peek(p)) == SHADOW_KW_VOID) {
        p_next(p);
    } else if (p_peek(p).kind != TK_PUNCT || !tok_eq(p_peek(p), TK_PUNCT, ")")) {
        int p0 = p->i;
        int depth = 1; /* already inside params `(` */
        int save = p->i;
        (void)save;
        while (p->i < p->n && depth > 0) {
            Token t = p_peek(p);
            if (tok_eq(t, TK_PUNCT, "(")) depth++;
            else if (tok_eq(t, TK_PUNCT, ")")) {
                depth--;
                if (depth == 0) break;
            }
            p_next(p);
        }
        if (!span_text(p, p0, p->i, param_ty, sizeof(param_ty))) {
            parser_fail(p, p_peek(p), "result fn params too long for shadow beachhead");
            return NULL;
        }
    }
    if (!p_accept(p, TK_PUNCT, ")")) { parser_fail(p, p_peek(p), "expected ')'"); return NULL; }
    AstNode* n = ast_new(p, AST_RESULT_FN);
    if (!n) return NULL;
    slice_to(n->a, sizeof(n->a), name.spell);
    slice_to(n->b, sizeof(n->b), err.spell);
    slice_to(n->c, sizeof(n->c), ok.spell);
    snprintf(n->d, sizeof(n->d), "%s", param_ty);
    if (p_accept(p, TK_PUNCT, ";")) return n;
    if (!p_accept(p, TK_PUNCT, "{")) {
        parser_fail(p, p_peek(p), "expected ';' or '{' after result function header");
        return NULL;
    }
    n->kids = &p->kids_storage[p->nkstore];
    while (!tok_eq(p_peek(p), TK_PUNCT, "}") && p_peek(p).kind != TK_EOF && !p->err) {
        AstNode* s = parse_stmt(p);
        if (!s) return NULL;
        if (p->nkstore >= AST_CAP * 4) { p->err = 1; return NULL; }
        p->kids_storage[p->nkstore++] = s;
        n->nkids++;
    }
    if (!p_accept(p, TK_PUNCT, "}")) {
        parser_fail(p, p_peek(p), "expected '}' to close result function");
        return NULL;
    }
    return n;
}

/* @errhandler(Type bind) handler(bind);  OR  @errhandler(Type bind) { stmts } */
static AstNode* parse_errhandler(Parser* p) {
    if (!tok_eq(p_peek(p), TK_PUNCT, "@")) return NULL;
    if (p->i + 1 >= p->n || shadow_kw(p->toks[p->i + 1]) != SHADOW_KW_ERRHANDLER)
        return NULL;
    p_next(p); /* @ */
    p_next(p); /* errhandler */
    if (!p_accept(p, TK_PUNCT, "(")) {
        parser_fail(p, p_peek(p), "expected '(' after @errhandler");
        return NULL;
    }
    Token ty = p_next(p);
    Token bind = p_next(p);
    if (ty.kind != TK_IDENT || bind.kind != TK_IDENT) {
        parser_fail(p, ty, "expected @errhandler(Type name)");
        return NULL;
    }
    if (!p_accept(p, TK_PUNCT, ")")) {
        parser_fail(p, p_peek(p), "expected ')' after errhandler bind");
        return NULL;
    }
    AstNode* n = ast_new(p, AST_ERRHANDLER);
    if (!n) return NULL;
    slice_to(n->a, sizeof(n->a), ty.spell);
    slice_to(n->b, sizeof(n->b), bind.spell);
    if (tok_eq(p_peek(p), TK_PUNCT, "{")) {
        p_next(p);
        while (!tok_eq(p_peek(p), TK_PUNCT, "}") && p_peek(p).kind != TK_EOF && !p->err) {
            AstNode* st = parse_stmt(p);
            if (!st) return NULL;
            if (n->nbody >= 8) {
                parser_fail(p, p_peek(p), "@errhandler body too large for shadow beachhead");
                return NULL;
            }
            n->body[n->nbody++] = st;
        }
        if (!p_accept(p, TK_PUNCT, "}")) {
            parser_fail(p, p_peek(p), "expected '}' to close @errhandler");
            return NULL;
        }
        return n;
    }
    Token handler = p_next(p);
    if (handler.kind != TK_IDENT) {
        parser_fail(p, handler, "expected handler call or '{' after @errhandler(...)");
        return NULL;
    }
    if (!p_accept(p, TK_PUNCT, "(")) { p->err = 1; return NULL; }
    Token arg = p_next(p);
    char bind_name[128];
    slice_to(bind_name, sizeof(bind_name), bind.spell);
    if (arg.kind != TK_IDENT || !spell_eq(arg.spell, bind_name)) {
        parser_fail(p, arg, "errhandler call arg must match bind name");
        return NULL;
    }
    if (!p_accept(p, TK_PUNCT, ")") || !p_accept(p, TK_PUNCT, ";")) {
        p->err = 1;
        return NULL;
    }
    slice_to(n->c, sizeof(n->c), handler.spell);
    return n;
}

/* @err ( Ident ) ; */
static AstNode* parse_err_fwd(Parser* p) {
    if (!tok_eq(p_peek(p), TK_PUNCT, "@")) return NULL;
    if (p->i + 1 >= p->n || shadow_kw(p->toks[p->i + 1]) != SHADOW_KW_ERR)
        return NULL;
    p_next(p); /* @ */
    p_next(p); /* err */
    if (!p_accept(p, TK_PUNCT, "(")) {
        parser_fail(p, p_peek(p), "expected '(' after @err");
        return NULL;
    }
    Token bind = p_next(p);
    if (bind.kind != TK_IDENT) {
        parser_fail(p, bind, "expected bind name in @err(...)");
        return NULL;
    }
    if (!p_accept(p, TK_PUNCT, ")") || !p_accept(p, TK_PUNCT, ";")) {
        p->err = 1;
        return NULL;
    }
    AstNode* n = ast_new(p, AST_ERR_FWD);
    if (!n) return NULL;
    slice_to(n->a, sizeof(n->a), bind.spell);
    return n;
}

/* @ string ( `tpl` , @ scratch ) — leaves tpl body (no ticks) in dst. */
static int parse_at_string_scratch(Parser* p, char* dst, size_t cap) {
    if (!tok_eq(p_peek(p), TK_PUNCT, "@")) return 0;
    if (p->i + 1 >= p->n || shadow_kw(p->toks[p->i + 1]) != SHADOW_KW_STRING) return 0;
    p_next(p); /* @ */
    p_next(p); /* string */
    if (!p_accept(p, TK_PUNCT, "(")) {
        parser_fail(p, p_peek(p), "expected '(' after @string");
        return 0;
    }
    Token bt = p_next(p);
    if (bt.kind != TK_STR || !bt.spell.ptr || bt.spell.len < 2 || bt.spell.ptr[0] != '`') {
        parser_fail(p, bt, "expected backtick template in @string(...)");
        return 0;
    }
    if (!p_accept(p, TK_PUNCT, ",")) {
        parser_fail(p, p_peek(p), "expected ',' after @string template");
        return 0;
    }
    if (!p_accept(p, TK_PUNCT, "@")) {
        parser_fail(p, p_peek(p), "expected @scratch after @string template");
        return 0;
    }
    Token scratch = p_next(p);
    if (scratch.kind != TK_IDENT || !spell_eq(scratch.spell, "scratch")) {
        parser_fail(p, scratch, "expected @scratch");
        return 0;
    }
    if (!p_accept(p, TK_PUNCT, ")")) {
        parser_fail(p, p_peek(p), "expected ')' after @string(..., @scratch)");
        return 0;
    }
    /* strip ticks */
    size_t n = bt.spell.len >= 2 ? bt.spell.len - 2 : 0;
    if (n >= cap) n = cap - 1;
    memcpy(dst, bt.spell.ptr + 1, n);
    dst[n] = 0;
    return 1;
}

/* println ( STR | @string(...) ) !> ;  OR  println ( STR ) !> ( Ident ) { stmts } ; */
static AstNode* parse_println_bang(Parser* p) {
    if (shadow_kw(p_peek(p)) != SHADOW_KW_PRINTLN) return NULL;
    p_next(p);
    if (!p_accept(p, TK_PUNCT, "(")) {
        parser_fail(p, p_peek(p), "expected '(' after println");
        return NULL;
    }
    int is_tpl = 0;
    char payload[256];
    payload[0] = 0;
    if (tok_eq(p_peek(p), TK_PUNCT, "@")) {
        if (!parse_at_string_scratch(p, payload, sizeof(payload))) return NULL;
        is_tpl = 1;
    } else {
        Token s = p_next(p);
        if (s.kind != TK_STR) {
            parser_fail(p, s, "expected string or @string(...) in println(...)");
            return NULL;
        }
        slice_to(payload, sizeof(payload), s.spell);
    }
    if (!p_accept(p, TK_PUNCT, ")")) {
        parser_fail(p, p_peek(p), "expected ')' after println arg");
        return NULL;
    }
    if (!p_accept(p, TK_PUNCT, "!>")) {
        parser_fail(p, p_peek(p), "expected '!>' after println(...)");
        return NULL;
    }
    /* Compose-then-default: !>(e) { ... } ; — string form only (hello beachhead) */
    if (tok_eq(p_peek(p), TK_PUNCT, "(")) {
        if (is_tpl) {
            parser_fail(p, p_peek(p), "println(@string) !>(e){...} not in shadow beachhead");
            return NULL;
        }
        p_next(p);
        Token bind = p_next(p);
        if (bind.kind != TK_IDENT) {
            parser_fail(p, bind, "expected bind name in !>(...)");
            return NULL;
        }
        if (!p_accept(p, TK_PUNCT, ")")) {
            parser_fail(p, p_peek(p), "expected ')' after !>(bind");
            return NULL;
        }
        if (!p_accept(p, TK_PUNCT, "{")) {
            parser_fail(p, p_peek(p), "expected '{' after !>(bind)");
            return NULL;
        }
        AstNode* n = ast_new(p, AST_PRINTLN_BANG_BIND);
        if (!n) return NULL;
        snprintf(n->a, sizeof(n->a), "%s", payload);
        slice_to(n->b, sizeof(n->b), bind.spell);
        while (!tok_eq(p_peek(p), TK_PUNCT, "}") && p_peek(p).kind != TK_EOF && !p->err) {
            AstNode* st = parse_stmt(p);
            if (!st) return NULL;
            if (n->nbody >= 8) {
                parser_fail(p, p_peek(p), "!>(...) body too large for shadow beachhead");
                return NULL;
            }
            n->body[n->nbody++] = st;
        }
        if (!p_accept(p, TK_PUNCT, "}")) {
            parser_fail(p, p_peek(p), "expected '}' to close !>(...) handler");
            return NULL;
        }
        if (!p_accept(p, TK_PUNCT, ";")) {
            parser_fail(p, p_peek(p), "expected ';' after !>(...) { ... }");
            return NULL;
        }
        return n;
    }
    if (!p_accept(p, TK_PUNCT, ";")) {
        parser_fail(p, p_peek(p), "expected ';' after println(...) !>");
        return NULL;
    }
    AstNode* n = ast_new(p, is_tpl ? AST_PRINTLN_TPL : AST_PRINTLN_BANG);
    if (!n) return NULL;
    snprintf(n->a, sizeof(n->a), "%s", payload);
    return n;
}

static AstNode* parse_return_int(Parser* p) {
    if (shadow_kw(p_peek(p)) != SHADOW_KW_RETURN) return NULL;
    p_next(p);
    Token t = p_peek(p);
    if (t.kind == TK_IDENT && (spell_eq(t.spell, "cc_ok") || spell_eq(t.spell, "cc_err"))) {
        Token which = p_next(p);
        if (!tok_eq(p_peek(p), TK_PUNCT, "(")) {
            parser_fail(p, p_peek(p), "expected '(' after cc_ok/cc_err");
            return NULL;
        }
        int a0 = p->i + 1; /* first tok inside parens */
        if (!skip_parens(p)) {
            parser_fail(p, p_peek(p), "unterminated cc_ok/cc_err(...)");
            return NULL;
        }
        int a1 = p->i - 1; /* index of `)` — args are a0 .. a1 */
        char args[256];
        if (a0 >= a1) args[0] = 0;
        else if (!span_text(p, a0, a1, args, sizeof(args))) {
            parser_fail(p, which, "cc_ok/cc_err args too long");
            return NULL;
        }
        if (!p_accept(p, TK_PUNCT, ";")) { p->err = 1; return NULL; }
        AstNode* n = ast_new(p, AST_RETURN_CC);
        if (!n) return NULL;
        snprintf(n->a, sizeof(n->a), "%s", spell_eq(which.spell, "cc_ok") ? "ok" : "err");
        snprintf(n->b, sizeof(n->b), "%s", args);
        return n;
    }
    if (t.kind == TK_NUM && p->i + 1 < p->n && tok_eq(p->toks[p->i + 1], TK_PUNCT, ";")) {
        Token num = p_next(p);
        p_next(p); /* ; */
        AstNode* n = ast_new(p, AST_RETURN_INT);
        if (!n) return NULL;
        slice_to(n->a, sizeof(n->a), num.spell);
        return n;
    }
    /* General return expr (ternary, NULL, ident, …) */
    int e0 = p->i;
    int depth = 0;
    while (p->i < p->n) {
        Token x = p_peek(p);
        if (tok_eq(x, TK_PUNCT, "(") || tok_eq(x, TK_PUNCT, "[") || tok_eq(x, TK_PUNCT, "{"))
            depth++;
        else if (tok_eq(x, TK_PUNCT, ")") || tok_eq(x, TK_PUNCT, "]") || tok_eq(x, TK_PUNCT, "}"))
            depth--;
        else if (depth == 0 && tok_eq(x, TK_PUNCT, ";")) break;
        p_next(p);
    }
    AstNode* n = ast_new(p, AST_RETURN_EXPR);
    if (!n) return NULL;
    if (!span_text(p, e0, p->i, n->a, sizeof(n->a))) {
        parser_fail(p, p_peek(p), "return expr too long");
        return NULL;
    }
    if (!p_accept(p, TK_PUNCT, ";")) { p->err = 1; return NULL; }
    return n;
}

static AstNode* parse_block(Parser* p) {
    if (!tok_eq(p_peek(p), TK_PUNCT, "{")) return NULL;
    p_next(p);
    AstNode* n = ast_new(p, AST_BLOCK);
    if (!n) return NULL;
    while (!tok_eq(p_peek(p), TK_PUNCT, "}") && p_peek(p).kind != TK_EOF && !p->err) {
        AstNode* st = parse_stmt(p);
        if (!st) return NULL;
        if (n->nbody >= 8) {
            parser_fail(p, p_peek(p), "block too large for shadow beachhead");
            return NULL;
        }
        n->body[n->nbody++] = st;
    }
    if (!p_accept(p, TK_PUNCT, "}")) {
        parser_fail(p, p_peek(p), "expected '}' to close block");
        return NULL;
    }
    return n;
}

static AstNode* parse_if_stmt(Parser* p) {
    if (shadow_kw(p_peek(p)) != SHADOW_KW_IF) return NULL;
    p_next(p);
    if (!tok_eq(p_peek(p), TK_PUNCT, "(")) {
        parser_fail(p, p_peek(p), "expected '(' after if");
        return NULL;
    }
    int c0 = p->i + 1;
    if (!skip_parens(p)) {
        parser_fail(p, p_peek(p), "unterminated if (...)");
        return NULL;
    }
    int c1 = p->i - 1;
    AstNode* n = ast_new(p, AST_IF);
    if (!n) return NULL;
    if (c0 >= c1) n->a[0] = 0;
    else if (!span_text(p, c0, c1, n->a, sizeof(n->a))) {
        parser_fail(p, p_peek(p), "if condition too long");
        return NULL;
    }
    AstNode* body = tok_eq(p_peek(p), TK_PUNCT, "{") ? parse_block(p) : parse_stmt(p);
    if (!body) return NULL;
    n->body[0] = body;
    n->nbody = 1;
    return n;
}

/* @defer stmt;  |  @defer(ok|err) stmt;  |  @defer(ok|err) { stmts } */
static AstNode* parse_defer(Parser* p) {
    if (!tok_eq(p_peek(p), TK_PUNCT, "@")) return NULL;
    if (p->i + 1 >= p->n || shadow_kw(p->toks[p->i + 1]) != SHADOW_KW_DEFER)
        return NULL;
    p_next(p); /* @ */
    p_next(p); /* defer */
    AstNode* n = ast_new(p, AST_DEFER);
    if (!n) return NULL;
    if (tok_eq(p_peek(p), TK_PUNCT, "(")) {
        p_next(p);
        Token mode = p_next(p);
        if (mode.kind != TK_IDENT ||
            (!spell_eq(mode.spell, "ok") && !spell_eq(mode.spell, "err"))) {
            parser_fail(p, mode, "expected @defer(ok) or @defer(err)");
            return NULL;
        }
        slice_to(n->c, sizeof(n->c), mode.spell);
        if (!p_accept(p, TK_PUNCT, ")")) {
            parser_fail(p, p_peek(p), "expected ')' after @defer(mode");
            return NULL;
        }
    }
    if (tok_eq(p_peek(p), TK_PUNCT, "{")) {
        AstNode* blk = parse_block(p);
        if (!blk) return NULL;
        /* Flatten one block into defer body */
        for (int k = 0; k < blk->nbody; k++) {
            if (n->nbody >= 8) {
                parser_fail(p, p_peek(p), "@defer body too large");
                return NULL;
            }
            n->body[n->nbody++] = blk->body[k];
        }
        return n;
    }
    AstNode* st = parse_stmt(p);
    if (!st) return NULL;
    n->body[0] = st;
    n->nbody = 1;
    return n;
}

/* Type * name = call(...);  (not nursery @destroy) */
static AstNode* parse_ptr_init(Parser* p) {
    Token ty = p_peek(p);
    if (ty.kind != TK_IDENT) return NULL;
    if (p->i + 5 >= p->n) return NULL;
    if (!tok_eq(p->toks[p->i + 1], TK_PUNCT, "*")) return NULL;
    if (p->toks[p->i + 2].kind != TK_IDENT) return NULL;
    if (!tok_eq(p->toks[p->i + 3], TK_PUNCT, "=")) return NULL;
    /* Nursery form takes precedence */
    {
        int j = p->i + 4;
        int depth = 0;
        while (j < p->n) {
            Token t = p->toks[j];
            if (tok_eq(t, TK_PUNCT, "(")) depth++;
            else if (tok_eq(t, TK_PUNCT, ")")) depth--;
            else if (depth == 0 && tok_eq(t, TK_PUNCT, "!>")) return NULL;
            else if (depth == 0 && tok_eq(t, TK_PUNCT, ";")) break;
            j++;
        }
    }
    p_next(p); /* type */
    p_next(p); /* * */
    Token name = p_next(p);
    p_next(p); /* = */
    int c0 = p->i;
    int depth = 0;
    while (p->i < p->n) {
        Token t = p_peek(p);
        if (tok_eq(t, TK_PUNCT, "(") || tok_eq(t, TK_PUNCT, "[")) depth++;
        else if (tok_eq(t, TK_PUNCT, ")") || tok_eq(t, TK_PUNCT, "]")) depth--;
        else if (depth == 0 && tok_eq(t, TK_PUNCT, ";")) break;
        p_next(p);
    }
    AstNode* n = ast_new(p, AST_PTR_INIT);
    if (!n) return NULL;
    slice_to(n->a, sizeof(n->a), ty.spell);
    slice_to(n->b, sizeof(n->b), name.spell);
    if (!span_text(p, c0, p->i, n->c, sizeof(n->c))) {
        parser_fail(p, name, "ptr init expr too long");
        return NULL;
    }
    if (!p_accept(p, TK_PUNCT, ";")) {
        parser_fail(p, p_peek(p), "expected ';' after ptr init");
        return NULL;
    }
    return n;
}

/* call(...) !>; */
static AstNode* parse_stmt_unwrap(Parser* p) {
    Token callee = p_peek(p);
    if (callee.kind != TK_IDENT) return NULL;
    if (p->i + 2 >= p->n || !tok_eq(p->toks[p->i + 1], TK_PUNCT, "(")) return NULL;
    int j = p->i + 1;
    int depth = 0;
    while (j < p->n) {
        Token t = p->toks[j];
        if (tok_eq(t, TK_PUNCT, "(")) depth++;
        else if (tok_eq(t, TK_PUNCT, ")")) {
            depth--;
            if (depth == 0) { j++; break; }
        }
        j++;
    }
    if (j >= p->n || !tok_eq(p->toks[j], TK_PUNCT, "!>")) return NULL;
    if (j + 1 >= p->n || !tok_eq(p->toks[j + 1], TK_PUNCT, ";")) return NULL;

    int c0 = p->i;
    while (p->i < j) p_next(p); /* through ')' */
    char call[256];
    if (!span_text(p, c0, j, call, sizeof(call))) {
        parser_fail(p, callee, "unwrap call too long");
        return NULL;
    }
    p_next(p); /* !> */
    p_next(p); /* ; */
    AstNode* n = ast_new(p, AST_STMT_UNWRAP);
    if (!n) return NULL;
    snprintf(n->a, sizeof(n->a), "%s", call);
    return n;
}

/* Ok!>(Err) name = call(...); */
static AstNode* parse_result_local(Parser* p) {
    if (!peek_result_shape(p)) return NULL;
    if (p->i + 6 >= p->n) return NULL;
    /* Must be `Ok !> Err name =` not a function */
    int j = p->i + 2; /* after Ok !> */
    if (tok_eq(p->toks[j], TK_PUNCT, "(")) {
        j++;
        if (j >= p->n || p->toks[j].kind != TK_IDENT) return NULL;
        j++;
        if (j >= p->n || !tok_eq(p->toks[j], TK_PUNCT, ")")) return NULL;
        j++;
    } else {
        if (j >= p->n || p->toks[j].kind != TK_IDENT) return NULL;
        j++;
    }
    if (j + 1 >= p->n || p->toks[j].kind != TK_IDENT) return NULL;
    if (!tok_eq(p->toks[j + 1], TK_PUNCT, "=")) return NULL;

    Token ok = p_next(p);
    p_next(p); /* !> */
    Token err;
    if (tok_eq(p_peek(p), TK_PUNCT, "(")) {
        p_next(p);
        err = p_next(p);
        p_next(p); /* ) */
    } else {
        err = p_next(p);
    }
    Token name = p_next(p);
    p_next(p); /* = */
    int c0 = p->i;
    int depth = 0;
    while (p->i < p->n) {
        Token t = p_peek(p);
        if (tok_eq(t, TK_PUNCT, "(")) depth++;
        else if (tok_eq(t, TK_PUNCT, ")")) depth--;
        else if (depth == 0 && tok_eq(t, TK_PUNCT, ";")) break;
        p_next(p);
    }
    AstNode* n = ast_new(p, AST_RESULT_LOCAL);
    if (!n) return NULL;
    slice_to(n->a, sizeof(n->a), name.spell);
    slice_to(n->b, sizeof(n->b), err.spell);
    slice_to(n->c, sizeof(n->c), ok.spell);
    if (!span_text(p, c0, p->i, n->d, sizeof(n->d))) {
        parser_fail(p, name, "result local init too long");
        return NULL;
    }
    if (!p_accept(p, TK_PUNCT, ";")) {
        parser_fail(p, p_peek(p), "expected ';' after result local");
        return NULL;
    }
    return n;
}

/* int name = <call-expr> !>|?> … ; */
static AstNode* parse_var_unwrap(Parser* p) {
    if (shadow_kw(p_peek(p)) != SHADOW_KW_INT) return NULL;
    if (p->i + 4 >= p->n) return NULL;
    if (p->toks[p->i + 1].kind != TK_IDENT) return NULL;
    if (!tok_eq(p->toks[p->i + 2], TK_PUNCT, "=")) return NULL;
    /* Scan for !> or ?> at paren-depth 0 before ';' */
    int j = p->i + 3;
    int depth = 0;
    int op_at = -1;
    while (j < p->n) {
        Token t = p->toks[j];
        if (tok_eq(t, TK_PUNCT, "(") || tok_eq(t, TK_PUNCT, "{") || tok_eq(t, TK_PUNCT, "["))
            depth++;
        else if (tok_eq(t, TK_PUNCT, ")") || tok_eq(t, TK_PUNCT, "}") || tok_eq(t, TK_PUNCT, "]"))
            depth--;
        else if (depth == 0 && (tok_eq(t, TK_PUNCT, "!>") || tok_eq(t, TK_PUNCT, "?>"))) {
            op_at = j;
            break;
        } else if (depth == 0 && tok_eq(t, TK_PUNCT, ";")) {
            return NULL; /* plain init — not in beachhead */
        }
        j++;
    }
    if (op_at < 0) return NULL;

    p_next(p); /* int */
    Token vname = p_next(p);
    p_next(p); /* = */
    int call0 = p->i;
    while (p->i < op_at) p_next(p);
    char call[256];
    if (!span_text(p, call0, op_at, call, sizeof(call))) {
        parser_fail(p, vname, "unwrap call expr too long");
        return NULL;
    }
    Token op = p_next(p); /* !> or ?> */
    AstNode* n = ast_new(p, AST_VAR_UNWRAP);
    if (!n) return NULL;
    slice_to(n->a, sizeof(n->a), vname.spell);
    snprintf(n->b, sizeof(n->b), "%s", call);

    if (tok_eq(op, TK_PUNCT, "!>")) {
        if (p_accept(p, TK_PUNCT, ";")) {
            snprintf(n->c, sizeof(n->c), "bang");
            return n;
        }
        if (!p_accept(p, TK_PUNCT, "(")) {
            parser_fail(p, p_peek(p), "expected ';' or '(bind)' after !>");
            return NULL;
        }
        Token bind = p_next(p);
        if (bind.kind != TK_IDENT) {
            parser_fail(p, bind, "expected bind name");
            return NULL;
        }
        if (!p_accept(p, TK_PUNCT, ")")) {
            parser_fail(p, p_peek(p), "expected ')' after bind");
            return NULL;
        }
        slice_to(n->d, sizeof(n->d), bind.spell);
        if (tok_eq(p_peek(p), TK_PUNCT, "{")) {
            p_next(p);
            snprintf(n->c, sizeof(n->c), "bang_block");
            while (!tok_eq(p_peek(p), TK_PUNCT, "}") && p_peek(p).kind != TK_EOF && !p->err) {
                AstNode* st = parse_stmt(p);
                if (!st) return NULL;
                if (n->nbody >= 8) {
                    parser_fail(p, p_peek(p), "!>(...) body too large");
                    return NULL;
                }
                n->body[n->nbody++] = st;
            }
            if (!p_accept(p, TK_PUNCT, "}") || !p_accept(p, TK_PUNCT, ";")) {
                parser_fail(p, p_peek(p), "expected '};' after !>(...) { ... }");
                return NULL;
            }
            return n;
        }
        /* !>(e) stmt ; */
        snprintf(n->c, sizeof(n->c), "bang_stmt");
        AstNode* st = parse_stmt(p);
        if (!st) return NULL;
        n->body[0] = st;
        n->nbody = 1;
        return n;
    }

    /* ?> */
    if (tok_eq(p_peek(p), TK_PUNCT, "(")) {
        p_next(p);
        Token bind = p_next(p);
        if (bind.kind != TK_IDENT) {
            parser_fail(p, bind, "expected bind in ?>(...)");
            return NULL;
        }
        if (!p_accept(p, TK_PUNCT, ")")) {
            parser_fail(p, p_peek(p), "expected ')' after ?>(bind");
            return NULL;
        }
        slice_to(n->d, sizeof(n->d), bind.spell);
        snprintf(n->c, sizeof(n->c), "qmark_bind");
    } else {
        snprintf(n->c, sizeof(n->c), "qmark");
    }
    int d0 = p->i;
    depth = 0;
    while (p->i < p->n) {
        Token t = p_peek(p);
        if (tok_eq(t, TK_PUNCT, "(") || tok_eq(t, TK_PUNCT, "{") || tok_eq(t, TK_PUNCT, "["))
            depth++;
        else if (tok_eq(t, TK_PUNCT, ")") || tok_eq(t, TK_PUNCT, "}") || tok_eq(t, TK_PUNCT, "]"))
            depth--;
        else if (depth == 0 && tok_eq(t, TK_PUNCT, ";")) break;
        p_next(p);
    }
    if (!span_text(p, d0, p->i, n->e, sizeof(n->e))) {
        parser_fail(p, p_peek(p), "?> default expr too long");
        return NULL;
    }
    if (!p_accept(p, TK_PUNCT, ";")) {
        parser_fail(p, p_peek(p), "expected ';' after ?> default");
        return NULL;
    }
    return n;
}

/* Type * name = callee ( NULL ) !> @destroy { stmts } ; */
static AstNode* parse_nursery_destroy(Parser* p) {
    Token ty = p_peek(p);
    if (ty.kind != TK_IDENT) return NULL;
    if (p->i + 12 >= p->n) return NULL;
    if (!tok_eq(p->toks[p->i + 1], TK_PUNCT, "*")) return NULL;
    if (p->toks[p->i + 2].kind != TK_IDENT) return NULL;
    if (!tok_eq(p->toks[p->i + 3], TK_PUNCT, "=")) return NULL;
    if (p->toks[p->i + 4].kind != TK_IDENT) return NULL;
    if (!tok_eq(p->toks[p->i + 5], TK_PUNCT, "(")) return NULL;
    /* Find ) !> @ destroy { */
    int j = p->i + 6;
    if (j >= p->n || p->toks[j].kind != TK_IDENT) return NULL; /* NULL / arg */
    j++;
    if (j >= p->n || !tok_eq(p->toks[j], TK_PUNCT, ")")) return NULL;
    j++;
    if (j >= p->n || !tok_eq(p->toks[j], TK_PUNCT, "!>")) return NULL;
    j++;
    if (j >= p->n || !tok_eq(p->toks[j], TK_PUNCT, "@")) return NULL;
    j++;
    if (j >= p->n || shadow_kw(p->toks[j]) != SHADOW_KW_DESTROY) return NULL;
    j++;
    if (j >= p->n || !tok_eq(p->toks[j], TK_PUNCT, "{")) return NULL;

    p_next(p); /* type */
    p_next(p); /* * */
    Token name = p_next(p);
    p_next(p); /* = */
    Token callee = p_next(p);
    p_next(p); /* ( */
    Token arg = p_next(p);
    (void)arg;
    p_next(p); /* ) */
    p_next(p); /* !> */
    p_next(p); /* @ */
    p_next(p); /* destroy */
    p_next(p); /* { */

    AstNode* n = ast_new(p, AST_NURSERY_DESTROY);
    if (!n) return NULL;
    slice_to(n->a, sizeof(n->a), ty.spell);
    slice_to(n->b, sizeof(n->b), name.spell);
    slice_to(n->c, sizeof(n->c), callee.spell);
    while (!tok_eq(p_peek(p), TK_PUNCT, "}") && p_peek(p).kind != TK_EOF && !p->err) {
        AstNode* s = parse_stmt(p);
        if (!s) return NULL;
        if (n->nbody >= 8) {
            parser_fail(p, p_peek(p), "@destroy body too large for shadow beachhead");
            return NULL;
        }
        n->body[n->nbody++] = s;
    }
    if (!p_accept(p, TK_PUNCT, "}")) {
        parser_fail(p, p_peek(p), "expected '}' to close @destroy");
        return NULL;
    }
    if (!p_accept(p, TK_PUNCT, ";")) {
        parser_fail(p, p_peek(p), "expected ';' after @destroy { ... }");
        return NULL;
    }
    return n;
}

/* Parse optional @destroy [; | { stmts }] into n->dbody / mode suffix. */
static int parse_destroy_tail(Parser* p, AstNode* n, char* mode, size_t mode_cap) {
    if (!tok_eq(p_peek(p), TK_PUNCT, "@")) return 1; /* no destroy */
    if (p->i + 1 >= p->n || shadow_kw(p->toks[p->i + 1]) != SHADOW_KW_DESTROY)
        return 1;
    p_next(p); /* @ */
    p_next(p); /* destroy */
    if (p_accept(p, TK_PUNCT, ";")) {
        size_t m = strlen(mode);
        if (m + 6 < mode_cap) snprintf(mode + m, mode_cap - m, "_Dbare");
        snprintf(n->d, sizeof(n->d), "%s", mode);
        return 1;
    }
    if (!p_accept(p, TK_PUNCT, "{")) {
        parser_fail(p, p_peek(p), "expected ';' or '{' after @destroy");
        return 0;
    }
    while (!tok_eq(p_peek(p), TK_PUNCT, "}") && p_peek(p).kind != TK_EOF && !p->err) {
        AstNode* s = parse_stmt(p);
        if (!s) return 0;
        if (n->ndbody >= 8) {
            parser_fail(p, p_peek(p), "@destroy body too large for shadow beachhead");
            return 0;
        }
        n->dbody[n->ndbody++] = s;
    }
    if (!p_accept(p, TK_PUNCT, "}") || !p_accept(p, TK_PUNCT, ";")) {
        parser_fail(p, p_peek(p), "expected '};' after @destroy { ... }");
        return 0;
    }
    {
        size_t m = strlen(mode);
        if (m + 2 < mode_cap) snprintf(mode + m, mode_cap - m, "_D");
        snprintf(n->d, sizeof(n->d), "%s", mode);
    }
    return 1;
}

/* Type * name = call(...) !>|?> … [@destroy …] ; */
static AstNode* parse_ptr_unwrap(Parser* p) {
    Token ty = p_peek(p);
    if (ty.kind != TK_IDENT) return NULL;
    if (p->i + 5 >= p->n) return NULL;
    if (!tok_eq(p->toks[p->i + 1], TK_PUNCT, "*")) return NULL;
    if (p->toks[p->i + 2].kind != TK_IDENT) return NULL;
    if (!tok_eq(p->toks[p->i + 3], TK_PUNCT, "=")) return NULL;
    int j = p->i + 4;
    int depth = 0;
    int op_at = -1;
    while (j < p->n) {
        Token t = p->toks[j];
        if (tok_eq(t, TK_PUNCT, "(") || tok_eq(t, TK_PUNCT, "{") || tok_eq(t, TK_PUNCT, "["))
            depth++;
        else if (tok_eq(t, TK_PUNCT, ")") || tok_eq(t, TK_PUNCT, "}") || tok_eq(t, TK_PUNCT, "]"))
            depth--;
        else if (depth == 0 && (tok_eq(t, TK_PUNCT, "!>") || tok_eq(t, TK_PUNCT, "?>"))) {
            op_at = j;
            break;
        } else if (depth == 0 && tok_eq(t, TK_PUNCT, ";")) {
            return NULL;
        }
        j++;
    }
    if (op_at < 0) return NULL;

    p_next(p); /* type */
    p_next(p); /* * */
    Token name = p_next(p);
    p_next(p); /* = */
    int c0 = p->i;
    while (p->i < op_at) p_next(p);
    char call[256];
    if (!span_text(p, c0, op_at, call, sizeof(call))) {
        parser_fail(p, name, "ptr unwrap call too long");
        return NULL;
    }
    Token op = p_next(p);
    AstNode* n = ast_new(p, AST_PTR_UNWRAP);
    if (!n) return NULL;
    slice_to(n->a, sizeof(n->a), ty.spell);
    slice_to(n->b, sizeof(n->b), name.spell);
    snprintf(n->c, sizeof(n->c), "%s", call);
    char mode[64];
    mode[0] = 0;

    if (tok_eq(op, TK_PUNCT, "!>")) {
        if (tok_eq(p_peek(p), TK_PUNCT, "@")) {
            /* !> @destroy … — handler = errhandler */
            snprintf(mode, sizeof(mode), "bang_eh");
            snprintf(n->d, sizeof(n->d), "%s", mode);
            if (!parse_destroy_tail(p, n, mode, sizeof(mode))) return NULL;
            return n;
        }
        if (tok_eq(p_peek(p), TK_PUNCT, "(")) {
            p_next(p);
            Token bind = p_next(p);
            if (bind.kind != TK_IDENT) {
                parser_fail(p, bind, "expected bind in !>(...)");
                return NULL;
            }
            if (!p_accept(p, TK_PUNCT, ")")) {
                parser_fail(p, p_peek(p), "expected ')' after bind");
                return NULL;
            }
            slice_to(n->e, sizeof(n->e), bind.spell);
            snprintf(mode, sizeof(mode), "bang_block");
        } else {
            snprintf(mode, sizeof(mode), "bang_nobind");
        }
        if (tok_eq(p_peek(p), TK_PUNCT, "{")) {
            p_next(p);
            while (!tok_eq(p_peek(p), TK_PUNCT, "}") && p_peek(p).kind != TK_EOF && !p->err) {
                AstNode* st = parse_stmt(p);
                if (!st) return NULL;
                if (n->nbody >= 8) {
                    parser_fail(p, p_peek(p), "!> handler too large");
                    return NULL;
                }
                n->body[n->nbody++] = st;
            }
            if (!p_accept(p, TK_PUNCT, "}")) {
                parser_fail(p, p_peek(p), "expected '}' after !> handler");
                return NULL;
            }
        } else if (strcmp(mode, "bang_nobind") == 0) {
            /* !> stmt ;  — single stmt handler without braces */
            AstNode* st = parse_stmt(p);
            if (!st) return NULL;
            n->body[0] = st;
            n->nbody = 1;
            snprintf(n->d, sizeof(n->d), "%s", mode);
            return n;
        }
        snprintf(n->d, sizeof(n->d), "%s", mode);
        if (p_accept(p, TK_PUNCT, ";")) return n;
        if (!tok_eq(p_peek(p), TK_PUNCT, "@")) {
            parser_fail(p, p_peek(p), "expected ';' or @destroy after !> handler");
            return NULL;
        }
        if (!parse_destroy_tail(p, n, mode, sizeof(mode))) return NULL;
        return n;
    }

    /* ?> */
    snprintf(mode, sizeof(mode), "qmark");
    int d0 = p->i;
    depth = 0;
    while (p->i < p->n) {
        Token t = p_peek(p);
        if (tok_eq(t, TK_PUNCT, "(") || tok_eq(t, TK_PUNCT, "{") || tok_eq(t, TK_PUNCT, "["))
            depth++;
        else if (tok_eq(t, TK_PUNCT, ")") || tok_eq(t, TK_PUNCT, "}") || tok_eq(t, TK_PUNCT, "]"))
            depth--;
        else if (depth == 0 && (tok_eq(t, TK_PUNCT, ";") || tok_eq(t, TK_PUNCT, "@")))
            break;
        p_next(p);
    }
    if (!span_text(p, d0, p->i, n->e, sizeof(n->e))) {
        parser_fail(p, p_peek(p), "?> default too long");
        return NULL;
    }
    snprintf(n->d, sizeof(n->d), "%s", mode);
    if (p_accept(p, TK_PUNCT, ";")) return n;
    if (!tok_eq(p_peek(p), TK_PUNCT, "@")) {
        parser_fail(p, p_peek(p), "expected ';' or @destroy after ?> default");
        return NULL;
    }
    if (!parse_destroy_tail(p, n, mode, sizeof(mode))) return NULL;
    return n;
}

/* Type name = expr @destroy;  (value type, bare destroy) */
static AstNode* parse_val_destroy(Parser* p) {
    Token ty = p_peek(p);
    if (ty.kind != TK_IDENT) return NULL;
    if (p->i + 4 >= p->n) return NULL;
    if (p->toks[p->i + 1].kind != TK_IDENT) return NULL;
    if (!tok_eq(p->toks[p->i + 2], TK_PUNCT, "=")) return NULL;
    /* Must see @destroy before ';' at depth 0; reject Type*. */
    int j = p->i + 3;
    int depth = 0;
    int saw_destroy = 0;
    while (j < p->n) {
        Token t = p->toks[j];
        if (tok_eq(t, TK_PUNCT, "(") || tok_eq(t, TK_PUNCT, "{") || tok_eq(t, TK_PUNCT, "["))
            depth++;
        else if (tok_eq(t, TK_PUNCT, ")") || tok_eq(t, TK_PUNCT, "}") || tok_eq(t, TK_PUNCT, "]"))
            depth--;
        else if (depth == 0 && tok_eq(t, TK_PUNCT, "@") && j + 1 < p->n &&
                 shadow_kw(p->toks[j + 1]) == SHADOW_KW_DESTROY) {
            saw_destroy = 1;
            break;
        } else if (depth == 0 && tok_eq(t, TK_PUNCT, ";")) {
            return NULL;
        }
        j++;
    }
    if (!saw_destroy) return NULL;

    p_next(p); /* type */
    Token name = p_next(p);
    p_next(p); /* = */
    int c0 = p->i;
    while (p->i < j) p_next(p);
    char init[256];
    if (!span_text(p, c0, j, init, sizeof(init))) {
        parser_fail(p, name, "val @destroy init too long");
        return NULL;
    }
    p_next(p); /* @ */
    p_next(p); /* destroy */
    if (!p_accept(p, TK_PUNCT, ";")) {
        parser_fail(p, p_peek(p), "expected ';' after @destroy");
        return NULL;
    }
    AstNode* n = ast_new(p, AST_VAL_DESTROY);
    if (!n) return NULL;
    slice_to(n->a, sizeof(n->a), ty.spell);
    slice_to(n->b, sizeof(n->b), name.spell);
    snprintf(n->c, sizeof(n->c), "%s", init);
    snprintf(n->d, sizeof(n->d), "_Dbare");
    return n;
}

/* for ( hdr ) { stmts } */
static AstNode* parse_for(Parser* p) {
    if (shadow_kw(p_peek(p)) != SHADOW_KW_FOR) return NULL;
    p_next(p);
    if (!tok_eq(p_peek(p), TK_PUNCT, "(")) {
        parser_fail(p, p_peek(p), "expected '(' after for");
        return NULL;
    }
    int h0 = p->i + 1;
    if (!skip_parens(p)) {
        parser_fail(p, p_peek(p), "unterminated for (...)");
        return NULL;
    }
    int h1 = p->i - 1;
    AstNode* n = ast_new(p, AST_FOR);
    if (!n) return NULL;
    if (h0 >= h1) n->a[0] = 0;
    else if (!span_text(p, h0, h1, n->a, sizeof(n->a))) {
        parser_fail(p, p_peek(p), "for header too long");
        return NULL;
    }
    if (!tok_eq(p_peek(p), TK_PUNCT, "{")) {
        parser_fail(p, p_peek(p), "expected '{' after for (...)");
        return NULL;
    }
    p_next(p); /* { */
    while (!tok_eq(p_peek(p), TK_PUNCT, "}") && p_peek(p).kind != TK_EOF && !p->err) {
        AstNode* s = parse_stmt(p);
        if (!s) return NULL;
        if (n->nbody >= 8) {
            parser_fail(p, p_peek(p), "for body too large for shadow beachhead");
            return NULL;
        }
        n->body[n->nbody++] = s;
    }
    if (!p_accept(p, TK_PUNCT, "}")) {
        parser_fail(p, p_peek(p), "expected '}' to close for");
        return NULL;
    }
    return n;
}

/* Type[*] name = expr ;  (no unwrap / @destroy) */
static AstNode* parse_typed_init(Parser* p) {
    Token ty = p_peek(p);
    if (ty.kind != TK_IDENT) return NULL;
    if (p->i + 3 >= p->n) return NULL;
    int is_ptr = 0;
    int ni = p->i + 1;
    if (tok_eq(p->toks[ni], TK_PUNCT, "*")) {
        is_ptr = 1;
        ni++;
    }
    if (ni >= p->n || p->toks[ni].kind != TK_IDENT) return NULL;
    if (ni + 1 >= p->n || !tok_eq(p->toks[ni + 1], TK_PUNCT, "=")) return NULL;
    /* Reject if later unwrap / @destroy (other parsers own those). */
    int j = ni + 2;
    int depth = 0;
    while (j < p->n) {
        Token t = p->toks[j];
        if (tok_eq(t, TK_PUNCT, "(") || tok_eq(t, TK_PUNCT, "{") || tok_eq(t, TK_PUNCT, "["))
            depth++;
        else if (tok_eq(t, TK_PUNCT, ")") || tok_eq(t, TK_PUNCT, "}") || tok_eq(t, TK_PUNCT, "]"))
            depth--;
        else if (depth == 0 && (tok_eq(t, TK_PUNCT, "!>") || tok_eq(t, TK_PUNCT, "?>") ||
                                tok_eq(t, TK_PUNCT, "@")))
            return NULL;
        else if (depth == 0 && tok_eq(t, TK_PUNCT, ";"))
            break;
        j++;
    }
    if (j >= p->n || !tok_eq(p->toks[j], TK_PUNCT, ";")) return NULL;

    p_next(p); /* type */
    if (is_ptr) p_next(p); /* * */
    Token name = p_next(p);
    p_next(p); /* = */
    int c0 = p->i;
    while (p->i < j) p_next(p);
    char expr[256];
    if (!span_text(p, c0, j, expr, sizeof(expr))) {
        parser_fail(p, name, "typed init expr too long");
        return NULL;
    }
    p_next(p); /* ; */
    AstNode* n = ast_new(p, AST_TYPED_INIT);
    if (!n) return NULL;
    slice_to(n->a, sizeof(n->a), ty.spell);
    slice_to(n->b, sizeof(n->b), name.spell);
    snprintf(n->c, sizeof(n->c), "%s", expr);
    if (is_ptr) snprintf(n->d, sizeof(n->d), "*");
    return n;
}

/* recv.method(args); */
static AstNode* parse_ufcs_stmt(Parser* p) {
    if (p_peek(p).kind != TK_IDENT) return NULL;
    if (p->i + 3 >= p->n) return NULL;
    if (!tok_eq(p->toks[p->i + 1], TK_PUNCT, ".")) return NULL;
    if (p->toks[p->i + 2].kind != TK_IDENT) return NULL;
    if (!tok_eq(p->toks[p->i + 3], TK_PUNCT, "(")) return NULL;
    Token recv = p_next(p);
    p_next(p); /* . */
    Token meth = p_next(p);
    int a0 = p->i + 1;
    if (!skip_parens(p)) {
        parser_fail(p, p_peek(p), "unterminated UFCS call");
        return NULL;
    }
    int a1 = p->i - 1;
    if (!p_accept(p, TK_PUNCT, ";")) {
        parser_fail(p, p_peek(p), "expected ';' after UFCS call");
        return NULL;
    }
    AstNode* n = ast_new(p, AST_UFCS_STMT);
    if (!n) return NULL;
    slice_to(n->a, sizeof(n->a), recv.spell);
    slice_to(n->b, sizeof(n->b), meth.spell);
    if (a0 < a1) {
        if (!span_text(p, a0, a1, n->c, sizeof(n->c))) {
            parser_fail(p, meth, "UFCS args too long");
            return NULL;
        }
    }
    return n;
}

/* lhs = rhs ;  (simple assign, e.g. scratch[0] = '\0') */
static AstNode* parse_assign_stmt(Parser* p) {
    if (p_peek(p).kind != TK_IDENT) return NULL;
    int j = p->i;
    int depth = 0;
    int eq = -1;
    while (j < p->n) {
        Token t = p->toks[j];
        if (tok_eq(t, TK_PUNCT, "(") || tok_eq(t, TK_PUNCT, "[") || tok_eq(t, TK_PUNCT, "{"))
            depth++;
        else if (tok_eq(t, TK_PUNCT, ")") || tok_eq(t, TK_PUNCT, "]") || tok_eq(t, TK_PUNCT, "}"))
            depth--;
        else if (depth == 0 && tok_eq(t, TK_PUNCT, "=") && eq < 0) {
            eq = j;
        } else if (depth == 0 && tok_eq(t, TK_PUNCT, ";")) {
            break;
        }
        j++;
    }
    if (eq < 0 || j >= p->n || !tok_eq(p->toks[j], TK_PUNCT, ";")) return NULL;
    /* Don't steal Type name = … */
    if (p->i + 1 == eq) return NULL;

    int l0 = p->i;
    while (p->i < eq) p_next(p);
    char lhs[128];
    if (!span_text(p, l0, eq, lhs, sizeof(lhs))) return NULL;
    p_next(p); /* = */
    int r0 = p->i;
    while (p->i < j) p_next(p);
    char rhs[128];
    if (!span_text(p, r0, j, rhs, sizeof(rhs))) return NULL;
    p_next(p); /* ; */
    AstNode* n = ast_new(p, AST_ASSIGN);
    if (!n) return NULL;
    snprintf(n->a, sizeof(n->a), "%s", lhs);
    snprintf(n->b, sizeof(n->b), "%s", rhs);
    return n;
}

/* (void) ident ; */
static AstNode* parse_void_cast(Parser* p) {
    if (!tok_eq(p_peek(p), TK_PUNCT, "(")) return NULL;
    if (p->i + 4 >= p->n) return NULL;
    if (shadow_kw(p->toks[p->i + 1]) != SHADOW_KW_VOID) return NULL;
    if (!tok_eq(p->toks[p->i + 2], TK_PUNCT, ")")) return NULL;
    if (p->toks[p->i + 3].kind != TK_IDENT) return NULL;
    if (!tok_eq(p->toks[p->i + 4], TK_PUNCT, ";")) return NULL;
    p_next(p); p_next(p); p_next(p);
    Token id = p_next(p);
    p_next(p); /* ; */
    AstNode* n = ast_new(p, AST_VOID_CAST);
    if (!n) return NULL;
    slice_to(n->a, sizeof(n->a), id.spell);
    return n;
}

/* static char name [] = "lit" ; */
static AstNode* parse_static_arr(Parser* p) {
    if (shadow_kw(p_peek(p)) != SHADOW_KW_STATIC) return NULL;
    if (p->i + 6 >= p->n) return NULL;
    if (shadow_kw(p->toks[p->i + 1]) != SHADOW_KW_CHAR) return NULL;
    if (p->toks[p->i + 2].kind != TK_IDENT) return NULL;
    if (!tok_eq(p->toks[p->i + 3], TK_PUNCT, "[") ||
        !tok_eq(p->toks[p->i + 4], TK_PUNCT, "]") ||
        !tok_eq(p->toks[p->i + 5], TK_PUNCT, "="))
        return NULL;
    p_next(p); /* static */
    p_next(p); /* char */
    Token name = p_next(p);
    p_next(p); p_next(p); p_next(p); /* [ ] = */
    Token lit = p_next(p);
    if (lit.kind != TK_STR) {
        parser_fail(p, lit, "expected string initializer");
        return NULL;
    }
    if (!p_accept(p, TK_PUNCT, ";")) { p->err = 1; return NULL; }
    AstNode* n = ast_new(p, AST_STATIC_ARR);
    if (!n) return NULL;
    slice_to(n->a, sizeof(n->a), name.spell);
    slice_to(n->b, sizeof(n->b), lit.spell);
    return n;
}

/* static char * name ( params ) { body } */
static AstNode* parse_static_fn(Parser* p) {
    if (shadow_kw(p_peek(p)) != SHADOW_KW_STATIC) return NULL;
    if (p->i + 5 >= p->n) return NULL;
    /* static char * name ( */
    if (shadow_kw(p->toks[p->i + 1]) != SHADOW_KW_CHAR) return NULL;
    if (!tok_eq(p->toks[p->i + 2], TK_PUNCT, "*")) return NULL;
    if (p->toks[p->i + 3].kind != TK_IDENT) return NULL;
    if (!tok_eq(p->toks[p->i + 4], TK_PUNCT, "(")) return NULL;
    p_next(p); /* static */
    p_next(p); /* char */
    p_next(p); /* * */
    Token name = p_next(p);
    p_next(p); /* ( */
    int p0 = p->i;
    int depth = 1;
    while (p->i < p->n && depth > 0) {
        Token t = p_peek(p);
        if (tok_eq(t, TK_PUNCT, "(")) depth++;
        else if (tok_eq(t, TK_PUNCT, ")")) {
            depth--;
            if (depth == 0) break;
        }
        p_next(p);
    }
    char params[256];
    if (p0 >= p->i) params[0] = 0;
    else if (!span_text(p, p0, p->i, params, sizeof(params))) {
        parser_fail(p, name, "static fn params too long");
        return NULL;
    }
    if (!p_accept(p, TK_PUNCT, ")") || !p_accept(p, TK_PUNCT, "{")) {
        parser_fail(p, p_peek(p), "expected ') {' after static fn params");
        return NULL;
    }
    AstNode* n = ast_new(p, AST_STATIC_FN);
    if (!n) return NULL;
    snprintf(n->a, sizeof(n->a), "char");
    slice_to(n->b, sizeof(n->b), name.spell);
    snprintf(n->c, sizeof(n->c), "%s", params);
    n->kids = &p->kids_storage[p->nkstore];
    while (!tok_eq(p_peek(p), TK_PUNCT, "}") && p_peek(p).kind != TK_EOF && !p->err) {
        /* Prefer static arr before generic stmts */
        AstNode* s = parse_static_arr(p);
        if (!s && !p->err) s = parse_stmt(p);
        if (!s) return NULL;
        if (p->nkstore >= AST_CAP * 4) { p->err = 1; return NULL; }
        p->kids_storage[p->nkstore++] = s;
        n->nkids++;
    }
    if (!p_accept(p, TK_PUNCT, "}")) {
        parser_fail(p, p_peek(p), "expected '}' to close static fn");
        return NULL;
    }
    return n;
}

/* Ident ( NUM ) ; */
static AstNode* parse_call_num(Parser* p) {
    Token callee = p_peek(p);
    if (callee.kind != TK_IDENT) return NULL;
    if (p->i + 4 >= p->n) return NULL;
    if (!tok_eq(p->toks[p->i + 1], TK_PUNCT, "(")) return NULL;
    if (p->toks[p->i + 2].kind != TK_NUM) return NULL;
    if (!tok_eq(p->toks[p->i + 3], TK_PUNCT, ")")) return NULL;
    if (!tok_eq(p->toks[p->i + 4], TK_PUNCT, ";")) return NULL;
    p_next(p);
    p_next(p); /* ( */
    Token num = p_next(p);
    p_next(p); /* ) */
    p_next(p); /* ; */
    AstNode* n = ast_new(p, AST_CALL_NUM);
    if (!n) return NULL;
    slice_to(n->a, sizeof(n->a), callee.spell);
    slice_to(n->b, sizeof(n->b), num.spell);
    return n;
}

/* recv -> spawn ( ( ) => { stmts } ) ; */
static AstNode* parse_spawn_closure(Parser* p) {
    Token recv = p_peek(p);
    if (recv.kind != TK_IDENT) return NULL;
    if (p->i + 8 >= p->n) return NULL;
    if (!tok_eq(p->toks[p->i + 1], TK_PUNCT, "->")) return NULL;
    if (shadow_kw(p->toks[p->i + 2]) != SHADOW_KW_SPAWN) return NULL;
    if (!tok_eq(p->toks[p->i + 3], TK_PUNCT, "(")) return NULL;
    if (!tok_eq(p->toks[p->i + 4], TK_PUNCT, "(")) return NULL;
    if (!tok_eq(p->toks[p->i + 5], TK_PUNCT, ")")) return NULL;
    if (!tok_eq(p->toks[p->i + 6], TK_PUNCT, "=>")) return NULL;
    if (!tok_eq(p->toks[p->i + 7], TK_PUNCT, "{")) return NULL;

    p_next(p); /* recv */
    p_next(p); /* -> */
    p_next(p); /* spawn */
    p_next(p); /* ( */
    p_next(p); /* ( */
    p_next(p); /* ) */
    p_next(p); /* => */
    p_next(p); /* { */

    AstNode* n = ast_new(p, AST_SPAWN_CLOSURE);
    if (!n) return NULL;
    slice_to(n->a, sizeof(n->a), recv.spell);
    snprintf(n->b, sizeof(n->b), "spawn");
    while (!tok_eq(p_peek(p), TK_PUNCT, "}") && p_peek(p).kind != TK_EOF && !p->err) {
        AstNode* s = parse_stmt(p);
        if (!s) return NULL;
        if (n->nbody >= 8) {
            parser_fail(p, p_peek(p), "spawn closure body too large for shadow beachhead");
            return NULL;
        }
        n->body[n->nbody++] = s;
    }
    if (!p_accept(p, TK_PUNCT, "}")) {
        parser_fail(p, p_peek(p), "expected '}' to close spawn closure");
        return NULL;
    }
    if (!p_accept(p, TK_PUNCT, ")")) {
        parser_fail(p, p_peek(p), "expected ')' after spawn(() => { ... })");
        return NULL;
    }
    if (!p_accept(p, TK_PUNCT, ";")) {
        parser_fail(p, p_peek(p), "expected ';' after spawn(...)");
        return NULL;
    }
    return n;
}

static AstNode* parse_call_args(Parser* p) {
    Token callee = p_peek(p);
    if (callee.kind != TK_IDENT) return NULL;
    if (p->i + 2 >= p->n || !tok_eq(p->toks[p->i + 1], TK_PUNCT, "(")) return NULL;
    /* Prefer the tight NUM form when it matches (usleep beachhead). */
    if (p->i + 4 < p->n && p->toks[p->i + 2].kind == TK_NUM &&
        tok_eq(p->toks[p->i + 3], TK_PUNCT, ")") &&
        tok_eq(p->toks[p->i + 4], TK_PUNCT, ";"))
        return NULL;
    /* Lookahead: balanced parens then ';' */
    int j = p->i + 1;
    int depth = 0;
    while (j < p->n) {
        Token t = p->toks[j];
        if (tok_eq(t, TK_PUNCT, "(")) depth++;
        else if (tok_eq(t, TK_PUNCT, ")")) {
            depth--;
            if (depth == 0) { j++; break; }
        }
        j++;
    }
    if (j >= p->n || !tok_eq(p->toks[j], TK_PUNCT, ";")) return NULL;

    p_next(p);
    int a0 = p->i + 1;
    if (!skip_parens(p)) {
        parser_fail(p, p_peek(p), "unterminated call");
        return NULL;
    }
    int a1 = p->i - 1;
    p_next(p); /* ; */
    AstNode* n = ast_new(p, AST_CALL_ARGS);
    if (!n) return NULL;
    slice_to(n->a, sizeof(n->a), callee.spell);
    if (a0 >= a1) n->b[0] = 0;
    else if (!span_text(p, a0, a1, n->b, sizeof(n->b))) {
        parser_fail(p, callee, "call args too long");
        return NULL;
    }
    return n;
}

static AstNode* parse_stmt(Parser* p) {
    Token t = p_peek(p);
    if (t.kind == TK_EOF) return NULL;
    AstNode* n;
    if (tok_eq(t, TK_PUNCT, "@")) {
        n = parse_errhandler(p);
        if (n || p->err) return n;
        n = parse_err_fwd(p);
        if (n || p->err) return n;
        n = parse_defer(p);
        if (n || p->err) return n;
        return parse_at_stmt(p);
    }
    if (tok_eq(t, TK_PUNCT, "(")) {
        n = parse_void_cast(p);
        if (n || p->err) return n;
    }
    if (shadow_kw(t) == SHADOW_KW_IF) return parse_if_stmt(p);
    if (shadow_kw(t) == SHADOW_KW_FOR) return parse_for(p);
    if (shadow_kw(t) == SHADOW_KW_RETURN) return parse_return_int(p);
    if (shadow_kw(t) == SHADOW_KW_PRINTLN) return parse_println_bang(p);
    if (shadow_kw(t) == SHADOW_KW_STATIC) {
        n = parse_static_arr(p);
        if (n || p->err) return n;
    }
    if (shadow_kw(t) == SHADOW_KW_INT) {
        n = parse_var_unwrap(p);
        if (n || p->err) return n;
        n = parse_chan_var(p);
        if (n || p->err) return n;
        n = parse_slice_var(p);
        if (n || p->err) return n;
    }
    if (peek_result_shape(p)) {
        n = parse_result_local(p);
        if (n || p->err) return n;
    }
    n = parse_ptr_unwrap(p);
    if (n || p->err) return n;
    n = parse_nursery_destroy(p);
    if (n || p->err) return n;
    n = parse_val_destroy(p);
    if (n || p->err) return n;
    n = parse_ptr_init(p);
    if (n || p->err) return n;
    n = parse_typed_init(p);
    if (n || p->err) return n;
    n = parse_spawn_closure(p);
    if (n || p->err) return n;
    n = parse_ufcs_stmt(p);
    if (n || p->err) return n;
    n = parse_assign_stmt(p);
    if (n || p->err) return n;
    n = parse_stmt_unwrap(p);
    if (n || p->err) return n;
    n = parse_call_num(p);
    if (n || p->err) return n;
    n = parse_call_args(p);
    if (n || p->err) return n;
    parser_fail(p, t, "unexpected statement (shadow subset)");
    return NULL;
}

/* int Name ( void ) { stmts } */
static AstNode* parse_fn(Parser* p) {
    if (!peek_int_base(p)) return NULL;
    if (p->i + 1 < p->n && (tok_eq(p->toks[p->i + 1], TK_PUNCT, "[") ||
                            tok_eq(p->toks[p->i + 1], TK_PUNCT, "!>")))
        return NULL;
    if (p->i + 5 >= p->n) return NULL;
    if (p->toks[p->i + 1].kind != TK_IDENT) return NULL;
    if (!tok_eq(p->toks[p->i + 2], TK_PUNCT, "(")) return NULL;
    int j = p->i + 3;
    if (shadow_kw(p->toks[j]) == SHADOW_KW_VOID) j++;
    if (!tok_eq(p->toks[j], TK_PUNCT, ")")) return NULL;
    j++;
    if (!tok_eq(p->toks[j], TK_PUNCT, "{")) return NULL;

    p_next(p); /* int */
    Token name = p_next(p);
    p_next(p); /* ( */
    if (shadow_kw(p_peek(p)) == SHADOW_KW_VOID) p_next(p);
    p_next(p); /* ) */
    p_next(p); /* { */
    AstNode* n = ast_new(p, AST_FN);
    if (!n) return NULL;
    slice_to(n->a, sizeof(n->a), name.spell);
    n->kids = &p->kids_storage[p->nkstore];
    while (!tok_eq(p_peek(p), TK_PUNCT, "}") && p_peek(p).kind != TK_EOF && !p->err) {
        AstNode* s = parse_stmt(p);
        if (!s) return NULL;
        if (p->nkstore >= AST_CAP * 4) { p->err = 1; return NULL; }
        p->kids_storage[p->nkstore++] = s;
        n->nkids++;
    }
    if (!p_accept(p, TK_PUNCT, "}")) {
        parser_fail(p, p_peek(p), "expected '}' to close function");
        return NULL;
    }
    return n;
}

/* () => { } ; */
static AstNode* parse_closure_lit(Parser* p) {
    if (!tok_eq(p_peek(p), TK_PUNCT, "(")) return NULL;
    if (p->i + 5 >= p->n) return NULL;
    if (!tok_eq(p->toks[p->i + 1], TK_PUNCT, ")") ||
        !tok_eq(p->toks[p->i + 2], TK_PUNCT, "=>") ||
        !tok_eq(p->toks[p->i + 3], TK_PUNCT, "{") ||
        !tok_eq(p->toks[p->i + 4], TK_PUNCT, "}"))
        return NULL;
    p_next(p); p_next(p); p_next(p); p_next(p); p_next(p);
    p_accept(p, TK_PUNCT, ";");
    return ast_new(p, AST_CLOSURE_LIT);
}

/* @ident ;  or  @ident { } ;  — spike: attr name only */
static AstNode* parse_at_stmt(Parser* p) {
    if (!tok_eq(p_peek(p), TK_PUNCT, "@")) return NULL;
    p_next(p);
    Token name = p_next(p);
    if (name.kind != TK_IDENT) { p->err = 1; return NULL; }
    if (tok_eq(p_peek(p), TK_PUNCT, "{")) {
        p_next(p);
        if (!p_accept(p, TK_PUNCT, "}")) { p->err = 1; return NULL; }
    }
    p_accept(p, TK_PUNCT, ";");
    AstNode* n = ast_new(p, AST_AT_STMT);
    if (!n) return NULL;
    slice_to(n->a, sizeof(n->a), name.spell);
    return n;
}

/* int Name ; */
static AstNode* parse_int_decl(Parser* p, AstKind kind) {
    if (shadow_kw(p_peek(p)) != SHADOW_KW_INT) return NULL;
    /* CC shapes take precedence over plain int Name */
    if (p->i + 1 < p->n && tok_eq(p->toks[p->i + 1], TK_PUNCT, "[")) return NULL;
    if (p->i + 1 < p->n && tok_eq(p->toks[p->i + 1], TK_PUNCT, "!>")) return NULL;
    p_next(p);
    Token name = p_next(p);
    if (name.kind != TK_IDENT) { p->err = 1; return NULL; }
    if (!p_accept(p, TK_PUNCT, ";")) { p->err = 1; return NULL; }
    AstNode* n = ast_new(p, kind);
    if (!n) return NULL;
    slice_to(n->a, sizeof(n->a), name.spell);
    return n;
}

static AstNode* parse_typedef_int(Parser* p) {
    if (shadow_kw(p_peek(p)) != SHADOW_KW_TYPEDEF) return NULL;
    p_next(p);
    if (shadow_kw(p_peek(p)) != SHADOW_KW_INT) { p->err = 1; return NULL; }
    p_next(p);
    Token name = p_next(p);
    if (name.kind != TK_IDENT) { p->err = 1; return NULL; }
    if (!p_accept(p, TK_PUNCT, ";")) { p->err = 1; return NULL; }
    if (!scope_add_typedef(p, name.spell)) { p->err = 1; return NULL; }
    AstNode* n = ast_new(p, AST_TYPEDEF_INT);
    if (!n) return NULL;
    slice_to(n->a, sizeof(n->a), name.spell);
    return n;
}

/* Ident * Ident ;  — decl if typedef, else mul expr */
static AstNode* parse_star_stmt(Parser* p) {
    Token a = p_peek(p);
    if (a.kind != TK_IDENT) return NULL;
    /* need Ident * Ident ; */
    if (p->i + 3 >= p->n) return NULL;
    Token star = p->toks[p->i + 1];
    Token b = p->toks[p->i + 2];
    Token semi = p->toks[p->i + 3];
    if (!tok_eq(star, TK_PUNCT, "*") || b.kind != TK_IDENT || !tok_eq(semi, TK_PUNCT, ";"))
        return NULL;
    p_next(p); p_next(p); p_next(p); p_next(p);
    AstNode* n;
    if (scope_is_typedef(p, a.spell)) {
        n = ast_new(p, AST_PTR_DECL);
    } else {
        n = ast_new(p, AST_MUL_EXPR);
    }
    if (!n) return NULL;
    slice_to(n->a, sizeof(n->a), a.spell);
    slice_to(n->b, sizeof(n->b), b.spell);
    return n;
}

static AstNode* parse_struct(Parser* p) {
    if (shadow_kw(p_peek(p)) != SHADOW_KW_STRUCT) return NULL;
    p_next(p);
    Token name = p_next(p);
    if (name.kind != TK_IDENT) { p->err = 1; return NULL; }
    if (!p_accept(p, TK_PUNCT, "{")) { p->err = 1; return NULL; }
    AstNode* st = ast_new(p, AST_STRUCT);
    if (!st) return NULL;
    slice_to(st->a, sizeof(st->a), name.spell);
    st->kids = &p->kids_storage[p->nkstore];
    if (!parse_struct_fields(p, st)) return NULL;
    if (!p_accept(p, TK_PUNCT, "}")) { p->err = 1; return NULL; }
    p_accept(p, TK_PUNCT, ";"); /* optional trailing semi */
    return st;
}

static int parse_struct_fields(Parser* p, AstNode* st) {
    while (!tok_eq(p_peek(p), TK_PUNCT, "}") && p_peek(p).kind != TK_EOF) {
        AstNode* f = parse_slice_var(p);
        if (!f) f = parse_chan_var(p);
        if (!f) f = parse_int_decl(p, AST_FIELD_INT);
        if (!f) { p->err = 1; snprintf(p->err_msg, sizeof(p->err_msg), "bad field"); return 0; }
        if (p->nkstore >= AST_CAP * 4) { p->err = 1; return 0; }
        p->kids_storage[p->nkstore++] = f;
        st->nkids++;
    }
    return 1;
}

static AstNode* parse_external(Parser* p) {
    Token t = p_peek(p);
    if (t.kind == TK_EOF) return NULL;
    AstNode* n;
    if (tok_eq(t, TK_PUNCT, "@")) return parse_at_stmt(p);
    if (tok_eq(t, TK_PUNCT, "(")) {
        n = parse_closure_lit(p);
        if (n || p->err) return n;
    }
    if (shadow_kw(t) == SHADOW_KW_STATIC) {
        n = parse_static_fn(p);
        if (n || p->err) return n;
        n = parse_static_arr(p);
        if (n || p->err) return n;
    }
    if (shadow_kw(t) == SHADOW_KW_TYPEDEF) return parse_typedef_int(p);
    if (shadow_kw(t) == SHADOW_KW_STRUCT) return parse_struct(p);
    if (peek_result_shape(p)) {
        n = parse_result_fn(p);
        if (n || p->err) return n;
    }
    if (shadow_kw(t) == SHADOW_KW_INT) {
        n = parse_slice_var(p);
        if (n || p->err) return n;
        n = parse_chan_var(p);
        if (n || p->err) return n;
        n = parse_fn(p);
        if (n || p->err) return n;
        return parse_int_decl(p, AST_VAR_INT);
    }
    n = parse_star_stmt(p);
    if (n || p->err) return n;
    parser_fail(p, t, "unexpected token (shadow subset cannot lower this yet)");
    return NULL;
}

static int parse_tu(Parser* p, AstNode*** out_items, int* out_n) {
    scope_push(p);
    p->ntu = 0;
    while (p_peek(p).kind != TK_EOF && !p->err) {
        AstNode* e = parse_external(p);
        if (!e) break;
        if (p->ntu >= AST_CAP) { p->err = 1; break; }
        p->tu_items[p->ntu++] = e;
    }
    *out_items = p->tu_items;
    *out_n = p->ntu;
    return !p->err && p_peek(p).kind == TK_EOF;
}

static const char* ast_kind_name(AstKind k) {
    switch (k) {
    case AST_TYPEDEF_INT: return "typedef_int";
    case AST_VAR_INT: return "var_int";
    case AST_PTR_DECL: return "ptr_decl";
    case AST_MUL_EXPR: return "mul_expr";
    case AST_STRUCT: return "struct";
    case AST_FIELD_INT: return "field_int";
    case AST_SLICE_VAR: return "slice_var";
    case AST_CHAN_VAR: return "chan_var";
    case AST_RESULT_FN: return "result_fn";
    case AST_CLOSURE_LIT: return "closure_lit";
    case AST_AT_STMT: return "at_stmt";
    case AST_FN: return "fn";
    case AST_RETURN_INT: return "return_int";
    case AST_RETURN_CC: return "return_cc";
    case AST_RETURN_EXPR: return "return_expr";
    case AST_ERRHANDLER: return "errhandler";
    case AST_PRINTLN_BANG: return "println_bang";
    case AST_PRINTLN_BANG_BIND: return "println_bang_bind";
    case AST_PRINTLN_TPL: return "println_tpl";
    case AST_ERR_FWD: return "err_fwd";
    case AST_NURSERY_DESTROY: return "nursery_destroy";
    case AST_SPAWN_CLOSURE: return "spawn_closure";
    case AST_CALL_NUM: return "call_num";
    case AST_CALL_ARGS: return "call_args";
    case AST_IF: return "if";
    case AST_BLOCK: return "block";
    case AST_VAR_UNWRAP: return "var_unwrap";
    case AST_PTR_INIT: return "ptr_init";
    case AST_STMT_UNWRAP: return "stmt_unwrap";
    case AST_RESULT_LOCAL: return "result_local";
    case AST_DEFER: return "defer";
    case AST_PTR_UNWRAP: return "ptr_unwrap";
    case AST_VOID_CAST: return "void_cast";
    case AST_STATIC_FN: return "static_fn";
    case AST_STATIC_ARR: return "static_arr";
    case AST_VAL_DESTROY: return "val_destroy";
    case AST_FOR: return "for";
    case AST_TYPED_INIT: return "typed_init";
    case AST_UFCS_STMT: return "ufcs_stmt";
    case AST_ASSIGN: return "assign";
    }
    return "?";
}

/*
 * Recipe: every form of UFCS
 *
 * The sections below are NOT ten things to learn. UFCS is ONE rule:
 *
 *     recv.method(args) calls the function the receiver's TYPE names,
 *     and DECLARING that function IS installing the method.
 *
 * Everything else is spelling. Generic instances name members
 * <Instance>_<method>; runtime families name them cc_<type>_<method>;
 * a bare declared function whose first parameter takes the receiver
 * needs no naming convention at all; prefix and postfix are the same
 * call. And when a hop can fail, `!>` is the link: each hop spells its
 * unwrap, then the next dispatches on the unwrapped value.
 *
 * There is no registration step anywhere in this file.
 *
 *    1. Family members       v.push(x)
 *    2. Instance extension   v.median()          declare CCVec_double_median
 *    3. Scalar family        d.halve()           declare cc_double_halve
 *    4. Free-call symmetry   halve(d)            the same call, prefix
 *    5. Bare-name tier       u.mean(6.0)         any fn whose 1st param fits
 *    6. System headers       d.fabs()            math.h, nothing local
 *    7. Chains               d.halve().twice()
 *    8. Typed slices         ps.at(1).y
 *    9. Fallible chains      get(21)!>.twice()    every hop spells its unwrap
 *   10. The miss             fails loud: the ladder names the receiver's
 *                            type and lists its installed methods
 */
#include <ccc/cc_runtime.cch>
#include <math.h>
#include <stdio.h>

typedef struct Pt { double x, y; } Pt;

/* 2. Extension by declaration: the composed spelling IS the install. */
static double CCVec_double_median(CCVec_double* v) {
    return v->len ? v->data[v->len / 2] : 0.0;
}

/* 3. Scalar families: cc_<type>_<method>, receiver by value. */
static double cc_double_halve(double v) { return v / 2.0; }
static double cc_double_twice(double v) { return v * 2.0; }

/* 5. Bare-name tier: any function whose first parameter takes the
 *    receiver (by value exactly, or by pointer via &recv). */
typedef struct Stats { double sum; int n; } Stats;
static double mean(Stats s, double bump) { return s.sum / s.n + bump; }

/* 9. A fallible hop returns a Result; `!>` is the chain link. */
static int cc_int_twice(int v) { return v * 2; }
static CCResult_int_CCError get(int v) {
    if (v < 0) return (CCResult_int_CCError){ .ok = false,
        .u.error = { .message = "negative" } };
    return (CCResult_int_CCError){ .ok = true, .u.value = v };
}

int main(void) {
    @errhandler(CCError e) { fprintf(stderr, "eh: %s\n", e.message); return 1; }

    CCArena arena = cc_arena_heap(kilobytes(64));
    if (!arena.base) return 1;

    /* 1. Family members: the declaration form's ##_ tokens ARE the
     *    method set. */
    Vec::[double] v = vec_new::[double](&arena);
    v.push(1.0);
    v.push(3.0);
    v.push(8.0);
    printf("len=%zu\n", v.len());

    /* 2. Declared above — no header edit, no compiler edit. */
    printf("median=%g\n", v.median());

    /* 3. Scalar receiver, by value. */
    double d = 10.0;
    printf("halve=%g\n", d.halve());

    /* 4. The same call, prefix spelling — U means universal both ways. */
    printf("halve2=%g\n", halve(d));

    /* 5. mean() is just a function; u.mean(6.0) == mean(u, 6.0). */
    Stats u = { 12.0, 3 };
    printf("mean=%g\n", u.mean(6.0));

    /* 6. System headers participate: fabs comes from math.h. */
    double neg = -2.5;
    printf("fabs=%g\n", neg.fabs());

    /* 7. Chains: each link is the same one rule on the previous result. */
    printf("chain=%g\n", d.halve().twice().halve());

    /* 8. Typed slices auto-instantiate for any element type. */
    Pt ps[:] = {{1, 2}, {3, 4}, {5, 6}};
    printf("slice=%zu y=%g\n", ps.sub(1, 3).len(), ps.at(1).y);

    /* 9. Fallible chains: a bare `!>` sends the error to @errhandler;
     *    a handler recovers this hop alone. Dynamic objects chain the
     *    same way — py.import("sys")!>.get("version")!>. */
    int ok = get(21)!>.twice();
    printf("ok=%d\n", ok);

    int rec = get(-1)
        !>(e) { printf("recovered: %s\n", e.message); return 0; }
        .twice();
    printf("unreachable %d\n", rec);
    return 9;
}

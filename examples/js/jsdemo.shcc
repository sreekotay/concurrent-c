#!/usr/bin/env -S ./cc/bin/ccc
/*
 * JS twin of examples/py/pydemo.shcc — same shape, same ownership: CC
 * owns main and hosts the runtime in-process.
 *
 *   pydemo:  cc_py_new(false, &a)        →  libpython in-process
 *   jsdemo:  cc_js_new(false, &a)  →  libnode in-process (V8, libuv, npm)
 *
 * One constructor, transport as the flag: `false` embeds a full Node in
 * this process (needs libnode-dev; one per process — V8's rule);
 * `true` spawns a node child per handle instead — N isolated domains,
 * crash isolation, wire cost (examples/recipe_js_isolated.ccs).  The
 * surface is the same either way: require/eval/exec, attribute chains,
 * `!>`, typed destinations.
 *
 *     ccc examples/js/jsdemo.shcc        # needs libnode-dev
 */
#include <ccc/script/js.cch>

/* The probe, mirroring cc_py_available(): clean skip, no side effects. */
if (!cc_js_dom_available(false)) {
    "SKIP (need libnode-dev + c++)".println() !>;
    return 0;
}

CCJsDom js = cc_js_new(false, &a) !> @destroy;

double v = js.eval("Math.sqrt(2)")!>.as_f64() !>;
println(@string(`Math.sqrt(2.0) = ${v}`, &a)) !>;

long long pv = js.eval("Math.pow(2,10)")!>.as_i64() !>;
println(@string(`Math.pow(2,10) = ${pv}`, &a)) !>;

CCJsDomVal os = js.require("os") !> @destroy;
CCSlice plat = os.platform()!>.as_slice(&a) !>;
println(@string(`os.platform()  = ${plat}`, &a)) !>;

CCSlice ver = js.eval("process.version")!>.as_slice(&a) !>;
println(@string(`node.version   = ${ver}`, &a)) !>;

return 0;

#!/usr/bin/env -S ./cc/bin/ccc
/*
 * JS counterpart to examples/py/pydemo.shcc — same call shape (Math.sqrt,
 * Math.pow, hop chains), different ownership today:
 *
 *   Python hosting:  CC owns main  →  cc_py_new  (in-process)
 *   JS guest mode:   Node owns main →  this .node  (napi env injected)
 *
 * Standalone `cc_js_new` (CC hosts an engine) is not implemented yet; the
 * outbound UFCS surface here is what that constructor will feed.
 *
 *     ccc examples/js/jsdemo.shcc
 */
#include <ccc/std/exec.cch>
#include <ccc/script/stdio.cch>

{
    CCCommand which = cc_command(&a, @slice("sh"));
    which.arg("-c");
    which.arg("command -v node >/dev/null 2>&1");
    int rc = which.status() !>;
    if (rc != 0) {
        io.println("SKIP (no node on PATH)") !>;
        return 0;
    }
}

{
    CCCommand build = cc_command(&a, @slice("./cc/bin/ccc"));
    build.arg("build");
    build.arg("examples/js/jsdemo_mod.ccs");
    build.inherit_stdio();
    int rc = build.status() !>;
    if (rc != 0) {
        io.println("build failed") !>;
        return 1;
    }
}

{
    CCCommand run = cc_command(&a, @slice("sh"));
    run.arg("-c");
    CCString js = @string(`node -e "
const d = require(process.cwd() + '/bin/js_demo.node');
console.log('Math.sqrt(2.0) =', d.sqrt2());
console.log('Math.pow(2,10) =', d.pow(2, 10));
console.log('Math.floor(3.7) =', d.floor(3.7));
console.log('process.pid =', d.pid());
"`, &a);
    run.arg(js.cstr(&a));
    run.inherit_stdio();
    int rc = run.status() !>;
    if (rc != 0) {
        io.println("node run failed") !>;
        return 1;
    }
}
return 0;

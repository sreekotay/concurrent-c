#!/usr/bin/env -S ./cc/bin/ccc
/*
 * JS twin of examples/py/pydemo.shcc — same surface, same ownership: CC
 * owns main and drives a Node domain.
 *
 *   pydemo:  cc_py_new(false, &a)   →  libpython in-process
 *   jsdemo:  cc_js_new(iso, &a)     →  libnode in-process, or node child
 *
 * One constructor, transport as the flag: `false` embeds a full Node in
 * this process (needs libnode-dev; one per process — V8's rule);
 * `true` spawns a node child per handle — N isolated domains, crash
 * isolation, wire cost (examples/recipe_js_isolated.ccs).  The surface
 * is the same either way: require/eval/exec, attribute chains, `!>`,
 * typed destinations.
 *
 * macOS note: Homebrew's `node` formula installs headers
 * (/opt/homebrew/include/node) but not an embeddable libnode — hosted
 * (`false`) returns "libnode not found".  Isolated (`true`) only needs
 * `node` on PATH, so this demo prefers hosted when available and falls
 * back to isolated otherwise.
 *
 *     ccc examples/js/jsdemo.shcc
 */
#include <ccc/script/js.cch>

_Bool iso = !cc_js_dom_available(false);
if (!cc_js_dom_available(iso)) {
    "SKIP (need libnode-dev + c++, or node on PATH)".println() !>;
    return 0;
}
if (iso)
    "jsdemo: isolated (hosted unavailable — libnode not found)".println() !>;

CCJsDom js = cc_js_new(iso, &a) !> @destroy;

double v = js.eval("Math.sqrt(2)")!>.as_f64() !>;
println(@string(`Math.sqrt(2.0) = ${v}`, &a)) !>;

long long pv = js.eval("Math.pow(2,10)")!>.as_i64() !>;
println(@string(`Math.pow(2,10) = ${pv}`, &a)) !>;

CCJsDomVal os = js.require("os") !> @destroy;
CCSlice plat = os.platform()!>.as_slice(&a) !>;
println(@string(`os.platform()  = ${plat}`, &a)) !>;

CCSlice ver = js.eval("process.version")!>.as_slice(&a) !>;
println(@string(`node.version   = ${ver}`, &a)) !>;

return 0;

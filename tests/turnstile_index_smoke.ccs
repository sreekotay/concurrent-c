#!ccc ccs
/*
 * CCTurnstile index form: t.wait(k, i) / t.stage(k)->pass(i).
 * Also covers pass-before-wait (UNARMED), and reclaim of gate cells.
 */
#include <ccc/std/prelude.cch>
#include <stdio.h>

#define N   8
#define CAP 2
#define STAGES 3

static int g_next[STAGES];
static int g_fail;

static void worker(CCTurnstile* t, int i) {
    @errhandler(CCError e) cc_error_exit(e);
    int k;
    for (k = 0; k < STAGES; k++) {
        t.wait(k, i) !>;
        if (g_next[k] != i)
            g_fail = 1;
        g_next[k] = i + 1;
        t->pass(k, i) !>;
    }
    t->leave() !>;
}

/* Pass then wait on one name — create UNARMED, waiter returns immediately. */
static int unarmed_probe(void) {
    @errhandler(CCError e) {
        (void)e;
        return 1;
    }
    CCArena arena = cc_arena_heap(kilobytes(16)) @destroy;
    CCExclusive excl = cc_exclusive_create(&arena, 8) !> @destroy;
    if (cc_exclusive_gate_pass(excl.e, 42) != CC_EXCL_WAIT_OK) return 1;
    if (cc_exclusive_gate_wait(excl.e, 42) != CC_EXCL_WAIT_OK) return 1;
    if (cc_exclusive_live_count(excl.e) != 0) return 1;
    return 0;
}

/* fail then wait — waiter wakes FAILED, not OK. */
static int fail_probe(void) {
    @errhandler(CCError e) {
        (void)e;
        return 1;
    }
    CCArena arena = cc_arena_heap(kilobytes(16)) @destroy;
    CCExclusive excl = cc_exclusive_create(&arena, 8) !> @destroy;
    if (cc_exclusive_gate_fail(excl.e, 7) != CC_EXCL_WAIT_OK) return 1;
    if (cc_exclusive_gate_wait(excl.e, 7) != CC_EXCL_WAIT_FAILED) return 1;
    if (cc_exclusive_live_count(excl.e) != 0) return 1;
    return 0;
}

int main(void) {
    @errhandler(CCError e) { cc_error_log(e); return 1; }

    if (unarmed_probe() != 0) {
        fprintf(stderr, "FAIL unarmed/reclaim\n");
        return 1;
    }
    if (fail_probe() != 0) {
        fprintf(stderr, "FAIL fail/wait\n");
        return 1;
    }

    CCArena arena = cc_arena_heap(kilobytes(64)) @destroy;
    CCTurnstile t@(CAP, STAGES, &arena) @destroy;
    if (!t.excl)
        return 1;

    CCTurnstile* tp = &t;
    int i;
    {
        CCNursery nur = cc_nursery_create() !> @destroy;
        for (i = 0; i < N; i++) {
            t.enter(i) !>;
            nur.spawn(() => [i, tp] {
                @errhandler(CCError e) cc_error_exit(e);
                worker(tp, i);
            });
        }
    }

    for (i = 0; i < STAGES; i++) {
        if (g_next[i] != N)
            g_fail = 1;
    }
    /* Trailing UNARMED cell per stage (last pass opens N); everything else
     * reclaimed by the two-touch free. */
    if (cc_exclusive_live_count(t.excl) > (size_t)STAGES)
        g_fail = 1;
    if (g_fail) {
        fprintf(stderr, "FAIL live=%zu\n", cc_exclusive_live_count(t.excl));
        return 1;
    }
    printf("turnstile_index_smoke: OK\n");
    return 0;
}

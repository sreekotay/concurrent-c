/* char[:] !>(E) as Result-fn return / local ok-type (not only CCSlice). */
#include <ccc/std/prelude.cch>
#include <stdio.h>

static char[:] !>(CCError) make_hi(void) {
    return cc_ok(cc_slice_from_buffer("hi", 2));
}

int main(void) {
    @errhandler(CCError e) {
        fprintf(stderr, "%s\n", e.message);
        return 1;
    }
    char[:] s = make_hi() !>;
    if (s.len != 2 || s.ptr[0] != 'h') return 2;

    char[:] !>(CCError) r = make_hi();
    char[:] t = r !>;
    if (t.len != 2) return 3;

    printf("ok\n");
    return 0;
}

/* @for (i, v in s) — index is size_t, v is the .access load. */
#include <ccc/std/prelude.cch>
#include <stdio.h>

int main(void) {
    int[:] ys = { 10, 20, 30 };
    int sum = 0;
    size_t last = 99;

    @for (i, v in ys) {
        if (i == 0 && v != 10) return 1;
        if (i == 1 && v != 20) return 2;
        if (i == 2 && v != 30) return 3;
        sum += (int)i + v;
        last = i;
    }
    if (sum != 63) return 4;
    if (last != 2) return 5;

    printf("ok\n");
    return 0;
}

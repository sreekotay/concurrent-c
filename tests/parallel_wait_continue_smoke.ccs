/*
 * continue on a wait-for skips the rest of this ticket (including later
 * stage work) and does not cancel successors.
 */
#include <ccc/std/prelude.cch>
#include <stdio.h>

#define N 8

static int run(int use_par, int* xs) {
    @errhandler(CCError e) { cc_error_log(e); return 1; }
    CCArena arena = cc_arena_heap(kilobytes(64)) @destroy;
    CCTurnstile ts@(4, 1, &arena) @destroy;
    if (!ts.excl)
        return 1;
    int i;
    @parallel seq (use_par) wait (ts) for (i in 0..N) {
        if ((i % 2) == 0)
            continue;
        @stage (ts, 0, i) {
            xs[i] = i + 1;
        }
    } !>.wait()!>;
    return 0;
}

static int check(const char* tag, int use_par) {
    int xs[N];
    int i;
    for (i = 0; i < N; i++) xs[i] = 0;
    if (run(use_par, xs) != 0)
        return 1;
    for (i = 0; i < N; i++) {
        int want = (i % 2) ? i + 1 : 0;
        if (xs[i] != want) {
            fprintf(stderr, "FAIL %s xs[%d]=%d want=%d\n", tag, i, xs[i],
                    want);
            return 1;
        }
    }
    return 0;
}

int main(void) {
    if (check("seq", 0) != 0)
        return 1;
    if (check("par", 1) != 0)
        return 1;
    printf("parallel_wait_continue_smoke: OK\n");
    return 0;
}

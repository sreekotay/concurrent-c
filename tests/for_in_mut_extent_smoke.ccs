/* Mut walk through the access peel: vec, string, T[n]. */
#include <ccc/std/prelude.cch>
#include <stdio.h>

int main(void) {
    @errhandler(CCError e) {
        fprintf(stderr, "fatal: %s\n", e.message);
        return 1;
    }

    CCArena arena = cc_arena_heap(kilobytes(4)) @destroy;
    CCVec::[int] v;
    CCString s;
    int a[3] = { 1, 2, 3 };

    if (!cc_arena_is_live(arena)) return 2;
    v = cc_vec_new::[int](arena);
    if (v.push(1) != 0 || v.push(2) != 0 || v.push(3) != 0) return 3;
    for (&x in v) {
        x = x * 10;
    } !>;
    if (v.len != 3) return 4;
    if (v.data[0] != 10 || v.data[1] != 20 || v.data[2] != 30) return 5;

    s = cc_string_from_slice(arena, CC_SLICE_LIT("ab"));
    for (&c in s) {
        if (c >= 'a' && c <= 'z')
            c -= 32;
    } !>;
    if (s.len != 2) return 6;
    if (s.data()[0] != 'A' || s.data()[1] != 'B') return 7;

    for (i, &n in a) {
        n = n + (int)i;
    } !>;
    if (a[0] != 1 || a[1] != 3 || a[2] != 5) return 8;

    printf("for_in_mut_extent_smoke: OK\n");
    return 0;
}

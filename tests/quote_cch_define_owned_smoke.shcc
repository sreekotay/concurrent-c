/* Guest + owner: CFG_ON selects the static helper in the extract. */
CCArena a = cc_arena_heap(megabytes(1)) @destroy;

CCCommand build = cc_command(a, @slice("./cc/bin/ccc"));
build.arg("build");
build.arg("--no-cache");
build.arg("tests/quote_cch_define_owned_guest_mod.ccs");
build.arg("tests/quote_cch_define_owned_mod.ccs");
build.arg("-o");
build.arg("out/quote_cch_define_owned_smoke");
build.inherit_stdio();
int rc = build.status() !>;
if (rc != 0) {
    "build failed".println() !>;
    return 1;
}
CCCommand run = cc_command(a, @slice("out/quote_cch_define_owned_smoke"));
run.inherit_stdio();
rc = run.status() !>;
if (rc != 0) {
    "run failed".println() !>;
    return 1;
}
return 0;

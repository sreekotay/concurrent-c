#include <ccc/std/prelude.cch>

int main(void) {
    @errhandler(CCError e) { cc_error_log(e); return 1; }
    int[~ >] tx;
    int[~ <] rx;
    CCChan* ch = cc_channel_pair(&tx, &rx) !> @destroy;
    @parallel {
        @serial {
            tx.send(1) !>;
            tx.close();
        }
        @serial {
            int v = 0;
            rx.recv(&v) !>;
        }
    } !>.wait()!>;
    return 0;
}

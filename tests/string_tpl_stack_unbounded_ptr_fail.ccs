/* Arena-less @string with a pointer (C string) interpolation must be a
 * compile error: a char pointer's formatted width is unbounded
 * (spec/draft_variants.md §9.2).  The arena form accepts const char*
 * (pinned by tests/string_tpl_arena_unbounded_types_smoke.ccs). */
#include <ccc/std/prelude.cch>

int main(void) {
    const char* who = "ada";
    char[:] s = @string(`w=${who}`);
    (void)s;
    return 0;
}

/* Bare `x = call() !>;` must assign Ok `.u.value` (not discard it). */
#include <ccc/std/prelude.cch>
#include <stdio.h>

static int !>(CCError) get_int(int v) { return cc_ok(v); }

static int !>(CCError) add_via_assign(int a, int b) {
    @errhandler(CCError e) { return cc_err(e); }
    int x = 0;
    int y = 0;
    x = get_int(a) !>;
    y = get_int(b) !>;
    return cc_ok(x + y);
}

int main(void) {
    @errhandler(CCError e) {
        fprintf(stderr, "fatal: %s\n", e.message);
        return 1;
    }
    int got = 0;
    got = get_int(7) !>;
    if (got != 7) {
        fprintf(stderr, "assign unwrap: got=%d want=7\n", got);
        return 2;
    }
    int sum = add_via_assign(3, 4) !>;
    if (sum != 7) {
        fprintf(stderr, "host-fn assign unwrap: got=%d want=7\n", sum);
        return 3;
    }
    printf("ok\n");
    return 0;
}

/* Diagnostics oracle: coordinates INSIDE an @async state-machine body. */
#include <ccc/std/prelude.cch>

@async int oracle_body(int[~4 >] tx, int[~4 <] rx, int v) {
    @await tx.send(v) !>;
    int reply;
    @await rx.recv(&reply) !>;
    int x = cc_diag_oracle_undeclared_in_async(reply);   /* line 8 */
    return x;
}

int main(void) {
    @errhandler(CCError e) { fprintf(stderr, "%s\n", e.message); return 1; }
    int[~4 >] tx;
    int[~4 <] rx;
    CCChan* ch = cc_channel_pair(&tx, &rx) !> @destroy;
    (void)ch;
    return 0;
}

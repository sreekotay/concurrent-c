/* Impl-grade local header (the @variant forces the raw splice): defines a
 * map type and a DB struct holding it, then includes a nested sibling
 * that does UFCS on both — through a parameter and through the struct
 * field. Text after the nested include must still lower too. */
#ifndef IMPL_CCH_NESTED_UFCS_OUTER_CCH
#define IMPL_CCH_NESTED_UFCS_OUTER_CCH

@variant NestedUfcsVal {
    num: int64_t;
    flag: void;
};

typedef ArrayMap::[int, int] NestedUfcsMap;

typedef struct NestedUfcsDb {
    NestedUfcsMap entries;
} NestedUfcsDb;

#include "impl_cch_nested_ufcs_inner.cch"

static void nested_ufcs_destroy(NestedUfcsDb* db) {
    if (db && db->entries) db->entries->destroy();
}

#endif /* IMPL_CCH_NESTED_UFCS_OUTER_CCH */

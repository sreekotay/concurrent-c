/* Fail: unprotected arm projection on a schema `one of`. */
#include <ccc/std/prelude.cch>

@grammar(schema) Bulk {~~~~
    rules [
        digit:  charset [#'0' - #'9']
        number: keep [opt #'-' some digit]
    ]
    #'$' len: int number
    one of [
        nil  [= -1] [ "\r\n" ]
        data [>= 0] [ "\r\n" payload: bytes len "\r\n" ]
    ] by len
~~~~}

int main(void) {
    Bulk b = { .data = { .payload = cc_slice_hdr_from_buffer((void*)"x", 1) } };
    return (int)b.data.payload.len; /* ERROR: not dominated */
}

// `text_eq` is `Text`'s `eq`. Inside it, `a.eq(b)` on a `Text` that
// aliases a type with its own `eq` calls that one, not `text_eq` again;
// recursion is spelled by name.
#include <ccc/std/prelude.cch>
#include <stdio.h>

typedef char[:] Text;

static bool text_eq(Text a, Text b) { return a.eq(b); }

int main(void) {
    Text x = "abc";
    Text y = "abc";
    Text z = "abd";
    if (!text_eq(x, y) || text_eq(x, z) || !x.eq(y)) {
        printf("FAIL\n");
        return 1;
    }
    printf("ok\n");
    return 0;
}

/* Articulate-error pack for concurrent-c-python (in-process + isolated):
 * reserved keys, unsupported types, foreign args, use-after-release,
 * keep-past-return, proxy traps, scalar edges, SystemExit, bigint wire
 * limit, lazy-import fail, pass-unresolved module root, after-close.
 * No numpy.  Rungs in tests/cc_python_bridge_neg.js. */
CCArena a = cc_arena_heap(megabytes(1)) @destroy;

{
    CCCommand which = cc_command(a, @slice("sh"));
    which.arg("-c");
    which.arg("command -v node >/dev/null 2>&1 && command -v python3 >/dev/null 2>&1");
    int rc = which.status() !>;
    if (rc != 0) { "SKIP (need node + python3)".println() !>; return 0; }
}

/* Own artifact name so concurrent suite jobs do not race one .node path. */
{
    CCCommand build = cc_command(a, @slice("./cc/bin/ccc"));
    build.arg("build");
    build.arg("npm/cc-python/src/cc_python.ccs");
    build.arg("-o");
    build.arg("bin/cc_python_neg.node");
    build.inherit_stdio();
    int rc = build.status() !>;
    if (rc != 0) { "build failed".println() !>; return 1; }
}

{
    CCCommand run = cc_command(a, @slice("sh"));
    run.arg("-c");
    run.arg("CC_PYTHON_ADDON=$PWD/bin/cc_python_neg.node node tests/cc_python_bridge_neg.js");
    run.inherit_stdio();
    int rc = run.status() !>;
    if (rc != 0) { "cc-python neg suite failed".println() !>; return 1; }
}
return 0;

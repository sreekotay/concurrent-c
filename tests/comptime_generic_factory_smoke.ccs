#include <ccc/std/prelude.cch>
#include <ccc/cc_instantiate.cch>
#include <stdio.h>

/* D6.0: user generic factories (modeled on UFCS).  A library registers HOW its
 * generic lowers to C via a declarative template; the compiler recognizes
 * `Pair::[A, B]` use sites, computes a mangled name (`Pair_A_B`), expands the
 * template once per unique instantiation ($0 = mangled name, $1..$N = the type
 * args), emits it at the prelude anchor, and rewrites the use site to the
 * mangled name.  The library owns the lowering; the compiler owns the splice. */

@comptime {
    cc_generic_template("Pair", 2,
        "typedef struct { $1 first; $2 second; } $0;\n"
        "static inline $0 $0_make($1 a, $2 b) { $0 r; r.first = a; r.second = b; return r; }\n");
}

int main(void) {
    Pair::[int, double] p = Pair_int_double_make(3, 2.5);
    Pair::[int, int]    q = Pair_int_int_make(10, 20);

    if (p.first != 3) return 1;
    if (q.second != 20) return 2;

    printf("comptime_generic_factory_smoke ok p=%d,%g q=%d,%d\n",
           p.first, p.second, q.first, q.second);
    return 0;
}

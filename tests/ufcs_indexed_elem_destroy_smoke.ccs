/* `T *bufs` + `[i]` is a T value. `.destroy()` is the UFCS, not `->`
 * and not `(&w->bufs[i])->destroy()`. */
#include <ccc/std/prelude.cch>
#include <assert.h>
#include <stdio.h>

typedef struct {
    int n;
} Elem;

static int g_n;

static void Elem_destroy(Elem *e) {
    if (!e) return;
    g_n += e->n;
    e->n = 0;
}

typedef struct {
    Elem *bufs;
    size_t len;
} Ws;

int main(void) {
    Elem storage[2] = {{1}, {2}};
    Ws w = {storage, 2};
    Ws *p = &w;
    Elem *local = storage;
    size_t i;

    g_n = 0;
    for (i = 0; i < p->len; i++)
        p->bufs[i].destroy();
    assert(g_n == 3);
    assert(storage[0].n == 0 && storage[1].n == 0);

    storage[0].n = 4;
    storage[1].n = 5;
    g_n = 0;
    for (i = 0; i < 2; i++)
        local[i].destroy();
    assert(g_n == 9);

    printf("ok\n");
    return 0;
}

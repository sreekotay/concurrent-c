/* A bare `!>` inside a `@destroy { D }` body: the body runs at the scope
 * exit of the declaration, and its unwrap forwards to the handler in
 * scope there, like any other statement of that scope. Nothing is left
 * for the host compiler. */
#include <ccc/std/prelude.cch>
#include <stdio.h>
typedef struct { int n; } Slot;
static int g_flushed = 0;
static int !>(CCError) slot_flush(Slot* s) { g_flushed++; (void)s; return cc_ok(0); }
int main(void) {
    @errhandler(CCError e) { fprintf(stderr, "fatal: %s\n", e.message); return 1; }
    {
        Slot s = {0} @destroy { slot_flush(&s) !>; };
        s.n = 1;
    }
    printf("flushed=%d\n", g_flushed);
    return 0;
}

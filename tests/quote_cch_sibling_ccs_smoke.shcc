/* Sibling `.ccs` owns impl/UFCS bodies. The umbrella consumer extracts
 * decls; the defining TU still splices. */
CCArena a = cc_arena_heap(megabytes(1)) @destroy;

CCCommand emit_main = cc_command(a, @slice("./cc/bin/ccc"));
emit_main.arg("--no-cache");
emit_main.arg("--emit-c-only");
emit_main.arg("tests/quote_cch_sibling_ccs_main_mod.ccs");
emit_main.arg("-o");
emit_main.arg("out/quote_cch_sibling_ccs_main.c");
emit_main.inherit_stdio();
int rc = emit_main.status() !>;
if (rc != 0) {
    "emit parent failed".println() !>;
    return 1;
}

CCCommand grep_parent = cc_command(a, @slice("grep"));
grep_parent.arg("-q");
grep_parent.arg("SIBLING_LEAF_BODY_MUST_NOT_SPLICE");
grep_parent.arg("out/quote_cch_sibling_ccs_main.c");
rc = grep_parent.status() !>;
if (rc == 0) {
    "parent TU spliced sibling leaf".println() !>;
    return 1;
}

CCCommand emit_leaf = cc_command(a, @slice("./cc/bin/ccc"));
emit_leaf.arg("--no-cache");
emit_leaf.arg("--emit-c-only");
emit_leaf.arg("tests/quote_cch_sibling_ccs_leaf_mod.ccs");
emit_leaf.arg("-o");
emit_leaf.arg("out/quote_cch_sibling_ccs_leaf.c");
emit_leaf.inherit_stdio();
rc = emit_leaf.status() !>;
if (rc != 0) {
    "emit leaf failed".println() !>;
    return 1;
}

CCCommand grep_leaf = cc_command(a, @slice("grep"));
grep_leaf.arg("-q");
grep_leaf.arg("SIBLING_LEAF_BODY_MUST_NOT_SPLICE");
grep_leaf.arg("out/quote_cch_sibling_ccs_leaf.c");
rc = grep_leaf.status() !>;
if (rc != 0) {
    "defining TU did not splice sibling leaf".println() !>;
    return 1;
}

CCCommand build = cc_command(a, @slice("./cc/bin/ccc"));
build.arg("build");
build.arg("--no-cache");
build.arg("tests/quote_cch_sibling_ccs_main_mod.ccs");
build.arg("tests/quote_cch_sibling_ccs_leaf_mod.ccs");
build.arg("-o");
build.arg("out/quote_cch_sibling_ccs_smoke");
build.inherit_stdio();
rc = build.status() !>;
if (rc != 0) {
    "build failed".println() !>;
    return 1;
}
CCCommand run = cc_command(a, @slice("out/quote_cch_sibling_ccs_smoke"));
run.inherit_stdio();
rc = run.status() !>;
if (rc != 0) {
    "run failed".println() !>;
    return 1;
}
return 0;

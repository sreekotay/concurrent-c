#include <ccc/std/prelude.cch>
#include <ccc/cc_type.cch>
#include <stdio.h>

/* D3.1(A): `@comptime if` predicates that need real target-ABI layout numbers
 * (sizeof/_Alignof) are decided in-process via the TCC constexpr seam.  The
 * dead branches reference undefined symbols, proving the predicate is folded at
 * compile time and the untaken arm is pruned before compilation.
 *
 * Branches cover both LP64 (long 8) and ILP32 (long 4). */
int main(void) {
    int acc = 0;

    @comptime if (type_of(long).size >= 8) {
        acc += 1;
    } else @comptime if (type_of(long).size == 4) {
        acc += 1;
    } else {
        acc += never1;
    }

    /* structural fact AND layout fact in one predicate */
    @comptime if (type_of(int).kind == CC_TK_PRIMITIVE && type_of(int).size == 4) {
        acc += 10;
    } else {
        acc += never2;
    }

    /* alignment + arithmetic */
    @comptime if (type_of(double).align * 2 == 16) {
        acc += 100;
    } else {
        acc += never3;
    }

    /* bare host-C constant expression — true on LP64, false on ILP32 */
    @comptime if (sizeof(int) < sizeof(long)) {
        acc += 1000;
    } else @comptime if (sizeof(int) == sizeof(long)) {
        acc += 1000;
    } else {
        acc += never4;
    }

    printf("comptime_if_layout_smoke acc=%d\n", acc);
    return acc == 1111 ? 0 : 1;
}

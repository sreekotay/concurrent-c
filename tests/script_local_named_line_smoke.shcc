#!/usr/bin/env -S ./cc/bin/ccc
/*
 * `line` and `nr` are the -n/-p loop bindings, never ambient in a file .shcc.
 * A script declaring its own local of either name must not pull in an implicit
 * `stdin` BufReader: the predecl is emitted above the script body.
 *
 * Covers the identifiers in plain code and inside a ${...} template hole,
 * which the predecl scan also walks as code.
 */

CCArena arena = @create(kilobytes(4)) @destroy;

int line = 7;
int nr = 3;

@string(`line=${line} nr=${nr}`, arena).println();

char *p = "abc";
char *line2 = p;
if (!line2) return 1;

return 0;

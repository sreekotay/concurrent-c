/* A Python failure carries its exception class and, when the failure
 * crossed Python frames, the formatted traceback — both anchored in
 * the handle's scratch arena. */
#include <ccc/script/py.cch>

CCPy py = cc_py_new(false, arena) !> @destroy;
CCPyObj b = py.import("builtins") !> @destroy;

int64_t n = b.int("notanum") !>(e) {
    println(@string(`type=${e.type_name}`, arena));
    println(@string(`has_msg=${(int)(e.base.message != NULL)}`, arena));
    return 0;
};
(void)n;

/* Smoke: @unsafe allows pointee mutation through a value-captured alias. */
#include <ccc/cc_nursery.cch>
#include <stdio.h>

int main(void) {
    @errhandler(CCError e) cc_error_exit(e);
    int x = 0;
    int* p = &x;

    {
        CCNursery n = @create() !> @destroy;
        n.spawn(@unsafe () => [p] {
            *p = 1;
        }) !>;
    }

    if (x != 1) return 1;
    printf("closure_ptr_alias_unsafe_mutation_smoke: ok\n");
    return 0;
}

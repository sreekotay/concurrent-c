/* Basic compile smoke through libtcc / CONFIG_CC_EXT (historically M5).
 * Keeps a minimal TU that must lower + host-compile after TCC patch shrink. */
#include <ccc/cc_runtime.cch>
#include <stdio.h>

static int square(int x) { return x * x; }

int main(void) {
    int s = 0;
    for (int i = 1; i <= 4; ++i) s += square(i);
    printf("sumsq=%d\n", s);
    return s == 30 ? 0 : 1;
}

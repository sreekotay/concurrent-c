#include <ccc/cc_runtime.cch>
#include <ccc/cc_closure.cch>
#include <ccc/std/task.cch>

int g = 0;

@async int noop(int v) { return v; }

@async int f(int flag) {
    @errhandler(CCError e) cc_error_exit(e);
    g = 0;
    if (flag)
        {
            CCNursery __cc_nursery3 = @create() !> @destroy;

            __cc_nursery3.spawn(() => { g = 9; });
        
        }
    int x = @await noop(g);
    return x;
}

int main(void) {
    CCTaskIntptr t = f(1);
    intptr_t r = cc_block_on_intptr(t);
    return (r == 9) ? 0 : 1;
}


/* User @typehooks .len / .access + @for (v in bag). */
#include <ccc/std/prelude.cch>
#include <stdio.h>

typedef struct {
    int *p;
    size_t n;
} Bag;

@typehooks on Bag {
    .len = cc_type_len_field("n"),
    .access = cc_type_access_load("p"),
};

int main(void) {
    int xs[3] = { 4, 5, 6 };
    Bag b;
    int sum = 0;
    b.p = xs;
    b.n = 3;
    @for (v in b)
        sum += v;
    if (sum != 15) return 1;
    if (b.n != 3) return 2;
    printf("ok\n");
    return 0;
}

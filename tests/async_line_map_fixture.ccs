/*
 * Thick-enough @async body for scripts/test_async_line_map.sh.
 * Pins per-statement #line markers inside the lowered poll fn without
 * depending on a redis server twin.
 */
#include <ccc/std/prelude.cch>
#include <ccc/cc_nursery.cch>
#include <ccc/std/task.cch>
#include <stdio.h>

static int g_acc;

static int step_a(int x) { return x + 1; }
static int step_b(int x) { return x - 1; }
static int step_c(int x) { return x * 2; }

@async int handle_client(int n) {
    int i;
    int local = 0;
    int a = 0;
    int b = 0;
    int c = 0;
    for (i = 0; i < n; i++) {
        local += i;
        a = step_a(local);
        b = step_b(a);
        c = step_c(b);
        if ((i & 1) != 0) {
            local += a;
            local += 1;
        } else {
            local -= b;
            local -= 1;
        }
        if (local < 0) {
            local = 0;
            a = 0;
        }
        if (local > 1000000) {
            local = 1000000;
            b = 0;
        }
        g_acc += local;
        g_acc += c;
        if ((i & 3) == 0) {
            local += 2;
            g_acc += 2;
            a += 2;
        }
        if ((i & 7) == 0) {
            local += 3;
            g_acc += 3;
            b += 3;
        }
        if ((i & 15) == 0) {
            local += 5;
            g_acc += 5;
            c += 5;
        }
        if ((i & 31) == 0) {
            local += 7;
            g_acc += 7;
            a += b;
            b += c;
        }
        if ((i & 63) == 0) {
            local += 11;
            g_acc += 11;
            c += a;
        }
        local += a + b + c;
        if (local < 0) local = -local;
        if (local > 2000000) local = local / 2;
    }
    g_acc += local;
    return local;
}

int main(void) {
    @errhandler(CCError e) { (void)e; return 1; }
    g_acc = 0;
    CCNursery n = cc_nursery_create() !> @destroy;
    n.spawn_async(handle_client(64));
    printf("async_line_map_fixture: OK acc=%d\n", g_acc);
    return 0;
}

/* A face's Name::[args] reaches host C spelled out (no leftover ::[).
 * The face is a member of the program module, so its text is in the
 * emitted C, not in a .h of its own. */
CCArena arena = cc_arena_heap(megabytes(1)) @destroy;

CCCommand emit = cc_command(arena, @slice("./cc/bin/ccc"));
emit.arg("--no-cache");
emit.arg("--emit-c-only");
emit.arg("tests/quote_cch_generic_face_smoke.ccs");
emit.arg("-o");
emit.arg("out/quote_cch_generic_face_smoke.c");
emit.inherit_stdio();
int rc = emit.status() !>;
if (rc != 0) {
    "emit guest failed".println();
    return 1;
}

CCCommand grep_col = cc_command(arena, @slice("grep"));
grep_col.arg("-q");
grep_col.arg("-E");
grep_col.arg("::\\[(int|char)");
grep_col.arg("out/quote_cch_generic_face_smoke.c");
rc = grep_col.status() !>;
if (rc == 0) {
    "emitted C still has ::[".println();
    return 1;
}

CCCommand grep_pair = cc_command(arena, @slice("grep"));
grep_pair.arg("-q");
grep_pair.arg("QuotePair_int_int");
grep_pair.arg("out/quote_cch_generic_face_smoke.c");
rc = grep_pair.status() !>;
if (rc != 0) {
    "emitted C missing QuotePair_int_int".println();
    return 1;
}

CCCommand grep_vec = cc_command(arena, @slice("grep"));
grep_vec.arg("-q");
grep_vec.arg("CCVec_char");
grep_vec.arg("out/quote_cch_generic_face_smoke.c");
rc = grep_vec.status() !>;
if (rc != 0) {
    "emitted C missing CCVec_char".println();
    return 1;
}

"ok".println();
return 0;

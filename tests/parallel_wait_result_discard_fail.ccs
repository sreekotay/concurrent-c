#include <ccc/std/prelude.cch>

int main(void) {
    @errhandler(CCError e) { return 1; }
    CCArena arena = cc_arena_heap(kilobytes(64)) @destroy;
    CCTurnstile ts@(4, 2, 1, &arena) @destroy;
    int i;
    @parallel wait (ts) for (i in 0..4) {
        if (i == 2)
            break;
    }
    return 0;
}

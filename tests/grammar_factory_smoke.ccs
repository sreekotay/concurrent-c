// FACTORY MODEL smoke: grammars are comptime factories, every use is a
// compile-time specialization, runtime instances are cursors. The call-site
// surface is the cc_* operations from <ccc/cc_grammar.cch> (via the prelude);
// the Name_* functions they expand to are the documented lowering contract
// (each generated splice begins with a manifest listing its API).
//
//   define      grammar_factory_kv.rules — a grammar as a FILE artifact
//   specialize  Kv (rules block, match projection) and Pair (schema) both
//               `include "..."` the same factory and stamp flat C
//   instantiate PairReader — a cursor (buffer, pos, arena); all behavior
//               was specialized at compile time, the instance is only state
//
// Demand gating: this file references only Kv_match, so Kv's DOM/collect
// tiers (tape, unwind, accessors) are never emitted — instantiation happens
// at use, not at declaration.
#include <ccc/std/prelude.cch>

@grammar(rules) Kv {~~~~
    include "grammar_factory_kv.rules"
~~~~}

@grammar(schema) Pair {~~~~
    rules [ include "grammar_factory_kv.rules" ]
    ws k: key ws #'=' ws v: value ws
~~~~}

// use "path" as Name — file-backed SHARED factory: no wrapper block, and
// every schema using the same path shares one emitted matcher set
@grammar(schema) PairQ {~~~~
    use "grammar_factory_kv.rules" as KvF
    KvF.ws k: KvF.key KvF.ws #'=' KvF.ws v: KvF.value KvF.ws
~~~~}

@grammar(schema) PairQ2 {~~~~
    use "grammar_factory_kv.rules" as KvG
    KvG.pair
~~~~}

// include + override: a block definition SHADOWS the included rule — this is
// how a factory is specialized without forking its file. Overrides don't
// claim the entry point (still `pair`, the file's first rule).
@grammar(rules) KvHex {~~~~
    include "grammar_factory_kv.rules"
    value: keep [some charset [#'0' - #'9' #'a' - #'f']]
~~~~}

/* nested .rules specialization (include-inside-include override) */
@grammar(rules) KvHexF {~~~~
    include "grammar_factory_hex.rules"
~~~~}

/* SIBLING includes stay first-wins (diamonds legal): the plain kv factory
 * first, then the hex-specialized one — `value` must remain plain digits.
 * Only a file's OWN later definitions may override its OWN includes. */
@grammar(rules) KvSib {~~~~
    include "grammar_factory_kv.rules"
    include "grammar_factory_hex.rules"
~~~~}

static int slice_is(CCSlice s, const char* want) {
    size_t l = strlen(want);
    return s.len == l && memcmp(s.ptr, want, l) == 0;
}

int main(void) {
    CCArena arena = cc_arena_create(1 << 20);

    /* specialization 1: recognizer from the file factory */
    if (!cc_match(Kv, "a = 42", 6)) { printf("FAIL: kv match\n"); return 1; }
    if (cc_match(Kv, "a =", 3)) { printf("FAIL: kv bad accepted\n"); return 1; }

    /* specialization 2: typed struct from the same factory */
    {
        Pair p;
        if (!cc_parse(Pair, "x=7", 3, arena, &p)) { printf("FAIL: pair parse\n"); return 1; }
        if (!slice_is(p.k, "x") || !slice_is(p.v, "7")) { printf("FAIL: pair fields\n"); return 1; }
    }

    /* specialization 3: file-backed shared factory, no wrapper block */
    {
        PairQ q;
        if (!cc_parse(PairQ, "ab = 12", 7, arena, &q)) { printf("FAIL: pairq parse\n"); return 1; }
        if (!slice_is(q.k, "ab") || !slice_is(q.v, "12")) { printf("FAIL: pairq fields\n"); return 1; }
        PairQ2 q2;
        if (!cc_parse(PairQ2, "c=3", 3, arena, &q2)) { printf("FAIL: pairq2 parse\n"); return 1; }
    }

    /* include + override: hex values accepted by KvHex, rejected by Kv */
    if (!cc_match(KvHex, "x = ff", 6)) { printf("FAIL: hex override\n"); return 1; }
    if (cc_match(Kv, "x = ff", 6)) { printf("FAIL: base accepts hex\n"); return 1; }
    if (!cc_match(KvHexF, "x = ff", 6)) { printf("FAIL: nested hex factory\n"); return 1; }

    /* sibling include conflict: FIRST include owns `value` (plain digits) */
    if (!cc_match(KvSib, "x = 12", 6)) { printf("FAIL: sibling first-wins digits\n"); return 1; }
    if (cc_match(KvSib, "x = ff", 6)) { printf("FAIL: sibling include overrode first\n"); return 1; }

    /* runtime instance: a Reader cursor over a pair stream */
    {
        const char* src = "a=1 b=22 c=333";
        PairReader r = cc_reader(Pair, src, strlen(src), arena);
        int cnt = 0;
        Pair p;
        while (cc_next(Pair, &r, &p)) cnt++;
        if (cnt != 3 || !cc_at_end(Pair, &r)) { printf("FAIL: reader cnt=%d\n", cnt); return 1; }
        if (!slice_is(p.k, "c") || !slice_is(p.v, "333")) { printf("FAIL: reader last\n"); return 1; }
        /* parse error mid-stream: _next returns 0 with the cursor mid-input */
        r = cc_reader(Pair, "a=1 !", 5, arena);
        cnt = 0;
        while (cc_next(Pair, &r, &p)) cnt++;
        if (cnt != 1 || cc_at_end(Pair, &r)) { printf("FAIL: reader error state\n"); return 1; }
    }

    /* UFCS forms: type-scoped statics (`Type.method(...)` -> Type_method)
     * and instance methods on cursors (receiver-typed lowering, registered
     * natively by the engine — no user-written registration) */
    {
        if (!Kv.match("b = 7", 5)) { printf("FAIL: ufcs type-scoped match\n"); return 1; }
        Pair p2;
        if (!Pair.parse("y=8", 3, arena, &p2)) { printf("FAIL: ufcs type-scoped parse\n"); return 1; }
        if (!slice_is(p2.k, "y") || !slice_is(p2.v, "8")) { printf("FAIL: ufcs parse fields\n"); return 1; }
        PairReader r2 = Pair.reader("m=1 n=2", 7, arena);
        int cnt2 = 0;
        while (r2.next(&p2)) cnt2++;
        if (cnt2 != 2 || !r2.at_end()) { printf("FAIL: ufcs reader cnt=%d\n", cnt2); return 1; }
        if (!slice_is(p2.k, "n") || !slice_is(p2.v, "2")) { printf("FAIL: ufcs reader last\n"); return 1; }
    }

    cc_arena_free(&arena);
    printf("grammar factory model OK\n");
    return 0;
}

int g = 0;

int main(void) {
    @errhandler(CCError e) cc_error_exit(e);
    int buf[2] = {1, 2};
    CCSlice s = cc_slice_from_buffer(buf, 2);
    CCSlice t = cc_move(s);
    (void)t;
    {
        CCNursery __cc_nursery84 = @create() !> @destroy;

        __cc_nursery84.spawn (() => {
            // illegal: s was moved before closure creation
            if (s.len == 2) g = 1;
        }) !>;
    
    }
    return g;
}


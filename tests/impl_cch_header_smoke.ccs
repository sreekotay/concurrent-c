/* Implementation-grade .cch headers: a local header carrying @variant
 * (plain and packed), @errhandler, @defer, and !> unwraps is a module of
 * one, lowered by the full pipeline as its own unit and linked in; this
 * program sees its .h.  Repeat inclusion is inert (the header's own
 * guard). */
#include <ccc/std/prelude.cch>
#include <stdio.h>
#include "impl_cch_header_helper.cch"
#include "impl_cch_header_helper.cch"

int main(void) {
    char[:0] a = "40";
    char[:0] b = "2";
    printf("sum=%lld\n", (long long)helper_sum(a, b));
    printf("cell=%lld\n", (long long)helper_cell_roundtrip(7));
    return 0;
}

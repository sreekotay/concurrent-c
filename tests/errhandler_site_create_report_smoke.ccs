/* Site `!>(e)` on `@(create) @destroy` is not the scope @errhandler.
 * Bare `!>;` in that body reports through the enclosing handler. */
#include <ccc/cc_runtime.cch>
#include <ccc/stdio.cch>
#include <ccc/std/io.cch>

int main(void) {
    @errhandler(CCIoError e) { cc_error_log(e.base); return 1; }
    CCFile f@("/dev/null") !>(e) {
        println(@string(`open failed`, @scratch));
        return 1;
    } @destroy;
    /* the same create with no site handler: this one is what the scope
     * handler is for */
    CCFile g@("/dev/null") !> @destroy;
    (void)f;
    (void)g;
    println("ok");
    return 0;
}

/* cap < 1 is INVALID_ARG — create is Result, not a dead value. */
#include <ccc/std/prelude.cch>
#include <stdio.h>

int main(void) {
    @errhandler(CCError e) {
        if (e.kind != CC_ERR_INVALID_ARG) return 1;
        printf("ok\n");
        return 0;
    }
    CCArena arena = cc_arena_heap(kilobytes(4)) @destroy;
    CCTurnstileRW ts@(0, arena) !> @destroy;
    return 1;
}

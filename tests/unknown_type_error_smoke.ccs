/* Unknown CamelCase is left for host-cc (passthrough includes never
 * register those typedefs). Host-cc must still say
 * "unknown type name 'SomeUndefinedType'" — not a lowerer parse miss. */
#include <ccc/std/prelude.cch>

int main(void) {
    SomeUndefinedType my_var = {0};
    (void)my_var;
    return 0;
}

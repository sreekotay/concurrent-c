#include <ccc/std/prelude.cch>
#include <assert.h>

/* cc_arena_malloc: fixed root + overflow (durable store policy). */
int main(void) {
    CCArena a = cc_arena_malloc(64) @destroy;
    assert(cc_arena_is_live(a));
    assert(a.a->block_max == 1);
    assert(a.a->_flags & CC_ARENA_FLAG_ALLOW_HEAP_OVERFLOW);

    /* Bigger than root → overflow malloc, individually releasable. */
    void* p = cc_arena_alloc(a, 128, 8);
    assert(p);
    assert(a.a->_flags & CC_ARENA_FLAG_USED_HEAP_OVERFLOW);
    assert(cc_arena_release(a, p));

    cc_arena_stack(scratch, 32);
    assert(cc_arena_is_live(scratch));
    assert(scratch.a->block_max == CC_ARENA_DEFAULT_BLOCK_MAX);
    assert(scratch.a->_flags & CC_ARENA_FLAG_ALLOW_HEAP_OVERFLOW);
    return 0;
}

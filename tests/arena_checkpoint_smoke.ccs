// Test: arena checkpoints restore allocation position without invalidating prior allocations
#include <ccc/std/prelude.cch>
#include <assert.h>
#include <stdlib.h>
#include <stdio.h>

int main(void) {
    char buffer[1024];

    {
        CCArena __cc_arena1 = @create(buffer, sizeof(buffer)) @destroy;
        if (!cc_arena_is_live(__cc_arena1)) abort();
        CCArena arena = __cc_arena1;
        int* a1 = cc_arena_alloc_T(int, arena);
        assert(a1 != NULL);
        *a1 = 11;

        CCArenaCheckpoint cp = cc_arena_checkpoint(arena);
        assert(cp.arena != NULL && cp.parent == arena.a);
        /* The child region counts as one live allocation of the parent. */
        assert(cc_arena_slab_live(arena.a) == 2);

        int* a2 = cc_arena_alloc_T_count(int, arena, 4);
        assert(a2 != NULL);
        a2[0] = 22;
        /* Scratch lands in the child, not the parent's count. */
        assert(cc_arena_slab_live(arena.a) == 2);
        assert(cc_arena_slab_live(cp.arena) == 1);

        // Restore: the child dies and the parent tip pops back
        assert(cc_arena_restore(cp));
        assert(cc_arena_slab_live(arena.a) == 1);
        assert(cc_arena_slab_offset(arena.a) == cp.offset);

        int* a3 = cc_arena_alloc_T_count(int, arena, 4);
        assert(a3 != NULL);
        // Lands at the checkpoint offset, at or below the scratch a2 used
        assert((uint8_t*)a3 == arena.a->slab->base + cp.offset);
        assert((uint8_t*)a3 <= (uint8_t*)a2);

        // Allocation before checkpoint should remain valid
        assert(*a1 == 11);
    
    }

    printf("arena_checkpoint_smoke: OK\n");
    return 0;
}

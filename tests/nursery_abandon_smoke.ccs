#!ccc ccs
#include <ccc/cc_runtime.cch>
#include <ccc/cc_atomic.cch>
#include <ccc/cc_channel.cch>

#include <errno.h>
#include <stdio.h>

static cc_atomic_int g_ran;

static void finish_flag(void* p) {
    cc_atomic_store((cc_atomic_int*)p, 1);
}

static int wait_flag(cc_atomic_int* f, int ms) {
    int i;
    for (i = 0; i < ms; i++) {
        if (cc_atomic_load(f) == 1)
            return 1;
        cc_sleep_ms(1);
    }
    return 0;
}

int main(void) {
    @errhandler(CCError e) cc_error_exit(e);
    {
        cc_atomic_int done = 0;
        CCNursery n = cc_nursery_create() !>;
        n.leave(&done, finish_flag) !>;
        if (!wait_flag(&done, 1000)) return 4;
    }

    {
        cc_atomic_int done = 0;
        CCNursery n = cc_nursery_create() !>;
        cc_nursery_register_leftover_host(n.p, &done, finish_flag) !>;
        {
            CCResult_void_CCError r =
                cc_nursery_register_leftover_host(n.p, &done, finish_flag);
            if (r.ok) return 3;
            if (r.u.error.kind != CC_ERR_INVALID_ARG) return 3;
        }
        n.leave();
        if (!wait_flag(&done, 1000)) return 4;
    }

    {
        cc_atomic_int done = 0;
        CCNursery n = cc_nursery_create() !>;
        cc_atomic_store(&g_ran, 0);
        n.spawn(() => { cc_atomic_store(&g_ran, 1); }) !>;
        n.leave(&done, finish_flag) !>;
        if (!wait_flag(&done, 2000)) return 13;
        if (cc_atomic_load(&g_ran) != 1) return 14;
    }

    {
        cc_atomic_int done = 0;
        CCNursery n = cc_nursery_create() !>;
        n.spawnhybrid(() => { cc_sleep_ms(5); }) !>;
        n.leave(&done, finish_flag) !>;
        if (!wait_flag(&done, 2000)) return 18;
    }

    {
        CCChanTx tx;
        CCChanRx rx;
        int tmp = 0;
        if (cc_chan_pair_create(1, CC_CHAN_MODE_BLOCK, false, sizeof(int),
                                &tx, &rx) != 0)
            return 20;
        CCNursery n = cc_nursery_create() !>;
        n.close(tx) !>;
        n.leave();
        CCResult_bool_CCIoError tr = chan_try_recv(rx, &tmp);
        if (!(cc_is_ok(tr) && !cc_unwrap(tr))) return 23;
        chan_free(tx);
    }

    {
        CCChanTx tx;
        CCChanRx rx;
        cc_atomic_int done = 0;
        int v = 1;
        if (cc_chan_pair_create(0, CC_CHAN_MODE_BLOCK, false, sizeof(int),
                                &tx, &rx) != 0)
            return 30;
        CCNursery n = cc_nursery_create() !>;
        n.spawn(() => [rx] {
            int x = 0;
            (void)chan_recv(rx, &x);
        }) !>;
        n.leave(&done, finish_flag) !>;
        {
            int saw = 0;
            n.spawn(() => {}) !>(e) {
                saw = 1;
                if (e.kind != CC_ERR_INVALID_ARG) return 34;
            };
            if (!saw) return 34;
        }
        if (!cc_io_avail(chan_send(tx, v))) return 35;
        if (!wait_flag(&done, 2000)) return 36;
        chan_free(tx);
    }

    {
        int i;
        for (i = 0; i < 1000; i++) {
            cc_atomic_int done = 0;
            CCNursery n = cc_nursery_create() !>;
            n.spawn(() => {}) !>;
            n.leave(&done, finish_flag) !>;
            if (!wait_flag(&done, 2000)) return 43;
        }
    }

    printf("nursery_abandon_smoke: OK\n");
    return 0;
}

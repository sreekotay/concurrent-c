/* Non-static char[:] !>(E) must emit Result specs after E exists. */
#include <ccc/std/prelude.cch>
#include <stdio.h>

typedef struct {
    const char *message;
} SliceUserErr;

static SliceUserErr slice_user_err(const char *msg) {
    SliceUserErr e;
    e.message = msg ? msg : "err";
    return e;
}

char[:] !>(SliceUserErr) slice_user_span(const char *p, size_t n) {
    if (!p) return cc_err(slice_user_err("null"));
    return cc_ok(cc_slice_from_buffer((char *)p, n));
}

int main(void) {
    @errhandler(SliceUserErr e) {
        (void)e;
        return 1;
    }
    char buf[3] = "hi";
    char[:] s = slice_user_span(buf, 2) !>;
    if (s.len != 2) return 2;
    printf("ok\n");
    return 0;
}

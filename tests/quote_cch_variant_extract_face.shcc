/* Extracted guest .h is enum+union C — not arena leftover @variant sigil,
 * and not an impl-grade splice of the face. */
CCArena arena = cc_arena_heap(megabytes(1)) @destroy;

CCCommand emit = cc_command(arena, @slice("./cc/bin/ccc"));
emit.arg("--no-cache");
emit.arg("--emit-c-only");
emit.arg("tests/quote_cch_variant_extract_smoke.ccs");
emit.arg("-o");
emit.arg("out/quote_cch_variant_extract_smoke.c");
emit.inherit_stdio();
int rc = emit.status() !>;
if (rc != 0) {
    "emit guest failed".println();
    return 1;
}

CCCommand grep_sigil = cc_command(arena, @slice("grep"));
grep_sigil.arg("-q");
grep_sigil.arg("@variant QuoteVaCell");
grep_sigil.arg("out/include/tests/quote_cch_variant_extract.h");
rc = grep_sigil.status() !>;
if (rc == 0) {
    "extracted .h still has @variant".println();
    return 1;
}

CCCommand grep_kind = cc_command(arena, @slice("grep"));
grep_kind.arg("-q");
grep_kind.arg("QuoteVaCellKind");
grep_kind.arg("out/include/tests/quote_cch_variant_extract.h");
rc = grep_kind.status() !>;
if (rc != 0) {
    "extracted .h missing QuoteVaCellKind".println();
    return 1;
}

CCCommand grep_splice = cc_command(arena, @slice("grep"));
grep_splice.arg("-q");
grep_splice.arg("impl_cch_begin:.*quote_cch_variant_extract.cch");
grep_splice.arg("out/quote_cch_variant_extract_smoke.c");
rc = grep_splice.status() !>;
if (rc == 0) {
    "guest spliced interface variant face".println();
    return 1;
}

"ok".println();
return 0;

#include <ccc/std/prelude.cch>
#include <ccc/script/py.cch>
#include <stdio.h>
#include <string.h>

/* Default `.as_slice()` uses `cc_py` scratch; `.as_slice_into` overrides.
 * Skips cleanly when libpython is unavailable. */
int main(void) {
    @errhandler(CCError e) {
        fprintf(stderr, "fatal: %s\n", e.message);
        return 1;
    }

    CCArena a = cc_arena_heap(kilobytes(4)) @destroy;
    CCArena other = cc_arena_heap(kilobytes(4)) @destroy;
    if (!a.valid() || !other.valid()) return 1;

    if (!cc_py_available()) { puts("py_as_slice_materialize_smoke: SKIP (no libpython)"); return 0; }
    CCPy py = cc_py_new(false, a) !>;
    if (cc_arena_host(py.arena) != cc_arena_host(a)) return 2;

    CCPyObj sys = py.import("sys") !> @destroy;
    if (sys.home != &py) return 3;
    CCPyObj ver = sys.get("version") !> @destroy;
    if (ver.home != &py) return 4;

    CCSlice vs = ver.as_slice() !>;
    if (!vs.ptr || vs.len == 0) return 5;
    if (!cc_slice_is_from_arena_epoch(vs, a)) return 6;

    void *ptr = vs.ptr;
    size_t len = vs.len;
    vs.materialize_in(a) !>;
    if (vs.ptr != ptr || vs.len != len) return 7;

    CCSlice alt = ver.as_slice_into(other) !>;
    if (!cc_slice_is_from_arena_epoch(alt, other)) return 8;
    void *alt_ptr = alt.ptr;
    alt.materialize_in(other) !>;
    if (alt.ptr != alt_ptr) return 9;
    if (alt.len != len || memcmp(alt.ptr, ptr, len) != 0) return 10;

    cc_py_close(&py);
    puts("py_as_slice_materialize_smoke: PASS");
    return 0;
}

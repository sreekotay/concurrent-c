/* Named as: UFCS retry: Outer.write → cc_file_write(&outer.file, …). */
#include <ccc/std/prelude.cch>
#include <assert.h>
#include <stdio.h>
#include <string.h>

typedef struct {
    CCFile file;
    int tag;
} AsFileWrap;

@typeview on AsFileWrap {
    as: file;
};

int main(void) {
    AsFileWrap w = {0};
    w.tag = 7;
    w.create("tmp/as_field_ufcs_smoke.txt") !>(e) {
        fprintf(stderr, "create: %s\n", cc_error_str(e));
        return 1;
    };

    CCSlice msg = CC_SLICE_LIT("hello-as\n");
    CCRes(size_t, CCIoError) wr = w.write(msg);
    assert(cc_is_ok(wr));
    assert(cc_value(wr) == msg.len);

    /* Explicit member path still works. */
    CCRes(size_t, CCIoError) wr2 = w.file.write(CC_SLICE_LIT("more\n"));
    assert(cc_is_ok(wr2));
    assert(cc_value(wr2) == 5);

    w.close();
    remove("tmp/as_field_ufcs_smoke.txt");
    printf("ok\n");
    return 0;
}

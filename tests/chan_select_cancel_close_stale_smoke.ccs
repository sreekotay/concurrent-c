/*
 * Smoke test for select-cancel/close waiter races.
 *
 * Goal (§8): repeatedly force one cc_chan_match_select(...) case to win
 * while the other case is cancelled/closed, exercising stale waiter-node
 * paths without deadlock. Pins the runtime select primitive directly
 * (this used to be spelled with the removed `@match` statement; the body
 * below reproduces exactly what that rewrite emitted, including the
 * pre-block cc_is_cancelled() check and cc_current_deadline()).
 */
#include <ccc/cc_runtime.cch>
#include <stdio.h>

#define REPEATS 1500

int main(void) {
    @errhandler(CCError e) cc_error_exit(e);
    int wins_data = 0;
    int wins_close = 0;

    for (int rep = 0; rep < REPEATS; rep++) {
        if ((rep % 1000) == 0) {
            fprintf(stderr, "iter %d/%d\n", rep, REPEATS);
        }

        int[~1 >] tx_data;
        int[~1 <] rx_data;
        int[~1 >] tx_close;
        int[~1 <] rx_close;
        CCChan* ch_data = cc_channel_pair(&tx_data, &rx_data);
        CCChan* ch_close = cc_channel_pair(&tx_close, &rx_close);

        int selected = 0;
        int got = 0;
        {
            CCNursery __cc_nursery16 = @create() !> @destroy;

            __cc_nursery16.spawn(() => {
                int v = 1;
                CCDeadline d = cc_deadline_after_ms(10);
                (void)cc_chan_deadline_send(tx_data.raw, &v, sizeof(int), &d);
            }) !>;
            __cc_nursery16.spawn(() => {
                tx_close.close();
            }) !>;

            @with_deadline(millis(30)) {
                do { /* select: recv/recv */
                    size_t __cc_match_idx = (size_t)-1;
                    int __cc_match_rc = 0;
                    CCChanMatchCase __cc_match_cases[2];
                    __cc_match_cases[0] = (CCChanMatchCase){ .ch = (rx_data).raw, .send_buf = NULL, .recv_buf = (void*)(&got), .elem_size = sizeof(*(&got)), .is_send = false };
                    __cc_match_cases[1] = (CCChanMatchCase){ .ch = (rx_close).raw, .send_buf = NULL, .recv_buf = (void*)(&got), .elem_size = sizeof(*(&got)), .is_send = false };
                    if (cc_is_cancelled()) {
                        /* pre-block cancel check: don't enter the select once
                         * the enclosing deadline scope is already cancelled */
                    } else {
                        __cc_match_rc = cc_chan_match_select(__cc_match_cases, 2, &__cc_match_idx, cc_current_deadline());
                    }
                    switch (__cc_match_idx) {
                        case 0: {
                            selected = 1;
                        }
                            break;
                        case 1: {
                            selected = 2;
                        }
                            break;
                        default: break;
                    }
                    (void)__cc_match_rc;
                } while(0);
            }
        
        }

        if (selected == 1) {
            wins_data++;
        } else if (selected == 2) {
            wins_close++;
        } else {
            fprintf(stderr, "invalid select result rep=%d selected=%d\n", rep, selected);
            return 2;
        }

        tx_data.close();
        cc_chan_free(ch_data);
        cc_chan_free(ch_close);
    }

    printf("chan_select_cancel_close_stale_smoke: reps=%d data=%d close=%d\n",
           REPEATS, wins_data, wins_close);
    return 0;
}

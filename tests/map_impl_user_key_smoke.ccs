/* Declared map-key convention on the Map (ccj) family: the same two
 * declarations that install a key for ArrayMap install it here — the
 * selection and forward-prototype emission are shared. */
#include <ccc/std/prelude.cch>
#include <stdio.h>
typedef struct GridPos { int x, y; } GridPos;
static size_t cc_map_key_hash_GridPos(GridPos k) {
    uint64_t h = ((uint64_t)(uint32_t)k.x << 32) | (uint32_t)k.y;
    return (size_t)(h ^ (h >> 32));
}
static int cc_map_key_eq_GridPos(GridPos a1, GridPos b1) {
    return a1.x == b1.x && a1.y == b1.y;
}
int main(void) {
    CCArena arena = cc_arena_heap(kilobytes(64));
    Map::[GridPos, int] m;
    GridPos p = {3, 4};
    GridPos q = {5, 6};
    int *vp;
    if (!arena.base) return 1;
    m = map_new::[GridPos, int](&arena);
    if (!m) return 2;
    if (m.insert(p, 7) != 0) return 3;
    if (m.insert(q, 9) != 0) return 4;
    vp = m.get_ptr(p);
    if (!vp || *vp != 7) return 5;
    vp = m.get_ptr(q);
    if (!vp || *vp != 9) return 6;
    if (!m.remove(p)) return 7;
    if (m.get_ptr(p)) return 8;
    printf("ok\n");
    return 0;
}

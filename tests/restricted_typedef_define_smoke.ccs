/* typedef + @restricted define in one declaration. */
#include <ccc/std/prelude.cch>
#include <stdio.h>
#include <string.h>

typedef struct Conn {
    int sock;
    int out_len;
} Conn;

typedef @restricted Encode on Conn {
    r: out_len, write;
} *ConnEnc;

static int conn_write(Conn* c, const char* data) {
    (void)c;
    (void)data;
    return 1;
}

static int use(ConnEnc enc) {
    return enc->write("x");
}

int main(void) {
    Conn c;
    memset(&c, 0, sizeof(c));
    if (!use(&c)) return 1;
    printf("ok\n");
    return 0;
}

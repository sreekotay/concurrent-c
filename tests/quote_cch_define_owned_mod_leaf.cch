#ifndef TESTS_QUOTE_CCH_DEFINE_OWNED_MOD_LEAF_CCH
#define TESTS_QUOTE_CCH_DEFINE_OWNED_MOD_LEAF_CCH

#include <ccc/std/prelude.cch>

/* The arm an includer selects with a #define before the include: a
 * `static inline` body, which the module .h carries. Bodies the module
 * compiles once are not selected per includer. */
#ifdef CFG_ON
static inline int define_owned_value(void) { return 7; }
#else
static inline int define_owned_value(void) { return 3; }
#endif

int !>(CCError) define_owned_step(int x) {
    @errhandler(CCError e) { return cc_err(e); }
    return cc_ok(x);
}

#endif

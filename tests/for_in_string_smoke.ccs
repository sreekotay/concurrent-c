/* @for (c in s) on CCString (SSO-safe data load). */
#include <ccc/std/prelude.cch>
#include <stdio.h>

int main(void) {
    CCArena arena = cc_arena_heap(kilobytes(1)) @destroy;
    CCString s;
    int n = 0;
    if (!cc_arena_is_live(arena)) return 1;
    s = cc_string_from_slice(arena, CC_SLICE_LIT("ab"));
    @for (c in s) {
        if (c != 'a' && c != 'b') return 2;
        n++;
    }
    if (n != 2) return 3;
    if (s.len != 2) return 4;
    printf("ok\n");
    return 0;
}

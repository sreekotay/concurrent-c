/* An owner handed to a slice parameter converts as it does at a slice
 * declaration: `f(s)` and `f(&s)` read `s.as_slice()`, `f(p)` a char
 * pointer to its NUL, whether the call is written plain or as a method. */
#include <ccc/std/prelude.cch>
#include <stdio.h>

static size_t take(char[:] raw) { return raw.len; }
static size_t take_erased(CCSlice raw) { return raw.len; }

int main(void) {
    cc_arena_stack(a, 1024);
    CCString direct = @string(`<b>`, a);
    CCString plain = cc_string_new();
    CCString* ps = &direct;
    CCString acc = cc_string_new();
    const char* cp = "abcd";
    size_t n = 0;
    plain.append("xy", a);
    n += take(direct);           /* 3 */
    n += take(plain);            /* 2 */
    n += take(&direct);          /* 3 */
    n += take(*ps);              /* 3 */
    n += take(ps);               /* 3 */
    n += take_erased(direct);    /* 3 */
    n += take(cp);               /* 4 */
    @for (i in 0..2) {
        CCString s;
        s = @string(`item${i}`, a);
        n += take(s);            /* 5 + 5 */
    }
    acc.push_slice(direct, a);
    printf("%zu %zu\n", n, acc.len());
    return 0;
}

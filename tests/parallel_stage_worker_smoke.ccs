/*
 * @stage + worker (w) on `@parallel wait (ts) for`.
 * worker slots are exclusive (never two live tickets on one slot) and in
 * [0, cap); the @stage section retires tickets strictly in ticket order;
 * an errored ticket discharges its unpassed stage so successors never
 * park (the loop terminates and re-raises). The seq denial path binds
 * w = 0 and stage calls degrade to no-ops.
 */
#include <ccc/std/prelude.cch>
#include <ccc/cc_atomic.cch>
#include <stdio.h>

#define N   24
#define CAP 4

static int g_order[N];
static int g_norder;
static cc_atomic_int g_slot_live[CAP];
static cc_atomic_int g_slot_bad;
static cc_atomic_int g_done;

static void !>(CCError) boom(int i) {
    if (i == 2)
        return cc_err(CC_ERR_IO, "boom");
    return cc_ok();
}

static int run_ok(CCTurnstile* ts) {
    @errhandler(CCError e) { cc_error_log(e); return 1; }
    int i;
    g_norder = 0;
    cc_atomic_store(&g_slot_bad, 0);
    cc_atomic_store(&g_done, 0);
    @parallel wait (ts) for (i in 0..N) worker (w) {
        if (w < 0 || w >= CAP)
            cc_atomic_store(&g_slot_bad, 1);
        else if (cc_atomic_fetch_add(&g_slot_live[w], 1) != 0)
            cc_atomic_store(&g_slot_bad, 1);
        cc_sleep_ms(i % 3);
        @stage (ts, 0, i) {
            /* Exclusive ordered section: no lock needed. */
            g_order[g_norder++] = i;
        }
        cc_atomic_fetch_add(&g_done, 1);
        if (w >= 0 && w < CAP)
            cc_atomic_fetch_sub(&g_slot_live[w], 1);
    }
    if (cc_atomic_load(&g_slot_bad)) {
        fprintf(stderr, "FAIL worker slot out of range or shared\n");
        return 1;
    }
    if (cc_atomic_load(&g_done) != N || g_norder != N) {
        fprintf(stderr, "FAIL done=%d norder=%d want=%d\n",
                cc_atomic_load(&g_done), g_norder, N);
        return 1;
    }
    for (i = 0; i < N; i++) {
        if (g_order[i] != i) {
            fprintf(stderr, "FAIL stage order[%d]=%d\n", i, g_order[i]);
            return 1;
        }
    }
    return 0;
}

static int run_err(CCTurnstile* ts) {
    @errhandler(CCError e) {
        if (e.kind != CC_ERR_IO) {
            fprintf(stderr, "FAIL wrong error kind %d\n", (int)e.kind);
            return 1;
        }
        return 0; /* expected: ticket 2's boom, stages discharged */
    }
    int i;
    g_norder = 0;
    @parallel wait (ts) for (i in 0..N) worker (w) {
        (void)w;
        boom(i) !>;
        @stage (ts, 0, i) {
            g_norder++;
        }
    }
    fprintf(stderr, "FAIL error not raised\n");
    return 1;
}

static int run_seq(CCTurnstile* ts) {
    @errhandler(CCError e) { cc_error_log(e); return 1; }
    int i;
    int last = -1;
    int wsum = 0;
    g_norder = 0;
    @parallel seq (0) wait (ts) for (i in 0..N) worker (w) {
        wsum += w;
        @stage (ts, 0, i) {
            if (i == last + 1)
                last = i;
            g_norder++;
        }
    }
    if (wsum != 0 || last != N - 1 || g_norder != N) {
        fprintf(stderr, "FAIL seq wsum=%d last=%d norder=%d\n", wsum, last,
                g_norder);
        return 1;
    }
    return 0;
}

int main(void) {
    @errhandler(CCError e) { cc_error_log(e); return 1; }
    CCArena arena = cc_arena_heap(kilobytes(64)) @destroy;
    CCTurnstile ts_ok@(N, CAP, 1, &arena) @destroy;
    CCTurnstile ts_err@(N, CAP, 1, &arena) @destroy;
    CCTurnstile ts_seq@(N, CAP, 1, &arena) @destroy;
    if (!ts_ok.excl || !ts_err.excl || !ts_seq.excl)
        return 1;
    if (run_ok(&ts_ok) != 0 || run_err(&ts_err) != 0 || run_seq(&ts_seq) != 0)
        return 1;
    printf("parallel_stage_worker_smoke: OK\n");
    return 0;
}

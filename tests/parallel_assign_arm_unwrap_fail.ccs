/* `a = f() !>;` as an arm puts the unwrap in expression position, where the
 * handler must diverge -- and in an arm the only way to diverge is to leave
 * the arm. `@serial` is where that is spelled, so the bare form is refused
 * rather than left to mean something the page does not say. */
#include <ccc/std/prelude.cch>

static int !>(CCError) step(int v) { return cc_ok(v); }

int main(void) {
    @errhandler(CCError e) cc_error_exit(e);
    int a = 0;
    int b = 0;
    @parallel {
        a = step(1) !>;
        b = step(2) !>;
    } !>.wait()!>;
    return a + b;
}

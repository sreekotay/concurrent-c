#ifndef TESTS_QUOTE_CCH_DESTATIC_MOD_CCH
#define TESTS_QUOTE_CCH_DESTATIC_MOD_CCH

#include <ccc/std/prelude.cch>

/* Owned impl-grade face. `static` fns stay in the owner splice and are
 * omitted from the extract. Non-static destatic_pub is the guest entry.
 * Non-static data becomes `extern` in the extract. */
static int destatic_cell = 4;
int destatic_table[] = { 1, 2, 3 };

static int !>(CCError) destatic_step(int x) {
    @errhandler(CCError e) { return cc_err(e); }
    return cc_ok(x);
}

static int destatic_hid(void) {
    /* DESTATIC_HID_BODY */
    int x = destatic_step(3) !> { return 0; };
    return x + destatic_cell;
}

int destatic_pub(void) {
    /* DESTATIC_PUB_BODY */
    return destatic_hid();
}

#endif

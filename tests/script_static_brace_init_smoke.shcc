#!/usr/bin/env -S ./cc/bin/ccc
/*
 * Smoke: file-scope `static T x[] = { ... };` stays at TU scope under .shcc
 * entry rewrite (brace initializer must not be treated as a compound stmt).
 */

typedef struct {
    const char* path;
    int n;
} Row;

static const Row ROWS[] = {
    {"a", 1},
    {"b", 2},
    {"c", 3},
};

static int lookup(const char* path) {
    size_t i;
    for (i = 0; i < sizeof(ROWS) / sizeof(ROWS[0]); i++) {
        if (strcmp(ROWS[i].path, path) == 0) return ROWS[i].n;
    }
    return -1;
}

if (lookup("a") != 1) return 1;
if (lookup("b") != 2) return 1;
if (lookup("c") != 3) return 1;
if (lookup("missing") != -1) return 1;
return 0;

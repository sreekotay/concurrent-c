/*
 * Channel policy regression (not wired into redis_idiomatic today): a full
 * per-client reply queue must not block the shared owner if the server uses
 * try_send + close-on-EAGAIN.  Slow client fills a cap-2 reply channel without
 * recv; fast client's request is still answered before the overflow closes the
 * slow side.  redis_idiomatic uses blocking send on the reply channel for
 * throughput; revisit non-blocking handoff with profiling before changing prod.
 */
#include <ccc/cc_runtime.cch>
#include <ccc/cc_channel.cch>
#include <ccc/cc_atomic.cch>
#include <ccc/cc_nursery.cch>

#include <errno.h>
#include <stdio.h>
#include <stdlib.h>

#define SLOW_REPLY_CAP 2
#define FAST_REPLY_CAP 8
#define REQUEST_CHAN_CAP 16

typedef struct QueueReq {
    CCChanTx reply_tx;
    CCChan* reply_ch;
    int reply_value;
} QueueReq;

typedef QueueReq*[~REQUEST_CHAN_CAP N:1 >] HolReqTx;
typedef QueueReq*[~REQUEST_CHAN_CAP N:1 <] HolReqRx;

static cc_atomic_int g_errors = 0;
static cc_atomic_int g_slow_prefill_sent = 0;
/* Set after fast's reply is received so the owner has finished r1,r2,f1
 * before the slow overflow request (avoids r3 vs f1 racing on the req channel). */
static cc_atomic_int g_fast_reply_received = 0;

static void hol_owner_try_send_policy(HolReqRx req_rx) {
    QueueReq* req = NULL;
    while (cc_io_avail(cc_channel_recv(req_rx, &req))) {
        if (!req) continue;
        int v = req->reply_value;
        CCChanTx tx = req->reply_tx;
        (void)req->reply_ch;
        free(req);

        CCResult_bool_CCIoError ts = cc_channel_try_send(tx, v);
        if (ts.ok && ts.u.value) {
            continue;
        }
        if (!ts.ok) {
            CCIoError e = ts.u.error;
            if (e.kind == CC_IO_BUSY && e.os_code == EAGAIN) {
                cc_channel_close(tx, cc_io_error_os(CC_IO_BUSY, EAGAIN));
            } else {
                cc_channel_close(tx, e);
            }
        } else {
            cc_channel_close(tx, cc_io_error(CC_IO_CONNECTION_CLOSED));
        }
    }
}

static void slow_client(HolReqTx req_tx_raw) {
    @defer cc_channel_close(req_tx_raw);
    int[~SLOW_REPLY_CAP 1:1 >] slow_reply_tx;
    int[~SLOW_REPLY_CAP 1:1 <] slow_reply_rx;
    CCChan* slow_ch = cc_channel_pair(&slow_reply_tx, &slow_reply_rx);
    if (!slow_ch) {
        cc_atomic_fetch_add(&g_errors, 1);
        cc_atomic_store(&g_slow_prefill_sent, 1);
        cc_atomic_store(&g_fast_reply_received, 1);
        return;
    }

    for (int i = 0; i < SLOW_REPLY_CAP; ++i) {
        QueueReq* q = malloc(sizeof(*q));
        if (!q) {
            cc_atomic_fetch_add(&g_errors, 1);
            cc_atomic_store(&g_slow_prefill_sent, 1);
            cc_atomic_store(&g_fast_reply_received, 1);
            cc_channel_close(slow_reply_tx);
            return;
        }
        q->reply_tx = slow_reply_tx;
        q->reply_ch = slow_ch;
        q->reply_value = i + 1;
        if (!cc_io_avail(cc_channel_send(req_tx_raw, q))) {
            cc_atomic_fetch_add(&g_errors, 1);
            free(q);
            cc_atomic_store(&g_slow_prefill_sent, 1);
            cc_atomic_store(&g_fast_reply_received, 1);
            cc_channel_close(slow_reply_tx);
            return;
        }
    }
    cc_atomic_store(&g_slow_prefill_sent, 1);

    while (!cc_atomic_load(&g_fast_reply_received)) {
        cc_yield();
    }

    {
        QueueReq* q = malloc(sizeof(*q));
        if (!q) {
            cc_atomic_fetch_add(&g_errors, 1);
            cc_atomic_store(&g_fast_reply_received, 1);
            cc_channel_close(slow_reply_tx);
            return;
        }
        q->reply_tx = slow_reply_tx;
        q->reply_ch = slow_ch;
        q->reply_value = 999;
        if (!cc_io_avail(cc_channel_send(req_tx_raw, q))) {
            cc_atomic_fetch_add(&g_errors, 1);
            free(q);
            cc_atomic_store(&g_fast_reply_received, 1);
            cc_channel_close(slow_reply_tx);
            return;
        }
    }

    /* Drain the two replies that landed before overflow closed the channel.
     * req_tx_raw is closed by @defer when this fiber returns (unblocks owner). */
    for (int k = 0; k < SLOW_REPLY_CAP; ++k) {
        int got = -1;
        if (!cc_io_avail(cc_channel_recv(slow_reply_rx, &got))) {
            break;
        }
        if (got != k + 1) {
            fprintf(stderr,
                    "redis_owner_reply_try_send_hol_smoke: slow recv mismatch got=%d expected=%d\n",
                    got,
                    k + 1);
            cc_atomic_fetch_add(&g_errors, 1);
            break;
        }
    }
    cc_channel_close(slow_reply_tx);
}

static void fast_client(HolReqTx req_tx_raw) {
    while (!cc_atomic_load(&g_slow_prefill_sent)) {
        cc_yield();
    }

    int[~FAST_REPLY_CAP 1:1 >] fast_reply_tx;
    int[~FAST_REPLY_CAP 1:1 <] fast_reply_rx;
    CCChan* fast_ch = cc_channel_pair(&fast_reply_tx, &fast_reply_rx);
    if (!fast_ch) {
        cc_atomic_fetch_add(&g_errors, 1);
        cc_atomic_store(&g_fast_reply_received, 1);
        return;
    }

    {
        QueueReq* q = malloc(sizeof(*q));
        if (!q) {
            cc_atomic_fetch_add(&g_errors, 1);
            cc_atomic_store(&g_fast_reply_received, 1);
            cc_channel_close(fast_reply_tx);
            return;
        }
        q->reply_tx = fast_reply_tx;
        q->reply_ch = fast_ch;
        q->reply_value = 4242;
        if (!cc_io_avail(cc_channel_send(req_tx_raw, q))) {
            cc_atomic_fetch_add(&g_errors, 1);
            free(q);
            cc_atomic_store(&g_fast_reply_received, 1);
            cc_channel_close(fast_reply_tx);
            return;
        }
    }

    int got = -1;
    if (!cc_io_avail(cc_channel_recv(fast_reply_rx, &got))) {
        cc_atomic_fetch_add(&g_errors, 1);
        cc_atomic_store(&g_fast_reply_received, 1);
        cc_channel_close(fast_reply_tx);
        return;
    }
    if (got != 4242) {
        fprintf(stderr,
                "redis_owner_reply_try_send_hol_smoke: fast expected 4242 got=%d\n",
                got);
        cc_atomic_fetch_add(&g_errors, 1);
    }
    cc_atomic_store(&g_fast_reply_received, 1);
    cc_channel_close(fast_reply_tx);
}

int main(void) {
    cc_sched_set_num_workers(8);
    cc_atomic_store(&g_errors, 0);
    cc_atomic_store(&g_slow_prefill_sent, 0);
    cc_atomic_store(&g_fast_reply_received, 0);

    HolReqTx req_tx;
    HolReqRx req_rx;
    CCChan* req_ch = cc_channel_pair(&req_tx, &req_rx);
    if (!req_ch) return 10;
    @defer req_ch.free();

    {
        CCNursery* n = @create(NULL) @destroy;
        if (!n) return 11;

        HolReqRx req_rx_raw = req_rx;
        HolReqTx req_tx_raw = req_tx;

        n->spawn(() => [req_rx_raw] { hol_owner_try_send_policy(req_rx_raw); });
        n->spawn(() => [req_tx_raw] { slow_client(req_tx_raw); });
        n->spawn(() => [req_tx_raw] { fast_client(req_tx_raw); });
    }

    if (cc_atomic_load(&g_errors) != 0) {
        fprintf(stderr,
                "redis_owner_reply_try_send_hol_smoke: FAIL errors=%d\n",
                cc_atomic_load(&g_errors));
        return 20;
    }

    printf("redis_owner_reply_try_send_hol_smoke: PASS\n");
    return 0;
}

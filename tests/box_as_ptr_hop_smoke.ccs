/* Teaching alias of CCBox::[H] + as: p hop — Host* methods, no peel list. */
#include <ccc/std/prelude.cch>
#include <stdio.h>

typedef struct BoxHopHost {
    int n;
} BoxHopHost;

typedef CCBox::[BoxHopHost] BoxHop;

static int BoxHopHost_bump(BoxHopHost* h) {
    if (!h) return -1;
    return ++h->n;
}

int main(void) {
    BoxHopHost host;
    CCBox::[BoxHopHost] b;
    BoxHop w;

    host.n = 3;
    b = &host;
    w = b;
    if (!w.is_live()) return 1;
    if (w.host() != &host) return 2;
    if (w.bump() != 4) return 3;
    if (b.bump() != 5) return 4;
    if (host.n != 5) return 5;

    printf("ok\n");
    return 0;
}

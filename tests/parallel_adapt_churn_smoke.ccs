/*
 * Ungated recursive `@parallel { }` must classify CHURN. Join is not a
 * meeting: pinning REAL on suspend floods this tree (the parallel_hello
 * revert). `CC_PAR_ADAPT_DEBUG=1` dumps `(churn)` at exit.
 */
#include <ccc/std/prelude.cch>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>

#define U24_MASK 0xFFFFFFu
#define DEPTH 10

static uint32_t u24(uint32_t x) {
    return x & U24_MASK;
}

static uint32_t sum_seq(uint32_t d, uint32_t i) {
    if (d >= DEPTH)
        return i;
    return u24(sum_seq(d + 1, u24(i * 2)) + sum_seq(d + 1, u24(i * 2 + 1)));
}

static uint32_t sum_par(uint32_t d, uint32_t i) {
    @errhandler(CCError e) cc_error_exit(e);
    if (d >= DEPTH)
        return i;
    uint32_t left = 0;
    uint32_t right = 0;
    @parallel {
        left  = sum_par(d + 1, u24(i * 2));
        right = sum_par(d + 1, u24(i * 2 + 1));
    } !>.wait()!>;
    return u24(left + right);
}

int main(void) {
    setenv("CC_PAR_ADAPT_DEBUG", "1", 1);
    uint32_t want = sum_seq(0, 0);
    uint32_t got = sum_par(0, 0);
    if (got != want) {
        fprintf(stderr, "FAIL tree want=%u got=%u\n", want, got);
        return 1;
    }
    printf("parallel_adapt_churn_smoke: OK\n");
    return 0;
}

/*
 * Bare !>; inside @errhandler(E) for the same E is ill-formed.
 * Report via cc_error_exit / !> { abort(); }, not !>; in the handler body.
 */
#include <ccc/cc_runtime.cch>
#include <ccc/stdio.cch>
#include <stdlib.h>

static void !>(CCError) boom(void) {
    return cc_err(CC_ERR_INVALID_ARG, "boom");
}

int main(void) {
    @errhandler(CCError e) {
        boom() !>;
        return 1;
    }
    boom() !>;
    return 0;
}

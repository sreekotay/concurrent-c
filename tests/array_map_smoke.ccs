/* array_map: pow2 u32 index + dense rows. */
#include <ccc/std/prelude.cch>
#include <stdio.h>
#include <string.h>

CC_ARRAY_MAP_DECL(int, int, IntArrayMap, cc_map_hash_i32, cc_map_eq_i32);

int main(void) {
    CCArena arena = cc_arena_heap(kilobytes(64));
    IntArrayMap *m;
    int *p;
    int k;
    int v;
    size_t n;
    size_t i;

    if (!arena.base) return 1;
    m = IntArrayMap_init_count(&arena, 16);
    if (!m) return 2;

    for (i = 0; i < 100; i++) {
        if (IntArrayMap_insert(m, (int)i, (int)(i * 10)) != 0) return 3;
    }
    if (IntArrayMap_len(m) != 100) return 4;

    p = IntArrayMap_get_ptr(m, 42);
    if (!p || *p != 420) return 5;
    if (IntArrayMap_get_ptr(m, 1000) != NULL) return 6;

    if (!IntArrayMap_del(m, 42)) return 7;
    if (IntArrayMap_get_ptr(m, 42) != NULL) return 8;
    if (IntArrayMap_len(m) != 99) return 9;

    /* Remaining keys still resolve after swap-remove. */
    p = IntArrayMap_get_ptr(m, 99);
    if (!p || *p != 990) return 10;
    p = IntArrayMap_get_ptr(m, 0);
    if (!p || *p != 0) return 11;

    n = 0;
    CC_ARRAY_MAP_FOREACH(m, k, v) {
        (void)k;
        (void)v;
        n++;
    }
    if (n != 99) return 12;

    IntArrayMap_clear(m);
    if (IntArrayMap_len(m) != 0) return 13;

    printf("array_map_smoke ok\n");
    IntArrayMap_destroy(m);
    cc_arena_free(&arena);
    return 0;
}

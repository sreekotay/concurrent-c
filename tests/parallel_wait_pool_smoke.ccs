/*
 * @parallel wait (ts) for — pool occupancy.
 * The join spawns `cap` runners, not one task per ticket. N > cap, no
 * stage in the body: peak live bodies must reach cap. A one-runner
 * collapse never trips the barrier and times out.
 */
#include <ccc/std/prelude.cch>
#include <ccc/cc_atomic.cch>
#include <stdio.h>

#define N   24
#define CAP 4

static cc_atomic_int g_live;
static cc_atomic_int g_peak;
static cc_atomic_int g_arrived;
static cc_atomic_int g_released;
static cc_atomic_int g_timed_out;
static cc_atomic_int g_done;

static void bump_peak(void) {
    int now = cc_atomic_fetch_add(&g_live, 1) + 1;
    int p = cc_atomic_load(&g_peak);
    while (now > p) {
        if (cc_atomic_cas(&g_peak, &p, now))
            break;
    }
}

static void meet_cap(void) {
    int n = cc_atomic_fetch_add(&g_arrived, 1) + 1;
    if (n >= CAP)
        cc_atomic_store(&g_released, 1);
    int spins = 0;
    while (!cc_atomic_load(&g_released)) {
        cc_sleep_ms(1);
        spins++;
        if (spins > 2000) {
            cc_atomic_store(&g_timed_out, 1);
            cc_atomic_store(&g_released, 1);
            break;
        }
    }
}

static int run_pool(CCTurnstile* ts) {
    @errhandler(CCError e) { cc_error_log(e); return 1; }
    cc_atomic_store(&g_live, 0);
    cc_atomic_store(&g_peak, 0);
    cc_atomic_store(&g_arrived, 0);
    cc_atomic_store(&g_released, 0);
    cc_atomic_store(&g_timed_out, 0);
    cc_atomic_store(&g_done, 0);
    int i;
    @parallel wait (ts) for (i in 0..N) {
        bump_peak();
        meet_cap();
        cc_atomic_fetch_add(&g_done, 1);
        cc_atomic_fetch_sub(&g_live, 1);
    } !>.wait()!>;
    if (cc_atomic_load(&g_timed_out)) {
        fprintf(stderr, "FAIL pool barrier timed out (one runner?)\n");
        return 1;
    }
    int peak = cc_atomic_load(&g_peak);
    int done = cc_atomic_load(&g_done);
    if (peak != CAP || done != N) {
        fprintf(stderr, "FAIL pool peak=%d want=%d done=%d want=%d\n",
                peak, CAP, done, N);
        return 1;
    }
    return 0;
}

static int run_seq(CCTurnstile* ts) {
    @errhandler(CCError e) { cc_error_log(e); return 1; }
    cc_atomic_store(&g_live, 0);
    cc_atomic_store(&g_peak, 0);
    cc_atomic_store(&g_done, 0);
    int i;
    @parallel seq (0) wait (ts) for (i in 0..N) {
        bump_peak();
        cc_atomic_fetch_add(&g_done, 1);
        cc_atomic_fetch_sub(&g_live, 1);
    } !>.wait()!>;
    int peak = cc_atomic_load(&g_peak);
    int done = cc_atomic_load(&g_done);
    if (peak != 1 || done != N) {
        fprintf(stderr, "FAIL seq peak=%d want=1 done=%d want=%d\n",
                peak, done, N);
        return 1;
    }
    return 0;
}

int main(void) {
    @errhandler(CCError e) { cc_error_log(e); return 1; }
    CCArena arena = cc_arena_heap(kilobytes(64)) @destroy;
    CCTurnstile ts_par@(CAP, 1, &arena) @destroy;
    CCTurnstile ts_seq@(CAP, 1, &arena) @destroy;
    if (!ts_par.excl || !ts_seq.excl)
        return 1;
    if (run_pool(&ts_par) != 0 || run_seq(&ts_seq) != 0)
        return 1;
    printf("parallel_wait_pool_smoke: OK\n");
    return 0;
}

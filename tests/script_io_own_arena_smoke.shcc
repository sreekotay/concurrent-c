#!/usr/bin/env -S ./cc/bin/ccc
/*
 * The implicit `io` binds an arena of its own, so it does not depend on the
 * script's `a`. Predecls are emitted above the script body: an `io` bound to
 * `a` put that reference above this file's own `CCArena a` declaration and
 * failed to compile.
 *
 * The script's arena stays independently usable, including for io's own
 * arena-taking calls.
 */

CCArena a = @create(kilobytes(4)) @destroy;

io.println("io works") !>;

@string(`a works: ${41 + 1}`, &a).println() !>;

return 0;

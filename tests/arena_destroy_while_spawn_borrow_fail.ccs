/* Fail: destroy/free arena while a nursery task still holds a borrow. */
#include <ccc/std/prelude.cch>
#include <string.h>

int main(void) {
    @errhandler(CCError e) {
        (void)e;
        return 1;
    }

    CCArena buf = cc_arena_heap(kilobytes(4));
    char[:] view = cc_arena_alloc_slice_bytes(&buf, 64);
    if (!view.ptr) return 1;
    memset(view.ptr, 'x', view.len);

    {
        CCNursery n = cc_nursery_create() !> @destroy;
        n.spawn(() => [view] {
            (void)view;
        }) !>;
        cc_arena_free(&buf); /* ERROR: pin */
    }
    return 0;
}

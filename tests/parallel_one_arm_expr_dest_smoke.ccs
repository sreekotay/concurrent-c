/*
 * Dest-live one-arm expression: that arm is the worker (spawned).
 * Dest is live on the caller; .wait() joins.
 */
#include <ccc/std/prelude.cch>
#include <stdio.h>

static int g;

static void work(void) {
    g = 7;
}

int main(void) {
    @errhandler(CCError err) { (void)err; return 1; }
    g = 0;
    CCParallel h = @parallel {
        work();
    } !>;
    h.wait() !>;
    if (g != 7) {
        fprintf(stderr, "FAIL g=%d\n", g);
        return 1;
    }
    printf("parallel_one_arm_expr_dest_smoke: OK\n");
    return 0;
}

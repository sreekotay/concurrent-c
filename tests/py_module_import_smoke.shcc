/* The other door: Python imports CC.  A TU exporting `PyInit_counter`
 * and no `main` builds — in one command, no flag — as counter.so, and
 * `import counter` runs CC code with module state.  Skips where no
 * python3 executable is on PATH (the .so needs a host to import it). */
CCArena a = cc_arena_heap(megabytes(1)) @destroy;

{
    CCCommand which = cc_command(&a, @slice("sh"));
    which.arg("-c");
    which.arg("command -v python3 >/dev/null 2>&1");
    int rc = which.status() !>;
    if (rc != 0) { "SKIP (no python3)".println() !>; return 0; }
}

{
    CCCommand build = cc_command(&a, @slice("./cc/bin/ccc"));
    build.arg("build");
    build.arg("examples/recipe_py_module.ccs");
    build.inherit_stdio();
    int rc = build.status() !>;
    if (rc != 0) { "build failed".println() !>; return 1; }
}

{
    CCCommand run = cc_command(&a, @slice("sh"));
    run.arg("-c");
    /* Seeded state, stateful calls, a CC error arriving as the exception
     * its kind maps to (INVALID_ARG -> ValueError), and the underscore
     * member staying home. */
    CCString py = @string(`PYTHONPATH=bin python3 -c "
import counter
print('start', counter.total())
print('bump', counter.bump(4))
print('checked', counter.bump_checked(6))
try:
    counter.bump_checked(-1)
except ValueError as e:
    print('raised:', e)
print('private_hidden', not hasattr(counter, '_clamp'))
import importlib.util
spec = importlib.util.spec_from_file_location('counter', 'bin/counter.abi3.so')
m2 = importlib.util.module_from_spec(spec)
spec.loader.exec_module(m2)
print('fresh_instance', m2.total())
m2.bump(1)
print('independent', counter.total(), m2.total())
"`, &a);
    run.arg(py.cstr(&a));
    run.inherit_stdio();
    int rc = run.status() !>;
    if (rc != 0) { "import failed".println() !>; return 1; }
}
return 0;

/* Declared-niche unit (spec/draft_variants.md §11): a CCString arm donates
 * its registered `cap`-field niche (offset 12, width 4, sentinel 0xFFFFFFFF),
 * so a packed { str: CCString; num: int64_t } round-trips both arms.
 *
 * The niche lives in `cap`, NOT over CCString's SSO first word — so BOTH an
 * inline string (cap == CC_STRING_INLINE_CAP == 8) and a heap string (cap ==
 * a real power-of-two allocation size) decode as `str`, because neither cap
 * value is the 0xFFFFFFFF sentinel that the `num` arm stamps. */
#include <ccc/std/prelude.cch>
#include <stdio.h>
#include <stdint.h>
#include <string.h>

@variant(packed) Cell {
    str: CCString;
    num: int64_t;
};

int main(void) {
    CCArena arena = cc_arena_create(1 << 16);

    /* inline string: fits the SSO buffer, cap == 8 */
    CCString small = cc_string_from("hi", arena);
    Cell a = { .str = small };
    if (a.kind != Cell_str) { printf("inline str decoded wrong\n"); return 1; }
    CCString as = a.str ?> cc_string_new();
    if (strcmp(cc_string_cstr(&as, arena), "hi") != 0) return 2;

    /* heap string: too long for SSO, cap is a real allocation size */
    CCString big = cc_string_from("the quick brown fox jumps over the lazy dog", arena);
    Cell b = { .str = big };
    if (b.kind != Cell_str) { printf("heap str decoded wrong\n"); return 3; }
    CCString bs = b.str ?> cc_string_new();
    if (strcmp(cc_string_cstr(&bs, arena), "the quick brown fox jumps over the lazy dog") != 0) return 4;

    /* num arm: stamps the cap sentinel, decodes as num */
    Cell c = { .num = -123456789 };
    if (c.kind != Cell_num) { printf("num decoded wrong\n"); return 5; }
    int64_t got = c.num ?> 0;
    if (got != -123456789) return 6;

    /* transition num -> str -> num all decode correctly in place */
    c = { .str = cc_string_from("x", arena) };
    if (c.kind != Cell_str) return 7;
    c = { .num = 999 };
    if (c.kind != Cell_num || (c.num ?> 0) != 999) return 8;

    printf("ok\n");
    return 0;
}

/* Smoke: value-capture of T* alias is OK if the body only reads. */
#include <ccc/std/prelude.cch>
#include <stdio.h>

int main(void) {
    @errhandler(CCError e) {
        fprintf(stderr, "fatal: %s\n", e.message);
        return 1;
    }

    int x = 7;
    int* p = &x;

    {
        CCNursery* n = cc_nursery_create(NULL) !> @destroy;
        n->spawn(() => [p] {
            if (*p != 7) abort();
        });
    }

    printf("closure_ptr_alias_value_capture_readonly_smoke: ok\n");
    return 0;
}

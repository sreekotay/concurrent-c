/* Hosting, the other JS door: CC creates the environment.  Builds
 * tests/js_host_prog.ccs — cc_js_host_new boots a full libnode inside
 * the process (first use compiles the embedded shim against the node
 * development headers) and hands back the owning handle; run() posts CC
 * closures onto the loop thread with a live CCJs — and runs it.  Skips
 * where the node dev headers, a C++ compiler, or libnode itself are
 * absent. */
CCArena a = cc_arena_heap(megabytes(1)) @destroy;

{
    CCCommand which = cc_command(a, @slice("sh"));
    which.arg("-c");
    which.arg("{ test -e /usr/include/node/node.h"
              " || test -e /usr/local/include/node/node.h"
              " || test -n \"$CC_NODE_INCLUDE\"; }"
              " && command -v c++ >/dev/null 2>&1"
              " && { ldconfig -p 2>/dev/null | grep -q libnode"
              " || test -n \"$CC_LIBNODE\"; }");
    int rc = which.status() !>;
    if (rc != 0) { "SKIP (need libnode-dev + c++)".println() !>; return 0; }
}

{
    CCCommand build = cc_command(a, @slice("./cc/bin/ccc"));
    build.arg("build");
    build.arg("tests/js_host_prog.ccs");
    build.inherit_stdio();
    int rc = build.status() !>;
    if (rc != 0) { "build failed".println() !>; return 1; }
}

{
    CCCommand run = cc_command(a, @slice("./bin/js_host_prog"));
    run.inherit_stdio();
    int rc = run.status() !>;
    if (rc != 0) { "host run failed".println() !>; return 1; }
}
return 0;

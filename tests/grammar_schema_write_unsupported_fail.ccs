// NEGATIVE: requesting the write projection of a schema that is not
// formatable yet. Narrowed schemas (`G.rule [...]`) format fine — but a
// DIRECTIVE-built member list (`fields [...]`) has no single grammar rule
// to invert, so its write side has no source of structural truth yet.
#include <ccc/std/prelude.cch>

@grammar(schema) Obj {~~~~
    rules [
        ws:      any charset [#' ']
        strchar: complement charset [#'"' #'\\']
        str:     [#'"' keep any strchar #'"']
        val:     [ws str ws]
    ]
    fields: open #'{' close #'}' sep #',' kv #':'
            key str pad ws else val
    fields [
        "k" v: str
    ]
~~~~}

int main(void) {
    char buf[64];
    Obj o;
    (void)o;
    (void)Obj_write(&o, buf, sizeof buf);
    return 0;
}

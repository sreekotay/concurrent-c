/* Track C1: explicit @comptime cc_instantiate_* forces a monomorph even when
 * the type is never spelled as CCVec::[T] / Map::[K,V] in source.  The body
 * below uses only the mangled names, which exist solely because of the
 * comptime instantiation requests. */
#include <ccc/std/prelude.cch>
#include <ccc/cc_instantiate.cch>
#include <stdio.h>

@comptime {
    cc_instantiate_vec("int");
    cc_instantiate_map("int", "int");
}

int main(void) {
    CCArena arena = cc_arena_heap(kilobytes(4));
    if (!cc_arena_is_live(arena)) return 1;

    CCVec_int v = CCVec_int_init(arena, 8);
    if (CCVec_int_push(&v, 11) != 0) return 2;
    if (CCVec_int_push(&v, 22) != 0) return 3;
    int* got = CCVec_int_get(&v, 1);
    if (!got || *got != 22) return 4;

    Map_int_int* m = Map_int_int_init(arena);
    if (!m) return 5;
    if (Map_int_int_insert(m, 7, 70) != 0) return 6;
    int* mv = Map_int_int_get(m, 7);
    if (!mv || *mv != 70) return 7;

    printf("comptime_instantiate_smoke ok\n");
    cc_arena_free(&arena);
    return 0;
}

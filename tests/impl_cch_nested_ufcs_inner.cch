/* Nested inside impl_cch_nested_ufcs_outer.cch. UFCS here targets a type
 * the nested file cannot see standalone — lowering must happen in the
 * spliced TU context. Receivers cover both a plain parameter and a
 * struct-field access mixed with raw derefs (the redis_mem.cch reporting
 * shape). */
#ifndef IMPL_CCH_NESTED_UFCS_INNER_CCH
#define IMPL_CCH_NESTED_UFCS_INNER_CCH

static size_t nested_ufcs_len(NestedUfcsMap m) {
    return m ? m->len() : 0;
}

static size_t nested_ufcs_report(const NestedUfcsDb* db) {
    if (!db || !db->entries) return 0;
    size_t cap = db->entries->cap();
    size_t n = db->entries->len();
    size_t raw = db->entries->len;
    size_t live = db->entries->live_bytes();
    return cap + n + raw + (live ? 1 : 0);
}

#endif /* IMPL_CCH_NESTED_UFCS_INNER_CCH */

/* Capturing CCExclusiveMutex into a spawn allows sibling [&counter]
 * mutation under acquire/release — no @unsafe. */
#include <ccc/cc_nursery.cch>
#include <ccc/cc_exclusive.cch>
#include <ccc/cc_arena.cch>
#include <stdio.h>
#include <stdlib.h>

int main(void) {
    CCArena a = cc_arena_heap(kilobytes(4));
    CCExclusive* excl = cc_exclusive_create(&a);
    if (!excl) abort();
    CCExclusiveMutex mu = excl->mutex(1);
    int counter = 0;

    {
        CCNursery* n = @create(NULL) @destroy;
        if (!n) abort();
        n->spawn(() => [mu, &counter] {
            CCExclusiveGuard g = mu.acquire();
            counter++;
            g.release();
        });
    }

    cc_exclusive_destroy(excl);
    cc_arena_free(&a);
    printf("counter=%d\n", counter);
    return (counter == 1) ? 0 : 1;
}

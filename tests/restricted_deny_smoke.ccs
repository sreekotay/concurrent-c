/* r:^secret — implicit * minus secret. Loads and UFCS stay; secret does not. */
#include <ccc/std/prelude.cch>
#include <stdio.h>

typedef struct Bag {
    int secret;
    int len;
} Bag;

@typeview on Bag {
    r: ^secret;
};

static int bag_bump(Bag* b) {
    return ++b->len;
}

int main(void) {
    Bag b = { .secret = 1, .len = 3 };
    if (b.len != 3) return 1;
    if (b.bump() != 4) return 2;
    printf("ok\n");
    return 0;
}

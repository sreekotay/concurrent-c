/* Unequal zip lens are CC_ERR_INVALID_ARG — not a silent min. */
#include <ccc/std/prelude.cch>
#include <stdio.h>

int main(void) {
    @errhandler(CCError e) {
        if (e.kind != CC_ERR_INVALID_ARG) return 1;
        printf("ok\n");
        return 0;
    }
    int[:] xs = { 1, 2 };
    int[:] ys = { 4, 5, 6 };
    for (a, b in xs, ys)
        (void)a;
    return 1;
}

/* Dest-bound by-value capture: `&x` is the copy, not the frame object. */
#include <ccc/std/prelude.cch>

int main(void) {
    @errhandler(CCError e) { cc_error_log(e); return 1; }
    int x = 0;
    CCParallel h = @parallel spawn { @serial { (void)0; } } !>;
    @parallel(h) {
        int* p = &x;
        (void)p;
    }
    h.wait() !>;
    return x;
}

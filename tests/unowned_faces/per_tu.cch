#ifndef TESTS_UNOWNED_FACES_PER_TU_CCH
#define TESTS_UNOWNED_FACES_PER_TU_CCH

#include <ccc/std/prelude.cch>

/* A face with no members: a module of one. `per_tu_step` is
 * module-private; `per_tu_val` is exported, defined once in the
 * module object every includer links. */
static int !>(CCError) per_tu_step(int x) {
    @errhandler(CCError e) { return cc_err(e); }
    return cc_ok(x);
}

int per_tu_val(void) {
    int x = per_tu_step(3) !> { return 0; };
    return x;
}

#endif

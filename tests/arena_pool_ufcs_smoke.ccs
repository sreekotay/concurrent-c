#include <ccc/std/prelude.cch>
#include <stdio.h>

struct Point {
    long long x;
    long long y;
};

int main(void) {
    cc_arena_stack(a, 1024);
    
    CCArenaPool p;
    cc_arena_pool_init(&p, &a, sizeof(struct Point));
    
    // Test UFCS alloc
    struct Point* p1 = (struct Point*)p.alloc();
    struct Point* p2 = (struct Point*)p.alloc();
    
    if (!p1 || !p2 || p1 == p2) {
        printf("FAIL: UFCS alloc\n");
        return 1;
    }
    
    p1->y = 200;
    
    // Test UFCS free
    p.free(p1);
    
    // Re-alloc
    struct Point* p3 = (struct Point*)p.alloc();
    if (p3 != p1) {
        printf("FAIL: UFCS reuse\n");
        return 1;
    }
    
    if (p3->y != 200) {
        printf("FAIL: UFCS data integrity (y should be preserved if it's after the freelist pointer)\n");
        return 1;
    }

    /* detach_arena moves a heap-owned L1. A stack L1 would dangle. */
    CCArena heap = cc_arena_heap(1024);
    CCArenaPool p_heap;
    cc_arena_pool_init(&p_heap, &heap, sizeof(struct Point));
    if (!p_heap.alloc()) {
        printf("FAIL: heap pool alloc\n");
        return 1;
    }
    CCArena detached = p_heap.detach_arena();
    if (detached.base == NULL || p_heap.arena != NULL) {
        printf("FAIL: UFCS detach_arena\n");
        return 1;
    }
    cc_arena_free(&detached);
    
    // Test owned pool
    CCArenaPool p_owned;
    if (cc_arena_pool(&p_owned, sizeof(struct Point)) != 0) {
        printf("FAIL: owned pool creation\n");
        return 1;
    }
    
    struct Point* p4 = (struct Point*)p_owned.alloc();
    if (!p4) {
        printf("FAIL: owned pool alloc\n");
        return 1;
    }
    
    p_owned.destroy();
    
    // Test cc_arena_pool_stack
    {
        cc_arena_pool_stack(p_stack, sizeof(struct Point), 1024);
        struct Point* p5 = (struct Point*)p_stack.alloc();
        if (!p5) {
            printf("FAIL: stack pool alloc\n");
            return 1;
        }
        p5->y = 500;
        p_stack.free(p5);
        struct Point* p6 = (struct Point*)p_stack.alloc();
        if (p6 != p5 || p6->y != 500) {
            printf("FAIL: stack pool reuse\n");
            return 1;
        }
        // p_stack and its arena should be cleaned up here via @defer
    }
    
    printf("arena_pool_ufcs_smoke ok\n");
    return 0;
}

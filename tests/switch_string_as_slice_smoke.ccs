#include <ccc/std/prelude.cch>
#include <assert.h>
#include <string.h>

/* UFCS inside opaque string-switch bodies (locals are not bind-registered). */
static int bulk_len(CCSlice name, CCString* v, CCArena* a) {
    switch (name) {
    case "GET": {
        if (!v) return -1;
        char[:] s = v->as_slice();
        return (int)s.len;
    }
    case "ECHO": {
        CCString owned = @string(`x`, a);
        char[:] s = owned.as_slice();
        return (int)s.len;
    }
    default:
        return 0;
    }
}

int main(void) {
    CCArena a = cc_arena_heap(kilobytes(1)) @destroy;
    assert(a.base);
    CCString s = cc_string_from_slice(&a, @slice("hello"));
    assert(bulk_len(char_to_slice("GET"), &s, &a) == 5);
    assert(bulk_len(char_to_slice("ECHO"), &s, &a) == 1);
    assert(bulk_len(char_to_slice("X"), &s, &a) == 0);
    return 0;
}

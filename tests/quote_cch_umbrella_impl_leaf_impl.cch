#ifndef TESTS_QUOTE_CCH_UMBRELLA_IMPL_LEAF_IMPL_CCH
#define TESTS_QUOTE_CCH_UMBRELLA_IMPL_LEAF_IMPL_CCH

#include <ccc/std/prelude.cch>

/* Own-text impl-grade: statement unwrap needs the including unit. */
static int !>(CCError) umbrella_impl_leaf_step(int x) {
    @errhandler(CCError e) { return cc_err(e); }
    return cc_ok(x);
}

static int umbrella_impl_leaf_add(int a, int b) {
    int x = umbrella_impl_leaf_step(a) !> { return -1; };
    int y = umbrella_impl_leaf_step(b) !> { return -1; };
    return x + y;
}

#endif

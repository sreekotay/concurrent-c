/* Slice declaration forms: declarator position (`T name[:]`) and type
 * position (`T[:] name`), with string-literal and braced initializers.
 * Braced initializers lower to a hidden block-scope backing array; the
 * slice is an untracked view with len = element count. */
#include <ccc/cc_runtime.cch>
#include <assert.h>
#include <stdio.h>
#include <string.h>

static double first(double v[:]) {
    return ((double*)v.ptr)[0];
}

int main(void) {
    /* Declarator position + string literal. */
    char s[:] = "test";
    assert(s.len == 4);
    assert(memcmp(s.ptr, "test", 4) == 0);

    /* Type position + string literal. */
    char[:] t = "hello";
    assert(t.len == 5);

    /* Declarator position + braced initializer: len = element count. */
    double xs[:] = {1.0, 2.0, 3.0, 4.0, 42.0};
    assert(xs.len == 5);
    assert(((double*)xs.ptr)[4] == 42.0);

    /* Type position + braced initializer. */
    int[:] ys = {1, 2, 3};
    assert(ys.len == 3);
    assert(((int*)ys.ptr)[2] == 3);

    /* Multi-token element type stays in declarator position. */
    unsigned long ul[:] = {7UL, 8UL};
    assert(ul.len == 2);
    assert(((unsigned long*)ul.ptr)[1] == 8UL);

    /* Empty braces make an empty slice. */
    char e[:] = {};
    assert(e.len == 0);

    /* Declarator position without initializer; plain assignment works. */
    char u[:];
    u = const_char_to_slice("x");
    assert(u.len == 1);

    /* Byte helpers still work on char slices from the new forms. */
    CCSlice sub = s.sub(1, 3);
    assert(sub.len == 2);
    assert(memcmp(sub.ptr, "es", 2) == 0);

    /* Declarator-position slice parameter. */
    assert(first(xs) == 1.0);

    printf("ok\n");
    return 0;
}

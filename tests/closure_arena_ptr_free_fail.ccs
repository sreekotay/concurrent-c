/* Fail: spawn worker cannot free() a captured arena pointer. */
#include <ccc/std/prelude.cch>
#include <stdlib.h>
#include <string.h>

int main(void) {
    @errhandler(CCError e) {
        (void)e;
        return 1;
    }

    CCArena buf = cc_arena_heap(kilobytes(4)) !> @destroy;
    char* base = cc_arena_alloc_T_count(char, buf, 64);
    if (!base) return 1;
    memset(base, 'x', 64);

    {
        CCNursery n = cc_nursery_create() !> @destroy;
        n.spawn(() => [base] {
            free(base); /* ERROR */
        }) !>;
    }
    return 0;
}

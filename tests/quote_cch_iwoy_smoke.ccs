#!ccc ccs
/* Extract names IwoyWs* only. IwoyWs is an anonymous struct in a
 * sibling face — listing still need not include that face; extract
 * pulls the unique defining sibling instead of inventing a tag. */
#include <stdio.h>
#include "quote_cch_iwoy_mod_leaf.cch"

int main(void) {
    if (iwoy_len(0) != 0) {
        printf("iwoy_len failed\n");
        return 1;
    }
    printf("ok\n");
    return 0;
}

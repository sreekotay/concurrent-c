/* @safe &x allows passing &x to a mutator; sync is the program's job. */
#include <ccc/cc_runtime.cch>
#include <ccc/cc_nursery.cch>
#include <stdio.h>

static void write_i32(int* p, int v) {
    if (p) *p = v;
}

int main(void) {
    @errhandler(CCError e) cc_error_exit(e);
    int x = 7;

    {
        CCNursery n = @create() !> @destroy;

        n.spawn(() => [@safe &x] {
            write_i32(&x, 42);
        }) !>;
    }

    if (x != 42) {
        printf("expected 42 got %d\n", x);
        return 1;
    }
    return 0;
}

/* T[n] constexpr .len and @for (v in a). */
#include <ccc/std/prelude.cch>
#include <stdio.h>

int main(void) {
    int a[4] = { 1, 2, 3, 4 };
    int sum = 0;
    if (a.len != 4) return 1;
    if (a.len() != 4) return 2;
    @for (v in a)
        sum += v;
    if (sum != 10) return 3;
    printf("ok\n");
    return 0;
}

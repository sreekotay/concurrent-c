/* Unresolved UFCS must be ill-formed.  `w.nonexistent_method(42)` has no
   matching struct member, no declared extension, and no bare-name
   binding, so the ladder fails loud: it names the receiver's type and
   walks the candidate tiers.  This comment deliberately spells
   Widget_nonexistent_method(&w, 42) with a paren — a name mentioned
   only in a comment must never count as a visible declaration. */
#include <ccc/std/prelude.cch>
#include <stdio.h>

typedef struct Widget {
    int base;
} Widget;

int main(void) {
    Widget w = { .base = 100 };
    int r = w.nonexistent_method(42);
    printf("should-not-reach: %d\n", r);
    return 0;
}

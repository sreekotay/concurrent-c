/* Void arms (spec/draft_variants.md §3-§4): payload-less arms are declared
 * `arm: void;`, constructed with the empty-braces designator
 * `{ .hup = {} }` (lowered to tag-only init), and the raw tag-only
 * spelling `{ .kind = Signal_hup }` stays valid.  Void arms are switchable
 * via designator case labels like any other arm. */
#include <ccc/std/prelude.cch>
#include <stdio.h>

@variant Signal {
    hup:  void;
    term: void;
    info: int;
};

static int classify(Signal s) {
    switch (s) {
        case .hup:  return 1;
        case .term: return 2;
        case .info: return 100 + s.info;
    }
    return -1;
}

int main(void) {
    Signal a = { .hup = {} };
    if (classify(a) != 1) return 1;

    Signal b = { .kind = Signal_term };   /* raw tag-only init stays valid */
    if (classify(b) != 2) return 2;

    Signal c = { .info = 7 };
    if (classify(c) != 107) return 3;

    a = { .term = {} };                   /* braced assignment to a void arm */
    if (classify(a) != 2) return 4;

    printf("ok\n");
    return 0;
}

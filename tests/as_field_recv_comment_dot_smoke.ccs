#include <ccc/std/prelude.cch>
#include <assert.h>
#include <stdio.h>
#include <string.h>

typedef struct {
    CCFile file @as;
    int tag;
} AsCommentWrap;

/* `@as` UFCS retry across a comment before `.`. */
int main(void) {
    AsCommentWrap w = {0};
    w.tag = 3;
    assert(w /*as*/ .open(cc_slice_from_cstr("tmp/as_field_recv_comment_dot.txt"), "w") == 0);
    CCRes(size_t, CCIoError) wr =
        w /* don't */ .write(cc_slice_from_cstr("hi\n"));
    assert(cc_is_ok(wr));
    assert(cc_value(wr) == 3);
    w /*as*/ .close();
    remove("tmp/as_field_recv_comment_dot.txt");
    printf("as_field_recv_comment_dot_smoke ok\n");
    return 0;
}

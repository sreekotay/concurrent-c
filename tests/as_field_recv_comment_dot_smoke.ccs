#include <ccc/std/prelude.cch>
#include <assert.h>
#include <stdio.h>
#include <string.h>

typedef struct {
    CCFile file;
    int tag;
} AsCommentWrap;

@typeview on AsCommentWrap {
    as: file;
};

/* as: UFCS retry across a comment before `.`. */
int main(void) {
    AsCommentWrap w = {0};
    w.tag = 3;
    w.create("tmp/as_field_recv_comment_dot.txt") !>(e) {
        fprintf(stderr, "create: %s\n", cc_error_str(e));
        return 1;
    };
    CCRes(size_t, CCIoError) wr =
        w /* don't */ .write(CC_SLICE_LIT("hi\n"));
    assert(cc_is_ok(wr));
    assert(cc_value(wr) == 3);
    w /*as*/ .close();
    remove("tmp/as_field_recv_comment_dot.txt");
    printf("as_field_recv_comment_dot_smoke ok\n");
    return 0;
}

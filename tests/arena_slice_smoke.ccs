/* Smoke: arena.slice(ptr, len) / cc_arena_slice stamps arena provenance. */
#include <ccc/std/prelude.cch>
#include <stdio.h>
#include <string.h>

int main(void) {
    {
        CCSlice empty = cc_arena_slice(NULL, (void*)"x", 1);
        if (!cc_slice_is_empty(&empty)) return 1;
    }
    {
        CCArena a = cc_arena_heap(kilobytes(1));
        if (!a.base) return 2;
        CCSlice empty = a.slice(NULL, 1);
        if (!cc_slice_is_empty(&empty)) return 3;
        cc_arena_free(&a);
    }

    CCArena arena = cc_arena_heap(kilobytes(4));
    if (!arena.base) return 4;
    char* p = (char*)cc_arena_alloc(&arena, 16, 1);
    if (!p) return 5;
    memcpy(p, "view-arena", 10);

    CCSlice view = arena.slice(p, 10);
    if (!view.ptr || view.len != 10) return 6;
    if (cc_slice_is_untracked(view)) return 7;
    if (!cc_slice_is_from_arena_epoch(view, &arena)) return 8;
    if (memcmp(view.ptr, "view-arena", 10) != 0) return 9;

    uint64_t old_id = cc_slice_alloc_id(view.id);
    cc_arena_reset(&arena);
    CCSlice stale = cc_slice_from_parts(p, 10, cc_slice_make_id(old_id, false, false, false));
    if (cc_slice_is_from_arena_epoch(stale, &arena)) return 10;

    cc_arena_free(&arena);
    printf("arena_slice_smoke: ok\n");
    return 0;
}

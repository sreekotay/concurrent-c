/* Bare designator in assignment position (spec/draft_variants.md §5a,
 * amendment): a bare `.arm` is resolved by the assignment target's type —
 * `RedisValueKind k = .num;` and `k = .txt;` — and kind-typed variables
 * compare against designators and drive switches. */
#include <ccc/std/prelude.cch>
#include <stdio.h>
#include <stdint.h>

@variant RedisValue {
    txt: const char*;
    num: int64_t;
};

int main(void) {
    RedisValueKind k = .num;               /* decl-init target resolves */
    if (k != RedisValue_num) return 1;

    k = .txt;                              /* assignment target resolves */
    if (k != RedisValue_txt) return 2;

    if (k == .txt) {                       /* kind-typed partner resolves */
        k = .num;
    }
    if (k != RedisValue_num) return 3;

    RedisValue v = { .num = 9 };
    if (v.kind != k) return 4;             /* kind read compares to kind var */

    printf("ok\n");
    return 0;
}

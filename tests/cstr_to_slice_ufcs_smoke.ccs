#include <ccc/std/prelude.cch>
#include <assert.h>
#include <stdio.h>
#include <string.h>

int main(void) {
    const char *path = "/tmp/cstr_to_slice_ufcs";
    char *mut = (char *)"hello";
    char const *east = "east-const";
    unsigned char *ubytes = (unsigned char *)"ubytes";

    /* Dest-cast: bound char* → cc_slice_cstr. Explicit helper still works. */
    char[:0] a = path;
    char[:0] a2 = cc_slice_cstr(path);
    (void)a2;
    char[:0] b = cc_slice_cstr(mut);
    char[:0] c = "literal";
    char[:0] e = cc_slice_cstr(east);

    /* Counted UFCS — length is explicit, not strlen-hiding. */
    char[:0] f = ubytes->to_slice_n(6);
    char[:0] g = mut->to_slice_n(5);

    assert(a.len == strlen(path));
    assert(CCSlice_eq_cstr(&a, path));
    assert(CCSlice_eq_cstr(&b, "hello"));
    assert(CCSlice_eq_cstr(&c, "literal"));
    assert(CCSlice_eq_cstr(&e, "east-const"));
    assert(CCSlice_eq_cstr(&f, "ubytes"));
    assert(CCSlice_eq_cstr(&g, "hello"));
    assert(cc_slice_cstr(NULL).len == 0);
    assert(char_to_slice_n(NULL, 0).len == 0);

    printf("cstr_to_slice_ufcs_smoke: PASS\n");
    return 0;
}

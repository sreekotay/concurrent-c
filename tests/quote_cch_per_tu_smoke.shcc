/* All-static unowned face: two TUs splice a private copy (no pragma). */
CCArena a = cc_arena_heap(megabytes(1)) @destroy;

CCCommand emit_a = cc_command(a, @slice("./cc/bin/ccc"));
emit_a.arg("--no-cache");
emit_a.arg("--emit-c-only");
emit_a.arg("tests/quote_cch_per_tu_a_mod.ccs");
emit_a.arg("-o");
emit_a.arg("out/quote_cch_per_tu_a.c");
emit_a.inherit_stdio();
int rc = emit_a.status() !>;
if (rc != 0) {
    "emit a failed".println() !>;
    return 1;
}

CCCommand grep_static = cc_command(a, @slice("grep"));
grep_static.arg("-q");
grep_static.arg("static int per_tu_val");
grep_static.arg("out/quote_cch_per_tu_a.c");
rc = grep_static.status() !>;
if (rc != 0) {
    "per_tu emit dropped static".println() !>;
    return 1;
}

CCCommand build = cc_command(a, @slice("./cc/bin/ccc"));
build.arg("build");
build.arg("--no-cache");
build.arg("tests/quote_cch_per_tu_a_mod.ccs");
build.arg("tests/quote_cch_per_tu_b_mod.ccs");
build.arg("-o");
build.arg("out/quote_cch_per_tu_smoke");
build.inherit_stdio();
rc = build.status() !>;
if (rc != 0) {
    "build failed".println() !>;
    return 1;
}
CCCommand run = cc_command(a, @slice("out/quote_cch_per_tu_smoke"));
run.inherit_stdio();
rc = run.status() !>;
if (rc != 0) {
    "run failed".println() !>;
    return 1;
}
return 0;

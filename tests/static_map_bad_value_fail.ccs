/* Fail: static_map value types must be flat POD integer/enum structs.
 * A pointer field is rejected at the map with a keyed comptime error. */
#include <ccc/std/prelude.cch>
#include <ccc/std/static_map.cch>

typedef struct Spec {
    int n;
    const char* label;
} Spec;

typedef struct SpecEntry {
    const char* key;
    Spec value;
} SpecEntry;

@comptime {
    SpecEntry entries[] = {
        { "ok", { 1, "x" } },
    };
    static_map("demo", entries, CC_STATIC_MAP_CASE_SENSITIVE);
}

int main(void) { return 0; }

    /* Missing ';' between members → invalid C, rejected at the use site. */
    return @emit(`typedef struct { ${arg(0)} a ${arg(0)} b; } ${mangled};`, arena);
}
#line 18 "comptime_factory_line_provenance_fail.ccs"

int main(void) {
    Bad::[int] b;
    (void)b;
    return 0;

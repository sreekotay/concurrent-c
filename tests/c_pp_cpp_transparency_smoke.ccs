/* Phase 3: `#if`/`#elif`/`#else`/`#endif` are emitted for host cpp; both
 * arms are lowered (not stage-2-evaluated away). */
#include <ccc/std/prelude.cch>

@grammar(rules) PpTok {~~~~
    include "../cc/shadow/pp_tok.rules"
~~~~}

@grammar(rules) PpStmt {~~~~
    include "../cc/shadow/pp_stmt.rules"
~~~~}

/* Demand grammar tiers before the umbrella pulls headers that call them. */
static int cpp_t_keep_nop(void* env, int id, CCSlice v) {
    (void)env; (void)id; (void)v;
    return 0;
}
static void cpp_t_demand_grammars(void) {
    CCArena gate = cc_arena_create(4096);
    (void)PpTok_match(";", 1);
    (void)PpTok_collect(";", 1, gate, cpp_t_keep_nop, NULL);
    (void)PpStmt_match("break;", 6);
    cc_arena_free(&gate);
}

#include "../cc/shadow/c_pp_spike.cch"

int main(void) {
    const char* src =
        "#if 0\n"
        "int dead_arm = 1;\n"
        "#else\n"
        "int live_arm = 2;\n"
        "#endif\n";
    char* owned = (char*)malloc(strlen(src) + 1);
    TapeCache cache = {0};
    CCArena arena = cc_arena_create(1 << 20);
    FileTape* ft;
    Token out_buf[256];
    Pp pp = {0};
    Parser p = {0};
    AstNode** items = NULL;
    int nitems = 0;
    int i, saw_if = 0, saw_else = 0, saw_endif = 0, saw_dead = 0, saw_live = 0;

    cpp_t_demand_grammars();

    if (!owned) { printf("FAIL: oom\n"); return 1; }
    memcpy(owned, src, strlen(src) + 1);
    ft = tape_cache_load_bytes(&cache, "<cpp-transparency>", owned, strlen(src), arena);
    if (!ft) { printf("FAIL: tape\n"); return 1; }

    pp.cache = &cache;
    pp.arena = arena;
    pp.out = out_buf;
    pp.out_cap = 256;
    if (!pp_run(&pp, ft)) {
        printf("FAIL: pp_run: %s\n", pp.err_msg);
        return 1;
    }
    for (i = 0; i < pp.nout; i++) {
        Token t = out_buf[i];
        if (t.kind == TK_IDENT && t.spell.len >= 3 && t.spell.ptr[0] == '#') {
            if (t.spell.len >= 3 && memcmp(t.spell.ptr, "#if", 3) == 0)
                saw_if = 1;
            if (t.spell.len >= 5 && memcmp(t.spell.ptr, "#else", 5) == 0)
                saw_else = 1;
            if (t.spell.len >= 6 && memcmp(t.spell.ptr, "#endif", 6) == 0)
                saw_endif = 1;
        }
        if (t.kind == TK_IDENT && spell_eq(t.spell, "dead_arm")) saw_dead = 1;
        if (t.kind == TK_IDENT && spell_eq(t.spell, "live_arm")) saw_live = 1;
    }
    if (!saw_if || !saw_else || !saw_endif) {
        printf("FAIL: stage2 missing cpp dirs if=%d else=%d endif=%d nout=%d\n",
               saw_if, saw_else, saw_endif, pp.nout);
        return 1;
    }
    if (!saw_dead || !saw_live) {
        printf("FAIL: stage2 dropped an arm dead=%d live=%d\n", saw_dead,
               saw_live);
        return 1;
    }

    p.toks = out_buf;
    p.n = pp.nout;
    p.cache = &cache;
    if (!parse_tu(&p, &items, &nitems)) {
        printf("FAIL: parse_tu (%s) i=%d nout=%d\n", p.err_msg, p.i, pp.nout);
        return 1;
    }
    saw_if = saw_else = saw_endif = saw_dead = saw_live = 0;
    for (i = 0; i < nitems; i++) {
        AstNode* it = items[i];
        if (it->kind == AST_RAW_LINE && strcmp(it->e, "ppdir") == 0) {
            if (strncmp(it->a, "#if", 3) == 0) saw_if = 1;
            if (strncmp(it->a, "#else", 5) == 0) saw_else = 1;
            if (strncmp(it->a, "#endif", 6) == 0) saw_endif = 1;
        }
        if (strstr(it->a, "dead_arm") || strstr(it->b, "dead_arm"))
            saw_dead = 1;
        if (strstr(it->a, "live_arm") || strstr(it->b, "live_arm"))
            saw_live = 1;
    }
    if (!saw_if || !saw_else || !saw_endif || !saw_dead || !saw_live) {
        printf("FAIL: AST missing pieces if=%d else=%d endif=%d dead=%d live=%d "
               "n=%d\n",
               saw_if, saw_else, saw_endif, saw_dead, saw_live, nitems);
        return 1;
    }

    /* `#ifdef` / `#ifndef` on the root tape match `#if`: emit the line,
     * keep both arms, leave `#define` in place (do not apply / hoist). */
    {
        const char* src2 =
            "#ifdef HAVE_GETADDRINFO\n"
            "#define RESOLVER_ENOMEM  EAI_MEMORY\n"
            "int eai_arm = 1;\n"
            "#else\n"
            "#define RESOLVER_ENOMEM  SOCKENOMEM\n"
            "int sock_arm = 2;\n"
            "#endif\n"
            "int use = RESOLVER_ENOMEM;\n";
        char* owned2 = (char*)malloc(strlen(src2) + 1);
        FileTape* ft2;
        Token out2[256];
        Pp pp2 = {0};
        int saw_ifdef = 0, saw_eai_def = 0, saw_sock_def = 0;
        int saw_eai = 0, saw_sock = 0, saw_use_ident = 0, saw_expanded = 0;
        int nifdef = 0, nelse = 0, nendif = 0;

        if (!owned2) { printf("FAIL: oom ifdef\n"); return 1; }
        memcpy(owned2, src2, strlen(src2) + 1);
        ft2 = tape_cache_load_bytes(&cache, "<cpp-ifdef>", owned2, strlen(src2), arena);
        if (!ft2) { printf("FAIL: tape ifdef\n"); return 1; }
        pp2.cache = &cache;
        pp2.arena = arena;
        pp2.out = out2;
        pp2.out_cap = 256;
        if (!pp_run(&pp2, ft2)) {
            printf("FAIL: pp_run ifdef: %s\n", pp2.err_msg);
            return 1;
        }
        for (i = 0; i < pp2.nout; i++) {
            Token t = out2[i];
            if (t.kind == TK_IDENT && t.spell.len > 0 && t.spell.ptr[0] == '#') {
                if (t.spell.len >= 6 && memcmp(t.spell.ptr, "#ifdef", 6) == 0) {
                    saw_ifdef = 1;
                    nifdef++;
                }
                if (t.spell.len >= 5 && memcmp(t.spell.ptr, "#else", 5) == 0)
                    nelse++;
                if (t.spell.len >= 6 && memcmp(t.spell.ptr, "#endif", 6) == 0)
                    nendif++;
                if (t.spell.len >= 8 && memcmp(t.spell.ptr, "#define", 7) == 0) {
                    if (strstr(t.spell.ptr, "EAI_MEMORY")) saw_eai_def = 1;
                    if (strstr(t.spell.ptr, "SOCKENOMEM")) saw_sock_def = 1;
                }
            }
            if (t.kind == TK_IDENT && spell_eq(t.spell, "eai_arm")) saw_eai = 1;
            if (t.kind == TK_IDENT && spell_eq(t.spell, "sock_arm")) saw_sock = 1;
            if (t.kind == TK_IDENT && spell_eq(t.spell, "RESOLVER_ENOMEM"))
                saw_use_ident = 1;
            if (t.kind == TK_IDENT && (spell_eq(t.spell, "EAI_MEMORY") ||
                                       spell_eq(t.spell, "SOCKENOMEM")))
                saw_expanded = 1;
        }
        if (!saw_ifdef || nifdef != 1 || nelse != 1 || nendif != 1) {
            printf("FAIL: ifdef dirs ifdef=%d n#ifdef=%d n#else=%d n#endif=%d\n",
                   saw_ifdef, nifdef, nelse, nendif);
            return 1;
        }
        if (!saw_eai_def || !saw_sock_def) {
            printf("FAIL: ifdef dropped a #define eai=%d sock=%d\n",
                   saw_eai_def, saw_sock_def);
            return 1;
        }
        if (!saw_eai || !saw_sock) {
            printf("FAIL: ifdef dropped an arm eai=%d sock=%d\n", saw_eai,
                   saw_sock);
            return 1;
        }
        if (!saw_use_ident || saw_expanded) {
            printf("FAIL: RESOLVER_ENOMEM not left for host cpp use=%d "
                   "expanded=%d\n",
                   saw_use_ident, saw_expanded);
            return 1;
        }
        if (pp2.npass_def != 0) {
            printf("FAIL: ifdef #define was hoisted npass_def=%d\n",
                   pp2.npass_def);
            return 1;
        }
    }

    printf("cpp-transparency: both arms + host #if / #ifdef structure OK\n");
    return 0;
}

/* js_fn: CC host callables into JS (hosted napi mint + isolated wire). */
#include <ccc/std/prelude.cch>
#include <ccc/script/js.cch>
#include <stdio.h>
#include <string.h>

static CCJsDomVal !>(CCJsError) add40(long long add, const CCJsDomVal *args,
                                      int argc) {
    @errhandler(CCJsError e) { return cc_err(e); }
    if (argc < 1)
        return cc_err(cc_js_host_error("add40: expected a number"));
    long long x = cc_js_dom_val_as_i64((CCJsDomVal *)&args[0]) !>;
    return cc_ok(cc_js_i64(args[0].dom, x + add));
}

static CCJsDomVal !>(CCJsError) boom(CCJsDomHostUserdata userdata,
                                     const CCJsDomVal *args, int argc) {
    (void)userdata;
    (void)args;
    (void)argc;
    return cc_err(cc_js_host_error("from cc"));
}

static int run_domain(CCJsDom *js, const char *tag) {
    @errhandler(CCJsError e) {
        fprintf(stderr, "%s: %s\n", tag,
                e.base.message ? e.base.message : "?");
        return 1;
    }

    /* apply(f, x) => f(x) + 1; host fn returns arg+40 → 42. */
    js->exec("globalThis.apply = (f, x) => f(x) + 1") !>;
    CCJsDomVal g = js->eval("globalThis") !> @destroy;
    long long got = g.apply(js_fn(add40, 40), 1LL) !>;
    printf("%s_apply %s\n", tag, got == 42 ? "true" : "false");
    if (got != 42) return 1;

    /* Host fn failure → JS throw → Result error with the message. */
    js->exec("globalThis.call = (f) => f()") !>;
    CCJsDomVal bad = g.call(js_fn(boom, NULL)) !>(e) {
        int ok = e.base.message && strstr(e.base.message, "from cc") != NULL;
        printf("%s_error %s\n", tag, ok ? "true" : "false");
        if (!ok)
            fprintf(stderr, "message: %s\n",
                    e.base.message ? e.base.message : "(null)");
        return ok ? 0 : 1;
    } @destroy;
    (void)bad;
    printf("%s_error false\n", tag);
    return 1;
}

int main(void) {
    @errhandler(CCError e) {
        fprintf(stderr, "fatal: %s\n", e.message);
        return 1;
    }
    CCArena a = cc_arena_heap(megabytes(1)) @destroy;
    int rc = 0;
    int any = 0;

    if (cc_js_dom_available(false)) {
        CCJsDom js = cc_js_new(false, a) !> @destroy;
        rc |= run_domain(&js, "hosted");
        any = 1;
    } else {
        printf("hosted_apply SKIP\n");
        printf("hosted_error SKIP\n");
    }

    if (cc_js_dom_available(true)) {
        CCJsDom js = cc_js_new(true, a) !> @destroy;
        rc |= run_domain(&js, "iso");
        any = 1;
    } else {
        printf("iso_apply SKIP\n");
        printf("iso_error SKIP\n");
    }

    if (!any) {
        printf("SKIP (no libnode and no node on PATH)\n");
        return 0;
    }

    printf("clean_exit true\n");
    return rc;
}

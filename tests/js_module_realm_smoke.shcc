/* Instancing is copy-per-realm, verified by mutation: the exported seed
 * is COPIED into arena fresh T at each registration, so arena worker_thread
 * requiring the same .node sees the seed value, never the main realm's
 * mutations — the load-bearing fact behind "stateful kernels are safe
 * by default".  (The Python twin is py_host_module_isolated_smoke: two
 * subinterpreters, same mutation independence.) */
CCArena arena = cc_arena_heap(megabytes(1)) @destroy;

{
    CCCommand which = cc_command(arena, @slice("sh"));
    which.arg("-c");
    which.arg("command -v node >/dev/null 2>&1");
    int rc = which.status() !>;
    if (rc != 0) { "SKIP (no node)".println(); return 0; }
}

{
    CCCommand build = cc_command(arena, @slice("./cc/bin/ccc"));
    build.arg("build");
    build.arg("examples/recipe_js_module.ccs");
    build.inherit_stdio();
    int rc = build.status() !>;
    if (rc != 0) { "build failed".println(); return 1; }
}

{
    CCCommand run = cc_command(arena, @slice("sh"));
    run.arg("-c");
    run.arg("mkdir -p tmp && cat > tmp/cc_realm_worker.js <<'WEOF'\n"
            "const { parentPort } = require('worker_threads');\n"
            "const c = require(process.cwd() + '/bin/counter.node');\n"
            "parentPort.postMessage([c.total(), c.bump(7)]);\n"
            "WEOF\n"
            "node -e \"\n"
            "const { Worker } = require('worker_threads');\n"
            "const c = require(process.cwd() + '/bin/counter.node');\n"
            "c.bump(41);\n"
            "const w = new Worker('./tmp/cc_realm_worker.js');\n"
            "w.on('message', ({ 0: fresh, 1: bumped }) => {\n"
            "  console.log('main_mutated', c.total() === 141);\n"
            "  console.log('worker_sees_seed', fresh === 100);\n"
            "  console.log('worker_own_state', bumped === 107);\n"
            "  process.exit(0);\n"
            "});\n\"");
    run.inherit_stdio();
    int rc = run.status() !>;
    if (rc != 0) { "realm run failed".println(); return 1; }
}
return 0;

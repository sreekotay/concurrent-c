#include <ccc/cc_nursery.cch>
// Smoke: spawn should accept a CCClosure0 value (not just a literal).
#include <ccc/cc_closure.cch>

int g = 0;

int main(void) {
    @errhandler(CCError e) cc_error_exit(e);
    CCClosure0 c = () => { g = 9; };
    {
        CCNursery __cc_nursery88 = @create() !> @destroy;

        __cc_nursery88.spawn (c) !>;
    
    }
    return (g == 9) ? 0 : 1;
}


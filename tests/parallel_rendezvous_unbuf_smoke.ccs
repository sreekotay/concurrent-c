/*
 * Complementary send/recv across two brace arms: `@parallel spawn`
 * admits both so the consumer is live while the kick parks.
 */
#include <ccc/std/prelude.cch>
#include <stdio.h>

int main(void) {
    @errhandler(CCError e) { cc_error_log(e); return 1; }

    {
        int[~ >] tx;
        int[~ <] rx;
        CCChan* ch = cc_channel_pair(&tx, &rx) !> @destroy;
        int got = 0;
        @parallel spawn {
            @serial {
                tx.send(7) !>;
                tx.close();
            }
            @serial {
                int v = 0;
                if (!cc_io_avail(rx.recv(&v)))
                    return 2;
                got = v;
            }
        } !>.wait()!>;
        if (got != 7) {
            fprintf(stderr, "FAIL join got=%d\n", got);
            return 3;
        }
    }

    {
        int[~ >] tx;
        int[~ <] rx;
        CCChan* ch = cc_channel_pair(&tx, &rx) !> @destroy;
        int got = 0;
        CCParallel h = @parallel spawn {
            @serial {
                tx.send(9) !>;
                tx.close();
            }
            @serial {
                int v = 0;
                if (!cc_io_avail(rx.recv(&v)))
                    return 4;
                got = v;
            }
        } !>;
        h.wait() !>;
        if (got != 9) {
            fprintf(stderr, "FAIL dest got=%d\n", got);
            return 5;
        }
    }

    printf("parallel_rendezvous_unbuf_smoke: OK\n");
    return 0;
}

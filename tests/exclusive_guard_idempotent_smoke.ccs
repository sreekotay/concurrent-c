/*
 * Guard double-release is a local no-op (NULL entry), not a lock-word protocol.
 */
#include <ccc/std/prelude.cch>
#include <ccc/cc_exclusive.cch>
#include <stdio.h>

int main(void) {
    @errhandler(CCError e) {
        fprintf(stderr, "%s\n", e.message ? e.message : "error");
        return 1;
    }
    CCArena arena = @create(kilobytes(16)) @destroy;
    CCExclusive excl = cc_exclusive_create(arena, 0) !> @destroy;

    CCExclusiveMutex m = excl.mutex(42);
    int x = 0;
    {
        CCExclusiveGuard g = m.acquire();
        x++;
        g.release();
        g.release(); /* must be safe */
        g.destroy(); /* alias; still safe */
    }

    /* Still usable after double-release. */
    {
        CCExclusiveGuard g = m.acquire();
        x++;
        g.release();
    }

    if (x != 2) {
        fprintf(stderr, "FAIL x=%d\n", x);
        return 1;
    }
    printf("exclusive_guard_idempotent_smoke: OK\n");
    return 0;
}

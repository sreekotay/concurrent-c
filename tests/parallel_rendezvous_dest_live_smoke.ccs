/*
 * Dest-live consume (helper / recv in the join) + send after the
 * handle is live. `@parallel spawn` admits the worker; deny is a hang.
 */
#include <ccc/std/prelude.cch>
#include <stdio.h>

static int consume(int[~ <] rx) {
    int v = 0;
    if (!cc_io_avail(rx.recv(&v)))
        return 0;
    return v;
}

int main(void) {
    @errhandler(CCError e) { cc_error_log(e); return 1; }

    int[~ >] tx;
    int[~ <] rx;
    CCChan* ch = cc_channel_pair(&tx, &rx) !> @destroy;
    int got = 0;
    CCParallel h = @parallel spawn {
        @serial { got = consume(rx); }
    } !>;
    tx.send(9) !>;
    tx.close();
    h.wait() !>;
    if (got != 9) {
        fprintf(stderr, "FAIL dest-live got=%d\n", got);
        return 2;
    }
    printf("parallel_rendezvous_dest_live_smoke: OK\n");
    return 0;
}

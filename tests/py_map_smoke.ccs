#include <ccc/std/prelude.cch>
#include <ccc/script/py.cch>
#include <stdio.h>
#include <string.h>

/* `f.map::[T](arena, cols...)` — one crossing calls f once per row.
 *
 * Mixed column types on purpose: a row is then a heterogeneous argument
 * tuple, which is the case the batching question was really about. The
 * result is checked against the same calls made one at a time, so the
 * vector path and the scalar path cannot drift.
 *
 * A raising row reports its exception; a length mismatch names the column;
 * neither returns a slice. */
int main(void) {
    @errhandler(CCError e) { fprintf(stderr, "fatal: %s\n", e.message); return 1; }
    CCArena a = cc_arena_heap(megabytes(1)) @destroy;
    if (!cc_py_available()) { puts("SKIP (no libpython)"); return 0; }
    CCPy py = cc_py_new(false, a) !>;

    py.exec(@string(`
        def mul_add(x, k, z):
            return x * k + z
        def bad(x, k, z):
            if k == 2: raise ValueError('row two')
            return 0.0
        `, &a).as_slice()) !>;
    CCPyObj m = py.import("__main__") !> @destroy;
    CCPyObj f = m.get("mul_add") !> @destroy;
    CCPyObj bad = m.get("bad") !> @destroy;

    double xs[:]  = {1.5, 2.5, 3.5, 4.5};
    double twoval[:] = {1.0, 2.0};
    int64_t ks[:] = {2, 3, 4, 5};          /* mixed: int column */
    double zs[:]  = {0.25, 0.25, 0.25, 0.25};

    CCSlice out = f.map::[double](a, xs, ks, zs) !>;
    const double *ov = (const double *)out.ptr;

    int ok = out.len == 4;
    for (size_t i = 0; i < 4 && ok; i++) {
        double want = m.mul_add(((const double *)xs.base.ptr)[i],
                            ((const int64_t *)ks.base.ptr)[i],
                            ((const double *)zs.base.ptr)[i]) !>;
        ok = ov[i] == want;
    }
    printf("map ok=%d first=%.2f last=%.2f\n", ok, ov[0], ov[3]);

    /* A raising row surfaces as an error naming the row (k==2 is row 0),
     * not a partial slice. */
    {
        CCResult_CCSlice_CCPyError r = cc_py_obj_map(double, &bad, &a, xs, ks, zs);
        const char *msg = r.is_err() ? CCResult_CCSlice_CCPyError_error(r).base.message : "";
        printf("raise_caught=%d row_named=%d\n", r.is_err() ? 1 : 0,
               strstr(msg, "row 0") != NULL);
    }
    /* Length mismatch is structural, named before any call runs. */
    {
        CCResult_CCSlice_CCPyError r2 = cc_py_obj_map(double, &f, &a, xs, twoval, zs);
        const char *msg = r2.is_err() ? CCResult_CCSlice_CCPyError_error(r2).base.message : "";
        printf("len_caught=%d col_named=%d\n", r2.is_err() ? 1 : 0,
               strstr(msg, "column 1") != NULL);
    }
    return ok ? 0 : 1;
}

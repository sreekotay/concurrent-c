#include <ccc/std/prelude.cch>
#include <stdio.h>

/* Comment between `.` and method name — sole UFCS site in the file so a
 * false-negative gate would leave the whole TU unlowered. */
int main(void) {
    @errhandler(CCError e) { (void)e; return 1; }
    CCArena a = cc_arena_heap(kilobytes(8));
    CCArena d = a. /*gap*/ detach() !>;
    void *probe = cc_arena_alloc(&d, 16, 8);
    printf("ufcs_dot_comment_method_smoke ok %d\n", probe != NULL);
    return 0;
}

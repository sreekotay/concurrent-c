/* @async with BufReader::[T]* params + a body that exceeds the old 8KiB
 * rewrite buffer — params must become `__f->__p_*` (not silent truncate). */
#include <ccc/std/prelude.cch>
#include <ccc/std/net.cch>
#include <stdio.h>
#include <string.h>

typedef struct Cmd {
    CCSlice args[4];
    size_t argc;
} Cmd;

@async int !>(CCError) read_cmd(BufReader::[CCSocket]* br, Cmd* out, CCArena a) {
    /* Many small statements (emit #line grows past 8KiB). */
    size_t i;
    memset(out, 0, sizeof(*out));
    for (i = 0; i < 200; i++) {
        if (!br || !out || !a.p) return cc_err(CC_ERR_INVALID_ARG, "null");
        (void)br->eof;
        (void)a;
        out->argc = 0;
    }
    if (!br || !out || !a.p) return cc_err(CC_ERR_INVALID_ARG, "null");
    out->argc = 1;
    out->args[0] = CC_SLICE_LIT("ok");
    return cc_ok(1);
}

int main(void) {
    @errhandler(CCError e) {
        fprintf(stderr, "async_large_body: %s\n", e.message);
        return 1;
    }
    char buf[64];
    CCSocket sock = {0};
    BufReader::[CCSocket] br;
    Cmd c;
    CCArena a = cc_arena_heap(1024) @destroy;
    br.init(&sock, buf, sizeof(buf));
    int n = @await read_cmd(&br, &c, a) !>;
    if (n != 1 || c.argc != 1) return 2;
    printf("async_large_body_param_rewrite_smoke ok\n");
    return 0;
}

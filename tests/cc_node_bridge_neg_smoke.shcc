/* Articulate-error pack for cc-node: reserved keys, unsupported types,
 * foreign handle as call arg, use-after-release, non-callable handle,
 * after-close doors.  Rungs in tests/cc_node_bridge_neg.py. */
CCArena a = cc_arena_heap(megabytes(1)) @destroy;

{
    CCCommand which = cc_command(&a, @slice("sh"));
    which.arg("-c");
    which.arg("command -v node >/dev/null 2>&1 && command -v python3 >/dev/null 2>&1");
    int rc = which.status() !>;
    if (rc != 0) { "SKIP (need node + python3)".println() !>; return 0; }
}

{
    CCCommand run = cc_command(&a, @slice("python3"));
    run.arg("tests/cc_node_bridge_neg.py");
    run.inherit_stdio();
    int rc = run.status() !>;
    if (rc != 0) { "cc-node neg suite failed".println() !>; return 1; }
}
return 0;

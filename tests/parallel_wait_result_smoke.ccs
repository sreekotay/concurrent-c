/* @parallel wait for is bool !>(CCError): true if the range finished. */
#include <ccc/std/prelude.cch>
#include <stdio.h>

#define N 4

static int run(int use_par, int cut, int* out_fin) {
    @errhandler(CCError e) { cc_error_log(e); return 1; }
    CCArena arena = cc_arena_heap(kilobytes(64)) @destroy;
    CCTurnstile ts@(2, 1, &arena) @destroy;
    if (!ts.excl)
        return 1;
    int i;
    int xs[N];
    for (i = 0; i < N; i++) xs[i] = 0;
    bool fin = @parallel seq (use_par) wait (ts) for (i in 0..N) {
        @stage (ts, 0, i) {
            xs[i] = 1;
        }
        if (cut >= 0 && i == cut)
            break;
    } !>;
    *out_fin = fin ? 1 : 0;
    if (cut < 0) {
        for (i = 0; i < N; i++) {
            if (xs[i] != 1) return 1;
        }
        if (!fin) return 1;
    } else {
        if (fin) return 1;
        if (xs[cut] != 1) return 1;
    }
    return 0;
}

static int run_assign(void) {
    @errhandler(CCError e) { cc_error_log(e); return 1; }
    CCArena arena = cc_arena_heap(kilobytes(64)) @destroy;
    CCTurnstile ts@(2, 1, &arena) @destroy;
    if (!ts.excl)
        return 1;
    int i;
    bool fin;
    fin = @parallel seq (0) wait (ts) for (i in 0..N) {
        @stage (ts, 0, i) { }
    } !>;
    return fin ? 0 : 1;
}

int main(void) {
    int fin;
    if (run(0, -1, &fin) != 0 || !fin) {
        fprintf(stderr, "FAIL seq complete\n");
        return 1;
    }
    if (run(1, -1, &fin) != 0 || !fin) {
        fprintf(stderr, "FAIL par complete\n");
        return 1;
    }
    if (run(0, 1, &fin) != 0 || fin) {
        fprintf(stderr, "FAIL seq break\n");
        return 1;
    }
    if (run(1, 1, &fin) != 0 || fin) {
        fprintf(stderr, "FAIL par break\n");
        return 1;
    }
    if (run_assign() != 0) {
        fprintf(stderr, "FAIL assign complete\n");
        return 1;
    }
    printf("parallel_wait_result_smoke: OK\n");
    return 0;
}

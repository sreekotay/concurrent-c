#include <ccc/std/prelude.cch>
#include <assert.h>
#include <stdio.h>
#include <unistd.h>

int main(void) {
    /* Literal path args at CCSlice params — no explicit to_slice / wrap. */
    assert(cc_path_exists("."));

    const char *path = "/tmp/cc_slice_literal_coerce_smoke";
    CCFile f = {0};
    f.create("/tmp/cc_slice_literal_coerce_smoke") !>(e) {
        fprintf(stderr, "create failed\n");
        return 1;
    };
    if (cc_is_err(f.write("ok\n"))) {
        f.close();
        return 1;
    }
    f.close();

    assert(cc_path_exists(path)); /* char* dest-cast → cc_slice_cstr */
    unlink(path);

    printf("slice_literal_coerce_smoke: PASS\n");
    return 0;
}

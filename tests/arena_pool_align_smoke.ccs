#include <ccc/std/prelude.cch>
#include <stdint.h>
#include <stdio.h>

/* Pool slots used to align to sizeof(void*) (4 on ILP32). ARM faults a
 * uint64_t / CCSlice.id load at 4-mod-8. Same layout as pigz_idiomatic. */
typedef struct {
    CCSlice data;
    unsigned long crc;
    size_t original_len;
} Slot;

static int check_slot(const char* tag, Slot* s, uint64_t want) {
    if (!s) {
        printf("FAIL: %s null\n", tag);
        return 1;
    }
    if (((uintptr_t)s % 8) != 0) {
        printf("FAIL: %s slot %p not 8-aligned\n", tag, (void*)s);
        return 1;
    }
    if (((uintptr_t)&s->data.id % 8) != 0) {
        printf("FAIL: %s id %p not 8-aligned\n", tag, (void*)&s->data.id);
        return 1;
    }
    s->data = cc_slice_from_parts((char*)s, sizeof(*s), want);
    s->crc = 1;
    s->original_len = 2;
    if (s->data.id != want || s->data.len != sizeof(*s)) {
        printf("FAIL: %s slice writeback\n", tag);
        return 1;
    }
    return 0;
}

int main(void) {
    cc_arena_pool_handle(p);
    Slot* a;
    Slot* b;
    Slot* loc;
    if (!p || cc_arena_pool(p, sizeof(Slot)) != 0) {
        printf("FAIL: pool create\n");
        return 1;
    }
    if (((uintptr_t)&p->freelist % 8) != 0) {
        printf("FAIL: pool freelist %p not 8-aligned\n", (void*)&p->freelist);
        cc_arena_pool_destroy(p);
        return 1;
    }

    a = (Slot*)cc_arena_pool_alloc(p);
    b = (Slot*)cc_arena_pool_alloc(p);
    if (check_slot("alloc-a", a, 0x0102030405060708ULL)) {
        cc_arena_pool_destroy(p);
        return 1;
    }
    if (check_slot("alloc-b", b, 0x1112131415161718ULL)) {
        cc_arena_pool_destroy(p);
        return 1;
    }
    cc_arena_pool_free(p, a);
    a = (Slot*)cc_arena_pool_alloc(p);
    if (check_slot("reuse", a, 0xA1A2A3A4A5A6A7A8ULL)) {
        cc_arena_pool_destroy(p);
        return 1;
    }

    loc = (Slot*)cc_arena_pool_alloc_local(p);
    if (check_slot("local", loc, 0xB1B2B3B4B5B6B7B8ULL)) {
        cc_arena_pool_destroy(p);
        return 1;
    }

    cc_arena_pool_destroy(p);
    printf("arena_pool_align_smoke ok\n");
    return 0;
}

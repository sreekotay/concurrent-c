/* `typedef struct tag Alias` — Type_meth stays Alias_meth after bind resolve. */
#include <ccc/std/prelude.cch>
#include <stdio.h>

typedef struct box_tag Box;

struct box_tag {
    int n;
};

static void Box_teardown(Box *q) {
    q->n = 0;
}

static int Box_add(Box *q, int x) {
    q->n += x;
    return q->n;
}

int main(void) {
    Box w;
    Box *q = &w;
    w.n = 1;
    if (q->add(2) != 3)
        return 1;
    q->teardown();
    if (w.n != 0)
        return 1;
    printf("ok\n");
    return 0;
}

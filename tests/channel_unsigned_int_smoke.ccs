/* `unsigned int[~N >]` is multi-token channel sugar (same path as long long). */
#include <ccc/cc_runtime.cch>

int main(void) {
    @errhandler(CCError e) cc_error_exit(e);
    unsigned int[~4 >] tx;
    unsigned int[~4 <] rx;
    CCChan* ch = cc_channel_pair(&tx, &rx) !> @destroy;
    CCNursery n = cc_nursery_create() !> @destroy;
    (void)n.close_on(tx);
    n.spawn(() => [tx] {
        @errhandler(CCError e) cc_error_exit(e);
        tx.send(9u) !>;
    });
    unsigned int v;
    rx.recv(&v) !>;
    return v == 9u ? 0 : 1;
}

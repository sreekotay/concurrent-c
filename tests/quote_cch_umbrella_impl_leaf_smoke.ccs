/* Quoted interface `.cch` that includes an impl-grade child: extract the
 * umbrella, splice only the leaf. */
#include <stdio.h>
#include "quote_cch_umbrella_impl_leaf.cch"

int main(void) {
    int u = umbrella_decl_only();
    int v = umbrella_impl_leaf_add(1, 1);
    if (u != 40 || v != 2) {
        printf("umbrella=%d leaf=%d\n", u, v);
        return 1;
    }
    printf("ok\n");
    return 0;
}

/* for (&ch in s) { ch = … } !>; — cursor write is the .access store. */
#include <ccc/std/prelude.cch>
#include <stdio.h>

int main(void) {
    @errhandler(CCError e) {
        fprintf(stderr, "fatal: %s\n", e.message);
        return 1;
    }

    char[:] s = {'a', 'b', 'c'};
    for (&ch in s) {
        if (ch >= 'a' && ch <= 'z')
            ch -= 32;
    } !>;
    if (s.len != 3) return 2;
    if (s.ptr[0] != 'A' || s.ptr[1] != 'B' || s.ptr[2] != 'C')
        return 3;

    int[:] ys = { 1, 2, 3 };
    for (i, &x in ys) {
        x = x + (int)i;
    } !>;
    if (((int *)ys.ptr)[0] != 1 || ((int *)ys.ptr)[1] != 3 ||
        ((int *)ys.ptr)[2] != 5)
        return 4;

    char[:] line = {'h', 'e', 'l', 'l', 'o'};
    for (&ch in line.sub(1, line.len)) {
        if (ch >= 'a' && ch <= 'z')
            ch -= 32;
    } !>;
    if (line.ptr[0] != 'h' || line.ptr[1] != 'E' ||
        line.ptr[2] != 'L' || line.ptr[3] != 'L' ||
        line.ptr[4] != 'O')
        return 5;

    printf("for_in_mut_slice_smoke: OK\n");
    return 0;
}

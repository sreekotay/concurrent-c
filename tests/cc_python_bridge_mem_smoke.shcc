/* Adversarial lifetime/memory suite for the cc-python bridge: handle
 * and domain churn with flat RSS, GC-driven sweeps, a finalizer storm
 * after close, the proxy graph pinning its domain, repeated zero-copy
 * leases, released-handle abuse at every door, cross-domain rejection
 * on the argument path, twenty interleaved domains with out-of-order
 * teardown, deep-chain intermediates, escaped closure after destroy,
 * and lease detach mid-lane.  The rungs live in
 * cc_python_bridge_mem.js (run under --expose-gc); the addon is
 * npm/cc-python/src/cc_python.ccs. */
CCArena a = cc_arena_heap(megabytes(1)) @destroy;

{
    CCCommand which = cc_command(&a, @slice("sh"));
    which.arg("-c");
    which.arg("command -v node >/dev/null 2>&1 && command -v python3 >/dev/null 2>&1");
    int rc = which.status() !>;
    if (rc != 0) { "SKIP (need node + python3)".println() !>; return 0; }
}

/* Own artifact name: the basic bridge smoke builds bin/cc_python.node,
 * and two suite jobs relinking one path race a concurrent require. */
{
    CCCommand build = cc_command(&a, @slice("./cc/bin/ccc"));
    build.arg("build");
    build.arg("npm/cc-python/src/cc_python.ccs");
    build.arg("-o");
    build.arg("bin/cc_python_mem.node");
    build.inherit_stdio();
    int rc = build.status() !>;
    if (rc != 0) { "build failed".println() !>; return 1; }
}

{
    CCCommand run = cc_command(&a, @slice("sh"));
    run.arg("-c");
    run.arg("CC_PYTHON_ADDON=$PWD/bin/cc_python_mem.node node --expose-gc tests/cc_python_bridge_mem.js");
    run.inherit_stdio();
    int rc = run.status() !>;
    if (rc != 0) { "mem suite failed".println() !>; return 1; }
}
return 0;

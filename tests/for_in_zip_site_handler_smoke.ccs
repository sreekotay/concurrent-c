/* Zip !>(e) is a site handler — unequal lens do not walk. */
#include <ccc/std/prelude.cch>
#include <stdio.h>

int main(void) {
    int[:] xs = { 1, 2 };
    int[:] ys = { 4, 5, 6 };
    int trips = 0;
    @for (a, b in xs, ys) {
        trips++;
        (void)a;
        (void)b;
    } !>(e) {
        if (e.kind != CC_ERR_INVALID_ARG) return 1;
        if (trips != 0) return 2;
        printf("ok\n");
        return 0;
    }
    return 3;
}

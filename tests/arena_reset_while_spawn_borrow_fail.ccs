/* Compile-fail: spawn capture pins arena epoch until nursery scope ends. */
#include <ccc/std/prelude.cch>
#include <string.h>

int main(void) {
    @errhandler(CCError e) {
        (void)e;
        return 1;
    }

    CCArena buf = cc_arena_heap(kilobytes(4)) !> @destroy;
    char[:] view = cc_arena_alloc_slice_bytes(&buf, 64);
    if (!view.ptr) return 1;
    memset(view.ptr, 'x', view.len);

    {
        CCNursery n = cc_nursery_create() !> @destroy;
        n.spawn(() => [view] {
            (void)view;
        }) !>;
        /* Original view may still be in outer scope; spawn pin also applies. */
        cc_arena_reset(&buf);
    }
    return 0;
}

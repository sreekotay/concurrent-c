#!ccc ccs
/* `?>` / `!>` inside UFCS arguments — the shape that used to leave `?>`
 * in the emit product (`port_history.push(parse_port("x") ?> 80)`). */
#include <ccc/std/prelude.cch>
#include <stdio.h>

int !>(CCError) parse_port(const char* s) {
    if (!s || s[0] == 'x')
        return cc_err(CC_ERR_INVALID_ARG, "bad port");
    return cc_ok(443);
}

int main(void) {
    @errhandler(CCError e) {
        (void)e;
        return 1;
    }
    CCArena arena = cc_arena_heap(kilobytes(4));
    if (!cc_arena_is_live(arena)) return 2;
    Vec::[int] ports = vec_new::[int](arena);
    Vec::[int]* ph = &ports;

    ports.push(parse_port("x") ?> 80);
    ports.push(parse_port("ok") ?> 80);
    ports.push(parse_port("ok") !>);
    ph->push(parse_port("x") ?> 7);

    int* a = ports.get(0);
    int* b = ports.get(1);
    int* c = ports.get(2);
    int* d = ports.get(3);
    if (!a || !b || !c || !d) return 3;
    size_t n = ports.len();
    printf("a=%d b=%d c=%d d=%d n=%zu\n", *a, *b, *c, *d, n);
    return 0;
}

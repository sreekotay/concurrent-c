/* Embedded NUL in a line must not truncate or glue the next line. */
#include <ccc/std/prelude.cch>
#include <stdio.h>
#include <string.h>
#include <unistd.h>
#include <stdlib.h>

int main(void) {
    @errhandler(CCIoError e) {
        fprintf(stderr, "open failed: %s\n", cc_io_error_str(e));
        abort();
    }
    char path[] = "/tmp/cc_read_line_nul_XXXXXX";
    int fd = mkstemp(path);
    if (fd < 0) abort();
    /* two lines: abc\0def\n  and  next\n */
    const unsigned char payload[] = {
        'a', 'b', 'c', 0, 'd', 'e', 'f', '\n',
        'n', 'e', 'x', 't', '\n'
    };
    if (write(fd, payload, sizeof(payload)) != (ssize_t)sizeof(payload)) abort();
    close(fd);

    CCFile f = cc_file_open(cc_slice_cstr(path)) !> @destroy;
    unlink(path);

    CCArena a = cc_arena_heap(kilobytes(4));
    @defer cc_arena_free(&a);

    CCSlice line = cc_slice_empty();
    bool !>(CCIoError) got = cc_file_read_line_into(&f, a, &line);
    if (cc_is_err(got) || !cc_value(got)) abort();
    if (line.len != 7) {
        fprintf(stderr, "line1 len=%zu want 7\n", line.len);
        return 1;
    }
    if (memcmp(line.ptr, payload, 7) != 0) {
        fprintf(stderr, "line1 bytes mismatch\n");
        return 1;
    }

    cc_arena_reset(a);
    got = cc_file_read_line_into(&f, a, &line);
    if (cc_is_err(got) || !cc_value(got)) abort();
    if (line.len != 4 || memcmp(line.ptr, "next", 4) != 0) {
        fprintf(stderr, "line2 corrupt (len=%zu)\n", line.len);
        return 1;
    }

    got = cc_file_read_line_into(&f, a, &line);
    if (cc_is_err(got) || cc_value(got)) {
        fprintf(stderr, "expected EOF\n");
        return 1;
    }

    printf("ok\n");
    return 0;
}

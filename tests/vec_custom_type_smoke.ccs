/* Smoke test for CCVec::[T] - verifies parser-safe generic container implementation. */
#include <ccc/std/prelude.cch>
#include <stdio.h>

int main(void) {
    CCArena arena = cc_arena_heap(kilobytes(4));
    
    /* Test CCVec::[int] - primitive type */
    CCVec::[int] nums = cc_vec_new::[int](arena);
    nums.push(42);
    nums.push(100);
    
    if (nums.len() != 2) {
        printf("FAIL: CCVec::[int] expected len 2, got %zu\n", nums.len());
        cc_arena_free(&arena);
        return 1;
    }
    
    int* first = nums.get(0);
    if (!first || *first != 42) {
        printf("FAIL: CCVec::[int].get(0) failed\n");
        cc_arena_free(&arena);
        return 1;
    }

    /* Pointer access: same API as get */
    int* ptr = nums.get(1);
    if (!ptr || *ptr != 100) {
        printf("FAIL: CCVec::[int].get(1) failed\n");
        cc_arena_free(&arena);
        return 1;
    }

    /* Pop writes last element via out-param. */
    int popped = 0;
    if (!nums.pop(&popped) || popped != 100) {
        printf("FAIL: CCVec::[int].pop() failed\n");
        cc_arena_free(&arena);
        return 1;
    }
    
    if (nums.len() != 1) {
        printf("FAIL: after pop expected len 1\n");
        cc_arena_free(&arena);
        return 1;
    }
    
    printf("OK: CCVec::[T] works\n");
    cc_arena_free(&arena);
    return 0;
}

/* Reset is legal once the borrow's enclosing block has ended. */
#include <ccc/std/prelude.cch>
#include <stdio.h>
#include <string.h>

int main(void) {
    CCArena buf = cc_arena_heap(kilobytes(4));
    {
        char* backing = cc_arena_alloc_T_count(char, &buf, 64);
        if (!backing) return 1;
        memset(backing, 'x', 64);
        char[:] view = cc_slice_from_parts(backing, 64, 0, 64);
        if (view.len != 64) return 2;
    }
    cc_arena_reset(&buf);
    char* again = cc_arena_alloc_T_count(char, &buf, 32);
    if (!again) return 3;
    cc_arena_free(&buf);
    printf("arena_reset_after_borrow_scope_smoke: ok\n");
    return 0;
}

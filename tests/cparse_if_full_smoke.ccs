/* C-only fields: ?: / bitwise / __has_* go through cparse. */
typedef struct CparseFullIf {
#if 1 ? 1 : 0
    int ternary_live;
#endif
#if (1 + 2) * 3 == 9 && (8 >> 2) == 2 && (3 & 1) == 1
    int arith_live;
#endif
#if defined(__has_feature) && __has_feature(thread_sanitizer)
    int tsan;
#else
    int no_tsan;
#endif
#if __has_builtin(__builtin_add_overflow)
    int has_addovf;
#endif
    int after;
} CparseFullIf;

int main(void) {
    CparseFullIf p;
    (void)p;
    return 0;
}

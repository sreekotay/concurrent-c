#include <ccc/std/prelude.cch>
#include <ccc/cc_instantiate.cch>
#include <ccc/cc_slice.cch>
#include <stdio.h>
#include <string.h>

typedef struct { int id; double weight; } Widget;

@comptime CCSlice reflect_emit_factory(CCSlice generic_name, CCSlice mangled,
                                        CCSliceArray type_args, CCArena* arena) {
    static char buf[4096];
    (void)generic_name;
    (void)arena;
    if (type_args.len < 1 || !mangled.ptr) return cc_slice_empty();

    char tname[128];
    int tl = (int)type_args.items[0].len;
    if (tl > 127) tl = 127;
    memcpy(tname, (char*)type_args.items[0].ptr, (size_t)tl);
    tname[tl] = '\0';

    int nf = cc_reflect_field_count(tname);
    if (nf < 0) nf = 0;

    CCSlice header = @emit(`
        typedef struct { int nfields; } ${mangled};
        static inline int ${mangled}_nfields(void) { return ${nf}; }
    `);

    size_t pos = 0;
    if (header.ptr && header.len < sizeof(buf)) {
        memcpy(buf, header.ptr, header.len);
        pos = header.len;
    }

    for (int i = 0; i < nf && pos + 256 < sizeof(buf); i++) {
        char fn[64], ft[64];
        cc_reflect_field_name(tname, i, fn, (int)sizeof(fn));
        cc_reflect_field_type(tname, i, ft, (int)sizeof(ft));
        CCSlice part = @emit(`
            static inline const char* ${mangled}_field${i}_name(void) { return "${fn}"; }
            static inline const char* ${mangled}_field${i}_type(void) { return "${ft}"; }
        `);
        if (part.ptr && pos + part.len < sizeof(buf)) {
            memcpy(buf + pos, part.ptr, part.len);
            pos += part.len;
        }
    }
    return cc_slice_from_parts(buf, pos, CC_SLICE_ID_UNTRACKED, sizeof(buf));
}

@comptime {
    cc_generic_register("ReflectEmit", reflect_emit_factory);
}

int main(void) {
    ReflectEmit::[Widget] d;
    d.nfields = ReflectEmit_Widget_nfields();
    if (d.nfields != 2) return 1;
    if (strcmp(ReflectEmit_Widget_field0_name(), "id") != 0) return 2;
    if (strcmp(ReflectEmit_Widget_field1_type(), "double") != 0) return 3;
    printf("comptime_reflect_emit_smoke ok nfields=%d\n", d.nfields);
    return 0;
}

#include <ccc/std/prelude.cch>
#include <ccc/cc_instantiate.cch>
#include <stdio.h>

/* recv.method(args) calls the function the receiver's TYPE names, and
 * DECLARING that function IS installing the method — for factory instances
 * too.  The member set derives from the emitted fragment's
 * `${mangled}_<member>` definitions, and a TU-declared
 * `<Mangled>_<member>` extension installs the same way. */

CC_GENERIC_FACTORY(Pair, 2) {
    return @emit(`
        typedef struct { ${arg(0)} first; ${arg(1)} second; } ${mangled};
        static inline ${mangled} ${mangled}_make(${arg(0)} a, ${arg(1)} b) {
            ${mangled} r; r.first = a; r.second = b; return r;
        }
        static inline ${arg(0)} ${mangled}_head(${mangled}* self) { return self->first; }
        static inline ${arg(1)} ${mangled}_tail(${mangled}* self) { return self->second; }`, arena);
}

/* Declared extension on one instance: installing by declaration. */
static double Pair_int_double_span(Pair::[int, double]* pr) {
    return pr->second - (double)pr->first;
}

int main(void) {
    Pair::[int, double] p = Pair_int_double_make(3, 4.5);
    Pair::[int, int]    q = Pair_int_int_make(10, 20);

    if (p.head() != 3) return 1;      /* factory-emitted member */
    if (p.tail() != 4.5) return 2;
    if (q.head() != 10) return 3;     /* second monomorph, same member set */
    if (q.tail() != 20) return 4;
    if (p.span() != 1.5) return 5;    /* declared extension */

    printf("user_generic_methods_smoke ok head=%d tail=%g span=%g q=%d,%d\n",
           p.head(), p.tail(), p.span(), q.head(), q.tail());
    return 0;
}

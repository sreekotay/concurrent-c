#include <ccc/std/prelude.cch>
#include <ccc/cc_instantiate.cch>
#include <ccc/cc_slice.cch>
#include <stdio.h>

/* D6.1: compiled generic factory — handler returns definition text via CCSlice. */

@comptime CCSlice pair_factory(CCSlice generic_name, CCSlice mangled,
                               CCSliceArray type_args, CCArena *arena) {
    static char buf[4096];
    (void)generic_name;
    (void)arena;
    if (type_args.len < 2 || !mangled.ptr) return cc_slice_empty();
    int n = snprintf(buf, sizeof(buf),
        "typedef struct { %.*s first; %.*s second; } %.*s;\n"
        "static inline %.*s %.*s_make(%.*s a, %.*s b) { %.*s r; r.first=a; r.second=b; return r; }\n",
        (int)type_args.items[0].len, (char*)type_args.items[0].ptr,
        (int)type_args.items[1].len, (char*)type_args.items[1].ptr,
        (int)mangled.len, (char*)mangled.ptr,
        (int)mangled.len, (char*)mangled.ptr,
        (int)mangled.len, (char*)mangled.ptr,
        (int)type_args.items[0].len, (char*)type_args.items[0].ptr,
        (int)type_args.items[1].len, (char*)type_args.items[1].ptr,
        (int)mangled.len, (char*)mangled.ptr);
    if (n <= 0) return cc_slice_empty();
    return cc_slice_from_parts(buf, (size_t)n, CC_SLICE_ID_UNTRACKED, sizeof(buf));
}

@comptime {
    cc_generic_register("Pair", pair_factory);
}

int main(void) {
    Pair::[int, double] p = Pair_int_double_make(3, 2.5);
    Pair::[int, int]    q = Pair_int_int_make(10, 20);

    if (p.first != 3) return 1;
    if (q.second != 20) return 2;

    printf("comptime_compiled_generic_factory_smoke ok p=%d,%g q=%d,%d\n",
           p.first, p.second, q.first, q.second);
    return 0;
}

/*
 * Stacked @errhandler: dispatch by Result error type E, not nearest.
 *   always_err_io  → CCIoError handler (inner)
 *   always_err_cc  → CCError handler (outer), skipping the IoError handler
 */
#include <stdio.h>
#include <ccc/std/io.h>

static int g_cc;
static int g_io;

static int !> (CCError) always_err_cc(void) {
    return cc_err(CC_ERR_NOT_FOUND, "cc");
}

static int !> (CCIoError) always_err_io(void) {
    return cc_err(cc_io_error(CC_IO_OTHER));
}

int main(void) {
    @errhandler(CCError e) {
        (void)e;
        g_cc = 1;
    }
    @errhandler(CCIoError e) {
        (void)e;
        g_io = 1;
    }

    always_err_io() !>;
    always_err_cc() !>;

    printf("g_cc=%d g_io=%d\n", g_cc, g_io);
    return (g_cc == 1 && g_io == 1) ? 0 : 1;
}

#!/usr/bin/env -S ./cc/bin/ccc
/*
 * Flipped print DX: slice/string/cstr/literal.println().
 * Prefer UFCS on the data; cc_println/cc_eprintln are lowered-C only.
 */

CCArena arena = @create(kilobytes(4)) @destroy;

CCSlice hi = @slice("hello");
hi.println();

CCString world = @string(`world`, arena);
world.println();

"plain".println();
@string(`tpl=${42}`, arena).println();

"err-line".eprintln();
hi.fprintln(STDERR_FILENO);

return 0;

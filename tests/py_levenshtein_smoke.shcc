/* Builds the DP-only smoke module (levenshtein_cc_smoke.ccs), not the full
 * bit-parallel specimen — keeps ILP32/QEMU under arena sane wall clock.  Checks
 * distance/ratio/hamming/jaro/jaro_winkler on fixed pairs (codepoints, not
 * bytes).  Full parity stays in real_projects/levenshtein/parity.py. */
CCArena arena = cc_arena_heap(megabytes(1)) @destroy;

{
    CCCommand which = cc_command(arena, @slice("sh"));
    which.arg("-c");
    which.arg("command -v python3 >/dev/null 2>&1");
    int rc = which.status() !>;
    if (rc != 0) { "SKIP (no python3)".println(); return 0; }
}

{
    CCCommand build = cc_command(arena, @slice("./cc/bin/ccc"));
    build.arg("build");
    build.arg("real_projects/levenshtein/levenshtein_cc_smoke.ccs");
    build.inherit_stdio();
    int rc = build.status() !>;
    if (rc != 0) { "build failed".println(); return 1; }
}

{
    CCCommand run = cc_command(arena, @slice("sh"));
    run.arg("-c");
    CCString py = @string(`PYTHONPATH=bin python3 -c "
import cclev
print('distance', cclev.distance('kitten', 'sitting'), cclev.distance('héllo', 'hello'), cclev.distance('\U0001d54atring', 'string'))
print('ratio', round(cclev.ratio('kitten', 'sitting'), 6), cclev.ratio('', ''))
print('hamming_jaro', cclev.hamming('abc', 'abcd'), round(cclev.jaro('martha', 'marhta'), 6))
print('jw', round(cclev.jaro_winkler('dixon', 'dicksonx'), 6), cclev.jaro_winkler('bbbbbb', 'baa') == cclev.jaro('bbbbbb', 'baa'))
"`, arena);
    run.arg(py.cstr(arena));
    run.inherit_stdio();
    int rc = run.status() !>;
    if (rc != 0) { "import failed".println(); return 1; }
}
return 0;

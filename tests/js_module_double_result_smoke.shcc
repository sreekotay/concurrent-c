/* The wider marshal gamut through one staged addon: arena double method and arena
 * `double !>(CCError)` method (the predeclared-Result collision the
 * Python twin pins), arena string return, BigInt out at 2^60 and arena BigInt
 * argument, arity and unexpected-keyword and wrong-type reports, both
 * fallible shapes, and the keyword-bag / js_pos escape for arena trailing
 * CCJsVal.  The module is js_module_double_result_mod.ccs; the node
 * driver is js_module_double_result_run.js. */
CCArena arena = cc_arena_heap(megabytes(1)) @destroy;

{
    CCCommand which = cc_command(arena, @slice("sh"));
    which.arg("-c");
    which.arg("command -v node >/dev/null 2>&1");
    int rc = which.status() !>;
    if (rc != 0) { "SKIP (no node)".println(); return 0; }
}

/* No staging: `js_module::[Counter]` names the artifact, so building the
 * fixture where it lives produces bin/gamut_counter.node. */
{
    CCCommand build = cc_command(arena, @slice("./cc/bin/ccc"));
    build.arg("build");
    build.arg("tests/js_module_double_result_mod.ccs");
    build.inherit_stdio();
    int rc = build.status() !>;
    if (rc != 0) { "build failed".println(); return 1; }
}

{
    CCCommand run = cc_command(arena, @slice("node"));
    run.arg("tests/js_module_double_result_run.js");
    run.inherit_stdio();
    int rc = run.status() !>;
    if (rc != 0) { "import failed".println(); return 1; }
}
return 0;

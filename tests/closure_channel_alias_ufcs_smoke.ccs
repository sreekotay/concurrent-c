#include <ccc/std/prelude.cch>
#include <assert.h>
#include <stdio.h>

int main(void) {
    @errhandler(CCError e) cc_error_exit(e);
    int[~8 >] tx_h;
    int[~8 <] rx_h;
    CCChan* ch = cc_channel_pair(&tx_h, &rx_h);
    CCChanTx tx = tx_h;
    CCChanRx rx = rx_h;
    int got = 0;

    assert(ch != NULL);

    {
        CCNursery __cc_nursery38 = @create() !> @destroy;
        (void)__cc_nursery38.close_on(tx_h);

        /* UFCS on typedef aliases inside a spawn; result comes back on a
         * second channel (no T* alias smuggle into the nursery). */
        int[~1 >] ans_tx;
        int[~1 <] ans_rx;
        CCChan* ans = cc_channel_pair(&ans_tx, &ans_rx);
        assert(ans != NULL);
        @defer ans.free();

        __cc_nursery38.spawn(() => [tx] {
            tx.send(1);
        }) !>;
        __cc_nursery38.spawn(() => [rx, ans_tx] {
            int v = 0;
            rx.recv(&v);
            ans_tx.send(v);
        }) !>;
        ans_rx.recv(&got);
    }

    assert(got == 1);
    ch.free();

    printf("closure_channel_alias_ufcs_smoke: PASS\n");
    return 0;
}

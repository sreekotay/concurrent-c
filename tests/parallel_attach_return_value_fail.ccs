/* A valued return in a dest body is ill-formed: the body is a fiber,
 * `return;` ends it, and there is no frame to hand a value to. */
#include <ccc/std/prelude.cch>

int main(void) {
    @errhandler(CCError e) { cc_error_log(e); return 1; }
    CCParallel h = @parallel spawn { @serial { (void)0; } } !>;
    int x = 2;
    @parallel(h) {
        if (x == 2)
            return 1;
    }
    h.wait() !>;
    return 0;
}

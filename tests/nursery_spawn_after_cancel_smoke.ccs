/*
 * Cancel stops admit. n.spawn after n.cancel() is CC_ERR_CANCELLED,
 * not a queued child whose body is skipped.
 */
#include <ccc/std/prelude.cch>
#include <stdio.h>

static int g_ran = 0;

int main(void) {
    @errhandler(CCError e) { cc_error_log(e); return 1; }

    CCNursery n = cc_nursery_create() !>;
    n.cancel();

    int saw = 0;
    n.spawn(() => { g_ran = 1; }) !>(e) {
        if (e.kind != CC_ERR_CANCELLED) {
            cc_error_log(e);
            n.free();
            return 1;
        }
        saw = 1;
    };
    n.wait() !>;
    n.free();

    if (!saw || g_ran) {
        fprintf(stderr, "FAIL spawn-after-cancel saw=%d ran=%d\n", saw, g_ran);
        return 1;
    }
    printf("nursery_spawn_after_cancel_smoke: OK\n");
    return 0;
}

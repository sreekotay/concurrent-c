/* Stage-2, the asyncio lane: coroutine results become loop tasks that
 * interleave (readiness order, not FIFO); `await cb(x)` suspends only
 * its task while the loop keeps running siblings; a callback's promise
 * may lean on tasks of the same domain; exceptions keep "Type: message"
 * both directions and across double/triple crossings; sync task shapes
 * (including stage-1 blocking suspension) survive loop mode; and
 * revocation cancels pending tasks articulately.  Rungs live in
 * cc_python_bridge_aio.js; the addon is npm/cc-python/src/cc_python.ccs
 * (own artifact name — sibling bridge smokes relink their own). */
CCArena a = cc_arena_heap(megabytes(1)) @destroy;

{
    CCCommand which = cc_command(&a, @slice("sh"));
    which.arg("-c");
    which.arg("command -v node >/dev/null 2>&1 && command -v python3 >/dev/null 2>&1");
    int rc = which.status() !>;
    if (rc != 0) { "SKIP (need node + python3)".println() !>; return 0; }
}

{
    CCCommand build = cc_command(&a, @slice("./cc/bin/ccc"));
    build.arg("build");
    build.arg("npm/cc-python/src/cc_python.ccs");
    build.arg("-o");
    build.arg("bin/cc_python_aio.node");
    build.inherit_stdio();
    int rc = build.status() !>;
    if (rc != 0) { "build failed".println() !>; return 1; }
}

{
    CCCommand run = cc_command(&a, @slice("sh"));
    run.arg("-c");
    run.arg("CC_PYTHON_ADDON=$PWD/bin/cc_python_aio.node node tests/cc_python_bridge_aio.js");
    run.inherit_stdio();
    int rc = run.status() !>;
    if (rc != 0) { "aio suite failed".println() !>; return 1; }
}
return 0;

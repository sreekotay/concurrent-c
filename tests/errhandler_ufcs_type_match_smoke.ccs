/*
 * Stacked @errhandler + UFCS Form-P unwrap (`T x = recv.meth() !>;`).
 * Must dispatch by Result E — not the innermost handler (regression:
 * try_assign / bang-chain skipped shadow_eh_for_call and bound CCPyError
 * onto a CCJsError / CCIoError Result).
 */
#include <stdio.h>
#include <ccc/std/io.h>

static int g_cc;
static int g_io;

typedef struct EhFace {
    int unused;
} EhFace;

static int !> (CCError) EhFace_cc(EhFace *self) {
    (void)self;
    return cc_err(CC_ERR_NOT_FOUND, "cc");
}

static int !> (CCIoError) EhFace_io(EhFace *self) {
    (void)self;
    return cc_err(cc_io_error(CC_IO_OTHER));
}

int main(void) {
    @errhandler(CCError e) {
        (void)e;
        g_cc = 1;
    }
    @errhandler(CCIoError e) {
        (void)e;
        g_io = 1;
    }

    EhFace f = {0};
    /* Expression-position UFCS bang — historically took innermost only. */
    int a = f.io() !>;
    int b = f.cc() !>;
    (void)a;
    (void)b;

    printf("g_cc=%d g_io=%d\n", g_cc, g_io);
    return (g_cc == 1 && g_io == 1) ? 0 : 1;
}

/* Declared map-key convention: a key type K is installed by declaring
 * cc_map_key_hash_<mangled K> (size_t, by value) and
 * cc_map_key_eq_<mangled K> (int, K, K) — no compiler or family-header
 * change. Forward prototypes are emitted above the spliced container
 * decl with the definition's own linkage. */
#include <ccc/std/prelude.cch>
#include <stdio.h>
typedef struct GridPos { int x, y; } GridPos;
static size_t cc_map_key_hash_GridPos(GridPos k) {
    /* Pack via uint64_t — size_t<<32 warns/overflows on ILP32. */
    uint64_t h = ((uint64_t)(uint32_t)k.x << 32) | (uint32_t)k.y;
    return (size_t)(h ^ (h >> 32));
}
static int cc_map_key_eq_GridPos(GridPos a1, GridPos b1) {
    return a1.x == b1.x && a1.y == b1.y;
}
/* Instance extension by declaration works for map instances too. */
static int ArrayMap_GridPos_int_span(ArrayMap_GridPos_int *m1) {
    (void)m1;
    return 42;
}
int main(void) {
    CCArena arena = cc_arena_heap(kilobytes(64));
    ArrayMap::[GridPos, int] m;
    GridPos p = {3, 4};
    GridPos q = {5, 6};
    int *vp;
    if (!cc_arena_is_live(arena)) return 1;
    m = array_map_new::[GridPos, int](arena);
    if (!m) return 2;
    if (m->insert(p, 7) != 0) return 3;
    if (m->insert(q, 9) != 0) return 4;
    vp = m->get_ptr(p);
    if (!vp || *vp != 7) return 5;
    vp = m->get_ptr(q);
    if (!vp || *vp != 9) return 6;
    if (m->span() != 42) return 7;
    printf("ok\n");
    return 0;
}

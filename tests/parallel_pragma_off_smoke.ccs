/*
 * #pragma(@parallel) off|on — static scheduling toggle.
 * Under off every @parallel construct is inert: arms and iterations run
 * in source order on the caller frame, seq predicates are not evaluated,
 * wait-for is a plain loop (worker binds 0; stage calls degrade against
 * the never-entered turnstile). `on` restores the parallel lowering.
 * The file-scope pragma below covers the TU marker; the one inside main
 * covers the statement-position marker.
 */
#include <ccc/std/prelude.cch>
#include <stdio.h>

#define N 16

static int g_pred_evals;

static int pred_true(void) {
    g_pred_evals++;
    return 1;
}

#pragma(@parallel) off

int main(void) {
    @errhandler(CCError e) { cc_error_log(e); return 1; }

    /* Join arms in order: b reads the a the first arm just wrote. */
    int a = 0;
    int b = 0;
    @parallel seq (pred_true()) {
        a = 41;
        b = a + 1;
    } !>.wait()!>;
    if (a != 41 || b != 42) {
        fprintf(stderr, "FAIL join a=%d b=%d\n", a, b);
        return 1;
    }
    if (g_pred_evals != 0) {
        fprintf(stderr, "FAIL seq predicate evaluated under off\n");
        return 1;
    }

    /* Bare walk form: strict source order, caller frame. */
    int i;
    int last = -1;
    int sum = 0;
    int order_ok = 1;
    @parallel for (i in 0..N) {
        if (i != last + 1)
            order_ok = 0;
        last = i;
        sum += i;
    } !>.wait()!>;
    if (!order_ok || sum != N * (N - 1) / 2) {
        fprintf(stderr, "FAIL for order_ok=%d sum=%d\n", order_ok, sum);
        return 1;
    }

    /* wait-for: plain loop; worker binds 0; stages degrade to no-ops. */
    CCArena arena = cc_arena_heap(kilobytes(64)) @destroy;
    CCTurnstile ts@(4, 1, arena) @destroy;
    if (!cc_exclusive_is_live(ts.excl))
        return 1;
    int hits = 0;
    int wsum = 0;
    last = -1;
    order_ok = 1;
    @parallel wait (ts) for (i in 0..N) worker (w) {
        wsum += w;
        if (i != last + 1)
            order_ok = 0;
        last = i;
        @stage (ts, 0, i) {
            hits++;
        }
    } !>.wait()!>;
    if (!order_ok || wsum != 0 || hits != N) {
        fprintf(stderr, "FAIL wait order_ok=%d wsum=%d hits=%d\n", order_ok,
                wsum, hits);
        return 1;
    }

#pragma(@parallel) on

    /* Restored: the parallel lowering is back. */
    int x = 0;
    int y = 0;
    @parallel {
        x = 1;
        y = 2;
    } !>.wait()!>;
    if (x != 1 || y != 2) {
        fprintf(stderr, "FAIL restored join x=%d y=%d\n", x, y);
        return 1;
    }

    printf("parallel_pragma_off_smoke: OK\n");
    return 0;
}

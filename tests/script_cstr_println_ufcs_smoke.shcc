#!/usr/bin/env -S ./cc/bin/ccc
/*
 * UFCS println/eprintln on string literals and char* / const char*.
 * Model: coerce to CCSlice, then cc_slice_println (not arena cc_char_* family).
 */

CCArena arena = @create(kilobytes(4)) @destroy;

"literal".println();

const char *p = "cstr";
p->println();
p.println();

char *mut = (char *)"mut";
mut->println();

@string(`tpl=${1}`, arena).println();

"err".eprintln();

return 0;

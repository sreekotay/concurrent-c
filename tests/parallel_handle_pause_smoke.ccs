/*
 * pause / resume on a live dest (before wait). h.paused / h.paused()
 * observe the flag.
 */
#include <ccc/std/prelude.cch>
#include <stdio.h>

int main(void) {
    @errhandler(CCError e) { cc_error_log(e); return 1; }
    int a = 0;
    int b = 0;
    CCParallel h = @parallel {
        a = 1;
        b = 2;
    } !>;
    if (!h.live()) {
        fprintf(stderr, "FAIL dest not live\n");
        return 1;
    }
    if (h.paused || h.paused()) {
        fprintf(stderr, "FAIL start paused\n");
        return 1;
    }
    if (!(h.pause() !>) || !h.paused() || !h.paused) {
        fprintf(stderr, "FAIL pause\n");
        return 1;
    }
    if (h.pause() !>) {
        fprintf(stderr, "FAIL pause twice\n");
        return 1;
    }
    if (!(h.resume() !>) || h.paused() || h.paused) {
        fprintf(stderr, "FAIL resume before wait\n");
        return 1;
    }
    if (h.resume() !>) {
        fprintf(stderr, "FAIL resume twice\n");
        return 1;
    }
    h.wait() !>;
    if (h.live()) {
        fprintf(stderr, "FAIL live after wait\n");
        return 1;
    }
    if (h.pause() !> || h.resume() !>) {
        fprintf(stderr, "FAIL pause/resume after wait\n");
        return 1;
    }
    if (a + b != 3) {
        fprintf(stderr, "FAIL join a=%d b=%d\n", a, b);
        return 1;
    }
    printf("parallel_handle_pause_smoke: OK\n");
    return 0;
}

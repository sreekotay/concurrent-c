/* Dual-target export directives: one build produces
 * bin/dual_gauge.abi3.so AND bin/dual_gauge.node as hardlinks of one
 * shared object; Python and Node each import their name and see the
 * same module.  `--module=js` narrows to one artifact; an unknown tag
 * reports the targets the TU spells.  The module is
 * dual_module_export_mod.ccs. */
CCArena a = cc_arena_heap(megabytes(1)) @destroy;

{
    CCCommand which = cc_command(&a, @slice("sh"));
    which.arg("-c");
    which.arg("command -v node >/dev/null 2>&1 && command -v python3 >/dev/null 2>&1");
    int rc = which.status() !>;
    if (rc != 0) { "SKIP (need node + python3)".println() !>; return 0; }
}

{
    CCCommand clean = cc_command(&a, @slice("sh"));
    clean.arg("-c");
    clean.arg("rm -f bin/dual_gauge.abi3.so bin/dual_gauge.node");
    int rc = clean.status() !>;
    if (rc != 0) { "clean failed".println() !>; return 1; }
}

{
    CCCommand build = cc_command(&a, @slice("./cc/bin/ccc"));
    build.arg("build");
    build.arg("tests/dual_module_export_mod.ccs");
    build.inherit_stdio();
    int rc = build.status() !>;
    if (rc != 0) { "build failed".println() !>; return 1; }
}

{
    CCCommand run = cc_command(&a, @slice("sh"));
    run.arg("-c");
    CCString sh = @string(`
    set -e
    # ls -i is portable (GNU/BSD); `stat -c` is GNU-only.
    a=$(ls -i bin/dual_gauge.abi3.so | awk '{print $1}')
    b=$(ls -i bin/dual_gauge.node | awk '{print $1}')
    if [ "$a" = "$b" ]; then echo "hardlinked true"; else echo "hardlinked false"; fi
    PYTHONPATH=bin python3 -c "import dual_gauge; print('py', dual_gauge.bump(3))"
    node -e "console.log('js', require(process.cwd() + '/bin/dual_gauge.node').bump(5))"
    rm -f bin/dual_gauge.abi3.so bin/dual_gauge.node
    ./cc/bin/ccc build tests/dual_module_export_mod.ccs --module=js >/dev/null 2>&1
    if [ -f bin/dual_gauge.node ] && [ ! -f bin/dual_gauge.abi3.so ]; then
        echo "narrowed js-only"
    else
        echo "narrowing failed"
    fi
    ./cc/bin/ccc build tests/dual_module_export_mod.ccs --module=rb 2>&1 | grep -o "no such entry (targets: py js)"
    `, &a);
    run.arg(sh.cstr(&a));
    run.inherit_stdio();
    int rc = run.status() !>;
    if (rc != 0) { "dual checks failed".println() !>; return 1; }
}
return 0;

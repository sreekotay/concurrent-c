/* Isolated domains: a full CPython child per domain over the mirrored
 * cc-node wire — numpy in every domain (no subinterpreter refusal),
 * two pythons computing in parallel (relative timing), lazy zero-trip
 * attribute chains, async JS callbacks over the wire, per-domain venv
 * selection, crash isolation (child _exit rejects promises, parent
 * survives), handle hygiene, and articulate revocation.  Rungs live in
 * cc_python_bridge_proc.js; the child side is npm/cc-python/broker.py
 * (stdlib-only).  No addon build — this tier is pure wire. */
CCArena a = cc_arena_heap(megabytes(1)) @destroy;

{
    CCCommand which = cc_command(&a, @slice("sh"));
    which.arg("-c");
    which.arg("command -v node >/dev/null 2>&1 && command -v python3 >/dev/null 2>&1");
    int rc = which.status() !>;
    if (rc != 0) { "SKIP (need node + python3)".println() !>; return 0; }
}

{
    CCCommand run = cc_command(&a, @slice("sh"));
    run.arg("-c");
    run.arg("node tests/cc_python_bridge_proc.js");
    run.inherit_stdio();
    int rc = run.status() !>;
    if (rc != 0) { "proc suite failed".println() !>; return 1; }
}
return 0;

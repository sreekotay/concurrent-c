/* `case .arm(bind):` — dominated payload binding without local-copy ritual. */
#include <ccc/std/prelude.cch>
#include <stdio.h>

typedef struct {
    char[:] bytes;
} Buf;

@variant Del {
    text: Buf;
    pieces: int;
};

typedef struct {
    Del del;
} Rec;

static void !>(CCError) commit_field(Rec* r, char[:] src) {
    @errhandler(CCError e) { return cc_err(e); }
    @switch (r->del) {
        case .text(buf):
            buf.bytes.copy(src) !>;
            r->del = { .text = { .bytes = buf.bytes } };
            return cc_ok();
        case .pieces:
            return cc_err(CC_ERR_INTERNAL, "pieces");
    }
    return cc_err(CC_ERR_INTERNAL, "closed");
}

static int hold_is_text(Rec r) {
    @switch (r.del) {
        case .text(buf):
            return buf.bytes.len > 0;
        case .pieces:
            return 0;
    }
    return 0;
}

int main(void) {
    char buf[8];
    Rec r;
    Rec *p;
    buf[0] = 'a';
    buf[1] = 'b';
    r.del = { .text = { .bytes = cc_slice_from_buffer(buf, 2) } };
    if (!hold_is_text(r)) return 1;
    p = &r;
    commit_field(p, cc_slice_from_buffer(buf, 2)) !> { return 2; };
    {
        Del d = p->del;
        if (d.kind == .text) {
            if (d.text.bytes.len != 2 || d.text.bytes.ptr[0] != 'a') return 3;
        } else {
            return 4;
        }
    }
    printf("ok\n");
    return 0;
}

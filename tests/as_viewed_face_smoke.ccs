/* as: (Region)field — UFCS retries on the arena through Region. */
#include <ccc/std/prelude.cch>
#include <stdio.h>

typedef struct {
    CCArena arena;
} Box;

@typeview on Box {
    as: (Region)arena;
};

int main(void) {
    Box b;
    void* p;
    CCArena child;
    CCArena tmp = cc_arena_heap(256) @destroy;
    b.arena = tmp.detach() !>;
    p = b.alloc(16, 8);
    if (!p) {
        printf("fail alloc\n");
        return 1;
    }
    child = b.create_arena(64) !>;
    if (!cc_arena_is_live(child)) {
        printf("fail create_arena\n");
        return 1;
    }
    printf("ok\n");
    return 0;
}

/* A bare `!>` in a `@serial` arm of a dest-bound construct is ill-formed:
 * the arm is a fiber of the dest and runs after the frame has moved on, so
 * the frame's @errhandler is not where its error can go. */
#include <ccc/std/prelude.cch>

static int !>(CCError) step(int x) {
    if (x == 2)
        return cc_err(CC_ERROR(CC_ERR_IO, "boom"));
    return cc_ok(x);
}

int main(void) {
    @errhandler(CCError e) { cc_error_log(e); return 1; }
    int a = 0;
    int b = 0;
    CCParallel h = @parallel {
        @serial { a = step(1) !>; }
        @serial { b = step(2) !>; }
    } !>;
    h.wait() !>;
    return a + b;
}

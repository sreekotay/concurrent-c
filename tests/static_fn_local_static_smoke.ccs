/* Local `static` / `unsigned char *` / bang-in-init inside a static fn
 * (raytext gui_draw_hex_buf). */
#include <ccc/std/prelude.cch>
#include <stdio.h>

static int !>(CCError) hex_sel(size_t at) {
    (void)at;
    return cc_ok(1);
}

static void hex_shape(size_t n, int has) {
    size_t k;
    static const char *hexd = "0123456789ABCDEF";
    unsigned char win[16];
    unsigned char *row;
    @errhandler(CCError e) {
        (void)e;
        return;
    }
    row = win;
    win[0] = 0xAB;
    for (k = 0; k < 2; k++) {
        char hex2[4];
        int sel = has && k < n && (hex_sel(k) !>);
        const char *chs;
        if (sel) {
            hex2[0] = hexd[(row[k] >> 4) & 0xF];
            hex2[1] = hexd[row[k] & 0xF];
        } else {
            hex2[0] = ' ';
            hex2[1] = ' ';
        }
        hex2[2] = 0;
        chs = hex2;
        (void)chs;
    }
}

int main(void) {
    hex_shape(1, 1);
    printf("ok\n");
    return 0;
}

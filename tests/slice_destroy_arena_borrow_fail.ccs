/* Fail: cannot cc_slice_destroy a non-unique arena slice view. */
#include <ccc/std/prelude.cch>
#include <string.h>

int main(void) {
    CCArena a = cc_arena_heap(kilobytes(4));
    char[:] view = cc_arena_alloc_slice_bytes(a, 32);
    if (!view.ptr) return 1;
    memset(view.ptr, 'a', view.len);

    cc_slice_destroy(&view); /* ERROR */

    cc_arena_free(&a);
    return 0;
}

/* Zip `&` binders store through each subject's access peel. */
#include <ccc/std/prelude.cch>
#include <stdio.h>

int main(void) {
    @errhandler(CCError e) {
        fprintf(stderr, "fatal: %s\n", e.message);
        return 1;
    }

    int[:] xs = { 1, 2, 3 };
    int[:] ys = { 10, 20, 30 };

    for (&a, b in xs, ys) {
        a = a + b;
    } !>;
    if (((int *)xs.ptr)[0] != 11 || ((int *)xs.ptr)[1] != 22 ||
        ((int *)xs.ptr)[2] != 33)
        return 2;
    if (((int *)ys.ptr)[0] != 10 || ((int *)ys.ptr)[1] != 20 ||
        ((int *)ys.ptr)[2] != 30)
        return 3;

    for (a, &b in xs, ys) {
        b = b + 1;
    } !>;
    if (((int *)ys.ptr)[0] != 11 || ((int *)ys.ptr)[1] != 21 ||
        ((int *)ys.ptr)[2] != 31)
        return 4;

    printf("for_in_zip_mut_smoke: OK\n");
    return 0;
}

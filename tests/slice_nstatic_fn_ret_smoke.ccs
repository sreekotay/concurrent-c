/* Non-static char[:] / T[:] return types must lower (not "cannot lower"). */
#include <ccc/std/prelude.cch>
#include <stdio.h>

char[:] mk_bytes(void) {
    return cc_slice_from_buffer("hi", 2);
}

int main(void) {
    char[:] s = mk_bytes();
    if (s.len != 2) return 1;
    if (s.ptr[0] != 'h' || s.ptr[1] != 'i') return 2;
    printf("ok\n");
    return 0;
}

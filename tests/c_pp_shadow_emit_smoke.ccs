/* Shadow path: same 2-stage front → .c (from .ccs) or .h (from .cch).
 * Host cc / TCC consume the product (intentional extra parse). */
#include <ccc/std/prelude.cch>

@grammar(rules) PpTok {~~~~
    include "../cc/shadow/pp_tok.rules"
~~~~}

@grammar(rules) PpStmt {~~~~
    include "../cc/shadow/pp_stmt.rules"
~~~~}

#include "../cc/shadow/c_pp_spike.cch"
#include "../cc/shadow/shadow_comptime.h"
#include <fcntl.h>
#include <unistd.h>

static const char* FIX = "cc/shadow/shadow";

static void pp_free_macros(Pp* pp) {
    for (int i = 0; i < pp->nmacros; i++) free(pp->macros[i].body);
    pp->nmacros = 0;
}

static char* read_all(const char* path, size_t* out_n) {
    FILE* f = fopen(path, "rb");
    if (!f) return NULL;
    fseek(f, 0, SEEK_END);
    long n = ftell(f);
    fseek(f, 0, SEEK_SET);
    char* b = (char*)malloc((size_t)n + 1);
    if (!b) { fclose(f); return NULL; }
    size_t rd = fread(b, 1, (size_t)n, f);
    fclose(f);
    b[rd] = 0;
    if (out_n) *out_n = rd;
    return b;
}

static int norm_eq(const char* a, size_t alen, const char* b, size_t blen) {
    while (alen && (a[alen - 1] == '\n' || a[alen - 1] == '\r')) alen--;
    while (blen && (b[blen - 1] == '\n' || b[blen - 1] == '\r')) blen--;
    return alen == blen && memcmp(a, b, alen) == 0;
}

/* Same succession path as native shadow_lower: comptime prepare/exec →
 * stage1 bytes → stage2 → parse → safety → emit → comptime splice. */
static int lower_file(TapeCache* cache, CCArena* arena, const char* name,
                      ShadowEmitKind kind, CEmit* out) {
    char path[512];
    char* stage1_src = NULL;
    size_t stage1_len = 0;
    FileTape* ft;
    Token tokbuf[1 << 16];
    Pp pp = {0};
    Parser p = {0};
    AstNode** items = NULL;
    int n = 0;
    int ok;
    snprintf(path, sizeof(path), "%s/%s", FIX, name);
    if (shadow_comptime_exec_file(path, &stage1_src, &stage1_len) != 0) {
        free(stage1_src);
        fprintf(stderr, "%s:1:1: error: comptime prepare/exec failed\n", path);
        return 0;
    }
    ft = tape_cache_load_bytes(cache, path, stage1_src, stage1_len, arena);
    stage1_src = NULL;
    if (!ft) {
        fprintf(stderr, "error: cannot stage1-load %s\n", path);
        return 0;
    }
    pp.cache = cache;
    pp.arena = arena;
    pp.search_dir = FIX;
    pp_add_sys_inc(&pp, "cc/include");
    pp_add_sys_inc(&pp, "out/include");
    pp.out = tokbuf;
    pp.out_cap = 1 << 16;
    if (!pp_run(&pp, ft)) {
        if (!pp.err_msg[0])
            fprintf(stderr, "%s:1:1: error: stage2 preprocess failed\n", path);
        pp_free_macros(&pp);
        return 0;
    }
    p.toks = tokbuf;
    p.n = pp.nout;
    p.cache = cache;
    if (!parse_tu(&p, &items, &n)) {
        if (!p.err_msg[0])
            fprintf(stderr, "%s:1:1: error: parse failed\n", path);
        pp_free_macros(&pp);
        return 0;
    }
    if (!shadow_safety_check(items, n, cache)) {
        pp_free_macros(&pp);
        return 0;
    }
    ok = shadow_emit(items, n, cache, out, kind, pp.pass_inc, pp.npass_inc,
                     pp.pass_def, pp.npass_def, path);
    if (ok && shadow_comptime_splice_emit(&out->buf, &out->len, path) != 0) {
        fprintf(stderr, "%s:1:1: error: comptime splice failed\n", path);
        ok = 0;
    }
    pp_free_macros(&pp);
    return ok;
}

static int expect_golden(const char* src_name, ShadowEmitKind kind,
                         const char* golden_name) {
    CCArena arena = cc_arena_create(1 << 20);
    TapeCache cache = {0};
    CEmit emit = {0};
    if (!lower_file(&cache, &arena, src_name, kind, &emit)) {
        tape_cache_free(&cache);
        cc_arena_free(&arena);
        return 0;
    }
    char gpath[512];
    snprintf(gpath, sizeof(gpath), "%s/%s", FIX, golden_name);
    if (getenv("UPDATE_GOLDEN") && getenv("UPDATE_GOLDEN")[0] == '1') {
        FILE* gf = fopen(gpath, "wb");
        if (!gf) {
            printf("FAIL: cannot write golden %s\n", gpath);
            free(emit.buf);
            tape_cache_free(&cache);
            cc_arena_free(&arena);
            return 0;
        }
        fwrite(emit.buf, 1, emit.len, gf);
        if (emit.len == 0 || emit.buf[emit.len - 1] != '\n') fputc('\n', gf);
        fclose(gf);
        printf("UPDATE: %s\n", gpath);
        free(emit.buf);
        tape_cache_free(&cache);
        cc_arena_free(&arena);
        return 1;
    }
    size_t glen = 0;
    char* golden = read_all(gpath, &glen);
    if (!golden) {
        printf("FAIL: missing golden %s\n", gpath);
        free(emit.buf);
        tape_cache_free(&cache);
        cc_arena_free(&arena);
        return 0;
    }
    if (!norm_eq(emit.buf, emit.len, golden, glen)) {
        printf("FAIL: %s emit != %s\n---- emit ----\n%.*s\n---- golden ----\n%s\n",
               src_name, golden_name, (int)emit.len, emit.buf, golden);
        free(golden);
        free(emit.buf);
        tape_cache_free(&cache);
        cc_arena_free(&arena);
        return 0;
    }
    free(golden);
    free(emit.buf);
    tape_cache_free(&cache);
    cc_arena_free(&arena);
    return 1;
}

static int test_ccs_to_c_hostcc(void) {
    CCArena arena = cc_arena_create(1 << 20);
    TapeCache cache = {0};
    CEmit emit = {0};
    if (!lower_file(&cache, &arena, "mini.ccs", SHADOW_EMIT_C, &emit)) return 0;
    const char* tmp = "out/c_pp_shadow_mini.c";
    const char* obj = "out/c_pp_shadow_mini.o";
    FILE* f = fopen(tmp, "wb");
    if (!f) { printf("FAIL: write %s\n", tmp); return 0; }
    fwrite(emit.buf, 1, emit.len, f);
    fclose(f);
    char cmd[512];
    snprintf(cmd, sizeof(cmd), "cc -c -o %s %s 2>&1", obj, tmp);
    int rc = system(cmd);
    free(emit.buf);
    tape_cache_free(&cache);
    cc_arena_free(&arena);
    if (rc != 0) {
        printf("FAIL: host cc -c rejected .c product (rc=%d)\n", rc);
        return 0;
    }
    return 1;
}

static int test_cch_to_h_hostcc(void) {
    /* Compile a tiny .c that includes the generated .h */
    CCArena arena = cc_arena_create(1 << 20);
    TapeCache cache = {0};
    CEmit emit = {0};
    if (!lower_file(&cache, &arena, "mini.cch", SHADOW_EMIT_H, &emit)) return 0;
    const char* hpath = "out/c_pp_shadow_mini.h";
    const char* cpath = "out/c_pp_shadow_mini_use.c";
    const char* obj = "out/c_pp_shadow_mini_use.o";
    {
        FILE* f = fopen(hpath, "wb");
        if (!f) return 0;
        fwrite(emit.buf, 1, emit.len, f);
        fclose(f);
    }
    {
        FILE* f = fopen(cpath, "wb");
        if (!f) return 0;
        fputs("#include \"c_pp_shadow_mini.h\"\n", f);
        fputs("int main(void) { (void)buf; return 0; }\n", f);
        fclose(f);
    }
    char cmd[512];
    snprintf(cmd, sizeof(cmd), "cc -c -Iout -o %s %s 2>&1", obj, cpath);
    int rc = system(cmd);
    free(emit.buf);
    tape_cache_free(&cache);
    cc_arena_free(&arena);
    if (rc != 0) {
        printf("FAIL: host cc rejected .h product (rc=%d)\n", rc);
        return 0;
    }
    return 1;
}

static int test_diag_line(void) {
    CCArena arena = cc_arena_create(1 << 20);
    TapeCache cache = {0};
    const char* path = "cc/shadow/shadow/bad_token.ccs";
    {
        FILE* f = fopen(path, "wb");
        if (!f) return 0;
        fputs("typedef int Err;\n", f);
        fputs("float x;\n", f);
        fclose(f);
    }
    FileTape* ft = tape_cache_load(&cache, path, &arena);
    if (!ft) { printf("FAIL: load bad_token\n"); return 0; }
    Token tokbuf[256];
    Pp pp = {0};
    pp.cache = &cache; pp.arena = &arena; pp.search_dir = FIX;
    pp.out = tokbuf; pp.out_cap = 256;
    if (!pp_run(&pp, ft)) { printf("FAIL: pp bad\n"); return 0; }
    Parser p = {0};
    p.toks = tokbuf; p.n = pp.nout; p.cache = &cache;
    AstNode** items; int n;
    int ok = !parse_tu(&p, &items, &n);
    pp_free_macros(&pp);
    tape_cache_free(&cache);
    cc_arena_free(&arena);
    remove(path);
    if (!ok) {
        printf("FAIL: expected parse failure on float\n");
        return 0;
    }
    return 1;
}

/* Capacity overflows must name the limit (no silent truncate / generic fail). */
/* Conservative safety: lower must fail and name the oracle. */
static int expect_safety_fail(const char* name, const char* needle) {
    char errpath[256];
    char* errbuf = NULL;
    size_t errlen = 0;
    int saved_fd, err_fd;
    CCArena arena = cc_arena_create(1 << 20);
    TapeCache cache = {0};
    CEmit emit = {0};
    int failed;
    snprintf(errpath, sizeof(errpath), "out/cc_safe_%s.err", name);
    err_fd = open(errpath, O_WRONLY | O_CREAT | O_TRUNC, 0644);
    if (err_fd < 0) {
        printf("FAIL: cannot open %s\n", errpath);
        cc_arena_free(&arena);
        return 0;
    }
    fflush(stderr);
    saved_fd = dup(2);
    if (saved_fd < 0 || dup2(err_fd, 2) < 0) {
        close(err_fd);
        if (saved_fd >= 0) close(saved_fd);
        printf("FAIL: stderr redirect\n");
        cc_arena_free(&arena);
        return 0;
    }
    close(err_fd);
    failed = !lower_file(&cache, &arena, name, SHADOW_EMIT_C, &emit);
    fflush(stderr);
    dup2(saved_fd, 2);
    close(saved_fd);
    free(emit.buf);
    tape_cache_free(&cache);
    cc_arena_free(&arena);
    errbuf = read_all(errpath, &errlen);
    remove(errpath);
    if (!failed) {
        printf("FAIL: expected safety fail on %s\n", name);
        free(errbuf);
        return 0;
    }
    if (!errbuf || !strstr(errbuf, needle)) {
        printf("FAIL: %s missing '%s' in:\n%s\n", name, needle,
               errbuf ? errbuf : "(empty)");
        free(errbuf);
        return 0;
    }
    free(errbuf);
    return 1;
}

static int expect_safety_pass(const char* name) {
    CCArena arena = cc_arena_create(1 << 20);
    TapeCache cache = {0};
    CEmit emit = {0};
    int ok = lower_file(&cache, &arena, name, SHADOW_EMIT_C, &emit);
    free(emit.buf);
    tape_cache_free(&cache);
    cc_arena_free(&arena);
    if (!ok) {
        printf("FAIL: expected safety pass on %s\n", name);
        return 0;
    }
    return 1;
}

static int test_safety_oracles(void) {
    if (!expect_safety_fail("safe_use_after_move_fail.ccs",
                            "use of moved slice 's'"))
        return 0;
    if (!expect_safety_fail("safe_move_in_call_fail.ccs",
                            "use of moved slice 's'"))
        return 0;
    if (!expect_safety_fail("safe_chan_send_borrow_fail.ccs",
                            "non-stable slice borrow"))
        return 0;
    if (!expect_safety_fail("safe_arena_reset_borrow_fail.ccs",
                            "cc_arena_reset"))
        return 0;
    if (!expect_safety_fail("safe_unwrap_no_diverge_fail.ccs",
                            "must diverge"))
        return 0;
    if (!expect_safety_fail("safe_variant_unprotected_proj_fail.ccs",
                            "projection of arm"))
        return 0;
    if (!expect_safety_fail("safe_variant_raw_u_fail.ccs",
                            "cannot reach into variant"))
        return 0;
    if (!expect_safety_fail("safe_chan_send_pointer_field_fail.ccs",
                            "raw pointer field"))
        return 0;
    if (!expect_safety_fail("safe_as_anon_fail.ccs", "anonymous @as"))
        return 0;
    if (!expect_safety_fail("safe_type_of_unregistered_fail.ccs",
                            "has no registered cc_type_info"))
        return 0;
    if (!expect_safety_fail("safe_arena_ptr_alias_free_fail.ccs",
                            "non-owning borrow"))
        return 0;
    if (!expect_safety_fail("safe_unproven_ptr_free_fail.ccs",
                            "cannot prove free target provenance"))
        return 0;
    /* Syntactic domination / !> / ?> allow protected projections. */
    if (!expect_safety_pass("safe_variant_if_guard_ok.ccs")) return 0;
    if (!expect_safety_pass("safe_variant_switch_ok.ccs")) return 0;
    if (!expect_safety_pass("safe_variant_bang_ok.ccs")) return 0;
    if (!expect_safety_pass("safe_variant_qmark_ok.ccs")) return 0;
    return 1;
}

static int test_cap_stage2(void) {
    CCArena arena = cc_arena_create(1 << 20);
    TapeCache cache = {0};
    const char* path = "cc/shadow/shadow/cap_stage2.ccs";
    FileTape* ft;
    Token tokbuf[8];
    Pp pp = {0};
    {
        FILE* f = fopen(path, "wb");
        if (!f) return 0;
        fputs("int main(void) { return 0; }\n", f);
        fclose(f);
    }
    ft = tape_cache_load(&cache, path, &arena);
    if (!ft) {
        printf("FAIL: load cap_stage2\n");
        return 0;
    }
    pp.cache = &cache;
    pp.arena = &arena;
    pp.search_dir = FIX;
    pp.out = tokbuf;
    pp.out_cap = 8;
    if (pp_run(&pp, ft)) {
        printf("FAIL: expected stage2 cap overflow\n");
        pp_free_macros(&pp);
        tape_cache_free(&cache);
        cc_arena_free(&arena);
        remove(path);
        return 0;
    }
    if (!strstr(pp.err_msg, "stage2 token buffer full (8")) {
        printf("FAIL: stage2 cap msg missing limit: %s\n", pp.err_msg);
        pp_free_macros(&pp);
        tape_cache_free(&cache);
        cc_arena_free(&arena);
        remove(path);
        return 0;
    }
    pp_free_macros(&pp);
    tape_cache_free(&cache);
    cc_arena_free(&arena);
    remove(path);
    return 1;
}

static int test_cap_body(void) {
    CCArena arena = cc_arena_create(1 << 20);
    TapeCache cache = {0};
    const char* path = "cc/shadow/shadow/cap_body.ccs";
    FileTape* ft;
    Token tokbuf[4096];
    Pp pp = {0};
    Parser p = {0};
    AstNode** items = NULL;
    int n = 0;
    int i;
    {
        FILE* f = fopen(path, "wb");
        if (!f) return 0;
        fputs("int main(void) {\n{\n", f);
        for (i = 0; i < 65; i++) fprintf(f, "int a%d;\n", i);
        fputs("}\nreturn 0;\n}\n", f);
        fclose(f);
    }
    ft = tape_cache_load(&cache, path, &arena);
    if (!ft) {
        printf("FAIL: load cap_body\n");
        return 0;
    }
    pp.cache = &cache;
    pp.arena = &arena;
    pp.search_dir = FIX;
    pp.out = tokbuf;
    pp.out_cap = 4096;
    if (!pp_run(&pp, ft)) {
        printf("FAIL: pp cap_body\n");
        pp_free_macros(&pp);
        tape_cache_free(&cache);
        cc_arena_free(&arena);
        remove(path);
        return 0;
    }
    p.toks = tokbuf;
    p.n = pp.nout;
    p.cache = &cache;
    if (parse_tu(&p, &items, &n) || !strstr(p.err_msg, "cap 64")) {
        printf("FAIL: expected body cap 64 diag, got: %s\n", p.err_msg);
        pp_free_macros(&pp);
        tape_cache_free(&cache);
        cc_arena_free(&arena);
        remove(path);
        return 0;
    }
    pp_free_macros(&pp);
    tape_cache_free(&cache);
    cc_arena_free(&arena);
    remove(path);
    return 1;
}

static int test_cap_field(void) {
    CCArena arena = cc_arena_create(1 << 20);
    TapeCache cache = {0};
    const char* path = "cc/shadow/shadow/cap_field.ccs";
    FileTape* ft;
    Token tokbuf[4096];
    Pp pp = {0};
    Parser p = {0};
    AstNode** items = NULL;
    int n = 0;
    char long_id[640];
    {
        FILE* f = fopen(path, "wb");
        if (!f) return 0;
        /* AstNode text fields are 512 bytes; exceed that for the span diag. */
        memset(long_id, 'A', 600);
        long_id[600] = 0;
        fprintf(f, "int main(void) { return %s; }\n", long_id);
        fclose(f);
    }
    ft = tape_cache_load(&cache, path, &arena);
    if (!ft) {
        printf("FAIL: load cap_field\n");
        return 0;
    }
    pp.cache = &cache;
    pp.arena = &arena;
    pp.search_dir = FIX;
    pp.out = tokbuf;
    pp.out_cap = 4096;
    if (!pp_run(&pp, ft)) {
        printf("FAIL: pp cap_field\n");
        pp_free_macros(&pp);
        tape_cache_free(&cache);
        cc_arena_free(&arena);
        remove(path);
        return 0;
    }
    p.toks = tokbuf;
    p.n = pp.nout;
    p.cache = &cache;
    if (parse_tu(&p, &items, &n) ||
        !strstr(p.err_msg, "exceeds 511-byte AST text field")) {
        printf("FAIL: expected 511-byte field diag, got: %s\n", p.err_msg);
        pp_free_macros(&pp);
        tape_cache_free(&cache);
        cc_arena_free(&arena);
        remove(path);
        return 0;
    }
    pp_free_macros(&pp);
    tape_cache_free(&cache);
    cc_arena_free(&arena);
    remove(path);
    return 1;
}

static int test_include_tape_reuse(void) {
    CCArena arena = cc_arena_create(1 << 20);
    TapeCache cache = {0};
    CEmit emit = {0};
    if (!lower_file(&cache, &arena, "with_include.cch", SHADOW_EMIT_H, &emit)) {
        tape_cache_free(&cache);
        cc_arena_free(&arena);
        return 0;
    }
    int types_tapes = 0;
    for (int i = 0; i < cache.n; i++) {
        if (strstr(cache.items[i]->path, "types.inc")) types_tapes++;
    }
    free(emit.buf);
    tape_cache_free(&cache);
    cc_arena_free(&arena);
    if (types_tapes != 1) {
        printf("FAIL: types.inc stage1 tapes=%d want 1\n", types_tapes);
        return 0;
    }
    return 1;
}

static int shadow_keep_nop(void* env, int id, CCSlice v) {
    (void)env; (void)id; (void)v;
    return 0;
}

/* Provenance: product must carry #line back to the .ccs path. */
static int test_line_provenance(void) {
    CCArena arena = cc_arena_create(1 << 20);
    TapeCache cache = {0};
    CEmit emit = {0};
    if (!lower_file(&cache, &arena, "hello.ccs", SHADOW_EMIT_C, &emit)) {
        tape_cache_free(&cache);
        cc_arena_free(&arena);
        return 0;
    }
    int ok = 1;
    if (!strstr(emit.buf, "#line ") || !strstr(emit.buf, "hello.ccs")) {
        printf("FAIL: hello emit missing #line … hello.ccs provenance\n");
        ok = 0;
    }
    /* Nursery unwrap site in shadow/hello.ccs (line 9) — tok_off loci. */
    if (ok && !strstr(emit.buf, "#line 9 \"")) {
        printf("FAIL: hello emit missing #line 9 for nursery site\n");
        ok = 0;
    }
    free(emit.buf);
    tape_cache_free(&cache);
    cc_arena_free(&arena);
    return ok;
}

int main(void) {
    CCArena gate = cc_arena_create(4096);
    (void)PpTok_match(";", 1);
    (void)PpTok_collect(";", 1, &gate, shadow_keep_nop, NULL);
    /* TU-surface demand: emit PpStmt entries before the umbrella's headers
     * call them (grammar emission keys on .ccs call sites). */
    (void)PpStmt_match("break;", 6);
    cc_arena_free(&gate);

    /* Compact golden matrix: mini + hard shapes. Full recipe behavior is
     * run_recipes_shadow.sh (not text goldens). */
    if (!expect_golden("mini.ccs", SHADOW_EMIT_C, "mini.c.golden")) return 1;
    if (!expect_golden("hello.ccs", SHADOW_EMIT_C, "hello.c.golden")) return 1;
    if (!expect_golden("recipe_result.ccs", SHADOW_EMIT_C, "recipe_result.c.golden")) return 1;
    if (!expect_golden("recipe_ordered_parallel.ccs", SHADOW_EMIT_C,
                       "recipe_ordered_parallel.c.golden"))
        return 1;
    if (!expect_golden("recipe_generics.ccs", SHADOW_EMIT_C, "recipe_generics.c.golden"))
        return 1;
    if (!expect_golden("mini.cch", SHADOW_EMIT_H, "mini.h.golden")) return 1;
    if (!expect_golden("with_include.cch", SHADOW_EMIT_H, "with_include.h.golden")) return 1;
    if (!expect_golden("result_frag.cch", SHADOW_EMIT_H, "result_frag.h.golden")) return 1;
    if (!expect_golden("io_error_frag.cch", SHADOW_EMIT_H, "io_error_frag.h.golden")) return 1;
    if (!expect_golden("error_face_frag.cch", SHADOW_EMIT_H, "error_face_frag.h.golden")) return 1;
    if (!test_include_tape_reuse()) return 1;
    if (!test_line_provenance()) return 1;
    if (!test_ccs_to_c_hostcc()) return 1;
    if (!test_cch_to_h_hostcc()) return 1;
    if (!test_diag_line()) return 1;
    if (!test_cap_stage2()) return 1;
    if (!test_cap_body()) return 1;
    if (!test_cap_field()) return 1;
    if (!test_safety_oracles()) return 1;
    {
        /* Beachhead name-match only — stdlib diffs + recipes live in
         * scripts/test_shadow_recipes.sh (keeps this smoke under cc_test's
         * default run timeout). */
        char cmd[512];
        snprintf(cmd, sizeof(cmd),
                 "bash cc/shadow/shadow/diff_lower_header.sh");
        int rc = system(cmd);
        if (rc != 0) {
            printf("FAIL: diff_lower_header.sh rc=%d\n", rc);
            return 1;
        }
    }
    printf("c_pp shadow emit (.ccs→.c / .cch→.h, 2-stage) OK\n");
    return 0;
}

// Test: Nested closures with captures at different levels
#include <ccc/cc_nursery.cch>
#include <stdio.h>

int main(void) {
    @errhandler(CCError e) cc_error_exit(e);
    int outer = 100;
    
    {
        CCNursery __cc_nursery47 = @create() !> @destroy;

        __cc_nursery47.spawn(() => [outer] {
            int middle = 50;
            
            // Inner nursery with nested closure
            {
                CCNursery __cc_nursery48 = @create() !> @destroy;

                __cc_nursery48.spawn(() => [outer, middle] {
                    int inner = 25;
                    printf("outer=%d middle=%d inner=%d\n", outer, middle, inner);
                    printf("sum=%d\n", outer + middle + inner);
                }) !>;
            
            }
        }) !>;
    
    }
    
    return 0;
}

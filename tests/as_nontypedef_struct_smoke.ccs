/* Non-typedef struct with a named as: embed must participate in UFCS retry. */
#include <ccc/std/prelude.cch>
#include <ccc/script/temp.cch>
#include <assert.h>
#include <stdio.h>
#include <string.h>
#include <unistd.h>

struct AsNtWrap {
    int tag;
    CCFile file;
};

@typeview on AsNtWrap {
    as: file;
};

int main(void) {
    @errhandler(CCError e) {
        fprintf(stderr, "err: %s\n", e.message ? e.message : "?");
        return 1;
    }

    CCArena a = @create(kilobytes(64)) @destroy;
    struct AsNtWrap w = {0};
    w.tag = 2;
    w.create("tmp/as_nontypedef_struct_smoke.txt") !>;
    assert(w.file.fd >= 0);
    w.close();
    assert(w.file.fd < 0);
    remove("tmp/as_nontypedef_struct_smoke.txt");
    printf("ok\n");
    return 0;
}

/* Comma-declarators in a C-only struct: cparse flatten emits one field
 * per name. Nested `{` is also cparse's. */
typedef struct CparseComma {
    size_t a, b, c;
    int *p, q;
} CparseComma;

int main(void) {
    CparseComma x;
    int n = 0;
    x.a = 1;
    x.b = 2;
    x.c = 3;
    x.p = &n;
    x.q = 4;
    return (x.a + x.b + x.c + (size_t)x.q == 10 && x.p == &n) ? 0 : 1;
}

/* Extracted interface @variant is host C in the .h. The guest harvests
 * the arms: one-arm construction, switch, and projection. A same-TU
 * struct field named `buf` is not rewritten. */
#include <ccc/std/prelude.cch>
#include <stdio.h>
#include "quote_cch_variant_extract.cch"

int main(void) {
    QuoteVaCell c = { .num = { .n = 7 } };
    QuoteVaField f = { .tag = 1, .buf = NULL };
    QuoteVaHold h;
    if (c.kind != QuoteVaCell_num) {
        printf("cell kind\n");
        return 1;
    }
    @switch (c) {
        case .num:
            if (c.num.n != 7) {
                printf("cell num\n");
                return 1;
            }
            break;
        case .flag:
            printf("cell flag\n");
            return 1;
    }
    f.buf = (char *)0;
    if (f.tag != 1) {
        printf("field tag\n");
        return 1;
    }
    f = (QuoteVaField){ .tag = 2, .buf = (char *)0 };
    if (f.tag != 2) {
        printf("field compound\n");
        return 1;
    }
    h = (QuoteVaHold){ .cell = { .flag = {} } };
    if (h.cell.kind != QuoteVaCell_flag) {
        printf("hold flag\n");
        return 1;
    }
    printf("ok\n");
    return 0;
}

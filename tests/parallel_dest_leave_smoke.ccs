/*
 * Dest leave / EMPTY: leftover LEFT-only; close(tx) on both paths.
 */
#include <ccc/std/prelude.cch>
#include <ccc/cc_atomic.cch>
#include <stdio.h>

static void finish_flag(void* p) {
    cc_atomic_store((cc_atomic_int*)p, 1);
}

static int wait_flag(cc_atomic_int* f, int ms) {
    int i;
    for (i = 0; i < ms; i++) {
        if (cc_atomic_load(f) == 1)
            return 1;
        cc_sleep_ms(1);
    }
    return 0;
}

int main(void) {
    @errhandler(CCError e) { cc_error_log(e); return 1; }

    {
        cc_atomic_int done = 0;
        int a = 0;
        int b = 0;
        CCParallel h = @parallel {
            a = 1;
            b = 2;
        } !>;
        if (!h.live()) {
            fprintf(stderr, "FAIL dest not live\n");
            return 2;
        }
        h.leave(&done, finish_flag) !>;
        if (h.live() || h.joined) {
            fprintf(stderr, "FAIL after leave live=%d joined=%d\n", h.live(),
                    h.joined);
            return 3;
        }
        if (!wait_flag(&done, 2000)) {
            fprintf(stderr, "FAIL leftover\n");
            return 4;
        }
        if (a + b != 3) {
            fprintf(stderr, "FAIL leftover join a=%d b=%d\n", a, b);
            return 5;
        }
    }

    {
        int[~1 >] tx;
        int[~1 <] rx;
        CCChan* ch = cc_channel_pair(&tx, &rx) !> @destroy;
        int tmp = 0;
        int a = 0;
        int b = 0;
        CCParallel h = @parallel {
            a = 1;
            b = 2;
        } !>;
        h.close(tx) !>;
        h.wait() !>;
        if (a + b != 3) {
            fprintf(stderr, "FAIL wait join a=%d b=%d\n", a, b);
            return 6;
        }
        CCResult_bool_CCIoError tr = chan_try_recv(rx, &tmp);
        if (!(cc_is_ok(tr) && !cc_unwrap(tr))) {
            fprintf(stderr, "FAIL wait EMPTY did not close\n");
            return 7;
        }
    }

    {
        int[~1 >] tx;
        int[~1 <] rx;
        CCChan* ch = cc_channel_pair(&tx, &rx) !> @destroy;
        cc_atomic_int done = 0;
        int tmp = 0;
        int a = 0;
        int b = 0;
        CCParallel h = @parallel {
            a = 1;
            b = 2;
        } !>;
        h.close(tx) !>;
        h.leave(&done, finish_flag) !>;
        if (!wait_flag(&done, 2000)) {
            fprintf(stderr, "FAIL leave EMPTY leftover\n");
            return 8;
        }
        if (a + b != 3) {
            fprintf(stderr, "FAIL leave EMPTY join a=%d b=%d\n", a, b);
            return 9;
        }
        CCResult_bool_CCIoError tr = chan_try_recv(rx, &tmp);
        if (!(cc_is_ok(tr) && !cc_unwrap(tr))) {
            fprintf(stderr, "FAIL leave EMPTY did not close\n");
            return 10;
        }
    }

    printf("parallel_dest_leave_smoke: OK\n");
    return 0;
}

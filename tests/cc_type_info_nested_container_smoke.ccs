/* Pin that nested container instantiations (Vec<Vec<int>>) flow
 * through the codegen emission path correctly:
 *   - Each layer gets its own `cc_type_info` registered.
 *   - The outer layer's size matches `sizeof(Vec<inner>)`.
 *   - Both layers report `CC_TK_GENERIC_INST`.
 *
 * This catches a class of bug where the codegen emission only
 * walks the top-level Vec<T> in the type registry and forgets
 * that T itself was a generic the registry knew about.
 */

#include <ccc/std/prelude.cch>
#include <ccc/cc_type.cch>
#include <stdio.h>

int main(void) {
    CCArena arena = cc_arena_heap(kilobytes(8));
    if (!arena.base) { printf("FAIL arena\n"); return 1; }

    /* Use both the inner and outer instantiation in user code
     * so the codegen pass has to emit cc_type_info for both. */
    Vec<int> inner = vec_new<int>(&arena);
    inner.push(7);

    Vec<Vec<int>> outer = vec_new<Vec<int>>(&arena);
    outer.push(inner);

    int fails = 0;

    const cc_type_info* inner_ti = type_of(CCVec_int);
    if (!inner_ti) {
        printf("FAIL: type_of(CCVec_int) is NULL\n");
        fails++;
    } else if (cc_ti_kind(inner_ti) != CC_TK_GENERIC_INST) {
        printf("FAIL: inner CCVec_int kind != GENERIC_INST (got %d)\n",
               (int)cc_ti_kind(inner_ti));
        fails++;
    }

    /* The mangled name for Vec<Vec<int>> follows CC's mangler.
     * `CCVec_CCVec_int` is the convention (Vec<T> mangles to
     * CCVec_<mangled(T)>).  If this fails, the codegen path
     * isn't emitting nested instantiations — or the mangler
     * changed and this assertion needs updating in lockstep. */
    const cc_type_info* outer_ti = type_of(CCVec_CCVec_int);
    if (!outer_ti) {
        printf("FAIL: type_of(CCVec_CCVec_int) is NULL — nested "
               "container codegen emission missing\n");
        fails++;
    } else {
        if (cc_ti_kind(outer_ti) != CC_TK_GENERIC_INST) {
            printf("FAIL: outer kind != GENERIC_INST\n");
            fails++;
        }
        if ((cc_ti_flags(outer_ti) & CC_TF_ERASABLE) == 0) {
            printf("FAIL: outer missing CC_TF_ERASABLE\n");
            fails++;
        }
        /* Outer size must equal sizeof(Vec<int>) — they share
         * the __CCVecGeneric layout regardless of nesting depth. */
        if (cc_ti_size(outer_ti) != sizeof(Vec<int>)) {
            printf("FAIL: outer size %zu != sizeof(Vec<int>) %zu\n",
                   cc_ti_size(outer_ti), sizeof(Vec<int>));
            fails++;
        }
    }

    if (fails == 0) {
        printf("cc_type_info nested container: OK\n");
        return 0;
    }
    printf("cc_type_info nested container: %d FAIL\n", fails);
    return 1;
}

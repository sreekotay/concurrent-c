/* Seams from the arena review: REGION_OWNED detach after grow, releases
 * during scratch, children and checkpoints together, LIFO for armed
 * handles, abandon, scope destroy of a checkpoint, epoch checks across the
 * active chain, overlay alignment. */
#include <ccc/std/prelude.cch>
#include <stdio.h>
#include <string.h>

static int fail(int code, const char *msg) {
    printf("FAIL: %s\n", msg);
    return code;
}

int main(void) {
    @errhandler(CCError e) { (void)e; return fail(9, "unwrap"); }
    /* Grow a heap arena, then detach — REGION_OWNED survives grow. */
    {
        CCArena a = cc_arena_heap(64);
        void *p;
        CCArena taken;
        int i;
        if (!cc_arena_is_live(a)) return fail(1, "heap");
        for (i = 0; i < 8; i++) {
            p = cc_arena_alloc(a, 32, 8);
            if (!p) return fail(1, "grow alloc");
        }
        taken = a.detach() !>;
        if (!cc_arena_is_live(taken)) return fail(1, "detach after grow");
        if (cc_arena_is_live(a)) return fail(1, "source dead");
        cc_arena_destroy(&taken);
    }

    /* Releasing a pre-checkpoint object during scratch is a parent release:
     * it cannot rewind under the child and never blocks the restore. */
    {
        CCArena a = cc_arena_heap(kilobytes(1));
        void *p;
        CCArenaCheckpoint cp;
        if (!cc_arena_is_live(a)) return fail(2, "heap");
        p = cc_arena_alloc(a, 16, 8);
        if (!p) return fail(2, "alloc");
        cp = cc_arena_checkpoint(a.a);
        if (!cp.arena) return fail(2, "checkpoint");
        if (!cc_arena_release(a.a, p)) return fail(2, "release");
        if (cc_arena_slab_offset(a.a) != a.a->slab->capacity)
            return fail(2, "parent tip stays at the child while it is active");
        if (!cc_arena_restore(cp)) return fail(2, "restore after release");
        if (cc_arena_slab_offset(a.a) != 0)
            return fail(2, "last-live pop rewinds to zero");
        cc_arena_destroy(&a);
    }

    /* Children and checkpoints mix; LIFO holds for armed handles. */
    {
        CCArena parent = cc_arena_heap(kilobytes(2));
        CCArenaCheckpoint a_cp;
        CCArenaCheckpoint b_cp;
        CCArena child;
        CCSlice pre;
        CCSlice mid;
        void *p;
        if (!cc_arena_is_live(parent)) return fail(3, "parent");
        p = cc_arena_alloc(parent, 8, 8);
        if (!p) return fail(3, "pre");
        pre = parent.slice(p, 8);
        a_cp = cc_arena_checkpoint(parent.a);
        if (!a_cp.arena) return fail(3, "cp A");
        if (!cc_slice_is_from_arena_epoch(pre, parent.a))
            return fail(3, "pre-checkpoint slice still live");
        mid = cc_arena_alloc_slice_bytes(parent, 8); /* forwarded: child epoch */
        if (!mid.ptr) return fail(3, "mid");
        if (!cc_slice_is_from_arena_epoch(mid, parent.a))
            return fail(3, "forwarded slice is live through the parent handle");
        if (!cc_slice_is_from_arena_epoch(mid, a_cp.arena))
            return fail(3, "forwarded slice is live on the child");
        b_cp = cc_arena_checkpoint(parent.a);
        if (!b_cp.arena || b_cp.parent != a_cp.arena) return fail(3, "cp B nests in A");
        if (cc_arena_restore(a_cp)) return fail(3, "outer refuses while inner is armed");
        if (!cc_arena_restore(b_cp)) return fail(3, "LIFO B");
        if (!cc_arena_restore(a_cp)) return fail(3, "A after B");
        if (cc_slice_is_from_arena_epoch(mid, parent.a))
            return fail(3, "scratch slice is dead after restore");
        child = parent.create_arena(64) !>;
        if (!cc_arena_is_live(child)) return fail(3, "child");
        {
            CCArenaCheckpoint after = cc_arena_checkpoint(parent.a);
            if (!after.arena) return fail(3, "checkpoint arms with children attached");
            if (!cc_arena_restore(after)) return fail(3, "restore with children attached");
        }
        cc_arena_destroy(&parent);
    }

    /* Abandon keeps the scratch: the child stays active and dies with the
     * parent; the handle is consumed. */
    {
        CCArena a = cc_arena_heap(kilobytes(1));
        CCArenaCheckpoint outer;
        CCArenaCheckpoint inner;
        void *keep;
        void *drop;
        if (!cc_arena_is_live(a)) return fail(4, "heap");
        keep = cc_arena_alloc(a, 16, 8);
        if (!keep) return fail(4, "keep");
        outer = cc_arena_checkpoint(a.a);
        if (!outer.arena) return fail(4, "outer");
        drop = cc_arena_alloc(a, 16, 8);
        if (!drop) return fail(4, "drop");
        inner = cc_arena_checkpoint(a.a);
        if (!inner.arena) return fail(4, "inner");
        if (!inner.abandon()) return fail(4, "inner abandon");
        if (inner.arena) return fail(4, "abandoned handle not nulled");
        if (outer.arena->active == NULL) return fail(4, "abandoned inner stays active");
        if (!cc_arena_restore(outer))
            return fail(4, "outer restore tears down the abandoned inner");
        if (a.a->active != NULL) return fail(4, "parent has no active child after restore");
        (void)drop;
        cc_arena_destroy(&a);
    }

    /* Heap child destroy tombstones the owner record (no UAF on owner free). */
    {
        CCArena owner = cc_arena_heap(kilobytes(1));
        CCArena kid;
        if (!cc_arena_is_live(owner)) return fail(5, "owner");
        kid = owner.create_arena(0) !>;
        if (!cc_arena_is_live(kid)) return fail(5, "kid");
        cc_arena_destroy(&kid);
        cc_arena_destroy(&owner);
    }

    /* Scope destroy of a checkpoint restores even after releases inside. */
    {
        CCArena a = cc_arena_heap(kilobytes(1));
        CCArena taken;
        void *p;
        if (!cc_arena_is_live(a)) return fail(6, "heap");
        p = cc_arena_alloc(a, 16, 8);
        if (!p) return fail(6, "alloc");
        {
            CCArenaCheckpoint cp = cc_arena_checkpoint(a.a);
            if (!cp.arena) return fail(6, "cp");
            if (!cc_arena_release(a.a, p)) return fail(6, "release");
            cc_arena_checkpoint_destroy(&cp);
            if (cp.arena) return fail(6, "destroy consumed the handle");
        }
        if (a.a->active) return fail(6, "no active child after destroy");
        taken = a.detach() !>;
        if (!cc_arena_is_live(taken)) return fail(6, "detach after checkpoint destroy");
        cc_arena_destroy(&taken);
    }

    /* Detach and adopt refuse while a checkpoint child is active. */
    {
        CCArena a = cc_arena_heap(kilobytes(1));
        CCArena sink = cc_arena_heap(kilobytes(1));
        CCArenaCheckpoint cp;
        if (!cc_arena_is_live(a) || !cc_arena_is_live(sink)) return fail(8, "heap");
        cp = cc_arena_checkpoint(a.a);
        if (!cp.arena) return fail(8, "cp");
        {
            CCArena !>(CCError) dr = a.detach();
            if (cc_is_ok(dr)) return fail(8, "detach must refuse with an active child");
        }
        if (cc_is_ok(sink.adopt(&a))) return fail(8, "adopt must refuse with an active child");
        if (!cc_arena_restore(cp)) return fail(8, "restore");
        {
            CCArena taken = a.detach() !>;
            if (!cc_arena_is_live(taken)) return fail(8, "detach after restore");
            cc_arena_destroy(&taken);
        }
        cc_arena_destroy(&sink);
    }

    /* Overlay aligns up inside the caller region — no silent dead handle. */
    {
        _Alignas(CCArenaHost) uint8_t raw[CC_ARENA_REGION_BYTES(64) + 8];
        CCArena a = cc_arena_wrap_region(raw + 1, CC_ARENA_REGION_BYTES(64),
                                         CC_ARENA_FIXED);
        void *p;
        if (!cc_arena_is_live(a)) return fail(7, "unaligned overlay");
        if (((uintptr_t)a.a % _Alignof(CCArenaHost)) != 0)
            return fail(7, "host not aligned");
        p = cc_arena_alloc(a, 16, 8);
        if (!p) return fail(7, "alloc after align-up");
        cc_arena_destroy(&a);
    }

    printf("arena_review_seam_smoke: ok\n");
    return 0;
}

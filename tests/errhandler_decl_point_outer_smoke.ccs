/*
 * Nested unwrap before an inner @errhandler must use the outer handler
 * already in scope (emit must not hoist the inner declaration).
 */
#include <stdio.h>
#include <ccc/std/prelude.cch>

static int g_hit;
static int g_inner;

static int !> (CCError) always_err_cc(void) {
    return cc_err(CC_ERR_NOT_FOUND, "cc");
}

int main(void) {
    @errhandler(CCError e) {
        (void)e;
        g_hit = 1;
    }
    {
        /* above the inner handler: this site takes the outer one */
        always_err_cc() !>;
        @errhandler(CCError e) {
            (void)e;
            g_inner = 2;
        }
        /* below it: this one takes the inner */
        always_err_cc() !>;
    }
    printf("g_hit=%d g_inner=%d\n", g_hit, g_inner);
    return (g_hit == 1 && g_inner == 2) ? 0 : 1;
}

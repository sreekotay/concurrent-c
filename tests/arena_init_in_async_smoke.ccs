#include <ccc/cc_runtime.cch>
#include <ccc/std/task.cch>
#include <ccc/std/prelude.cch>

@async int noop(int v) { return v; }

@async int f(void) {
    int x = @await noop(3);
    _Alignas(CCArenaHost) char buf[CC_ARENA_REGION_BYTES(256)];
    int out = 0;
    CCArena arena_storage = cc_arena_wrap_region(buf, sizeof(buf),
                                                CC_ARENA_FIXED);
    if (1) {
        CCArena* arena = &arena_storage;
        int* slot = cc_arena_alloc_T(int, arena);
        if (!slot) abort();
        *slot = x;
        out = *slot;
    }
    cc_arena_free(&arena_storage);
    return out;
}

int main(void) {
    CCTaskIntptr t = f();
    intptr_t r = cc_block_on_intptr(t);
    return (r == 3) ? 0 : 1;
}

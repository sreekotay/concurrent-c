/*
 * @defer / @destroy registration watermark — both directions of the contract:
 *   runs iff control passed the registration line; every soft-return exit.
 *
 * Pair with defer_bang_handler_return_smoke (handler-return after register).
 * This file pins the inverse and redis-shaped interleavings: early failure
 * before a later @defer must leave that canary untouched (unguarded cleanup
 * would poke it — the listen-failure / uninit-ln.close class).
 */
#include <ccc/std/prelude.cch>
#include <stdio.h>
#include <string.h>

static int g_a;
static int g_b;
static int g_c;
static int g_d;
static int g_f;
static int g_order[8];
static int g_norder;
static int g_close_calls;
static int g_close_seen_ready;

typedef struct FakeLn {
    int ready; /* 0 until "listen" succeeds; close must not see garbage */
} FakeLn;

static void fake_ln_close(FakeLn* ln) {
    g_close_calls++;
    if (ln && ln->ready)
        g_close_seen_ready++;
    else {
        /* Pathological: close on unregistered / unready ln. */
        fprintf(stderr, "FAIL: fake_ln_close on unready ln\n");
        g_close_seen_ready = -999;
    }
}

static void poke(int* slot, int id) {
    if (slot) (*slot)++;
    if (g_norder < 8) g_order[g_norder++] = id;
}

static CCResult_int_CCError boom(void) {
    return cc_err(CC_ERR_INVALID_ARG, "boom");
}

/* --- A: early return before any @defer --- */
static int fail_before_any(void) {
    if (1) return 1;
    @defer { poke(&g_a, 1); };
    return 0;
}

/* --- B: registered then early return; later @defer never registered --- */
static int fail_between_defers(void) {
    @defer { poke(&g_a, 1); };
    if (1) return 2;
    @defer { poke(&g_b, 2); };
    return 0;
}

/* --- C: bang-handler return between defers (redis listen shape) --- */
static int bang_between_defers(void) {
    @defer { poke(&g_a, 1); };
    int x = boom() !>(e) {
        (void)e;
        return 3;
    };
    (void)x;
    @defer { poke(&g_b, 2); };
    return 0;
}

/* --- D: three defers; fail after the middle registration --- */
static int fail_after_second_of_three(void) {
    @defer { poke(&g_a, 1); };
    @defer { poke(&g_b, 2); };
    if (1) return 4;
    @defer { poke(&g_c, 3); };
    return 0;
}

/* --- E: @destroy registered, early return before trailing @defer --- */
static int destroy_then_fail_before_defer(void) {
    CCArena arena = cc_arena_heap(kilobytes(1)) @destroy {
        poke(&g_d, 10);
    };
    (void)arena;
    if (1) return 5;
    @defer { poke(&g_f, 11); };
    return 0;
}

/* --- F: @defer, then @destroy, then @defer — fail after destroy only --- */
static int interleaved_fail_mid(void) {
    @defer { poke(&g_a, 1); };
    CCArena arena = cc_arena_heap(kilobytes(1)) @destroy {
        poke(&g_d, 10);
    };
    (void)arena;
    if (1) return 6;
    @defer { poke(&g_b, 2); };
    return 0;
}

/* --- G: all registered — LIFO cleanup order (3,2,1) --- */
static int all_registered_lifo(void) {
    g_norder = 0;
    @defer { poke(&g_a, 1); };
    @defer { poke(&g_b, 2); };
    @defer { poke(&g_c, 3); };
    return 7;
}

/* --- H: redis-shaped FakeLn — fail before @defer ln.close --- */
static int listen_fail_skips_close(void) {
    FakeLn ln;
    memset(&ln, 0xA5, sizeof(ln)); /* garbage; must never be closed */
    @defer { poke(&g_a, 1); };
    int x = boom() !>(e) {
        (void)e;
        return 8;
    };
    (void)x;
    ln.ready = 1;
    @defer { fake_ln_close(&ln); };
    return 0;
}

/* --- I: listen ok — close runs and sees ready --- */
static int listen_ok_closes(void) {
    FakeLn ln = {0};
    ln.ready = 1;
    @defer { fake_ln_close(&ln); };
    return 9;
}

static int expect_counts(const char* name, int ea, int eb, int ec, int ed,
                         int ef) {
    if (g_a != ea || g_b != eb || g_c != ec || g_d != ed || g_f != ef) {
        fprintf(stderr,
                "FAIL %s: a=%d b=%d c=%d d=%d f=%d (want %d %d %d %d %d)\n",
                name, g_a, g_b, g_c, g_d, g_f, ea, eb, ec, ed, ef);
        return 0;
    }
    return 1;
}

int main(void) {
    int rc;

    g_a = g_b = g_c = g_d = g_f = 0;
    rc = fail_before_any();
    if (rc != 1 || !expect_counts("fail_before_any", 0, 0, 0, 0, 0)) return 1;

    g_a = g_b = g_c = g_d = g_f = 0;
    rc = fail_between_defers();
    if (rc != 2 || !expect_counts("fail_between_defers", 1, 0, 0, 0, 0))
        return 1;

    g_a = g_b = g_c = g_d = g_f = 0;
    rc = bang_between_defers();
    if (rc != 3 || !expect_counts("bang_between_defers", 1, 0, 0, 0, 0))
        return 1;

    g_a = g_b = g_c = g_d = g_f = 0;
    rc = fail_after_second_of_three();
    if (rc != 4 || !expect_counts("fail_after_second_of_three", 1, 1, 0, 0, 0))
        return 1;

    g_a = g_b = g_c = g_d = g_f = 0;
    rc = destroy_then_fail_before_defer();
    if (rc != 5 || !expect_counts("destroy_then_fail_before_defer", 0, 0, 0, 1, 0))
        return 1;

    g_a = g_b = g_c = g_d = g_f = 0;
    rc = interleaved_fail_mid();
    if (rc != 6 || !expect_counts("interleaved_fail_mid", 1, 0, 0, 1, 0))
        return 1;

    g_a = g_b = g_c = g_d = g_f = 0;
    g_norder = 0;
    rc = all_registered_lifo();
    if (rc != 7 || !expect_counts("all_registered_lifo", 1, 1, 1, 0, 0))
        return 1;
    if (g_norder != 3 || g_order[0] != 3 || g_order[1] != 2 ||
        g_order[2] != 1) {
        fprintf(stderr, "FAIL lifo order: n=%d [%d,%d,%d]\n", g_norder,
                g_order[0], g_order[1], g_order[2]);
        return 1;
    }

    g_a = g_b = g_c = g_d = g_f = 0;
    g_close_calls = g_close_seen_ready = 0;
    rc = listen_fail_skips_close();
    if (rc != 8 || !expect_counts("listen_fail_skips_close", 1, 0, 0, 0, 0))
        return 1;
    if (g_close_calls != 0 || g_close_seen_ready != 0) {
        fprintf(stderr, "FAIL listen_fail: close_calls=%d seen_ready=%d\n",
                g_close_calls, g_close_seen_ready);
        return 1;
    }

    g_close_calls = g_close_seen_ready = 0;
    rc = listen_ok_closes();
    if (rc != 9 || g_close_calls != 1 || g_close_seen_ready != 1) {
        fprintf(stderr, "FAIL listen_ok: rc=%d calls=%d ready=%d\n", rc,
                g_close_calls, g_close_seen_ready);
        return 1;
    }

    printf("defer_registration_hw_smoke: PASS\n");
    return 0;
}

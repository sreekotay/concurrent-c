#include <ccc/std/prelude.cch>
#include <stdio.h>

static inline CCSliceHdr key_view(char[:] key) {
    return cc_slice_hdr_from_buffer(key.ptr, key.len);
}

typedef struct Entr { int64_t n; } Entr;

typedef ArrayMap::[CCSliceHdr, Entr] DbMap;

typedef struct Db {
    DbMap entries;
} Db;

int main(void) {
    CCArena arena = cc_arena_heap(kilobytes(64));
    Db db;
    Entr e;
    Entr* p;
    CCSliceHdr k;
    if (!cc_arena_is_live(arena)) return 1;
    db.entries = array_map_new::[CCSliceHdr, Entr](arena);
    if (!db.entries) return 2;
    k = key_view(@slice("k"));
    e.n = 99;
    if (db.entries->insert(k, e) != 0) return 3;
    p = db.entries->get_ptr(k);
    if (!p || p->n != 99) return 4;
    if (db.entries->len() != 1) return 5;
    printf("array_map_sugar_after_helper_smoke ok\n");
    db.entries->destroy();
    cc_arena_free(&arena);
    return 0;
}

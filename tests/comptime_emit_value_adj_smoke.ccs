#include <ccc/std/prelude.cch>
#include <ccc/cc_instantiate.cch>
#include <stdio.h>

/* File-scope @comptime(value) next to a @comptime {@emit} — value hoist
 * must not walk into the emit backticks (skip_templates=1). */
enum { EMIT_VAL_ADJ = @comptime(3 + 4) };

@comptime {
    @emit(CC_EMIT_AFTER_PRELUDE, `
        /* don't value-adj 'emit' */
        enum { EMIT_VAL_BODY = ${2} };
        enum { EMIT_VAL_COPY = ${7} };
    `);
}

int main(void) {
    if (EMIT_VAL_ADJ != 7) return 1;
    if (EMIT_VAL_BODY != 2) return 2;
    if (EMIT_VAL_COPY != 7) return 3;
    printf("comptime_emit_value_adj_smoke ok\n");
    return 0;
}

// Schema float/double binds: keep borrows number text; ffc parses at bind.
#include <ccc/std/prelude.cch>
#include <math.h>
#include <string.h>
#include <stdio.h>

@grammar(rules) Num {~~~~
    top:   number
    digit: charset [#'0' - #'9']
    onenine: charset [#'1' - #'9']
    int:   [opt #'-' [#'0' | [onenine any digit]]]
    number: keep [int opt [#'.' some digit]
                         opt [charset [#'e' #'E'] opt charset [#'+' #'-'] some digit]]
~~~~}

@grammar(schema) Point {~~~~
    use Num
    "{" "\"x\":" x: float Num.number ",\"y\":" y: double Num.number "}"
~~~~}

int main(void) {
    CCArena arena = cc_arena_create(1 << 20);
    const char* s = "{\"x\":-1.5,\"y\":2.25e1}";
    Point p;
    if (!Point_parse(s, strlen(s), arena, &p)) {
        fprintf(stderr, "Point_parse failed\n");
        return 1;
    }
    if (fabs(p.x - (-1.5)) > 1e-12 || fabs(p.y - 22.5) > 1e-12) {
        fprintf(stderr, "bad values: x=%g y=%g\n", p.x, p.y);
        return 1;
    }
    CCArena ar2 = cc_arena_create(1 << 20);
    const char* n = "-1.5";
    NumNode* tape = Num_parse(n, strlen(n), ar2);
    if (!tape) {
        fprintf(stderr, "Num_parse failed\n");
        return 1;
    }
    if (fabs(NumNode_as_f64(&tape[1]) - (-1.5)) > 1e-12) {
        fprintf(stderr, "NumNode_as_f64 failed: %g\n", NumNode_as_f64(&tape[1]));
        return 1;
    }
    cc_arena_free(&ar2);
    cc_arena_free(&arena);
    printf("ok schema float + as_f64\n");
    return 0;
}

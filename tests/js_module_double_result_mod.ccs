/* Node-API addon over one GamutCounter state.  Exercises scalar marshal both
 * directions, a string return, a parameter default bound positionally and
 * by trailing-object keyword, BigInt in and out across 2^53, underscore
 * privacy, and fallible methods crossing as the error class their kind
 * maps to — including a `double !>(CCError)` method, pinning the
 * predeclared-Result collision the Python twin pins. */
#include <ccc/script/js.cch>

typedef struct GamutCounter { long long n; } GamutCounter;

static long long GamutCounter_bump(GamutCounter *self, long long by = 1) {
    self->n += by;
    return self->n;
}
static long long GamutCounter_total(GamutCounter *self) {
    return self->n;
}
static double GamutCounter_scale(GamutCounter *self, double k) {
    return (double)self->n * k;
}
static const char *GamutCounter_label(GamutCounter *self) {
    return "counter";
}
static long long GamutCounter_big(GamutCounter *self) {
    return 1LL << 60;
}
/* Unsigned 64 inbound must use napi_get_value_bigint_uint64 so values in
 * [2^63, 2^64-1] round-trip (the signed BigInt extract refuses them). */
static unsigned long long GamutCounter_echo_u64(GamutCounter *self,
                                               unsigned long long v) {
    (void)self;
    return v;
}
static long long GamutCounter__clamp(GamutCounter *self, long long v) {
    return v > 1000 ? 1000 : v;
}
static long long !>(CCError) GamutCounter_bump_checked(GamutCounter *self, long long by) {
    if (by <= 0) return cc_err(CC_ERR_INVALID_ARG, "bump must be positive");
    self->n = GamutCounter__clamp(self, self->n + by);
    return cc_ok(self->n);
}
static double !>(CCError) GamutCounter_half(GamutCounter *self, double x) {
    if (x < 0) return cc_err(CC_ERR_INVALID_ARG, "x must be non-negative");
    return cc_ok(x / 2.0);
}
/* A matching Float64Array borrows zero-copy; an Array or a Float32Array
 * converts per element — same sum either way. */
static double GamutCounter_sum(GamutCounter *self, double[:] xs) {
    double acc = 0;
    for (size_t i = 0; i < xs.base.len; i++) acc += ((double *)xs.base.ptr)[i];
    return acc;
}
/* The borrow is writable: writes land in the caller's TypedArray. */
static void GamutCounter_fill(GamutCounter *self, double[:] xs, double v) {
    for (size_t i = 0; i < xs.base.len; i++) ((double *)xs.base.ptr)[i] = v;
}
/* A typed-slice return materializes as a fresh Float64Array. */
static double[:] GamutCounter_row(GamutCounter *self) {
    static double v[3] = { 1.5, 2.5, 3.0 };
    return CCSlice_double_from_buffer(v, 3);
}

/* Outbound: JS hands CC an object; CC calls back through it natively —
 * the dynamic sink, with the declared destination joining resolution. */
static long long !>(CCError) GamutCounter_apply(GamutCounter *self, CCJsVal obj) {
    @errhandler(CCError e) { return cc_err(e); }
    long long v = obj.step(21) !>;
    return cc_ok(v);
}
/* Keyword-bag escape: a trailing plain object stays positional when it is
 * not a kwargs bag (keys outside the formals), and `js_pos` / the
 * `__cc_js_pos__` brand forces positional even when keys look like
 * kwargs.  Optional `n` keeps the bind path (argc != want) in play. */
static long long !>(CCError) GamutCounter_peek_opts(GamutCounter *self,
                                                    CCJsVal opts,
                                                    long long n = 0) {
    @errhandler(CCError e) { return cc_err(e); }
    (void)self;
    long long x = opts.get("x")!>.as_i64()!>;
    return cc_ok(x + n);
}
/* The environment of the call in flight: source text as bootstrap glue. */
static long long !>(CCError) GamutCounter_eval42(GamutCounter *self, CCJs *js) {
    @errhandler(CCError e) { return cc_err(e); }
    long long v = js->eval("6 * 7") !>;
    return cc_ok(v);
}
/* The chain form still works: plain eval yields a value, hops extract. */
static long long !>(CCError) GamutCounter_eval_chain(GamutCounter *self, CCJs *js) {
    @errhandler(CCError e) { return cc_err(e); }
    long long v = js->eval("6 * 6")!>.as_i64()!>;
    return cc_ok(v);
}
/* Typed eval: the scalar form without the extraction hop. */
static long long !>(CCError) GamutCounter_eval_typed(GamutCounter *self, CCJs *js) {
    @errhandler(CCError e) { return cc_err(e); }
    long long v = js->eval_i64("40 + 2") !>;
    return cc_ok(v);
}
/* Hop chains, pydemo-shape: properties link, the end extracts — by the
 * declared destination (a sink call), or by an as_* hop. */
static long long !>(CCError) GamutCounter_chain_floor(GamutCounter *self, CCJs *js) {
    @errhandler(CCError e) { return cc_err(e); }
    long long v = js->global()!>.get("Math")!>.floor(3.7) !>;
    return cc_ok(v);
}
static double !>(CCError) GamutCounter_chain_pi(GamutCounter *self, CCJs *js) {
    @errhandler(CCError e) { return cc_err(e); }
    double v = js->global()!>.get("Math")!>.get("PI")!>.as_f64()!>;
    return cc_ok(v);
}
static long long !>(CCError) GamutCounter_chain_pid(GamutCounter *self, CCJs *js) {
    @errhandler(CCError e) { return cc_err(e); }
    long long v = js->global()!>.get("process")!>.get("pid")!>.as_i64()!>;
    return cc_ok(v);
}
/* globalThis, property-called like any other value. */
static long long !>(CCError) GamutCounter_gparse(GamutCounter *self, CCJs *js) {
    @errhandler(CCError e) { return cc_err(e); }
    CCJsVal g = js->global() !> @destroy;
    long long v = g.parseInt("42") !>;
    return cc_ok(v);
}

/* Bulk rows: one crossing calls the JS callable once per row over typed
 * columns (mixed element types on purpose); the typed results sum here. */
static double !>(CCError) GamutCounter_rowmap(GamutCounter *self, CCJsVal f,
                                         double[:] xs, int64_t[:] ks) {
    @errhandler(CCError e) { return cc_err(e); }
    CCArena a = cc_arena_heap(megabytes(1)) @destroy;
    /* The destination names the element type — no spelled formal. */
    double[:] ys = f.map(&a, xs, ks) !>;
    double s = 0;
    for (size_t i = 0; i < ys.base.len; i++)
        s += ((const double *)ys.base.ptr)[i];
    return cc_ok(s);
}

/* The seed is the module's initial state, copied in at registration;
 * `js_module::[GamutCounter]` names the artifact — gamut_counter.node. */
static const GamutCounter seed = { .n = 100 };

void *napi_register_module_v1(CCJsEnv env, CCJsExports exports) {
    return js_module::[GamutCounter](env, exports, &seed);
}

/* Owner `.ccs` is the stem prefix (`quote_cch_chapter_owner_mod.ccs` owns
 * `quote_cch_chapter_owner_mod_leaf.cch`). Other TUs extract decls. */
CCArena a = cc_arena_heap(megabytes(1)) @destroy;

CCCommand emit_other = cc_command(a, @slice("./cc/bin/ccc"));
emit_other.arg("--no-cache");
emit_other.arg("--emit-c-only");
emit_other.arg("tests/quote_cch_chapter_owner_other_mod.ccs");
emit_other.arg("-o");
emit_other.arg("out/quote_cch_chapter_owner_other.c");
emit_other.inherit_stdio();
int rc = emit_other.status() !>;
if (rc != 0) {
    "emit other failed".println();
    return 1;
}

CCCommand grep_other = cc_command(a, @slice("grep"));
grep_other.arg("-q");
grep_other.arg("CHAPTER_OWNER_LEAF_BODY_MUST_NOT_SPLICE");
grep_other.arg("out/quote_cch_chapter_owner_other.c");
rc = grep_other.status() !>;
if (rc == 0) {
    "other TU spliced chapter leaf".println();
    return 1;
}

CCCommand emit_owner = cc_command(a, @slice("./cc/bin/ccc"));
emit_owner.arg("--no-cache");
emit_owner.arg("--emit-c-only");
emit_owner.arg("tests/quote_cch_chapter_owner_mod.ccs");
emit_owner.arg("-o");
emit_owner.arg("out/quote_cch_chapter_owner.c");
emit_owner.inherit_stdio();
rc = emit_owner.status() !>;
if (rc != 0) {
    "emit owner failed".println();
    return 1;
}

CCCommand grep_owner = cc_command(a, @slice("grep"));
grep_owner.arg("-q");
grep_owner.arg("CHAPTER_OWNER_LEAF_BODY_MUST_NOT_SPLICE");
grep_owner.arg("out/quote_cch_chapter_owner.c");
rc = grep_owner.status() !>;
if (rc != 0) {
    "owner TU did not splice chapter leaf".println();
    return 1;
}

CCCommand build = cc_command(a, @slice("./cc/bin/ccc"));
build.arg("build");
build.arg("--no-cache");
build.arg("tests/quote_cch_chapter_owner_other_mod.ccs");
build.arg("tests/quote_cch_chapter_owner_mod.ccs");
build.arg("-o");
build.arg("out/quote_cch_chapter_owner_smoke");
build.inherit_stdio();
rc = build.status() !>;
if (rc != 0) {
    "build failed".println();
    return 1;
}
CCCommand run = cc_command(a, @slice("out/quote_cch_chapter_owner_smoke"));
run.inherit_stdio();
rc = run.status() !>;
if (rc != 0) {
    "run failed".println();
    return 1;
}
return 0;

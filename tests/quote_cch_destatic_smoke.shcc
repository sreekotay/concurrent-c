/* Extracted module face omits static fns and static data; exported
 * destatic_pub is a prototype and exported data is `extern`. No unit
 * splices the bodies: they lower into the module object every includer
 * links. */
CCArena arena = cc_arena_heap(megabytes(1)) @destroy;
int rc = 0;

CCCommand emit_other = cc_command(arena, @slice("./cc/bin/ccc"));
emit_other.arg("--no-cache");
emit_other.arg("--emit-c-only");
emit_other.arg("tests/quote_cch_destatic_other_mod.ccs");
emit_other.arg("-o");
emit_other.arg("out/quote_cch_destatic_other.c");
emit_other.inherit_stdio();
rc = emit_other.status() !>;
if (rc != 0) {
    "emit other failed".println();
    return 1;
}
CCCommand grep_h_static = cc_command(arena, @slice("grep"));
grep_h_static.arg("-q");
grep_h_static.arg("static int destatic_hid");
grep_h_static.arg("out/include/tests/quote_cch_destatic_mod.h");
rc = grep_h_static.status() !>;
if (rc == 0) {
    "extracted .h kept destatic_hid".println();
    return 1;
}
CCCommand grep_h_hid = cc_command(arena, @slice("grep"));
grep_h_hid.arg("-q");
grep_h_hid.arg("destatic_hid");
grep_h_hid.arg("out/include/tests/quote_cch_destatic_mod.h");
rc = grep_h_hid.status() !>;
if (rc == 0) {
    "extracted .h still names destatic_hid".println();
    return 1;
}
CCCommand grep_h_pub = cc_command(arena, @slice("grep"));
grep_h_pub.arg("-q");
grep_h_pub.arg("int destatic_pub");
grep_h_pub.arg("out/include/tests/quote_cch_destatic_mod.h");
rc = grep_h_pub.status() !>;
if (rc != 0) {
    "extracted .h missing destatic_pub decl".println();
    return 1;
}
CCCommand grep_h_cell = cc_command(arena, @slice("grep"));
grep_h_cell.arg("-q");
grep_h_cell.arg("destatic_cell");
grep_h_cell.arg("out/include/tests/quote_cch_destatic_mod.h");
rc = grep_h_cell.status() !>;
if (rc == 0) {
    "extracted .h names module-private destatic_cell".println();
    return 1;
}
CCCommand grep_h_table = cc_command(arena, @slice("grep"));
grep_h_table.arg("-q");
grep_h_table.arg("extern int destatic_table");
grep_h_table.arg("out/include/tests/quote_cch_destatic_mod.h");
rc = grep_h_table.status() !>;
if (rc != 0) {
    "extracted .h missing extern destatic_table".println();
    return 1;
}
CCCommand grep_h_table_init = cc_command(arena, @slice("grep"));
grep_h_table_init.arg("-q");
grep_h_table_init.arg("destatic_table\\[\\] =");
grep_h_table_init.arg("out/include/tests/quote_cch_destatic_mod.h");
rc = grep_h_table_init.status() !>;
if (rc == 0) {
    "extracted .h kept destatic_table initializer".println();
    return 1;
}
CCCommand grep_other_body = cc_command(arena, @slice("grep"));
grep_other_body.arg("-q");
grep_other_body.arg("DESTATIC_HID_BODY");
grep_other_body.arg("out/quote_cch_destatic_other.c");
rc = grep_other_body.status() !>;
if (rc == 0) {
    "other TU spliced destatic_hid body".println();
    return 1;
}
CCCommand grep_other_pub = cc_command(arena, @slice("grep"));
grep_other_pub.arg("-q");
grep_other_pub.arg("DESTATIC_PUB_BODY");
grep_other_pub.arg("out/quote_cch_destatic_other.c");
rc = grep_other_pub.status() !>;
if (rc == 0) {
    "other TU spliced destatic_pub body".println();
    return 1;
}
CCCommand emit_owner = cc_command(arena, @slice("./cc/bin/ccc"));
emit_owner.arg("--no-cache");
emit_owner.arg("--emit-c-only");
emit_owner.arg("tests/quote_cch_destatic_mod.ccs");
emit_owner.arg("-o");
emit_owner.arg("out/quote_cch_destatic_mod.c");
emit_owner.inherit_stdio();
rc = emit_owner.status() !>;
if (rc != 0) {
    "emit same-stem unit failed".println();
    return 1;
}
CCCommand grep_owner_body = cc_command(arena, @slice("grep"));
grep_owner_body.arg("-q");
grep_owner_body.arg("DESTATIC_HID_BODY");
grep_owner_body.arg("out/quote_cch_destatic_mod.c");
rc = grep_owner_body.status() !>;
if (rc == 0) {
    "same-stem TU spliced destatic_hid body".println();
    return 1;
}
CCCommand build = cc_command(arena, @slice("./cc/bin/ccc"));
build.arg("build");
build.arg("--no-cache");
build.arg("tests/quote_cch_destatic_other_mod.ccs");
build.arg("tests/quote_cch_destatic_mod.ccs");
build.arg("-o");
build.arg("out/quote_cch_destatic_smoke");
build.inherit_stdio();
rc = build.status() !>;
if (rc != 0) {
    "build failed".println();
    return 1;
}
CCCommand run = cc_command(arena, @slice("out/quote_cch_destatic_smoke"));
run.inherit_stdio();
rc = run.status() !>;
if (rc != 0) {
    "run failed".println();
    return 1;
}
return 0;

/* @destroy { body } then outer hook then as: embeds (draft_as §3). */
#include <ccc/std/prelude.cch>
#include <assert.h>
#include <stdio.h>

static int g_seq[8];
static int g_n;

static void seq(int step) {
    if (g_n < 8) g_seq[g_n++] = step;
}

typedef struct {
    int n;
} Inner;

static void inner_dtor(Inner* i) {
    (void)i;
    seq(3);
}

typedef struct {
    Inner inner;
} Outer;

static void outer_dtor(Outer* o) {
    (void)o;
    seq(2);
}

@typeview on Outer {
    as: inner;
};

@typehooks on Inner {
    .destroy = inner_dtor,
};

@typehooks on Outer {
    .destroy = outer_dtor,
};

int main(void) {
    {
        Outer o = {0} @destroy { seq(1); };
        assert(o.inner.n == 0);
    }
    assert(g_n == 3);
    assert(g_seq[0] == 1);
    assert(g_seq[1] == 2);
    assert(g_seq[2] == 3);

    g_n = 0;
    {
        Outer o = {0} @destroy;
        assert(o.inner.n == 0);
    }
    assert(g_n == 2);
    assert(g_seq[0] == 2);
    assert(g_seq[1] == 3);

    printf("ok\n");
    return 0;
}

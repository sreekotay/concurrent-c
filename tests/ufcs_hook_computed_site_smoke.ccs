/* A `.ufcs` handler that decides from the call site, not from a table.
 *
 * The callee depends on the arguments, so no reading of the handler's body
 * can name it: `pick(2)`, `pick("abcd")` and `pick(3, 5)` are three
 * different functions. The handler is compiled and run instead, once, with
 * each site's arguments and their types.
 *
 * The two answers that are not a callee are here too: `cc_ufcs_pass()`
 * leaves the method to ordinary resolution (`pick_toy_plain` below), and a
 * handler that names something undeclared is a diagnostic at the site,
 * never a call the host is left to explain. */
#include <ccc/std/prelude.cch>
#include <ccc/cc_ufcs.cch>
#include <ccc/cc_type.cch>
#include <stdio.h>
#include <string.h>

typedef struct {
    int n;
} PickToy;

static void pick_toy_one_int(PickToy* p, int v) {
    p->n += v;
}

static void pick_toy_one_text(PickToy* p, const char* t) {
    p->n += (int)strlen(t);
}

static void pick_toy_two(PickToy* p, int a, int b) {
    p->n += a * b;
}

static void pick_toy_plain(PickToy* p) {
    p->n += 100;
}

static CCSlice pick_toy_ufcs(CCSlice recv_type, CCSlice method, CCSlice mode,
                             CCSliceArray argv, CCSliceArray arg_types, CCArena arena) {
    (void)recv_type;
    (void)mode;
    (void)argv;
    (void)arena;
    if (!CCSlice_eq_cstr(&method, "pick")) {
        return cc_ufcs_pass();
    }
    if (arg_types.len == 2) {
        return cc_slice_from_buffer((void*)"pick_toy_two", sizeof("pick_toy_two") - 1);
    }
    if (arg_types.len != 1) {
        return cc_slice_empty();
    }
    if (CCSlice_eq_cstr(&arg_types.items[0], "const char*")) {
        return cc_slice_from_buffer((void*)"pick_toy_one_text", sizeof("pick_toy_one_text") - 1);
    }
    return cc_slice_from_buffer((void*)"pick_toy_one_int", sizeof("pick_toy_one_int") - 1);
}

@typehooks on PickToy {
    .ufcs = pick_toy_ufcs,
};

int main(void) {
    PickToy p = { 0 };
    p.pick(2);
    p.pick("abcd");
    p.pick(3, 5);
    p.plain();
    if (p.n != 2 + 4 + 15 + 100) {
        printf("n=%d\n", p.n);
        return 1;
    }
    printf("ufcs_hook_computed_site_smoke: PASS\n");
    return 0;
}

/* Owned impl-grade face: guest extract must keep `static inline` bodies. */
CCArena a = cc_arena_heap(megabytes(1)) @destroy;

CCCommand emit_guest = cc_command(a, @slice("./cc/bin/ccc"));
emit_guest.arg("--no-cache");
emit_guest.arg("--emit-c-only");
emit_guest.arg("tests/static_inline_impl_extract_guest.ccs");
emit_guest.arg("-o");
emit_guest.arg("out/static_inline_impl_extract_guest.c");
emit_guest.inherit_stdio();
int rc = emit_guest.status() !>;
if (rc != 0) {
    "emit guest failed".println() !>;
    return 1;
}

CCCommand grep_hdr = cc_command(a, @slice("grep"));
grep_hdr.arg("-q");
grep_hdr.arg("STATIC_INLINE_IMPL_BODY_MUST_STAY");
grep_hdr.arg("out/include/tests/static_inline_impl_extract.h");
rc = grep_hdr.status() !>;
if (rc != 0) {
    "guest extract dropped static inline body".println() !>;
    return 1;
}

CCCommand build = cc_command(a, @slice("./cc/bin/ccc"));
build.arg("build");
build.arg("--no-cache");
build.arg("tests/static_inline_impl_extract_guest.ccs");
build.arg("tests/static_inline_impl_extract.ccs");
build.arg("-o");
build.arg("out/static_inline_impl_extract_smoke");
build.inherit_stdio();
rc = build.status() !>;
if (rc != 0) {
    "build failed".println() !>;
    return 1;
}
CCCommand run = cc_command(a, @slice("out/static_inline_impl_extract_smoke"));
run.inherit_stdio();
rc = run.status() !>;
if (rc != 0) {
    "run failed".println() !>;
    return 1;
}
return 0;

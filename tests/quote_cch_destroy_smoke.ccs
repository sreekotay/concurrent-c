/* Quoted local `.cch` with `create_buffer(...) @destroy` — pins statement
 * `@destroy` on a helper inside a quoted header. The header is a member of
 * this program module (spec 1.7): its text splices into the program. */
#pragma(@module) "destroy_smoke"
#include <ccc/std/prelude.cch>
#include <assert.h>
#include <stdio.h>
#include "quote_cch_destroy_smoke.cch"

int main(void) {
    assert(quote_cch_scratch_sum(40, 2) == 42);
    printf("ok\n");
    return 0;
}

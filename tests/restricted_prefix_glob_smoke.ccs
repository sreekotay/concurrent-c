/* Leading-* name globs: `*_len` matches a name that ends with `_len`. */
#include <ccc/std/prelude.cch>
#include <stdio.h>
#include <string.h>

typedef struct Conn {
    int sock;
    int out_len;
} Conn;

@typeview Encode on Conn {
    r: *_len;
}

static int use_enc(@typeview(Encode) Conn* enc) {
    return enc->out_len;
}

int main(void) {
    Conn c;
    memset(&c, 0, sizeof(c));
    c.out_len = 3;
    if (use_enc(&c) != 3) return 1;
    printf("ok\n");
    return 0;
}

/* A comment is inert at every position in a declaration: inside a result
 * signature, between a declarator and its parameter list, before a body's
 * brace, inside declaration specifiers, and inside a type-argument list.
 * Each case below is a fuzzer finding, pinned. */
#include <ccc/std/prelude.cch>
#include <stdio.h>
#include <string.h>

/* Every gap in `T !>(E) name(params) {` takes a comment. */
static int !>/*x*/(CCError) s1(int d) { return cc_ok(d); }
static int !> (/*x*/CCError) s2(int d) { return cc_ok(d); }
static int !> (CCError/*x*/) s3(int d) { return cc_ok(d); }
static int !> (CCError)/*x*/s4(int d) { return cc_ok(d); }
static int !> (CCError) s5/*x*/(int d) { return cc_ok(d); }
static int !> (CCError) s6(int d)/*x*/{ return cc_ok(d); }

static size_t mylen(const char* s) { return strlen(s); }

/* A comment before the body brace must not hide the function from the
 * closure-declaration insertion point.  The handler is written out: this is
 * a `.ccs` function, so spec 9.5 injects none, and a bare `!>;` with no
 * matching `@errhandler` in scope is ill-formed under spec 3.1 invariant 4
 * whatever the callee is spelled like. */
static void emit_closure(CCNursery nur, int base) /*x*/{
    @errhandler(CCError e) cc_error_exit(e);
    nur.spawn(() => [base] { printf("closure=%d\n", base); }) !>;
}

int main(void) {
    /* The handler's own brace, and its parameter declaration. */
    @errhandler(/*x*/CCError e)/*x*/ { fprintf(stderr, "eh: %s\n", e.message); return 1; }

    CCArena a = cc_arena_heap(megabytes(1)) @destroy;

    int sum = 0;
    sum += s1(1) !>;
    sum += s2(2) !>;
    sum += s3(4) !>;
    sum += s4(8) !>;
    sum += s5(16) !>;
    sum += s6(32) !>;
    printf("sum=%d\n", sum);

    /* Declaration specifiers: the receiver type must still be recorded, or
     * the UFCS tiers cannot resolve `mylen` on a `const char*`.  The method
     * is declared in this unit on purpose: whether the bare tier also reaches
     * a name that only a system header declares (`s.strlen()`) is the open
     * question `cc/lower/INDEX_GAPS.md` records under "C library names", and
     * `ufcs_bare_system_fn_smoke` is the row that asks it.  Pinning it here
     * too would make a comment-inertness row fail for that reason instead. */
    const /*x*/char* p1 = "aa";
    const char /*x*/* p2 = "bbb";
    const char* /*x*/p3 = "cccc";
    unsigned /*x*/int n = 7;
    int /*x*/m = 8;
    printf("lens=%zu%zu%zu n=%u m=%d\n", p1.mylen(), p2.mylen(), p3.mylen(), n, m);

    /* Type arguments: a comment must not reach the mangled instance name. */
    Vec::[int/*x*/] v = vec_new::[int](a);
    v.push(3);
    printf("v=%d\n", *v.get(0));

    CCNursery nur = cc_nursery_create() !> @destroy;
    emit_closure(nur, 5);
    nur.wait() !>;
    return 0;
}

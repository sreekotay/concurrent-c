#include <ccc/cc_nursery.cch>
// Smoke: closure literal spawn inside nursery should lower to CCClosure0 + cc_nursery_spawn_closure0.

int g = 0;

int main(void) {
    @errhandler(CCError e) cc_error_exit(e);
    int v = 7;
    {
        CCNursery __cc_nursery53 = @create() !> @destroy;

        __cc_nursery53.spawn (() => [v] { g = v; }) !>;
    
    }
    if (g != 7) return 1;
    return 0;
}


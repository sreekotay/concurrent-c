// Field-discriminated `one of ... by <int>`: shared prefix, then arms
// selected by a bound int (EQ / GE). Write derives the discriminant from
// the arm tag (EQ imm / GE payload.len) — stored len is ignored.
// Construction and projection use the protected @variant surface.
#include <ccc/std/prelude.cch>

@grammar(schema) Bulk {~~~~
    rules [
        digit:  charset [#'0' - #'9']
        number: keep [opt #'-' some digit]
    ]
    #'$' len: int number
    one of [
        nil  [= -1] [ "\r\n" ]
        data [>= 0] [ "\r\n" payload: bytes len "\r\n" ]
    ] by len
~~~~}

@grammar(schema) BulkArray {~~~~
    rules [
        digit:  charset [#'0' - #'9']
        number: keep [opt #'-' some digit]
    ]
    #'*' n: int number "\r\n"
    elems: items Bulk n
~~~~}

static int bytes_are(const char* got, size_t n, const char* want) {
    return n == strlen(want) && memcmp(got, want, n) == 0;
}

int main(void) {
    CCArena arena = cc_arena_create(1 << 20);
    char buf[256];
    size_t w;

    /* write nil / data */
    {
        Bulk b = { .nil = {} };
        b.len = 999;   /* lie: write emits -1 from the arm */
        w = Bulk_write(&b, buf, sizeof buf);
        if (!bytes_are(buf, w, "$-1\r\n")) { printf("FAIL: write nil\n"); return 1; }

        b = (Bulk){ .data = { .payload = cc_slice_hdr_from_buffer((void*)"hi", 2) } };
        b.len = 999;
        w = Bulk_write(&b, buf, sizeof buf);
        if (!bytes_are(buf, w, "$2\r\nhi\r\n")) { printf("FAIL: write data\n"); return 1; }
    }

    /* parse nil / data */
    {
        Bulk b;
        if (!Bulk_parse("$-1\r\n", 5, arena, &b) || b.kind != Bulk_nil || b.len != -1) {
            printf("FAIL: parse nil\n"); return 1;
        }
        if (!Bulk_parse("$2\r\nhi\r\n", 8, arena, &b) || b.kind != Bulk_data ||
            b.len != 2) {
            printf("FAIL: parse data\n"); return 1;
        }
        if (b.kind == Bulk_data) {
            if (b.data.payload.len != 2 || memcmp(b.data.payload.ptr, "hi", 2) != 0) {
                printf("FAIL: parse data payload\n"); return 1;
            }
        }
        if (Bulk_parse("$-2\r\n", 5, arena, &b)) {
            printf("FAIL: parse other negative should reject\n"); return 1;
        }
    }

    /* array of bulk-or-nil */
    {
        Bulk elems[3] = {
            (Bulk){ .data = { .payload = cc_slice_hdr_from_buffer((void*)"a", 1) } },
            (Bulk){ .nil = {} },
            (Bulk){ .data = { .payload = cc_slice_hdr_from_buffer((void*)"bc", 2) } },
        };

        BulkArray arr;
        memset(&arr, 0, sizeof arr);
        arr.n = 99;
        arr.elems = elems;
        arr.elems_n = 3;
        w = BulkArray_write(&arr, buf, sizeof buf);
        if (!bytes_are(buf, w, "*3\r\n$1\r\na\r\n$-1\r\n$2\r\nbc\r\n")) {
            printf("FAIL: write array\n"); return 1;
        }
    }

    printf("ok\n");
    return 0;
}

#include <ccc/std/prelude.cch>
#include <stdio.h>

int main(void) {
    @errhandler(CCError e) cc_error_exit(e);
    int[~4 >] tx;
    int[~4 ordered <] rx;
    CCChan* ch = cc_channel_pair(&tx, &rx);
    int ok = 1;

    {
        CCNursery __cc_nursery23 = @create() !> @destroy;

        {
            CCNursery __cc_nursery24 = @create() !> @destroy;
            (void)__cc_nursery24.close_on(tx);

            CCNursery producer = cc_nursery_create() !> @destroy;
            producer.spawn(() => [tx] {
                int value = 2;
                tx.send_task(() => [value] {
                    value * 3;
                });
                return NULL;
            });
            (void)producer;
        
        }
    
    }

    cc_chan_free(ch);
    if (!ok) {
        printf("channel_send_task_ufcs_capture_smoke: FAIL\n");
        return 1;
    }
    printf("channel_send_task_ufcs_capture_smoke: PASS\n");
    return 0;
}

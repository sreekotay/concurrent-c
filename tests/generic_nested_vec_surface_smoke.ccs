#include <ccc/std/prelude.cch>
#include <stdio.h>

/* Nested surface `Vec::[T]` inside `Map::[K, V]` must canonicalize to
 * `CCVec_T` (same instance as top-level `Vec::[T]`) and emit `CC_VEC_DECL`
 * before the map DECL. */
int main(void) {
    CCArena a = cc_arena_heap(kilobytes(64)) @destroy;
    Map::[int, Vec::[int]] m = map_new::[int, Vec::[int]](a);
    Vec::[int] inner = vec_new::[int](a);
    inner.push(9);
    m->insert(1, inner);
    Vec::[int] *got = m->get_ptr(1);
    if (!got || got->len() != 1 || *got->get(0) != 9) return 1;
    printf("generic_nested_vec_surface_smoke ok\n");
    return 0;
}

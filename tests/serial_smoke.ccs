#include <ccc/std/prelude.cch>
#include <stdint.h>
#include <stdio.h>

#define U24_MASK 0xFFFFFFu
#define DEPTH 6

static uint32_t u24(uint32_t x) {
    return x & U24_MASK;
}

static uint32_t sum_seq(uint32_t d, uint32_t i) {
    if (d >= DEPTH)
        return i;
    return u24(sum_seq(d + 1, u24(i * 2)) + sum_seq(d + 1, u24(i * 2 + 1)));
}

static uint32_t sum_par(uint32_t d, uint32_t i) {
    if (d >= DEPTH)
        return i;
    uint32_t left = 0;
    uint32_t right = 0;
    @parallel {
        @serial {
            uint32_t t = u24(i * 2);
            left = sum_par(d + 1, t);
        }
        right = sum_par(d + 1, u24(i * 2 + 1));
    }
    return u24(left + right);
}

static uint32_t sum_both(uint32_t d, uint32_t i) {
    if (d >= DEPTH)
        return i;
    uint32_t left = 0;
    uint32_t right = 0;
    @parallel {
        @serial {
            uint32_t t = u24(i * 2);
            left = sum_both(d + 1, t);
        }
        @serial {
            uint32_t t = u24(i * 2 + 1);
            right = sum_both(d + 1, t);
        }
    }
    return u24(left + right);
}

static int mix_assign_first(int x) {
    int a = 0;
    int b = 0;
    @parallel {
        a = x + 1;
        @serial {
            int t = x + 2;
            b = t;
        }
    }
    return a + b;
}

static int serial_if(int c) {
    int a = 0;
    int b = 0;
    @parallel {
        @serial {
            if (c)
                a = 10;
            else
                a = 11;
        }
        b = 20;
    }
    return a + b;
}

static int serial_for(void) {
    int a = 0;
    int b = 0;
    @parallel {
        @serial {
            int i;
            int s = 0;
            for (i = 0; i < 4; i++)
                s += i;
            a = s;
        }
        b = 1;
    }
    return a + b;
}

int main(void) {
    uint32_t want = sum_seq(0, 0);
    uint32_t got = sum_par(0, 0);
    if (got != want) {
        printf("mix mismatch want=%u got=%u\n", want, got);
        return 1;
    }
    got = sum_both(0, 0);
    if (got != want) {
        printf("both mismatch want=%u got=%u\n", want, got);
        return 1;
    }
    if (mix_assign_first(10) != 23) {
        printf("assign-first mismatch\n");
        return 1;
    }
    if (serial_if(1) != 30 || serial_if(0) != 31) {
        printf("serial-if mismatch\n");
        return 1;
    }
    if (serial_for() != 7) {
        printf("serial-for mismatch\n");
        return 1;
    }
    printf("ok\n");
    return 0;
}

/* Sequential for (i in lo..hi); hi < lo is empty. */
#include <ccc/std/prelude.cch>
#include <stdio.h>

int main(void) {
    int sum = 0;
    int empty = 0;
    for (i in 0..4)
        sum += (int)i;
    if (sum != 6) return 1;
    for (i in 4..1)
        empty++;
    if (empty != 0) return 2;
    printf("ok\n");
    return 0;
}

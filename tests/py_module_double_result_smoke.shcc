/* A module method returning `double !>(CCError)` must build, and the
 * double[:] buffer surface (param borrow + return materialize) must work
 * for the Python target — same contract as the JS twin. */
CCArena a = cc_arena_heap(megabytes(1)) @destroy;

{
    CCCommand which = cc_command(a, @slice("sh"));
    which.arg("-c");
    which.arg("command -v python3 >/dev/null 2>&1");
    int rc = which.status() !>;
    if (rc != 0) { "SKIP (no python3)".println() !>; return 0; }
}

/* No staging: `PyInit_halver` names the artifact, so building the
 * fixture where it lives produces bin/halver.abi3.so. */
{
    CCCommand build = cc_command(a, @slice("./cc/bin/ccc"));
    build.arg("build");
    build.arg("tests/py_module_double_result_mod.ccs");
    build.inherit_stdio();
    int rc = build.status() !>;
    if (rc != 0) { "build failed".println() !>; return 1; }
}

{
    CCCommand run = cc_command(a, @slice("sh"));
    run.arg("-c");
    CCString py = @string(`PYTHONPATH=bin python3 -c "
import array
import halver
print('twice', halver.twice(21))
print('half', halver.half(5.0))
try:
    halver.half(-1.0)
except ValueError as e:
    print('raised:', e)
xs = array.array('d', [1, 2, 3.5])
print('sum_array', halver.sum(xs))
print('sum_list', halver.sum([1, 2, 3.5]))
halver.fill(xs, 9.0)
print('filled', xs[0], xs[1], xs[2])
row = halver.row()
print('row', type(row).__name__, list(row))
print('roundtrip', halver.sum(row))
try:
    halver.sum(['x'])
except TypeError as e:
    print('badelem:', e)
"`, a);
    run.arg(py.cstr(a));
    run.inherit_stdio();
    int rc = run.status() !>;
    if (rc != 0) { "import failed".println() !>; return 1; }
}
return 0;

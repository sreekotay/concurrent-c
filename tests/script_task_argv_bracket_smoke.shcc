#!/usr/bin/env -S ./cc/bin/ccc
/*
 * Smoke: @task accepts the textbook char *argv[] spelling.
 */

/**
 * @task Echo argv[1] or hi
 */
static int greet(int argc, char *argv[]) {
    const char *msg = (argc >= 2 && argv[1]) ? argv[1] : "hi";
    msg.println() !>;
    return 0;
}

"script_task_argv_bracket_smoke: use @greet".println() !>;
return 2;

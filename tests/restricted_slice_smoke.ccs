/* Slice family unnamed facet: loads + UFCS + first-arg writes. */
#include <ccc/std/prelude.cch>
#include <stdio.h>

static size_t bump_len(CCSlice* s) {
    /* First param → trusted body may store. */
    s->len++;
    return s->len;
}

static size_t read_len(int n, CCSlice* s) {
    (void)n;
    return s->len; /* load OK */
}

int main(void) {
    char buf[8] = "abcdefg";
    char[:] s = cc_slice_from_buffer(buf, 7);
    size_t n = s.len;
    if (n != 7) return 1;
    if (s.is_empty()) return 1;
    if (bump_len(&s) != n + 1) return 1;
    if (read_len(0, &s) != n + 1) return 1;
    printf("ok\n");
    return 0;
}

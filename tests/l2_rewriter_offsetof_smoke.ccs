/* Pins idiom #1 of the L2 prelude rewriter:
 *
 *     standard C `offsetof(T, F)` should compile in CC user code.
 *
 * Pre-rewriter, this test would fail to compile with TCC's stub-AST
 * parser rejecting `offsetof(...)` ("lvalue expected") because TCC's
 * expression parser only wires up `__builtin_offsetof`, not the libc
 * macro from <stddef.h>.  cc_l2_rewriter.c rewrites every `offsetof(`
 * occurrence in non-inert positions (i.e. outside strings / comments
 * / PP-directive bodies) to `__builtin_offsetof(` before handing the
 * buffer to TCC.
 *
 * The test deliberately spreads the call across multiple usages to
 * verify the rewriter handles them all, and includes a comment + a
 * string both containing the literal text "offsetof" to verify the
 * inert-region skip works.  If either of those got rewritten the
 * compiled C would still build (since `__builtin_offsetof` in a
 * comment or string is harmless text) but the negative-control
 * intent is: keep the smoke close to user-realistic conditions and
 * exercise the inert-skip path.
 *
 * Tests both the bare `offsetof` form and the call form inside
 * various expression contexts (assignment, return, function arg). */

#include <stddef.h>
#include <stdio.h>

typedef struct {
    int   a;
    int   b;
    char  c;
    double d;
} Point;

/* offsetof in a comment — must NOT be rewritten */
/* The literal word offsetof appears here for inert-skip coverage. */

static size_t off_of_b(void) {
    return offsetof(Point, b);
}

static int use_off(size_t off) {
    return (int)off;
}

int main(void) {
    /* Bare usage in declaration initializer */
    size_t off_a = offsetof(Point, a);
    size_t off_b = offsetof(Point, b);
    size_t off_c = offsetof(Point, c);
    size_t off_d = offsetof(Point, d);

    if (off_a != 0)                                 { printf("FAIL: off_a=%zu\n", off_a); return 1; }
    if (off_b != sizeof(int))                       { printf("FAIL: off_b=%zu\n", off_b); return 1; }
    if (off_c != 2 * sizeof(int))                   { printf("FAIL: off_c=%zu\n", off_c); return 1; }
    if (off_b != off_of_b())                        { printf("FAIL: off_b != off_of_b()\n"); return 1; }
    if (use_off(offsetof(Point, d)) != (int)off_d)  { printf("FAIL: use_off(offsetof(...))\n"); return 1; }

    /* String literal containing the word offsetof — must NOT be rewritten. */
    const char* doc = "uses offsetof(T, F) under the hood";
    (void)doc;

    printf("l2 rewriter offsetof: OK\n");
    return 0;
}

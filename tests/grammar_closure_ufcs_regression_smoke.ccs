// REGRESSION for three pipeline bugs surfaced by @grammar splices in a
// closure-bearing TU (the real_projects/redis integration):
//   1. closure forward-decl insertion must not split a multi-line function
//      signature (the splice's generated signatures wrap);
//   2. `*a = ...` deref must not be unwrap-rewritten just because SOME other
//      function has a Result-typed local named `a` (scope-aware rewrite);
//   3. UFCS on registered types BELOW the splice must lower even when the
//      node's physical line collides with a real logical line (the padding
//      block at the bottom makes max-logical exceed the site's physical
//      line, forcing the collision).
#include <ccc/std/prelude.cch>

@grammar(schema) RG {~~~~
    rules [
        digit:  charset [#'0' - #'9']
        number: keep [opt #'-' some digit]
    ]
    #'*' v: int number "\r\n"
~~~~}

static size_t !>(CCError) mk_seven(void) {
    return cc_ok((size_t)7);
}

/* bug 2: Result-typed local named `a` ... */
static size_t result_local_a(void) {
    @errhandler(CCError e) cc_error_exit(e);
    size_t !>(CCError) a = mk_seven();
    if (a.is_err()) return 0;
    return a.value();
}

/* ... must not capture this CCArena* parameter, also named `a` */
static bool arena_init(CCArena* a, size_t root) {
    *a = cc_arena_create(root);
    if (!a->valid()) return false;   /* bug 3: UFCS below the splice */
    return true;
}

int main(void) {
    @errhandler(CCError e) cc_error_exit(e);
    CCArena ar;
    if (!arena_init(&ar, 1 << 16)) { printf("FAIL: arena init\n"); return 1; }
    RG v;
    if (!RG_parse("*42\r\n", 5, &ar, &v) || v.v != 42) { printf("FAIL: parse\n"); return 1; }
    if (result_local_a() != 7) { printf("FAIL: result local\n"); return 1; }
    {
        /* bug 1: closures force the proto-insertion path */
        CCNursery n = cc_nursery_create() !>;
        int base = 5;
        n.spawn(() => [base] { (void)base; });
        cc_nursery_wait(n);
        cc_nursery_free(n);
    }
    ar.destroy();
    printf("grammar closure ufcs regression OK\n");
    return 0;
}

/* Padding: keeps max-logical-line past the physical position of the UFCS
 * sites above, so the logical/physical collision (bug 3) actually occurs.
 * The @grammar splice adds ~120 physical lines; this block adds more than
 * that many logical lines after the sites. */


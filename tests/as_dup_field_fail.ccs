/* Two direct as: fields of the same type — ill-formed at the struct. */
#include <ccc/std/prelude.cch>
#include <stdio.h>

typedef struct {
    CCFile a;
    CCFile b;
    int tag;
} AsDupFile;

@typeview on AsDupFile {
    as: a, b;
};

int main(void) {
    AsDupFile w = {0};
    (void)w;
    printf("unreachable\n");
    return 0;
}

/* CCPyStr.codepoints(arena) — Stable-ABI UCS4, no UTF-8 round-trip. */
#include <ccc/std/prelude.cch>
#include <ccc/script/py.cch>
#include <assert.h>
#include <stdio.h>

int main(void) {
    @errhandler(CCError e) {
        fprintf(stderr, "fatal: %s\n", e.message);
        return 1;
    }
    @errhandler(CCPyError e) {
        fprintf(stderr, "py: %s\n", e.base.message ? e.base.message : "?");
        return 1;
    }

    CCArena arena = cc_arena_heap(kilobytes(64)) @destroy;
    if (!arena.valid()) return 1;

    CCPy py = cc_py_new(false, arena) !> @destroy;
    CCPyObj s = py.eval(@slice("'héllo'")) !> @destroy;
    CCPyStr view;
    assert(cc__py_in_pystr(&view, s.o, "s") == 0);

    CCResult_CCSlice_uint32_t_CCError r = view.codepoints(arena);
    assert(r.is_ok());
    uint32_t[:] cps = r.value();
    assert(cps.len == 5);
    assert(cps.at(0) == (uint32_t)'h');
    assert(cps.at(1) == 0xE9u);
    assert(cps.at(4) == (uint32_t)'o');

    /* Empty. */
    {
        CCPyObj empty = py.eval(@slice("''")) !> @destroy;
        CCPyStr ev;
        assert(cc__py_in_pystr(&ev, empty.o, "e") == 0);
        CCResult_CCSlice_uint32_t_CCError er = ev.codepoints(arena);
        assert(er.is_ok());
        assert(er.value().base.len == 0);
    }

    /* Astral. */
    {
        CCPyObj astral = py.eval(@slice("'\U0001d54a'")) !> @destroy;
        CCPyStr av;
        assert(cc__py_in_pystr(&av, astral.o, "a") == 0);
        CCResult_CCSlice_uint32_t_CCError ar = av.codepoints(arena);
        assert(ar.is_ok());
        uint32_t[:] ac = ar.value();
        assert(ac.len == 1);
        assert(ac.at(0) == 0x1D54Au);
    }

    printf("ok\n");
    return 0;
}

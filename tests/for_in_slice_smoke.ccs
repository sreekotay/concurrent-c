/* Sequential @for (v in s) on char[:] and int[:]. */
#include <ccc/std/prelude.cch>
#include <stdio.h>

int main(void) {
    char buf[4] = { 'a', 'b', 'c', 0 };
    char[:] s = cc_slice_from_buffer(buf, 3);
    int[:] ys = { 1, 2, 3 };
    int n = 0;
    int sum = 0;

    @for (c in s) {
        if (c != 'a' && c != 'b' && c != 'c') return 1;
        n++;
    }
    if (n != 3) return 2;
    if (s.len != 3) return 3;

    @for (x in ys)
        sum += x;
    if (sum != 6) return 4;
    if (ys.len() != 3) return 5;

    printf("ok\n");
    return 0;
}

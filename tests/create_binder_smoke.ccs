#include <ccc/std/prelude.cch>
#include <assert.h>
#include <stdio.h>

int main(void) {
    {
        CCArena a@(1024) @destroy;
        if (!cc_arena_is_live(a)) return 1;
        char* p = cc_arena_alloc_T_count(char, a, 16);
        if (!p) return 2;
        p[0] = 'x';
        Vec::[char] out@(a) @destroy;
        out.push('a');
        out.push('b');
        if (out.len() != 2) return 3;
        if (out.get(0) == NULL || *out.get(0) != 'a') return 4;
    }
    printf("ok\n");
    return 0;
}

#include <ccc/cc_nursery.cch>
// Smoke: multiline closure body + capture-by-value (best-effort heuristic).

int g = 0;

int main(void) {
    @errhandler(CCError e) cc_error_exit(e);
    int x = 3;
    {
        CCNursery __cc_nursery34 = @create() !> @destroy;

        __cc_nursery34.spawn (() => {
            if (x == 3) {
                g = 9;
            }
        });
    
    }
    return (g == 9) ? 0 : 1;
}


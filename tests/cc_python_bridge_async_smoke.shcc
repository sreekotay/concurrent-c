/* Async mode for the cc-python bridge: calls return Promises and run on
 * the domain's executor lane (FIFO per domain, parallel across domains
 * under per-interpreter GILs); the event loop stays live during Python
 * work; teardown is revoke-then-drain with an awaitable destroy; the
 * typed-array lease spans the job.  Rungs live in
 * cc_python_bridge_async.js; the addon is npm/cc-python/src/cc_python.ccs
 * (own artifact name — sibling bridge smokes relink their own). */
CCArena a = cc_arena_heap(megabytes(1)) @destroy;

{
    CCCommand which = cc_command(a, @slice("sh"));
    which.arg("-c");
    which.arg("command -v node >/dev/null 2>&1 && command -v python3 >/dev/null 2>&1");
    int rc = which.status() !>;
    if (rc != 0) { "SKIP (need node + python3)".println(); return 0; }
}

{
    CCCommand build = cc_command(a, @slice("./cc/bin/ccc"));
    build.arg("build");
    build.arg("npm/cc-python/src/cc_python.ccs");
    build.arg("-o");
    build.arg("bin/cc_python_async.node");
    build.inherit_stdio();
    int rc = build.status() !>;
    if (rc != 0) { "build failed".println(); return 1; }
}

{
    CCCommand run = cc_command(a, @slice("sh"));
    run.arg("-c");
    run.arg("CC_PYTHON_ADDON=$PWD/bin/cc_python_async.node node --expose-gc tests/cc_python_bridge_async.js");
    run.inherit_stdio();
    int rc = run.status() !>;
    if (rc != 0) { "async suite failed".println(); return 1; }
}
return 0;

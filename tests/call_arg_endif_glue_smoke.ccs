/* Mid-arg `#if`/`#endif` must not emit `#endif)` — trailing trivia before
 * the closing `)` has to stay so host cpp sees a clean directive line. */
#include <stdio.h>

int main(void) {
    fprintf(stderr,
            "x=%d\n",
#if 1
            1
#else
            2
#endif
            );
    return 0;
}

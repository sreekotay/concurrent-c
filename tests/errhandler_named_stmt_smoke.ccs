/*
 * @errhandler(E e) STMT; binds a named policy; !>; forwards to it.
 * Shared cc_error_exit from main and a task.
 */
#include <ccc/cc_runtime.cch>
#include <ccc/stdio.cch>

static void !>(CCError) say_ok(void) {
    println("named-ok");
    return cc_ok();
}

int main(void) {
    @errhandler(CCError e) cc_error_exit(e);

    {
        CCNursery n = cc_nursery_create() !> @destroy;
        n.spawn(() => {
            @errhandler(CCError e) cc_error_exit(e);
            say_ok() !>;
        }) !>;
    }
    println("main-ok");
    return 0;
}

#include <ccc/std/prelude.cch>

int main(void) {
    @errhandler(CCError e) cc_error_exit(e);
    CCNursery task = cc_nursery_create() !> @destroy;
    task.spawn(() => {
        CCResult_int_CCError res = cc_ok_CCResult_int_CCError(123);
        if (res.is_ok()) {
            int value = res.value();
            (void)value;
        }
        return NULL;
    }) !>;

    return 0;
}

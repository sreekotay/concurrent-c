/* Vec.truncate shrinks len and keeps cap. n >= len is a no-op. */
#include <ccc/std/prelude.cch>
#include <stdio.h>

int main(void) {
    CCArena arena = cc_arena_heap(kilobytes(4));
    if (!cc_arena_is_live(arena)) return 1;

    Vec::[int] v = vec_new::[int](arena);
    v.push(1);
    v.push(2);
    v.push(3);
    v.push(4);
    size_t cap0 = v.cap();

    v.truncate(2);
    if (v.len() != 2) {
        fprintf(stderr, "FAIL: truncate(2) len=%zu\n", v.len());
        return 2;
    }
    if (v.cap() != cap0) {
        fprintf(stderr, "FAIL: truncate moved cap %zu -> %zu\n", cap0, v.cap());
        return 3;
    }
    if (*v.get(0) != 1 || *v.get(1) != 2) {
        fprintf(stderr, "FAIL: truncate dropped the wrong prefix\n");
        return 4;
    }
    if (v.get(2) != NULL) {
        fprintf(stderr, "FAIL: index 2 still in extent\n");
        return 5;
    }

    v.truncate(2);
    if (v.len() != 2) {
        fprintf(stderr, "FAIL: truncate(len) changed len\n");
        return 6;
    }

    v.truncate(99);
    if (v.len() != 2) {
        fprintf(stderr, "FAIL: truncate(>len) changed len\n");
        return 7;
    }

    v.truncate(0);
    if (v.len() != 0 || v.cap() != cap0) {
        fprintf(stderr, "FAIL: truncate(0) len/cap %zu %zu\n", v.len(), v.cap());
        return 8;
    }

    int buf[4] = {10, 20, 30, 40};
    Vec::[int] w = vec_from::[int](buf, 4, 4);
    w.truncate(1);
    if (w.len() != 1 || w.cap() != 4) {
        fprintf(stderr, "FAIL: from truncate len/cap %zu %zu\n", w.len(), w.cap());
        return 9;
    }
    if (buf[0] != 10 || buf[1] != 20) {
        fprintf(stderr, "FAIL: from truncate wrote through backing\n");
        return 10;
    }
    w.destroy();

    v.push(7);
    v.push(8);
    Vec::[int] *p = &v;
    p->truncate(1);
    if (v.len() != 1 || *v.get(0) != 7) {
        fprintf(stderr, "FAIL: pointer UFCS truncate\n");
        return 11;
    }

    v.destroy();
    printf("vec_truncate_smoke ok\n");
    cc_arena_free(&arena);
    return 0;
}

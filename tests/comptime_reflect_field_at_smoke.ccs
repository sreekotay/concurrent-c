#include <ccc/std/prelude.cch>
#include <ccc/cc_instantiate.cch>
#include <stdio.h>
#include <string.h>

typedef struct { int x; long y; } RFld;

@comptime CCSlice rfld_factory(CCSlice generic_name, CCSlice mangled,
                               CCSliceArray type_args, CCArena* arena) {
    (void)generic_name; (void)mangled; (void)type_args;
    CCReflectField f0, f1;
    if (cc_reflect_field_at("RFld", 0, &f0) != 0) return cc_slice_empty();
    if (cc_reflect_field_at("RFld", 1, &f1) != 0) return cc_slice_empty();
    return @emit(`
        typedef struct { int n; } ${mangled};
        static inline const char* ${mangled}_f0(void) { return "${f0.name}"; }
        static inline const char* ${mangled}_f1(void) { return "${f1.type}"; }
    `, arena);
}

@comptime { cc_generic_register("RFldWrap", rfld_factory); }

int main(void) {
    RFldWrap::[int] w;
    w.n = 0;
    if (strcmp(RFldWrap_int_f0(), "x") != 0) return 1;
    if (strcmp(RFldWrap_int_f1(), "long") != 0) return 2;
    printf("comptime_reflect_field_at_smoke ok\n");
    return 0;
}

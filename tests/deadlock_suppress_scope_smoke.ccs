/*
 * Deadlock detector / deadlock-suppress scope test.
 *
 * Runs under the V2-default runtime via sched_v2_check_deadlock (in
 * sched_v2.c). See external_wait_scope_smoke.ccs for the full
 * contract; this test is the twin variant for cc_deadlock_suppress_*
 * scopes: a fiber inside cc_deadlock_suppress_enter is exempt from
 * the verdict while the scope is active, and re-enters detection
 * after cc_deadlock_suppress_leave.
 */
#include <ccc/cc_runtime.cch>

#include <signal.h>
#include <stdlib.h>
#include <sys/wait.h>
#include <unistd.h>

enum {
    MODE_UNSUPPRESSED = 0,
    MODE_SUPPRESSED = 1,
    MODE_LEAVE_RESTORES = 2,
};

static int g_mode = MODE_UNSUPPRESSED;

static void child_deadlock_case(void) {
    @errhandler(CCError e) cc_error_exit(e);
    setenv("CC_WORKERS", "1", 1);
    setenv("CC_DEADLOCK_ABORT", "1", 1);
    /* Short latch: same detector shape, less wall time in the harness. */
    setenv("CC_DEADLOCK_PERSIST_MS", "200", 1);

    int[~ >] tx;
    int[~ <] rx;
    CCChan* ch = cc_channel_pair(&tx, &rx);
    if (!ch) _exit(20);

    {
        CCNursery n = @create() !> @destroy;

        n.spawn(() => {
            int v = 0;
            if (g_mode == MODE_SUPPRESSED) {
                cc_deadlock_suppress_enter();
                (void)chan_recv(rx, &v);
                cc_deadlock_suppress_leave();
            } else {
                if (g_mode == MODE_LEAVE_RESTORES) {
                    cc_deadlock_suppress_enter();
                    cc_deadlock_suppress_leave();
                }
                (void)chan_recv(rx, &v);
            }
        }) !>;
    }

    chan_free(ch);
    _exit(30);
}

static int run_child_expect_exit124(int mode, int timeout_ms) {
    g_mode = mode;
    pid_t pid = fork();
    if (pid < 0) return 10;
    if (pid == 0) child_deadlock_case();

    int status = 0;
    int waited_ms = 0;
    while (waited_ms < timeout_ms) {
        pid_t rc = waitpid(pid, &status, WNOHANG);
        if (rc == pid) {
            if (WIFEXITED(status) && WEXITSTATUS(status) == 124) return 0;
            return 11;
        }
        if (rc < 0) return 12;
        usleep(20 * 1000);
        waited_ms += 20;
    }

    kill(pid, SIGKILL);
    (void)waitpid(pid, &status, 0);
    return 13;
}

static int run_child_expect_suppressed_hang(int mode, int timeout_ms) {
    g_mode = mode;
    pid_t pid = fork();
    if (pid < 0) return 20;
    if (pid == 0) child_deadlock_case();

    int status = 0;
    int waited_ms = 0;
    while (waited_ms < timeout_ms) {
        pid_t rc = waitpid(pid, &status, WNOHANG);
        if (rc == pid) {
            return 21;
        }
        if (rc < 0) return 22;
        usleep(20 * 1000);
        waited_ms += 20;
    }

    kill(pid, SIGKILL);
    (void)waitpid(pid, &status, 0);
    return 0;
}

int main(void) {
    /* Children set CC_DEADLOCK_PERSIST_MS=200. Exit-124 budgets sit above
     * that; the hang case must outlast the latch so a suppressed stall is
     * distinguishable from "not fired yet". */
    int rc = run_child_expect_exit124(MODE_UNSUPPRESSED, 800);
    if (rc != 0) return rc;

    rc = run_child_expect_suppressed_hang(MODE_SUPPRESSED, 500);
    if (rc != 0) return rc;

    rc = run_child_expect_exit124(MODE_LEAVE_RESTORES, 800);
    if (rc != 0) return rc;

    return 0;
}

/* typedef ArrayMap::[K,V] alias + UFCS. */
#include <ccc/std/prelude.cch>
#include <stdio.h>

typedef ArrayMap::[int, int] IntMap;

int main(void) {
    CCArena arena = cc_arena_heap(kilobytes(64));
    IntMap m;
    int* p;
    if (!cc_arena_is_live(arena)) return 1;
    m = array_map_new::[int, int](&arena);
    if (!m) return 2;
    if (m->insert(42, 420) != 0) return 3;
    p = m->get_ptr(42);
    if (!p || *p != 420) return 4;
    if (m->len() != 1) return 5;
    printf("array_map_sugar_typedef_ufcs_smoke ok\n");
    m->destroy();
    cc_arena_free(&arena);
    return 0;
}

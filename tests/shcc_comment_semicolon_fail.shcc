/* Task #53 tripwire: a leading comment holding a semicolon; that alone
 * corrupts the .shcc emit plan's insert position, so this file dies in
 * the parser pass even though every statement below is well-formed.
 * When this file starts COMPILING, the bug is fixed -- delete the
 * .compile_err fixture and flip this into a passing smoke. */
CCArena a = cc_arena_heap(megabytes(1)) @destroy;
{
    CCCommand which = cc_command(&a, @slice("sh"));
    which.arg("-c");
    which.arg("true");
    int rc = which.status() !>;
    if (rc != 0) { "unreachable".println() !>; return 1; }
}
return 0;

/*
 * Test: !> used outside a function returning T !> (E) (should fail)
 * Propagation requires the enclosing function to return a compatible Result type.
 */
#include <ccc/std/prelude.cch>

int !> (CCError) maybe_fail(int x) {
    if (x < 0) {
        return cc_err(CC_ERR_INVALID_ARG, "negative");
    }
    return cc_ok(x);
}

/* This function returns int, not int !> (CCError), so !> should fail */
int broken(int x) {
    int v = maybe_fail(x) !>(e) return cc_err(e);
    return v;
}

int main(void) {
    return broken(5);
}

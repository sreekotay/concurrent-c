/* Dest-bound by-value capture: assigning the copy is ill-formed. */
#include <ccc/std/prelude.cch>

int main(void) {
    @errhandler(CCError e) { cc_error_log(e); return 1; }
    int x = 0;
    CCParallel h = @parallel spawn { @serial { (void)0; } } !>;
    @parallel(h) { x = 1; }
    h.wait() !>;
    return x;
}

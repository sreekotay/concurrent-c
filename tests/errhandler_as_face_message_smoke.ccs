/*
 * An error type that is a CCError through its `as:` face: the face's
 * message is filled, so a CCError-only handler prints it without the
 * type's own vocabulary.
 */
#include <ccc/std/io.h>
#include "as_face_error_helper.cch"
#include <stdio.h>
#include <string.h>

static int !> (AppError) always_err_not_found(void) {
    return cc_err(app_error(CC_ERR_NOT_FOUND, 2));
}

int main(void) {
    const char *msg = NULL;
    CCErrorKind kind = CC_ERR_NONE;
    @errhandler(CCError e) {
        msg = cc_error_str(e);
        kind = e.kind;
    }
    always_err_not_found() !>;
    if (!msg || !msg[0]) {
        fprintf(stderr, "empty face message\n");
        return 1;
    }
    if (kind != CC_ERR_NOT_FOUND) {
        fprintf(stderr, "kind=%d\n", (int)kind);
        return 1;
    }
    printf("msg=%s\n", msg);
    return 0;
}

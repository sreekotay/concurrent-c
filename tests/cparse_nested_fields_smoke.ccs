/* Nested struct/union in a C-only struct: cparse owns the member list.
 * The fat union is >512 bytes so flatten must not chop — emit reprints
 * the FileTape span. */
typedef struct CparseNest {
    union {
        int bytes;
        int i64;
    } u;
    struct {
        int inner_x;
        int inner_y;
    } nest;
    union {
        long long a00, a01, a02, a03, a04, a05, a06, a07;
        long long a08, a09, a10, a11, a12, a13, a14, a15;
        long long a16, a17, a18, a19, a20, a21, a22, a23;
        long long a24, a25, a26, a27, a28, a29, a30, a31;
        long long a32, a33, a34, a35, a36, a37, a38, a39;
        long long a40, a41, a42, a43, a44, a45, a46, a47;
        long long a48, a49, a50, a51, a52, a53, a54, a55;
        long long a56, a57, a58, a59, a60, a61, a62, a63;
        long long a64, a65, a66, a67, a68, a69, a70, a71;
        long long a72, a73, a74, a75, a76, a77, a78, a79;
    } fat;
    int extra;
} CparseNest;

int main(void) {
    CparseNest x;
    x.u.bytes = 1;
    x.nest.inner_x = 2;
    x.nest.inner_y = 3;
    x.fat.a00 = 4;
    x.fat.a63 = 5;
    x.extra = 6;
    return (x.u.bytes + x.nest.inner_x + x.nest.inner_y + x.extra == 12) ? 0
                                                                        : 1;
}

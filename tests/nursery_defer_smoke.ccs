#include <ccc/cc_nursery.cch>
// Smoke test: ensure @create/@destroy nursery setup and @defer coexist.

void worker(int n) {
    (void)n;
}

int main(void) {
    @errhandler(CCError e) cc_error_exit(e);
    @defer { int x = 0; (void)x; };
    {
        CCNursery __cc_nursery71 = @create() !> @destroy;

        __cc_nursery71.spawn(() => { worker(1); });

    }
    return 0;
}



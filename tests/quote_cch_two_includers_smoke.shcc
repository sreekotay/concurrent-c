/* Two programs include one implementation face (spec 1.7): the face is a
 * module of one, its exported two_splice_val is defined once in the
 * module object, and both programs link it. Two includers is the normal
 * case. */
CCArena arena = cc_arena_heap(megabytes(1)) @destroy;

CCCommand build = cc_command(arena, @slice("./cc/bin/ccc"));
build.arg("build");
build.arg("--no-cache");
build.arg("tests/quote_cch_two_splice_a_mod.ccs");
build.arg("tests/quote_cch_two_splice_b_mod.ccs");
build.arg("-o");
build.arg("out/quote_cch_two_includers_smoke");
build.inherit_stdio();
int rc = build.status() !>;
if (rc != 0) {
    "build failed: the face's object was not linked once for both programs".println();
    return 1;
}
CCCommand run = cc_command(arena, @slice("out/quote_cch_two_includers_smoke"));
run.inherit_stdio();
rc = run.status() !>;
if (rc != 0) {
    "run failed".println();
    return 1;
}
return 0;

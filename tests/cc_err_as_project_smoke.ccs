/* cc_err(e) projects the unique as: path when the Result's error is
 * CCError and e is a type with a CCError face — same rule as !>; and the
 * @errhandler binder projection. The bang binder stays the face's own type
 * (code visible); projection is at the sink. */
#include <ccc/std/io.h>
#include "as_face_error_helper.cch"
#include <stdio.h>

static int g_inline_kind;
static int g_hoist_kind;
static int g_os;

static int !>(AppError) always_err_io(void) {
    AppError e = app_error(CC_ERR_IO, 0);
    e.code = 42;
    return cc_err(e);
}

/* Hoist: !>; under @errhandler(CCError) — already specified. */
static int !>(CCError) via_hoist(void) {
    @errhandler(CCError e) { return cc_err(e); }
    always_err_io() !>;
    return cc_ok(0);
}

/* Inline: !>(e) return cc_err(e) — the gap this smoke pins. */
static int !>(CCError) via_inline(void) {
    always_err_io() !>(e) {
        g_os = e.code;
        return cc_err(e);
    };
    return cc_ok(0);
}

typedef struct { int _pad; } CcErrAsBox;

static int !>(AppError) CcErrAsBox_as_project_io(CcErrAsBox *b) {
    AppError e;
    (void)b;
    e = app_error(CC_ERR_IO, 0);
    e.code = 42;
    return cc_err(e);
}

/* UFCS callee often misses the rfn table — projection must still fire. */
static int !>(CCError) via_ufcs(void) {
    CcErrAsBox box;
    box._pad = 0;
    box.as_project_io() !>(e) {
        return cc_err(e);
    };
    return cc_ok(0);
}

int main(void) {
    @errhandler(CCError e) {
        if (g_inline_kind == 0)
            g_inline_kind = (int)e.kind;
        else
            g_hoist_kind = (int)e.kind;
    }
    via_inline() !>;
    via_hoist() !>;
    via_ufcs() !>;
    if (g_os != 42) return 1;
    if (g_inline_kind != (int)CC_ERR_IO) return 2;
    if (g_hoist_kind != (int)CC_ERR_IO) return 3;
    printf("ok os=%d\n", g_os);
    return 0;
}

/* cc_err(e) projects unique as: path when Result face is CCError and
 * e is CCIoError — same rule as !>; / @errhandler binder projection.
 * Bang binder stays CCIoError (os_code visible); projection is at the sink. */
#include <ccc/std/io.h>
#include <stdio.h>

static int g_inline_kind;
static int g_hoist_kind;
static int g_os;

static int !>(CCIoError) always_err_io(void) {
    CCIoError e = cc_io_error(CC_IO_OTHER);
    e.os_code = 42;
    return cc_err(e);
}

/* Hoist: !>; under @errhandler(CCError) — already specified. */
static int !>(CCError) via_hoist(void) {
    @errhandler(CCError e) { return cc_err(e); }
    always_err_io() !>;
    return cc_ok(0);
}

/* Inline: !>(e) return cc_err(e) — the gap this smoke pins. */
static int !>(CCError) via_inline(void) {
    always_err_io() !>(e) {
        g_os = e.os_code;
        return cc_err(e);
    };
    return cc_ok(0);
}

int main(void) {
    @errhandler(CCError e) {
        if (g_inline_kind == 0)
            g_inline_kind = (int)e.kind;
        else
            g_hoist_kind = (int)e.kind;
    }
    via_inline() !>;
    via_hoist() !>;
    if (g_os != 42) return 1;
    if (g_inline_kind != (int)CC_ERR_IO) return 2;
    if (g_hoist_kind != (int)CC_ERR_IO) return 3;
    printf("ok os=%d\n", g_os);
    return 0;
}

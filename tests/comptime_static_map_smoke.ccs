#include <ccc/std/prelude.cch>
#include <ccc/std/static_map.cch>
#include <stdio.h>

typedef struct CommandSpec {
    int kind;
    int min_args;
    int max_args;
} CommandSpec;

@comptime {
    CCStaticMapEntry entries[] = {
        { "GET",  "(CommandSpec){ 1, 1, 1 }" },
        { "MGET", "(CommandSpec){ 2, 1, -1 }" },
        { "SET",  "(CommandSpec){ 3, 2, 2 }" },
    };
    static_map("commands", "CommandSpec", entries,
               sizeof(entries) / sizeof(entries[0]),
               CC_STATIC_MAP_ASCII_CI);
}

int main(void) {
    const CommandSpec* get = commands_get(cc_slice_from_cstr("get"));
    const CommandSpec* mget = commands_get(cc_slice_from_cstr("MGET"));
    const CommandSpec* set = commands_get(cc_slice_from_cstr("Set"));
    if (!get || get->kind != 1 || get->min_args != 1) return 1;
    if (!mget || mget->kind != 2 || mget->max_args != -1) return 2;
    if (!set || set->kind != 3) return 3;
    if (commands_get(cc_slice_from_cstr("NOPE"))) return 4;
    puts("comptime_static_map_smoke: PASS");
    return 0;
}

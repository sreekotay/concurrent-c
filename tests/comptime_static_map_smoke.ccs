#include <ccc/std/prelude.cch>
#include <ccc/std/static_map.cch>
#include <stdio.h>

/* Enum field in the value type — same shape redis_idiomatic uses with
 * RedisCommandKind from a shared header. */
typedef enum CmdKind {
    CMD_GET = 1,
    CMD_MGET = 2,
    CMD_SET = 3,
} CmdKind;

typedef struct CommandSpec {
    CmdKind kind;
    int min_args;
    int max_args;
} CommandSpec;

typedef struct CommandEntry {
    const char* key;
    CommandSpec value;
} CommandEntry;

@comptime {
    CommandEntry entries[] = {
        { "GET",  { CMD_GET, 1, 1 } },
        { "MGET", { CMD_MGET, 1, -1 } },
        { "SET",  { CMD_SET, 2, 2 } },
    };
    static_map("commands", entries, CC_STATIC_MAP_ASCII_CI);
}

int main(void) {
    const CommandSpec* get = commands_get(cc_slice_from_cstr("get"));
    const CommandSpec* mget = commands_get(cc_slice_from_cstr("MGET"));
    const CommandSpec* set = commands_get(cc_slice_from_cstr("Set"));
    if (!get || get->kind != CMD_GET || get->min_args != 1) return 1;
    if (!mget || mget->kind != CMD_MGET || mget->max_args != -1) return 2;
    if (!set || set->kind != CMD_SET || set->min_args != 2) return 3;
    if (commands_get(cc_slice_from_cstr("NOPE"))) return 4;
    puts("comptime_static_map_smoke: PASS");
    return 0;
}

#include <ccc/std/prelude.cch>
#include <ccc/cc_instantiate.cch>
#include <stdio.h>
#include <string.h>

/* Reflection is all-or-nothing: a struct with a member shape the field parser
 * does not model (here, an array field) reflects as -1 — never a partial or
 * guessed result.  A struct of plain scalar/pointer fields reflects cleanly.
 * Both the executor and compiled factories share this one field parser. */

typedef struct {
    int id;
    int items[4];
    char tag;
} HasArray;

typedef struct {
    int x;
    int y;
} Clean;

@comptime {
    int bad = cc_reflect_field_count("HasArray");
    int good = cc_reflect_field_count("Clean");
    cc_emit_format(CC_EMIT_AFTER_PRELUDE,
        "enum { HASARRAY_NF = %d, CLEAN_NF = %d };\n", bad, good);
    for (int i = 0; i < good; i++) {
        char nm[64];
        cc_reflect_field_name("Clean", i, nm, sizeof(nm));
        cc_emit_format(CC_EMIT_AFTER_PRELUDE,
            "static const char* clean_f%d = \"%s\";\n", i, nm);
    }
}

int main(void) {
    if (HASARRAY_NF != -1) return 1;
    if (CLEAN_NF != 2) return 2;
    if (strcmp(clean_f0, "x") != 0) return 3;
    if (strcmp(clean_f1, "y") != 0) return 4;
    printf("comptime_reflect_array_reject_smoke ok hasarray=%d clean=%d %s,%s\n",
           HASARRAY_NF, CLEAN_NF, clean_f0, clean_f1);
    return 0;
}

/* Runtime selection: usePython (venv dir / interpreter / libpython path,
 * spawn-resolved via sysconfig), ambient VIRTUAL_ENV and ./.venv (the
 * uv/poetry convention), one-runtime-per-process semantics (matching
 * re-choice is a no-op, a different one answers articulately), venv
 * adoption via Py_SetProgramName (sys.prefix IS the venv), and loud
 * failure on any present-but-broken selection — never a fall-through to
 * the wrong Python.  Rungs live in cc_python_bridge_env.js; the addon
 * is npm/cc-python/src/cc_python.ccs (own artifact name — sibling
 * bridge smokes relink their own). */
CCArena a = cc_arena_heap(megabytes(1)) @destroy;

{
    CCCommand which = cc_command(&a, @slice("sh"));
    which.arg("-c");
    which.arg("command -v node >/dev/null 2>&1 && command -v python3 >/dev/null 2>&1");
    int rc = which.status() !>;
    if (rc != 0) { "SKIP (need node + python3)".println() !>; return 0; }
}

{
    CCCommand build = cc_command(&a, @slice("./cc/bin/ccc"));
    build.arg("build");
    build.arg("npm/cc-python/src/cc_python.ccs");
    build.arg("-o");
    build.arg("bin/cc_python_env.node");
    build.inherit_stdio();
    int rc = build.status() !>;
    if (rc != 0) { "build failed".println() !>; return 1; }
}

{
    CCCommand run = cc_command(&a, @slice("sh"));
    run.arg("-c");
    run.arg("CC_PYTHON_ADDON=$PWD/bin/cc_python_env.node node tests/cc_python_bridge_env.js");
    run.inherit_stdio();
    int rc = run.status() !>;
    if (rc != 0) { "env suite failed".println() !>; return 1; }
}
return 0;

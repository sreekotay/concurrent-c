/* UFCS method chains: a call-expression receiver normalizes onto a
 * typed temporary in a statement expression, so every rail applies to
 * each link — family members, extensions, the as: retry, the strict
 * ladder. Covers: slice method->method (and deeper), method->field,
 * mixed method->method->field, vec as_slice chains, scalar-family
 * chains, and chains in expression position. */
#include <ccc/std/prelude.cch>
#include <assert.h>
#include <stdio.h>

typedef struct Pt { double x, y; } Pt;

static double cc_double_halve(double v) { return v / 2.0; }
static double cc_double_twice(double v) { return v * 2.0; }

int main(void) {
    CCArena arena = cc_arena_heap(kilobytes(64));
    if (!cc_arena_is_live(arena)) return 1;

    /* slice: method -> method */
    double xs[:] = {1.0, 2.0, 3.0, 4.0};
    assert(xs.sub(1, 3).len() == 2);

    /* slice: three links */
    assert(xs.sub(0, 4).sub(1, 2).len() == 1);

    /* slice: method -> field (struct element) */
    Pt ps[:] = {{1, 2}, {3, 4}, {5, 6}};
    assert(ps.at(2).y == 6.0);

    /* slice: method -> method -> field */
    assert(ps.sub(1, 3).at(0).y == 4.0);

    /* vec: as_slice chain into typed-slice members */
    Vec::[double] v = vec_new::[double](arena);
    v.push(1.5);
    v.push(2.5);
    assert(v.as_slice().sub(0, 1).len() == 1);

    /* scalar family: value-receiver chain, three links */
    double d = 10.0;
    assert(d.halve().twice().halve() == 5.0);

    /* chains in expression position */
    assert(2.0 + (4.0).halve() == 4.0);
    assert(xs.sub(0, 2).len() + xs.sub(2, 4).len() == 4);

    printf("ok\n");
    return 0;
}

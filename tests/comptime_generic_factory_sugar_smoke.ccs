#include <ccc/std/prelude.cch>
#include <ccc/cc_instantiate.cch>
#include <ccc/cc_slice.cch>
#include <stdio.h>

/* CC_GENERIC_FACTORY(Name[, arity]) { ... } is the single canonical factory
 * style.  Sugar: the implicit `generic_name`/`mangled`/`type_args`/`arena`
 * params are auto-voided (no boilerplate (void) casts), the optional arity
 * injects the `type_args.len < arity` guard, and `arg(i)` abbreviates
 * `type_args.items[i]`.  The body returns the fragment via @emit(`...`, arena). */

CC_GENERIC_FACTORY(Pair, 2) {
    return @emit(`
        typedef struct { ${arg(0)} first; ${arg(1)} second; } ${mangled};
        static inline ${mangled} ${mangled}_make(${arg(0)} a, ${arg(1)} b) {
            ${mangled} r; r.first = a; r.second = b; return r;
        }`, arena);
}

int main(void) {
    Pair::[int, double] p = Pair_int_double_make(3, 2.5);
    Pair::[int, int]    q = Pair_int_int_make(10, 20);

    if (p.first != 3) return 1;
    if (q.second != 20) return 2;

    printf("comptime_generic_factory_sugar_smoke ok p=%d,%g q=%d,%d\n",
           p.first, p.second, q.first, q.second);
    return 0;
}

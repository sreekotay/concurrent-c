/* Inbound kwargs on py_module trampolines: METH_FASTCALL|METH_KEYWORDS
 * binds by reflected parameter name. */
CCArena a = cc_arena_heap(megabytes(1)) @destroy;

{
    CCCommand which = cc_command(a, @slice("sh"));
    which.arg("-c");
    which.arg("command -v python3 >/dev/null 2>&1");
    int rc = which.status() !>;
    if (rc != 0) { "SKIP (no python3)".println() !>; return 0; }
}

{
    CCCommand build = cc_command(a, @slice("./cc/bin/ccc"));
    build.arg("build");
    build.arg("examples/recipe_py_module.ccs");
    build.inherit_stdio();
    int rc = build.status() !>;
    if (rc != 0) { "build failed".println() !>; return 1; }
}

{
    CCCommand run = cc_command(a, @slice("sh"));
    run.arg("-c");
    CCString py = @string(`PYTHONPATH=bin python3 -c "
import counter
print('pos', counter.bump(4))
print('kw', counter.bump(by=3))
print('default', counter.bump())
print('total', counter.total())
try:
    counter.bump(by=1, nope=2)
except TypeError as e:
    print('unexpected:', 'unexpected' in str(e).lower() or 'keyword' in str(e).lower())
try:
    counter.bump(1, by=2)
except TypeError as e:
    print('multi:', 'multiple' in str(e).lower())
"`, &a);
    run.arg(py.cstr(&a));
    run.inherit_stdio();
    int rc = run.status() !>;
    if (rc != 0) { "import failed".println() !>; return 1; }
}
return 0;

/* CCSlicePacked: 8B SSO or arena length-prefixed payload; map key. */
#include <ccc/std/prelude.cch>
#include <stdio.h>
#include <string.h>

int main(void) {
    CCArena arena = cc_arena_heap(kilobytes(64));
    CCSlicePacked a;
    CCSlicePacked b;
    CCSlicePacked long_p;
    CCSlice s;
    ArrayMap::[CCSlicePacked, int] m;
    int *p;
    char long_buf[64];
    size_t i;

    if (!arena.base) return 1;
    if (sizeof(CCSlicePacked) != sizeof(void *)) return 2;

    a = cc_slice_packed_empty();
    if (!cc_slice_packed_is_empty(&a) || cc_slice_packed_len(&a) != 0) return 3;

    {
        CCSlice hi = cc_slice_from_buffer((void *)"hi", 2);
        CCResult_CCSlicePacked_CCError rr = hi.to_packed(&arena);
        if (rr.is_err()) return 100;
        a = rr.value();
    }
    if (!cc_slice_packed_is_inline(&a) || cc_slice_packed_len(&a) != 2) return 4;
    s = cc_slice_packed_as_slice(&a);
    if (s.len != 2 || memcmp(s.ptr, "hi", 2) != 0) return 5;

    {
        CCSlice hi = cc_slice_from_buffer((void *)"hi", 2);
        CCResult_CCSlicePacked_CCError rr = hi.to_packed(&arena);
        if (rr.is_err()) return 101;
        b = rr.value();
    }
    if (!cc_map_eq_slice_packed(a, b)) return 6;

    for (i = 0; i < sizeof(long_buf); i++) long_buf[i] = (char)('A' + (i % 26));
    {
        CCSlice long_s = cc_slice_from_buffer(long_buf, sizeof(long_buf));
        CCResult_CCSlicePacked_CCError rr = long_s.to_packed(&arena);
        if (rr.is_err()) return 102;
        long_p = rr.value();
    }
    if (cc_slice_packed_is_inline(&long_p) || cc_slice_packed_len(&long_p) != sizeof(long_buf))
        return 7;
    s = cc_slice_packed_as_slice(&long_p);
    if (s.len != sizeof(long_buf) || memcmp(s.ptr, long_buf, sizeof(long_buf)) != 0) return 8;

    m = array_map_new::[CCSlicePacked, int](&arena);
    if (!m) return 9;
    if (m.insert(a, 11) != 0) return 10;
    if (m.insert(long_p, 22) != 0) return 11;
    p = m.get_ptr(b);
    if (!p || *p != 11) return 12;
    p = m.get_ptr(long_p);
    if (!p || *p != 22) return 13;
    if (m.len() != 2) return 14;

    if (a.len() != 2 || !a.is_inline()) return 15;
    s = a.as_slice();
    if (s.len != 2) return 16;

    /* Borrowed view probes the map without copying long keys. */
    {
        CCSlicePackedView view;
        CCSlicePacked probe = cc_slice_packed_borrow_slice(
            &view, cc_slice_from_buffer(long_buf, sizeof(long_buf)));
        p = m.get_ptr(probe);
        if (!p || *p != 22) return 17;
        if (!cc_slice_packed_is_view(&probe)) return 18;
        if (cc_slice_packed_is_durable(&probe)) return 19;
        if (!cc_slice_packed_is_durable(&a)) return 20;
    }

    /* Heap-overflow arena: packed heap payload can be released individually. */
    {
        CCArena ovf = cc_arena_malloc(64);
        CCSlicePacked hp;
        if (!ovf.base) return 21;
        {
            CCSlice long_s = cc_slice_from_buffer(long_buf, sizeof(long_buf));
            CCResult_CCSlicePacked_CCError rr = long_s.to_packed(&ovf);
            if (rr.is_err()) return 23;
            hp = rr.value();
        }
        if (cc_slice_packed_is_inline(&hp)) return 24;
        cc_slice_packed_release(&ovf, &hp);
        if (!cc_slice_packed_is_empty(&hp)) return 25;
        {
            CCSlicePacked inline_p = a; /* copy; release is inline no-op */
            cc_slice_packed_release(&ovf, &inline_p);
            if (!cc_slice_packed_is_empty(&inline_p)) return 26;
        }
        ovf.destroy();
    }

    printf("slice_packed_smoke: ok\n");
    return 0;
}

/*
 * A Result whose error has a CCError face, with only @errhandler(CCError):
 * matches through the face. An exact handler is still preferred when
 * stacked (see type_match smoke).
 */
#include <ccc/std/io.h>
#include "as_face_error_helper.cch"
#include <stdio.h>

static int g_hit;

static int !> (AppError) always_err_io(void) {
    return cc_err(app_error(CC_ERR_IO, 0));
}

int main(void) {
    @errhandler(CCError e) {
        g_hit = 1 + (int)e.kind; /* binder is CCError via as: projection */
    }
    always_err_io() !>;
    printf("g_hit=%d\n", g_hit);
    return (g_hit == 1 + (int)CC_ERR_IO) ? 0 : 1;
}

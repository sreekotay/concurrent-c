#include <ccc/cc_nursery.cch>
// Smoke: nested closures should be *recorded* in stub AST (Phase 2).

int g = 0;
int x = 1;

int main(void) {
    @errhandler(CCError e) cc_error_exit(e);
    {
        CCNursery __cc_nursery45 = @create() !> @destroy;

        __cc_nursery45.spawn (() => {
            {
                CCNursery __cc_nursery46 = @create() !> @destroy;

                __cc_nursery46.spawn (() => { g = x; });
            
            }
        });
    
    }
    return 0;
}


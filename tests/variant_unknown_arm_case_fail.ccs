/* Fail oracle: unknown arm as a designator case label — lists the valid
 * arms with a did-you-mean hint. */
#include <ccc/std/prelude.cch>
#include <stdint.h>

@variant V {
    str: const char*;
    num: int64_t;
};

int main(void) {
    V v = { .num = 3 };
    @switch (v) {
        case .num: break;
        case .strr: break;
    }
    return 0;
}

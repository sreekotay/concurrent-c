/* Pointer as: fields are ill-formed (value embeds only). */
#include <ccc/std/prelude.cch>
#include <stdio.h>

typedef struct {
    CCFile *fp;
    int tag;
} AsPtrWrap;

@typeview on AsPtrWrap {
    as: fp;
};

int main(void) {
    AsPtrWrap w = {0};
    (void)w;
    printf("unreachable\n");
    return 0;
}

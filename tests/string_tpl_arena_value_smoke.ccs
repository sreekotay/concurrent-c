/* @string interpolations take a CCArena value. Assigning that handle to
 * CCArena* is the emit bug this pins. */
#include <ccc/std/prelude.cch>
#include <stdio.h>
#include <string.h>

int main(void) {
    CCArena a = cc_arena_heap(kilobytes(4)) @destroy;
    int v = 7;
    CCString s = @string(`n=${v}`, a);
    char[:0] t = s.as_slice();
    if (t.len != 3 || memcmp(t.ptr, "n=7", 3) != 0) return 1;
    printf("ok\n");
    return 0;
}

/* Diagnostics oracle: closure lift above AND error inside a closure body.
 * Closure bodies are hoisted to end-of-file functions; the #line anchor
 * must still map the error back to the user's line inside the closure. */
#include <ccc/std/prelude.cch>

int main(void) {
    @errhandler(CCError e) { fprintf(stderr, "%s\n", e.message); return 1; }
    CCNursery* n = cc_nursery_create(NULL) !> @destroy;
    n->spawn(() => {
        int inner = cc_diag_oracle_undeclared(1);   /* line 10 */
        (void)inner;
    });
    int after = cc_diag_oracle_undeclared_two(2);   /* line 13 */
    (void)after;
    return 0;
}

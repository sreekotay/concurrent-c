/* Cyclic @as graph must fail loudly. */
#include <ccc/std/prelude.cch>
#include <stdio.h>

typedef struct AsA AsA;
typedef struct AsB AsB;

typedef struct AsA {
    AsB *b @as;
    int a_tag;
} AsA;

typedef struct AsB {
    AsA *a @as;
    int b_tag;
} AsB;

int main(void) {
    AsA a = {0};
    AsB b = {0};
    a.b = &b;
    b.a = &a;
    a.destroy();
    printf("unreachable\n");
    return 0;
}

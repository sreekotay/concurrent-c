/* @as arg-position autocast: Outer* / &Outer where T* expected → &x.name.
 * `tag` precedes `file` so &wrap != &wrap.file — layout alone cannot pass. */
#include <ccc/std/prelude.cch>
#include <assert.h>
#include <stdio.h>
#include <string.h>

typedef struct {
    int tag;
    CCFile file @as;
} AsArgWrap;

static CCFile *g_got;

static void takes_file(CCFile *f) {
    assert(f != NULL);
    g_got = f;
}

int main(void) {
    AsArgWrap w = {0};
    AsArgWrap *p = &w;
    w.tag = 9;
    assert(w.open(CC_SLICE_LIT("tmp/as_arg_coerce_smoke.txt"), "w") == 0);

    g_got = NULL;
    takes_file(&w);          /* → takes_file(&w.file) */
    assert(g_got == &w.file);

    g_got = NULL;
    takes_file(p);           /* → takes_file(&p->file) */
    assert(g_got == &w.file);

    g_got = NULL;
    takes_file(&w.file);     /* already member — unchanged */
    assert(g_got == &w.file);

    /* Explicit non-first @as: cast keeps C meaning (wrong address) — warn only.
     * Do not assert on the cast result; just ensure it compiles. */
    takes_file((CCFile *)&w);

    w.close();
    remove("tmp/as_arg_coerce_smoke.txt");
    printf("ok\n");
    return 0;
}

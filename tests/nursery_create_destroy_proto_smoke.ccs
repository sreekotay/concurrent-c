#include <ccc/std/prelude.cch>

static int g_task_ran = 0;
static int g_destroy_ran = 0;

int main(void) {
    {
        @errhandler(CCError e) cc_error_exit(e);
        CCNursery n = cc_nursery_create() !> @destroy {
            (void)n.wait();
            if (g_task_ran == 1) {
                g_destroy_ran = 1;
            }
        };
        n.spawn(() => {
            g_task_ran = 1;
        });
    }

    if (g_task_ran != 1) return 2;
    if (g_destroy_ran != 1) return 3;
    return 0;
}

/*
 * Smoke test: top-level nursery sibling spawns must not stay serialized on a
 * single worker when the scheduler is configured with 4 workers.
 *
 * This targets the non-worker nursery startup placement bug class that can
 * serialize sibling spawns onto a single worker (historically: one
 * inbox/worker under V1, which then showed up as ~2x channel-isolation
 * contention; under the V2 single-ready-queue scheduler the equivalent
 * regression is a wake path that never gets sibling work onto a second
 * worker).
 *
 * LOAD TOLERANCE (2026-07): the original version asserted a FIRST-TOUCH
 * property — "which worker ran each sibling first" — and required >= 2
 * distinct workers in > 50% of iterations.  That property is decided by a
 * race between one hot worker self-draining the ready queue and the OS
 * scheduling the woken sibling workers, so it legitimately degrades on a
 * loaded machine: under a parallel test suite (--jobs 4 on 4 CPUs) the
 * collapse rate drifts right past any fixed threshold (measured 0..61
 * collapsed / 100 isolated on a 4-CPU container, > 50 under suite load) —
 * a long-documented flake, not a runtime bug.
 *
 * The test now asserts the load-robust residue of the same property:
 * while all 4 siblings are alive and continuously yielding (so the ready
 * queue keeps refilling and wakes keep being issued), work must SPREAD to
 * at least 2 distinct workers within a generous deadline.  Woken workers
 * are runnable and the OS schedules them within a few timeslices no matter
 * the load, so a sibling group that stays on ONE worker for the whole
 * 100 ms window means wakes are being lost or placement is systematically
 * collapsed — the actual regression this test exists to catch (which
 * presents as ~100% of iterations collapsed, far past MAX_COLLAPSED).
 */

#include <ccc/std/prelude.cch>
#include <ccc/cc_nursery.cch>
#include <stdio.h>
#include <time.h>

#define NUM_WORKERS 4
#define NUM_SIBLINGS 4
#define ITERATIONS 50
#define MAX_COLLAPSED 12
#define SPREAD_DEADLINE_MS 100

/* Private runtime probe used only by this regression test. */
int cc__sched_current_worker_id(void);
static cc_atomic_int g_worker_ids[NUM_SIBLINGS];
static cc_atomic_int g_ready = 0;
static cc_atomic_int g_done = 0;      /* iteration finished (spread or deadline) */
static cc_atomic_int g_collapsed = 0; /* deadline hit with < 2 workers seen */
static struct timespec g_iter_start;

/* NOTE: the helpers below take no arguments and read the globals directly —
 * the closure-capture scanner mis-parses bare global array names passed as
 * call arguments inside closure literals, so the closure body must only
 * reference globals through `&g_xxx[...]` / `&g_xxx` expressions or through
 * zero-argument helper calls. */
static int iteration_deadline_expired(void) {
    struct timespec now;
    clock_gettime(CLOCK_MONOTONIC, &now);
    long ms = (long)((now.tv_sec - g_iter_start.tv_sec) * 1000 +
                     (now.tv_nsec - g_iter_start.tv_nsec) / 1000000);
    return ms >= SPREAD_DEADLINE_MS;
}

static int count_unique_workers(void) {
    int unique = 0;
    for (int i = 0; i < NUM_SIBLINGS; i++) {
        int wid = cc_atomic_load(&g_worker_ids[i]);
        if (wid < 0) {
            return -1;
        }
        int seen = 0;
        for (int j = 0; j < i; j++) {
            if (cc_atomic_load(&g_worker_ids[j]) == wid) {
                seen = 1;
                break;
            }
        }
        if (!seen) unique++;
    }
    return unique;
}

int main(void) {
    cc_sched_set_num_workers(NUM_WORKERS);
    int collapsed = 0;

    for (int iter = 0; iter < ITERATIONS; iter++) {
        for (int i = 0; i < NUM_SIBLINGS; i++) {
            cc_atomic_store(&g_worker_ids[i], -1);
        }
        cc_atomic_store(&g_ready, 0);
        cc_atomic_store(&g_done, 0);
        cc_atomic_store(&g_collapsed, 0);
        clock_gettime(CLOCK_MONOTONIC, &g_iter_start);

        CCNursery* n = @create(NULL) @detach;
        if (!n) abort();
        for (int i = 0; i < NUM_SIBLINGS; i++) {
            int idx = i;
            (void)cc_nursery_spawn_closure0(n, () => [idx] {
                int announced = 0;
                while (!cc_atomic_load(&g_done)) {
                    /* Continuously republish the worker we are currently
                     * on; yielding keeps the ready queue hot so parked
                     * workers keep receiving wakes. */
                    int wid = cc__sched_current_worker_id();
                    if (wid >= 0) {
                        cc_atomic_store(&g_worker_ids[idx], wid);
                        if (!announced) {
                            announced = 1;
                            cc_atomic_fetch_add(&g_ready, 1);
                        }
                    }
                    /* Sibling 0 referees: once all siblings have started,
                     * finish the iteration as soon as 2+ workers are seen,
                     * or flag a collapse when the deadline expires. */
                    if (idx == 0 && cc_atomic_load(&g_ready) == NUM_SIBLINGS) {
                        int unique = count_unique_workers();
                        if (unique >= 2) {
                            cc_atomic_store(&g_done, 1);
                            break;
                        }
                        if (iteration_deadline_expired()) {
                            cc_atomic_store(&g_collapsed, 1);
                            cc_atomic_store(&g_done, 1);
                            break;
                        }
                    }
                    cc_yield();
                }
            });
        }
        (void)cc_nursery_wait(n);
        cc_nursery_free(n);

        int unique = count_unique_workers();
        if (unique < 0) {
            fprintf(stderr,
                    "FAIL nursery_spawn_placement_workers4: iter %d recorded invalid worker ids [%d %d %d %d]\n",
                    iter,
                    cc_atomic_load(&g_worker_ids[0]), cc_atomic_load(&g_worker_ids[1]),
                    cc_atomic_load(&g_worker_ids[2]), cc_atomic_load(&g_worker_ids[3]));
            return 1;
        }
        if (cc_atomic_load(&g_collapsed)) {
            collapsed++;
            if (collapsed > MAX_COLLAPSED) {
                fprintf(stderr,
                        "FAIL nursery_spawn_placement_workers4: sustained collapse %d/%d iterations; last iter %d never spread past %d worker within %d ms [%d %d %d %d]\n",
                        collapsed, ITERATIONS, iter, unique, SPREAD_DEADLINE_MS,
                        cc_atomic_load(&g_worker_ids[0]), cc_atomic_load(&g_worker_ids[1]),
                        cc_atomic_load(&g_worker_ids[2]), cc_atomic_load(&g_worker_ids[3]));
                return 1;
            }
        }
    }

    printf("nursery_spawn_placement_workers4_smoke: PASS (%d iterations, %d collapsed)\n",
           ITERATIONS, collapsed);
    return 0;
}

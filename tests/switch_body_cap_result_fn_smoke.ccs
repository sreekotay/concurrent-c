/*
 * Fat Result-fn switch that used to break (ConnEnc was a red herring):
 *
 *   static bool !>(CCError) f(...) {
 *     switch (k) { … many arms with `!>`; body length >= 4096 … }
 *   }
 *
 * Was: structured body[64] miss → opaque d[4096] → silent NULL → raw `!>`.
 * Now: body[256] keeps fat !> switches structured; opaque bodies larger
 * than d[] stay on the tape (span_off/span_len) instead of NULL.
 *
 * Expect PASS:
 *   ./cc/bin/ccc --no-cache build --emit-c-only \
 *     tests/switch_body_cap_result_fn_smoke.ccs -o /tmp/x.c
 */
#include <ccc/std/prelude.cch>
#include <ccc/script/stdio.cch>

static int64_t !>(CCError) parse_i(char[:] s) {
    return s.to_i64();
}

static bool !>(CCError) execute_fat(int k, char[:] arg) {
    @errhandler(CCError e) { return cc_err(e); }
    switch (k) {
    case 0: {
        char[:] _pad = CC_SLICE_LIT("pad-pad-pad-pad-pad-pad-pad-pad-pad-pad-pad-pad-pad-pad-pad");
        (void)_pad;
        int64_t v = parse_i(arg) !>;
        return cc_ok(v == (int64_t)0);
    }
    case 1: {
        char[:] _pad = CC_SLICE_LIT("pad-pad-pad-pad-pad-pad-pad-pad-pad-pad-pad-pad-pad-pad-pad");
        (void)_pad;
        int64_t v = parse_i(arg) !>;
        return cc_ok(v == (int64_t)1);
    }
    case 2: {

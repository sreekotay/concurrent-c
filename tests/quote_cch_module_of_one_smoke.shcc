/* A face with no members is a module of one (spec 1.7): its bodies lower
 * into per_tu_cch.c, compile once, and both programs link that object.
 * Neither program carries a copy of the module-private step. */
CCArena arena = cc_arena_heap(megabytes(1)) @destroy;

CCCommand emit_a = cc_command(arena, @slice("./cc/bin/ccc"));
emit_a.arg("--no-cache");
emit_a.arg("--emit-c-only");
emit_a.arg("tests/quote_cch_per_tu_a_mod.ccs");
emit_a.arg("-o");
emit_a.arg("out/quote_cch_per_tu_a.c");
emit_a.inherit_stdio();
int rc = emit_a.status() !>;
if (rc != 0) {
    "emit arena failed".println();
    return 1;
}

CCCommand grep_static = cc_command(arena, @slice("grep"));
grep_static.arg("-q");
grep_static.arg("per_tu_step");
grep_static.arg("out/quote_cch_per_tu_a.c");
rc = grep_static.status() !>;
if (rc == 0) {
    "the module-private step was copied into the program TU".println();
    return 1;
}

CCCommand build = cc_command(arena, @slice("./cc/bin/ccc"));
build.arg("build");
build.arg("--no-cache");
build.arg("tests/quote_cch_per_tu_a_mod.ccs");
build.arg("tests/quote_cch_per_tu_b_mod.ccs");
build.arg("-o");
build.arg("out/quote_cch_module_of_one_smoke");
build.inherit_stdio();
rc = build.status() !>;
if (rc != 0) {
    "build failed".println();
    return 1;
}
CCCommand run = cc_command(arena, @slice("out/quote_cch_module_of_one_smoke"));
run.inherit_stdio();
rc = run.status() !>;
if (rc != 0) {
    "run failed".println();
    return 1;
}
return 0;

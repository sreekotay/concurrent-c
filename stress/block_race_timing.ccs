/*
 * Stress test: cc_block_race correctness
 * 
 * Tests that cc_block_race returns valid results.
 * 
 * NOTE: Due to current async runtime limitations (cc_sleep_ms blocks 
 * the polling thread, not just the fiber), timing-based "fast wins"
 * behavior is not reliable. This test focuses on correctness:
 * - No errors
 * - Winner index is valid (0 or 1)
 * - Result matches the winner's return value
 */
#include <ccc/cc_runtime.cch>
#include <ccc/stdio.cch>

#define ITERATIONS 50

@async int task_a(void) {
    cc_sleep_ms(5);
    return 42;
}

@async int task_b(void) {
    cc_sleep_ms(10);
    return 99;
}

int main(void) {
    @errhandler(CCError e) { cc_error_log(e); return 1; }
    println(@string(`block_race_timing: ${ITERATIONS} iterations (correctness test)`, @scratch)) !>;
    
    int a_wins = 0;
    int b_wins = 0;
    int errors = 0;
    
    for (int iter = 0; iter < ITERATIONS; iter++) {
        CCTaskIntptr tasks[] = {
            task_a(),  /* index 0, returns 42 */
            task_b()   /* index 1, returns 99 */
        };
        
        int winner = -1;
        intptr_t result = 0;
        int err = cc_block_race(2, tasks, &winner, &result);
        
        if (err != 0) {
            errors++;
            eprintln(@string(`  iter ${iter}: ERROR err=${err}`, @scratch)) !>;
            continue;
        }
        
        /* Validate result matches winner */
        if (winner == 0) {
            if (result != 42) {
                errors++;
                eprintln(@string(`  iter ${iter}: winner=0 but result=${(int)result} (expected 42)`, @scratch)) !>;
            } else {
                a_wins++;
            }
        } else if (winner == 1) {
            if (result != 99) {
                errors++;
                eprintln(@string(`  iter ${iter}: winner=1 but result=${(int)result} (expected 99)`, @scratch)) !>;
            } else {
                b_wins++;
            }
        } else {
            errors++;
            eprintln(@string(`  iter ${iter}: invalid winner=${winner}`, @scratch)) !>;
        }
        
        if ((iter + 1) % 10 == 0) {
            println(@string(`  completed ${iter + 1}/${ITERATIONS} (a=${a_wins}, b=${b_wins}, err=${errors})`, @scratch)) !>;
        }
    }
    
    println(@string(`
Results: task_a_wins=${a_wins}, task_b_wins=${b_wins}, errors=${errors}`, @scratch)) !>;
    
    if (errors > 0) {
        eprintln(@string(`FAIL: ${errors} errors`, @scratch)) !>;
        return 1;
    }
    
    println(@string(`block_race_timing: PASS (correctness verified)`, @scratch)) !>;
    return 0;
}
/*
 * Mixed lifetimes the arena way — separate arenas as lifetime annotations.
 *
 * Same which-objects-live as arena_mixed_lifetime_bench (same seed / free set):
 *   ephemeral slots → scratch arena
 *   survivors       → keep arena
 *
 * Mid-life reclaim is scratch.reset()/free (bulk), not per-object release.
 * Grow survivors on keep, then keep.reset()/free.
 *
 * Contrast: arena_mixed_lifetime_bench packs both lifetimes in one arena and
 * uses cc_arena_release (escape hatch). This peer is the intended pattern.
 */
#include <ccc/std/prelude.cch>
#include <ccc/cc_arena.cch>
#include "mem_sample.h"
#include <ccc/stdio.cch>
#include <stdlib.h>
#include <string.h>
#include <stdint.h>
#include <sys/types.h>
#include <time.h>

static size_t env_zu(const char *k, size_t d) {
    const char *v = getenv(k);
    if (!v || !*v) return d;
    return (size_t)strtoull(v, NULL, 10);
}

static double now_ms(void) {
    struct timespec ts;
    clock_gettime(CLOCK_MONOTONIC, &ts);
    return (double)ts.tv_sec * 1e3 + (double)ts.tv_nsec * 1e-6;
}

static size_t item_size(size_t i) {
    return 24 + (i * 17) % 400;
}

static uint32_t lcg(uint32_t *s) {
    *s = (*s * 1664525u) + 1013904223u;
    return *s;
}

int main(void) {
    @errhandler(CCError e) { cc_error_log(e); return 1; }
    size_t n = env_zu("MIX_LIFE_N", 200000);
    /* Equal-budget default: total root bytes split across scratch+keep.
     * Harness sets MIX_LIFE_TOTAL_ROOT; each half is one lifetime annotation. */
    size_t total_root = env_zu("MIX_LIFE_TOTAL_ROOT", 32u * 1024u * 1024u);
    size_t half = total_root / 2;
    if (half == 0) half = 16u * 1024u * 1024u;
    size_t scratch_root = env_zu("MIX_LIFE_SCRATCH_ROOT", half);
    size_t keep_root = env_zu("MIX_LIFE_KEEP_ROOT", half);
    uint32_t seed = (uint32_t)env_zu("MIX_LIFE_SEED", 0xC0FFEEu);
    unsigned char **ptrs;
    uint32_t *sizes;
    uint8_t *alive;
    uint8_t *ephemeral; /* 1 = allocated in scratch (dies mid-run) */
    size_t *order;
    size_t i;
    size_t freed = 0;
    size_t live = 0;
    size_t peak_live = 0;
    size_t n_eph = 0;
    size_t n_keep = 0;
    double t0;
    double alloc_ms = 0;
    double midfree_ms = 0;
    double grow_ms = 0;
    double reclaim_ms = 0;
    double total_ms = 0;
    size_t rss0 = 0;
    size_t sampled_peak = 0;
    size_t best_peak = 0;
    size_t rss1 = 0;
    size_t cgroup_peak = 0;
    volatile size_t sink = 0;
    uint32_t rng = seed;
    StressMemSample m0;
    StressMemSample m1;
    size_t scratch_gross = 0;
    size_t keep_gross = 0;

    ptrs = (unsigned char **)calloc(n, sizeof(*ptrs));
    sizes = (uint32_t *)calloc(n, sizeof(*sizes));
    alive = (uint8_t *)calloc(n, 1);
    ephemeral = (uint8_t *)calloc(n, 1);
    order = (size_t *)malloc(n * sizeof(size_t));
    if (!ptrs || !sizes || !alive || !ephemeral || !order) return 1;

    /* Same scramble as arena_release peer: first n/2 in shuffle are ephemeral. */
    for (i = 0; i < n; i++) order[i] = i;
    for (i = n; i > 1; i--) {
        size_t j = (size_t)(lcg(&rng) % i);
        size_t tmp = order[i - 1];
        order[i - 1] = order[j];
        order[j] = tmp;
    }
    for (i = 0; i < n / 2; i++) ephemeral[order[i]] = 1;

    println(@string(`mixed_lifetime(cc arena_split): n=${n} scratch_root=${scratch_root} keep_root=${keep_root} seed=${seed}`, @scratch));

    m0 = stress_mem_sample();
    rss0 = m0.ok ? m0.current : 0;
    sampled_peak = rss0;
    t0 = now_ms();

    {
        CCArena scratch = cc_arena_heap(scratch_root);
        CCArena keep = cc_arena_heap(keep_root);
        double t;

        if (!cc_arena_is_live(scratch) || !cc_arena_is_live(keep)) {
            scratch.destroy();
            keep.destroy();
            return 2;
        }

        t = now_ms();
        for (i = 0; i < n; i++) {
            size_t sz = item_size(i);
            CCArena *dest = ephemeral[i] ? &scratch : &keep;
            ptrs[i] = (unsigned char *)cc_arena_alloc(*dest, sz, 8);
            if (!ptrs[i]) {
                scratch.destroy();
                keep.destroy();
                return 3;
            }
            ptrs[i][0] = (unsigned char)i;
            sink ^= ptrs[i][0];
            sizes[i] = (uint32_t)sz;
            alive[i] = 1;
            live++;
            if (ephemeral[i]) n_eph++;
            else n_keep++;
        }
        alloc_ms = now_ms() - t;
        peak_live = live;
        scratch_gross = cc_arena_committed_gross_bytes(scratch);
        keep_gross = cc_arena_committed_gross_bytes(keep);
        {
            StressMemSample m = stress_mem_sample();
            if (m.ok && m.current > sampled_peak) sampled_peak = m.current;
        }

        /* Mid-life: drop the entire ephemeral lifetime — one reset, not N/2 releases. */
        t = now_ms();
        cc_arena_reset(scratch);
        for (i = 0; i < n; i++) {
            if (!ephemeral[i] || !alive[i]) continue;
            alive[i] = 0;
            ptrs[i] = NULL;
            live--;
            freed++;
        }
        midfree_ms = now_ms() - t;

        t = now_ms();
        for (i = 0; i < n; i++) {
            size_t want;
            void *np;
            if (!alive[i]) continue;
            want = (size_t)sizes[i] + 48 + (i % 64);
            np = cc_arena_realloc(keep, keep, ptrs[i], sizes[i], want, 8);
            if (!np) {
                scratch.destroy();
                keep.destroy();
                return 4;
            }
            ptrs[i] = (unsigned char *)np;
            ptrs[i][0] = (unsigned char)(i ^ 0x5a);
            sink ^= ptrs[i][0];
            sizes[i] = (uint32_t)want;
        }
        grow_ms = now_ms() - t;
        {
            StressMemSample m = stress_mem_sample();
            if (m.ok && m.current > sampled_peak) sampled_peak = m.current;
        }

        t = now_ms();
        cc_arena_reset(keep);
        scratch.destroy();
        keep.destroy();
        reclaim_ms = now_ms() - t;
        live = 0;
    }

    total_ms = now_ms() - t0;
    m1 = stress_mem_sample();
    rss1 = m1.ok ? m1.current : 0;
    best_peak = stress_mem_best_peak(&m1, sampled_peak);
    cgroup_peak = m1.cgroup_ok ? m1.cgroup_peak : 0;

    size_t hwm_out = m1.hwm_ok ? m1.hwm : 0;
    println(@string(`RESULT lang=cc strategy=arena_split n=${n} freed=${freed} peak_live=${peak_live} total_root=${total_root} scratch_root=${scratch_root} keep_root=${keep_root} eph=${n_eph} keep=${n_keep} scratch_gross=${scratch_gross} keep_gross=${keep_gross} alloc_ms=$~float_dec(3){alloc_ms} midfree_ms=$~float_dec(3){midfree_ms} grow_ms=$~float_dec(3){grow_ms} reclaim_ms=$~float_dec(3){reclaim_ms} total_ms=$~float_dec(3){total_ms} rss_peak_delta=${(ssize_t)best_peak - (ssize_t)rss0} rss_end_delta=${(ssize_t)rss1 - (ssize_t)rss0} hwm=${hwm_out} cgroup_peak=${cgroup_peak} sink=${(size_t)sink}`, @scratch));

    free(ptrs);
    free(sizes);
    free(alive);
    free(ephemeral);
    free(order);
    return 0;
}
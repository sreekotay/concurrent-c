/* A @switch nested in a case resolves its `.arm` labels against its own
 * subject, not the outer one. */
#include <ccc/std/prelude.cch>
#include <stdio.h>

typedef struct B { int n; } B;
@variant K { num: int; box: B; };
typedef struct N { int s; K k; } N;
@variant W { leaf: int; node: N*; };

static int classify(W* w) {
    int r = -1;
    @switch (w) {
        case .leaf(v): r = v; break;
        case .node(n):
            @switch (n->k) {
                case .num(v): r = v * 10; break;
                default: break;
            }
            break;
    }
    return r;
}

int main(void) {
    N n;
    W a = { .leaf = 7 };
    W b;
    n.s = 0;
    n.k = { .num = 4 };
    b = (W){ .node = &n };
    printf("%d %d\n", classify(&a), classify(&b));
    return 0;
}

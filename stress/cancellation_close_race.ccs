/*
 * Stress Test: Cancellation and Channel Close Races
 *
 * Tests:
 * - cc_task_intptr_cancel() under load (via cc_block_race)
 * - Channel close() while send/recv in flight
 */
#include <ccc/cc_runtime.cch>
#include <ccc/cc_atomic.cch>
#include <ccc/stdio.cch>

#define NUM_ROUNDS 10
#define TASKS_PER_ROUND 8

cc_atomic_int g_cancelled = 0;
cc_atomic_int g_completed = 0;
cc_atomic_int g_close_errors = 0;

/* Slow task that can be cancelled */
@async int slow_work(int id) {
    int sum = 0;
    for (int i = 0; i < 10000; i++) {
        sum += (id + i) % 17;
    }
    return sum;
}

/* Test 1: cc_block_race cancellation under load */
int test_race_cancellation(void) {
    println(@string(`  race_cancellation: ${NUM_ROUNDS} rounds x ${TASKS_PER_ROUND} tasks`, @scratch)) !>;
    
    for (int round = 0; round < NUM_ROUNDS; round++) {
        CCTaskIntptr tasks[TASKS_PER_ROUND];
        
        for (int i = 0; i < TASKS_PER_ROUND; i++) {
            tasks[i] = slow_work(round * TASKS_PER_ROUND + i);
        }
        
        int winner;
        intptr_t result;
        int err = cc_block_race(TASKS_PER_ROUND, tasks, &winner, &result);
        
        if (err != 0) {
            println(@string(`  race_cancellation: round ${round} failed err=${err}`, @scratch)) !>;
            return 1;
        }
        
        cc_atomic_fetch_add(&g_completed, 1);
        cc_atomic_fetch_add(&g_cancelled, TASKS_PER_ROUND - 1);
    }
    
    println(@string(`  race_cancellation: completed=${cc_atomic_load(&g_completed)}, cancelled=${cc_atomic_load(&g_cancelled)}`, @scratch)) !>;
    return 0;
}

/* Test 2: Channel close while recv is waiting */
int test_close_while_recv(void) {
    @errhandler(CCError e) cc_error_exit(e);
    println(@string(`  close_while_recv: testing close() interrupts blocking recv`, @scratch)) !>;
    
    cc_atomic_store(&g_close_errors, 0);
    
    for (int round = 0; round < 10; round++) {
        int[~4 >] tx;
        int[~4 <] rx;
        CCChan* ch = cc_channel_pair(&tx, &rx);
        
        /* Note: We need TWO spawns - one to recv, one to close.
           The closing(tx) clause runs AFTER children, which would deadlock.
           Instead, have a sibling spawn close the channel. */
        {
            CCNursery __cc_nursery110 = @create() !> @destroy;

            __cc_nursery110.spawn(() => {
                int val;
                if (!cc_io_avail(chan_recv(rx, &val))) {
                    cc_atomic_fetch_add(&g_close_errors, 1);
                }
            }) !>;
            
            __cc_nursery110.spawn(() => {
                /* Small delay to ensure recv is waiting */
                for (int i = 0; i < 1000; i++) { }
                chan_close(tx);
            }) !>;
        
        }
        
        ch.free();
    }
    
    int close_errors = cc_atomic_load(&g_close_errors);
    println(@string(`  close_while_recv: recv-after-close errors=${close_errors} (expected ~10)`, @scratch)) !>;
    return (close_errors >= 5) ? 0 : 1;
}

/* Test 3: Concurrent close - multiple threads closing same channel */
int test_concurrent_close(void) {
    @errhandler(CCError e) cc_error_exit(e);
    println(@string(`  concurrent_close: multiple threads racing to close`, @scratch)) !>;
    
    for (int round = 0; round < NUM_ROUNDS; round++) {
        int[~4 >] tx;
        int[~4 <] rx;
        CCChan* ch = cc_channel_pair(&tx, &rx);
        
        {
            CCNursery __cc_nursery111 = @create() !> @destroy;

            __cc_nursery111.spawn(() => { chan_close(tx); }) !>;
            __cc_nursery111.spawn(() => { chan_close(tx); }) !>;
            __cc_nursery111.spawn(() => { chan_close(tx); }) !>;
            __cc_nursery111.spawn(() => { chan_close(tx); }) !>;
        
        }
        
        ch.free();
    }
    
    println(@string(`  concurrent_close: ${NUM_ROUNDS} rounds completed`, @scratch)) !>;
    return 0;
}

int main(void) {
    @errhandler(CCError e) { cc_error_log(e); return 1; }
    println(@string(`cancellation_close_race: starting`, @scratch)) !>;
    
    int err = 0;
    
    err = test_race_cancellation();
    if (err != 0) return err;
    
    err = test_close_while_recv();
    if (err != 0) return err;
    
    err = test_concurrent_close();
    if (err != 0) return err;
    
    println(@string(`cancellation_close_race: PASS`, @scratch)) !>;
    return 0;
}
/*
 * Minimal test: spawn a single fiber and wait for it.
 * This isolates the core spawn/join race condition.
 */
#include <ccc/cc_runtime.cch>
#include <ccc/stdio.cch>

#define ITERATIONS 1000

cc_atomic_int g = 0;

int main(void) {
    @errhandler(CCError e) cc_error_exit(e);
    println(@string(`minimal_spawn_race: testing basic spawn/join`, @scratch));
    
    for (int i = 0; i < ITERATIONS; i++) {
        int x = i;
        {
            CCNursery __cc_nursery130 = @create() !> @destroy;

            __cc_nursery130.spawn (() => [x] {
                cc_atomic_store(&g, x);
            }) !>;
        
        }
        
        if ((i + 1) % 100 == 0) {
            println(@string(`  completed ${i + 1}/${ITERATIONS} (g=${cc_atomic_load(&g)})`, @scratch));
        }
    }
    
    println(@string(`minimal_spawn_race: PASS (${ITERATIONS} iterations)`, @scratch));
    return 0;
}
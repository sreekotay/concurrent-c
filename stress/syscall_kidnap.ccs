/*
 * syscall_kidnap.ccs - The "Neckbeard Challenge" for M:N Scheduling
 * 
 * This test simulates "rude" blocking IO that doesn't use the CC runtime's
 * async IO wrappers. It tests if the scheduler can survive when its OS threads
 * are kidnapped by blocking syscalls.
 */

#include <ccc/cc_runtime.cch>
#include <ccc/cc_nursery.cch>
#include <ccc/std/prelude.cch>
#include <ccc/stdio.cch>
#include <stdlib.h>
#include <unistd.h>
#include <time.h>
#include <stdatomic.h>

#define NUM_KIDNAPPERS 100    // 100 kidnappers on 16 workers — same across all implementations
#define HEARTBEAT_INTERVAL_MS 100
#define TEST_DURATION_SEC 3

atomic_int g_heartbeats = 0;
atomic_int g_kidnappers_active = 0;
atomic_int g_kidnappers_done = 0;

/* A "Heartbeat" fiber that should keep ticking if the scheduler is healthy.
 * Uses raw nanosleep (not cc_sleep_ms) to match the kidnappers: both the
 * heartbeat and the kidnappers now block their worker thread in the kernel.
 * The only thing keeping the heartbeat alive is the scheduler's ability to
 * free up a worker thread (or spawn a new one) in the face of 100 kidnappers.
 *
 * cancel still needs to work: after the parent nursery is cancelled, the
 * heartbeat exits its loop on the next wake. */
void heartbeat_fiber() {
    @errhandler(CCError e) { cc_error_log(e); return; }
    setvbuf(stdout, NULL, _IONBF, 0);
    struct timespec t0;
    clock_gettime(CLOCK_MONOTONIC, &t0);
    println(@string(`[Heartbeat] Started`, @scratch));
    struct timespec ts = { .tv_sec = 0, .tv_nsec = HEARTBEAT_INTERVAL_MS * 1000000L };
    while (!cc_cancelled()) {
        nanosleep(&ts, NULL);
        struct timespec now;
        clock_gettime(CLOCK_MONOTONIC, &now);
        double ms = (double)(now.tv_sec - t0.tv_sec) * 1000.0
                  + (double)(now.tv_nsec - t0.tv_nsec) / 1e6;
        int n = atomic_fetch_add(&g_heartbeats, 1) + 1;
        println(@string(`[Heartbeat] Tick ${n} @ $~float_dec(1){ms}ms`, @scratch));
    }
    println(@string(`[Heartbeat] Cancelled, exiting`, @scratch));
}

/* A "Kidnapper" fiber that uses a RAW blocking syscall (sleep) */
void kidnapper_fiber(int id) {
    @errhandler(CCError e) { cc_error_log(e); return; }
    setvbuf(stdout, NULL, _IONBF, 0);
    atomic_fetch_add(&g_kidnappers_active, 1);
    println(@string(`[Kidnapper ${id}] Kidnapping an OS thread for 2 seconds...`, @scratch));
    
    // Do the work (blocking syscall)
    sleep(2); 
    
    println(@string(`[Kidnapper ${id}] Released OS thread`, @scratch));
    atomic_fetch_sub(&g_kidnappers_active, 1);
    atomic_fetch_add(&g_kidnappers_done, 1);
    
    // Pattern: (cancelled && no_work) => exit
    // We just finished our work. If cancelled, don't take new work.
    // (In this test, each kidnapper only does one unit of work anyway)
}

int main(void) {
    @errhandler(CCError e) cc_error_exit(e);
    setvbuf(stdout, NULL, _IONBF, 0);
    // Ensure we have a fixed number of workers for the test
    setenv("CC_V2_THREADS", "16", 1);
    
    println(@string(`=================================================================`, @scratch));
    println(@string(`KIDNAPPING CHALLENGE: Can the CC Scheduler survive rude IO?`, @scratch));
    println(@string(`Workers: 16 | Kidnappers: ${NUM_KIDNAPPERS}`, @scratch));
    println(@string(`=================================================================
`, @scratch)) !>;

    {
        CCNursery __cc_nursery148 = @create() !> @destroy;

        // 1. No warmup. Heartbeat and kidnappers race for workers from T=0.
        __cc_nursery148.spawnhybrid(() => { heartbeat_fiber(); }) !>;

        println(@string(`
!!! Unleashing Kidnappers !!!`, @scratch)) !>;
        for (int i = 0; i < NUM_KIDNAPPERS; i++) {
            int id = i;
            __cc_nursery148.spawnhybrid(() => [id] { kidnapper_fiber(id); }) !>;
        }

        // 4. Monitor heartbeats while kidnappers are active (kidnappers block for 2s each)
        for (int i = 0; i < TEST_DURATION_SEC; i++) {
            cc_sleep_ms(1000);
            int beats = atomic_load(&g_heartbeats);
            int active = atomic_load(&g_kidnappers_active);
            println(@string(`T+${i+1}s: Heartbeats=${beats} | Active Kidnappers=${active}`, @scratch));
        }

        // 5. Cancel the nursery - signals all fibers to stop
        println(@string(`Cancelling nursery...=========================================`, @scratch));
        __cc_nursery148.cancel();
    
    }

    int final_beats = atomic_load(&g_heartbeats);
    int final_done = atomic_load(&g_kidnappers_done);
    int final_active = atomic_load(&g_kidnappers_active);
    println(@string(`
=================================================================`, @scratch)) !>;
    println(@string(`FINAL RESULTS`, @scratch));
    println(@string(`Total Heartbeats:       ${final_beats}`, @scratch));
    println(@string(`Kidnappers Completed:   ${final_done} / ${NUM_KIDNAPPERS}`, @scratch));
    println(@string(`Kidnappers Still Active:${final_active}`, @scratch));
    
    if (final_beats > (TEST_DURATION_SEC * (1000/HEARTBEAT_INTERVAL_MS)) * 0.8) {
        println(@string(`RESULT: PASS - The scheduler survived the kidnapping!`, @scratch));
    } else {
        println(@string(`RESULT: FAIL - The scheduler was bricked by blocking IO.`, @scratch));
    }
    println(@string(`=================================================================`, @scratch));

    return 0;
}
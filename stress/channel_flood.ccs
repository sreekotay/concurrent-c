/*
 * Stress Test: Channel Flood
 *
 * Many producers flooding messages to a single consumer.
 * Tests channel backpressure and throughput under contention.
 */
#include <ccc/cc_runtime.cch>
#include <ccc/cc_atomic.cch>
#include <ccc/stdio.cch>

cc_atomic_int g_received = 0;

int main(void) {
    @errhandler(CCError e) cc_error_exit(e);
    int num_producers = 4;
    int msgs_per = 25;
    int total_msgs = num_producers * msgs_per;
    
    /* Use unbuffered channel */
    int[~ >] tx;
    int[~ <] rx;
    CCChan* ch = cc_channel_pair(&tx, &rx);

    println(@string(`channel_flood: ${num_producers} producers x ${msgs_per} msgs = ${total_msgs} total`, @scratch)) !>;

    {
        CCNursery __cc_nursery114 = @create() !> @destroy;

        /* Consumer */
        __cc_nursery114.spawn(() => {
            int v;
            while (cc_io_avail(chan_recv(rx, &v))) {
                cc_atomic_fetch_add(&g_received, 1);
            }
        }) !>;

        /* Producers */
        {
            CCNursery __cc_nursery115 = @create() !> @destroy;
            (void)__cc_nursery115.close_on(tx);

            for (int p = 0; p < num_producers; p++) {
                int n = msgs_per;  /* Capture local copy */
                __cc_nursery115.spawn(() => [n] {
                    for (int i = 0; i < n; i++) {
                        (void)chan_send(tx, i);
                    }
                }) !>;
            }
        
        }
    
    }

    ch.free();

    int recv_count = cc_atomic_load(&g_received);
    println(@string(`channel_flood: received ${recv_count}/${total_msgs}`, @scratch)) !>;
    return (recv_count == total_msgs) ? 0 : 1;
}
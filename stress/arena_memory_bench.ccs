/*
 * Concurrent-C peer for stress/compare_arena_memory.sh
 *
 * Heavy fair protocol: tip rounds, large-root bulk, overflow escape, reset, churn.
 */
#include <ccc/std/prelude.cch>
#include <ccc/cc_arena.cch>
#include <ccc/stdio.cch>
#include <stdlib.h>
#include <string.h>
#include <stdint.h>
#include <time.h>

static size_t env_zu(const char *k, size_t d) {
    const char *v = getenv(k);
    if (!v || !*v) return d;
    return (size_t)strtoull(v, NULL, 10);
}

static double now_ms(void) {
    struct timespec ts;
    clock_gettime(CLOCK_MONOTONIC, &ts);
    return (double)ts.tv_sec * 1e3 + (double)ts.tv_nsec * 1e-6;
}

static size_t bulk_size(size_t i) {
    return 16 + (i * 17) % 240;
}

int main(void) {
    @errhandler(CCError e) { cc_error_log(e); return 1; }
    size_t tip_rounds = env_zu("ARENA_MEM_TIP_ROUNDS", 400);
    size_t tip_steps = env_zu("ARENA_MEM_TIP_STEPS", 5000);
    size_t tip_root = env_zu("ARENA_MEM_TIP_ROOT", 8u * 1024u * 1024u);
    size_t bulk_n = env_zu("ARENA_MEM_BULK", 2000000);
    size_t bulk_root = env_zu("ARENA_MEM_BULK_ROOT", 64u * 1024u * 1024u);
    size_t ovf_n = env_zu("ARENA_MEM_OVF", 200000);
    size_t ovf_root = env_zu("ARENA_MEM_OVF_ROOT", 4096);
    size_t churn_n = env_zu("ARENA_MEM_CHURN", 1000);
    size_t churn_each = env_zu("ARENA_MEM_CHURN_EACH", 128);
    /* 0 = unbounded extents (2-tier grow); 1 = fixed+ovf (2-tier spill);
     * N>1 = budget then ovf (3-tier). Default matches cc_arena_heap. */
    unsigned block_max = (unsigned)env_zu("ARENA_MEM_BLOCK_MAX", CC_ARENA_DEFAULT_BLOCK_MAX);
    size_t i;
    size_t j;
    size_t r;
    size_t moves = 0;
    size_t sz = 0;
    unsigned char *p = NULL;
    double tip_ms = 0;
    double bulk_ms = 0;
    double ovf_ms = 0;
    double reset_ms = 0;
    double churn_ms = 0;
    size_t bulk_gross = 0;
    size_t bulk_ovf = 0;
    size_t ovf_gross = 0;
    size_t ovf_bytes = 0;
    double t0 = 0;
    volatile size_t sink = 0;

    println(@string(`arena_memory_bench(cc): tip=${tip_rounds}x${tip_steps} bulk=${bulk_n} ovf=${ovf_n} block_max=${block_max}`, @scratch)) !>;

    {
        CCArena tip = cc_arena_heap(tip_root);
        tip.a->block_max = (uint16_t)block_max;
        t0 = now_ms();
        for (r = 0; r < tip_rounds; r++) {
            p = NULL;
            sz = 0;
            for (i = 0; i < tip_steps; i++) {
                size_t want = sz + 16 + (i % 17);
                /* Single-owner tip: local tier (peer bumps are non-atomic too). */
                void *np = cc_arena_realloc_local_grow(tip, p, sz, want, 8);
                if (!np) {
                    tip.destroy();
                    return 2;
                }
                if (p && np != p) moves++;
                p = (unsigned char *)np;
                p[sz] = (unsigned char)i;
                sz = want;
            }
            sink ^= (size_t)p[0] + sz;
            cc_arena_reset(tip);
        }
        tip.destroy();
        tip_ms = now_ms() - t0;
    }

    /* bulk_ms / ovf_ms are full ownership: allocate + reclaim. */
    {
        CCArena bulk = cc_arena_heap(bulk_root);
        double t_reset;
        bulk.a->block_max = (uint16_t)block_max;
        t0 = now_ms();
        for (i = 0; i < bulk_n; i++) {
            size_t n = bulk_size(i);
            unsigned char *q = (unsigned char *)cc_arena_alloc_local_grow(bulk, n, 8);
            if (!q) {
                bulk.destroy();
                return 4;
            }
            q[0] = (unsigned char)i;
            sink ^= q[0];
        }
        bulk_gross = cc_arena_committed_gross_bytes(bulk);
        bulk_ovf = cc_arena_overflow_raw_bytes(bulk);
        t_reset = now_ms();
        cc_arena_reset(bulk);
        reset_ms = now_ms() - t_reset;
        bulk.destroy();
        bulk_ms = now_ms() - t0;
    }

    {
        CCArena ovf = cc_arena_heap(ovf_root);
        ovf.a->block_max = (uint16_t)block_max;
        t0 = now_ms();
        for (i = 0; i < ovf_n; i++) {
            size_t n = 24 + (i * 17) % 512;
            unsigned char *q = (unsigned char *)cc_arena_alloc(ovf, n, 8);
            if (!q) {
                ovf.destroy();
                return 6;
            }
            q[0] = (unsigned char)i;
            sink ^= q[0];
        }
        ovf_gross = cc_arena_committed_gross_bytes(ovf);
        ovf_bytes = cc_arena_overflow_raw_bytes(ovf);
        ovf.destroy(); /* reclaim extents + overflow inside ovf_ms */
        ovf_ms = now_ms() - t0;
    }

    t0 = now_ms();
    for (i = 0; i < churn_n; i++) {
        CCArena c = cc_arena_heap(16 * 1024);
        c.a->block_max = (uint16_t)block_max;
        for (j = 0; j < churn_each; j++) {
            size_t n = 16 + (j * 31) % 256;
            if (!cc_arena_alloc_local_grow(c, n, 8)) {
                c.destroy();
                return 8;
            }
        }
        c.destroy();
    }
    churn_ms = now_ms() - t0;

    size_t sink_out = (size_t)sink;
    println(@string(`RESULT lang=cc block_max=${block_max} tip_ms=$~float_dec(3){tip_ms} tip_moves=${moves} bulk_ms=$~float_dec(3){bulk_ms} bulk_gross=${bulk_gross} bulk_ovf=${bulk_ovf} ovf_ms=${ovf_ms} ovf_gross=${ovf_gross} ovf_bytes=${ovf_bytes} reset_ms=${reset_ms} churn_ms=${churn_ms} sink=${sink_out}`, @scratch)) !>;
    return 0;
}
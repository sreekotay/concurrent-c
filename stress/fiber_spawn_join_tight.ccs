/*
 * Stress test: tight spawn-join loop via nursery
 * 
 * Tests the race between:
 * 1. Spawning a fiber
 * 2. Fiber completing immediately
 * 3. Nursery join racing with completion
 * 
 * The "immediate completion" scenario maximizes the race window.
 */
#include <ccc/cc_runtime.cch>
#include <ccc/stdio.cch>

#define ITERATIONS 50000

cc_atomic_int counter = 0;

void* instant_task(void* arg) {
    (void)arg;
    cc_atomic_fetch_add(&counter, 1);
    return NULL;
}

int main(void) {
    @errhandler(CCError e) cc_error_exit(e);
    println(@string(`fiber_spawn_join_tight: ${ITERATIONS} iterations`, @scratch)) !>;
    
    for (int iter = 0; iter < ITERATIONS; iter++) {
        CCNursery n = cc_nursery_create() !>;
        cc_nursery_spawn(n, instant_task, NULL);
        cc_nursery_wait(n);
        n.free();
        
        if ((iter + 1) % 10000 == 0) {
            println(@string(`  completed ${iter + 1}/${ITERATIONS} (counter=${cc_atomic_load(&counter)})`, @scratch)) !>;
        }
    }
    
    int c = cc_atomic_load(&counter);
    if (c != ITERATIONS) {
        eprintln(@string(`FAIL: counter=${c}, expected=${ITERATIONS}`, @scratch)) !>;
        return 1;
    }
    
    println(@string(`fiber_spawn_join_tight: PASS`, @scratch)) !>;
    return 0;
}
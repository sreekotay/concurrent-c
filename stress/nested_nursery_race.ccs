/*
 * Stress test: nested nursery race condition
 * 
 * Reproduces the pattern from closure_nested_ast_smoke.ccs
 * that fails intermittently under parallel test execution.
 * 
 * Pattern: spawn a closure that creates a nested nursery with another spawn.
 */
#include <ccc/cc_runtime.cch>
#include <ccc/stdio.cch>

#define ITERATIONS 1000

cc_atomic_int g = 0;  /* Must be atomic - accessed from multiple fibers */

int main(void) {
    @errhandler(CCError e) cc_error_exit(e);
    println(@string(`nested_nursery_race: testing nested nursery pattern`, @scratch));
    
    for (int i = 0; i < ITERATIONS; i++) {
        int x = i;
        
        {
            CCNursery __cc_nursery135 = @create() !> @destroy;

            __cc_nursery135.spawn (() => [x] {
                {
                    CCNursery __cc_nursery136 = @create() !> @destroy;

                    __cc_nursery136.spawn (() => [x] { 
                        cc_atomic_store(&g, x); 
                    }) !>;
                
                }
            }) !>;
        
        }
        
        if ((i + 1) % 100 == 0) {
            println(@string(`  completed ${i + 1}/${ITERATIONS} (g=${cc_atomic_load(&g)})`, @scratch));
        }
    }
    
    println(@string(`nested_nursery_race: PASS (${ITERATIONS} iterations)`, @scratch));
    return 0;
}
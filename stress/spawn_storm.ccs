/*
 * Stress Test: Spawn Storm
 *
 * Spawns many concurrent tasks that each do minimal work.
 * Tests nursery spawn overhead and task scheduling.
 */
#include <ccc/cc_runtime.cch>
#include <ccc/cc_atomic.cch>
#include <ccc/stdio.cch>

#define NUM_TASKS 1000

cc_atomic_int g_counter = 0;

int main(void) {
    @errhandler(CCError e) cc_error_exit(e);
    println(@string(`spawn_storm: spawning ${NUM_TASKS} tasks`, @scratch)) !>;

    {
        CCNursery __cc_nursery147 = @create() !> @destroy;

        for (int i = 0; i < NUM_TASKS; i++) {
            __cc_nursery147.spawn(() => {
                cc_atomic_fetch_add(&g_counter, 1);
            }) !>;
        }
    
    }

    int final = cc_atomic_load(&g_counter);
    println(@string(`spawn_storm: completed ${final}/${NUM_TASKS} tasks`, @scratch)) !>;
    return (final == NUM_TASKS) ? 0 : 1;
}
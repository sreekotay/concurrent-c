/*
 * Nested nursery with few iterations - find minimum to trigger bug
 */
#include <ccc/cc_runtime.cch>
#include <ccc/stdio.cch>

#define ITERATIONS 10

cc_atomic_int g = 0;

int main(void) {
    @errhandler(CCError e) cc_error_exit(e);
    println(@string(`nested_few: ${ITERATIONS} iterations`, @scratch)) !>;
    
    for (int i = 0; i < ITERATIONS; i++) {
        int x = i;
        {
            CCNursery __cc_nursery131 = @create() !> @destroy;

            __cc_nursery131.spawn (() => [x] {
                {
                    CCNursery __cc_nursery132 = @create() !> @destroy;

                    __cc_nursery132.spawn (() => [x] {
                        cc_atomic_store(&g, x);
                    }) !>;
                
                }
            }) !>;
        
        }
    }
    
    println(@string(`nested_few: PASS (g=${cc_atomic_load(&g)})`, @scratch)) !>;
    return 0;
}
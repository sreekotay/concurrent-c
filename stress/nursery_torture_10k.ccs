/*
 * nursery_torture_10k.ccs - Extreme Nursery Nesting Test
 *
 * Pushes nursery nesting to 10,000 levels to test metadata overhead
 * and stackless fiber scalability.
 */
#include <ccc/cc_runtime.cch>
#include <ccc/cc_atomic.cch>
#include <ccc/stdio.cch>
#include <stdlib.h>
#include <time.h>

#define TORTURE_DEPTH 10000

cc_atomic_int g_count = 0;

static double time_now_ms(void) {
    struct timespec ts;
    clock_gettime(CLOCK_MONOTONIC, &ts);
    return ts.tv_sec * 1000.0 + ts.tv_nsec / 1000000.0;
}

void recursive_nursery(int depth) {
    @errhandler(CCError e) cc_error_exit(e);
    if (depth >= TORTURE_DEPTH) return;

    {
        CCNursery __cc_nursery141 = @create() !> @destroy;

        __cc_nursery141.spawn(() => {
            cc_atomic_fetch_add(&g_count, 1);
        }) !>;
        
        // Recurse deeper
        recursive_nursery(depth + 1);
    
    }
}

int main(void) {
    @errhandler(CCError e) { cc_error_log(e); return 1; }
    setvbuf(stdout, NULL, _IONBF, 0);
    println(@string(`=================================================================`, @scratch)) !>;
    println(@string(`NURSERY TORTURE: Nesting ${TORTURE_DEPTH} levels deep`, @scratch)) !>;
    println(@string(`=================================================================
`, @scratch)) !>;

    double start = time_now_ms();
    recursive_nursery(0);
    double duration = time_now_ms() - start;

    int final_count = cc_atomic_load(&g_count);
    println(@string(`Completed: ${final_count}/${TORTURE_DEPTH} levels`, @scratch)) !>;
    println(@string(`Total Time: $~float_dec(2){duration} ms ($~float_dec(4){duration / TORTURE_DEPTH} ms per level)`, @scratch)) !>;

    if (final_count == TORTURE_DEPTH) {
        println(@string(`
RESULT: PASS - Nurseries scale linearly to extreme depths!`, @scratch)) !>;
    } else {
        println(@string(`
RESULT: FAIL - Lost some fibers in the abyss.`, @scratch)) !>;
    }
    println(@string(`=================================================================`, @scratch)) !>;

    return 0;
}
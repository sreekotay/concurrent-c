/*
 * Opposite case: cc_arena_malloc (fixed root + per-alloc overflow) under a
 * heavy keep-alive alloc load, vs cc_arena_heap (budget→overflow) and a raw
 * malloc/free-all baseline.
 *
 * This is the durable-map constructor used as if it were request scratch.
 */
#include <ccc/std/prelude.cch>
#include <ccc/cc_arena.cch>
#include <ccc/stdio.cch>
#include <stdlib.h>
#include <string.h>
#include <stdint.h>
#include <time.h>

static size_t env_zu(const char *k, size_t d) {
    const char *v = getenv(k);
    if (!v || !*v) return d;
    return (size_t)strtoull(v, NULL, 10);
}

static double now_ms(void) {
    struct timespec ts;
    clock_gettime(CLOCK_MONOTONIC, &ts);
    return (double)ts.tv_sec * 1e3 + (double)ts.tv_nsec * 1e-6;
}

static size_t bulk_size(size_t i) {
    return 16 + (i * 17) % 240;
}

typedef enum {
    MODE_HEAP = 0,
    MODE_MALLOC_ARENA = 1,
    MODE_RAW = 2
} Mode;

static const char *mode_name(Mode m) {
    if (m == MODE_HEAP) return "heap";
    if (m == MODE_MALLOC_ARENA) return "arena_malloc";
    return "raw_malloc";
}

int run_arena(Mode mode, size_t root, size_t n, volatile size_t *sink) {
    @errhandler(CCError e) { cc_error_log(e); return 1; }
    CCArena a;
    size_t i;
    size_t live = 0;
    size_t gross = 0;
    size_t ovf = 0;
    double t0, alloc_ms, reset_ms, total_ms;
    double t_reset;

    if (mode == MODE_HEAP)
        a = cc_arena_heap(root);
    else
        a = cc_arena_malloc(root);

    if (!cc_arena_is_live(a)) {
        println(@string(`FAIL: ${mode_name(mode)} init`, @scratch));
        return 1;
    }
    if (mode == MODE_MALLOC_ARENA && a.a->block_max != 1) {
        println(@string(`FAIL: cc_arena_malloc block_max=${a.a->block_max} want 1`, @scratch));
        a.destroy();
        return 1;
    }

    t0 = now_ms();
    for (i = 0; i < n; i++) {
        size_t sz = bulk_size(i);
        unsigned char *p = (unsigned char *)cc_arena_alloc(a, sz, 8);
        if (!p) {
            println(@string(`FAIL: ${mode_name(mode)} alloc i=${i}`, @scratch));
            a.destroy();
            return 1;
        }
        p[0] = (unsigned char)i;
        *sink ^= p[0];
        live += sz;
    }
    gross = cc_arena_committed_gross_bytes(a);
    ovf = cc_arena_overflow_raw_bytes(a);
    t_reset = now_ms();
    cc_arena_reset(a);
    reset_ms = now_ms() - t_reset;
    a.destroy();
    total_ms = now_ms() - t0;
    alloc_ms = total_ms - reset_ms;

    unsigned block_max_out = mode == MODE_HEAP ? CC_ARENA_DEFAULT_BLOCK_MAX : 1u;
    println(@string(`RESULT mode=${mode_name(mode)} root=${root} n=${n} live=${live} gross=${gross} ovf=${ovf} alloc_ms=$~float_dec(3){alloc_ms} reset_ms=$~float_dec(3){reset_ms} total_ms=$~float_dec(3){total_ms} block_max=${block_max_out}`, @scratch));
    return 0;
}

int run_raw(size_t n, volatile size_t *sink) {
    @errhandler(CCError e) { cc_error_log(e); return 1; }
    unsigned char **ptrs;
    size_t i;
    size_t live = 0;
    double t0, alloc_ms, reset_ms, total_ms;
    double t_free;

    ptrs = (unsigned char **)malloc(n * sizeof(*ptrs));
    if (!ptrs) return 1;

    t0 = now_ms();
    for (i = 0; i < n; i++) {
        size_t sz = bulk_size(i);
        ptrs[i] = (unsigned char *)malloc(sz);
        if (!ptrs[i]) {
            while (i) free(ptrs[--i]);
            free(ptrs);
            return 1;
        }
        ptrs[i][0] = (unsigned char)i;
        *sink ^= ptrs[i][0];
        live += sz;
    }
    t_free = now_ms();
    for (i = 0; i < n; i++) free(ptrs[i]);
    reset_ms = now_ms() - t_free;
    total_ms = now_ms() - t0;
    alloc_ms = total_ms - reset_ms;
    free(ptrs);

    println(@string(`RESULT mode=raw_malloc root=0 n=${n} live=${live} gross=${live} ovf=0 alloc_ms=$~float_dec(3){alloc_ms} reset_ms=$~float_dec(3){reset_ms} total_ms=$~float_dec(3){total_ms} block_max=0`, @scratch));
    return 0;
}

int main(void) {
    @errhandler(CCError e) { cc_error_log(e); return 1; }
    size_t n = env_zu("ARENA_MALLOC_COST_N", 800000);
    size_t root = env_zu("ARENA_MALLOC_COST_ROOT", 64u * 1024u); /* tiny root → force spill */
    size_t fat_root = env_zu("ARENA_MALLOC_COST_FAT_ROOT", 16u * 1024u * 1024u);
    volatile size_t sink = 0;

    println(@string(`arena_malloc_cost: n=${n} tiny_root=${root} fat_root=${fat_root}`, @scratch));
    println(@string(`  (cc_arena_malloc = fixed root + per-object overflow; no extent growth)`, @scratch));

    /* Opposite cases: durable ctor used as scratch. */
    if (run_arena(MODE_MALLOC_ARENA, root, n, &sink)) return 1;
    if (run_arena(MODE_MALLOC_ARENA, fat_root, n, &sink)) return 2;
    /* Default heap: tiny root still spills; fat root is request-scratch. */
    if (run_arena(MODE_HEAP, root, n, &sink)) return 3;
    if (run_arena(MODE_HEAP, fat_root, n, &sink)) return 4;
    /* Raw malloc keep-alive + free-all. */
    if (run_raw(n, &sink)) return 5;

    println(@string(`arena_malloc_cost: PASS sink=${(size_t)sink}`, @scratch));
    return 0;
}
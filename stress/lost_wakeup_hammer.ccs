/*
 * lost_wakeup_hammer.ccs - Channel Selection Correctness Test
 *
 * This test hammers unbuffered channels with many concurrent selectors
 * and senders. It targets the "Lost Wakeup" bug where a notification
 * is dropped during high contention, leaving a fiber blocked forever.
 */

#include <ccc/cc_runtime.cch>
#include <ccc/cc_atomic.cch>
#include <ccc/stdio.cch>
#include <stdlib.h>
#include <time.h>

#define NUM_FIBERS 50
#define OPS_PER_FIBER 1000
#define TOTAL_OPS (NUM_FIBERS * OPS_PER_FIBER)

cc_atomic_int g_recvs_completed = 0;
cc_atomic_int g_sends_completed = 0;

void selector_fiber(int[~ <] rx1, int[~ <] rx2) {
    for (int i = 0; i < OPS_PER_FIBER; i++) {
        int v;
        do { /* select: recv/recv */
            size_t __cc_match_idx = (size_t)-1;
            int __cc_match_rc = 0;
            CCChanMatchCase __cc_match_cases[2];
            __cc_match_cases[0] = (CCChanMatchCase){ .ch = (rx1).raw, .send_buf = NULL, .recv_buf = (void*)(&v), .elem_size = sizeof(*(&v)), .is_send = false };
            __cc_match_cases[1] = (CCChanMatchCase){ .ch = (rx2).raw, .send_buf = NULL, .recv_buf = (void*)(&v), .elem_size = sizeof(*(&v)), .is_send = false };
            __cc_match_rc = cc_chan_match_select(__cc_match_cases, 2, &__cc_match_idx, cc_current_deadline());
            switch (__cc_match_idx) {
                case 0: { cc_atomic_fetch_add(&g_recvs_completed, 1); }
                    break;
                case 1: { cc_atomic_fetch_add(&g_recvs_completed, 1); }
                    break;
                default: break;
            }
            (void)__cc_match_rc;
        } while(0);
    }
}

void sender_fiber(int[~ >] tx1, int[~ >] tx2) {
    for (int i = 0; i < OPS_PER_FIBER; i++) {
        int val = i;
        if (rand() % 2 == 0) {
            (void)tx1.send(val);
        } else {
            (void)tx2.send(val);
        }
        cc_atomic_fetch_add(&g_sends_completed, 1);
    }
}

int main(void) {
    @errhandler(CCError e) cc_error_exit(e);
    setvbuf(stdout, NULL, _IONBF, 0);
    srand(time(NULL));

    println(@string(`=================================================================`, @scratch)) !>;
    println(@string(`LOST WAKEUP HAMMER: ${NUM_FIBERS * 2} fibers | ${OPS_PER_FIBER} ops each`, @scratch)) !>;
    println(@string(`Targeting unbuffered channel rendezvous contention...`, @scratch)) !>;
    println(@string(`=================================================================
`, @scratch)) !>;

    int[~ >] tx1_h, tx2_h;
    int[~ <] rx1_h, rx2_h;
    cc_channel_pair(&tx1_h, &rx1_h); // Unbuffered by default
    cc_channel_pair(&tx2_h, &rx2_h);

    int[~ >] tx1 = tx1_h; int[~ >] tx2 = tx2_h;
    int[~ <] rx1 = rx1_h; int[~ <] rx2 = rx2_h;

    {
        CCNursery __cc_nursery129 = @create() !> @destroy;

        // 1. Start Selectors
        for (int i = 0; i < NUM_FIBERS; i++) {
            CCChanRx r1 = rx1;
            CCChanRx r2 = rx2;
            __cc_nursery129.spawn(() => [r1, r2] { selector_fiber(r1, r2); }) !>;
        }

        // 2. Start Senders
        for (int i = 0; i < NUM_FIBERS; i++) {
            CCChanTx t1 = tx1;
            CCChanTx t2 = tx2;
            __cc_nursery129.spawn(() => [t1, t2] { sender_fiber(t1, t2); }) !>;
        }
        
        // 3. Monitor progress with a timeout
        int last_count = 0;
        int stalled_iters = 0;
        while (cc_atomic_load(&g_recvs_completed) < TOTAL_OPS) {
            cc_sleep_ms(500);
            int current = cc_atomic_load(&g_recvs_completed);
            cc_fprint(STDOUT_FILENO, @string(`
Progress: ${current}/${TOTAL_OPS} operations...`, @scratch)) !>;
            
            if (current == last_count) {
                stalled_iters++;
                if (stalled_iters > 10) { // 5 seconds of no progress
                    println(@string(`

!!! HANG DETECTED !!!`, @scratch)) !>;
                    println(@string(`Possible Lost Wakeup bug in channel selection.`, @scratch)) !>;
                    println(@string(`Sends completed: ${cc_atomic_load(&g_sends_completed)}`, @scratch)) !>;
                    println(@string(`Recvs completed: ${current}`, @scratch)) !>;
                    exit(1);
                }
            } else {
                last_count = current;
                stalled_iters = 0;
            }
        }
    
    }

    println(@string(`

RESULT: PASS - All ${TOTAL_OPS} operations completed without a hang.`, @scratch)) !>;
    println(@string(`=================================================================`, @scratch)) !>;

    return 0;
}
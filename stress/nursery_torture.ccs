/*
 * nursery_torture.ccs - The "Deep Nursery" Challenge
 * 
 * This test pushes Concurrent-C's structured concurrency to the limit by
 * creating a recursive tree of nurseries. 
 */

#include <ccc/cc_runtime.cch>
#include <ccc/cc_atomic.cch>
#include <ccc/stdio.cch>
#include <stdlib.h>

#define TORTURE_DEPTH 10000

cc_atomic_int g_completed_levels = 0;

void torture_nesting(int depth) {
    @errhandler(CCError e) cc_error_exit(e);
    if (depth >= TORTURE_DEPTH) return;

    {
        CCNursery __cc_nursery140 = @create() !> @destroy;

        __cc_nursery140.spawn(() => {
            cc_atomic_fetch_add(&g_completed_levels, 1);
        }) !>;

        // Recurse! Each level is a new nursery scope.
        torture_nesting(depth + 1);
    
    }
}

int main(void) {
    @errhandler(CCError e) { cc_error_log(e); return 1; }
    println(@string(`=================================================================`, @scratch));
    println(@string(`NURSERY TORTURE: Nesting ${TORTURE_DEPTH} levels of nurseries`, @scratch));
    println(@string(`=================================================================
`, @scratch)) !>;

    torture_nesting(0);

    int total = cc_atomic_load(&g_completed_levels);
    println(@string(`
Final Result: ${total}/${TORTURE_DEPTH} levels completed.`, @scratch)) !>;

    if (total == TORTURE_DEPTH) {
        println(@string(`RESULT: PASS - The runtime handled extreme nesting!`, @scratch));
    } else {
        println(@string(`RESULT: FAIL - Some levels were lost or the runtime crashed.`, @scratch));
    }
    println(@string(`=================================================================`, @scratch));

    return 0;
}
/* cc-python: the generic Python bridge for Node.
 *
 *     const py = require('cc-python').create();   // an Isolation Domain
 *     const np = py.import('numpy');
 *     const s  = np.array([1, 2, 3]).sum();
 *     py.destroy();                                // one sweep: everything
 *
 * The addon exposes primitive operations (create / import / getattr /
 * invoke / release / destroy) over opaque handles; index.js wraps them
 * in a Proxy so attribute chains and calls read as ordinary JavaScript.
 *
 * Ownership is the Isolation Domain model: a domain owns its
 * interpreter handle, its arena, and every Python reference minted
 * through it — and everything, the domain struct and the handle boxes
 * included, lives IN the arena; nothing is malloc'd.  Proxies are
 * borrows — each holds a strong JS reference to its domain (index.js),
 * so the GC can only collect the domain when the whole graph is
 * unreachable.  The domain has two distinct lifetimes: destroy() is
 * REVOCATION — Python references released, interpreter closed, every
 * outstanding handle answers "bridge is closed", double destroy a
 * quiet no-op — while the arena's REAL life ends when the last
 * outstanding External (the domain's own or any handle's) is
 * collected: finalizers are bookkeeping decrements, and whichever runs
 * last takes the arena and everything in it down in one free.  Buffers
 * cross as leases: a typed array argument is a zero-copy memoryview
 * pinned for the call, and the py_buf retention check catches a callee
 * that keeps it. */
#include <pthread.h>

#include <ccc/script/js.cch>
#include <ccc/script/py.cch>

typedef struct CcPyDom CcPyDom;
typedef struct CcPyObjBox CcPyObjBox;
typedef struct CcPyJob CcPyJob;
typedef struct CcJsCbBox CcJsCbBox;
typedef struct CcJsCbReq CcJsCbReq;

/* One Python reference owned by a domain.  Boxes live IN the domain's
 * arena — nothing about a domain is malloc'd — and recycle through a
 * free list once their External is collected, so a long-lived domain's
 * arena is bounded by its peak simultaneous handles, not its history. */
struct CcPyObjBox {
    CcPyDom *dom;
    CCPyObj obj;
    CcPyObjBox *next; /* live list; free list after collection */
    CcPyObjBox *prev;
    int released;
};

/* The domain, allocated from its own arena.  Two lifetimes, deliberately
 * distinct: `closed` is REVOCATION (close()/GC sweep — Python refs
 * released, interpreter closed, every op answers articulately), while
 * `ext_outstanding` counts the Externals still alive in JS (the domain's
 * own plus one per box) and is the domain's REAL life: whichever
 * finalizer decrements it to zero destroys the arena, and the domain,
 * its boxes, and everything else it holds go with it in one free. */
/* One queued call in an async domain.  The record is arena-owned and
 * recycled; the JOB owns its Python references (callable + object args,
 * IncRef'd at submit) so release()/close() mid-flight cannot dangle it,
 * and its napi_refs pin every typed-array buffer from submit to
 * completion — the lease spans the job, not a stack frame. */
#define CCPY__JOB_MAX_ARGS 16
/* Everything posted through the tsfn starts with `what`: 0 = job (and
 * the drain sentinel), 1 = a callback request from the lane. */
struct CcPyJob {
    int what; /* 0 */
    CcPyJob *next;
    void *fn; /* owned PyObject*, DecRef'd by the executor */
    CCPyArg args[CCPY__JOB_MAX_ARGS];
    int argc;
    void *buf_refs[CCPY__JOB_MAX_ARGS];
    int nbuf;
    /* result, filled by the executor */
    int rkind; /* 0 f64, 1 i64, 2 bool, 3 str, 4 none, 5 obj, 6 error, 7 drain */
    double rf;
    long long ri;
    const char *rstr; /* exec-arena copy (length rlen) */
    size_t rlen;
    void *robj; /* owned PyObject*; boxed on the main thread */
    char errmsg[240];
    void *deferred; /* settled on the main thread; NULL for the sentinel */
    int rejected; /* drained before running */
};

/* A JS function registered as a Python callable.  Arena-owned and
 * domain-listed; the napi_ref pins the function until REVOCATION (the
 * documented rule: a registered callback pins the domain — destroy()
 * breaks the cycle), deleted at sweep on the main thread. */
struct CcJsCbBox {
    CcPyDom *dom;
    void *fnref;
    CcJsCbBox *next;
    int dead;
};

/* One lane-side callback invocation, stack-allocated in the trampoline:
 * the executor releases the GIL, posts this through the tsfn, and waits;
 * the main thread runs the JS function and fills the tagged result. */
struct CcJsCbReq {
    int what; /* 1 */
    CcJsCbBox *box;
    void *argv[CCPY__JOB_MAX_ARGS]; /* owned PyObject refs; main consumes */
    int argc;
    int done;
    int failed;
    char errmsg[240];
    int rkind; /* 0 f64, 1 i64, 2 bool, 3 str, 4 none, 5 obj */
    double rf;
    long long ri;
    const char *rstr; /* job-arena copy (domain is not idle mid-callback) */
    size_t rlen;
    void *robj; /* owned PyObject, IncRef'd on main under the GIL */
    pthread_cond_t cv; /* signaled under d->mu */
};

struct CcPyDom {
    CCArena arena;
    CCPy py;
    void *none; /* owned builtins.None, for result probing */
    CcPyObjBox *head;
    CcPyObjBox *free_boxes;
    long long live;
    long long ext_outstanding;
    int closed;
    /* ---- async lane (mode 'async' only) ----
     * One executor thread per domain, FIFO: Python is serial under its
     * per-interpreter GIL anyway, so a lane loses nothing within a
     * domain and concurrent DOMAINS parallelize.  Teardown is
     * revoke-then-drain: close marks the lane stopping, queued jobs
     * settle as rejections, the executor detaches its thread state and
     * posts a drain sentinel; the sentinel's completion — after every
     * result has been delivered on the main thread — joins the thread,
     * runs the sweep, and resolves the close promise.  The lane and
     * every in-flight job hold ext_outstanding, so the arena's real
     * life covers work the GC can no longer see. */
    int async_mode;
    pthread_t exec;
    pthread_mutex_t mu;
    pthread_cond_t cv;
    CcPyJob *qhead;
    CcPyJob *qtail;
    CcPyJob *job_free; /* recycled records (domain arena) */
    CCArena job_arena; /* submit-side payloads (main thread writes) */
    CCArena exec_arena; /* result strings (executor writes) */
    int inflight;
    long long pending_done; /* posted to tsfn, not yet delivered */
    int stopping;
    int exec_done;
    void *tsfn;
    void *close_deferred; /* settled by the sentinel's completion */
    int tsfn_reffed;
    CcPyJob sentinel; /* posted once by the exiting executor */
    /* JS-callback bridging */
    CcJsCbBox *cb_head;
    void *main_env; /* the creating thread's env: case-1 calls, ref cleanup */
    pthread_t main_tid;
};

/* The last outstanding External — object or domain, whichever collects
 * last — takes the arena (and the domain inside it) down. */
static void ccpy__dom_unref(CcPyDom *d) {
    if (--d->ext_outstanding > 0) return;
    {
        CCArena tmp = d->arena;
        cc_arena_destroy(&tmp); /* d is inside it — gone now */
    }
}

/* Revocation, shared by close() and the GC finalizer: release every
 * live Python reference and close the interpreter handle.  The arena
 * stays — boxes must outlive their Externals' finalizers — so after
 * this the domain answers only `closed` until its real life ends. */
static void ccpy__dom_sweep(CcPyDom *d) {
    CcPyObjBox *b = d->head;
    /* Refcounts need the interpreter's GIL; on an async domain the
     * executor is already joined by the time the sweep runs, so this
     * acquires without contention. */
    cc__py_attach(&d->py);
    while (b) {
        if (!b->released) {
            cc_py_obj_release(&b->obj);
            b->released = 1;
        }
        b = b->next;
    }
    d->head = NULL;
    d->live = 0;
    /* Callback registrations: deleting the napi_refs needs the main
     * thread's env, and every sweep path runs there. */
    {
        CcJsCbBox *cb = d->cb_head;
        while (cb) {
            if (cb->fnref && d->main_env)
                cc__js.DeleteReference(d->main_env, cb->fnref);
            cb->fnref = NULL;
            cb->dead = 1;
            cb = cb->next;
        }
        d->cb_head = NULL;
    }
    if (d->none) {
        cc__py.DecRef(d->none);
        d->none = NULL;
    }
    cc_py_close(&d->py);
    /* Closing an isolated interpreter leaves the PROCESS interpreter's
     * state current (cc_py_close does that so later releases have a
     * thread state) — which means this thread now HOLDS the process
     * GIL, and another domain's lane would block on it forever.  The
     * bridge's discipline everywhere: never keep a GIL between ops. */
    cc_py_thread_leave();
    d->closed = 1;
}

static void ccpy__obj_finalize(void *env, void *data, void *hint) {
    CcPyObjBox *b = (CcPyObjBox *)data;
    CcPyDom *d;
    (void)env;
    (void)hint;
    if (!b || !b->dom) return;
    d = b->dom;
    if (!d->closed) {
        if (!b->released) {
            if (d->async_mode) cc__py_attach(&d->py);
            cc_py_obj_release(&b->obj);
            b->released = 1;
            if (b->prev) b->prev->next = b->next;
            else d->head = b->next;
            if (b->next) b->next->prev = b->prev;
            d->live--;
        }
        b->next = d->free_boxes;
        d->free_boxes = b;
        if (d->async_mode) cc_py_thread_leave();
    }
    ccpy__dom_unref(d);
}

static void ccpy__lane_close(CcPyDom *d, void *env, void *deferred);

static void ccpy__dom_finalize(void *env, void *data, void *hint) {
    CcPyDom *d = (CcPyDom *)data;
    (void)hint;
    if (!d) return;
    if (d->async_mode && !d->closed) {
        /* Undelivered work may still hold Python references; drain — the
         * sentinel's completion sweeps.  The lane's own hold keeps the
         * arena alive past this unref. */
        ccpy__lane_close(d, env, NULL);
    } else if (!d->closed) {
        ccpy__dom_sweep(d);
    }
    ccpy__dom_unref(d);
}

/* Register a fresh owned reference with the domain.  The box comes from
 * the free list or the arena; the caller mints the External (and the
 * ext_outstanding count) via ccpy__ext_make, or rolls back via
 * ccpy__box_undo if it cannot. */
static CcPyObjBox *ccpy__box(CcPyDom *d, CCPyObj o) {
    CcPyObjBox *b = d->free_boxes;
    if (b) d->free_boxes = b->next;
    else b = (CcPyObjBox *)cc_arena_alloc(&d->arena, sizeof(*b), 16);
    if (!b) {
        cc_py_obj_release(&o);
        return NULL;
    }
    memset(b, 0, sizeof(*b));
    b->dom = d;
    b->obj = o;
    b->next = d->head;
    if (d->head) d->head->prev = b;
    d->head = b;
    d->live++;
    return b;
}

static void ccpy__box_undo(CcPyDom *d, CcPyObjBox *b) {
    cc_py_obj_release(&b->obj);
    if (b->prev) b->prev->next = b->next;
    else d->head = b->next;
    if (b->next) b->next->prev = b->prev;
    d->live--;
    b->next = d->free_boxes;
    d->free_boxes = b;
}

/* Mint the External that carries a box; counting happens ONLY here and
 * in the finalizers, so a creation failure cannot strand the count. */
static int ccpy__ext_make(CcPyDom *d, void *env, CcPyObjBox *b, void **out) {
    if (cc__js.CreateExternal(env, b, ccpy__obj_finalize, NULL, out) != 0)
        return -1;
    d->ext_outstanding++;
    return 0;
}

static int ccpy__result_to_js(CcPyDom *d, void *env, CCPyObj r, void **out);

/* ---- JS callbacks crossing into Python ------------------------------ */

/* PyMethodDef mirror (stable layout since forever). */
typedef struct CcPyMethodDefMirror {
    const char *ml_name;
    void *(*ml_meth)(void *self, void *args);
    int ml_flags;
    const char *ml_doc;
} CcPyMethodDefMirror;
#define CC__PY_METH_VARARGS 0x0001

static void *ccpy__cb_trampoline(void *self, void *args);

static CcPyMethodDefMirror ccpy__cb_def = {
    "cc_js_callback",
    ccpy__cb_trampoline,
    CC__PY_METH_VARARGS,
    "JavaScript function held by a cc-python bridge",
};

/* Pending-exception text, coerced to a string; clears the exception. */
static void ccpy__js_exc_text(void *env, char *buf, size_t cap) {
    void *exc = NULL;
    void *str = NULL;
    size_t got = 0;
    snprintf(buf, cap, "callback threw");
    if (cc__js.GetAndClearLastException(env, &exc) != 0 || !exc) return;
    if (cc__js.CoerceToString(env, exc, &str) != 0 || !str) return;
    if (cc__js.GetValueStringUtf8(env, str, buf, cap, &got) != 0)
        snprintf(buf, cap, "callback threw");
}

/* JS return value -> tagged result (shared by both call paths).  Fills
 * req-style fields via out-pointers; GIL-needing pieces (the handle
 * IncRef) attach around themselves.  Returns 0, or -1 with errmsg. */
static int ccpy__cb_ret_tag(CcPyDom *d, void *env, void *ret, int *rkind,
                            double *rf, long long *ri, const char **rstr,
                            size_t *rlen, void **robj, char *errmsg,
                            size_t errcap) {
    int t = 0;
    if (!ret) {
        *rkind = 4;
        return 0;
    }
    cc__js.Typeof(env, ret, &t);
    switch (t) {
    case CC__JS_T_UNDEFINED:
    case CC__JS_T_NULL:
        *rkind = 4;
        return 0;
    case CC__JS_T_NUMBER: {
        double dd = 0;
        cc__js.GetValueDouble(env, ret, &dd);
        if (dd == (double)(long long)dd && dd >= -9007199254740992.0 &&
            dd <= 9007199254740992.0) {
            *rkind = 1;
            *ri = (long long)dd;
        } else {
            *rkind = 0;
            *rf = dd;
        }
        return 0;
    }
    case CC__JS_T_BOOLEAN: {
        _Bool b = 0;
        cc__js.GetValueBool(env, ret, &b);
        *rkind = 2;
        *ri = b ? 1 : 0;
        return 0;
    }
    case CC__JS_T_STRING: {
        size_t len = 0, got = 0;
        char *copy;
        if (cc__js.GetValueStringUtf8(env, ret, NULL, 0, &len) != 0) break;
        copy = (char *)cc_arena_alloc(&d->job_arena, len + 1, 16);
        if (!copy) break;
        if (cc__js.GetValueStringUtf8(env, ret, copy, len + 1, &got) != 0)
            break;
        *rkind = 3;
        *rstr = copy;
        *rlen = got;
        return 0;
    }
    case CC__JS_T_EXTERNAL: {
        void *pp = NULL;
        CcPyObjBox *b;
        cc__js.GetValueExternal(env, ret, &pp);
        b = (CcPyObjBox *)pp;
        if (!b || b->dom != d || b->released) {
            snprintf(errmsg, errcap, "cc-python: the callback returned a "
                                     "released or foreign handle");
            return -1;
        }
        cc__py_attach(&d->py);
        cc__py.IncRef(b->obj.o);
        *robj = b->obj.o;
        if (d->async_mode) cc_py_thread_leave();
        *rkind = 5;
        return 0;
    }
    case CC__JS_T_OBJECT: {
        _Bool has = 0;
        if (cc__js.HasNamedProperty(env, ret, "then", &has) == 0 && has) {
            snprintf(errmsg, errcap,
                     "cc-python: callbacks are synchronous in v1 — return a "
                     "value, not a Promise");
            return -1;
        }
        break;
    }
    default:
        break;
    }
    snprintf(errmsg, errcap, "cc-python: unsupported callback return (use "
                             "scalars, strings, or bridge handles)");
    return -1;
}

/* Tagged result -> Python value (executor side, GIL held). */
static void *ccpy__cb_tag_to_py(CcPyDom *d, int rkind, double rf, long long ri,
                                const char *rstr, size_t rlen, void *robj) {
    switch (rkind) {
    case 0: return cc__py.FloatFromDouble(rf);
    case 1: return cc__py.LongFromLongLong(ri);
    case 2: return cc__py.BoolFromLong((long)ri);
    case 3: return cc__py.UnicodeFromStringAndSize(rstr, (intptr_t)rlen);
    case 4:
        if (d->none) {
            cc__py.IncRef(d->none);
            return d->none;
        }
        break;
    case 5: return robj; /* already owned */
    default: break;
    }
    return cc__py_raise("cc-python: corrupt callback result");
}

/* Case 1: callback fires on the main thread inside a sync call — plain
 * reentrancy, GIL held throughout except across the JS call itself. */
static void *ccpy__cb_call_main(CcPyDom *d, CcJsCbBox *box, void *args,
                                int n) {
    void *jsargs[CCPY__JOB_MAX_ARGS];
    void *env = d->main_env;
    void *fnv = NULL;
    void *undef = NULL;
    void *ret = NULL;
    int i;
    int rkind = -1;
    double rf = 0;
    long long ri = 0;
    const char *rstr = NULL;
    size_t rlen = 0;
    void *robj = NULL;
    char errmsg[240];
    for (i = 0; i < n; i++) {
        CCPyObj r;
        void *o = cc__py.TupleGetItem(args, (intptr_t)i); /* borrowed */
        cc__py.IncRef(o);
        r.o = o;
        r.home = &d->py;
        if (ccpy__result_to_js(d, env, r, &jsargs[i]) != 0)
            return cc__py_raise("cc-python: cannot marshal a callback "
                                "argument");
    }
    if (cc__js.GetReferenceValue(env, box->fnref, &fnv) != 0 || !fnv)
        return cc__py_raise("cc-python: the callback function is gone");
    cc__js.GetUndefined(env, &undef);
    if (cc__js.CallFunction(env, undef, fnv, (size_t)n, jsargs, &ret) != 0) {
        ccpy__js_exc_text(env, errmsg, sizeof(errmsg));
        return cc__py_raise(errmsg);
    }
    if (ccpy__cb_ret_tag(d, env, ret, &rkind, &rf, &ri, &rstr, &rlen, &robj,
                         errmsg, sizeof(errmsg)) != 0)
        return cc__py_raise(errmsg);
    return ccpy__cb_tag_to_py(d, rkind, rf, ri, rstr, rlen, robj);
}

/* Case 2: callback fires on the lane.  Release the GIL — that is what
 * lets concurrent sync bridge work proceed and the loop stay free to
 * service us — post through the tsfn, wait, reacquire, convert. */
static void *ccpy__cb_call_lane(CcPyDom *d, CcJsCbBox *box, void *args,
                                int n) {
    CcJsCbReq req;
    int i;
    memset(&req, 0, sizeof(req));
    req.what = 1;
    req.box = box;
    req.argc = n;
    for (i = 0; i < n; i++) {
        void *o = cc__py.TupleGetItem(args, (intptr_t)i); /* borrowed */
        cc__py.IncRef(o);
        req.argv[i] = o; /* main consumes these */
    }
    pthread_cond_init(&req.cv, NULL);
    cc_py_thread_leave();
    cc__js.CallTsfn(d->tsfn, &req, 1);
    pthread_mutex_lock(&d->mu);
    while (!req.done) pthread_cond_wait(&req.cv, &d->mu);
    pthread_mutex_unlock(&d->mu);
    pthread_cond_destroy(&req.cv);
    cc__py_attach(&d->py);
    if (req.failed) return cc__py_raise(req.errmsg);
    return ccpy__cb_tag_to_py(d, req.rkind, req.rf, req.ri, req.rstr,
                              req.rlen, req.robj);
}

static void *ccpy__cb_trampoline(void *self, void *args) {
    CcJsCbBox *box =
        cc__py.CapsuleGetPointer
            ? (CcJsCbBox *)cc__py.CapsuleGetPointer(self, "cc-python.cb")
            : NULL;
    CcPyDom *d;
    intptr_t n;
    if (!box) return cc__py_raise("cc-python: corrupt callback capsule");
    d = box->dom;
    if (box->dead || !d || d->closed)
        return cc__py_raise("cc-python: bridge is closed");
    n = args ? cc__py.TupleSize(args) : 0;
    if (n > CCPY__JOB_MAX_ARGS)
        return cc__py_raise("cc-python: too many callback arguments");
    if (pthread_equal(pthread_self(), d->main_tid))
        return ccpy__cb_call_main(d, box, args, (int)n);
    if (d->async_mode && pthread_equal(pthread_self(), d->exec))
        return ccpy__cb_call_lane(d, box, args, (int)n);
    return cc__py_raise("cc-python: callbacks must run on the bridge's "
                        "threads");
}

/* Main-thread service for a lane-side callback request. */
static void ccpy__cb_service(void *env, CcJsCbReq *req) {
    CcJsCbBox *box = req->box;
    CcPyDom *d = box->dom;
    void *jsargs[CCPY__JOB_MAX_ARGS];
    void *fnv = NULL;
    void *undef = NULL;
    void *ret = NULL;
    int i;
    int failed = 0;
    if (box->dead || d->closed) {
        snprintf(req->errmsg, sizeof(req->errmsg),
                 "cc-python: bridge is closed");
        failed = 1;
    }
    if (!failed) {
        /* Convert the owned Python args under the GIL (the lane released
         * it before posting). */
        cc__py_attach(&d->py);
        for (i = 0; i < req->argc; i++) {
            CCPyObj r;
            r.o = req->argv[i];
            r.home = &d->py;
            req->argv[i] = NULL;
            if (ccpy__result_to_js(d, env, r, &jsargs[i]) != 0) {
                snprintf(req->errmsg, sizeof(req->errmsg),
                         "cc-python: cannot marshal a callback argument");
                failed = 1;
                break;
            }
        }
        cc_py_thread_leave();
    }
    if (!failed &&
        (cc__js.GetReferenceValue(env, box->fnref, &fnv) != 0 || !fnv)) {
        snprintf(req->errmsg, sizeof(req->errmsg),
                 "cc-python: the callback function is gone");
        failed = 1;
    }
    if (!failed) {
        cc__js.GetUndefined(env, &undef);
        if (cc__js.CallFunction(env, undef, fnv, (size_t)req->argc, jsargs,
                                &ret) != 0) {
            ccpy__js_exc_text(env, req->errmsg, sizeof(req->errmsg));
            failed = 1;
        }
    }
    if (!failed &&
        ccpy__cb_ret_tag(d, env, ret, &req->rkind, &req->rf, &req->ri,
                         &req->rstr, &req->rlen, &req->robj, req->errmsg,
                         sizeof(req->errmsg)) != 0)
        failed = 1;
    req->failed = failed;
    pthread_mutex_lock(&d->mu);
    req->done = 1;
    pthread_cond_signal(&req->cv);
    pthread_mutex_unlock(&d->mu);
}

/* Wrap a JS function as a Python callable registered with the domain.
 * Main thread, GIL held.  Returns an owned PyObject or NULL (errbuf). */
static void *ccpy__cb_wrap(CcPyDom *d, void *env, void *fnval, char *errbuf,
                           size_t errcap) {
    CcJsCbBox *box;
    void *capsule;
    void *callable;
    void *ref = NULL;
    if (!cc__py.CFunctionNewEx || !cc__py.CapsuleNew ||
        !cc__py.CapsuleGetPointer) {
        snprintf(errbuf, errcap, "cc-python: this Python runtime cannot mint "
                                 "callables (needs PyCFunction_NewEx)");
        return NULL;
    }
    box = (CcJsCbBox *)cc_arena_alloc(&d->arena, sizeof(*box), 16);
    if (!box) {
        snprintf(errbuf, errcap, "cc-python: out of memory");
        return NULL;
    }
    memset(box, 0, sizeof(*box));
    if (cc__js.CreateReference(env, fnval, 1, &ref) != 0) {
        snprintf(errbuf, errcap, "cc-python: cannot pin the callback");
        return NULL;
    }
    box->dom = d;
    box->fnref = ref;
    box->next = d->cb_head;
    d->cb_head = box;
    capsule = cc__py.CapsuleNew(box, "cc-python.cb", NULL);
    callable = capsule ? cc__py.CFunctionNewEx(&ccpy__cb_def, capsule, NULL)
                       : NULL;
    if (capsule) cc__py.DecRef(capsule); /* the callable holds it */
    if (!callable) {
        if (cc__py.ErrClear) cc__py.ErrClear();
        snprintf(errbuf, errcap, "cc-python: cannot mint the callback "
                                 "callable");
        return NULL;
    }
    return callable;
}

/* ---- the async lane ------------------------------------------------- */

/* Executor side of one job: attach this thread to the domain's
 * interpreter, run the call, convert a scalar result in place (a held
 * result keeps its reference for the main thread to box), and drop the
 * job's own Python references. */
static void ccpy__exec_run(CcPyDom *d, CcPyJob *j) {
    CCResult_CCPyObj_CCPyError r;
    int i;
    cc__py_attach(&d->py);
    {
        CCPyObj tmp;
        tmp.o = j->fn;
        tmp.home = &d->py;
        r = cc__py_obj_callm_n(&tmp, "invoke", j->argc, j->args);
    }
    for (i = 0; i < j->argc; i++)
        if (j->args[i].kind == 4) cc__py.DecRef((void *)j->args[i].p);
    cc__py.DecRef(j->fn);
    j->fn = NULL;
    if (!r.ok) {
        j->rkind = 6;
        snprintf(j->errmsg, sizeof(j->errmsg), "%s",
                 r.u.error.base.message ? r.u.error.base.message
                                        : "python error");
        return;
    }
    {
        void *o = r.u.value.o;
        void *t = cc__py.BoolFromLong(1);
        void *f = cc__py.BoolFromLong(0);
        int is_t = (o == t), is_f = (o == f);
        if (t) cc__py.DecRef(t);
        if (f) cc__py.DecRef(f);
        if (is_t || is_f) {
            j->rkind = 2;
            j->ri = is_t;
            cc_py_obj_release(&r.u.value);
            return;
        }
    }
    if (d->none && r.u.value.o == d->none) {
        j->rkind = 4;
        cc_py_obj_release(&r.u.value);
        return;
    }
    {
        intptr_t n = 0;
        const char *s = cc__py.AsUTF8AndSize(r.u.value.o, &n);
        if (s) {
            char *copy =
                (char *)cc_arena_alloc(&d->exec_arena, (size_t)n + 1, 16);
            if (copy) {
                memcpy(copy, s, (size_t)n);
                copy[n] = 0;
                j->rkind = 3;
                j->rstr = copy;
                j->rlen = (size_t)n;
                cc_py_obj_release(&r.u.value);
                return;
            }
        }
        if (cc__py.ErrClear) cc__py.ErrClear();
    }
    {
        CCResult_int64_t_CCPyError iv = cc_py_obj_as_i64(&r.u.value);
        if (iv.ok) {
            j->rkind = 1;
            j->ri = (long long)iv.u.value;
            cc_py_obj_release(&r.u.value);
            return;
        }
        if (cc__py.ErrClear) cc__py.ErrClear();
    }
    {
        CCResult_double_CCPyError fv = cc_py_obj_as_f64(&r.u.value);
        if (fv.ok) {
            j->rkind = 0;
            j->rf = fv.u.value;
            cc_py_obj_release(&r.u.value);
            return;
        }
        if (cc__py.ErrClear) cc__py.ErrClear();
    }
    j->rkind = 5;
    j->robj = r.u.value.o; /* keep the reference for the main thread */
}

/* The lane: pop, run, post; under `stopping`, queued jobs settle as
 * rejections.  On exit: detach this thread's interpreter state (the
 * mem-suite fatal otherwise), then post the drain sentinel — its
 * completion, ordered after every delivered result, does the sweep. */
static void *ccpy__exec_main(void *arg) {
    CcPyDom *d = (CcPyDom *)arg;
    pthread_mutex_lock(&d->mu);
    for (;;) {
        while (!d->qhead && !d->stopping) {
            if (!d->inflight && d->pending_done == 0)
                cc_arena_reset(&d->exec_arena);
            pthread_cond_wait(&d->cv, &d->mu);
        }
        if (!d->qhead) break; /* stopping and drained */
        {
            CcPyJob *j = d->qhead;
            d->qhead = j->next;
            if (!d->qhead) d->qtail = NULL;
            j->next = NULL;
            if (d->stopping) {
                j->rejected = 1;
                d->pending_done++;
                pthread_mutex_unlock(&d->mu);
                cc__js.CallTsfn(d->tsfn, j, 1);
                pthread_mutex_lock(&d->mu);
                continue;
            }
            d->inflight = 1;
            pthread_mutex_unlock(&d->mu);
            ccpy__exec_run(d, j);
            cc_py_thread_leave();
            pthread_mutex_lock(&d->mu);
            d->inflight = 0;
            d->pending_done++;
            pthread_mutex_unlock(&d->mu);
            cc__js.CallTsfn(d->tsfn, j, 1);
            pthread_mutex_lock(&d->mu);
        }
    }
    pthread_mutex_unlock(&d->mu);
    cc_py_thread_detach(&d->py);
    pthread_mutex_lock(&d->mu);
    d->exec_done = 1;
    pthread_mutex_unlock(&d->mu);
    d->sentinel.rkind = 7;
    cc__js.CallTsfn(d->tsfn, &d->sentinel, 1);
    return NULL;
}

static void ccpy__reject(void *env, void *deferred, const char *msg) {
    void *m = NULL, *e = NULL;
    cc__js.CreateStringUtf8(env, msg, strlen(msg), &m);
    if (!m || cc__js.CreateError(env, NULL, m, &e) != 0 || !e) e = m;
    cc__js.RejectDeferred(env, deferred, e);
}

/* Main-thread completion for every posted job, FIFO — the sentinel is
 * therefore last, after all results are delivered, which is what makes
 * it safe for the sentinel to end the interpreter. */
static void ccpy__async_complete(void *env, void *jscb, void *ctx, void *data) {
    CcPyDom *d = (CcPyDom *)ctx;
    CcPyJob *j;
    (void)jscb;
    if (*(int *)data == 1) {
        ccpy__cb_service(env, (CcJsCbReq *)data);
        return;
    }
    j = (CcPyJob *)data;
    if (j->rkind == 7) {
        pthread_join(d->exec, NULL);
        if (!d->closed) ccpy__dom_sweep(d);
        if (d->close_deferred) {
            void *u = NULL;
            cc__js.GetUndefined(env, &u);
            cc__js.ResolveDeferred(env, d->close_deferred, u);
            d->close_deferred = NULL;
        }
        cc__js.ReleaseTsfn(d->tsfn, 0);
        d->tsfn = NULL;
        ccpy__dom_unref(d); /* the lane's hold on the arena */
        return;
    }
    if (j->rejected) {
        ccpy__reject(env, j->deferred, "cc-python: bridge is closed");
    } else {
        void *v = NULL;
        int ok = 0;
        switch (j->rkind) {
        case 0: ok = cc__js.CreateDouble(env, j->rf, &v) == 0; break;
        case 1: v = cc__js_out_ll(env, j->ri); ok = v != NULL; break;
        case 2: ok = cc__js.GetBoolean(env, (int)j->ri, &v) == 0; break;
        case 3:
            ok = cc__js.CreateStringUtf8(env, j->rstr, j->rlen, &v) == 0;
            break;
        case 4: ok = cc__js.GetUndefined(env, &v) == 0; break;
        case 5: {
            CCPyObj held;
            CcPyObjBox *b;
            held.o = j->robj;
            held.home = &d->py;
            j->robj = NULL;
            b = ccpy__box(d, held);
            ok = b && ccpy__ext_make(d, env, b, &v) == 0;
            if (b && !ok) ccpy__box_undo(d, b);
            break;
        }
        default: break;
        }
        if (ok) cc__js.ResolveDeferred(env, j->deferred, v);
        else if (j->rkind == 6) ccpy__reject(env, j->deferred, j->errmsg);
        else ccpy__reject(env, j->deferred,
                          "cc-python: cannot materialize the result");
    }
    {
        int i;
        for (i = 0; i < j->nbuf; i++)
            if (j->buf_refs[i]) cc__js.DeleteReference(env, j->buf_refs[i]);
    }
    {
        int idle;
        pthread_mutex_lock(&d->mu);
        j->next = d->job_free;
        d->job_free = j;
        d->pending_done--;
        idle = !d->qhead && !d->inflight && d->pending_done == 0;
        pthread_mutex_unlock(&d->mu);
        if (idle) {
            cc_arena_reset(&d->job_arena);
            if (d->tsfn_reffed && !d->stopping && cc__js.UnrefTsfn) {
                cc__js.UnrefTsfn(env, d->tsfn);
                d->tsfn_reffed = 0;
            }
        }
    }
    ccpy__dom_unref(d); /* the job's hold on the arena */
}

/* Start the lane at creation: tsfn (unref'd while idle so an idle
 * domain never pins the event loop), queue state, executor thread. */
static int ccpy__lane_start(CcPyDom *d, void *env) {
    void *name = NULL;
    if (!cc__js.CreateTsfn || !cc__js.CreatePromise || !cc__js.CreateError ||
        !cc__js.RefTsfn || !cc__js.UnrefTsfn)
        return -1;
    pthread_mutex_init(&d->mu, NULL);
    pthread_cond_init(&d->cv, NULL);
    d->job_arena = cc_arena_heap(megabytes(1));
    d->exec_arena = cc_arena_heap(megabytes(1));
    cc__js.CreateStringUtf8(env, "cc-python", 9, &name);
    if (!name ||
        cc__js.CreateTsfn(env, NULL, NULL, name, 0, 1, NULL, NULL, d,
                          ccpy__async_complete, &d->tsfn) != 0)
        return -1;
    cc__js.UnrefTsfn(env, d->tsfn);
    d->async_mode = 1;
    d->ext_outstanding++; /* the lane holds the arena until its sentinel */
    if (pthread_create(&d->exec, NULL, ccpy__exec_main, d) != 0) {
        d->ext_outstanding--;
        cc__js.ReleaseTsfn(d->tsfn, 0);
        d->tsfn = NULL;
        return -1;
    }
    return 0;
}

/* Initiate revoke-then-drain.  Idempotent; `deferred` (may be NULL — the
 * GC path has no promise to settle) resolves at the sentinel. */
static void ccpy__lane_close(CcPyDom *d, void *env, void *deferred) {
    void *u = NULL;
    pthread_mutex_lock(&d->mu);
    if (d->stopping || d->closed) {
        pthread_mutex_unlock(&d->mu);
        if (deferred) {
            cc__js.GetUndefined(env, &u);
            cc__js.ResolveDeferred(env, deferred, u);
        }
        return;
    }
    d->stopping = 1;
    d->close_deferred = deferred;
    if (!d->tsfn_reffed) {
        cc__js.RefTsfn(env, d->tsfn); /* keep the loop alive to the sweep */
        d->tsfn_reffed = 1;
    }
    pthread_cond_signal(&d->cv);
    pthread_mutex_unlock(&d->mu);
}

/* Unbox + guard: the domain must be open, the object must belong to it
 * and still be held.  Every op routes through these two so the error
 * text is the same at every door. */
static CcPyDom *ccpy__dom(CCJsExt dom) {
    CcPyDom *d = (CcPyDom *)dom.ptr;
    /* Revocation is immediate: a draining async lane already answers
     * closed at every door, before the sweep lands. */
    return (d && !d->closed && !d->stopping) ? d : NULL;
}

static CcPyObjBox *ccpy__objbox(CcPyDom *d, CCJsExt obj) {
    CcPyObjBox *b = (CcPyObjBox *)obj.ptr;
    if (!b || b->dom != d || b->released) return NULL;
    return b;
}

static int ccpy__result_to_js(CcPyDom *d, void *env, CCPyObj r, void **out);

/* Error text for the argument-conversion path.  File scope: the
 * trampoline marshals it to a JS exception after the method returns, so
 * a stack buffer would be read after its frame died. */
static CC_JS_THREAD_LOCAL char ccpy__errbuf[160];

/* The module: stateless — every operation names its domain. */
typedef struct CcPython {
    int ok;
} CcPython;

static CCJsVal !>(CCError) CcPython_create(CcPython *self, CCJs *js) {
    CCArena ar = cc_arena_heap(megabytes(4));
    CcPyDom *d = (CcPyDom *)cc_arena_alloc(&ar, sizeof(*d), 16);
    (void)self;
    if (!d) {
        cc_arena_destroy(&ar);
        return cc_err(CC_ERR_IO, "cc-python: out of memory");
    }
    memset(d, 0, sizeof(*d));
    /* The domain lives in its own arena; from here every allocation and
     * every teardown path goes through d->arena. */
    d->arena = ar;
    {
        CCResult_CCPy_CCPyError r = cc_py_new(&d->arena);
        if (!r.ok) {
            CCArena tmp = d->arena;
            cc_arena_destroy(&tmp);
            return cc_err(CC_ERR_IO, "cc-python: no Python runtime "
                                     "(is libpython installed, or set "
                                     "CC_LIBPYTHON?)");
        }
        d->py = r.u.value;
    }
    {
        void *b = cc__py.ImportModule("builtins");
        if (b) {
            d->none = cc__py.GetAttrString(b, "None");
            cc__py.DecRef(b);
        }
        if (!d->none && cc__py.ErrClear) cc__py.ErrClear();
    }
    {
        void *ext = NULL;
        if (cc__js.CreateExternal(js->env, d, ccpy__dom_finalize, NULL,
                                  &ext) != 0) {
            CCArena tmp;
            ccpy__dom_sweep(d);
            tmp = d->arena;
            cc_arena_destroy(&tmp);
            return cc_err(CC_ERR_IO, "cc-python: external allocation failed");
        }
        d->ext_outstanding++;
        d->main_env = js->env;
        d->main_tid = pthread_self();
        {
            CCJsVal jv = { 0 };
            jv.env = js->env;
            jv.v = ext;
            return cc_ok(jv);
        }
    }
}

/* Revocation: idempotent, immediate.  The box stays until the GC
 * finalizes the External; every op on it answers "closed".  (Named
 * `close` because a module method named `destroy` is the reflection
 * convention for the module finalizer.) */
static void CcPython_close(CcPython *self, CCJs *js, CCJsExt dom) {
    CcPyDom *d = (CcPyDom *)dom.ptr;
    (void)self;
    if (!d || d->closed) return;
    /* An async lane cannot sweep synchronously — undelivered results
     * still hold Python references — so sync close initiates the same
     * revoke-then-drain the promise form does. */
    if (d->async_mode) ccpy__lane_close(d, js->env, NULL);
    else ccpy__dom_sweep(d);
}

static _Bool CcPython_closed(CcPython *self, CCJsExt dom) {
    CcPyDom *d = (CcPyDom *)dom.ptr;
    (void)self;
    return !d || d->closed;
}

/* Live handle count — the lifetime-introspection door: a debug hook can
 * assert a scope released what it minted. */
static long long CcPython_stats(CcPython *self, CCJsExt dom) {
    CcPyDom *d = ccpy__dom(dom);
    (void)self;
    return d ? d->live : -1;
}

static CCJsVal !>(CCError) CcPython_pyimport(CcPython *self, CCJs *js,
                                             CCJsExt dom, const char *name) {
    CcPyDom *d = ccpy__dom(dom);
    (void)self;
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "cc-python: bridge is closed");
    {
        /* Ownership transfers straight into the domain's box. */
        CCResult_CCPyObj_CCPyError r = cc_py_import(&d->py, name);
        if (d->async_mode) cc_py_thread_leave();
        if (!r.ok) return cc_err_CCResult_CCJsVal_CCError(r.u.error.base);
        {
            CcPyObjBox *b = ccpy__box(d, r.u.value);
            void *ext = NULL;
            if (!b) return cc_err(CC_ERR_IO, "cc-python: out of memory");
            if (ccpy__ext_make(d, js->env, b, &ext) != 0) {
                ccpy__box_undo(d, b);
                return cc_err(CC_ERR_IO,
                              "cc-python: external allocation failed");
            }
            {
                CCJsVal jv = { 0 };
                jv.env = js->env;
                jv.v = ext;
                return cc_ok(jv);
            }
        }
    }
}

/* Attribute access materializes exactly as a call result does: a scalar
 * attribute (math.pi) IS the scalar; anything else stays a held handle
 * (np.linalg) for the Proxy to keep chaining.  One rule at every
 * boundary crossing. */
static CCJsVal !>(CCError) CcPython_getattr(CcPython *self, CCJs *js,
                                            CCJsExt dom, CCJsExt obj,
                                            const char *name) {
    CcPyDom *d = ccpy__dom(dom);
    CcPyObjBox *b;
    (void)self;
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "cc-python: bridge is closed");
    b = ccpy__objbox(d, obj);
    if (!b)
        return cc_err(CC_ERR_INVALID_ARG,
                      "cc-python: handle is released or belongs to another "
                      "bridge");
    {
        /* Ownership transfers into the box or releases in the probe. */
        CCResult_CCPyObj_CCPyError r = cc_py_obj_get(&b->obj, name);
        if (!r.ok) {
            if (d->async_mode) cc_py_thread_leave();
            return cc_err_CCResult_CCJsVal_CCError(r.u.error.base);
        }
        {
            void *out = NULL;
            int mrc = ccpy__result_to_js(d, js->env, r.u.value, &out);
            if (d->async_mode) cc_py_thread_leave();
            if (mrc != 0)
                return cc_err(CC_ERR_IO, "cc-python: cannot materialize the "
                                         "attribute");
            {
                CCJsVal jv = { 0 };
                jv.env = js->env;
                jv.v = out;
                return cc_ok(jv);
            }
        }
    }
}

/* Early release of one handle; answers the domain's remaining live
 * count so a scope can assert it dropped what it minted. */
static long long !>(CCError) CcPython_release(CcPython *self, CCJsExt dom,
                                              CCJsExt obj) {
    CcPyDom *d = ccpy__dom(dom);
    CcPyObjBox *b;
    (void)self;
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "cc-python: bridge is closed");
    b = ccpy__objbox(d, obj);
    if (!b)
        return cc_err(CC_ERR_INVALID_ARG,
                      "cc-python: handle is released or belongs to another "
                      "bridge");
    if (d->async_mode) cc__py_attach(&d->py);
    cc_py_obj_release(&b->obj);
    if (d->async_mode) cc_py_thread_leave();
    b->released = 1;
    if (b->prev) b->prev->next = b->next;
    else d->head = b->next;
    if (b->next) b->next->prev = b->prev;
    b->next = NULL;
    b->prev = NULL;
    d->live--;
    return cc_ok(d->live);
}

/* JS argument array → CCPyArg row.  Numbers with integral values cross
 * as Python int (JavaScript has one number type, and Python APIs that
 * want a float accept an int — the reverse is not true); typed arrays
 * cross as zero-copy memoryview leases; externals pass the held
 * reference through. */
static int ccpy__arg_from_js(CcPyDom *d, void *env, void *v, CCPyArg *out,
                             void **owned_out, char *errbuf, size_t errcap) {
    int t = 0;
    if (owned_out) *owned_out = NULL;
    if (cc__js.Typeof(env, v, &t) != 0) {
        snprintf(errbuf, errcap, "cc-python: cannot read an argument");
        return -1;
    }
    if (t == CC__JS_T_FUNCTION) {
        /* A JS function crosses as a minted Python callable (caller holds
         * the GIL); the caller owns the fresh reference. */
        CCPyObj tmp;
        void *callable = ccpy__cb_wrap(d, env, v, errbuf, errcap);
        if (!callable) return -1;
        tmp.o = callable;
        tmp.home = &d->py;
        *out = cc__py_arg_obj(tmp);
        if (owned_out) *owned_out = callable;
        return 0;
    }
    if (t == CC__JS_T_NUMBER) {
        double dd = 0;
        cc__js.GetValueDouble(env, v, &dd);
        if (dd == (double)(long long)dd && dd >= -9007199254740992.0 &&
            dd <= 9007199254740992.0)
            *out = cc__py_arg_i((long long)dd);
        else
            *out = cc__py_arg_f(dd);
        return 0;
    }
    if (t == CC__JS_T_BOOLEAN) {
        _Bool bv = 0;
        cc__js.GetValueBool(env, v, &bv);
        *out = cc__py_arg_bool(bv ? 1 : 0);
        return 0;
    }
    if (t == CC__JS_T_STRING) {
        CCSlice s;
        if (cc__js_inq_slice(&s, env, v) != 0) {
            snprintf(errbuf, errcap, "cc-python: cannot read a string argument");
            return -1;
        }
        *out = cc__py_arg_slice(s);
        return 0;
    }
    if (t == CC__JS_T_EXTERNAL) {
        void *p = NULL;
        CcPyObjBox *b;
        cc__js.GetValueExternal(env, v, &p);
        b = (CcPyObjBox *)p;
        if (!b || b->dom != d || b->released) {
            snprintf(errbuf, errcap,
                     "cc-python: an argument handle is released or belongs "
                     "to another bridge");
            return -1;
        }
        *out = cc__py_arg_obj(b->obj);
        return 0;
    }
    {
        _Bool ta = 0;
        if (cc__js.IsTypedarray(env, v, &ta) == 0 && ta) {
            int tt = 0;
            size_t len = 0;
            void *data = NULL;
            void *ab = NULL;
            size_t off = 0;
            int esz = 0, isf = 0, iss = 1;
            if (cc__js.GetTypedarrayInfo(env, v, &tt, &len, &data, &ab, &off) != 0) {
                snprintf(errbuf, errcap, "cc-python: cannot read a typed array");
                return -1;
            }
            switch (tt) {
            case CC__JS_TA_FLOAT64: esz = 8; isf = 1; break;
            case CC__JS_TA_FLOAT32: esz = 4; isf = 1; break;
            case CC__JS_TA_INT32:   esz = 4; break;
            case CC__JS_TA_BIGINT64: esz = 8; break;
            default:
                snprintf(errbuf, errcap,
                         "cc-python: unsupported typed-array element type");
                return -1;
            }
            {
                CCSlice s = { (char *)data, len };
                *out = cc__py_arg_buffer(cc__py_arg_tslice(s, esz, isf, iss));
            }
            return 0;
        }
    }
    snprintf(errbuf, errcap,
             "cc-python: unsupported argument (pass numbers, strings, "
             "booleans, typed arrays, or bridge handles)");
    return -1;
}

/* Python result → JS value.  Scalars materialize (bool, str, int —
 * BigInt past 2^53 — float, None → undefined); anything else stays a
 * held reference, registered with the domain and returned as a handle
 * for the Proxy to wrap. */
static int ccpy__result_to_js(CcPyDom *d, void *env, CCPyObj r, void **out) {
    void *o = r.o;
    /* bool first — Python bool is a subtype of int. */
    {
        void *t = cc__py.BoolFromLong(1);
        void *f = cc__py.BoolFromLong(0);
        int is_t = (o == t), is_f = (o == f);
        if (t) cc__py.DecRef(t);
        if (f) cc__py.DecRef(f);
        if (is_t || is_f) {
            cc_py_obj_release(&r);
            return cc__js.GetBoolean(env, is_t, out);
        }
    }
    if (d->none && o == d->none) {
        cc_py_obj_release(&r);
        return cc__js.GetUndefined(env, out);
    }
    {
        intptr_t n = 0;
        const char *s = cc__py.AsUTF8AndSize(o, &n);
        if (s) {
            int rc = cc__js.CreateStringUtf8(env, s, (size_t)n, out);
            cc_py_obj_release(&r);
            return rc;
        }
        if (cc__py.ErrClear) cc__py.ErrClear();
    }
    {
        CCResult_int64_t_CCPyError iv = cc_py_obj_as_i64(&r);
        if (iv.ok) {
            void *v = cc__js_out_ll(env, (long long)iv.u.value);
            cc_py_obj_release(&r);
            if (!v) return -1;
            *out = v;
            return 0;
        }
        if (cc__py.ErrClear) cc__py.ErrClear();
    }
    {
        CCResult_double_CCPyError fv = cc_py_obj_as_f64(&r);
        if (fv.ok) {
            int rc = cc__js.CreateDouble(env, fv.u.value, out);
            cc_py_obj_release(&r);
            return rc;
        }
        if (cc__py.ErrClear) cc__py.ErrClear();
    }
    {
        CcPyObjBox *b = ccpy__box(d, r);
        if (!b) return -1;
        if (ccpy__ext_make(d, env, b, out) != 0) {
            ccpy__box_undo(d, b);
            return -1;
        }
        return 0;
    }
}

static CCJsVal !>(CCError) CcPython_invoke(CcPython *self, CCJs *js,
                                           CCJsExt dom, CCJsExt fn,
                                           CCJsVal args) {
    CcPyDom *d = ccpy__dom(dom);
    CcPyObjBox *fb;
    CCPyArg argv[CC__PY_MAX_CALL_ARGS];
    void *owned[CC__PY_MAX_CALL_ARGS]; /* minted callables to drop post-call */
    uint32_t argc = 0, i;
    _Bool isarr = 0;
    CC__JsMark mark;
    (void)self;
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "cc-python: bridge is closed");
    fb = ccpy__objbox(d, fn);
    if (!fb)
        return cc_err(CC_ERR_INVALID_ARG,
                      "cc-python: handle is released or belongs to another "
                      "bridge");
    if (cc__js.IsArray(js->env, args.v, &isarr) != 0 || !isarr)
        return cc_err(CC_ERR_INVALID_ARG,
                      "cc-python: invoke wants an argument ARRAY");
    if (cc__js.GetArrayLength(js->env, args.v, &argc) != 0 ||
        argc > CC__PY_MAX_CALL_ARGS)
        return cc_err(CC_ERR_INVALID_ARG, "cc-python: too many arguments");
    mark = cc__js_mark();
    /* Minting callables and (on an async domain) refcounts need the GIL. */
    cc__py_attach(&d->py);
    for (i = 0; i < argc; i++) {
        void *el = NULL;
        if (cc__js.GetElement(js->env, args.v, i, &el) != 0 ||
            ccpy__arg_from_js(d, js->env, el, &argv[i], &owned[i],
                              ccpy__errbuf, sizeof(ccpy__errbuf)) != 0) {
            uint32_t k;
            for (k = 0; k < i; k++)
                if (owned[k]) cc__py.DecRef(owned[k]);
            if (d->async_mode) cc_py_thread_leave();
            cc__js_release(mark);
            return cc_err(CC_ERR_INVALID_ARG, ccpy__errbuf);
        }
    }
    {
        CCPyObj *f = &fb->obj;
        CCResult_CCPyObj_CCPyError r =
            cc__py_obj_callm_n(f, "invoke", (int)argc, argv);
        for (i = 0; i < argc; i++)
            if (owned[i]) cc__py.DecRef(owned[i]);
        cc__js_release(mark);
        if (!r.ok) {
            if (d->async_mode) cc_py_thread_leave();
            return cc_err_CCResult_CCJsVal_CCError(r.u.error.base);
        }
        {
            void *out = NULL;
            int mrc = ccpy__result_to_js(d, js->env, r.u.value, &out);
            if (d->async_mode) cc_py_thread_leave();
            if (mrc != 0)
                return cc_err(CC_ERR_IO, "cc-python: cannot materialize the "
                                         "result");
            {
                CCJsVal jv = { 0 };
                jv.env = js->env;
                jv.v = out;
                return cc_ok(jv);
            }
        }
    }
}

/* Pack one JS argument for an async job: same probes as the sync path,
 * but string copies land in the job arena (the call outlives this
 * frame), typed arrays gain a napi_ref pinning the buffer to the job,
 * and handle args are IncRef'd — the job owns its references.  Caller
 * holds the interpreter's GIL. */
static int ccpy__arg_pack_async(CcPyDom *d, void *env, void *v, CcPyJob *j,
                                CCPyArg *out, char *errbuf, size_t errcap) {
    int t = 0;
    if (cc__js.Typeof(env, v, &t) != 0) {
        snprintf(errbuf, errcap, "cc-python: cannot read an argument");
        return -1;
    }
    if (t == CC__JS_T_FUNCTION) {
        /* A JS function crosses as a minted Python callable; the JOB owns
         * the fresh reference (its kind-4 sweep releases it). */
        CCPyObj tmp;
        void *callable = ccpy__cb_wrap(d, env, v, errbuf, errcap);
        if (!callable) return -1;
        tmp.o = callable;
        tmp.home = &d->py;
        *out = cc__py_arg_obj(tmp);
        return 0;
    }
    if (t == CC__JS_T_NUMBER) {
        double dd = 0;
        cc__js.GetValueDouble(env, v, &dd);
        if (dd == (double)(long long)dd && dd >= -9007199254740992.0 &&
            dd <= 9007199254740992.0)
            *out = cc__py_arg_i((long long)dd);
        else
            *out = cc__py_arg_f(dd);
        return 0;
    }
    if (t == CC__JS_T_BOOLEAN) {
        _Bool bv = 0;
        cc__js.GetValueBool(env, v, &bv);
        *out = cc__py_arg_bool(bv ? 1 : 0);
        return 0;
    }
    if (t == CC__JS_T_STRING) {
        size_t len = 0, got = 0;
        char *copy;
        if (cc__js.GetValueStringUtf8(env, v, NULL, 0, &len) != 0) {
            snprintf(errbuf, errcap, "cc-python: cannot read a string argument");
            return -1;
        }
        copy = (char *)cc_arena_alloc(&d->job_arena, len + 1, 16);
        if (!copy) {
            snprintf(errbuf, errcap, "cc-python: out of memory");
            return -1;
        }
        if (cc__js.GetValueStringUtf8(env, v, copy, len + 1, &got) != 0) {
            snprintf(errbuf, errcap, "cc-python: cannot read a string argument");
            return -1;
        }
        {
            CCSlice sl = { copy, got };
            *out = cc__py_arg_slice(sl);
        }
        return 0;
    }
    if (t == CC__JS_T_EXTERNAL) {
        void *p = NULL;
        CcPyObjBox *b;
        cc__js.GetValueExternal(env, v, &p);
        b = (CcPyObjBox *)p;
        if (!b || b->dom != d || b->released) {
            snprintf(errbuf, errcap,
                     "cc-python: an argument handle is released or belongs "
                     "to another bridge");
            return -1;
        }
        cc__py.IncRef(b->obj.o); /* the job's own reference */
        *out = cc__py_arg_obj(b->obj);
        return 0;
    }
    {
        _Bool ta = 0;
        if (cc__js.IsTypedarray(env, v, &ta) == 0 && ta) {
            int tt = 0;
            size_t len = 0;
            void *data = NULL;
            void *ab = NULL;
            size_t off = 0;
            int esz = 0, isf = 0, iss = 1;
            void *ref = NULL;
            if (cc__js.GetTypedarrayInfo(env, v, &tt, &len, &data, &ab,
                                         &off) != 0) {
                snprintf(errbuf, errcap, "cc-python: cannot read a typed array");
                return -1;
            }
            switch (tt) {
            case CC__JS_TA_FLOAT64: esz = 8; isf = 1; break;
            case CC__JS_TA_FLOAT32: esz = 4; isf = 1; break;
            case CC__JS_TA_INT32:   esz = 4; break;
            case CC__JS_TA_BIGINT64: esz = 8; break;
            default:
                snprintf(errbuf, errcap,
                         "cc-python: unsupported typed-array element type");
                return -1;
            }
            /* Pin the buffer to the job: the lease spans submit to
             * completion, not this stack frame. */
            if (cc__js.CreateReference(env, v, 1, &ref) != 0) {
                snprintf(errbuf, errcap, "cc-python: cannot pin a typed array");
                return -1;
            }
            j->buf_refs[j->nbuf++] = ref;
            {
                CCSlice sl = { (char *)data, len };
                *out = cc__py_arg_buffer(cc__py_arg_tslice(sl, esz, isf, iss));
            }
            return 0;
        }
    }
    snprintf(errbuf, errcap,
             "cc-python: unsupported argument (pass numbers, strings, "
             "booleans, typed arrays, or bridge handles)");
    return -1;
}

/* Unwind a partially packed job (caller holds the GIL): drop the job's
 * references and pins, recycle the record. */
static void ccpy__job_abort(CcPyDom *d, void *env, CcPyJob *j, int npacked) {
    int i;
    for (i = 0; i < npacked; i++)
        if (j->args[i].kind == 4) cc__py.DecRef((void *)j->args[i].p);
    if (j->fn) cc__py.DecRef(j->fn);
    for (i = 0; i < j->nbuf; i++)
        if (j->buf_refs[i]) cc__js.DeleteReference(env, j->buf_refs[i]);
    pthread_mutex_lock(&d->mu);
    j->next = d->job_free;
    d->job_free = j;
    pthread_mutex_unlock(&d->mu);
}

/* The async call: submit, return the Promise.  Same doors and the same
 * messages as the sync invoke; the settle happens on the main thread
 * when the lane posts completion. */
static CCJsVal !>(CCError) CcPython_invoke_async(CcPython *self, CCJs *js,
                                                 CCJsExt dom, CCJsExt fn,
                                                 CCJsVal args) {
    CcPyDom *d = ccpy__dom(dom);
    CcPyObjBox *fb;
    CcPyJob *j;
    uint32_t argc = 0, i;
    _Bool isarr = 0;
    (void)self;
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "cc-python: bridge is closed");
    if (!d->async_mode) {
        /* The lane is latent: first task call starts it.  Main may hold
         * this interpreter's GIL from sync work — the lane needs it. */
        if (ccpy__lane_start(d, js->env) != 0)
            return cc_err(CC_ERR_IO, "cc-python: async needs Node-API "
                                     "promises + threadsafe functions");
        cc_py_thread_leave();
    }
    fb = ccpy__objbox(d, fn);
    if (!fb)
        return cc_err(CC_ERR_INVALID_ARG,
                      "cc-python: handle is released or belongs to another "
                      "bridge");
    if (cc__js.IsArray(js->env, args.v, &isarr) != 0 || !isarr)
        return cc_err(CC_ERR_INVALID_ARG,
                      "cc-python: invoke wants an argument ARRAY");
    if (cc__js.GetArrayLength(js->env, args.v, &argc) != 0 ||
        argc > CCPY__JOB_MAX_ARGS)
        return cc_err(CC_ERR_INVALID_ARG, "cc-python: too many arguments");
    pthread_mutex_lock(&d->mu);
    j = d->job_free;
    if (j) d->job_free = j->next;
    pthread_mutex_unlock(&d->mu);
    if (!j) j = (CcPyJob *)cc_arena_alloc(&d->arena, sizeof(*j), 16);
    if (!j) return cc_err(CC_ERR_IO, "cc-python: out of memory");
    memset(j, 0, sizeof(*j));
    /* Refcounts (handle args, the callable) need the GIL; the executor
     * yields it between jobs. */
    cc__py_attach(&d->py);
    for (i = 0; i < argc; i++) {
        void *el = NULL;
        if (cc__js.GetElement(js->env, args.v, i, &el) != 0 ||
            ccpy__arg_pack_async(d, js->env, el, j, &j->args[i], ccpy__errbuf,
                                 sizeof(ccpy__errbuf)) != 0) {
            ccpy__job_abort(d, js->env, j, (int)i);
            cc_py_thread_leave();
            return cc_err(CC_ERR_INVALID_ARG, ccpy__errbuf);
        }
    }
    j->argc = (int)argc;
    cc__py.IncRef(fb->obj.o);
    j->fn = fb->obj.o;
    cc_py_thread_leave();
    {
        void *promise = NULL;
        if (cc__js.CreatePromise(js->env, &j->deferred, &promise) != 0) {
            cc__py_attach(&d->py);
            ccpy__job_abort(d, js->env, j, (int)argc);
            cc_py_thread_leave();
            return cc_err(CC_ERR_IO, "cc-python: promise allocation failed");
        }
        pthread_mutex_lock(&d->mu);
        if (d->qtail) d->qtail->next = j;
        else d->qhead = j;
        d->qtail = j;
        d->ext_outstanding++; /* the job holds the arena to completion */
        if (!d->tsfn_reffed) {
            cc__js.RefTsfn(js->env, d->tsfn);
            d->tsfn_reffed = 1;
        }
        pthread_cond_signal(&d->cv);
        pthread_mutex_unlock(&d->mu);
        {
            CCJsVal jv = { 0 };
            jv.env = js->env;
            jv.v = promise;
            return cc_ok(jv);
        }
    }
}

/* Revoke-then-drain with a Promise: rejects everything queued, lets the
 * in-flight call finish, sweeps after the last delivery, resolves. */
static CCJsVal !>(CCError) CcPython_close_async(CcPython *self, CCJs *js,
                                                CCJsExt dom) {
    CcPyDom *d = (CcPyDom *)dom.ptr;
    void *deferred = NULL;
    void *promise = NULL;
    (void)self;
    if (!d)
        return cc_err(CC_ERR_INVALID_ARG, "cc-python: not a bridge handle");
    if (!cc__js.CreatePromise)
        return cc_err(CC_ERR_IO, "cc-python: async needs Node-API promises");
    if (cc__js.CreatePromise(js->env, &deferred, &promise) != 0)
        return cc_err(CC_ERR_IO, "cc-python: promise allocation failed");
    if (d->async_mode) {
        ccpy__lane_close(d, js->env, deferred);
    } else {
        /* No lane ever started: the sweep is synchronous, the promise
         * only keeps destroy()'s shape uniform. */
        void *u = NULL;
        if (!d->closed) ccpy__dom_sweep(d);
        cc__js.GetUndefined(js->env, &u);
        cc__js.ResolveDeferred(js->env, deferred, u);
    }
    {
        CCJsVal jv = { 0 };
        jv.env = js->env;
        jv.v = promise;
        return cc_ok(jv);
    }
}

static const CcPython seed = { .ok = 1 };

@comptime cc_js_export("CcPython", &seed);

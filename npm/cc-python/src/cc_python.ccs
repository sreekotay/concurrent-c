        CCPyObj f;
        int already = 0;
        f.o = req->fut;
        f.home = &d->py;
        {
            CCResult_CCPyObj_CCPyError r =
                cc__py_obj_callm_n(&f, "done", 0, NULL);
            if (r.ok) {
                already = ccpy__truthy(d, &r.u.value);
                cc_py_obj_release(&r.u.value);
            } else if (cc__py.ErrClear) {
                cc__py.ErrClear();
            }

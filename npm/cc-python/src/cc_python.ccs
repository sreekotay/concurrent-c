/* Main-side conclusion of an awaitable request: hand the tags to the
 * loop thread.  After revocation has closed the interpreter the drop is
 * silent — the future's task was already cancelled at drain. */
static void ccpy__aio_req_finish(CcPyDom *d, CcJsCbReq *req) {
    int dead;
    int handed = 0;
    pthread_mutex_lock(&d->mu);
    dead = d->closed;
    pthread_mutex_unlock(&d->mu);
    if (!dead) {
        cc__py_attach(&d->py);
        {
            void *cap = cc__py.CapsuleNew(req, "cc-python.req", NULL);
            void *settle =
                cap ? cc__py.CFunctionNewEx(&ccpy__settle_def, cap, NULL)
                    : NULL;
            if (cap) cc__py.DecRef(cap);
            if (settle) {
                CCPyObj lo;
                CCPyObj sv;
                CCPyArg a;
                lo.o = d->loop;
                lo.home = &d->py;
                sv.o = settle;
                sv.home = &d->py;
                a = cc__py_arg_obj(sv);
                {
                    CCResult_CCPyObj_CCPyError r = cc__py_obj_callm_n(
                        &lo, "call_soon_threadsafe", 1, &a);
                    if (r.ok) {
                        cc_py_obj_release(&r.u.value);
                        handed = 1;

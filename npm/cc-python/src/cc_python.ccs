    for (;;) {
        CcPyJob *j;
        pthread_mutex_lock(&d->mu);
        j = d->qhead;
        if (j) {
            d->qhead = j->next;
            if (!d->qhead) d->qtail = NULL;
            j->next = NULL;
        }
        pthread_mutex_unlock(&d->mu);
        if (!j) break;
        j->rejected = 1;
        pthread_mutex_lock(&d->mu);
        d->pending_done++;
        pthread_mutex_unlock(&d->mu);
        cc__js.CallTsfn(d->tsfn, j, 1);
    }
    {
        CCResult_CCPyObj_CCPyError r = cc__py_obj_callm_n(&lo, "close", 0, NULL);
        if (r.ok) cc_py_obj_release(&r.u.value);
        else if (cc__py.ErrClear) cc__py.ErrClear();
    }
    pthread_mutex_lock(&d->mu);
    d->loop_closed = 1;
    pthread_mutex_unlock(&d->mu);
}

/* The lane: pop, run, post; under `stopping`, queued jobs settle as
 * rejections.  On exit: detach this thread's interpreter state (the
 * mem-suite fatal otherwise), then post the drain sentinel — its
 * completion, ordered after every delivered result, does the sweep. */
static void *ccpy__exec_main(void *arg) {
    CcPyDom *d = (CcPyDom *)arg;
    pthread_mutex_lock(&d->mu);
    for (;;) {
        /* Once loop mode engages (first coroutine — possibly scheduled
         * from a nested suspension), the loop owns this thread. */
        if (d->loop_mode) {
            pthread_mutex_unlock(&d->mu);
            ccpy__exec_loop(d);
            cc_py_thread_leave();
            pthread_mutex_lock(&d->mu);
            break;
        }
        while (!d->qhead && !d->stopping && !d->loop_mode) {
            if (!d->inflight && d->pending_done == 0 && d->sched_live == 0)
                cc_arena_reset(&d->exec_arena);
            pthread_cond_wait(&d->cv, &d->mu);
        }
        if (d->loop_mode) continue;
        if (!d->qhead) break; /* stopping and drained */
        {
            CcPyJob *j = d->qhead;
            d->qhead = j->next;
            if (!d->qhead) d->qtail = NULL;
            j->next = NULL;
            if (d->stopping) {
                j->rejected = 1;
                d->pending_done++;
                pthread_mutex_unlock(&d->mu);
                cc__js.CallTsfn(d->tsfn, j, 1);
                pthread_mutex_lock(&d->mu);
                continue;
            }
            d->inflight = 1;
            pthread_mutex_unlock(&d->mu);
            ccpy__exec_run(d, j);
            cc_py_thread_leave();
            pthread_mutex_lock(&d->mu);
            d->inflight = 0;
            if (j->scheduled) continue; /* posts at task-done; loop next */
            d->pending_done++;
            pthread_mutex_unlock(&d->mu);
            cc__js.CallTsfn(d->tsfn, j, 1);
            pthread_mutex_lock(&d->mu);
        }
    }
    pthread_mutex_unlock(&d->mu);
    cc_py_thread_detach(&d->py);
    pthread_mutex_lock(&d->mu);
    d->exec_done = 1;
    pthread_mutex_unlock(&d->mu);
    d->sentinel.rkind = 7;
    cc__js.CallTsfn(d->tsfn, &d->sentinel, 1);
    return NULL;
}

static void ccpy__reject(void *env, void *deferred, const char *msg) {
    void *m = NULL, *e = NULL, *c = NULL, *pt = NULL;
    char pyty[64];
    const char *code = NULL;
    if (msg && cc__js_py_type_from_msg(msg, pyty, sizeof(pyty)))
        code = pyty;
    cc__js.CreateStringUtf8(env, msg ? msg : "python error",
                            strlen(msg ? msg : "python error"), &m);
    if (code)
        cc__js.CreateStringUtf8(env, code, strlen(code), &c);
    if (!m || cc__js.CreateError(env, c, m, &e) != 0 || !e) e = m;
    if (e && code && c) {
        (void)cc__js.SetNamedProperty(env, e, "code", c);
        if (cc__js.CreateStringUtf8(env, code, strlen(code), &pt) == 0 && pt)
            (void)cc__js.SetNamedProperty(env, e, "pyType", pt);
    }
    cc__js.RejectDeferred(env, deferred, e);
}

/* Process-wide: async lane drains (close_async / GC / sync close after a
 * lane) overlap with create() is refuse-not-block — close completes on the
 * JS thread via TSFN, so a sync wait in create would deadlock. */
static int ccpy__async_closes_inflight = 0;

/* In-process libpython is process-global.  Concurrent create() from
 * Node worker_threads races `_PyImport_Init` and aborts the process;
 * a late create() on a second thread after main already owns it yields
 * opaque extension ImportErrors.  One OS thread may own in-process
 * domains; others must use create({ isolated: true }). */
static pthread_mutex_t ccpy__inproc_owner_mu = PTHREAD_MUTEX_INITIALIZER;
static pthread_t ccpy__inproc_owner_tid;
static int ccpy__inproc_owner_set = 0;
static int ccpy__inproc_live = 0;

static int ccpy__claim_inproc_owner(char *err, size_t errcap) {
    pthread_t self = pthread_self();
    pthread_mutex_lock(&ccpy__inproc_owner_mu);
    if (!ccpy__inproc_owner_set) {
        ccpy__inproc_owner_tid = self;
        ccpy__inproc_owner_set = 1;
        ccpy__inproc_live = 1;
        pthread_mutex_unlock(&ccpy__inproc_owner_mu);
        return 0;
    }
    if (pthread_equal(ccpy__inproc_owner_tid, self)) {
        ccpy__inproc_live++;
        pthread_mutex_unlock(&ccpy__inproc_owner_mu);
        return 0;
    }
    pthread_mutex_unlock(&ccpy__inproc_owner_mu);
    snprintf(err, errcap,
             "cc-python: in-process bridge already owned by another thread; "
             "use create({ isolated: true }) — one Node thread may own "
             "in-process libpython; worker threads need isolated domains");
    return -1;
}

static void ccpy__release_inproc_owner(void) {
    pthread_mutex_lock(&ccpy__inproc_owner_mu);
    if (ccpy__inproc_live > 0) ccpy__inproc_live--;
    if (ccpy__inproc_live == 0) ccpy__inproc_owner_set = 0;
    pthread_mutex_unlock(&ccpy__inproc_owner_mu);
}

static void ccpy__async_close_begin(void) {
    __sync_add_and_fetch(&ccpy__async_closes_inflight, 1);
}

static void ccpy__async_close_end(void) {
    __sync_sub_and_fetch(&ccpy__async_closes_inflight, 1);
}

/* Main-thread completion for every posted job, FIFO — the sentinel is
 * therefore last, after all results are delivered, which is what makes
 * it safe for the sentinel to end the interpreter. */
static void ccpy__async_complete(void *env, void *jscb, void *ctx, void *data) {
    CcPyDom *d = (CcPyDom *)ctx;
    CcPyJob *j;
    (void)jscb;
    if (*(int *)data == 1) {
        ccpy__cb_service(env, (CcJsCbReq *)data);
        return;
    }
    j = (CcPyJob *)data;
    if (j->rkind == 7) {
        pthread_join(d->exec, NULL);
        if (!d->closed) ccpy__dom_sweep(d);
        if (d->close_deferred) {
            void *u = NULL;
            cc__js.GetUndefined(env, &u);
            cc__js.ResolveDeferred(env, d->close_deferred, u);
            d->close_deferred = NULL;
        }
        cc__js.ReleaseTsfn(d->tsfn, 0);
        d->tsfn = NULL;
        ccpy__async_close_end();
        ccpy__dom_unref(d); /* the lane's hold on the arena */
        return;
    }
    if (j->rejected) {
        ccpy__reject(env, j->deferred, "cc-python: bridge is closed");
    } else {
        void *v = NULL;
        int ok = 0;
        switch (j->rkind) {
        case 0: ok = cc__js.CreateDouble(env, j->rf, &v) == 0; break;
        case 1: v = cc__js_out_ll(env, j->ri); ok = v != NULL; break;
        case 2: ok = cc__js.GetBoolean(env, (int)j->ri, &v) == 0; break;
        case 3:
            ok = cc__js.CreateStringUtf8(env, j->rstr, j->rlen, &v) == 0;
            break;
        case 4: ok = cc__js.GetUndefined(env, &v) == 0; break;
        case 5: {
            CCPyObj held;
            CcPyObjBox *b;
            held.o = j->robj;
            held.home = &d->py;
            j->robj = NULL;
            b = ccpy__box(d, held);
            ok = b && ccpy__ext_make(d, env, b, &v) == 0;
            if (b && !ok) ccpy__box_undo(d, b);
            break;
        }
        case 8:
            v = cc__js_out_bigint_dec(env, j->rstr, j->rlen);
            ok = v != NULL;
            break;
        default: break;
        }
        if (ok) cc__js.ResolveDeferred(env, j->deferred, v);
        else if (j->rkind == 6) ccpy__reject(env, j->deferred, j->errmsg);
        else ccpy__reject(env, j->deferred,
                          "cc-python: cannot materialize the result");
    }
    {
        int i;
        for (i = 0; i < j->nbuf; i++)
            if (j->buf_refs[i]) cc__js.DeleteReference(env, j->buf_refs[i]);
    }
    {
        int idle;
        pthread_mutex_lock(&d->mu);
        j->next = d->job_free;
        d->job_free = j;
        d->pending_done--;
        idle = !d->qhead && !d->inflight && d->pending_done == 0 &&
               d->sched_live == 0 && d->cb_live == 0;
        pthread_mutex_unlock(&d->mu);
        if (idle) {
            cc_arena_reset(&d->job_arena);
            if (d->tsfn_reffed && !d->stopping && cc__js.UnrefTsfn) {
                cc__js.UnrefTsfn(env, d->tsfn);
                d->tsfn_reffed = 0;
            }
        }
    }
    ccpy__dom_unref(d); /* the job's hold on the arena */
}

/* Start the lane at creation: tsfn (unref'd while idle so an idle
 * domain never pins the event loop), queue state, executor thread. */
static int ccpy__lane_start(CcPyDom *d, void *env) {
    void *name = NULL;
    if (!cc__js.CreateTsfn || !cc__js.CreatePromise || !cc__js.CreateError ||
        !cc__js.RefTsfn || !cc__js.UnrefTsfn)
        return -1;
    /* d->mu / d->cv are initialized at creation — the lifetime count
     * needs the mutex on every domain, laned or not. */
    d->job_arena = cc_arena_heap(megabytes(1));
    d->exec_arena = cc_arena_heap(megabytes(1));
    cc__js.CreateStringUtf8(env, "concurrent-c-python", 20, &name);
    if (!name ||
        cc__js.CreateTsfn(env, NULL, NULL, name, 0, 1, NULL, NULL, d,
                          ccpy__async_complete, &d->tsfn) != 0)
        return -1;
    cc__js.UnrefTsfn(env, d->tsfn);
    d->async_mode = 1;
    ccpy__dom_hold(d); /* the lane holds the arena until its sentinel */
    if (pthread_create(&d->exec, NULL, ccpy__exec_main, d) != 0) {
        pthread_mutex_lock(&d->mu);
        d->ext_outstanding--;
        pthread_mutex_unlock(&d->mu);
        cc__js.ReleaseTsfn(d->tsfn, 0);
        d->tsfn = NULL;
        return -1;
    }
    return 0;
}

/* Initiate revoke-then-drain.  Idempotent; `deferred` (may be NULL — the
 * GC path has no promise to settle) resolves at the sentinel. */
static void ccpy__lane_close(CcPyDom *d, void *env, void *deferred) {
    void *u = NULL;
    pthread_mutex_lock(&d->mu);
    if (d->stopping || d->closed) {
        pthread_mutex_unlock(&d->mu);
        if (deferred) {
            cc__js.GetUndefined(env, &u);
            cc__js.ResolveDeferred(env, deferred, u);
        }
        return;
    }
    d->stopping = 1;
    ccpy__async_close_begin();
    d->close_deferred = deferred;
    if (!d->tsfn_reffed) {
        cc__js.RefTsfn(env, d->tsfn); /* keep the loop alive to the sweep */
        d->tsfn_reffed = 1;
    }
    pthread_cond_signal(&d->cv);
    /* A suspended lane callback drains queued jobs from its own wait —
     * it must see `stopping` to reject them. */
    if (d->cb_waiter) pthread_cond_signal(&d->cb_waiter->cv);
    {
        int loop_mode = d->loop_mode;
        pthread_mutex_unlock(&d->mu);
        if (loop_mode) {
            /* wake the loop so the pump sees `stopping` and stops it */
            cc__py_attach(&d->py);
            {
                CCPyObj lo;
                CCPyObj pv;
                CCPyArg a;
                lo.o = d->loop;
                lo.home = &d->py;
                pv.o = d->pump;
                pv.home = &d->py;
                a = cc__py_arg_obj(pv);
                {
                    CCResult_CCPyObj_CCPyError r =
                        cc__py_obj_callm_n(&lo, "call_soon_threadsafe", 1, &a);
                    if (r.ok) cc_py_obj_release(&r.u.value);
                    else if (cc__py.ErrClear) cc__py.ErrClear();
                }
            }
            cc_py_thread_leave();
        }
    }
}

/* Unbox + guard: the domain must be open, the object must belong to it
 * and still be held.  Every op routes through these two so the error
 * text is the same at every door. */
static CcPyDom *ccpy__dom(CCJsExt dom) {
    CcPyDom *d = (CcPyDom *)dom.ptr;
    /* Revocation is immediate: a draining async lane already answers
     * closed at every door, before the sweep lands. */
    return (d && !d->closed && !d->stopping) ? d : NULL;
}

static CcPyObjBox *ccpy__objbox(CcPyDom *d, CCJsExt obj) {
    CcPyObjBox *b = (CcPyObjBox *)obj.ptr;
    if (!b || b->dom != d || b->released) return NULL;
    return b;
}

static int ccpy__result_to_js(CcPyDom *d, void *env, CCPyObj r, void **out);

/* Error text for the argument-conversion path.  File scope: the
 * trampoline marshals it to a JS exception after the method returns, so
 * a stack buffer would be read after its frame died. */
static CC_JS_THREAD_LOCAL char ccpy__errbuf[160];

/* The module: stateless — every operation names its domain. */
typedef struct CcPython {
    int ok;
} CcPython;

static CCJsVal !>(CCError) CcPython_create(CcPython *self, CCJs *js) {
    CCArena ar = cc_arena_heap(megabytes(4));
    CcPyDom *d;
    static char owner_err[256];
    (void)self;
    /* Refuse while any lane drain is unfinished — do not sync-wait (close
     * settles on this thread via TSFN).  Callers must await destroy(). */
    if (__sync_add_and_fetch(&ccpy__async_closes_inflight, 0) > 0)
        return cc_err(CC_ERR_IO,
                      "cc-python: a domain destroy is still in progress; "
                      "await the outstanding destroy() before create()");
    /* Claim before cc_py_new: concurrent create() from worker_threads
     * otherwise races CPython process-global init and aborts Node. */
    if (ccpy__claim_inproc_owner(owner_err, sizeof(owner_err)) != 0)
        return cc_err(CC_ERR_INVALID_ARG, owner_err);
    d = (CcPyDom *)cc_arena_alloc(&ar, sizeof(*d), 16);
    if (!d) {
        cc_arena_destroy(&ar);
        ccpy__release_inproc_owner();
        return cc_err(CC_ERR_IO, "cc-python: out of memory");
    }
    memset(d, 0, sizeof(*d));
    /* The domain lives in its own arena; from here every allocation and
     * every teardown path goes through d->arena.  The mutex guards the
     * queue AND the lifetime count, so every domain gets one. */
    pthread_mutex_init(&d->mu, NULL);
    pthread_cond_init(&d->cv, NULL);
    d->arena = ar;
    {
        CCResult_CCPy_CCPyError r = cc_py_new(false, &d->arena);
        if (!r.ok) {
            /* The load layer's message names the actual refusal (a broken
             * VIRTUAL_ENV, a static libpython, a bad usePython target) —
             * never mask it behind the generic hint. */
            static char why[560];
            snprintf(why, sizeof(why), "%s",
                     r.u.error.base.message && r.u.error.base.message[0]
                         ? r.u.error.base.message
                         : "cc-python: no Python runtime (is libpython "
                           "installed, or set CC_LIBPYTHON?)");
            {
                CCArena tmp = d->arena;
                cc_arena_destroy(&tmp);
            }
            ccpy__release_inproc_owner();
            return cc_err(CC_ERR_IO, why);
        }
        d->py = r.u.value;
    }
    {
        void *b = cc__py.ImportModule("builtins");
        if (b) {
            d->none = cc__py.GetAttrString(b, "None");
            cc__py.DecRef(b);
        }
        if (!d->none && cc__py.ErrClear) cc__py.ErrClear();
    }
    {
        void *ext = NULL;
        if (cc__js.CreateExternal(js->env, d, ccpy__dom_finalize, NULL,
                                  &ext) != 0) {
            CCArena tmp;
            ccpy__dom_sweep(d);
            tmp = d->arena;
            cc_arena_destroy(&tmp);
            ccpy__release_inproc_owner();
            return cc_err(CC_ERR_IO, "cc-python: external allocation failed");
        }
        ccpy__dom_hold(d);
        d->main_env = js->env;
        d->main_tid = pthread_self();
        {
            CCJsVal jv = { 0 };
            jv.env = js->env;
            jv.v = ext;
            return cc_ok(jv);
        }
    }
}

/* Revocation: idempotent, immediate.  The box stays until the GC
 * finalizes the External; every op on it answers "closed".  (Named
 * `close` because a module method named `destroy` is the reflection
 * convention for the module finalizer.) */
static void CcPython_close(CcPython *self, CCJs *js, CCJsExt dom) {
    CcPyDom *d = (CcPyDom *)dom.ptr;
    (void)self;
    if (!d || d->closed) return;
    /* An async lane cannot sweep synchronously — undelivered results
     * still hold Python references — so sync close initiates the same
     * revoke-then-drain the promise form does. */
    if (d->async_mode) ccpy__lane_close(d, js->env, NULL);
    else ccpy__dom_sweep(d);
}

static _Bool CcPython_closed(CcPython *self, CCJsExt dom) {
    CcPyDom *d = (CcPyDom *)dom.ptr;
    (void)self;
    return !d || d->closed;
}

/* Live handle count — the lifetime-introspection door: a debug hook can
 * assert a scope released what it minted. */
static long long CcPython_stats(CcPython *self, CCJsExt dom) {
    CcPyDom *d = ccpy__dom(dom);
    (void)self;
    return d ? d->live : -1;
}

static CCJsVal !>(CCError) CcPython_pyimport(CcPython *self, CCJs *js,
                                             CCJsExt dom, const char *name) {
    CcPyDom *d = ccpy__dom(dom);
    (void)self;
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "cc-python: bridge is closed");
    {
        /* Ownership transfers straight into the domain's box. */
        CCResult_CCPyObj_CCPyError r = cc_py_import(&d->py, name);
        if (d->async_mode) cc_py_thread_leave();
        if (!r.ok) return cc_err_CCResult_CCJsVal_CCError(r.u.error.base);
        {
            CcPyObjBox *b = ccpy__box(d, r.u.value);
            void *ext = NULL;
            if (!b) return cc_err(CC_ERR_IO, "cc-python: out of memory");
            if (ccpy__ext_make(d, js->env, b, &ext) != 0) {
                ccpy__box_undo(d, b);
                return cc_err(CC_ERR_IO,
                              "cc-python: external allocation failed");
            }
            {
                CCJsVal jv = { 0 };
                jv.env = js->env;
                jv.v = ext;
                return cc_ok(jv);
            }
        }
    }
}

/* Attribute access materializes exactly as a call result does: a scalar
 * attribute (math.pi) IS the scalar; anything else stays a held handle
 * (np.linalg) for the Proxy to keep chaining.  One rule at every
 * boundary crossing. */
/* Bulk output door: 1-D numeric buffer → TypedArray copy (mirrors
 * isolated `toTypedArray`).  Not a handle — the bytes leave the domain. */
static CCJsVal !>(CCError) CcPython_to_typed_array(CcPython *self, CCJs *js,
                                                   CCJsExt dom, CCJsExt obj) {
    CcPyDom *d = ccpy__dom(dom);
    CcPyObjBox *b;
    void *out = NULL;
    int rc;
    (void)self;
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "cc-python: bridge is closed");
    b = ccpy__objbox(d, obj);
    if (!b)
        return cc_err(CC_ERR_INVALID_ARG,
                      "cc-python: handle is released or belongs to another "
                      "bridge");
    cc__py_attach(&d->py);
    rc = ccpy__buf_to_ta(js->env, b->obj.o, &out);
    if (d->async_mode) cc_py_thread_leave();
    if (rc == 0)
        return cc_err(CC_ERR_INVALID_ARG,
                      "cc-python: not a 1-D numeric buffer "
                      "(ndarray / array.array / memoryview of "
                      "f64/f32/i32/i64/u8)");
    if (rc < 0 || !out)
        return cc_err(CC_ERR_IO, "cc-python: cannot materialize typed array");
    {
        CCJsVal jv = { 0 };
        jv.env = js->env;
        jv.v = out;
        return cc_ok(jv);
    }
}

static CCJsVal !>(CCError) CcPython_getattr(CcPython *self, CCJs *js,
                                            CCJsExt dom, CCJsExt obj,
                                            const char *name) {
    CcPyDom *d = ccpy__dom(dom);
    CcPyObjBox *b;
    (void)self;
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "cc-python: bridge is closed");
    b = ccpy__objbox(d, obj);
    if (!b)
        return cc_err(CC_ERR_INVALID_ARG,
                      "cc-python: handle is released or belongs to another "
                      "bridge");
    {
        /* Ownership transfers into the box or releases in the probe. */
        CCResult_CCPyObj_CCPyError r = cc_py_obj_get(&b->obj, name);
        if (!r.ok) {
            if (d->async_mode) cc_py_thread_leave();
            return cc_err_CCResult_CCJsVal_CCError(r.u.error.base);
        }
        {
            void *out = NULL;
            int mrc = ccpy__result_to_js(d, js->env, r.u.value, &out);
            if (d->async_mode) cc_py_thread_leave();
            if (mrc != 0)
                return cc_err(CC_ERR_IO, "cc-python: cannot materialize the "
                                         "attribute");
            {
                CCJsVal jv = { 0 };
                jv.env = js->env;
                jv.v = out;
                return cc_ok(jv);
            }
        }
    }
}

/* JS value → owned PyObject* for setattr (GIL held). */
static void *ccpy__arg_to_owned_py(const CCPyArg *a, char *errbuf,
                                  size_t errcap) {
    if (!a) return NULL;
    if (a->kind == 0) return cc__py.LongFromLongLong(a->i);
    if (a->kind == 1) return cc__py.FloatFromDouble(a->f);
    if (a->kind == 2 || a->kind == 3)
        return cc__py.UnicodeFromStringAndSize
                   ? cc__py.UnicodeFromStringAndSize(
                         (const char *)a->p, (intptr_t)a->n)
                   : NULL;
    if (a->kind == 4) {
        if (!a->p) {
            snprintf(errbuf, errcap, "cc-python: null object attribute value");
            return NULL;
        }
        cc__py.IncRef((void *)a->p);
        return (void *)a->p;
    }
    if (a->kind == 5) return cc__py.BoolFromLong(a->i ? 1 : 0);
    snprintf(errbuf, errcap,
             "cc-python: cannot assign that value as an attribute "
             "(use numbers, strings, booleans, or bridge handles)");
    return NULL;
}

/* `obj.prop = value` → setattr. Mapping key assignment uses __setitem__
 * from the JS Proxy when setattr refuses. */
static long long !>(CCError) CcPython_setattr(CcPython *self, CCJs *js,
                                              CCJsExt dom, CCJsExt obj,
                                              const char *name, CCJsVal val) {
    CcPyDom *d = ccpy__dom(dom);
    CcPyObjBox *b;
    CCPyArg a;
    void *owned = NULL;
    void *pyv;
    int rc;
    (void)self;
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "cc-python: bridge is closed");
    if (!name || !name[0])
        return cc_err(CC_ERR_INVALID_ARG, "cc-python: empty attribute name");
    b = ccpy__objbox(d, obj);
    if (!b)
        return cc_err(CC_ERR_INVALID_ARG,
                      "cc-python: handle is released or belongs to another "
                      "bridge");
    cc__py_attach(&d->py);
    if (ccpy__arg_from_js(d, js->env, val.v, &a, &owned, ccpy__errbuf,
                          sizeof(ccpy__errbuf)) != 0) {
        if (d->async_mode) cc_py_thread_leave();
        return cc_err(CC_ERR_INVALID_ARG, ccpy__errbuf);
    }
    pyv = ccpy__arg_to_owned_py(&a, ccpy__errbuf, sizeof(ccpy__errbuf));
    if (owned) cc__py.DecRef(owned);
    if (!pyv) {
        CCPyError pe;
        if (ccpy__errbuf[0]) {
            if (d->async_mode) cc_py_thread_leave();
            return cc_err(CC_ERR_INVALID_ARG, ccpy__errbuf);
        }
        pe = cc__py_err("setattr");
        if (d->async_mode) cc_py_thread_leave();
        return cc_err_CCResult_long_long_CCError(pe.base);
    }
    rc = cc__py.ObjectSetAttrString
             ? cc__py.ObjectSetAttrString(b->obj.o, name, pyv)
             : -1;
    cc__py.DecRef(pyv);
    if (rc != 0) {
        CCPyError pe = cc__py_err("setattr");
        if (d->async_mode) cc_py_thread_leave();
        return cc_err_CCResult_long_long_CCError(pe.base);
    }
    if (d->async_mode) cc_py_thread_leave();
    return cc_ok((long long)1);
}

/* Early release of one handle; answers the domain's remaining live
 * count so a scope can assert it dropped what it minted. */
static long long !>(CCError) CcPython_release(CcPython *self, CCJsExt dom,
                                              CCJsExt obj) {
    CcPyDom *d = ccpy__dom(dom);
    CcPyObjBox *b;
    (void)self;
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "cc-python: bridge is closed");
    b = ccpy__objbox(d, obj);
    if (!b)
        return cc_err(CC_ERR_INVALID_ARG,
                      "cc-python: handle is released or belongs to another "
                      "bridge");
    if (d->async_mode) cc__py_attach(&d->py);
    cc_py_obj_release(&b->obj);
    if (d->async_mode) cc_py_thread_leave();
    b->released = 1;
    if (b->prev) b->prev->next = b->next;
    else d->head = b->next;
    if (b->next) b->next->prev = b->prev;
    b->next = NULL;
    b->prev = NULL;
    d->live--;
    return cc_ok(d->live);
}

/* Typed-array element kinds accepted as zero-copy memoryviews. */
static int ccpy__ta_desc(int tt, int *esz, int *isf, int *iss,
                         char *errbuf, size_t errcap) {
    *esz = 0;
    *isf = 0;
    *iss = 1;
    switch (tt) {
    case CC__JS_TA_FLOAT64: *esz = 8; *isf = 1; return 0;
    case CC__JS_TA_FLOAT32: *esz = 4; *isf = 1; return 0;
    case CC__JS_TA_INT32:   *esz = 4; return 0;
    case CC__JS_TA_BIGINT64: *esz = 8; return 0;
    case CC__JS_TA_UINT8:
    case CC__JS_TA_UINT8_CLAMPED:
        *esz = 1;
        *iss = 0;
        return 0;
    default:
        snprintf(errbuf, errcap,
                 "cc-python: unsupported typed-array element type "
                 "(Float64/Float32/Int32/BigInt64/Uint8Array or Buffer)");
        return -1;
    }
}

/* bit_length is int-only among the numeric builtins — floats fail. */
static int ccpy__is_py_int(void *o) {
    void *a;
    if (!o || !cc__py.GetAttrString) return 0;
    a = cc__py.GetAttrString(o, "bit_length");
    if (!a) {
        if (cc__py.ErrClear) cc__py.ErrClear();
        return 0;
    }
    cc__py.DecRef(a);
    return 1;
}

/* Exact JS BigInt ← Python int (i64 / u64 / decimal digits). Never a
 * lossy double: a Python int that cannot mint BigInt fails the call. */
static int ccpy__py_int_to_js(void *env, void *o, void **out) {
    unsigned long long uv;
    void *sobj;
    intptr_t n = 0;
    const char *digits;
    if (!o || !out) return -1;
    uv = cc__py.LongAsUnsignedLongLong(o);
    if (!(uv == (unsigned long long)-1 && cc__py.ErrOccurred())) {
        if (uv <= (unsigned long long)CC__JS_MAX_SAFE_LL) {
            return cc__js.CreateDouble(env, (double)uv, out);
        }
        if (cc__js.CreateBigintU64 &&
            cc__js.CreateBigintU64(env, (uint64_t)uv, out) == 0)
            return 0;
        /* Fall through to decimal BigInt when uint64 mint is absent. */
    }
    if (cc__py.ErrClear) cc__py.ErrClear();
    sobj = cc__py.Str(o);
    if (!sobj) return -1;
    digits = cc__py.AsUTF8AndSize(sobj, &n);
    if (!digits) {
        cc__py.DecRef(sobj);
        if (cc__py.ErrClear) cc__py.ErrClear();
        return -1;
    }
    *out = cc__js_out_bigint_dec(env, digits, (size_t)n);
    cc__py.DecRef(sobj);
    return *out ? 0 : -1;
}

/* JS BigInt → owned PyLong (caller DecRefs).  Digits land in job_arena
 * (async) or call scratch (sync — caller must hold a js mark). */
static void *ccpy__bigint_to_py(CcPyDom *d, void *env, void *v, int async,
                                char *errbuf, size_t errcap) {
    _Bool lossless = 0;
    int64_t iv = 0;
    uint64_t uv = 0;
    void *s = NULL;
    size_t len = 0, got = 0;
    char *buf;
    void *py;
    if (cc__js.GetValueBigintI64 &&
        cc__js.GetValueBigintI64(env, v, &iv, &lossless) == 0 && lossless)
        return cc__py.LongFromLongLong((long long)iv);
    if (cc__js.GetValueBigintU64 &&
        cc__js.GetValueBigintU64(env, v, &uv, &lossless) == 0 && lossless)
        return cc__py.LongFromUnsignedLongLong((unsigned long long)uv);
    if (cc__js.CoerceToString(env, v, &s) != 0 || !s ||
        cc__js.GetValueStringUtf8(env, s, NULL, 0, &len) != 0) {
        snprintf(errbuf, errcap, "cc-python: cannot read a BigInt argument");
        return NULL;
    }
    buf = async ? (char *)cc_arena_alloc(&d->job_arena, len + 1, 16)
                : (char *)cc__js_scratch(len + 1);
    if (!buf) {
        snprintf(errbuf, errcap, "cc-python: out of memory");
        return NULL;
    }
    if (cc__js.GetValueStringUtf8(env, s, buf, len + 1, &got) != 0) {
        snprintf(errbuf, errcap, "cc-python: cannot read a BigInt argument");
        return NULL;
    }
    py = cc__py.LongFromString(buf, NULL, 10);
    if (!py) {
        if (cc__py.ErrClear) cc__py.ErrClear();
        snprintf(errbuf, errcap, "cc-python: cannot materialize a BigInt");
        return NULL;
    }
    return py;
}

static int ccpy__string_arg(CcPyDom *d, void *env, void *v, CCPyArg *out,
                            int async_copy, char *errbuf, size_t errcap) {
    int lone = cc__js_string_lone_surrogate(env, v);
    if (lone < 0) {
        snprintf(errbuf, errcap, "cc-python: cannot read a string argument");
        return -1;
    }
    if (lone > 0) {
        snprintf(errbuf, errcap,
                 "cc-python: string contains a lone UTF-16 surrogate");
        return -1;
    }
    if (!async_copy) {
        CCSlice s;
        if (cc__js_inq_slice(&s, env, v) != 0) {
            /* inq_slice may have thrown; clear so the bridge owns the error */
            _Bool pend = 0;
            void *exc = NULL;
            if (cc__js.IsExceptionPending(env, &pend) == 0 && pend)
                (void)cc__js.GetAndClearLastException(env, &exc);
            snprintf(errbuf, errcap, "cc-python: cannot read a string argument");
            return -1;
        }
        *out = cc__py_arg_slice(s);
        return 0;
    }
    {
        size_t len = 0, got = 0;
        char *copy;
        if (cc__js.GetValueStringUtf8(env, v, NULL, 0, &len) != 0) {
            snprintf(errbuf, errcap, "cc-python: cannot read a string argument");
            return -1;
        }
        copy = (char *)cc_arena_alloc(&d->job_arena, len + 1, 16);
        if (!copy) {
            snprintf(errbuf, errcap, "cc-python: out of memory");
            return -1;
        }
        if (cc__js.GetValueStringUtf8(env, v, copy, len + 1, &got) != 0) {
            snprintf(errbuf, errcap, "cc-python: cannot read a string argument");
            return -1;
        }
        {
            CCSlice sl = { copy, got };
            *out = cc__py_arg_slice(sl);
        }
        return 0;
    }
}

/* JS value → owned PyObject* for nested list/dict cells (GIL held).
 * Top-level typed-array leases stay on the CCPyArg path (zero-copy);
 * nested typed arrays are refused — pass them as top-level args. */
#define CCPY__ARG_DEPTH_MAX 32

static void *ccpy__js_to_py(CcPyDom *d, void *env, void *v, CcPyJob *j,
                            char *errbuf, size_t errcap, int depth) {
    int t = 0;
    if (depth > CCPY__ARG_DEPTH_MAX) {
        snprintf(errbuf, errcap,
                 "cc-python: argument nesting exceeds %d levels",
                 CCPY__ARG_DEPTH_MAX);
        return NULL;
    }
    if (cc__js.Typeof(env, v, &t) != 0) {
        snprintf(errbuf, errcap, "cc-python: cannot read an argument");
        return NULL;
    }
    if (t == CC__JS_T_UNDEFINED || t == CC__JS_T_NULL) {
        if (!d->none) {
            snprintf(errbuf, errcap, "cc-python: None unavailable");
            return NULL;
        }
        cc__py.IncRef(d->none);
        return d->none;
    }
    if (t == CC__JS_T_FUNCTION) {
        return ccpy__cb_wrap(d, env, v, errbuf, errcap);
    }
    if (t == CC__JS_T_NUMBER) {
        double dd = 0;
        cc__js.GetValueDouble(env, v, &dd);
        if (dd == 0.0 && signbit(dd))
            return cc__py.FloatFromDouble(dd);
        if (dd == (double)(long long)dd &&
            dd >= -9007199254740992.0 && dd <= 9007199254740992.0)
            return cc__py.LongFromLongLong((long long)dd);
        return cc__py.FloatFromDouble(dd);
    }
    if (t == CC__JS_T_BIGINT)
        return ccpy__bigint_to_py(d, env, v, j ? 1 : 0, errbuf, errcap);
    if (t == CC__JS_T_BOOLEAN) {
        _Bool bv = 0;
        cc__js.GetValueBool(env, v, &bv);
        return cc__py.BoolFromLong(bv ? 1 : 0);
    }
    if (t == CC__JS_T_STRING) {
        size_t len = 0, got = 0;
        char *buf;
        void *py;
        if (cc__js.GetValueStringUtf8(env, v, NULL, 0, &len) != 0) {
            snprintf(errbuf, errcap, "cc-python: cannot read a string argument");
            return NULL;
        }
        if (j) {
            buf = (char *)cc_arena_alloc(&d->arena, len + 1, 1);
            if (!buf) {
                snprintf(errbuf, errcap, "cc-python: out of memory");
                return NULL;
            }
        } else {
            buf = (char *)malloc(len + 1);
            if (!buf) {
                snprintf(errbuf, errcap, "cc-python: out of memory");
                return NULL;
            }
        }
        if (cc__js.GetValueStringUtf8(env, v, buf, len + 1, &got) != 0) {
            if (!j) free(buf);
            snprintf(errbuf, errcap, "cc-python: cannot read a string argument");
            return NULL;
        }
        py = cc__py.UnicodeFromStringAndSize(buf, (intptr_t)got);
        if (!j) free(buf);
        if (!py) {
            snprintf(errbuf, errcap, "cc-python: cannot mint a Python str");
            return NULL;
        }
        return py;
    }
    if (t == CC__JS_T_EXTERNAL) {
        void *p = NULL;
        CcPyObjBox *b;
        cc__js.GetValueExternal(env, v, &p);
        b = (CcPyObjBox *)p;
        if (!b || b->dom != d || b->released) {
            snprintf(errbuf, errcap,
                     "cc-python: an argument handle is released or belongs "
                     "to another bridge");
            return NULL;
        }
        cc__py.IncRef(b->obj.o);
        return b->obj.o;
    }
    {
        _Bool ta = 0;
        if (cc__js.IsTypedarray(env, v, &ta) == 0 && ta) {
            snprintf(errbuf, errcap,
                     "cc-python: typed arrays must be top-level call "
                     "arguments (zero-copy lease) — not nested in a "
                     "list/dict");
            return NULL;
        }
    }
    {
        _Bool isarr = 0;
        if (cc__js.IsArray(env, v, &isarr) == 0 && isarr) {
            uint32_t n = 0, i;
            void *list;
            if (cc__js.GetArrayLength(env, v, &n) != 0) {
                snprintf(errbuf, errcap, "cc-python: cannot read array length");
                return NULL;
            }
            if (!cc__py.ListNew || !cc__py.ListSetItem) {
                snprintf(errbuf, errcap, "cc-python: list APIs unavailable");
                return NULL;
            }
            list = cc__py.ListNew((intptr_t)n);
            if (!list) {
                snprintf(errbuf, errcap, "cc-python: cannot mint a Python list");
                return NULL;
            }
            for (i = 0; i < n; i++) {
                void *el = NULL, *py;
                if (cc__js.GetElement(env, v, i, &el) != 0) {
                    cc__py.DecRef(list);
                    snprintf(errbuf, errcap,
                             "cc-python: cannot read array element %u", i);
                    return NULL;
                }
                py = ccpy__js_to_py(d, env, el, j, errbuf, errcap, depth + 1);
                if (!py) {
                    cc__py.DecRef(list);
                    return NULL;
                }
                if (cc__py.ListSetItem(list, (intptr_t)i, py) != 0) {
                    cc__py.DecRef(py);
                    cc__py.DecRef(list);
                    if (cc__py.ErrClear) cc__py.ErrClear();
                    snprintf(errbuf, errcap,
                             "cc-python: cannot set list element %u", i);
                    return NULL;
                }
            }
            return list;
        }
    }
    if (t == CC__JS_T_OBJECT) {
        void *names = NULL, *dict, *ctor = NULL;
        uint32_t n = 0, i;
        int ct = 0;
        /* Refuse Set/Map/Date/class instances. Object.create(null) and
         * plain {} (constructor Object) are the only dict shapes. */
        if (cc__js.GetNamedProperty(env, v, "constructor", &ctor) == 0 &&
            ctor &&
            cc__js.Typeof(env, ctor, &ct) == 0 &&
            ct == CC__JS_T_FUNCTION) {
            void *nm = NULL;
            char cname[64];
            size_t got = 0;
            if (cc__js.GetNamedProperty(env, ctor, "name", &nm) == 0 && nm &&
                cc__js.GetValueStringUtf8
                    (env, nm, cname, sizeof(cname), &got) == 0 &&
                got > 0 && strcmp(cname, "Object") != 0) {
                snprintf(errbuf, errcap,
                         "cc-python: unsupported argument (pass numbers, "
                         "BigInt, strings, booleans, null/undefined, plain "
                         "arrays/objects, typed arrays, or bridge handles)");
                return NULL;
            }
        }
        if (!cc__py.DictNew || !cc__py.DictSetItemString) {
            snprintf(errbuf, errcap, "cc-python: dict APIs unavailable");
            return NULL;
        }
        if (cc__js.GetPropertyNames(env, v, &names) != 0 || !names) {
            snprintf(errbuf, errcap, "cc-python: cannot enumerate object keys");
            return NULL;
        }
        if (cc__js.GetArrayLength(env, names, &n) != 0) {
            snprintf(errbuf, errcap, "cc-python: cannot read object key count");
            return NULL;
        }
        dict = cc__py.DictNew();
        if (!dict) {
            snprintf(errbuf, errcap, "cc-python: cannot mint a Python dict");
            return NULL;
        }
        for (i = 0; i < n; i++) {
            void *k = NULL, *val = NULL, *py;
            char kn[256];
            size_t got = 0;
            if (cc__js.GetElement(env, names, i, &k) != 0 || !k) {
                cc__py.DecRef(dict);
                snprintf(errbuf, errcap, "cc-python: cannot read object key");
                return NULL;
            }
            if (cc__js.GetValueStringUtf8(env, k, kn, sizeof(kn), &got) != 0) {
                cc__py.DecRef(dict);
                snprintf(errbuf, errcap,
                         "cc-python: object keys must be strings "
                         "(and fit in %zu bytes)",
                         sizeof(kn) - 1);
                return NULL;
            }
            if (kn[0] == '$') {
                cc__py.DecRef(dict);
                snprintf(errbuf, errcap,
                         "cc-python: unsupported argument (object keys "
                         "starting with $ are reserved)");
                return NULL;
            }
            if (cc__js.GetNamedProperty(env, v, kn, &val) != 0 || !val) {
                cc__py.DecRef(dict);
                snprintf(errbuf, errcap,
                         "cc-python: cannot read object property '%s'", kn);
                return NULL;
            }
            py = ccpy__js_to_py(d, env, val, j, errbuf, errcap, depth + 1);
            if (!py) {
                cc__py.DecRef(dict);
                return NULL;
            }
            if (cc__py.DictSetItemString(dict, kn, py) != 0) {
                cc__py.DecRef(py);
                cc__py.DecRef(dict);
                if (cc__py.ErrClear) cc__py.ErrClear();
                snprintf(errbuf, errcap,
                         "cc-python: cannot set dict key '%s'", kn);
                return NULL;
            }
            cc__py.DecRef(py); /* DictSetItemString does not steal */
        }
        return dict;
    }
    snprintf(errbuf, errcap,
             "cc-python: unsupported argument (pass numbers, BigInt, strings, "
             "booleans, null/undefined, plain arrays/objects, typed arrays, "
             "or bridge handles)");
    return NULL;
}

/* JS argument → CCPyArg.  Numbers with integral values cross as Python
 * int; typed arrays as zero-copy memoryview leases; plain arrays/objects
 * as list/dict; null/undefined as None; externals pass the held ref. */
static int ccpy__arg_from_js(CcPyDom *d, void *env, void *v, CCPyArg *out,
                             void **owned_out, char *errbuf, size_t errcap) {
    int t = 0;
    if (owned_out) *owned_out = NULL;
    if (cc__js.Typeof(env, v, &t) != 0) {
        snprintf(errbuf, errcap, "cc-python: cannot read an argument");
        return -1;
    }
    if (t == CC__JS_T_FUNCTION) {
        CCPyObj tmp;
        void *callable = ccpy__cb_wrap(d, env, v, errbuf, errcap);
        if (!callable) return -1;
        tmp.o = callable;
        tmp.home = &d->py;
        *out = cc__py_arg_obj(tmp);
        if (owned_out) *owned_out = callable;
        return 0;
    }
    if (t == CC__JS_T_NUMBER) {
        double dd = 0;
        cc__js.GetValueDouble(env, v, &dd);
        if (dd == 0.0 && signbit(dd))
            *out = cc__py_arg_f(dd);
        else if (dd == (double)(long long)dd &&
                 dd >= -9007199254740992.0 && dd <= 9007199254740992.0)
            *out = cc__py_arg_i((long long)dd);
        else
            *out = cc__py_arg_f(dd);
        return 0;
    }
    if (t == CC__JS_T_BIGINT) {
        CCPyObj tmp;
        void *py = ccpy__bigint_to_py(d, env, v, 0, errbuf, errcap);
        if (!py) return -1;
        tmp.o = py;
        tmp.home = &d->py;
        *out = cc__py_arg_obj(tmp);
        if (owned_out) *owned_out = py;
        return 0;
    }
    if (t == CC__JS_T_BOOLEAN) {
        _Bool bv = 0;
        cc__js.GetValueBool(env, v, &bv);
        *out = cc__py_arg_bool(bv ? 1 : 0);
        return 0;
    }
    if (t == CC__JS_T_STRING)
        return ccpy__string_arg(d, env, v, out, 0, errbuf, errcap);
    if (t == CC__JS_T_EXTERNAL) {
        void *p = NULL;
        CcPyObjBox *b;
        cc__js.GetValueExternal(env, v, &p);
        b = (CcPyObjBox *)p;
        if (!b || b->dom != d || b->released) {
            snprintf(errbuf, errcap,
                     "cc-python: an argument handle is released or belongs "
                     "to another bridge");
            return -1;
        }
        *out = cc__py_arg_obj(b->obj);
        return 0;
    }
    {
        _Bool ta = 0;
        if (cc__js.IsTypedarray(env, v, &ta) == 0 && ta) {
            int tt = 0;
            size_t len = 0;
            void *data = NULL;
            void *ab = NULL;
            size_t off = 0;
            int esz = 0, isf = 0, iss = 1;
            if (cc__js.GetTypedarrayInfo(env, v, &tt, &len, &data, &ab, &off) != 0) {
                snprintf(errbuf, errcap, "cc-python: cannot read a typed array");
                return -1;
            }
            if (ccpy__ta_desc(tt, &esz, &isf, &iss, errbuf, errcap) != 0)
                return -1;
            {
                CCSlice s = { (char *)data, len };
                *out = cc__py_arg_buffer(cc__py_arg_tslice(s, esz, isf, iss));
            }
            return 0;
        }
    }
    if (t == CC__JS_T_UNDEFINED || t == CC__JS_T_NULL || t == CC__JS_T_OBJECT) {
        CCPyObj tmp;
        void *py = ccpy__js_to_py(d, env, v, NULL, errbuf, errcap, 0);
        if (!py) return -1;
        tmp.o = py;
        tmp.home = &d->py;
        *out = cc__py_arg_obj(tmp);
        if (owned_out) *owned_out = py;
        return 0;
    }
    snprintf(errbuf, errcap,
             "cc-python: unsupported argument (pass numbers, BigInt, strings, "
             "booleans, null/undefined, plain arrays/objects, typed arrays, "
             "or bridge handles)");
    return -1;
}

/* ---- strict toJS: one-crossing deep materialize -------------------- */

#define CCPY__TOJS_MAX_DEPTH 64
#define CCPY__TOJS_PATH_CAP  384

typedef struct {
    char path[CCPY__TOJS_PATH_CAP];
    size_t plen;
    void *stack[CCPY__TOJS_MAX_DEPTH];
    int depth;
} CcpyToJsCtx;

static void ccpy__tojs_path_set_root(CcpyToJsCtx *c) {
    c->path[0] = '$';
    c->path[1] = 0;
    c->plen = 1;
    c->depth = 0;
}

static size_t ccpy__tojs_path_mark(CcpyToJsCtx *c) { return c->plen; }

static void ccpy__tojs_path_reset(CcpyToJsCtx *c, size_t mark) {
    c->plen = mark;
    c->path[mark] = 0;
}

static void ccpy__tojs_path_push_key(CcpyToJsCtx *c, const char *k, size_t kn) {
    size_t i, need;
    int bracket = 0;
    if (!k) return;
    for (i = 0; i < kn; i++) {
        char ch = k[i];
        if (!((ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') ||
              (ch >= '0' && ch <= '9') || ch == '_' || ch == '$')) {
            bracket = 1;
            break;
        }
        if (i == 0 && (ch >= '0' && ch <= '9')) bracket = 1;
    }
    if (!bracket) {
        need = c->plen + 1 + kn + 1;
        if (need > CCPY__TOJS_PATH_CAP) return;
        c->path[c->plen++] = '.';
        memcpy(c->path + c->plen, k, kn);
        c->plen += kn;
        c->path[c->plen] = 0;
        return;
    }
    need = c->plen + 2 + kn + 2;
    if (need > CCPY__TOJS_PATH_CAP) return;
    c->path[c->plen++] = '[';
    c->path[c->plen++] = '"';
    memcpy(c->path + c->plen, k, kn);
    c->plen += kn;
    c->path[c->plen++] = '"';
    c->path[c->plen++] = ']';
    c->path[c->plen] = 0;
}

static void ccpy__tojs_path_push_idx(CcpyToJsCtx *c, long long idx) {
    char tmp[32];
    int n = snprintf(tmp, sizeof(tmp), "[%lld]", idx);
    if (n <= 0 || c->plen + (size_t)n + 1 > CCPY__TOJS_PATH_CAP) return;
    memcpy(c->path + c->plen, tmp, (size_t)n);
    c->plen += (size_t)n;
    c->path[c->plen] = 0;
}

static int ccpy__tojs_type_name(void *o, char *buf, size_t cap) {
    void *cls, *nm;
    const char *s;
    intptr_t n = 0;
    if (!o || !buf || cap < 2) return -1;
    buf[0] = 0;
    cls = cc__py.GetAttrString(o, "__class__");
    if (!cls) {
        if (cc__py.ErrClear) cc__py.ErrClear();
        return -1;
    }
    nm = cc__py.GetAttrString(cls, "__name__");
    cc__py.DecRef(cls);
    if (!nm) {
        if (cc__py.ErrClear) cc__py.ErrClear();
        return -1;
    }
    s = cc__py.AsUTF8AndSize(nm, &n);
    if (!s || n <= 0) {
        cc__py.DecRef(nm);
        if (cc__py.ErrClear) cc__py.ErrClear();
        return -1;
    }
    if ((size_t)n + 1 > cap) n = (intptr_t)cap - 1;
    memcpy(buf, s, (size_t)n);
    buf[n] = 0;
    cc__py.DecRef(nm);
    return 0;
}

static int ccpy__tojs_refuse(CcpyToJsCtx *c, const char *tn, const char *hint) {
    if (hint && hint[0])
        snprintf(ccpy__errbuf, sizeof(ccpy__errbuf),
                 "cc-python: toJS: cannot materialize %s at %s — %s",
                 tn && tn[0] ? tn : "object", c->path, hint);
    else
        snprintf(ccpy__errbuf, sizeof(ccpy__errbuf),
                 "cc-python: toJS: cannot materialize %s at %s",
                 tn && tn[0] ? tn : "object", c->path);
    return -1;
}

/* Borrowed o → JS scalar, or 1 if not a scalar (no error). -1 on OOM. */
static int ccpy__tojs_scalar(CcPyDom *d, void *env, void *o, void **out) {
    {
        void *t = cc__py.BoolFromLong(1);
        void *f = cc__py.BoolFromLong(0);
        int is_t = (o == t), is_f = (o == f);
        if (t) cc__py.DecRef(t);
        if (f) cc__py.DecRef(f);
        if (is_t || is_f) return cc__js.GetBoolean(env, is_t, out);
    }
    /* None → JSON null (stringify-safe); not undefined. */
    if (d->none && o == d->none) {
        if (!cc__js.GetNull) return -1;
        return cc__js.GetNull(env, out);
    }
    {
        intptr_t n = 0;
        const char *s = cc__py.AsUTF8AndSize(o, &n);
        if (s) return cc__js.CreateStringUtf8(env, s, (size_t)n, out);
        if (cc__py.ErrClear) cc__py.ErrClear();
    }
    {
        CCPyObj tmp;
        CCResult_int64_t_CCPyError iv;
        tmp.o = o;
        tmp.home = &d->py;
        iv = cc_py_obj_as_i64(&tmp);
        if (iv.ok) {
            void *v = cc__js_out_ll(env, (long long)iv.u.value);
            if (!v) return -1;
            *out = v;
            return 0;
        }
        if (cc__py.ErrClear) cc__py.ErrClear();
    }
    if (ccpy__is_py_int(o)) {
        void *v = NULL;
        if (ccpy__py_int_to_js(env, o, &v) != 0 || !v) return -1;
        *out = v;
        return 0;
    }
    {
        CCPyObj tmp;
        CCResult_double_CCPyError fv;
        tmp.o = o;
        tmp.home = &d->py;
        fv = cc_py_obj_as_f64(&tmp);
        if (fv.ok) return cc__js.CreateDouble(env, fv.u.value, out);
        if (cc__py.ErrClear) cc__py.ErrClear();
    }
    return 1; /* not a scalar */
}

static int ccpy__deep_to_js(CcPyDom *d, void *env, void *o, CcpyToJsCtx *c,
                            void **out);

static int ccpy__tojs_mapping(CcPyDom *d, void *env, void *o, CcpyToJsCtx *c,
                              void **out) {
    void *items = NULL;
    intptr_t n, i;
    void *obj = NULL;
    char tn[64];
    /* Strict: only dict — not UserDict / OrderedDict / other mappings. */
    if (ccpy__tojs_type_name(o, tn, sizeof(tn)) != 0) tn[0] = 0;
    if (strcmp(tn, "dict") != 0) return 1;
    if (!cc__py.MappingItems || !cc__js.CreateObject ||
        !cc__js.SetNamedProperty)
        return ccpy__tojs_refuse(c, "dict", "runtime lacks mapping APIs");
    items = cc__py.MappingItems(o);
    if (!items) {
        if (cc__py.ErrClear) cc__py.ErrClear();
        return 1; /* not a mapping */
    }
    n = cc__py.SequenceSize ? cc__py.SequenceSize(items) : -1;
    if (n < 0) {
        cc__py.DecRef(items);
        if (cc__py.ErrClear) cc__py.ErrClear();
        return 1;
    }
    if (cc__js.CreateObject(env, &obj) != 0 || !obj) {
        cc__py.DecRef(items);
        snprintf(ccpy__errbuf, sizeof(ccpy__errbuf),
                 "cc-python: toJS: cannot create object at %s", c->path);
        return -1;
    }
    for (i = 0; i < n; i++) {
        void *pair;
        void *kobj;
        void *vobj;
        void *jv;
        char kbuf[256];
        const char *ks;
        intptr_t kn;
        size_t mark;
        pair = cc__py.SequenceGetItem(items, i);
        kobj = NULL;
        vobj = NULL;
        jv = NULL;
        ks = NULL;
        kn = 0;
        if (!pair) {
            if (cc__py.ErrClear) cc__py.ErrClear();
            cc__py.DecRef(items);
            return ccpy__tojs_refuse(c, "dict", "broken items()");
        }
        kobj = cc__py.SequenceGetItem(pair, 0);
        vobj = cc__py.SequenceGetItem(pair, 1);
        cc__py.DecRef(pair);
        if (!kobj || !vobj) {
            if (kobj) cc__py.DecRef(kobj);
            if (vobj) cc__py.DecRef(vobj);
            cc__py.DecRef(items);
            return ccpy__tojs_refuse(c, "dict", "broken items() pair");
        }
        /* bool is an int subclass — refuse (no silent True→"1"). */
        {
            void *t = cc__py.BoolFromLong(1);
            void *f = cc__py.BoolFromLong(0);
            int is_bool = (kobj == t || kobj == f);
            if (t) cc__py.DecRef(t);
            if (f) cc__py.DecRef(f);
            if (is_bool) {
                cc__py.DecRef(kobj);
                cc__py.DecRef(vobj);
                cc__py.DecRef(items);
                return ccpy__tojs_refuse(c, "bool",
                                        "dict keys must be str or int");
            }
        }
        ks = cc__py.AsUTF8AndSize(kobj, &kn);
        if (!ks) {
            if (cc__py.ErrClear) cc__py.ErrClear();
            /* Int keys → decimal string (JS object key). */
            {
                CCPyObj tmp;
                CCResult_int64_t_CCPyError iv;
                tmp.o = kobj;
                tmp.home = &d->py;
                iv = cc_py_obj_as_i64(&tmp);
                if (iv.ok) {
                    kn = (intptr_t)snprintf(kbuf, sizeof(kbuf), "%lld",
                                            (long long)iv.u.value);
                    ks = kbuf;
                } else if (ccpy__is_py_int(kobj)) {
                    /* Big int key — still stringify via Python str. */
                    void *s = cc__py.Str ? cc__py.Str(kobj) : NULL;
                    if (s) {
                        ks = cc__py.AsUTF8AndSize(s, &kn);
                        if (ks && kn > 0 && (size_t)kn < sizeof(kbuf)) {
                            memcpy(kbuf, ks, (size_t)kn);
                            kbuf[kn] = 0;
                            ks = kbuf;
                        } else
                            ks = NULL;
                        cc__py.DecRef(s);
                    }
                    if (cc__py.ErrClear) cc__py.ErrClear();
                } else if (cc__py.ErrClear)
                    cc__py.ErrClear();
            }
        } else if (kn > 0 && (size_t)kn < sizeof(kbuf)) {
            memcpy(kbuf, ks, (size_t)kn);
            kbuf[kn] = 0;
            ks = kbuf;
        }
        if (!ks) {
            char tn[64];
            ccpy__tojs_type_name(kobj, tn, sizeof(tn));
            cc__py.DecRef(kobj);
            cc__py.DecRef(vobj);
            cc__py.DecRef(items);
            return ccpy__tojs_refuse(c, tn[0] ? tn : "key",
                                    "dict keys must be str or int");
        }
        mark = ccpy__tojs_path_mark(c);
        ccpy__tojs_path_push_key(c, ks, (size_t)kn);
        if (ccpy__deep_to_js(d, env, vobj, c, &jv) != 0) {
            cc__py.DecRef(kobj);
            cc__py.DecRef(vobj);
            cc__py.DecRef(items);
            return -1;
        }
        ccpy__tojs_path_reset(c, mark);
        if (cc__js.SetNamedProperty(env, obj, ks, jv) != 0) {
            cc__py.DecRef(kobj);
            cc__py.DecRef(vobj);
            cc__py.DecRef(items);
            snprintf(ccpy__errbuf, sizeof(ccpy__errbuf),
                     "cc-python: toJS: cannot set key at %s", c->path);
            return -1;
        }
        cc__py.DecRef(kobj);
        cc__py.DecRef(vobj);
    }
    cc__py.DecRef(items);
    *out = obj;
    return 0;
}

static int ccpy__tojs_sequence(CcPyDom *d, void *env, void *o, CcpyToJsCtx *c,
                               void **out) {
    char tn[64];
    intptr_t n, i;
    void *arr = NULL;
    if (ccpy__tojs_type_name(o, tn, sizeof(tn)) != 0) tn[0] = 0;
    if (strcmp(tn, "list") != 0 && strcmp(tn, "tuple") != 0) return 1;
    if (!cc__py.SequenceSize || !cc__py.SequenceGetItem || !cc__js.CreateArray ||
        !cc__js.SetElement)
        return ccpy__tojs_refuse(c, tn, "runtime lacks sequence APIs");
    n = cc__py.SequenceSize(o);
    if (n < 0) {
        if (cc__py.ErrClear) cc__py.ErrClear();
        return 1;
    }
    if (cc__js.CreateArray(env, (size_t)n, &arr) != 0 || !arr) {
        snprintf(ccpy__errbuf, sizeof(ccpy__errbuf),
                 "cc-python: toJS: cannot create array at %s", c->path);
        return -1;
    }
    for (i = 0; i < n; i++) {
        void *item = cc__py.SequenceGetItem(o, i);
        void *jv = NULL;
        size_t mark;
        if (!item) {
            if (cc__py.ErrClear) cc__py.ErrClear();
            return ccpy__tojs_refuse(c, tn, "broken sequence item");
        }
        mark = ccpy__tojs_path_mark(c);
        ccpy__tojs_path_push_idx(c, (long long)i);
        if (ccpy__deep_to_js(d, env, item, c, &jv) != 0) {
            cc__py.DecRef(item);
            return -1;
        }
        ccpy__tojs_path_reset(c, mark);
        if (cc__js.SetElement(env, arr, (uint32_t)i, jv) != 0) {
            cc__py.DecRef(item);
            snprintf(ccpy__errbuf, sizeof(ccpy__errbuf),
                     "cc-python: toJS: cannot set element at %s", c->path);
            return -1;
        }
        cc__py.DecRef(item);
    }
    *out = arr;
    return 0;
}

static int ccpy__deep_to_js(CcPyDom *d, void *env, void *o, CcpyToJsCtx *c,
                            void **out) {
    int rc, i;
    char tn[64];
    if (!o) return ccpy__tojs_refuse(c, "NoneType", NULL);
    for (i = 0; i < c->depth; i++) {
        if (c->stack[i] == o)
            return ccpy__tojs_refuse(c, "object",
                                    "cycle detected (circular reference)");
    }
    /* Containers before scalars: a mapping/sequence must not be misread
     * as a scalar (as_i64/as_f64 on some types can spuriously succeed). */
    if (c->depth >= CCPY__TOJS_MAX_DEPTH)
        return ccpy__tojs_refuse(c, "object", "nesting too deep");
    c->stack[c->depth++] = o;
    rc = ccpy__tojs_mapping(d, env, o, c, out);
    if (rc <= 0) {
        c->depth--;
        return rc;
    }
    rc = ccpy__tojs_sequence(d, env, o, c, out);
    if (rc <= 0) {
        c->depth--;
        return rc;
    }
    c->depth--;
    rc = ccpy__tojs_scalar(d, env, o, out);
    if (rc <= 0) return rc;
    ccpy__tojs_type_name(o, tn, sizeof(tn));
    if (strcmp(tn, "set") == 0 || strcmp(tn, "frozenset") == 0)
        return ccpy__tojs_refuse(c, tn, "convert with list(...)");
    if (strcmp(tn, "bytes") == 0 || strcmp(tn, "bytearray") == 0 ||
        strcmp(tn, "memoryview") == 0)
        return ccpy__tojs_refuse(c, tn,
                                "use toTypedArray() or list(...) for bytes");
    return ccpy__tojs_refuse(c, tn[0] ? tn : "object",
                            "not a JSON-safe scalar, dict, list, or tuple");
}

static CCJsVal !>(CCError) CcPython_to_js(CcPython *self, CCJs *js, CCJsExt dom,
                                          CCJsExt obj) {
    CcPyDom *d = ccpy__dom(dom);
    CcPyObjBox *b;
    CcpyToJsCtx ctx;
    void *out = NULL;
    int rc;
    (void)self;
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "cc-python: bridge is closed");
    b = ccpy__objbox(d, obj);
    if (!b)
        return cc_err(CC_ERR_INVALID_ARG,
                      "cc-python: handle is released or belongs to another "
                      "bridge");
    ccpy__tojs_path_set_root(&ctx);
    ccpy__errbuf[0] = 0;
    cc__py_attach(&d->py);
    rc = ccpy__deep_to_js(d, js->env, b->obj.o, &ctx, &out);
    /* Sync domains also drop the GIL between ops — holding it across
     * napi/GC re-entry made deep materialize return a stale scalar. */
    cc_py_thread_leave();
    if (rc != 0 || !out)
        return cc_err(CC_ERR_INVALID_ARG,
                      ccpy__errbuf[0] ? ccpy__errbuf
                                      : "cc-python: toJS failed");
    {
        CCJsVal jv = { 0 };
        jv.env = js->env;
        jv.v = out;
        return cc_ok(jv);
    }
}

/* Python result → JS value.  Scalars materialize (bool, str, int —
 * exact BigInt past 2^53, including the full u64 range and beyond —
 * float, None → undefined); anything else stays a held reference,
 * registered with the domain and returned as a handle for the Proxy. */
static int ccpy__result_to_js(CcPyDom *d, void *env, CCPyObj r, void **out) {
    void *o = r.o;
    /* bool first — Python bool is a subtype of int. */
    {
        void *t = cc__py.BoolFromLong(1);
        void *f = cc__py.BoolFromLong(0);
        int is_t = (o == t), is_f = (o == f);
        if (t) cc__py.DecRef(t);
        if (f) cc__py.DecRef(f);
        if (is_t || is_f) {
            cc_py_obj_release(&r);
            return cc__js.GetBoolean(env, is_t, out);
        }
    }
    if (d->none && o == d->none) {
        cc_py_obj_release(&r);
        return cc__js.GetUndefined(env, out);
    }
    {
        intptr_t n = 0;
        const char *s = cc__py.AsUTF8AndSize(o, &n);
        if (s) {
            int rc = cc__js.CreateStringUtf8(env, s, (size_t)n, out);
            cc_py_obj_release(&r);
            return rc;
        }
        if (cc__py.ErrClear) cc__py.ErrClear();
    }
    {
        CCResult_int64_t_CCPyError iv = cc_py_obj_as_i64(&r);
        if (iv.ok) {
            void *v = cc__js_out_ll(env, (long long)iv.u.value);
            cc_py_obj_release(&r);
            if (!v) return -1;
            *out = v;
            return 0;
        }
        if (cc__py.ErrClear) cc__py.ErrClear();
    }
    /* Ints beyond signed i64: exact BigInt — never PyFloat_AsDouble. */
    if (ccpy__is_py_int(o)) {
        void *v = NULL;
        if (ccpy__py_int_to_js(env, o, &v) != 0 || !v) {
            cc_py_obj_release(&r);
            return -1;
        }
        cc_py_obj_release(&r);
        *out = v;
        return 0;
    }
    {
        CCResult_double_CCPyError fv = cc_py_obj_as_f64(&r);
        if (fv.ok) {
            int rc = cc__js.CreateDouble(env, fv.u.value, out);
            cc_py_obj_release(&r);
            return rc;
        }
        if (cc__py.ErrClear) cc__py.ErrClear();
    }
    {
        CcPyObjBox *b = ccpy__box(d, r);
        if (!b) return -1;
        if (ccpy__ext_make(d, env, b, out) != 0) {
            ccpy__box_undo(d, b);
            return -1;
        }
        return 0;
    }
}

static CCJsVal !>(CCError) CcPython_invoke(CcPython *self, CCJs *js,
                                           CCJsExt dom, CCJsExt fn,
                                           CCJsVal args) {
    CcPyDom *d = ccpy__dom(dom);
    CcPyObjBox *fb;
    CCPyArg argv[CC__PY_MAX_CALL_ARGS];
    void *owned[CC__PY_MAX_CALL_ARGS]; /* minted callables to drop post-call */
    uint32_t argc = 0, i;
    _Bool isarr = 0;
    CC__JsMark mark;
    (void)self;
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "cc-python: bridge is closed");
    fb = ccpy__objbox(d, fn);
    if (!fb)
        return cc_err(CC_ERR_INVALID_ARG,
                      "cc-python: handle is released or belongs to another "
                      "bridge");
    if (cc__js.IsArray(js->env, args.v, &isarr) != 0 || !isarr)
        return cc_err(CC_ERR_INVALID_ARG,
                      "cc-python: invoke wants an argument ARRAY");
    if (cc__js.GetArrayLength(js->env, args.v, &argc) != 0 ||
        argc > CC__PY_MAX_CALL_ARGS)
        return cc_err(CC_ERR_INVALID_ARG, "cc-python: too many arguments");
    mark = cc__js_mark();
    /* Minting callables and (on an async domain) refcounts need the GIL. */
    cc__py_attach(&d->py);
    for (i = 0; i < argc; i++) {
        void *el = NULL;
        if (cc__js.GetElement(js->env, args.v, i, &el) != 0 ||
            ccpy__arg_from_js(d, js->env, el, &argv[i], &owned[i],
                              ccpy__errbuf, sizeof(ccpy__errbuf)) != 0) {
            uint32_t k;
            for (k = 0; k < i; k++)
                if (owned[k]) cc__py.DecRef(owned[k]);
            if (d->async_mode) cc_py_thread_leave();
            cc__js_release(mark);
            return cc_err(CC_ERR_INVALID_ARG, ccpy__errbuf);
        }
    }
    /* Bare eval/exec: supply the domain's __main__ dict as globals. */
    if (argc == 1 && ccpy__is_builtin_eval_or_exec(fb->obj.o)) {
        void *ns = ccpy__domain_ns(d);
        CCPyObj nso;
        if (!ns) {
            for (i = 0; i < argc; i++)
                if (owned[i]) cc__py.DecRef(owned[i]);
            if (d->async_mode) cc_py_thread_leave();
            cc__js_release(mark);
            return cc_err(CC_ERR_IO,
                          "cc-python: cannot resolve __main__ for bare "
                          "eval/exec");
        }
        nso.o = ns;
        nso.home = &d->py;
        argv[1] = cc__py_arg_obj(nso);
        owned[1] = NULL;
        argc = 2;
    }
    {
        CCPyObj *f = &fb->obj;
        CCResult_CCPyObj_CCPyError r =
            cc__py_obj_callm_n(f, "invoke", (int)argc, argv);
        for (i = 0; i < argc; i++)
            if (owned[i]) cc__py.DecRef(owned[i]);
        cc__js_release(mark);
        if (!r.ok) {
            if (d->async_mode) cc_py_thread_leave();
            return cc_err_CCResult_CCJsVal_CCError(r.u.error.base);
        }
        {
            void *out = NULL;
            int mrc = ccpy__result_to_js(d, js->env, r.u.value, &out);
            if (d->async_mode) cc_py_thread_leave();
            if (mrc != 0)
                return cc_err(CC_ERR_IO, "cc-python: cannot materialize the "
                                         "result");
            {
                CCJsVal jv = { 0 };
                jv.env = js->env;
                jv.v = out;
                return cc_ok(jv);
            }
        }
    }
}

/* Like invoke, with an explicit kwargs object (plain JS object → keywords).
 * Positionals stay in `args`; `kwargs(...)` is peeled in JS before this. */
static CCJsVal !>(CCError) CcPython_invoke_kw(CcPython *self, CCJs *js,
                                              CCJsExt dom, CCJsExt fn,
                                              CCJsVal args, CCJsVal kw) {
    CcPyDom *d = ccpy__dom(dom);
    CcPyObjBox *fb;
    CCPyArg argv[CC__PY_MAX_CALL_ARGS];
    void *owned[CC__PY_MAX_CALL_ARGS];
    uint32_t argc = 0, i;
    _Bool isarr = 0;
    CC__JsMark mark;
    (void)self;
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "cc-python: bridge is closed");
    fb = ccpy__objbox(d, fn);
    if (!fb)
        return cc_err(CC_ERR_INVALID_ARG,
                      "cc-python: handle is released or belongs to another "
                      "bridge");
    if (cc__js.IsArray(js->env, args.v, &isarr) != 0 || !isarr)
        return cc_err(CC_ERR_INVALID_ARG,
                      "cc-python: invoke wants an argument ARRAY");
    if (cc__js.GetArrayLength(js->env, args.v, &argc) != 0 ||
        argc > CC__PY_MAX_CALL_ARGS)
        return cc_err(CC_ERR_INVALID_ARG, "cc-python: too many arguments");
    mark = cc__js_mark();
    cc__py_attach(&d->py);
    for (i = 0; i < argc; i++) {
        void *el = NULL;
        if (cc__js.GetElement(js->env, args.v, i, &el) != 0 ||
            ccpy__arg_from_js(d, js->env, el, &argv[i], &owned[i],
                              ccpy__errbuf, sizeof(ccpy__errbuf)) != 0) {
            uint32_t k;
            for (k = 0; k < i; k++)
                if (owned[k]) cc__py.DecRef(owned[k]);
            if (d->async_mode) cc_py_thread_leave();
            cc__js_release(mark);
            return cc_err(CC_ERR_INVALID_ARG, ccpy__errbuf);
        }
    }
    if (ccpy__pack_kwargs(d, js->env, kw.v, argv, owned, &argc,
                          CC__PY_MAX_CALL_ARGS, NULL, ccpy__errbuf,
                          sizeof(ccpy__errbuf)) != 0) {
        for (i = 0; i < argc; i++)
            if (owned[i]) cc__py.DecRef(owned[i]);
        if (d->async_mode) cc_py_thread_leave();
        cc__js_release(mark);
        return cc_err(CC_ERR_INVALID_ARG, ccpy__errbuf);
    }
    {
        CCPyObj *f = &fb->obj;
        CCResult_CCPyObj_CCPyError r =
            cc__py_obj_callm_n(f, "invoke", (int)argc, argv);
        for (i = 0; i < argc; i++)
            if (owned[i]) cc__py.DecRef(owned[i]);
        cc__js_release(mark);
        if (!r.ok) {
            if (d->async_mode) cc_py_thread_leave();
            return cc_err_CCResult_CCJsVal_CCError(r.u.error.base);
        }
        {
            void *out = NULL;
            int mrc = ccpy__result_to_js(d, js->env, r.u.value, &out);
            if (d->async_mode) cc_py_thread_leave();
            if (mrc != 0)
                return cc_err(CC_ERR_IO, "cc-python: cannot materialize the "
                                         "result");
            {
                CCJsVal jv = { 0 };
                jv.env = js->env;
                jv.v = out;
                return cc_ok(jv);
            }
        }
    }
}

/* Pack one JS argument for an async job: same probes as the sync path,
 * but string copies land in the job arena (the call outlives this
 * frame), typed arrays gain a napi_ref pinning the buffer to the job,
 * and handle args are IncRef'd — the job owns its references.  Caller
 * holds the interpreter's GIL. */
static int ccpy__arg_pack_async(CcPyDom *d, void *env, void *v, CcPyJob *j,
                                CCPyArg *out, char *errbuf, size_t errcap) {
    int t = 0;
    if (cc__js.Typeof(env, v, &t) != 0) {
        snprintf(errbuf, errcap, "cc-python: cannot read an argument");
        return -1;
    }
    if (t == CC__JS_T_FUNCTION) {
        CCPyObj tmp;
        void *callable = ccpy__cb_wrap(d, env, v, errbuf, errcap);
        if (!callable) return -1;
        tmp.o = callable;
        tmp.home = &d->py;
        *out = cc__py_arg_obj(tmp);
        return 0;
    }
    if (t == CC__JS_T_NUMBER) {
        double dd = 0;
        cc__js.GetValueDouble(env, v, &dd);
        if (dd == 0.0 && signbit(dd))
            *out = cc__py_arg_f(dd);
        else if (dd == (double)(long long)dd &&
                 dd >= -9007199254740992.0 && dd <= 9007199254740992.0)
            *out = cc__py_arg_i((long long)dd);
        else
            *out = cc__py_arg_f(dd);
        return 0;
    }
    if (t == CC__JS_T_BIGINT) {
        CCPyObj tmp;
        void *py = ccpy__bigint_to_py(d, env, v, 1, errbuf, errcap);
        if (!py) return -1;
        tmp.o = py;
        tmp.home = &d->py;
        *out = cc__py_arg_obj(tmp);
        return 0;
    }
    if (t == CC__JS_T_BOOLEAN) {
        _Bool bv = 0;
        cc__js.GetValueBool(env, v, &bv);
        *out = cc__py_arg_bool(bv ? 1 : 0);
        return 0;
    }
    if (t == CC__JS_T_STRING)
        return ccpy__string_arg(d, env, v, out, 1, errbuf, errcap);
    if (t == CC__JS_T_EXTERNAL) {
        void *p = NULL;
        CcPyObjBox *b;
        cc__js.GetValueExternal(env, v, &p);
        b = (CcPyObjBox *)p;
        if (!b || b->dom != d || b->released) {
            snprintf(errbuf, errcap,
                     "cc-python: an argument handle is released or belongs "
                     "to another bridge");
            return -1;
        }
        cc__py.IncRef(b->obj.o);
        *out = cc__py_arg_obj(b->obj);
        return 0;
    }
    {
        _Bool ta = 0;
        if (cc__js.IsTypedarray(env, v, &ta) == 0 && ta) {
            int tt = 0;
            size_t len = 0;
            void *data = NULL;
            void *ab = NULL;
            size_t off = 0;
            int esz = 0, isf = 0, iss = 1;
            void *ref = NULL;
            if (cc__js.GetTypedarrayInfo(env, v, &tt, &len, &data, &ab,
                                         &off) != 0) {
                snprintf(errbuf, errcap, "cc-python: cannot read a typed array");
                return -1;
            }
            if (ccpy__ta_desc(tt, &esz, &isf, &iss, errbuf, errcap) != 0)
                return -1;
            if (cc__js.CreateReference(env, v, 1, &ref) != 0) {
                snprintf(errbuf, errcap, "cc-python: cannot pin a typed array");
                return -1;
            }
            j->buf_refs[j->nbuf++] = ref;
            {
                CCSlice sl = { (char *)data, len };
                *out = cc__py_arg_buffer(cc__py_arg_tslice(sl, esz, isf, iss));
            }
            return 0;
        }
    }
    if (t == CC__JS_T_UNDEFINED || t == CC__JS_T_NULL || t == CC__JS_T_OBJECT) {
        CCPyObj tmp;
        void *py = ccpy__js_to_py(d, env, v, j, errbuf, errcap, 0);
        if (!py) return -1;
        tmp.o = py;
        tmp.home = &d->py;
        *out = cc__py_arg_obj(tmp);
        return 0;
    }
    snprintf(errbuf, errcap,
             "cc-python: unsupported argument (pass numbers, BigInt, strings, "
             "booleans, null/undefined, plain arrays/objects, typed arrays, "
             "or bridge handles)");
    return -1;
}

/* Attach keyword args from a plain JS object onto argv[argc..].
 * kwname strings are arena-allocated on the domain (live for the call /
 * async job). */
static int ccpy__pack_kwargs(CcPyDom *d, void *env, void *kw,
                             CCPyArg *argv, void **owned, uint32_t *argc,
                             uint32_t argcap, CcPyJob *j, char *errbuf,
                             size_t errcap) {
    void *names = NULL;
    uint32_t n = 0, i;
    int t = 0;
    if (!kw) return 0;
    if (cc__js.Typeof(env, kw, &t) != 0) {
        snprintf(errbuf, errcap, "cc-python: kwargs wants a plain object");
        return -1;
    }
    if (t == CC__JS_T_UNDEFINED || t == CC__JS_T_NULL) return 0;
    if (t != CC__JS_T_OBJECT) {
        snprintf(errbuf, errcap, "cc-python: kwargs wants a plain object");
        return -1;
    }
    {
        _Bool isarr = 0;
        if (cc__js.IsArray(env, kw, &isarr) == 0 && isarr) {
            snprintf(errbuf, errcap, "cc-python: kwargs wants a plain object");
            return -1;
        }
    }
    if (cc__js.GetPropertyNames(env, kw, &names) != 0 || !names) {
        snprintf(errbuf, errcap, "cc-python: cannot enumerate kwargs");
        return -1;
    }
    if (cc__js.GetArrayLength(env, names, &n) != 0) {
        snprintf(errbuf, errcap, "cc-python: cannot read kwargs length");
        return -1;
    }
    if (*argc + n > argcap) {
        snprintf(errbuf, errcap, "cc-python: too many arguments");
        return -1;
    }
    for (i = 0; i < n; i++) {
        void *k = NULL, *val = NULL;
        char kn[256];
        char *nm;
        size_t got = 0;
        uint32_t slot = *argc;
        if (cc__js.GetElement(env, names, i, &k) != 0 || !k ||
            cc__js.GetValueStringUtf8(env, k, kn, sizeof(kn), &got) != 0) {
            snprintf(errbuf, errcap, "cc-python: kwargs keys must be strings");
            return -1;
        }
        if (kn[0] == '$') {
            snprintf(errbuf, errcap,
                     "cc-python: kwargs keys starting with $ are reserved");
            return -1;
        }
        if (got >= 128) {
            snprintf(errbuf, errcap, "cc-python: kwargs key too long");
            return -1;
        }
        if (cc__js.GetNamedProperty(env, kw, kn, &val) != 0 || !val) {
            snprintf(errbuf, errcap, "cc-python: cannot read kwargs '%s'", kn);
            return -1;
        }
        if (j) {
            if (ccpy__arg_pack_async(d, env, val, j, &argv[slot], errbuf,
                                     errcap) != 0)
                return -1;
            if (owned) owned[slot] = NULL;
        } else {
            if (ccpy__arg_from_js(d, env, val, &argv[slot],
                                  owned ? &owned[slot] : NULL, errbuf,
                                  errcap) != 0)
                return -1;
        }
        nm = (char *)cc_arena_alloc(&d->arena, got + 1, 1);
        if (!nm) {
            snprintf(errbuf, errcap, "cc-python: out of memory");
            return -1;
        }
        memcpy(nm, kn, got + 1);
        argv[slot] = cc__py_arg_named(nm, argv[slot]);
        (*argc)++;
    }
    return 0;
}

/* Unwind a partially packed job (caller holds the GIL): drop the job's
 * references and pins, recycle the record. */
static void ccpy__job_abort(CcPyDom *d, void *env, CcPyJob *j, int npacked) {
    int i;
    for (i = 0; i < npacked; i++)
        if (j->args[i].kind == 4) cc__py.DecRef((void *)j->args[i].p);
    if (j->fn) cc__py.DecRef(j->fn);
    for (i = 0; i < j->nbuf; i++)
        if (j->buf_refs[i]) cc__js.DeleteReference(env, j->buf_refs[i]);
    pthread_mutex_lock(&d->mu);
    j->next = d->job_free;
    d->job_free = j;
    pthread_mutex_unlock(&d->mu);
}

/* The async call: submit, return the Promise.  Same doors and the same
 * messages as the sync invoke; the settle happens on the main thread
 * when the lane posts completion. */
static CCJsVal !>(CCError) CcPython_invoke_async(CcPython *self, CCJs *js,
                                                 CCJsExt dom, CCJsExt fn,
                                                 CCJsVal args) {
    CcPyDom *d = ccpy__dom(dom);
    CcPyObjBox *fb;
    CcPyJob *j;
    uint32_t argc = 0, i;
    _Bool isarr = 0;
    (void)self;
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "cc-python: bridge is closed");
    if (!d->async_mode) {
        /* The lane is latent: first task call starts it.  Main may hold
         * this interpreter's GIL from sync work — the lane needs it. */
        if (ccpy__lane_start(d, js->env) != 0)
            return cc_err(CC_ERR_IO, "cc-python: async needs Node-API "
                                     "promises + threadsafe functions");
        cc_py_thread_leave();
    }
    fb = ccpy__objbox(d, fn);
    if (!fb)
        return cc_err(CC_ERR_INVALID_ARG,
                      "cc-python: handle is released or belongs to another "
                      "bridge");
    if (cc__js.IsArray(js->env, args.v, &isarr) != 0 || !isarr)
        return cc_err(CC_ERR_INVALID_ARG,
                      "cc-python: invoke wants an argument ARRAY");
    if (cc__js.GetArrayLength(js->env, args.v, &argc) != 0 ||
        argc > CCPY__JOB_MAX_ARGS)
        return cc_err(CC_ERR_INVALID_ARG, "cc-python: too many arguments");
    pthread_mutex_lock(&d->mu);
    j = d->job_free;
    if (j) d->job_free = j->next;
    pthread_mutex_unlock(&d->mu);
    if (!j) {
        pthread_mutex_lock(&d->mu); /* the loop thread allocates here too */
        j = (CcPyJob *)cc_arena_alloc(&d->arena, sizeof(*j), 16);
        pthread_mutex_unlock(&d->mu);
    }
    if (!j) return cc_err(CC_ERR_IO, "cc-python: out of memory");
    memset(j, 0, sizeof(*j));
    j->dom = d;
    /* Refcounts (handle args, the callable) need the GIL; the executor
     * yields it between jobs. */
    cc__py_attach(&d->py);
    for (i = 0; i < argc; i++) {
        void *el = NULL;
        if (cc__js.GetElement(js->env, args.v, i, &el) != 0 ||
            ccpy__arg_pack_async(d, js->env, el, j, &j->args[i], ccpy__errbuf,
                                 sizeof(ccpy__errbuf)) != 0) {
            ccpy__job_abort(d, js->env, j, (int)i);
            cc_py_thread_leave();
            return cc_err(CC_ERR_INVALID_ARG, ccpy__errbuf);
        }
    }
    j->argc = (int)argc;
    if (argc == 1 && ccpy__is_builtin_eval_or_exec(fb->obj.o)) {
        void *ns = ccpy__domain_ns(d);
        CCPyObj nso;
        if (!ns) {
            ccpy__job_abort(d, js->env, j, (int)argc);
            cc_py_thread_leave();
            return cc_err(CC_ERR_IO,
                          "cc-python: cannot resolve __main__ for bare "
                          "eval/exec");
        }
        cc__py.IncRef(ns); /* job owns a ref (kind-4 sweep DecRefs) */
        nso.o = ns;
        nso.home = &d->py;
        j->args[1] = cc__py_arg_obj(nso);
        j->argc = 2;
    }
    cc__py.IncRef(fb->obj.o);
    j->fn = fb->obj.o;
    cc_py_thread_leave();
    {
        void *promise = NULL;
        if (cc__js.CreatePromise(js->env, &j->deferred, &promise) != 0) {
            cc__py_attach(&d->py);
            ccpy__job_abort(d, js->env, j, j->argc);
            cc_py_thread_leave();
            return cc_err(CC_ERR_IO, "cc-python: promise allocation failed");
        }
        pthread_mutex_lock(&d->mu);
        if (d->qtail) d->qtail->next = j;
        else d->qhead = j;
        d->qtail = j;
        d->ext_outstanding++; /* the job holds the arena to completion */
        if (!d->tsfn_reffed) {
            cc__js.RefTsfn(js->env, d->tsfn);
            d->tsfn_reffed = 1;
        }
        pthread_cond_signal(&d->cv);
        /* A suspended lane callback services the queue from its own wait
         * — wake the innermost waiter too, or a job submitted DURING the
         * suspension (the deadlock-dissolving case) sits unnoticed. */
        if (d->cb_waiter) pthread_cond_signal(&d->cb_waiter->cv);
        {
            int loop_mode = d->loop_mode;
            pthread_mutex_unlock(&d->mu);
            if (loop_mode) {
                /* the executor lives inside run_forever now — wake it
                 * through the loop, not the condvar */
                cc__py_attach(&d->py);
                {
                    CCPyObj lo;
                    CCPyObj pv;
                    CCPyArg a;
                    lo.o = d->loop;
                    lo.home = &d->py;
                    pv.o = d->pump;
                    pv.home = &d->py;
                    a = cc__py_arg_obj(pv);
                    {
                        CCResult_CCPyObj_CCPyError r = cc__py_obj_callm_n(
                            &lo, "call_soon_threadsafe", 1, &a);
                        if (r.ok) cc_py_obj_release(&r.u.value);
                        else if (cc__py.ErrClear) cc__py.ErrClear();
                    }
                }
                cc_py_thread_leave();
            }
        }
        {
            CCJsVal jv = { 0 };
            jv.env = js->env;
            jv.v = promise;
            return cc_ok(jv);
        }
    }
}

static CCJsVal !>(CCError) CcPython_invoke_async_kw(CcPython *self, CCJs *js,
                                                    CCJsExt dom, CCJsExt fn,
                                                    CCJsVal args, CCJsVal kw) {
    CcPyDom *d = ccpy__dom(dom);
    CcPyObjBox *fb;
    CcPyJob *j;
    uint32_t argc = 0, i;
    _Bool isarr = 0;
    (void)self;
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "cc-python: bridge is closed");
    if (!d->async_mode) {
        /* The lane is latent: first task call starts it.  Main may hold
         * this interpreter's GIL from sync work — the lane needs it. */
        if (ccpy__lane_start(d, js->env) != 0)
            return cc_err(CC_ERR_IO, "cc-python: async needs Node-API "
                                     "promises + threadsafe functions");
        cc_py_thread_leave();
    }
    fb = ccpy__objbox(d, fn);
    if (!fb)
        return cc_err(CC_ERR_INVALID_ARG,
                      "cc-python: handle is released or belongs to another "
                      "bridge");
    if (cc__js.IsArray(js->env, args.v, &isarr) != 0 || !isarr)
        return cc_err(CC_ERR_INVALID_ARG,
                      "cc-python: invoke wants an argument ARRAY");
    if (cc__js.GetArrayLength(js->env, args.v, &argc) != 0 ||
        argc > CCPY__JOB_MAX_ARGS)
        return cc_err(CC_ERR_INVALID_ARG, "cc-python: too many arguments");
    pthread_mutex_lock(&d->mu);
    j = d->job_free;
    if (j) d->job_free = j->next;
    pthread_mutex_unlock(&d->mu);
    if (!j) {
        pthread_mutex_lock(&d->mu); /* the loop thread allocates here too */
        j = (CcPyJob *)cc_arena_alloc(&d->arena, sizeof(*j), 16);
        pthread_mutex_unlock(&d->mu);
    }
    if (!j) return cc_err(CC_ERR_IO, "cc-python: out of memory");
    memset(j, 0, sizeof(*j));
    j->dom = d;
    /* Refcounts (handle args, the callable) need the GIL; the executor
     * yields it between jobs. */
    cc__py_attach(&d->py);
    for (i = 0; i < argc; i++) {
        void *el = NULL;
        if (cc__js.GetElement(js->env, args.v, i, &el) != 0 ||
            ccpy__arg_pack_async(d, js->env, el, j, &j->args[i], ccpy__errbuf,
                                 sizeof(ccpy__errbuf)) != 0) {
            ccpy__job_abort(d, js->env, j, (int)i);
            cc_py_thread_leave();
            return cc_err(CC_ERR_INVALID_ARG, ccpy__errbuf);
        }
    }
    if (ccpy__pack_kwargs(d, js->env, kw.v, j->args, NULL, &argc,
                          CCPY__JOB_MAX_ARGS, j, ccpy__errbuf,
                          sizeof(ccpy__errbuf)) != 0) {
        ccpy__job_abort(d, js->env, j, (int)argc);
        cc_py_thread_leave();
        return cc_err(CC_ERR_INVALID_ARG, ccpy__errbuf);
    }
    j->argc = (int)argc;
    if (argc == 1 && ccpy__is_builtin_eval_or_exec(fb->obj.o)) {
        void *ns = ccpy__domain_ns(d);
        CCPyObj nso;
        if (!ns) {
            ccpy__job_abort(d, js->env, j, (int)argc);
            cc_py_thread_leave();
            return cc_err(CC_ERR_IO,
                          "cc-python: cannot resolve __main__ for bare "
                          "eval/exec");
        }
        cc__py.IncRef(ns); /* job owns a ref (kind-4 sweep DecRefs) */
        nso.o = ns;
        nso.home = &d->py;
        j->args[1] = cc__py_arg_obj(nso);
        j->argc = 2;
    }
    cc__py.IncRef(fb->obj.o);
    j->fn = fb->obj.o;
    cc_py_thread_leave();
    {
        void *promise = NULL;
        if (cc__js.CreatePromise(js->env, &j->deferred, &promise) != 0) {
            cc__py_attach(&d->py);
            ccpy__job_abort(d, js->env, j, j->argc);
            cc_py_thread_leave();
            return cc_err(CC_ERR_IO, "cc-python: promise allocation failed");
        }
        pthread_mutex_lock(&d->mu);
        if (d->qtail) d->qtail->next = j;
        else d->qhead = j;
        d->qtail = j;
        d->ext_outstanding++; /* the job holds the arena to completion */
        if (!d->tsfn_reffed) {
            cc__js.RefTsfn(js->env, d->tsfn);
            d->tsfn_reffed = 1;
        }
        pthread_cond_signal(&d->cv);
        /* A suspended lane callback services the queue from its own wait
         * — wake the innermost waiter too, or a job submitted DURING the
         * suspension (the deadlock-dissolving case) sits unnoticed. */
        if (d->cb_waiter) pthread_cond_signal(&d->cb_waiter->cv);
        {
            int loop_mode = d->loop_mode;
            pthread_mutex_unlock(&d->mu);
            if (loop_mode) {
                /* the executor lives inside run_forever now — wake it
                 * through the loop, not the condvar */
                cc__py_attach(&d->py);
                {
                    CCPyObj lo;
                    CCPyObj pv;
                    CCPyArg a;
                    lo.o = d->loop;
                    lo.home = &d->py;
                    pv.o = d->pump;
                    pv.home = &d->py;
                    a = cc__py_arg_obj(pv);
                    {
                        CCResult_CCPyObj_CCPyError r = cc__py_obj_callm_n(
                            &lo, "call_soon_threadsafe", 1, &a);
                        if (r.ok) cc_py_obj_release(&r.u.value);
                        else if (cc__py.ErrClear) cc__py.ErrClear();
                    }
                }
                cc_py_thread_leave();
            }
        }
        {
            CCJsVal jv = { 0 };
            jv.env = js->env;
            jv.v = promise;
            return cc_ok(jv);
        }
    }
}

/* Revoke-then-drain with a Promise: rejects everything queued, lets the
 * in-flight call finish, sweeps after the last delivery, resolves. */
static CCJsVal !>(CCError) CcPython_close_async(CcPython *self, CCJs *js,
                                                CCJsExt dom) {
    CcPyDom *d = (CcPyDom *)dom.ptr;
    void *deferred = NULL;
    void *promise = NULL;
    (void)self;
    if (!d)
        return cc_err(CC_ERR_INVALID_ARG, "cc-python: not a bridge handle");
    if (!cc__js.CreatePromise)
        return cc_err(CC_ERR_IO, "cc-python: async needs Node-API promises");
    if (cc__js.CreatePromise(js->env, &deferred, &promise) != 0)
        return cc_err(CC_ERR_IO, "cc-python: promise allocation failed");
    if (d->async_mode) {
        ccpy__lane_close(d, js->env, deferred);
    } else {
        /* No lane ever started: the sweep is synchronous, the promise
         * only keeps destroy()'s shape uniform. */
        void *u = NULL;
        if (!d->closed) ccpy__dom_sweep(d);
        cc__js.GetUndefined(js->env, &u);
        cc__js.ResolveDeferred(js->env, deferred, u);
    }
    {
        CCJsVal jv = { 0 };
        jv.env = js->env;
        jv.v = promise;
        return cc_ok(jv);
    }
}

/* Choose the process Python from code, before the first domain loads a
 * runtime: a venv directory, an interpreter executable, or a libpython
 * path.  After a runtime is loaded a matching choice is a no-op and a
 * different one answers articulately — one runtime per process until
 * process-isolated domains. */
static long long !>(CCError) CcPython_use_python(CcPython *self,
                                                 const char *spec) {
    (void)self;
    if (cc_py_use(spec) != 0)
        return cc_err(CC_ERR_INVALID_ARG,
                      cc__py_errbuf[0] ? cc__py_errbuf
                                       : "cc-python: cannot use that Python");
    return cc_ok((long long)1);
}

/* "version|libpath|how" — the introspection door for the runtime choice
 * (fields empty until known). */
static CCJsVal !>(CCError) CcPython_runtime_desc(CcPython *self, CCJs *js) {
    char buf[4400];
    void *out = NULL;
    (void)self;
    cc_py_runtime_desc(buf, sizeof(buf));
    if (cc__js.CreateStringUtf8(js->env, buf, strlen(buf), &out) != 0)
        return cc_err(CC_ERR_IO, "cc-python: cannot build the description");
    {
        CCJsVal jv = { 0 };
        jv.env = js->env;
        jv.v = out;
        return cc_ok(jv);
    }
}

static const CcPython seed = { .ok = 1 };

@comptime cc_js_export("cc_python", "CcPython", &seed);

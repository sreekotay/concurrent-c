            if (exc) {
                CCPyObj ev;
                CCPyArg a;
                ev.o = exc;
                ev.home = &d->py;
                a = cc__py_arg_obj(ev);
                {
                    CCResult_CCPyObj_CCPyError r =
                        cc__py_obj_callm_n(&f, "set_exception", 1, &a);
                    if (r.ok) cc_py_obj_release(&r.u.value);
                    else if (cc__py.ErrClear) cc__py.ErrClear();
                }
                cc__py.DecRef(exc);
            }
        } else if (!already) {
            void *val = ccpy__cb_tag_to_py(d, req->rkind, req->rf, req->ri,
                                           req->rstr, req->rlen, req->robj);
            if (val) {
                CCPyObj vv;
                CCPyArg a;
                vv.o = val;
                vv.home = &d->py;
                a = cc__py_arg_obj(vv);
                {
                    CCResult_CCPyObj_CCPyError r =
                        cc__py_obj_callm_n(&f, "set_result", 1, &a);
                    if (r.ok) cc_py_obj_release(&r.u.value);
                    else if (cc__py.ErrClear) cc__py.ErrClear();
                }
                cc__py.DecRef(val);
            } else if (cc__py.ErrClear) {
                cc__py.ErrClear();

    if (handed) return; /* the settle frees the request */
    pthread_mutex_lock(&d->mu);
    req->up = d->cbreq_free;
    d->cbreq_free = req;
    d->cb_live--;
    pthread_mutex_unlock(&d->mu);
    ccpy__dom_unref(d);
}

/* Callback invoked from inside a task: mint a future, post the request,
 * return the future for Python to await.  Loop thread, GIL held. */
static void *ccpy__cb_call_aio(CcPyDom *d, CcJsCbBox *box, void *args, int n) {
    CcJsCbReq *req;
    void *fut = NULL;
    int i;
    pthread_mutex_lock(&d->mu);
    req = d->cbreq_free;
    if (req) d->cbreq_free = req->up;
    else req = (CcJsCbReq *)cc_arena_alloc(&d->arena, sizeof(*req), 16);
    pthread_mutex_unlock(&d->mu);
    if (!req) return cc__py_raise("cc-python: out of memory");
    memset(req, 0, sizeof(*req));
    req->what = 1;
    req->aio = 1;
    req->box = box;
    req->argc = n;
    {
        CCPyObj lo;
        lo.o = d->loop;
        lo.home = &d->py;
        {
            CCResult_CCPyObj_CCPyError r =
                cc__py_obj_callm_n(&lo, "create_future", 0, NULL);
            if (!r.ok) {
                pthread_mutex_lock(&d->mu);
                req->up = d->cbreq_free;
                d->cbreq_free = req;
                pthread_mutex_unlock(&d->mu);
                return cc__py_raise("cc-python: cannot create the future");
            }
            fut = r.u.value.o;
        }
    }
    req->fut = fut; /* the request's own reference */
    cc__py.IncRef(fut); /* the caller's awaitable */
    for (i = 0; i < n; i++) {
        void *o = cc__py.TupleGetItem(args, (intptr_t)i); /* borrowed */
        cc__py.IncRef(o);
        req->argv[i] = o; /* main consumes these */
    }
    pthread_mutex_lock(&d->mu);
    d->cb_live++;
    pthread_mutex_unlock(&d->mu);
    ccpy__dom_hold(d); /* the request pins the arena until its settle */
    cc__js.CallTsfn(d->tsfn, req, 1);
    return fut;
}

/* Is this frame inside an asyncio task?  current_task() discriminates:
 * pump callbacks answer None (sync semantics), task frames answer the
 * task (awaitable semantics). */
static int ccpy__aio_in_task(CcPyDom *d) {
    CCPyObj m;
    int in = 0;
    if (!d->loop_mode) return 0;
    m.o = d->aio;
    m.home = &d->py;

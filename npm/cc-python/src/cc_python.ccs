        CCResult_CCPyObj_CCPyError r =
            cc__py_obj_callm_n(&m, "current_task", 0, NULL);
        if (!r.ok) {
            if (cc__py.ErrClear) cc__py.ErrClear();
            return 0;
        }
        in = r.u.value.o && r.u.value.o != d->none;
        cc_py_obj_release(&r.u.value);
    }
    return in;
}

/* Loop mode's thread body: pump once (jobs may have queued between
 * engagement and here), run until revocation stops the loop, then
 * cancel-drain every task so its done-callback posts, reject the
 * stragglers, and close.  Attaches the GIL; leaves it to the caller. */
static void ccpy__exec_loop(CcPyDom *d) {
    CCPyObj lo;
    cc__py_attach(&d->py);
    lo.o = d->loop;
    lo.home = &d->py;
    {
        CCPyObj pv;
        CCPyArg a;
        pv.o = d->pump;
        pv.home = &d->py;
        a = cc__py_arg_obj(pv);
        {
            CCResult_CCPyObj_CCPyError r =
                cc__py_obj_callm_n(&lo, "call_soon", 1, &a);
            if (r.ok) cc_py_obj_release(&r.u.value);
            else if (cc__py.ErrClear) cc__py.ErrClear();
        }
    }
    {
        CCResult_CCPyObj_CCPyError r =
            cc__py_obj_callm_n(&lo, "run_forever", 0, NULL);
        if (r.ok) cc_py_obj_release(&r.u.value);
        else if (cc__py.ErrClear) cc__py.ErrClear();
    }
    for (;;) {
        void *task = NULL;
        pthread_mutex_lock(&d->mu);
        if (d->sched_head) {
            task = d->sched_head->task;
            cc__py.IncRef(task);
        }
        pthread_mutex_unlock(&d->mu);
        if (!task) break;
        {
            CCPyObj t;
            t.o = task;
            t.home = &d->py;
            {
                CCResult_CCPyObj_CCPyError rc =
                    cc__py_obj_callm_n(&t, "cancel", 0, NULL);
                if (rc.ok) cc_py_obj_release(&rc.u.value);
                else if (cc__py.ErrClear) cc__py.ErrClear();
            }
            {
                CCPyArg a = cc__py_arg_obj(t);
                CCResult_CCPyObj_CCPyError rr =
                    cc__py_obj_callm_n(&lo, "run_until_complete", 1, &a);
                if (rr.ok) cc_py_obj_release(&rr.u.value);
                else if (cc__py.ErrClear) cc__py.ErrClear(); /* CancelledError */
            }

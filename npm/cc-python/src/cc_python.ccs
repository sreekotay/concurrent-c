        if (!already && req->failed) {
            /* rejection -> RuntimeError carrying the reason's text */
            void *exc = NULL;
            if (d->rterr) {
                CCPyObj rt;
                CCSlice sl = { req->errmsg, strlen(req->errmsg) };
                CCPyArg a;
                rt.o = d->rterr;
                rt.home = &d->py;
                a = cc__py_arg_slice(sl);

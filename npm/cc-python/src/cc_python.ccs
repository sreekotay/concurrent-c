/* concurrent-c-python: the generic Python bridge for Node.
 *
 *     const py = require('concurrent-c-python').create();  // Isolation Domain
 *     const np = py.import('numpy');
 *     const s  = np.array([1, 2, 3]).sum();
 *     py.destroy();                                // one sweep: everything
 *
 * The addon exposes primitive operations (create / import / getattr /
 * invoke / release / destroy) over opaque handles; index.js wraps them
 * in a Proxy so attribute chains and calls read as ordinary JavaScript.
 *
 * Ownership is the Isolation Domain model: a domain owns its
 * interpreter handle, its arena, and every Python reference minted
 * through it — and everything, the domain struct and the handle boxes
 * included, lives IN the arena; nothing is malloc'd.  Proxies are
 * borrows — each holds a strong JS reference to its domain (index.js),
 * so the GC can only collect the domain when the whole graph is
 * unreachable.  The domain has two distinct lifetimes: destroy() is
 * REVOCATION — Python references released, interpreter closed, every
 * outstanding handle answers "bridge is closed", double destroy a
 * quiet no-op — while the arena's REAL life ends when the last
 * outstanding External (the domain's own or any handle's) is
 * collected: finalizers are bookkeeping decrements, and whichever runs
 * last takes the arena and everything in it down in one free.  Buffers
 * cross as leases: a typed array argument is a zero-copy memoryview
 * pinned for the call, and the py_buf retention check catches a callee
 * that keeps it. */
#include <math.h>
#include <pthread.h>

#include <ccc/script/js.cch>
#include <ccc/script/py.cch>

typedef struct CcPyDom CcPyDom;
typedef struct CcPyObjBox CcPyObjBox;
typedef struct CcPyJob CcPyJob;
typedef struct CcJsCbBox CcJsCbBox;
typedef struct CcJsCbReq CcJsCbReq;

/* One Python reference owned by a domain.  Boxes live IN the domain's
 * arena — nothing about a domain is malloc'd — and recycle through a
 * free list once their External is collected, so a long-lived domain's
 * arena is bounded by its peak simultaneous handles, not its history. */
struct CcPyObjBox {
    CcPyDom *dom;
    CCPyObj obj;
    CcPyObjBox *next; /* live list; free list after collection */
    CcPyObjBox *prev;
    int released;
};

/* The domain, allocated from its own arena.  Two lifetimes, deliberately
 * distinct: `closed` is REVOCATION (close()/GC sweep — Python refs
 * released, interpreter closed, every op answers articulately), while
 * `ext_outstanding` counts the Externals still alive in JS (the domain's
 * own plus one per box) and is the domain's REAL life: whichever
 * finalizer decrements it to zero destroys the arena, and the domain,
 * its boxes, and everything else it holds go with it in one free. */
/* One queued call in an async domain.  The record is arena-owned and
 * recycled; the JOB owns its Python references (callable + object args,
 * IncRef'd at submit) so release()/close() mid-flight cannot dangle it,
 * and its napi_refs pin every typed-array buffer from submit to
 * completion — the lease spans the job, not a stack frame. */
#define CCPY__JOB_MAX_ARGS 16
/* Everything posted through the tsfn starts with `what`: 0 = job (and
 * the drain sentinel), 1 = a callback request from the lane. */
struct CcPyJob {
    int what; /* 0 */
    CcPyJob *next;
    CcPyDom *dom;
    void *fn; /* owned PyObject*, DecRef'd by the executor */
    CCPyArg args[CCPY__JOB_MAX_ARGS];
    int argc;
    void *buf_refs[CCPY__JOB_MAX_ARGS];
    int nbuf;
    /* result, filled by the executor */
    int rkind; /* 0 f64, 1 i64, 2 bool, 3 str, 4 none, 5 obj, 6 error,
                * 7 drain, 8 BigInt decimal digits in rstr */
    double rf;
    long long ri;
    const char *rstr; /* exec-arena copy (length rlen) */
    size_t rlen;
    void *robj; /* owned PyObject*; boxed on the main thread */
    char errmsg[240];
    void *deferred; /* settled on the main thread; NULL for the sentinel */
    int rejected; /* drained before running */
    /* stage-2: a call that returned a coroutine becomes an asyncio task;
     * the job completes at task-done, not at call-return */
    int scheduled;
    void *task; /* owned asyncio.Task while on the scheduled list */
};

/* A JS function registered as a Python callable.  Arena-owned and
 * domain-listed; the napi_ref pins the function until REVOCATION (the
 * documented rule: a registered callback pins the domain — destroy()
 * breaks the cycle), deleted at sweep on the main thread. */
struct CcJsCbBox {
    CcPyDom *dom;
    void *fnref;
    CcJsCbBox *next;
    int dead;
};

/* One lane-side callback invocation, stack-allocated in the trampoline:
 * the executor releases the GIL, posts this through the tsfn, and waits;
 * the main thread runs the JS function and fills the tagged result.  A
 * callback that returns a thenable SUSPENDS the request instead: main
 * attaches native .then handlers (their data pointer is this record —
 * safe because the executor's frame outlives the wait by construction)
 * and the settle fills the result later.  While suspended, the executor
 * services its own queue — see ccpy__cb_call_lane — so a promise whose
 * settlement needs another task on the SAME domain completes instead of
 * deadlocking.  Suspensions nest strictly LIFO (the stack below). */
struct CcJsCbReq {
    int what; /* 1 */
    CcJsCbBox *box;
    void *argv[CCPY__JOB_MAX_ARGS]; /* owned PyObject refs; main consumes */
    int argc;
    int done;
    int failed;
    char errmsg[240];
    int rkind; /* 0 f64, 1 i64, 2 bool, 3 str, 4 none, 5 obj */
    double rf;
    long long ri;
    const char *rstr; /* job-arena copy (domain is not idle mid-callback) */
    size_t rlen;
    void *robj; /* owned PyObject, IncRef'd on main under the GIL */
    pthread_cond_t cv; /* signaled under d->mu */
    CcJsCbReq *up; /* next-outer suspended request (waiter stack) */
    /* stage-2: a callback invoked from inside an asyncio task returns an
     * awaitable instead of blocking.  The record then lives in the
     * domain arena (the trampoline returns immediately), `fut` is the
     * loop-thread future the settle fills, and the condvar fields are
     * unused.  `up` doubles as the freelist link. */
    int aio;
    void *fut; /* owned asyncio.Future */
};

struct CcPyDom {
    CCArena arena;
    CCPy py;
    void *none; /* owned builtins.None, for result probing */
    void *ns;   /* owned __main__.__dict__ — bare eval/exec globals */
    CcPyObjBox *head;
    CcPyObjBox *free_boxes;
    long long live;
    long long ext_outstanding;
    int closed;
    /* ---- async lane (mode 'async' only) ----
     * One executor thread per domain, FIFO: Python is serial under its
     * per-interpreter GIL anyway, so a lane loses nothing within a
     * domain and concurrent DOMAINS parallelize.  Teardown is
     * revoke-then-drain: close marks the lane stopping, queued jobs
     * settle as rejections, the executor detaches its thread state and
     * posts a drain sentinel; the sentinel's completion — after every
     * result has been delivered on the main thread — joins the thread,
     * runs the sweep, and resolves the close promise.  The lane and
     * every in-flight job hold ext_outstanding, so the arena's real
     * life covers work the GC can no longer see. */
    int async_mode;
    pthread_t exec;
    pthread_mutex_t mu;
    pthread_cond_t cv;
    CcPyJob *qhead;
    CcPyJob *qtail;
    CcPyJob *job_free; /* recycled records (domain arena) */
    CCArena job_arena; /* submit-side payloads (main thread writes) */
    CCArena exec_arena; /* result strings (executor writes) */
    int inflight;
    long long pending_done; /* posted to tsfn, not yet delivered */
    int stopping;
    int exec_done;
    void *tsfn;
    void *close_deferred; /* settled by the sentinel's completion */
    int tsfn_reffed;
    CcPyJob sentinel; /* posted once by the exiting executor */
    /* JS-callback bridging */
    CcJsCbBox *cb_head;
    CcJsCbReq *cb_waiter; /* innermost suspended lane callback (under mu):
                           * submit and close signal its cv so a suspended
                           * executor notices new work and revocation */
    void *main_env; /* the creating thread's env: case-1 calls, ref cleanup */
    pthread_t main_tid;
    /* ---- stage-2: the asyncio lane ----
     * Engaged lazily by the first coroutine result: the executor thread
     * hands itself to loop.run_forever(), submissions pump via
     * call_soon_threadsafe, coroutine jobs interleave as tasks, and a
     * callback invoked from inside a task returns an awaitable future.
     * The sync FIFO path (and its latency) is untouched until then. */
    int loop_mode;
    int loop_closed;
    void *aio; /* owned asyncio module */
    void *loop; /* owned event loop */
    void *pump; /* owned C pump callable (capsule carries the domain) */
    void *rterr; /* owned builtins.RuntimeError, for future rejections */
    CcJsCbReq *cbreq_free; /* recycled arena-resident aio requests */
    CcPyJob *sched_head; /* jobs living as asyncio tasks (via j->next) */
    long long sched_live; /* |sched_head| — gates idle unref/resets */
    long long cb_live; /* outstanding aio callback futures — same gate */
};

/* The last outstanding External — object or domain, whichever collects
 * last — takes the arena (and the domain inside it) down.  The count is
 * mutex-guarded because stage-2 settles release holds from the loop
 * thread; zero is still only reachable on the main thread (the lane's
 * own hold outlives the loop thread and releases at the sentinel), so
 * the destroy below never races the executor. */
static void ccpy__release_inproc_owner(void);

static void ccpy__dom_unref(CcPyDom *d) {
    long long left;
    pthread_mutex_lock(&d->mu);
    left = --d->ext_outstanding;
    pthread_mutex_unlock(&d->mu);
    if (left > 0) return;
    {
        CCArena tmp = d->arena;
        cc_arena_destroy(&tmp); /* d is inside it — gone now */
    }
    ccpy__release_inproc_owner();
}

static void ccpy__dom_hold(CcPyDom *d) {
    pthread_mutex_lock(&d->mu);
    d->ext_outstanding++;
    pthread_mutex_unlock(&d->mu);
}

/* Revocation, shared by close() and the GC finalizer: release every
 * live Python reference and close the interpreter handle.  The arena
 * stays — boxes must outlive their Externals' finalizers — so after
 * this the domain answers only `closed` until its real life ends. */
static void ccpy__dom_sweep(CcPyDom *d) {
    CcPyObjBox *b = d->head;
    /* Refcounts need the interpreter's GIL; on an async domain the
     * executor is already joined by the time the sweep runs, so this
     * acquires without contention. */
    cc__py_attach(&d->py);
    while (b) {
        if (!b->released) {
            cc_py_obj_release(&b->obj);
            b->released = 1;
        }
        b = b->next;
    }
    d->head = NULL;
    d->live = 0;
    /* Callback registrations: deleting the napi_refs needs the main
     * thread's env, and every sweep path runs there. */
    {
        CcJsCbBox *cb = d->cb_head;
        while (cb) {
            if (cb->fnref && d->main_env)
                cc__js.DeleteReference(d->main_env, cb->fnref);
            cb->fnref = NULL;
            cb->dead = 1;
            cb = cb->next;
        }
        d->cb_head = NULL;
    }
    if (d->aio) {
        cc__py.DecRef(d->aio);
        d->aio = NULL;
    }
    if (d->loop) {
        cc__py.DecRef(d->loop);
        d->loop = NULL;
    }
    if (d->pump) {
        cc__py.DecRef(d->pump);
        d->pump = NULL;
    }
    if (d->rterr) {
        cc__py.DecRef(d->rterr);
        d->rterr = NULL;
    }
    if (d->none) {
        cc__py.DecRef(d->none);
        d->none = NULL;
    }
    if (d->ns) {
        cc__py.DecRef(d->ns);
        d->ns = NULL;
    }
    cc_py_close(&d->py);
    /* Closing an isolated interpreter leaves the PROCESS interpreter's
     * state current (cc_py_close does that so later releases have a
     * thread state) — which means this thread now HOLDS the process
     * GIL, and another domain's lane would block on it forever.  The
     * bridge's discipline everywhere: never keep a GIL between ops. */
    cc_py_thread_leave();
    d->closed = 1;
}

static void ccpy__obj_finalize(void *env, void *data, void *hint) {
    CcPyObjBox *b = (CcPyObjBox *)data;
    CcPyDom *d;
    (void)env;
    (void)hint;
    if (!b || !b->dom) return;
    d = b->dom;
    if (!d->closed) {
        if (!b->released) {
            if (d->async_mode) cc__py_attach(&d->py);
            cc_py_obj_release(&b->obj);
            b->released = 1;
            if (b->prev) b->prev->next = b->next;
            else d->head = b->next;
            if (b->next) b->next->prev = b->prev;
            d->live--;
        }
        b->next = d->free_boxes;
        d->free_boxes = b;
        if (d->async_mode) cc_py_thread_leave();
    }
    ccpy__dom_unref(d);
}

static void ccpy__lane_close(CcPyDom *d, void *env, void *deferred);

static void ccpy__dom_finalize(void *env, void *data, void *hint) {
    CcPyDom *d = (CcPyDom *)data;
    (void)hint;
    if (!d) return;
    if (d->async_mode && !d->closed) {
        /* Undelivered work may still hold Python references; drain — the
         * sentinel's completion sweeps.  The lane's own hold keeps the
         * arena alive past this unref. */
        ccpy__lane_close(d, env, NULL);
    } else if (!d->closed) {
        ccpy__dom_sweep(d);
    }
    ccpy__dom_unref(d);
}

/* Register a fresh owned reference with the domain.  The box comes from
 * the free list or the arena; the caller mints the External (and the
 * ext_outstanding count) via ccpy__ext_make, or rolls back via
 * ccpy__box_undo if it cannot. */
static CcPyObjBox *ccpy__box(CcPyDom *d, CCPyObj o) {
    CcPyObjBox *b = d->free_boxes;
    if (b) d->free_boxes = b->next;
    else {
        /* the loop thread also allocates from this arena (aio requests) */
        pthread_mutex_lock(&d->mu);
        b = (CcPyObjBox *)cc_arena_alloc(&d->arena, sizeof(*b), 16);
        pthread_mutex_unlock(&d->mu);
    }
    if (!b) {
        cc_py_obj_release(&o);
        return NULL;
    }
    memset(b, 0, sizeof(*b));
    b->dom = d;
    b->obj = o;
    b->next = d->head;
    if (d->head) d->head->prev = b;
    d->head = b;
    d->live++;
    return b;
}

static void ccpy__box_undo(CcPyDom *d, CcPyObjBox *b) {
    cc_py_obj_release(&b->obj);
    if (b->prev) b->prev->next = b->next;
    else d->head = b->next;
    if (b->next) b->next->prev = b->prev;
    d->live--;
    b->next = d->free_boxes;
    d->free_boxes = b;
}

/* Mint the External that carries a box; counting happens ONLY here and
 * in the finalizers, so a creation failure cannot strand the count. */
static int ccpy__ext_make(CcPyDom *d, void *env, CcPyObjBox *b, void **out) {
    if (cc__js.CreateExternal(env, b, ccpy__obj_finalize, NULL, out) != 0)
        return -1;
    ccpy__dom_hold(d);
    return 0;
}

static int ccpy__result_to_js(CcPyDom *d, void *env, CCPyObj r, void **out);
static int ccpy__arg_from_js(CcPyDom *d, void *env, void *v, CCPyArg *out,
                             void **owned_out, char *errbuf, size_t errcap);
static int ccpy__arg_pack_async(CcPyDom *d, void *env, void *v, CcPyJob *j,
                                CCPyArg *out, char *errbuf, size_t errcap);
static int ccpy__pack_kwargs(CcPyDom *d, void *env, void *kw,
                             CCPyArg *argv, void **owned, uint32_t *argc,
                             uint32_t argcap, CcPyJob *j, char *errbuf,
                             size_t errcap);
static void ccpy__exec_run(CcPyDom *d, CcPyJob *j);
static int ccpy__aio_in_task(CcPyDom *d);
static void *ccpy__cb_call_aio(CcPyDom *d, CcJsCbBox *box, void *args, int n);
static void ccpy__aio_req_finish(CcPyDom *d, CcJsCbReq *req);

/* ---- JS callbacks crossing into Python ------------------------------ */

/* PyMethodDef mirror (stable layout since forever). */
typedef struct CcPyMethodDefMirror {
    const char *ml_name;
    void *(*ml_meth)(void *self, void *args);
    int ml_flags;
    const char *ml_doc;
} CcPyMethodDefMirror;
#define CC__PY_METH_VARARGS 0x0001

static void *ccpy__cb_trampoline(void *self, void *args);

static CcPyMethodDefMirror ccpy__cb_def = {
    "cc_js_callback",
    ccpy__cb_trampoline,
    CC__PY_METH_VARARGS,
    "JavaScript function held by a cc-python bridge",
};

/* Pending-exception text, coerced to a string; clears the exception. */
static void ccpy__js_exc_text(void *env, char *buf, size_t cap) {
    void *exc = NULL;
    void *str = NULL;
    size_t got = 0;
    snprintf(buf, cap, "callback threw");
    if (cc__js.GetAndClearLastException(env, &exc) != 0 || !exc) return;
    if (cc__js.CoerceToString(env, exc, &str) != 0 || !str) return;
    if (cc__js.GetValueStringUtf8(env, str, buf, cap, &got) != 0)
        snprintf(buf, cap, "callback threw");
}

static void *ccpy__bigint_to_py(CcPyDom *d, void *env, void *v, int async,
                                char *errbuf, size_t errcap);
static int ccpy__result_to_js(CcPyDom *d, void *env, CCPyObj r, void **out);
static int ccpy__cb_arg_to_js(CcPyDom *d, void *env, CCPyObj r, void **out);

/* JS return value -> tagged result (shared by both call paths).  Fills
 * req-style fields via out-pointers; GIL-needing pieces (the handle
 * IncRef) attach around themselves.  Returns 0, or -1 with errmsg. */
static int ccpy__cb_ret_tag(CcPyDom *d, void *env, void *ret, int *rkind,
                            double *rf, long long *ri, const char **rstr,
                            size_t *rlen, void **robj, char *errmsg,
                            size_t errcap) {
    int t = 0;
    if (!ret) {
        *rkind = 4;
        return 0;
    }
    cc__js.Typeof(env, ret, &t);
    switch (t) {
    case CC__JS_T_UNDEFINED:
    case CC__JS_T_NULL:
        *rkind = 4;
        return 0;
    case CC__JS_T_NUMBER: {
        double dd = 0;
        cc__js.GetValueDouble(env, ret, &dd);
        /* Keep IEEE -0 as float — int collapse drops the sign. */
        if (dd == 0.0 && signbit(dd)) {
            *rkind = 0;
            *rf = dd;
        } else if (dd == (double)(long long)dd &&
                   dd >= -9007199254740992.0 &&
                   dd <= 9007199254740992.0) {
            *rkind = 1;
            *ri = (long long)dd;
        } else {
            *rkind = 0;
            *rf = dd;
        }
        return 0;
    }
    case CC__JS_T_BOOLEAN: {
        _Bool b = 0;
        cc__js.GetValueBool(env, ret, &b);
        *rkind = 2;
        *ri = b ? 1 : 0;
        return 0;
    }
    case CC__JS_T_STRING: {
        size_t len = 0, got = 0;
        char *copy;
        int lone = cc__js_string_lone_surrogate(env, ret);
        if (lone < 0) break;
        if (lone > 0) {
            snprintf(errmsg, errcap,
                     "cc-python: string contains a lone UTF-16 surrogate");
            return -1;
        }
        if (cc__js.GetValueStringUtf8(env, ret, NULL, 0, &len) != 0) break;
        copy = (char *)cc_arena_alloc(&d->job_arena, len + 1, 16);
        if (!copy) break;
        if (cc__js.GetValueStringUtf8(env, ret, copy, len + 1, &got) != 0)
            break;
        *rkind = 3;
        *rstr = copy;
        *rlen = got;
        return 0;
    }
    case CC__JS_T_BIGINT: {
        void *py = ccpy__bigint_to_py(d, env, ret, 1, errmsg, errcap);
        if (!py) return -1;
        *robj = py;
        *rkind = 5;
        return 0;
    }
    case CC__JS_T_EXTERNAL: {
        void *pp = NULL;
        CcPyObjBox *b;
        cc__js.GetValueExternal(env, ret, &pp);
        b = (CcPyObjBox *)pp;
        if (!b || b->dom != d || b->released) {
            snprintf(errmsg, errcap, "cc-python: the callback returned a "
                                     "released or foreign handle");
            return -1;
        }
        cc__py_attach(&d->py);
        cc__py.IncRef(b->obj.o);
        *robj = b->obj.o;
        if (d->async_mode) cc_py_thread_leave();
        *rkind = 5;
        return 0;
    }
    case CC__JS_T_OBJECT: {
        _Bool has = 0;
        if (cc__js.HasNamedProperty(env, ret, "then", &has) == 0 && has) {
            /* The lane path intercepts thenables before this probe (the
             * request suspends); reaching it means a SYNC bridge call —
             * main cannot block on its own event loop. */
            snprintf(errmsg, errcap,
                     "cc-python: a synchronous bridge call cannot wait on a "
                     "Promise — call through py.task(fn) and the callback "
                     "may return one");
            return -1;
        }
        break;
    }
    default:
        break;
    }
    snprintf(errmsg, errcap, "cc-python: unsupported callback return (use "
                             "scalars, BigInt, strings, or bridge handles)");
    return -1;
}

/* Tagged result -> Python value (executor side, GIL held). */
static void *ccpy__cb_tag_to_py(CcPyDom *d, int rkind, double rf, long long ri,
                                const char *rstr, size_t rlen, void *robj) {
    switch (rkind) {
    case 0: return cc__py.FloatFromDouble(rf);
    case 1: return cc__py.LongFromLongLong(ri);
    case 2: return cc__py.BoolFromLong((long)ri);
    case 3: return cc__py.UnicodeFromStringAndSize(rstr, (intptr_t)rlen);
    case 4:
        if (d->none) {
            cc__py.IncRef(d->none);
            return d->none;
        }
        break;
    case 5: return robj; /* already owned */
    default: break;
    }
    return cc__py_raise("cc-python: corrupt callback result");
}

/* 1-D contiguous numeric buffer → fresh JS TypedArray (copy).  Used by
 * toTypedArray and by callback arg marshalling so a call-scoped py_buf
 * lease is never IncRef'd into a handle (that trips the retention check).
 * Returns 1 with *out set, 0 if not a supported buffer, -1 on alloc fail. */
static int ccpy__buf_to_ta(void *env, void *o, void **out) {
    CC__PyBuffer view;
    int tt = -1, esz = 0;
    size_t nelem;
    char c;
    if (!o || !out || !cc__py.GetBuffer || !cc__py.ReleaseBuffer) return 0;
    memset(&view, 0, sizeof(view));
    if (cc__py.GetBuffer(o, &view, CC__PYBUF_CONTIG_FMT) != 0) {
        if (cc__py.ErrClear) cc__py.ErrClear();
        return 0;
    }
    if (view.ndim != 1 || view.len < 0 || view.itemsize <= 0 ||
        (view.len % view.itemsize) != 0) {
        cc__py.ReleaseBuffer(&view);
        return 0;
    }
    if (!view.format || !view.format[0]) c = 'B';
    else {
        const char *p = view.format;
        if (*p == '@' || *p == '=') p++;
        else if (*p == '<' || *p == '>' || *p == '!') {
            cc__py.ReleaseBuffer(&view);
            return 0;
        }
        if (!p[0] || p[1]) {
            cc__py.ReleaseBuffer(&view);
            return 0;
        }
        c = p[0];
    }
    switch (c) {
    case 'd': tt = CC__JS_TA_FLOAT64; esz = 8; break;
    case 'f': tt = CC__JS_TA_FLOAT32; esz = 4; break;
    case 'i': tt = CC__JS_TA_INT32; esz = 4; break;
    case 'q': tt = CC__JS_TA_BIGINT64; esz = 8; break;
    case 'B': tt = CC__JS_TA_UINT8; esz = 1; break;
    case 'b': tt = CC__JS_TA_INT8; esz = 1; break;
    default:
        cc__py.ReleaseBuffer(&view);
        return 0;
    }
    if (view.itemsize != esz) {
        cc__py.ReleaseBuffer(&view);
        return 0;
    }
    nelem = (size_t)view.len / (size_t)esz;
    {
        void *ab = NULL, *ta = NULL, *data = NULL;
        if (cc__js.CreateArraybuffer(env, (size_t)view.len, &data, &ab) != 0) {
            cc__py.ReleaseBuffer(&view);
            return -1;
        }
        if (view.len > 0 && view.buf) memcpy(data, view.buf, (size_t)view.len);
        cc__py.ReleaseBuffer(&view);
        if (cc__js.CreateTypedarray(env, tt, nelem, ab, 0, &ta) != 0)
            return -1;
        *out = ta;
        return 1;
    }
}

/* Callback args prefer a TypedArray copy of buffer exporters so leases
 * are not retained; otherwise the usual scalar/handle materialization. */
static int ccpy__cb_arg_to_js(CcPyDom *d, void *env, CCPyObj r, void **out) {
    int rc = ccpy__buf_to_ta(env, r.o, out);
    if (rc == 1) {
        cc_py_obj_release(&r);
        return 0;
    }
    if (rc < 0) {
        cc_py_obj_release(&r);
        return -1;
    }
    return ccpy__result_to_js(d, env, r, out);
}

/* Case 1: callback fires on the main thread inside a sync call — plain
 * reentrancy, GIL held throughout except across the JS call itself. */
static void *ccpy__cb_call_main(CcPyDom *d, CcJsCbBox *box, void *args,
                                int n) {
    void *jsargs[CCPY__JOB_MAX_ARGS];
    void *env = d->main_env;
    void *fnv = NULL;
    void *undef = NULL;
    void *ret = NULL;
    int i;
    int rkind = -1;
    double rf = 0;
    long long ri = 0;
    const char *rstr = NULL;
    size_t rlen = 0;
    void *robj = NULL;
    char errmsg[240];
    for (i = 0; i < n; i++) {
        CCPyObj r;
        void *o = cc__py.TupleGetItem(args, (intptr_t)i); /* borrowed */
        cc__py.IncRef(o);
        r.o = o;
        r.home = &d->py;
        if (ccpy__cb_arg_to_js(d, env, r, &jsargs[i]) != 0)
            return cc__py_raise("cc-python: cannot marshal a callback "
                                "argument");
    }
    if (cc__js.GetReferenceValue(env, box->fnref, &fnv) != 0 || !fnv)
        return cc__py_raise("cc-python: the callback function is gone");
    cc__js.GetUndefined(env, &undef);
    if (cc__js.CallFunction(env, undef, fnv, (size_t)n, jsargs, &ret) != 0) {
        ccpy__js_exc_text(env, errmsg, sizeof(errmsg));
        return cc__py_raise(errmsg);
    }
    if (ccpy__cb_ret_tag(d, env, ret, &rkind, &rf, &ri, &rstr, &rlen, &robj,
                         errmsg, sizeof(errmsg)) != 0)
        return cc__py_raise(errmsg);
    return ccpy__cb_tag_to_py(d, rkind, rf, ri, rstr, rlen, robj);
}

/* Case 2: callback fires on the lane.  Release the GIL — that is what
 * lets concurrent sync bridge work proceed and the loop stay free to
 * service us — post through the tsfn, wait, reacquire, convert.
 *
 * The wait doubles as a nested executor: while this frame is suspended
 * (a thenable return keeps `done` unset until the promise settles), the
 * queue keeps moving ON THIS THREAD — same discipline as ccpy__exec_main,
 * beneath the suspended Python frame.  That is what lets a callback's
 * promise depend on a task of its own domain: the job it awaits runs
 * here, its completion settles the promise on main, main signals us.
 * Under `stopping`, queued jobs settle as rejections, exactly as the
 * outer loop would; the suspended frame itself finishes when its promise
 * settles.  The GIL is NOT held anywhere in the wait — nested runs
 * attach and leave around themselves. */
static void *ccpy__cb_call_lane(CcPyDom *d, CcJsCbBox *box, void *args,
                                int n) {
    CcJsCbReq req;
    int i;
    memset(&req, 0, sizeof(req));
    req.what = 1;
    req.box = box;
    req.argc = n;
    for (i = 0; i < n; i++) {
        void *o = cc__py.TupleGetItem(args, (intptr_t)i); /* borrowed */
        cc__py.IncRef(o);
        req.argv[i] = o; /* main consumes these */
    }
    pthread_cond_init(&req.cv, NULL);
    cc_py_thread_leave();
    cc__js.CallTsfn(d->tsfn, &req, 1);
    pthread_mutex_lock(&d->mu);
    req.up = d->cb_waiter;
    d->cb_waiter = &req;
    while (!req.done) {
        if (d->qhead) {
            CcPyJob *nj = d->qhead;
            d->qhead = nj->next;
            if (!d->qhead) d->qtail = NULL;
            nj->next = NULL;
            if (d->stopping) {
                nj->rejected = 1;
                d->pending_done++;
                pthread_mutex_unlock(&d->mu);
                cc__js.CallTsfn(d->tsfn, nj, 1);
            } else {
                pthread_mutex_unlock(&d->mu);
                ccpy__exec_run(d, nj);
                cc_py_thread_leave();
                if (nj->scheduled) {
                    /* the nested call became an asyncio task: it runs
                     * once this suspension unwinds and exec_main hands
                     * the thread to the loop — no completion yet */
                    pthread_mutex_lock(&d->mu);
                    continue;
                }
                pthread_mutex_lock(&d->mu);
                d->pending_done++;
                pthread_mutex_unlock(&d->mu);
                cc__js.CallTsfn(d->tsfn, nj, 1);
            }
            pthread_mutex_lock(&d->mu);
            continue;
        }
        pthread_cond_wait(&req.cv, &d->mu);
    }
    d->cb_waiter = req.up;
    pthread_mutex_unlock(&d->mu);
    pthread_cond_destroy(&req.cv);
    cc__py_attach(&d->py);
    if (req.failed) return cc__py_raise(req.errmsg);
    return ccpy__cb_tag_to_py(d, req.rkind, req.rf, req.ri, req.rstr,
                              req.rlen, req.robj);
}

static void *ccpy__cb_trampoline(void *self, void *args) {
    CcJsCbBox *box =
        cc__py.CapsuleGetPointer
            ? (CcJsCbBox *)cc__py.CapsuleGetPointer(self, "cc-python.cb")
            : NULL;
    CcPyDom *d;
    intptr_t n;
    if (!box) return cc__py_raise("cc-python: corrupt callback capsule");
    d = box->dom;
    if (box->dead || !d || d->closed)
        return cc__py_raise("cc-python: bridge is closed");
    n = args ? cc__py.TupleSize(args) : 0;
    if (n > CCPY__JOB_MAX_ARGS)
        return cc__py_raise("cc-python: too many callback arguments");
    if (pthread_equal(pthread_self(), d->main_tid))
        return ccpy__cb_call_main(d, box, args, (int)n);
    if (d->async_mode && pthread_equal(pthread_self(), d->exec)) {
        /* Inside an asyncio task the callback returns an awaitable —
         * only that task suspends, the loop keeps running.  Sync
         * callables (pump callbacks: current_task is None) keep the
         * blocking stage-1 shape. */
        if (ccpy__aio_in_task(d))
            return ccpy__cb_call_aio(d, box, args, (int)n);
        return ccpy__cb_call_lane(d, box, args, (int)n);
    }
    return cc__py_raise("cc-python: callbacks must run on the bridge's "
                        "threads");
}

/* Settle handlers for a suspended request.  Main thread; the data
 * pointer is the executor-side stack record, alive until `done`.  A
 * well-behaved promise settles once; a hostile thenable that calls both
 * handlers hits the `done` guard (main is the only writer). */
static void ccpy__cb_settle(CcPyDom *d, CcJsCbReq *req) {
    pthread_mutex_lock(&d->mu);
    req->done = 1;
    pthread_cond_signal(&req->cv);
    pthread_mutex_unlock(&d->mu);
}

/* One conclusion door for both request flavors: a stack request wakes
 * the blocked executor; an arena (awaitable) request hands its tags to
 * the loop thread, which settles the future. */
static void ccpy__cb_conclude(CcPyDom *d, CcJsCbReq *req) {
    req->done = 1; /* main is the only writer; guards double-settle */
    if (req->aio) ccpy__aio_req_finish(d, req);
    else ccpy__cb_settle(d, req);
}

static void *ccpy__cb_then_ok(void *env, void *info) {
    void *argv[1];
    size_t argc = 1;
    void *data = NULL;
    CcJsCbReq *req;
    CcPyDom *d;
    argv[0] = NULL;
    if (cc__js.GetCbInfo(env, info, &argc, argv, NULL, &data) != 0 || !data)
        return NULL;
    req = (CcJsCbReq *)data;
    if (req->done) return NULL;
    d = req->box->dom;
    if (ccpy__cb_ret_tag(d, env, argc ? argv[0] : NULL, &req->rkind, &req->rf,
                         &req->ri, &req->rstr, &req->rlen, &req->robj,
                         req->errmsg, sizeof(req->errmsg)) != 0)
        req->failed = 1;
    ccpy__cb_conclude(d, req);
    return NULL;
}

static void *ccpy__cb_then_err(void *env, void *info) {
    void *argv[1];
    size_t argc = 1;
    void *data = NULL;
    CcJsCbReq *req;
    void *str = NULL;
    size_t got = 0;
    argv[0] = NULL;
    if (cc__js.GetCbInfo(env, info, &argc, argv, NULL, &data) != 0 || !data)
        return NULL;
    req = (CcJsCbReq *)data;
    if (req->done) return NULL;
    snprintf(req->errmsg, sizeof(req->errmsg), "callback promise rejected");
    if (argc && argv[0] &&
        cc__js.CoerceToString(env, argv[0], &str) == 0 && str)
        (void)cc__js.GetValueStringUtf8(env, str, req->errmsg,
                                        sizeof(req->errmsg), &got);
    req->failed = 1;
    ccpy__cb_conclude(req->box->dom, req);
    return NULL;
}

/* Suspend a request on the thenable the callback returned: attach the
 * settle handlers and leave `done` unset — the executor keeps servicing
 * its queue meanwhile.  The thenable is normalized through the REAL
 * Promise.resolve first: the handlers' data pointer is the executor's
 * stack record, so they must fire at most once and never after resume —
 * real promises guarantee exactly that, where a hand-rolled thenable
 * could double-settle or settle late.  On failure the caller fails the
 * request with req->errmsg. */
static int ccpy__cb_suspend(void *env, void *ret, CcJsCbReq *req) {
    void *thenfn = NULL;
    void *onok = NULL;
    void *onerr = NULL;
    void *handlers[2];
    void *res = NULL;
    if (!cc__js.CreateFunction || !cc__js.GetCbInfo) {
        snprintf(req->errmsg, sizeof(req->errmsg),
                 "cc-python: this Node runtime cannot suspend callbacks "
                 "(needs napi_create_function)");
        return -1;
    }
    {
        void *global = NULL;
        void *promise_ctor = NULL;
        void *resolvefn = NULL;
        void *normalized = NULL;
        if (cc__js.GetGlobal && cc__js.GetGlobal(env, &global) == 0 && global &&
            cc__js.GetNamedProperty(env, global, "Promise", &promise_ctor) == 0 &&
            promise_ctor &&
            cc__js.GetNamedProperty(env, promise_ctor, "resolve",
                                    &resolvefn) == 0 && resolvefn &&
            cc__js.CallFunction(env, promise_ctor, resolvefn, 1, &ret,
                                &normalized) == 0 && normalized)
            ret = normalized;
        else if (cc__js.GetAndClearLastException) {
            void *ignored = NULL;
            (void)cc__js.GetAndClearLastException(env, &ignored);
        }
    }
    if (cc__js.GetNamedProperty(env, ret, "then", &thenfn) != 0 || !thenfn ||
        cc__js.CreateFunction(env, "ccPyOnOk", 8, (void *)ccpy__cb_then_ok,
                              req, &onok) != 0 ||
        cc__js.CreateFunction(env, "ccPyOnErr", 9, (void *)ccpy__cb_then_err,
                              req, &onerr) != 0) {
        snprintf(req->errmsg, sizeof(req->errmsg),
                 "cc-python: cannot attach to the callback's Promise");
        return -1;
    }
    handlers[0] = onok;
    handlers[1] = onerr;
    if (cc__js.CallFunction(env, ret, thenfn, 2, handlers, &res) != 0) {
        ccpy__js_exc_text(env, req->errmsg, sizeof(req->errmsg));
        return -1;
    }
    return 0;
}

/* Main-thread service for a lane-side callback request. */
static void ccpy__cb_service(void *env, CcJsCbReq *req) {
    CcJsCbBox *box = req->box;
    CcPyDom *d = box->dom;
    void *jsargs[CCPY__JOB_MAX_ARGS];
    void *fnv = NULL;
    void *undef = NULL;
    void *ret = NULL;
    int i;
    int failed = 0;
    if (box->dead || d->closed) {
        snprintf(req->errmsg, sizeof(req->errmsg),
                 "cc-python: bridge is closed");
        failed = 1;
    }
    if (!failed) {
        /* Convert the owned Python args under the GIL (the lane released
         * it before posting). */
        cc__py_attach(&d->py);
        for (i = 0; i < req->argc; i++) {
            CCPyObj r;
            r.o = req->argv[i];
            r.home = &d->py;
            req->argv[i] = NULL;
            if (ccpy__cb_arg_to_js(d, env, r, &jsargs[i]) != 0) {
                snprintf(req->errmsg, sizeof(req->errmsg),
                         "cc-python: cannot marshal a callback argument");
                failed = 1;
                break;
            }
        }
        cc_py_thread_leave();
    }
    if (!failed &&
        (cc__js.GetReferenceValue(env, box->fnref, &fnv) != 0 || !fnv)) {
        snprintf(req->errmsg, sizeof(req->errmsg),
                 "cc-python: the callback function is gone");
        failed = 1;
    }
    if (!failed) {
        cc__js.GetUndefined(env, &undef);
        if (cc__js.CallFunction(env, undef, fnv, (size_t)req->argc, jsargs,
                                &ret) != 0) {
            ccpy__js_exc_text(env, req->errmsg, sizeof(req->errmsg));
            failed = 1;
        }
    }
    /* A thenable return suspends the request instead of settling it: the
     * .then handlers fill the tags when the promise settles, and until
     * then the executor services its own queue (see ccpy__cb_call_lane). */
    if (!failed && ret) {
        int t = 0;
        cc__js.Typeof(env, ret, &t);
        if (t == CC__JS_T_OBJECT) {
            _Bool has = 0;
            if (cc__js.HasNamedProperty(env, ret, "then", &has) == 0 && has) {
                if (ccpy__cb_suspend(env, ret, req) == 0) return;
                failed = 1;
            }
        }
    }
    if (!failed &&
        ccpy__cb_ret_tag(d, env, ret, &req->rkind, &req->rf, &req->ri,
                         &req->rstr, &req->rlen, &req->robj, req->errmsg,
                         sizeof(req->errmsg)) != 0)
        failed = 1;
    req->failed = failed;
    ccpy__cb_conclude(d, req);
}

/* Wrap a JS function as a Python callable registered with the domain.
 * Main thread, GIL held.  Returns an owned PyObject or NULL (errbuf). */
static void *ccpy__cb_wrap(CcPyDom *d, void *env, void *fnval, char *errbuf,
                           size_t errcap) {
    CcJsCbBox *box;
    void *capsule;
    void *callable;
    void *ref = NULL;
    if (!cc__py.CFunctionNewEx || !cc__py.CapsuleNew ||
        !cc__py.CapsuleGetPointer) {
        snprintf(errbuf, errcap, "cc-python: this Python runtime cannot mint "
                                 "callables (needs PyCFunction_NewEx)");
        return NULL;
    }
    pthread_mutex_lock(&d->mu);
    box = (CcJsCbBox *)cc_arena_alloc(&d->arena, sizeof(*box), 16);
    pthread_mutex_unlock(&d->mu);
    if (!box) {
        snprintf(errbuf, errcap, "cc-python: out of memory");
        return NULL;
    }
    memset(box, 0, sizeof(*box));
    if (cc__js.CreateReference(env, fnval, 1, &ref) != 0) {
        snprintf(errbuf, errcap, "cc-python: cannot pin the callback");
        return NULL;
    }
    box->dom = d;
    box->fnref = ref;
    box->next = d->cb_head;
    d->cb_head = box;
    capsule = cc__py.CapsuleNew(box, "cc-python.cb", NULL);
    callable = capsule ? cc__py.CFunctionNewEx(&ccpy__cb_def, capsule, NULL)
                       : NULL;
    if (capsule) cc__py.DecRef(capsule); /* the callable holds it */
    if (!callable) {
        if (cc__py.ErrClear) cc__py.ErrClear();
        snprintf(errbuf, errcap, "cc-python: cannot mint the callback "
                                 "callable");
        return NULL;
    }
    return callable;
}

/* ---- the async lane ------------------------------------------------- */

static int ccpy__is_py_int(void *o);

/* Tag one owned Python value into a job's result slots — shared by the
 * direct call path and the asyncio task-done path. */
static void ccpy__job_tag(CcPyDom *d, CcPyJob *j, CCPyObj val) {
    {
        void *o = val.o;
        void *t = cc__py.BoolFromLong(1);
        void *f = cc__py.BoolFromLong(0);
        int is_t = (o == t), is_f = (o == f);
        if (t) cc__py.DecRef(t);
        if (f) cc__py.DecRef(f);
        if (is_t || is_f) {
            j->rkind = 2;
            j->ri = is_t;
            cc_py_obj_release(&val);
            return;
        }
    }
    if (d->none && val.o == d->none) {
        j->rkind = 4;
        cc_py_obj_release(&val);
        return;
    }
    {
        intptr_t n = 0;
        const char *s = cc__py.AsUTF8AndSize(val.o, &n);
        if (s) {
            char *copy =
                (char *)cc_arena_alloc(&d->exec_arena, (size_t)n + 1, 16);
            if (copy) {
                memcpy(copy, s, (size_t)n);
                copy[n] = 0;
                j->rkind = 3;
                j->rstr = copy;
                j->rlen = (size_t)n;
                cc_py_obj_release(&val);
                return;
            }
        }
        if (cc__py.ErrClear) cc__py.ErrClear();
    }
    {
        CCResult_int64_t_CCPyError iv = cc_py_obj_as_i64(&val);
        if (iv.ok) {
            j->rkind = 1;
            j->ri = (long long)iv.u.value;
            cc_py_obj_release(&val);
            return;
        }
        if (cc__py.ErrClear) cc__py.ErrClear();
    }
    /* Exact BigInt path for ints beyond signed i64 (no float collapse). */
    if (ccpy__is_py_int(val.o)) {
        void *sobj = cc__py.Str(val.o);
        intptr_t n = 0;
        const char *digits;
        char *copy;
        if (!sobj) {
            if (cc__py.ErrClear) cc__py.ErrClear();
            j->rkind = 6;
            snprintf(j->errmsg, sizeof(j->errmsg),
                     "cc-python: cannot materialize a large integer");
            cc_py_obj_release(&val);
            return;
        }
        digits = cc__py.AsUTF8AndSize(sobj, &n);
        if (!digits) {
            cc__py.DecRef(sobj);
            if (cc__py.ErrClear) cc__py.ErrClear();
            j->rkind = 6;
            snprintf(j->errmsg, sizeof(j->errmsg),
                     "cc-python: cannot materialize a large integer");
            cc_py_obj_release(&val);
            return;
        }
        copy = (char *)cc_arena_alloc(&d->exec_arena, (size_t)n + 1, 16);
        if (!copy) {
            cc__py.DecRef(sobj);
            j->rkind = 6;
            snprintf(j->errmsg, sizeof(j->errmsg), "cc-python: out of memory");
            cc_py_obj_release(&val);
            return;
        }
        memcpy(copy, digits, (size_t)n);
        copy[n] = 0;
        cc__py.DecRef(sobj);
        j->rkind = 8;
        j->rstr = copy;
        j->rlen = (size_t)n;
        cc_py_obj_release(&val);
        return;
    }
    {
        CCResult_double_CCPyError fv = cc_py_obj_as_f64(&val);
        if (fv.ok) {
            j->rkind = 0;
            j->rf = fv.u.value;
            cc_py_obj_release(&val);
            return;
        }
        if (cc__py.ErrClear) cc__py.ErrClear();
    }
    j->rkind = 5;
    j->robj = val.o; /* keep the reference for the main thread */
}

/* A coroutine object and nothing else: `cr_code` is coroutine-specific
 * (generators spell gi_code), so no asyncio import on the probe path. */
static int ccpy__is_coro(void *o) {
    void *a = cc__py.GetAttrString(o, "cr_code");
    if (!a) {
        if (cc__py.ErrClear) cc__py.ErrClear();
        return 0;
    }
    cc__py.DecRef(a);
    return 1;
}

/* Persistent `__main__.__dict__` for this domain. Bare builtins.eval /
 * builtins.exec have no Python frame in-process, so CPython cannot
 * default globals — inject this namespace (matches isolated broker). */
static void *ccpy__domain_ns(CcPyDom *d) {
    void *m;
    if (d->ns) return d->ns;
    if (!cc__py.ImportModule || !cc__py.GetAttrString) return NULL;
    m = cc__py.ImportModule("__main__");
    if (!m) {
        if (cc__py.ErrClear) cc__py.ErrClear();
        return NULL;
    }
    d->ns = cc__py.GetAttrString(m, "__dict__");
    cc__py.DecRef(m);
    if (!d->ns && cc__py.ErrClear) cc__py.ErrClear();
    return d->ns;
}

/* True for builtins.eval / builtins.exec (by __name__ + __module__). */
static int ccpy__is_builtin_eval_or_exec(void *fn) {
    void *name, *mod;
    const char *ns = NULL, *ms = NULL;
    intptr_t nn = 0, mn = 0;
    int ok = 0;
    if (!fn || !cc__py.GetAttrString || !cc__py.AsUTF8AndSize) return 0;
    name = cc__py.GetAttrString(fn, "__name__");
    if (!name) {
        if (cc__py.ErrClear) cc__py.ErrClear();
        return 0;
    }
    ns = cc__py.AsUTF8AndSize(name, &nn);
    if (!ns || !((nn == 4 && memcmp(ns, "eval", 4) == 0) ||
                 (nn == 4 && memcmp(ns, "exec", 4) == 0))) {
        cc__py.DecRef(name);
        return 0;
    }
    mod = cc__py.GetAttrString(fn, "__module__");
    if (!mod) {
        if (cc__py.ErrClear) cc__py.ErrClear();
        cc__py.DecRef(name);
        return 0;
    }
    ms = cc__py.AsUTF8AndSize(mod, &mn);
    ok = (ms && mn == 8 && memcmp(ms, "builtins", 8) == 0);
    cc__py.DecRef(mod);
    cc__py.DecRef(name);
    return ok;
}

static int ccpy__aio_schedule(CcPyDom *d, CcPyJob *j, CCPyObj coro);

/* Executor side of one job: attach this thread to the domain's
 * interpreter, run the call, convert a scalar result in place (a held
 * result keeps its reference for the main thread to box), and drop the
 * job's own Python references.  A coroutine result does not complete
 * here: it becomes an asyncio task (engaging loop mode on first use)
 * and the job posts at task-done. */
static void ccpy__exec_run(CcPyDom *d, CcPyJob *j) {
    CCResult_CCPyObj_CCPyError r;
    int i;
    cc__py_attach(&d->py);
    {
        CCPyObj tmp;
        tmp.o = j->fn;
        tmp.home = &d->py;
        r = cc__py_obj_callm_n(&tmp, "invoke", j->argc, j->args);
    }
    for (i = 0; i < j->argc; i++)
        if (j->args[i].kind == 4) cc__py.DecRef((void *)j->args[i].p);
    cc__py.DecRef(j->fn);
    j->fn = NULL;
    if (!r.ok) {
        j->rkind = 6;
        snprintf(j->errmsg, sizeof(j->errmsg), "%s",
                 r.u.error.base.message ? r.u.error.base.message
                                        : "python error");
        return;
    }
    if (ccpy__is_coro(r.u.value.o)) {
        if (ccpy__aio_schedule(d, j, r.u.value) == 0) j->scheduled = 1;
        /* on failure the schedule tagged rkind 6 and the job posts */
        return;
    }
    ccpy__job_tag(d, j, r.u.value);
}

/* ---- stage-2: the asyncio loop on the lane -------------------------- */

static void *ccpy__aio_pump(void *self, void *args);
static void *ccpy__aio_taskdone(void *self, void *args);
static void *ccpy__aio_settle(void *self, void *args);

static CcPyMethodDefMirror ccpy__pump_def = {
    "cc_pump", ccpy__aio_pump, CC__PY_METH_VARARGS,
    "cc-python job pump (runs on the lane's asyncio loop)",
};
static CcPyMethodDefMirror ccpy__taskdone_def = {
    "cc_task_done", ccpy__aio_taskdone, CC__PY_METH_VARARGS,
    "cc-python task completion (posts the job's result)",
};
static CcPyMethodDefMirror ccpy__settle_def = {
    "cc_settle", ccpy__aio_settle, CC__PY_METH_VARARGS,
    "cc-python future settle (fills an awaited callback's result)",
};

static void *ccpy__py_none(CcPyDom *d) {
    if (d->none) {
        cc__py.IncRef(d->none);
        return d->none;
    }
    return cc__py_raise("cc-python: interpreter has no None");
}

/* "Type: message" from an exception OBJECT (not a pending error) — the
 * shape exception text keeps in BOTH crossing directions. */
static void ccpy__exc_text(CcPyDom *d, void *exc, char *buf, size_t cap) {
    const char *tn = NULL;
    intptr_t tl = 0;
    const char *ms = NULL;
    intptr_t ml = 0;
    void *cls = cc__py.GetAttrString(exc, "__class__");
    void *nm = cls ? cc__py.GetAttrString(cls, "__name__") : NULL;
    void *msg = NULL;
    if (nm) tn = cc__py.AsUTF8AndSize(nm, &tl);
    {
        CCPyObj e;
        e.o = exc;
        e.home = &d->py;
        {
            CCResult_CCPyObj_CCPyError r =
                cc__py_obj_callm_n(&e, "__str__", 0, NULL);
            if (r.ok) {
                msg = r.u.value.o;
                ms = cc__py.AsUTF8AndSize(msg, &ml);
            }
        }
    }
    if (cc__py.ErrClear) cc__py.ErrClear();
    if (tn && ms && ml > 0)
        snprintf(buf, cap, "%.*s: %.*s", (int)tl, tn, (int)ml, ms);
    else if (tn) snprintf(buf, cap, "%.*s", (int)tl, tn);
    else snprintf(buf, cap, "python task failed");
    if (msg) cc__py.DecRef(msg);
    if (nm) cc__py.DecRef(nm);
    if (cls) cc__py.DecRef(cls);
}

static int ccpy__truthy(CcPyDom *d, CCPyObj *v) {
    CCResult_int64_t_CCPyError iv = cc_py_obj_as_i64(v);
    (void)d;
    if (iv.ok) return iv.u.value != 0;
    if (cc__py.ErrClear) cc__py.ErrClear();
    return 0;
}

/* Engage loop mode: import asyncio, build the loop and the pump.  Lane
 * thread, GIL held.  Idempotent; failure is the caller's articulate
 * error (never a silent sync fallback). */
static int ccpy__aio_ensure(CcPyDom *d) {
    void *aio;
    void *loop = NULL;
    void *pump = NULL;
    void *rterr = NULL;
    if (d->loop_mode) return 0;
    if (!cc__py.CFunctionNewEx || !cc__py.CapsuleNew ||
        !cc__py.CapsuleGetPointer)
        return -1;
    aio = cc__py.ImportModule("asyncio");
    if (!aio) {
        if (cc__py.ErrClear) cc__py.ErrClear();
        return -1;
    }
    {
        CCPyObj m;
        m.o = aio;
        m.home = &d->py;
        {
            CCResult_CCPyObj_CCPyError r =
                cc__py_obj_callm_n(&m, "new_event_loop", 0, NULL);
            if (!r.ok) {
                cc__py.DecRef(aio);
                return -1;
            }
            loop = r.u.value.o;
        }
    }
    {
        void *cap = cc__py.CapsuleNew(d, "cc-python.dom", NULL);
        pump = cap ? cc__py.CFunctionNewEx(&ccpy__pump_def, cap, NULL) : NULL;
        if (cap) cc__py.DecRef(cap);
    }
    {
        void *b = cc__py.ImportModule("builtins");
        if (b) {
            rterr = cc__py.GetAttrString(b, "RuntimeError");
            cc__py.DecRef(b);
        }
        if (!rterr && cc__py.ErrClear) cc__py.ErrClear();
    }
    if (!pump) {
        if (cc__py.ErrClear) cc__py.ErrClear();
        cc__py.DecRef(loop);
        cc__py.DecRef(aio);
        if (rterr) cc__py.DecRef(rterr);
        return -1;
    }
    pthread_mutex_lock(&d->mu);
    d->aio = aio;
    d->loop = loop;
    d->pump = pump;
    d->rterr = rterr;
    d->loop_mode = 1;
    pthread_mutex_unlock(&d->mu);
    return 0;
}

/* Coroutine -> asyncio task, job completes at task-done.  Lane thread,
 * GIL held; owns (and releases) the coroutine either way. */
static int ccpy__aio_schedule(CcPyDom *d, CcPyJob *j, CCPyObj coro) {
    void *task = NULL;
    if (ccpy__aio_ensure(d) != 0) {
        j->rkind = 6;
        snprintf(j->errmsg, sizeof(j->errmsg),
                 "cc-python: the call returned a coroutine but this Python "
                 "runtime cannot host an asyncio lane (needs asyncio and "
                 "PyCFunction_NewEx)");
        cc_py_obj_release(&coro);
        return -1;
    }
    {
        CCPyObj lo;
        CCPyArg a;
        lo.o = d->loop;
        lo.home = &d->py;
        a = cc__py_arg_obj(coro);
        {
            CCResult_CCPyObj_CCPyError r =
                cc__py_obj_callm_n(&lo, "create_task", 1, &a);
            cc_py_obj_release(&coro);
            if (!r.ok) {
                j->rkind = 6;
                snprintf(j->errmsg, sizeof(j->errmsg), "%s",
                         r.u.error.base.message ? r.u.error.base.message
                                                : "cannot schedule the task");
                return -1;
            }
            task = r.u.value.o;
        }
    }
    {
        void *cap = cc__py.CapsuleNew(j, "cc-python.job", NULL);
        void *dcb =
            cap ? cc__py.CFunctionNewEx(&ccpy__taskdone_def, cap, NULL) : NULL;
        if (cap) cc__py.DecRef(cap);
        if (!dcb) {
            CCPyObj t;
            t.o = task;
            t.home = &d->py;
            if (cc__py.ErrClear) cc__py.ErrClear();
            {
                CCResult_CCPyObj_CCPyError rc =
                    cc__py_obj_callm_n(&t, "cancel", 0, NULL);
                if (rc.ok) cc_py_obj_release(&rc.u.value);
                else if (cc__py.ErrClear) cc__py.ErrClear();
            }
            cc__py.DecRef(task);
            j->rkind = 6;
            snprintf(j->errmsg, sizeof(j->errmsg),
                     "cc-python: cannot mint the task callback");
            return -1;
        }
        {
            CCPyObj t;
            CCPyObj dv;
            CCPyArg da;
            t.o = task;
            t.home = &d->py;
            dv.o = dcb;
            dv.home = &d->py;
            da = cc__py_arg_obj(dv);
            {
                CCResult_CCPyObj_CCPyError r2 =
                    cc__py_obj_callm_n(&t, "add_done_callback", 1, &da);
                cc__py.DecRef(dcb);
                if (!r2.ok) {
                    if (cc__py.ErrClear) cc__py.ErrClear();
                    cc__py.DecRef(task);
                    j->rkind = 6;
                    snprintf(j->errmsg, sizeof(j->errmsg),
                             "cc-python: cannot attach the task callback");
                    return -1;
                }
                cc_py_obj_release(&r2.u.value);
            }
        }
    }
    j->task = task;
    pthread_mutex_lock(&d->mu);
    j->next = d->sched_head;
    d->sched_head = j;
    d->sched_live++;
    pthread_mutex_unlock(&d->mu);
    return 0;
}

/* Task completion — loop thread, GIL held.  Tags the job (result,
 * exception as "Type: message", or the drain rejection) and posts it. */
static void *ccpy__aio_taskdone(void *self, void *args) {
    CcPyJob *j = cc__py.CapsuleGetPointer
                     ? (CcPyJob *)cc__py.CapsuleGetPointer(self, "cc-python.job")
                     : NULL;
    CcPyDom *d;
    void *task;
    if (!j) return cc__py_raise("cc-python: corrupt task capsule");
    d = j->dom;
    task = (args && cc__py.TupleSize(args) > 0)
               ? cc__py.TupleGetItem(args, 0) /* borrowed */
               : NULL;
    pthread_mutex_lock(&d->mu);
    {
        CcPyJob **pp = &d->sched_head;
        while (*pp && *pp != j) pp = &(*pp)->next;
        if (*pp) {
            *pp = j->next;
            d->sched_live--;
        }
    }
    pthread_mutex_unlock(&d->mu);
    j->next = NULL;
    if (j->task) {
        cc__py.DecRef(j->task);
        j->task = NULL;
    }
    if (!task) {
        j->rkind = 6;
        snprintf(j->errmsg, sizeof(j->errmsg), "cc-python: task vanished");
    } else {
        CCPyObj t;
        t.o = task;
        t.home = &d->py;
        {
            CCResult_CCPyObj_CCPyError rc =
                cc__py_obj_callm_n(&t, "cancelled", 0, NULL);
            int was_cancelled = 0;
            if (rc.ok) {
                was_cancelled = ccpy__truthy(d, &rc.u.value);
                cc_py_obj_release(&rc.u.value);
            } else if (cc__py.ErrClear) {
                cc__py.ErrClear();
            }
            if (was_cancelled) {
                j->rejected = 1; /* settles as "bridge is closed" */
            } else {
                CCResult_CCPyObj_CCPyError re =
                    cc__py_obj_callm_n(&t, "exception", 0, NULL);
                if (!re.ok) {
                    j->rkind = 6;
                    snprintf(j->errmsg, sizeof(j->errmsg), "%s",
                             re.u.error.base.message
                                 ? re.u.error.base.message
                                 : "python task failed");
                } else if (re.u.value.o && re.u.value.o != d->none) {
                    j->rkind = 6;
                    ccpy__exc_text(d, re.u.value.o, j->errmsg,
                                   sizeof(j->errmsg));
                    cc_py_obj_release(&re.u.value);
                } else {
                    cc_py_obj_release(&re.u.value);
                    {
                        CCResult_CCPyObj_CCPyError rr =
                            cc__py_obj_callm_n(&t, "result", 0, NULL);
                        if (rr.ok) {
                            ccpy__job_tag(d, j, rr.u.value);
                        } else {
                            j->rkind = 6;
                            snprintf(j->errmsg, sizeof(j->errmsg), "%s",
                                     rr.u.error.base.message
                                         ? rr.u.error.base.message
                                         : "python task failed");
                        }
                    }
                }
            }
        }
    }
    pthread_mutex_lock(&d->mu);
    d->pending_done++;
    pthread_mutex_unlock(&d->mu);
    cc__js.CallTsfn(d->tsfn, j, 1);
    return ccpy__py_none(d);
}

/* The queue, serviced from the loop: run sync calls inline (they block
 * the loop — choosing sync is choosing that), schedule coroutines, and
 * under `stopping` reject the backlog and stop the loop.  Loop thread,
 * GIL held throughout. */
static void *ccpy__aio_pump(void *self, void *args) {
    CcPyDom *d = cc__py.CapsuleGetPointer
                     ? (CcPyDom *)cc__py.CapsuleGetPointer(self, "cc-python.dom")
                     : NULL;
    (void)args;
    if (!d) return cc__py_raise("cc-python: corrupt pump capsule");
    for (;;) {
        CcPyJob *j;
        int stopping;
        pthread_mutex_lock(&d->mu);
        j = d->qhead;
        if (j) {
            d->qhead = j->next;
            if (!d->qhead) d->qtail = NULL;
            j->next = NULL;
        }
        stopping = d->stopping;
        pthread_mutex_unlock(&d->mu);
        if (!j) {
            if (stopping) {
                CCPyObj lo;
                lo.o = d->loop;
                lo.home = &d->py;
                {
                    CCResult_CCPyObj_CCPyError r =
                        cc__py_obj_callm_n(&lo, "stop", 0, NULL);
                    if (r.ok) cc_py_obj_release(&r.u.value);
                    else if (cc__py.ErrClear) cc__py.ErrClear();
                }
            }
            break;
        }
        if (stopping) {
            j->rejected = 1;
            pthread_mutex_lock(&d->mu);
            d->pending_done++;
            pthread_mutex_unlock(&d->mu);
            cc__js.CallTsfn(d->tsfn, j, 1);
            continue;
        }
        ccpy__exec_run(d, j); /* attach is idempotent; the GIL stays */
        if (!j->scheduled) {
            pthread_mutex_lock(&d->mu);
            d->pending_done++;
            pthread_mutex_unlock(&d->mu);
            cc__js.CallTsfn(d->tsfn, j, 1);
        }
    }
    return ccpy__py_none(d);
}

/* An awaitable callback's future settles here, on the loop thread with
 * the GIL — set_result/set_exception are loop-affine.  Frees the
 * request and drops its arena hold. */
static void *ccpy__aio_settle(void *self, void *args) {

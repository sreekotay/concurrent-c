/*
 * epoch_wheel.ccs — ring of gen buckets (wstore5 wheel-shaped, study-local).
 *
 * New allocs go to slots[cur]. Driver epoch advances cur; the previous
 * slot parks when empty. Same EpSlot / reclaim queue as epoch_store.
 *
 * Thin handles live in claim_pool / reg_pool (freelist); gen bodies are
 * densified by mid-gen compact when dead ratio is high (see hostile.ccs).
 *
 * Requires epoch_store.ccs included first (shared bucket helpers).
 */
#pragma once

#ifndef EP_WHEEL_N
#define EP_WHEEL_N 8
#endif

/* Compact when live_n * DEN < born * NUM (default: live < 2/3 ⇒ >⅓ dead). */
#ifndef EP_COMPACT_NUM
#define EP_COMPACT_NUM 2
#endif
#ifndef EP_COMPACT_DEN
#define EP_COMPACT_DEN 3
#endif

typedef struct EpWheel {
    CCArena owner;
    EpBucket slots[EP_WHEEL_N];
    int cur;
    uint32_t gen_seq;
    EpReclaimQ rq;
    CCArenaPool claim_pool;
    CCArenaPool reg_pool;
    int pools_ready;
    int ready;
} EpWheel;

static int ep_wheel_init(EpWheel *w, CCArena owner) {
    int i;
    if (!w || !owner.valid()) return -1;
    memset(w, 0, sizeof(*w));
    w->owner = owner;
    ep_rq_init(&w->rq);
    for (i = 0; i < EP_WHEEL_N; i++) {
        ep_bucket_reset(&w->slots[i]);
        w->slots[i].gen = (uint32_t)(i + 1);
    }
    w->cur = 0;
    w->gen_seq = EP_WHEEL_N;
    /* Thin handle ≈ { void *body; uint8_t freed; } — freelist uses first word. */
    if (cc_arena_pool(&w->claim_pool, sizeof(void *) * 2) != 0) return -1;
    if (cc_arena_pool(&w->reg_pool, sizeof(void *) * 2) != 0) {
        cc_arena_pool_destroy(&w->claim_pool);
        return -1;
    }
    w->pools_ready = 1;
    w->ready = 1;
    return 0;
}

static void *ep_wheel_alloc(EpWheel *w, size_t nbytes, size_t align) {
    if (!w || !w->ready) return NULL;
    return ep_bucket_alloc(&w->slots[w->cur], nbytes, align);
}

static void ep_wheel_release(EpWheel *w, EpSlot *e) {
    (void)w;
    ep_slot_release(e);
}

static int ep_bucket_should_compact(const EpBucket *b) {
    if (!b || !b->recs.valid() || b->live_n == 0 || b->born == 0) return 0;
    /* live_n / born < NUM/DEN  <=>  live_n * DEN < born * NUM */
    return b->live_n * (size_t)EP_COMPACT_DEN < b->born * (size_t)EP_COMPACT_NUM;
}

/* Advance wheel: park current if empty, move to next slot. */
static void ep_wheel_rotate(EpWheel *w) {
    int next;
    if (!w || !w->ready) return;
    (void)ep_bucket_try_park(&w->rq, &w->slots[w->cur]);
    next = (w->cur + 1) % EP_WHEEL_N;
    /* If next still has live claims, keep allocating there (overlap).
     * If empty and parked, reset for a new gen. */
    if (w->slots[next].live_n == 0 && !w->slots[next].recs.valid()) {
        ep_bucket_reset(&w->slots[next]);
        w->gen_seq++;
        if (!w->gen_seq) w->gen_seq = 1;
        w->slots[next].gen = w->gen_seq;
    }
    w->cur = next;
}

static void ep_wheel_reclaim(EpWheel *w) {
    if (!w) return;
    ep_rq_reclaim(&w->rq);
}

static void ep_wheel_destroy(EpWheel *w) {
    int i;
    if (!w || !w->ready) return;
    for (i = 0; i < EP_WHEEL_N; i++)
        (void)ep_bucket_try_park(&w->rq, &w->slots[i]);
    ep_wheel_reclaim(w);
    for (i = 0; i < EP_WHEEL_N; i++) {
        if (w->slots[i].recs.valid()) {
            w->slots[i].recs.destroy();
            w->rq.destroys++;
            w->slots[i].recs = ep_arena_none();
        }
    }
    if (w->pools_ready) {
        cc_arena_pool_destroy(&w->claim_pool);
        cc_arena_pool_destroy(&w->reg_pool);
        w->pools_ready = 0;
    }
    w->ready = 0;
}

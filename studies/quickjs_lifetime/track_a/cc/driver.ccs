/*
 * Track A driver — hostile retain/release/weak + callback registry.
 *
 * Build:
 *   cc -O2 -c stress/mem_sample.c -o /tmp/mem_sample.o
 *   CC_QUICKJS_SRC=... ./cc/bin/ccc build \
 *     studies/quickjs_lifetime/track_a/cc/driver.ccs \
 *     -o studies/quickjs_lifetime/track_a/results/driver_cc \
 *     --ld-flags /tmp/mem_sample.o \
 *     -I studies/quickjs_lifetime/track_a/cc \
 *     -I stress
 */
#include <ccc/std/prelude.cch>
#include <ccc/stdio.cch>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>
#include "hostile.ccs"
#include "mem_sample.h"

static int g_create = 200;
static int g_retain = 40;
static int g_gens = 3;
static int g_micro = 2000;

static void chk(int epoch, const char *phase, HostileRealm *r, int ok,
                const char *detail) {
    StressMemSample m = stress_mem_sample();
    size_t rss = m.ok ? m.current : 0;
    if (detail && detail[0] && !ok)
        printf("CHK {\"epoch\":%d,\"phase\":\"%s\",\"claims\":%zu,\"weaks\":%zu,"
               "\"regs\":%zu,\"rss\":%zu,\"ok\":%d,\"detail\":\"%s\"}\n",
               epoch, phase, hostile_outstanding_claims(r),
               hostile_outstanding_weaks(r), hostile_outstanding_regs(r), rss,
               ok, detail);
    else
        printf("CHK {\"epoch\":%d,\"phase\":\"%s\",\"claims\":%zu,\"weaks\":%zu,"
               "\"regs\":%zu,\"rss\":%zu,\"ok\":%d}\n",
               epoch, phase, hostile_outstanding_claims(r),
               hostile_outstanding_weaks(r), hostile_outstanding_regs(r), rss,
               ok);
    fflush(stdout);
}

static long long ns_now(void) {
    struct timespec ts;
    clock_gettime(CLOCK_MONOTONIC, &ts);
    return (long long)ts.tv_sec * 1000000000LL + ts.tv_nsec;
}

static void perf(const char *op, int n, long long ns) {
    printf("PERF {\"op\":\"%s\",\"n\":%d,\"ns_total\":%lld,\"ns_per_op\":%lld}\n",
           op, n, ns, n ? ns / n : 0);
    fflush(stdout);
}

static const char *kMakePayload =
    "function makePayload(i) {"
    "  const payload = new Uint8Array(64 * 1024);"
    "  payload[0] = i & 255;"
    "  const a = { i: i, payload: payload };"
    "  const b = { parent: a };"
    "  a.child = b;"
    "  return function () {"
    "    if (a.i !== i) throw new Error('corrupt');"
    "    return a.payload[0];"
    "  };"
    "}";

int main(void) {
    @errhandler(CCError e) {
        fprintf(stderr, "fatal: %s\n", e.message);
        return 1;
    }

    const char *scale = getenv("HOSTILE_SCALE");
    size_t arena_mb = 64;
    if (scale && strcmp(scale, "full") == 0) {
        g_create = 1000;
        g_retain = 100;
        g_gens = 3;
        g_micro = 10000;
        arena_mb = 128;
    } else if (scale && strcmp(scale, "x10") == 0) {
        /* 10× full: pressure host claim machinery + RSS slope. */
        g_create = 10000;
        g_retain = 1000;
        g_gens = 3;
        g_micro = 100000;
        arena_mb = 512;
    } else if (scale && strcmp(scale, "x100") == 0) {
        /* 10× x10 — expect RSS to suffer (JS payloads + gen arenas). */
        g_create = 100000;
        g_retain = 10000;
        g_gens = 3;
        g_micro = 100000; /* keep microbench capped; reclaim/RSS is the story */
        arena_mb = 2048;
    }

    CCArena a = cc_arena_heap(megabytes(arena_mb)) @destroy;
    if (!a.valid()) return 1;
    if (!cc_qjs_available()) {
        puts("SKIP (attach quickjs-ng — CC_QUICKJS_SRC)");
        return 0;
    }

    int err = 0;
    HostileRealm *realm = hostile_realm_new(a, &err);
    if (!realm) {
        fprintf(stderr, "realm_new failed %d\n", err);
        return 2;
    }

    {
        void !>(CCQjsError) xe =
            cc_qjs_exec(&realm->js, cc__qjs_src(kMakePayload));
        if (!xe.ok) {
            fprintf(stderr, "inject makePayload failed\n");
            return 2;
        }
    }

    /* --- microbench retain/release --- */
    {
        HostileValue *one =
            hostile_eval(realm, "makePayload(0)", a, &err);
        if (!one) return 2;
        long long t0 = ns_now();
        int i;
        for (i = 0; i < g_micro; i++) {
            HostileClaim *c = hostile_retain(realm, one, a, &err);
            if (!c) return 2;
            if (hostile_release(c) != HOSTILE_OK) return 2;
        }
        perf("retain", g_micro, ns_now() - t0);
        t0 = ns_now();
        for (i = 0; i < g_micro; i++) {
            HostileClaim *c = hostile_retain(realm, one, a, &err);
            if (!c) return 2;
            (void)hostile_release(c);
        }
        perf("release", g_micro, ns_now() - t0);
        {
            HostileClaim *c = hostile_retain(realm, one, a, &err);
            long long tb = ns_now();
            for (i = 0; i < g_micro; i++) {
                HostileBorrow *b = hostile_borrow_begin(c, a, &err);
                if (!b || !hostile_borrow_value(b)) return 2;
                if (hostile_borrow_end(b) != HOSTILE_OK) return 2;
            }
            perf("borrow", g_micro, ns_now() - tb);
            (void)hostile_release(c);
        }
        hostile_value_drop(one);
    }

    long long wall0 = ns_now();
    int epoch;
    for (epoch = 0; epoch < g_gens; epoch++) {
        HostileClaim **claims =
            (HostileClaim **)cc_arena_alloc(
                a, (size_t)g_retain * sizeof(HostileClaim *),
                _Alignof(HostileClaim *));
        HostileWeak **weaks = (HostileWeak **)cc_arena_alloc(
            a, (size_t)g_retain * sizeof(HostileWeak *),
            _Alignof(HostileWeak *));
        HostileRegistration **regs = (HostileRegistration **)cc_arena_alloc(
            a, (size_t)(g_retain / 4 + 1) * sizeof(HostileRegistration *),
            _Alignof(HostileRegistration *));
        int nreg = 0;
        int i;
        if (!claims || !weaks || !regs) return 2;

        for (i = 0; i < g_create; i++) {
            char src[64];
            snprintf(src, sizeof(src), "makePayload(%d)", i + epoch * g_create);
            HostileValue *v = hostile_eval(realm, src, a, &err);
            if (!v) {
                chk(epoch, "after_create", realm, 0, "eval");
                return 3;
            }
            if (i < g_retain) {
                claims[i] = hostile_retain(realm, v, a, &err);
                weaks[i] = hostile_weak(realm, v, a, &err);
                if (!claims[i] || !weaks[i]) {
                    chk(epoch, "after_retain", realm, 0, "retain/weak");
                    return 3;
                }
                if ((i % 4) == 0) {
                    regs[nreg] =
                        hostile_register_callback(realm, v, a, &err);
                    if (!regs[nreg]) {
                        chk(epoch, "after_retain", realm, 0, "register");
                        return 3;
                    }
                    nreg++;
                }
            }
            hostile_value_drop(v);
        }
        chk(epoch, "after_retain", realm, 1, NULL);

        /* Drop accidental globals / pressure before use. */
        (void)cc_qjs_exec(&realm->js,
                          cc__qjs_src("globalThis.__batch = undefined"));
        chk(epoch, "after_drop_roots", realm, 1, NULL);

        hostile_gc_pressure(realm);
        chk(epoch, "after_gc", realm, 1, NULL);

        /* Use retained claims via borrow + invoke. */
        for (i = 0; i < g_retain; i++) {
            HostileBorrow *b = hostile_borrow_begin(claims[i], a, &err);
            CCQjsVal *bv;
            int64_t !>(CCQjsError) got;
            if (!b) {
                chk(epoch, "after_use", realm, 0, "borrow");
                return 3;
            }
            bv = hostile_borrow_value(b);
            if (!bv) {
                chk(epoch, "after_use", realm, 0, "borrow_val");
                return 3;
            }
            got = cc_qjs_val_callm_int64_t(bv, "invoke", 0);
            if (!got.ok) {
                chk(epoch, "after_use", realm, 0, "invoke_claim");
                return 3;
            }
            (void)hostile_borrow_end(b);
        }
        for (i = 0; i < nreg; i++) {
            if (hostile_invoke_registered(regs[i]) != HOSTILE_OK) {
                chk(epoch, "after_callback", realm, 0, "invoke_reg");
                return 3;
            }
        }
        chk(epoch, "after_use", realm, 1, NULL);
        chk(epoch, "after_callback", realm, 1, NULL);

        /* Release half the claims. */
        for (i = 0; i < g_retain / 2; i++) {
            if (hostile_release(claims[i]) != HOSTILE_OK) {
                chk(epoch, "after_release_half", realm, 0, "release");
                return 3;
            }
            claims[i] = NULL;
        }
        chk(epoch, "after_release_half", realm, 1, NULL);

        hostile_gc_pressure(realm);
        chk(epoch, "after_gc2", realm, 1, NULL);

        /* Remaining claims still usable; released weaks may expire. */
        for (i = g_retain / 2; i < g_retain; i++) {
            HostileClaim *up = hostile_upgrade(weaks[i], a, &err);
            if (!up) {
                chk(epoch, "after_weak_check", realm, 0, "upgrade_live");
                return 3;
            }
            (void)hostile_release(up);
        }
        /* Weaks for released half: upgrade may expire (ok) or still succeed
         * if other roots keep the object — either is HOSTILE_OK path. */
        chk(epoch, "after_weak_check", realm, 1, NULL);

        /* Unregister callbacks; invoke must fail. */
        for (i = 0; i < nreg; i++) {
            if (hostile_unregister(regs[i]) != HOSTILE_OK) {
                chk(epoch, "after_teardown", realm, 0, "unregister");
                return 3;
            }
            if (hostile_invoke_registered(regs[i]) != HOSTILE_ERR_EXPIRED) {
                chk(epoch, "after_teardown", realm, 0, "invoke_after_unreg");
                return 3;
            }
        }

        for (i = g_retain / 2; i < g_retain; i++)
            (void)hostile_release(claims[i]);
        for (i = 0; i < g_retain; i++)
            hostile_weak_drop(weaks[i]);

        /* Rotate + reclaim for epoch/wheel; no-op for flat. */
        hostile_epoch_end(realm);
    }

    /* Realm teardown with no live claims. */
    hostile_realm_destroy(realm);
    chk(g_gens, "after_teardown", realm, 1, NULL);

    perf("workload_wall", 1, ns_now() - wall0);
    puts("ORACLE PASS");
    return 0;
}

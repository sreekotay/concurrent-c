/*
 * Track A hostile contract — CC implementation.
 *
 * Backends (HOSTILE_IMPL):
 *   flat  — claim/reg bodies on the driver arena (no gen reclaim)
 *   epoch — simple single-gen store (epoch_store.ccs)
 *   wheel — ring of gen buckets + thin pool handles (stable slot → gen body)
 *
 * Wheel handles are ~pointer-sized pool slots with freelist reuse. Mid-gen
 * compact densifies live bodies when dead ratio is high and patches slots.
 *
 * Frozen ABI unchanged. Does not extend CCQjsVal UFCS / quickjs.cch.
 */
#pragma once

#include <ccc/script/quickjs.cch>
#include <string.h>
#include <stdio.h>
#include <stdint.h>
#include <stdlib.h>
#include "epoch_store.ccs"
#include "epoch_wheel.ccs"

enum {
    HOSTILE_OK = 0,
    HOSTILE_ERR_EXPIRED = 1,
    HOSTILE_ERR_DOUBLE_RELEASE = 2,
    HOSTILE_ERR_STALE_REALM = 3,
    HOSTILE_ERR_STALE_BORROW = 4,
    HOSTILE_ERR_NOT_LIVE = 5,
    HOSTILE_ERR_BAD_VALUE = 6,
    HOSTILE_ERR_ARENA = 7
};

typedef enum {
    HOSTILE_IMPL_FLAT = 0,
    HOSTILE_IMPL_EPOCH = 1,
    HOSTILE_IMPL_WHEEL = 2
} HostileImpl;

typedef struct HostileRealm HostileRealm;
typedef struct HostileClaim HostileClaim;
typedef struct HostileRegistration HostileRegistration;

typedef struct HostileRealm {
    CCQjs js;
    CCArena owner;
    HostileImpl impl;
    EpStore store;
    EpWheel wheel;
    int alive;
    size_t n_claims;
    size_t n_weaks;
    size_t n_regs;
} HostileRealm;

typedef struct HostileValue {
    HostileRealm *realm;
    CCQjsVal v;
    int live;
} HostileValue;

/* Gen-local / arena-local payloads. Thin HostileClaim* points here. */
typedef struct HostileClaimBody {
    EpSlot ep;
    CCQjsVal v;
    HostileRealm *realm;
    HostileClaim *handle; /* backptr — patched on mid-gen compact */
} HostileClaimBody;

typedef struct HostileRegBody {
    EpSlot ep;
    CCQjsVal fn;
    HostileRealm *realm;
    HostileRegistration *handle;
} HostileRegBody;

/*
 * Thin handle: body pointer + sticky freed bit.
 * Wheel pool freelist overwrites the first word only (`body` ↔ next), so
 * `freed` must stay after that word — post-release is_live still works.
 */
struct HostileClaim {
    HostileClaimBody *body;
    uint8_t freed;
};

typedef struct HostileWeak {
    HostileRealm *realm;
    CCQjsVal weakref;
    int live;
} HostileWeak;

struct HostileRegistration {
    HostileRegBody *body;
    uint8_t freed;
};

typedef struct HostileBorrow {
    HostileClaim *claim;
    int open;
} HostileBorrow;

static HostileImpl hostile_impl_from_env(void) {
    const char *s = getenv("HOSTILE_IMPL");
    if (!s || !s[0] || strcmp(s, "epoch") == 0) return HOSTILE_IMPL_EPOCH;
    if (strcmp(s, "flat") == 0) return HOSTILE_IMPL_FLAT;
    if (strcmp(s, "wheel") == 0) return HOSTILE_IMPL_WHEEL;
    return HOSTILE_IMPL_EPOCH;
}

static const char *hostile_impl_name(HostileImpl i) {
    switch (i) {
    case HOSTILE_IMPL_FLAT: return "flat";
    case HOSTILE_IMPL_EPOCH: return "epoch";
    case HOSTILE_IMPL_WHEEL: return "wheel";
    }
    return "?";
}

static int hostile_claim_is_live(const HostileClaim *c) {
    return c && !c->freed && c->body && c->body->ep.live;
}

static CCQjsVal *hostile_claim_val(HostileClaim *c) {
    if (!hostile_claim_is_live(c)) return NULL;
    return &c->body->v;
}

static int hostile_reg_is_live(const HostileRegistration *r) {
    return r && !r->freed && r->body && r->body->ep.live;
}

static CCQjsVal *hostile_reg_fn(HostileRegistration *r) {
    if (!hostile_reg_is_live(r)) return NULL;
    return &r->body->fn;
}

static HostileClaimBody *hostile_claim_body_alloc(HostileRealm *realm) {
    HostileClaimBody *body;
    if (!realm) return NULL;
    if (realm->impl == HOSTILE_IMPL_FLAT) {
        body = (HostileClaimBody *)cc_arena_alloc(
            realm->owner, sizeof(*body), _Alignof(HostileClaimBody));
        if (!body) return NULL;
        memset(body, 0, sizeof(*body));
        body->ep.live = 1;
        body->ep.kind = EP_KIND_CLAIM;
        body->ep.bucket = NULL;
        return body;
    }
    if (realm->impl == HOSTILE_IMPL_EPOCH) {
        body = (HostileClaimBody *)ep_alloc(&realm->store, sizeof(*body),
                                            _Alignof(HostileClaimBody));
        if (!body) return NULL;
        body->ep.kind = EP_KIND_CLAIM;
        return body;
    }
    if (realm->impl == HOSTILE_IMPL_WHEEL) {
        body = (HostileClaimBody *)ep_wheel_alloc(&realm->wheel, sizeof(*body),
                                                  _Alignof(HostileClaimBody));
        if (!body) return NULL;
        body->ep.kind = EP_KIND_CLAIM;
        return body;
    }
    return NULL;
}

static HostileRegBody *hostile_reg_body_alloc(HostileRealm *realm) {
    HostileRegBody *body;
    if (!realm) return NULL;
    if (realm->impl == HOSTILE_IMPL_FLAT) {
        body = (HostileRegBody *)cc_arena_alloc(
            realm->owner, sizeof(*body), _Alignof(HostileRegBody));
        if (!body) return NULL;
        memset(body, 0, sizeof(*body));
        body->ep.live = 1;
        body->ep.kind = EP_KIND_REG;
        body->ep.bucket = NULL;
        return body;
    }
    if (realm->impl == HOSTILE_IMPL_EPOCH) {
        body = (HostileRegBody *)ep_alloc(&realm->store, sizeof(*body),
                                          _Alignof(HostileRegBody));
        if (!body) return NULL;
        body->ep.kind = EP_KIND_REG;
        return body;
    }
    if (realm->impl == HOSTILE_IMPL_WHEEL) {
        body = (HostileRegBody *)ep_wheel_alloc(&realm->wheel, sizeof(*body),
                                                _Alignof(HostileRegBody));
        if (!body) return NULL;
        body->ep.kind = EP_KIND_REG;
        return body;
    }
    return NULL;
}

static HostileClaim *hostile_claim_handle_alloc(HostileRealm *realm) {
    HostileClaim *c;
    if (!realm) return NULL;
    if (realm->impl == HOSTILE_IMPL_WHEEL) {
        c = (HostileClaim *)cc_arena_pool_alloc(&realm->wheel.claim_pool);
        if (!c) return NULL;
        c->body = NULL;
        c->freed = 0;
        return c;
    }
    c = (HostileClaim *)cc_arena_alloc(realm->owner, sizeof(*c),
                                       _Alignof(HostileClaim));
    if (!c) return NULL;
    c->body = NULL;
    c->freed = 0;
    return c;
}

static HostileRegistration *hostile_reg_handle_alloc(HostileRealm *realm) {
    HostileRegistration *r;
    if (!realm) return NULL;
    if (realm->impl == HOSTILE_IMPL_WHEEL) {
        r = (HostileRegistration *)cc_arena_pool_alloc(&realm->wheel.reg_pool);
        if (!r) return NULL;
        r->body = NULL;
        r->freed = 0;
        return r;
    }
    r = (HostileRegistration *)cc_arena_alloc(realm->owner, sizeof(*r),
                                              _Alignof(HostileRegistration));
    if (!r) return NULL;
    r->body = NULL;
    r->freed = 0;
    return r;
}

static void hostile_claim_handle_free(HostileRealm *realm, HostileClaim *c) {
    if (!realm || !c) return;
    c->freed = 1;
    c->body = NULL;
    if (realm->impl == HOSTILE_IMPL_WHEEL)
        cc_arena_pool_free(&realm->wheel.claim_pool, c);
}

static void hostile_reg_handle_free(HostileRealm *realm, HostileRegistration *r) {
    if (!realm || !r) return;
    r->freed = 1;
    r->body = NULL;
    if (realm->impl == HOSTILE_IMPL_WHEEL)
        cc_arena_pool_free(&realm->wheel.reg_pool, r);
}

static int hostile_wheel_compact_bucket(HostileRealm *realm, EpBucket *b);

static void hostile_claim_body_release(HostileRealm *realm, HostileClaimBody *body) {
    EpBucket *b;
    if (!realm || !body) return;
    b = body->ep.bucket;
    if (realm->impl == HOSTILE_IMPL_FLAT) ep_slot_release(&body->ep);
    else if (realm->impl == HOSTILE_IMPL_EPOCH)
        ep_release(&realm->store, &body->ep);
    else if (realm->impl == HOSTILE_IMPL_WHEEL) {
        ep_wheel_release(&realm->wheel, &body->ep);
        /* Mid-gen densify while handles still point into this bucket. */
        if (b) (void)hostile_wheel_compact_bucket(realm, b);
    }
}

static void hostile_reg_body_release(HostileRealm *realm, HostileRegBody *body) {
    EpBucket *b;
    if (!realm || !body) return;
    b = body->ep.bucket;
    if (realm->impl == HOSTILE_IMPL_FLAT) ep_slot_release(&body->ep);
    else if (realm->impl == HOSTILE_IMPL_EPOCH)
        ep_release(&realm->store, &body->ep);
    else if (realm->impl == HOSTILE_IMPL_WHEEL) {
        ep_wheel_release(&realm->wheel, &body->ep);
        if (b) (void)hostile_wheel_compact_bucket(realm, b);
    }
}

/*
 * Mid-gen compact: densify live ClaimBody/RegBody into a fresh arena,
 * patch thin handles, destroy the sparse gen arena. External HostileClaim*
 * stay stable (pool slots).
 */
static int hostile_wheel_compact_bucket(HostileRealm *realm, EpBucket *b) {
    CCResult_CCArena_CCError ar;
    CCArena fresh;
    EpSlot *e, *next;
    EpSlot *new_head = NULL, *new_tail = NULL;
    size_t moved = 0;
    size_t live_n;

    if (!realm || !b || !ep_bucket_should_compact(b)) return 0;
    live_n = b->live_n;
    ar = cc_arena_try_heap(EP_GEN_L1);
    if (!ar.ok) return -1;
    fresh = ar.u.value;

    for (e = b->live_head; e; e = next) {
        next = e->live_next;
        if (e->kind == EP_KIND_CLAIM) {
            HostileClaimBody *old = (HostileClaimBody *)e;
            HostileClaimBody *nb = (HostileClaimBody *)fresh.alloc_local_grow(
                sizeof(*nb), _Alignof(HostileClaimBody));
            if (!nb) goto fail;
            *nb = *old;
            nb->ep.live_next = NULL;
            nb->ep.live_prev = new_tail;
            nb->ep.bucket = b;
            nb->ep.live = 1;
            nb->ep.kind = EP_KIND_CLAIM;
            if (new_tail) new_tail->live_next = &nb->ep;
            else new_head = &nb->ep;
            new_tail = &nb->ep;
            if (nb->handle) nb->handle->body = nb;
            moved++;
        } else if (e->kind == EP_KIND_REG) {
            HostileRegBody *old = (HostileRegBody *)e;
            HostileRegBody *nb = (HostileRegBody *)fresh.alloc_local_grow(
                sizeof(*nb), _Alignof(HostileRegBody));
            if (!nb) goto fail;
            *nb = *old;
            nb->ep.live_next = NULL;
            nb->ep.live_prev = new_tail;
            nb->ep.bucket = b;
            nb->ep.live = 1;
            nb->ep.kind = EP_KIND_REG;
            if (new_tail) new_tail->live_next = &nb->ep;
            else new_head = &nb->ep;
            new_tail = &nb->ep;
            if (nb->handle) nb->handle->body = nb;
            moved++;
        } else {
            goto fail;
        }
    }

    if (moved != live_n) goto fail;

    {
        CCArena old = b->recs;
        b->recs = fresh;
        b->live_head = new_head;
        b->live_tail = new_tail;
        b->live_n = live_n;
        b->born = live_n;
        b->free_head = NULL;
        old.destroy();
        realm->wheel.rq.compacts++;
        realm->wheel.rq.compact_moved += moved;
        realm->wheel.rq.destroys++;
    }
    return 1;

fail:
    fresh.destroy();
    return -1;
}

static void hostile_wheel_compact_all(HostileRealm *realm) {
    int i;
    if (!realm || realm->impl != HOSTILE_IMPL_WHEEL) return;
    for (i = 0; i < EP_WHEEL_N; i++)
        (void)hostile_wheel_compact_bucket(realm, &realm->wheel.slots[i]);
}

static HostileRealm *hostile_realm_new(CCArena arena, int *err) {
    HostileRealm *r;
    if (err) *err = HOSTILE_OK;
    if (!cc_qjs_available()) {
        if (err) *err = HOSTILE_ERR_BAD_VALUE;
        return NULL;
    }
    r = (HostileRealm *)cc_arena_alloc(arena, sizeof(*r), _Alignof(HostileRealm));
    if (!r) {
        if (err) *err = HOSTILE_ERR_ARENA;
        return NULL;
    }
    memset(r, 0, sizeof(*r));
    r->owner = arena;
    r->impl = hostile_impl_from_env();
    if (r->impl == HOSTILE_IMPL_EPOCH) {
        if (ep_store_init(&r->store, arena) != 0) {
            if (err) *err = HOSTILE_ERR_ARENA;
            return NULL;
        }
    } else if (r->impl == HOSTILE_IMPL_WHEEL) {
        if (ep_wheel_init(&r->wheel, arena) != 0) {
            if (err) *err = HOSTILE_ERR_ARENA;
            return NULL;
        }
    }
    {
        CCQjs !>(CCQjsError) jr = cc_qjs_new(arena);
        if (!jr.ok) {
            if (err) *err = HOSTILE_ERR_BAD_VALUE;
            return NULL;
        }
        r->js = jr.u.value;
    }
    r->alive = 1;
    printf("META {\"hostile_impl\":\"%s\",\"sizeof_HostileClaim\":%zu,"
           "\"sizeof_HostileClaimBody\":%zu}\n",
           hostile_impl_name(r->impl), sizeof(HostileClaim),
           sizeof(HostileClaimBody));
    fflush(stdout);
    return r;
}

static void hostile_epoch_end(HostileRealm *realm) {
    if (!realm) return;
    switch (realm->impl) {
    case HOSTILE_IMPL_FLAT:
        break;
    case HOSTILE_IMPL_EPOCH:
        ep_rotate(&realm->store);
        ep_reclaim(&realm->store);
        break;
    case HOSTILE_IMPL_WHEEL:
        /* Densify sparse gens before park/rotate. */
        hostile_wheel_compact_all(realm);
        ep_wheel_rotate(&realm->wheel);
        ep_wheel_reclaim(&realm->wheel);
        break;
    }
}

static void hostile_reclaim(HostileRealm *realm) {
    hostile_epoch_end(realm);
}

static void hostile_realm_destroy(HostileRealm *realm) {
    if (!realm || !realm->alive) return;
    realm->alive = 0;
    switch (realm->impl) {
    case HOSTILE_IMPL_FLAT:
        break;
    case HOSTILE_IMPL_EPOCH:
        printf("META {\"parks\":%zu,\"destroys\":%zu}\n",
               realm->store.rq.parks, realm->store.rq.destroys);
        ep_store_destroy(&realm->store);
        break;
    case HOSTILE_IMPL_WHEEL:
        printf("META {\"parks\":%zu,\"destroys\":%zu,\"compacts\":%zu,"
               "\"compact_moved\":%zu}\n",
               realm->wheel.rq.parks, realm->wheel.rq.destroys,
               realm->wheel.rq.compacts, realm->wheel.rq.compact_moved);
        ep_wheel_destroy(&realm->wheel);
        break;
    }
    fflush(stdout);
    cc_qjs_close(&realm->js);
}

static HostileValue *hostile_value_from_val(HostileRealm *realm, CCQjsVal v,
                                           CCArena arena, int *err) {
    HostileValue *hv;
    if (err) *err = HOSTILE_OK;
    if (!realm || !realm->alive || !v.live) {
        if (err) *err = HOSTILE_ERR_BAD_VALUE;
        if (v.live) cc_qjs_val_release(&v);
        return NULL;
    }
    hv = (HostileValue *)cc_arena_alloc(arena, sizeof(*hv), _Alignof(HostileValue));
    if (!hv) {
        if (err) *err = HOSTILE_ERR_ARENA;
        cc_qjs_val_release(&v);
        return NULL;
    }
    hv->realm = realm;
    hv->v = v;
    hv->live = 1;
    return hv;
}

static HostileValue *hostile_eval(HostileRealm *realm, const char *src,
                                  CCArena arena, int *err) {
    CCQjsVal !>(CCQjsError) r;
    if (err) *err = HOSTILE_OK;
    if (!realm || !realm->alive) {
        if (err) *err = HOSTILE_ERR_STALE_REALM;
        return NULL;
    }
    r = cc__qjs_eval(&realm->js, cc__qjs_src(src));
    if (!r.ok) {
        if (err) *err = HOSTILE_ERR_BAD_VALUE;
        return NULL;
    }
    return hostile_value_from_val(realm, r.u.value, arena, err);
}

static void hostile_value_drop(HostileValue *v) {
    if (!v || !v->live) return;
    v->live = 0;
    cc_qjs_val_release(&v->v);
}

static HostileClaim *hostile_retain(HostileRealm *realm, HostileValue *v,
                                    CCArena arena, int *err) {
    HostileClaim *c;
    HostileClaimBody *body;
    CCQjsRaw dup;
    (void)arena;
    if (err) *err = HOSTILE_OK;
    if (!realm || !realm->alive) {
        if (err) *err = HOSTILE_ERR_STALE_REALM;
        return NULL;
    }
    if (!v || !v->live || v->realm != realm) {
        if (err) *err = HOSTILE_ERR_BAD_VALUE;
        return NULL;
    }
    dup = cc__qjs.dup_value(realm->js.ctx, v->v.v);

    c = hostile_claim_handle_alloc(realm);
    if (!c) {
        cc__qjs.free_value(realm->js.ctx, dup);
        if (err) *err = HOSTILE_ERR_ARENA;
        return NULL;
    }
    body = hostile_claim_body_alloc(realm);
    if (!body) {
        hostile_claim_handle_free(realm, c);
        cc__qjs.free_value(realm->js.ctx, dup);
        if (err) *err = HOSTILE_ERR_ARENA;
        return NULL;
    }
    body->v.home = &realm->js;
    body->v.v = dup;
    body->v.live = 1;
    body->realm = realm;
    body->handle = c;
    c->body = body;
    realm->n_claims++;
    return c;
}

static int hostile_release(HostileClaim *claim) {
    HostileRealm *realm;
    HostileClaimBody *body;
    if (!claim) return HOSTILE_ERR_BAD_VALUE;
    if (claim->freed) return HOSTILE_ERR_DOUBLE_RELEASE;
    body = claim->body;
    if (!body || !body->ep.live) return HOSTILE_ERR_DOUBLE_RELEASE;
    realm = body->realm;
    if (!realm || !realm->alive) {
        body->ep.live = 0;
        claim->body = NULL;
        return HOSTILE_ERR_STALE_REALM;
    }
    if (body->v.live) cc_qjs_val_release(&body->v);
    if (realm->n_claims) realm->n_claims--;
    hostile_claim_body_release(realm, body);
    hostile_claim_handle_free(realm, claim);
    return HOSTILE_OK;
}

static HostileBorrow *hostile_borrow_begin(HostileClaim *claim, CCArena arena,
                                           int *err) {
    HostileBorrow *b;
    if (err) *err = HOSTILE_OK;
    if (!hostile_claim_is_live(claim)) {
        if (err) *err = HOSTILE_ERR_NOT_LIVE;
        return NULL;
    }
    if (!claim->body->realm || !claim->body->realm->alive) {
        if (err) *err = HOSTILE_ERR_STALE_REALM;
        return NULL;
    }
    b = (HostileBorrow *)cc_arena_alloc(arena, sizeof(*b), _Alignof(HostileBorrow));
    if (!b) {
        if (err) *err = HOSTILE_ERR_ARENA;
        return NULL;
    }
    b->claim = claim;
    b->open = 1;
    return b;
}

static CCQjsVal *hostile_borrow_value(HostileBorrow *b) {
    if (!b || !b->open || !b->claim) return NULL;
    return hostile_claim_val(b->claim);
}

static int hostile_borrow_end(HostileBorrow *b) {
    if (!b) return HOSTILE_ERR_BAD_VALUE;
    if (!b->open) return HOSTILE_ERR_STALE_BORROW;
    b->open = 0;
    return HOSTILE_OK;
}

static HostileWeak *hostile_weak(HostileRealm *realm, HostileValue *v,
                                 CCArena arena, int *err) {
    HostileWeak *w;
    CCQjsVal wr;
    if (err) *err = HOSTILE_OK;
    if (!realm || !realm->alive) {
        if (err) *err = HOSTILE_ERR_STALE_REALM;
        return NULL;
    }
    if (!v || !v->live) {
        if (err) *err = HOSTILE_ERR_BAD_VALUE;
        return NULL;
    }
    {
        void !>(CCQjsError) se = cc_qjs_set(&realm->js, "__hostile_tmp", v->v);
        if (!se.ok) {
            if (err) *err = HOSTILE_ERR_BAD_VALUE;
            return NULL;
        }
    }
    {
        CCQjsVal !>(CCQjsError) er =
            cc__qjs_eval(&realm->js, cc__qjs_src("new WeakRef(__hostile_tmp)"));
        (void)cc_qjs_exec(&realm->js, cc__qjs_src("delete globalThis.__hostile_tmp"));
        if (!er.ok) {
            if (err) *err = HOSTILE_ERR_BAD_VALUE;
            return NULL;
        }
        wr = er.u.value;
    }
    w = (HostileWeak *)cc_arena_alloc(arena, sizeof(*w), _Alignof(HostileWeak));
    if (!w) {
        cc_qjs_val_release(&wr);
        if (err) *err = HOSTILE_ERR_ARENA;
        return NULL;
    }
    w->realm = realm;
    w->weakref = wr;
    w->live = 1;
    realm->n_weaks++;
    return w;
}

static void hostile_weak_drop(HostileWeak *w) {
    if (!w || !w->live) return;
    w->live = 0;
    cc_qjs_val_release(&w->weakref);
    if (w->realm && w->realm->n_weaks) w->realm->n_weaks--;
}

static HostileClaim *hostile_upgrade(HostileWeak *w, CCArena arena, int *err) {
    HostileValue *tmp;
    HostileClaim *c;
    CCQjsVal deref;
    if (err) *err = HOSTILE_OK;
    if (!w || !w->live) {
        if (err) *err = HOSTILE_ERR_EXPIRED;
        return NULL;
    }
    if (!w->realm || !w->realm->alive) {
        if (err) *err = HOSTILE_ERR_STALE_REALM;
        return NULL;
    }
    {
        void !>(CCQjsError) se =
            cc_qjs_set(&w->realm->js, "__hostile_wr", w->weakref);
        if (!se.ok) {
            if (err) *err = HOSTILE_ERR_BAD_VALUE;
            return NULL;
        }
    }
    {
        CCQjsVal !>(CCQjsError) er = cc__qjs_eval(
            &w->realm->js, cc__qjs_src("(__hostile_wr.deref())"));
        (void)cc_qjs_exec(&w->realm->js,
                          cc__qjs_src("delete globalThis.__hostile_wr"));
        if (!er.ok) {
            if (err) *err = HOSTILE_ERR_EXPIRED;
            return NULL;
        }
        deref = er.u.value;
    }
    if (cc__qjs.is_undefined(deref.v) || cc__qjs.is_null(deref.v)) {
        cc_qjs_val_release(&deref);
        if (err) *err = HOSTILE_ERR_EXPIRED;
        return NULL;
    }
    tmp = hostile_value_from_val(w->realm, deref, arena, err);
    if (!tmp) return NULL;
    c = hostile_retain(w->realm, tmp, arena, err);
    hostile_value_drop(tmp);
    return c;
}

static HostileRegistration *hostile_register_callback(HostileRealm *realm,
                                                      HostileValue *fn,
                                                      CCArena arena,
                                                      int *err) {
    HostileRegistration *reg;
    HostileRegBody *body;
    HostileClaim *c;
    CCQjsVal *cv;
    (void)arena;
    if (err) *err = HOSTILE_OK;
    if (!realm || !realm->alive) {
        if (err) *err = HOSTILE_ERR_STALE_REALM;
        return NULL;
    }
    if (!fn || !fn->live) {
        if (err) *err = HOSTILE_ERR_BAD_VALUE;
        return NULL;
    }
    if (!cc__qjs.is_function(realm->js.ctx, fn->v.v)) {
        if (err) *err = HOSTILE_ERR_BAD_VALUE;
        return NULL;
    }
    c = hostile_retain(realm, fn, arena, err);
    if (!c) return NULL;
    cv = hostile_claim_val(c);
    if (!cv) {
        (void)hostile_release(c);
        if (err) *err = HOSTILE_ERR_BAD_VALUE;
        return NULL;
    }

    reg = hostile_reg_handle_alloc(realm);
    if (!reg) {
        (void)hostile_release(c);
        if (err) *err = HOSTILE_ERR_ARENA;
        return NULL;
    }
    body = hostile_reg_body_alloc(realm);
    if (!body) {
        hostile_reg_handle_free(realm, reg);
        (void)hostile_release(c);
        if (err) *err = HOSTILE_ERR_ARENA;
        return NULL;
    }
    /* Move JS value from claim body into reg body. */
    body->fn = *cv;
    cv->live = 0;
    body->realm = realm;
    body->handle = reg;
    reg->body = body;
    /* Drop claim body + return handle to freelist (wheel). */
    {
        HostileClaimBody *cb = c->body;
        if (realm->n_claims) realm->n_claims--;
        hostile_claim_body_release(realm, cb);
        hostile_claim_handle_free(realm, c);
    }
    realm->n_regs++;
    return reg;
}

static int hostile_unregister(HostileRegistration *reg) {
    HostileRealm *realm;
    HostileRegBody *body;
    if (!reg) return HOSTILE_ERR_BAD_VALUE;
    if (reg->freed) return HOSTILE_ERR_DOUBLE_RELEASE;
    body = reg->body;
    if (!body || !body->ep.live) return HOSTILE_ERR_DOUBLE_RELEASE;
    realm = body->realm;
    if (!realm || !realm->alive) {
        body->ep.live = 0;
        reg->body = NULL;
        return HOSTILE_ERR_STALE_REALM;
    }
    if (body->fn.live) cc_qjs_val_release(&body->fn);
    if (realm->n_regs) realm->n_regs--;
    hostile_reg_body_release(realm, body);
    hostile_reg_handle_free(realm, reg);
    return HOSTILE_OK;
}

static int hostile_invoke_registered(HostileRegistration *reg) {
    CCQjsVal !>(CCQjsError) out;
    CCQjsVal *fn;
    if (!hostile_reg_is_live(reg)) return HOSTILE_ERR_EXPIRED;
    if (!reg->body->realm || !reg->body->realm->alive)
        return HOSTILE_ERR_STALE_REALM;
    fn = hostile_reg_fn(reg);
    if (!fn) return HOSTILE_ERR_EXPIRED;
    out = cc_qjs_val_callm(fn, "invoke", 0);
    if (!out.ok) return HOSTILE_ERR_BAD_VALUE;
    cc_qjs_val_release(&out.u.value);
    return HOSTILE_OK;
}

static size_t hostile_outstanding_claims(HostileRealm *realm) {
    return realm ? realm->n_claims : 0;
}
static size_t hostile_outstanding_weaks(HostileRealm *realm) {
    return realm ? realm->n_weaks : 0;
}
static size_t hostile_outstanding_regs(HostileRealm *realm) {
    return realm ? realm->n_regs : 0;
}

static void hostile_gc_pressure(HostileRealm *realm) {
    int i;
    if (!realm || !realm->alive) return;
    for (i = 0; i < 8; i++)
        (void)cc_qjs_exec(&realm->js,
                          cc__qjs_src("(function(){ let a=[]; for(let i=0;i<2000;i++)"
                                      " a.push(new Uint8Array(4096)); })()"));
}

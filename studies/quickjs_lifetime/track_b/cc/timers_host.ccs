/*
 * Track B timer host — txiki-shaped setTimeout/clearTimeout on libuv.
 *
 * Lifetime facts (stated here, not smeared into the app):
 *   uv_timer_t handle  ≠  logical timer id  ≠  JS callback claim (DupValue)
 * Clear / fire / shutdown drop the JS claim then uv_close the handle.
 *
 * Requires: uv.h on include path, libuv linked; CC_QUICKJS_SRC for engine.
 */
#pragma once

#include <ccc/script/quickjs.cch>
#include <uv.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdint.h>

#define TB_MAX_SAFE_INT ((((int64_t)1) << 53) - 1)

typedef struct TbTimer TbTimer;
typedef struct TbHost TbHost;

struct TbTimer {
    TbHost *host;
    int64_t id;
    uv_timer_t handle;
    CCQjsRaw func;
    int interval;
    int live;
    TbTimer *next;
};

struct TbHost {
    CCQjs *js;
    uv_loop_t *loop;
    TbTimer *timers;
    int64_t next_id;
    size_t n_live;
    size_t n_closing;
    size_t n_fired;
    size_t n_created;
    size_t n_cleared;
    int shutting_down;
};

static TbHost *g_tb;

typedef int (*TbToI64Fn)(void *ctx, CCQjsRaw v, int64_t *out);
typedef CCQjsRaw (*TbCallFn)(void *ctx, CCQjsRaw fn, CCQjsRaw this_v, int argc,
                             CCQjsRaw *argv);

/* Avoid UFCS rewriting cc__qjs.to_i64 / .call into slice methods. */
static int tb_to_i64(void *ctx, CCQjsRaw v, int64_t *out) {
    TbToI64Fn fn = cc__qjs.to_i64;
    return fn(ctx, v, out);
}

static CCQjsRaw tb_call(void *ctx, CCQjsRaw fn, CCQjsRaw this_v, int argc,
                        CCQjsRaw *argv) {
    TbCallFn call = cc__qjs.call;
    return call(ctx, fn, this_v, argc, argv);
}

static void tb_timer_free_js(TbTimer *th) {
    int i;
    (void)i;
    if (!th || !th->host || !th->host->js) return;
    cc__qjs.free_value(th->host->js->ctx, th->func);
    th->func = cc__qjs.undefined();
}

static void tb_on_close(uv_handle_t *handle) {
    TbTimer *th = (TbTimer *)handle->data;
    TbHost *h;
    if (!th) return;
    h = th->host;
    if (h && h->n_closing) h->n_closing--;
    free(th);
}

static void tb_unlink(TbHost *h, TbTimer *th) {
    TbTimer **pp;
    if (!h || !th) return;
    for (pp = &h->timers; *pp; pp = &(*pp)->next) {
        if (*pp == th) {
            *pp = th->next;
            th->next = NULL;
            return;
        }
    }
}

static void tb_destroy_timer(TbTimer *th) {
    TbHost *h;
    if (!th || !th->live) return;
    h = th->host;
    th->live = 0;
    tb_timer_free_js(th);
    tb_unlink(h, th);
    if (h && h->n_live) h->n_live--;
    if (!uv_is_closing((uv_handle_t *)&th->handle)) {
        if (h) h->n_closing++;
        uv_close((uv_handle_t *)&th->handle, tb_on_close);
    }
}

static TbTimer *tb_find(TbHost *h, int64_t id) {
    TbTimer *th;
    for (th = h->timers; th; th = th->next)
        if (th->id == id && th->live) return th;
    return NULL;
}

static void tb_on_timer(uv_timer_t *handle) {
    TbTimer *th = (TbTimer *)handle->data;
    TbHost *h;
    CCQjsRaw this_v, out;
    if (!th || !th->live) return;
    h = th->host;
    if (!h || !h->js || h->shutting_down) return;
    if (uv_is_closing((uv_handle_t *)handle)) return;

    h->n_fired++;
    this_v = cc__qjs.undefined();
    out = tb_call(h->js->ctx, th->func, this_v, 0, NULL);
    if (cc__qjs.is_exception(out)) {
        CCQjsRaw ex = cc__qjs.get_exception(h->js->ctx);
        cc__qjs.free_value(h->js->ctx, ex);
    } else {
        cc__qjs.free_value(h->js->ctx, out);
    }

    if (uv_is_closing((uv_handle_t *)handle)) return;
    if (!th->interval) tb_destroy_timer(th);
}

static CCQjsRaw tb_set_timer(void *ctx, CCQjsRaw this_v, int argc, CCQjsRaw *argv,
                             int interval) {
    TbHost *h = g_tb;
    TbTimer *th;
    int64_t delay = 0;
    (void)this_v;
    if (!h || !h->js || ctx != h->js->ctx)
        return cc__qjs.throw_type(ctx, "timer host not ready");
    if (argc < 1 || !cc__qjs.is_function(ctx, argv[0]))
        return cc__qjs.throw_type(ctx, "not a function");
    if (argc >= 2) {
        if (tb_to_i64(ctx, argv[1], &delay) != 0)
            return cc__qjs.get_exception(ctx);
        if (delay < 0) delay = 0;
    }
    th = (TbTimer *)calloc(1, sizeof(*th));
    if (!th) return cc__qjs.throw_type(ctx, "oom");
    th->host = h;
    th->id = h->next_id++;
    if (h->next_id > TB_MAX_SAFE_INT) h->next_id = 1;
    th->interval = interval;
    th->live = 1;
    th->func = cc__qjs.dup_value(ctx, argv[0]);
    if (uv_timer_init(h->loop, &th->handle) != 0) {
        tb_timer_free_js(th);
        free(th);
        return cc__qjs.throw_type(ctx, "uv_timer_init failed");
    }
    th->handle.data = th;
    if (uv_timer_start(&th->handle, tb_on_timer, (uint64_t)delay,
                       interval ? (uint64_t)delay : 0) != 0) {
        tb_timer_free_js(th);
        h->n_closing++;
        uv_close((uv_handle_t *)&th->handle, tb_on_close);
        return cc__qjs.throw_type(ctx, "uv_timer_start failed");
    }
    th->next = h->timers;
    h->timers = th;
    h->n_live++;
    h->n_created++;
    return cc__qjs.new_i64(ctx, th->id);
}

static CCQjsRaw tb_c_setTimeout(void *ctx, CCQjsRaw this_v, int argc,
                                CCQjsRaw *argv) {
    return tb_set_timer(ctx, this_v, argc, argv, 0);
}

static CCQjsRaw tb_c_setInterval(void *ctx, CCQjsRaw this_v, int argc,
                                 CCQjsRaw *argv) {
    return tb_set_timer(ctx, this_v, argc, argv, 1);
}

static CCQjsRaw tb_c_clearTimeout(void *ctx, CCQjsRaw this_v, int argc,
                                  CCQjsRaw *argv) {
    TbHost *h = g_tb;
    int64_t id = 0;
    TbTimer *th;
    (void)this_v;
    if (!h || !h->js || ctx != h->js->ctx) return cc__qjs.undefined();
    if (argc < 1) return cc__qjs.undefined();
    if (tb_to_i64(ctx, argv[0], &id) != 0) {
        CCQjsRaw ex = cc__qjs.get_exception(ctx);
        cc__qjs.free_value(ctx, ex);
        return cc__qjs.undefined();
    }
    th = tb_find(h, id);
    if (th) {
        uv_timer_stop(&th->handle);
        h->n_cleared++;
        tb_destroy_timer(th);
    }
    return cc__qjs.undefined();
}

static CCQjsRaw tb_c_console_log(void *ctx, CCQjsRaw this_v, int argc,
                                 CCQjsRaw *argv) {
    int i;
    (void)this_v;
    for (i = 0; i < argc; i++) {
        size_t len = 0;
        const char *s = cc__qjs.to_cstr(ctx, argv[i], &len);
        if (s) {
            fwrite(s, 1, len, stdout);
            cc__qjs.free_cstr(ctx, s);
        } else {
            fputs("[unprintable]", stdout);
        }
        if (i + 1 < argc) fputc(' ', stdout);
    }
    fputc('\n', stdout);
    fflush(stdout);
    return cc__qjs.undefined();
}

static CCQjsRaw tb_c_shutdown(void *ctx, CCQjsRaw this_v, int argc,
                              CCQjsRaw *argv) {
    TbHost *h = g_tb;
    TbTimer *th, *next;
    (void)this_v;
    (void)argc;
    (void)argv;
    if (!h) return cc__qjs.undefined();
    h->shutting_down = 1;
    for (th = h->timers; th; th = next) {
        next = th->next;
        if (th->live) {
            uv_timer_stop(&th->handle);
            tb_destroy_timer(th);
        }
    }
    return cc__qjs.undefined();
}

static int tb_install_globals(TbHost *h) {
    CCQjsRaw g, f, f2;
    void *ctx;
    if (!h || !h->js) return -1;
    ctx = h->js->ctx;
    g = cc__qjs.get_global(ctx);

    /* JS_SetPropertyStr takes ownership of the value — do not free after set. */
    f = cc__qjs.new_cfunc(ctx, tb_c_setTimeout, "setTimeout", 2);
    cc__qjs.set_prop(ctx, g, "setTimeout", f);

    f = cc__qjs.new_cfunc(ctx, tb_c_setInterval, "setInterval", 2);
    cc__qjs.set_prop(ctx, g, "setInterval", f);

    f = cc__qjs.new_cfunc(ctx, tb_c_clearTimeout, "clearTimeout", 1);
    f2 = cc__qjs.dup_value(ctx, f);
    cc__qjs.set_prop(ctx, g, "clearTimeout", f);
    cc__qjs.set_prop(ctx, g, "clearInterval", f2);

    f = cc__qjs.new_cfunc(ctx, tb_c_shutdown, "__hostile_shutdown", 0);
    cc__qjs.set_prop(ctx, g, "__hostile_shutdown", f);

    {
        CCQjsVal !>(CCQjsError) er =
            cc__qjs_eval(h->js, cc__qjs_src("globalThis.console = {}"));
        if (er.ok) cc_qjs_val_release(&er.u.value);
    }
    {
        CCQjsRaw cobj = cc__qjs.get_prop(ctx, g, "console");
        f = cc__qjs.new_cfunc(ctx, tb_c_console_log, "log", 1);
        cc__qjs.set_prop(ctx, cobj, "log", f);
        cc__qjs.free_value(ctx, cobj);
    }

    cc__qjs.free_value(ctx, g);
    return 0;
}

static int tb_host_init(TbHost *h, CCQjs *js) {
    memset(h, 0, sizeof(*h));
    h->js = js;
    h->loop = uv_default_loop();
    h->next_id = 1;
    g_tb = h;
    return tb_install_globals(h);
}

static int tb_drain_jobs(TbHost *h) {
    int n = 0, r;
    if (!h || !h->js) return 0;
    for (;;) {
        r = cc_qjs_execute_pending_job(h->js);
        if (r > 0) {
            n++;
            continue;
        }
        if (r < 0) {
            CCQjsRaw ex = cc__qjs.get_exception(h->js->ctx);
            cc__qjs.free_value(h->js->ctx, ex);
            return -1;
        }
        break;
    }
    return n;
}

/* Run until no live timers, no closing handles, and no pending jobs. */
static void tb_run_until_idle(TbHost *h) {
    int spins = 0;
    if (!h) return;
    for (;;) {
        if (tb_drain_jobs(h) < 0) return;
        if (h->n_live == 0 && h->n_closing == 0) {
            if (tb_drain_jobs(h) == 0) break;
            continue;
        }
        uv_run(h->loop, UV_RUN_ONCE);
        if (++spins > 1000000) {
            fprintf(stderr, "tb: loop spun too long (live=%zu closing=%zu)\n",
                    h->n_live, h->n_closing);
            break;
        }
    }
}

static void tb_host_shutdown(TbHost *h) {
    TbTimer *th, *next;
    if (!h) return;
    h->shutting_down = 1;
    for (th = h->timers; th; th = next) {
        next = th->next;
        if (th->live) {
            uv_timer_stop(&th->handle);
            tb_destroy_timer(th);
        }
    }
    while (h->n_closing)
        uv_run(h->loop, UV_RUN_ONCE);
    (void)tb_drain_jobs(h);
    if (g_tb == h) g_tb = NULL;
}

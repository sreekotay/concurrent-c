/*
 * Track B CC driver — load workload/timers.js on the libuv timer host.
 *
 * Build (from repo root):
 *   ./studies/quickjs_lifetime/scripts/run_track_b.sh
 */
#include <ccc/std/prelude.cch>
#include <ccc/stdio.cch>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include "timers_host.ccs"

static char *read_file(const char *path, size_t *out_len) {
    FILE *f;
    long n;
    char *buf;
    f = fopen(path, "rb");
    if (!f) return NULL;
    if (fseek(f, 0, SEEK_END) != 0) {
        fclose(f);
        return NULL;
    }
    n = ftell(f);
    if (n < 0) {
        fclose(f);
        return NULL;
    }
    rewind(f);
    buf = (char *)malloc((size_t)n + 1);
    if (!buf) {
        fclose(f);
        return NULL;
    }
    if (fread(buf, 1, (size_t)n, f) != (size_t)n) {
        free(buf);
        fclose(f);
        return NULL;
    }
    buf[n] = 0;
    fclose(f);
    if (out_len) *out_len = (size_t)n;
    return buf;
}

int main(int argc, char **argv) {
    @errhandler(CCError e) {
        fprintf(stderr, "fatal: %s\n", e.message);
        return 1;
    }

    const char *script_path =
        argc > 1 ? argv[1]
                 : "studies/quickjs_lifetime/track_b/workload/timers.js";
    char *src;
    size_t src_len = 0;
    TbHost host;
    int ok = 1;

    printf("META {\"track\":\"B\",\"impl\":\"cc\",\"libuv\":\"pinned\"}\n");
    fflush(stdout);

    if (!cc_qjs_available()) {
        fprintf(stderr, "error: QuickJS adapter unavailable (set CC_QUICKJS_SRC)\n");
        return 2;
    }

    src = read_file(script_path, &src_len);
    if (!src) {
        fprintf(stderr, "error: cannot read %s\n", script_path);
        return 2;
    }

    {
        CCArena !>(CCError) ar = cc_arena_try_heap(8 * 1024 * 1024);
        CCArena a = ar.u.value;
        CCQjs !>(CCQjsError) jr = cc_qjs_new(a);
        CCQjs js = jr.u.value;

        if (tb_host_init(&host, &js) != 0) {
            fprintf(stderr, "error: timer host init failed\n");
            free(src);
            return 2;
        }

        printf("CHK {\"phase\":\"after_install\",\"timers\":%zu,\"ok\":1}\n",
               host.n_live);
        fflush(stdout);

        {
            CCSlice src_sl = cc_slice_from_buffer(src, src_len);
            CCQjsVal !>(CCQjsError) er = cc__qjs_eval(&js, src_sl);
            if (!er.ok) {
                fprintf(stderr, "eval failed: %s\n", er.u.error.base.message);
                ok = 0;
            } else {
                /* Keep the completion promise rooted until idle. */
                CCQjsVal ret = er.u.value;
                tb_run_until_idle(&host);
                cc_qjs_val_release(&ret);
            }
        }

        printf("CHK {\"phase\":\"after_workload\",\"timers\":%zu,\"created\":%zu,"
               "\"cleared\":%zu,\"fired\":%zu,\"ok\":%d}\n",
               host.n_live, host.n_created, host.n_cleared, host.n_fired, ok);
        fflush(stdout);

        tb_host_shutdown(&host);
        printf("CHK {\"phase\":\"after_teardown\",\"timers\":%zu,\"closing\":%zu,"
               "\"ok\":%d}\n",
               host.n_live, host.n_closing, host.n_live == 0 && host.n_closing == 0);
        fflush(stdout);

        cc_qjs_close(&js);
        a.destroy();
    }

    free(src);

    /* Expected per epoch from timers.js: fired=24 cancelled=8 nested=3 threw=3 */
    if (ok && host.n_live == 0) {
        puts("ORACLE PASS");
        return 0;
    }
    puts("ORACLE FAIL");
    return 3;
}

/* Control: the fence refuses the store on Plain, and does not reach the
 * factory-generated Source_size_t (seed 0.4.0-419). */
#include <ccc/std/prelude.cch>
#include "cc_source.cch"
typedef struct { int value; } Plain;
@typeview on Plain { r: ^value; }
@typeview on Source_size_t { r: ^value; }
int main(void) {
    Plain p = {0};
    Source::[size_t] s = {0};
    p.value = 1;          /* expect refusal */
    s.value = 1;          /* expect refusal if the fence reaches generated types */
    return p.value + (int)s.value;
}

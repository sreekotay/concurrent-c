/* Source::[T] and Derived::[T] as generic families, with UFCS and a fence. */
#include <ccc/std/prelude.cch>
#include <stdio.h>
#include "cc_source.cch"

@typeview on Source_* { r: ^value; }
@typeview on Derived_* { r: ^value; }

typedef struct { size_t nl; size_t rows; } LineIndex;

typedef struct {
    Source::[size_t]     width;
    Source::[size_t]     text_len;          /* stands in for the text source */
    Derived::[LineIndex] idx;
    int rebuilds;
} Doc;

static const LineIndex* Doc_idx(Doc* d) {
    Derived_LineIndex_Check k = d->idx.check(cc_inputs(d->text_len.gen(), d->width.gen()));
    if (k.stale) {
        size_t w = d->width.val(), n = d->text_len.val();
        k.slot->nl = n / 2;
        k.slot->rows = w ? (n + w - 1) / w : 0;
        d->idx.commit(&k);
        d->rebuilds++;
    }
    return d->idx.ref();
}

int main(void) {
    static Doc d;
    d.width.set(10);
    d.text_len.set(40);
    (void)Doc_idx(&d); (void)Doc_idx(&d);          /* one build, then fresh */
    d.width.set(4);
    size_t rows = Doc_idx(&d)->rows;                 /* width moved: one rebuild */
    printf("rows=%zu rebuilds=%d\n", rows, d.rebuilds);
    return 0;
}

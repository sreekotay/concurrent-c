/* The Ruby / Rust `update` from the thread, as stamps and watermarks.
 *
 * The row is one struct of plain values. A Source of it keeps a stamp per
 * field, and set() moves only the stamps of the fields that changed. The
 * row as last written is a watermark over those stamps, and a flush
 * writes the fields whose stamps moved since it.
 *
 * So update() takes a whole row. The caller starts from the current one
 * and changes what it means to change: a field it leaves alone is the
 * same value, and the same value moves no stamp. There is no keep / clear
 * / set encoding, and "name cannot be NULL" is the type of `name`.
 *
 * The record's bytes live on the arena it keeps; a caller's row lives
 * wherever the caller built it, and set() copies the changed fields over.
 * The database is a stand-in (sql_standin.cch). */
#include <ccc/std/prelude.cch>
#include <ccc/stdio.cch>
#define CC_GEN_IMPL                      /* this unit defines the counter */
#include "cc_source.cch"
#include "sql_standin.cch"

/* ---- the row ------------------------------------------------------------ */

typedef struct { char[:] k; char[:] v; } Setting;

@variant Styles { none: void; some: char[:]; };     /* a nullable column */

typedef struct {
    char[:]          name;
    Styles           custom_styles;
    CCVec::[Setting] settings;
} Row;

/* What a row must be: a rule on the whole row, checked before it is
 * stored. */
static void !>(CCError) Row_check(Row* w) {
    @for (s in w->settings) {
        if (s.k.eq("tab_width")) {
            @for (c in s.v)
                if (c < '0' || c > '9') return cc_err(CC_ERR_INVALID_ARG, "tab_width is not a number");
        } else if (!s.k.eq("theme") && !s.k.eq("font")) {
            return cc_err(CC_ERR_INVALID_ARG, "unknown setting");
        }
    }
    return cc_ok();
}

/* The settings with kv set: a new list on `a`. (A row from r.row.val()
 * shares its lists with the record; an edit builds a new one.) */
static CCVec::[Setting] settings_put(CCVec::[Setting] cur, Setting kv, CCArena a) {
    CCVec::[Setting] out = cc_vec_new::[Setting](a);
    bool found = false;
    @for (s in cur) {
        bool same = s.k.eq(kv.k);
        (void)out.push(same ? kv : s);
        found = found || same;
    }
    if (!found) (void)out.push(kv);
    return out;
}

/* A @variant is a type the Source cannot see into, so it brings its own
 * equality and copy. */
static bool Styles_eq(Styles* a, Styles b) {
    char[:] none = "";
    @switch (*a) {
        case .none: return b.kind == .none;
        case .some(t): return b.kind == .some && t.eq(b.some ?> none);
    }
    return false;
}

static Styles !>(CCError) Styles_clone_into(Styles* s, CCArena a) {
    @switch (*s) {
        case .none: return cc_ok(*s);
        case .some(t): {
            char[:] kept = t.clone_into(a) !>(e) { return cc_err(e); };
            return cc_ok((Styles){ .some = kept });
        }
    }
    return cc_ok(*s);
}

/* ---- the record ---------------------------------------------------------- */

typedef struct {
    CCArena        keep;       /* where the record's bytes live */
    Source::[Row]  row;        /* the row, and a stamp per field */
    CCStamp::[Row] written;    /* the row as last written */
} Record;

@typeview on Record { r: ^written; }

static Record Record_open(CCArena keep) {
    Record r = { .keep = keep };
    return r;
}

/* The caller's intent: a checked row, stored. */
static void !>(CCError) Record_update(Record* r, Row next) {
    @errhandler(CCError e) {
        return cc_err(e);
    }
    next.check() !>;                     /* fails before anything moves */
    r->row.set(next, r->keep) !>;
    return cc_ok();
}

/* The row as last written, marked when a row is loaded. */
static void Record_loaded(Record* r) {
    CCStampCheck k = r->row.since(&r->written);
    cc_stamp_commit(&k);
}

/* The effect: the fields whose stamps moved since the row was last
 * written; the watermark is recorded only after the write succeeds. */
static void !>(CCError) Record_flush(Record* r, SqlTable::[Row]* db) {
    @errhandler(CCError e) {
        return cc_err(e);
    }
    CCStampCheck k = r->row.since(&r->written);
    if (!k.stale) {
        println("    (nothing to write)");
        return cc_ok();
    }
    db->update(r->row.ref(), k.changed) !>;
    cc_stamp_commit(&k);
    return cc_ok();
}

/* ---- the columns ---------------------------------------------------------- */

static SqlValue Styles_sql(Styles* s, CCArena a) {
    (void)a;
    @switch (*s) {
        case .none: return (SqlValue){ .null = true };
        case .some(t): return (SqlValue){ .text = t };
    }
    return (SqlValue){ .null = true };
}

static int json_builds;

/* The settings as JSON: built when the settings column is written, which
 * is when its stamp moved. */
static SqlValue CCVec_Setting_sql(CCVec::[Setting]* st, CCArena a) {
    CCVec::[Setting] list = *st;
    CCString out = @string(`{`, a);
    @for (i, kv in list) {
        CCString item = @string(`"${kv.k}":"${kv.v}"`, @scratch);
        if (i) out.push_cstr(",", a);
        out.push_slice(item.as_slice(), a);
    }
    out.push_cstr("}", a);
    json_builds++;
    return (SqlValue){ .text = out.as_slice() };
}

/* ---- a session ------------------------------------------------------------ */

static void save(Record* r, SqlTable::[Row]* db, Row next) {
    r->update(next) !>(e) {
        println(@string(`    update refused: ${e.message}; name is still '${r->row.val().name}'`, @scratch));
        return;
    };
    r->flush(db) !>(e) {
        println(@string(`    write failed: ${e.message}; the row stays unwritten`, @scratch));
    };
}

int main(void) {
    @errhandler(CCError e) {
        cc_error_log(e);
        return 1;
    }
    CCArena keep = cc_arena_heap(kilobytes(8)) @destroy;
    CCArena scratch = cc_arena_heap(kilobytes(8)) @destroy;   /* the caller's rows */
    Record r = Record_open(keep);
    SqlTable::[Row] db = { .name = "record" };
    Setting dark, mono, four;            /* (a literal in a char[:] field or */
    char[:] bold = "bold";               /*  arm initializer is empty today) */
    Row next;

    dark.k = "theme";     dark.v = "dark";
    mono.k = "font";      mono.v = "mono";
    four.k = "tab_width"; four.v = "four";

    /* a row as loaded from the database */
    next = r.row.val();
    next.name = "alpha";
    next.settings = settings_put(next.settings, dark, scratch);
    r.update(next) !>;
    r.loaded();

    println("the same name again");
    next = r.row.val();
    next.name = "alpha";
    save(&r, &db, next);

    println("a new name and styles");
    next = r.row.val();
    next.name = "beta";
    next.custom_styles = (Styles){ .some = bold };
    save(&r, &db, next);

    println("a font");
    next = r.row.val();
    next.settings = settings_put(next.settings, mono, scratch);
    save(&r, &db, next);

    println("the same font again");
    next = r.row.val();
    next.settings = settings_put(next.settings, mono, scratch);
    save(&r, &db, next);

    println("a name with a bad setting");
    next = r.row.val();
    next.name = "gamma";
    next.settings = settings_put(next.settings, four, scratch);
    save(&r, &db, next);

    println("clear the styles, and the write fails");
    db.fail = true;
    next = r.row.val();
    next.custom_styles = (Styles){ .none = {} };
    save(&r, &db, next);
    db.fail = false;

    println("the next flush");
    r.flush(&db) !>(e) { println("    write failed again"); };

    println(@string(`settings JSON built ${json_builds} time(s)`, @scratch));
    return 0;
}

#include <ccc/std/prelude.cch>
static void use(char[:] s) { (void)s; }

int main(void) {
    @errhandler(CCError e) cc_error_exit(e);
    CCArena a = cc_arena_heap(1024) @destroy;
    CCParallel h = @parallel spawn { @serial { (void)0; } } !>;
    {
        char[:] s = cc_arena_alloc_slice_bytes(a, 8);
        @parallel(h) { use(s); }
    }
    cc_arena_reset(a);
    h.wait() !>;
    return 0;
}

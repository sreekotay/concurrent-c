/*
 * SHAPE-T7 residual — raw T* field on a channel: PREVENTED.
 *
 * Ill-formed (tests/channel_send_pointer_field_fail.ccs):
 *   typedef struct Msg { char* p; size_t n; } Msg;
 *   cc_channel_send(tx, m);   // ERROR: raw pointer field
 *
 * Idiomatic: send owned / static bytes (no raw T* in the message).
 */
#include <ccc/std/prelude.cch>
#include <stdio.h>
#include <string.h>

int main(void) {
    char[:] msg = cc_slice_from_static((void*)"payload!", 8);

    char[:][~4 >] tx;
    char[:][~4 <] rx;
    CCChan* ch = cc_channel_pair(&tx, &rx);
    if (!ch) return 1;
    @defer ch.free();

    if (!cc_io_avail(cc_channel_send(tx, msg))) return 2;

    char[:] got = {0};
    if (!cc_io_avail(cc_channel_recv(rx, &got))) return 3;
    if (got.len != 8 || memcmp(got.ptr, "payload!", 8) != 0) return 4;

    printf("shape-t7-pointer-channel-send: prevented "
           "(pointer-channel-send-ban; send owned/static bytes)\n");
    return 0;
}

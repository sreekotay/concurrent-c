/*
 * SHAPE-T9 — indexed OOB: MITIGATED on the checked surface.
 *
 * Idiomatic: s.at(i) !> / s.set(i, c) !> return CCError on OOB.
 * Escape (still compiles): ((char*)s.ptr)[s.len] = 'x';
 */
#include <ccc/std/prelude.cch>
#include <stdio.h>

int main(void) {
    char buf[4] = {'a', 'b', 'c', 'd'};
    char[:] s = cc_slice_from_buffer(buf, 4);

    @errhandler(CCError e) {
        if (e.kind != CC_ERR_INVALID_ARG) {
            fprintf(stderr, "unexpected: %s\n", e.message);
            return 2;
        }
        printf("shape-t9-raw-index-oob: mitigated "
               "(checked at/set; raw ptr[i]= remains Gap)\n");
        return 0;
    }

    bool wrote = s.set(1, 'B') !>;
    if (!wrote) return 3;
    char c = s.at(1) !>;
    if (c != 'B') return 4;

    /* OOB — Result error, all builds. */
    char bad = s.at(4) !>;
    (void)bad;
    printf("FAIL: OOB should have erred\n");
    return 1;
}

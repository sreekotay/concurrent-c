/*
 * SHAPE-T3 residual — non-arena borrow on a channel: PREVENTED.
 *
 * Ill-formed (tests/channel_send_untracked_borrow_fail.ccs):
 *   char[:] view = cc_slice_from_buffer(heap, n);
 *   cc_channel_send(tx, view);   // ERROR: non-stable slice borrow
 *
 * Idiomatic: materialize static / unique / stable-arena bytes before send.
 */
#include <ccc/std/prelude.cch>
#include <stdio.h>
#include <string.h>

int main(void) {
    char[:] msg = cc_slice_from_static((void*)"payload!", 8);

    char[:][~4 >] tx;
    char[:][~4 <] rx;
    CCChan* ch = cc_channel_pair(&tx, &rx);
    if (!ch) return 1;
    @defer ch.free();

    if (!cc_io_avail(cc_channel_send(tx, msg))) return 2;

    char[:] got = {0};
    if (!cc_io_avail(cc_channel_recv(rx, &got))) return 3;
    if (got.len != 8 || memcmp(got.ptr, "payload!", 8) != 0) return 4;

    printf("shape-t3-nonarena-borrow-send: prevented "
           "(channel-stable-borrow covers untracked from_buffer)\n");
    return 0;
}
